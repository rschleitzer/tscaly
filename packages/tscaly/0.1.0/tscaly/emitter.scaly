; SPDX-License-Identifier: Apache-2.0
;
; emitter — the JS half of internal/compiler/emitter.go, and the TRANSFORMERS it
; runs: internal/transformers (transformer.go, chain.go, modifiervisitor.go,
; utilities.go), tstransforms/typeeraser.go, estransforms/usestrict.go and
; moduletransforms/esmodule.go (+ utilities.go). Ported from
; microsoft/typescript-go at the pin named in tscaly.scaly.
;
; ★★★ THE TRANSFORMER HIERARCHY IS ONE RECORD WITH A TAG (§3.41). The reference
; embeds `transformers.Transformer` in every transformer struct and hands the
; visitor a method value; here `Transformer` carries a `tag`, the fields of
; every transformer (prefixed where they would collide), and ONE `visit` that
; dispatches on the tag. The NodeVisitor reaches it through its `transformer`
; field under `VisitTagTransformer` (§3.18: a func value is a tag).
;
; ★★★ EVERY TRANSFORMER THE DRIVER DOES NOT RUN YET IS A SAID STOP. The reference
; gates each of them by the file's SubtreeFacts; this port has no facts, so the
; driver SCANS the file for what each unported transformer would act on and
; records `transform-<name>` when it finds it — the unit is UNPORTED, never
; emitted wrongly. The gates and the chain order are in `Emitter.emit_js`.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
; the whole ast module: the facts read a field of most of the 134 records
use tscaly.ast.*
use tscaly.parser.Parser
use tscaly.binder.Binder
use tscaly.checker.Checker
use tscaly.checker.EvalResult
use tscaly.printer.EmitContext
use tscaly.printer.NameGenerator
use tscaly.printer.EmitHelper
use tscaly.printer.EmitHelpers
use tscaly.printer.AutoGenerateInfo
use tscaly.printer.Printer
use tscaly.printer.PrinterOptions
use tscaly.printer.SourceFileInfo
use tscaly.printer.TextWriter
use tscaly.printer.NameNode
use tscaly.printer.TextRange
use tscaly.factory.NodeFactory
use tscaly.factory.NodeVisitor

; core.JsxEmit
; core.ModuleKind values the checker's table lacks
define ModuleKindAMD: int 2
define ModuleKindUMD: int 3
define ModuleKindNode20: int 102
; core.ModuleDetectionKind
define ModuleDetectionKindAuto: int 0
define ModuleDetectionKindLegacy: int 1
define ModuleDetectionKindForce: int 2

define JsxEmitNone: int 0
define JsxEmitPreserve: int 1
define JsxEmitReactNative: int 2
define JsxEmitReact: int 3
define JsxEmitReactJSX: int 4
define JsxEmitReactJSXDev: int 5

; ast.OEKAllExceptAssertionsOrExpressionsWithTypeArguments = OEKAll &^ OEKAssertions
; &^ OEKExpressionsWithTypeArguments = OEKParentheses | OEKPartiallyEmittedExpressions
define OEKAllExceptAssertionsOrExpressionsWithTypeArguments: int 9

define TransformerTagNone: int 0
define TransformerTagTypeEraser: int 1
define TransformerTagUseStrict: int 2
define TransformerTagESModule: int 3
define TransformerTagChain: int 4
define TransformerTagModifierVisitor: int 5
define TransformerTagImportElision: int 6
define TransformerTagRuntimeSyntax: int 7
define TransformerTagConstEnumInlining: int 8
define TransformerTagUsing: int 9
; estransforms/using.go usingKind
define UsingKindNone:  int 0
define UsingKindSync:  int 1
define UsingKindAsync: int 2

define TransformerTagESDecorator: int 10

; the twelve visitors of esdecorator.go beside its `visit`, by sub tag
define EsdSubOuterThis:                  int 1
define EsdSubDiscarded:                  int 2
define EsdSubModifier:                   int 3
define EsdSubExportStrippingModifier:    int 4
define EsdSubClassElement:               int 5
define EsdSubNonConstructorClassElement: int 6
define EsdSubConstructorClassElement:    int 7
define EsdSubArrayAssignment:            int 8
define EsdSubObjectAssignment:           int 9
define EsdSubStaticOnlyModifier:         int 10
define EsdSubAsyncOnlyModifier:          int 11
define EsdSubAccessorStrippingModifier:  int 12

; lexicalEntryKind
define EsdLexicalKindClass:        int 0
define EsdLexicalKindClassElement: int 1
define EsdLexicalKindName:         int 2
define EsdLexicalKindOther:        int 3

; createDescriptorFunc, as a kind
define EsdDescriptorNone:     int 0
define EsdDescriptorMethod:   int 1
define EsdDescriptorGet:      int 2
define EsdDescriptorSet:      int 3
define EsdDescriptorAccessor: int 4

; memberInfo: decoration-related data for a single class element
define EsdMemberInfo
(
    member_decorators_name: ref[AstNode]?
    member_initializers_name: ref[AstNode]?
    member_extra_initializers_name: ref[AstNode]?
    member_descriptor_name: ref[AstNode]?
)

; the OrderedMap[*Node, *memberInfo] row
define EsdMemberEntry
(
    member: ref[AstNode]
    info: ref[EsdMemberInfo]
)

; classInfo: all transformation data for a single decorated class
define EsdClassInfo
(
    class_node: ref[AstNode]
    class_decorators_name: ref[AstNode]?
    class_descriptor_name: ref[AstNode]?
    class_extra_initializers_name: ref[AstNode]?
    class_this: ref[AstNode]?
    class_super: ref[AstNode]?
    metadata_reference: ref[AstNode]
    member_infos: ref[Array[EsdMemberEntry]]
    instance_method_extra_initializers_name: ref[AstNode]?
    static_method_extra_initializers_name: ref[AstNode]?
    static_non_field_decoration_statements: ref[Array[ref[AstNode]?]]
    non_static_non_field_decoration_statements: ref[Array[ref[AstNode]?]]
    static_field_decoration_statements: ref[Array[ref[AstNode]?]]
    non_static_field_decoration_statements: ref[Array[ref[AstNode]?]]
    has_static_initializers: bool
    has_non_ambient_instance_fields: bool
    has_static_private_class_elements: bool
    pending_static_initializers: ref[Array[ref[AstNode]?]]?
    pending_instance_initializers: ref[Array[ref[AstNode]?]]?
)

; lexicalEntry: one entry of the lexical scope stack
define EsdLexicalEntry
(
    kind: int
    next: ref[EsdLexicalEntry]?
    class_info: ref[EsdClassInfo]?
    saved_pending_expressions: ref[Array[ref[AstNode]?]]?
    class_this: ref[AstNode]?
    class_super: ref[AstNode]?
    depth: int
)

; partialResult
define EsdPartialResult
(
    modifiers: ref[Array[ref[AstNode]?]]?
    referenced_name: ref[AstNode]?
    name: ref[AstNode]?
    initializers_name: ref[AstNode]?
    extra_initializers_name: ref[AstNode]?
    descriptor_name: ref[AstNode]?
    this_arg: ref[AstNode]?
)
; ast.ModifierFlagsTypeScriptModifier
define ModifierFlagsTypeScriptModifier: int ModifierFlagsAmbient | ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsReadonly | ModifierFlagsAbstract | ModifierFlagsConst | ModifierFlagsOverride | ModifierFlagsIn | ModifierFlagsOut

; ── ast/subtreefacts.go — the transformers' gate (slice 237) ──────────────────
;
; The reference gates EVERY transformer on `node.SubtreeFacts()`: the type
; eraser returns a subtree without SubtreeContainsTypeScript untouched (so a
; bodiless overload `function f1(),` prints as `function f1() { }` and a `static
; constructor() { }` keeps its `static`), the class-fields transformer asks for
; ContainsClassFields, `using` for ContainsUsing, and so on. The facts are the
; per-kind computeSubtreeFacts of ast.go / ast_generated.go (110 of them, the
; scope exclusions of subtreefacts.go applied on the way UP by
; propagateSubtreeFacts), cached on the node behind SubtreeFactsComputed.
;
; ★ The cache slot is `AstNode.subtree_facts` (0 = not yet computed; the
; reference caches on CompositeBase nodes only and recomputes the leaves — the
; answer is the same, computeSubtreeFacts being idempotent). A node the FACTORY
; makes (an updated node) starts at 0 too, so a transformed tree is asked afresh.

define SubtreeContainsTypeScript:                    int 1 << 0
define SubtreeContainsJsx:                           int 1 << 1
define SubtreeContainsESDecorators:                  int 1 << 2
define SubtreeContainsUsing:                         int 1 << 3
define SubtreeContainsClassStaticBlocks:             int 1 << 4
define SubtreeContainsESClassFields:                 int 1 << 5
define SubtreeContainsLogicalAssignments:            int 1 << 6
define SubtreeContainsNullishCoalescing:             int 1 << 7
define SubtreeContainsOptionalChaining:              int 1 << 8
define SubtreeContainsMissingCatchClauseVariable:    int 1 << 9
define SubtreeContainsESObjectRestOrSpread:          int 1 << 10
define SubtreeContainsForAwaitOrAsyncGenerator:      int 1 << 11
define SubtreeContainsAnyAwait:                      int 1 << 12
define SubtreeContainsExponentiationOperator:        int 1 << 13
define SubtreeContainsLexicalThis:                   int 1 << 14
define SubtreeContainsLexicalSuper:                  int 1 << 15
define SubtreeContainsRestOrSpread:                  int 1 << 16
define SubtreeContainsObjectRestOrSpread:            int 1 << 17
define SubtreeContainsAwait:                         int 1 << 18
define SubtreeContainsDynamicImport:                 int 1 << 19
define SubtreeContainsClassFields:                   int 1 << 20
define SubtreeContainsDecorators:                    int 1 << 21
define SubtreeContainsIdentifier:                    int 1 << 22
define SubtreeContainsPrivateIdentifierInExpression: int 1 << 23
define SubtreeContainsInvalidTemplateEscape:         int 1 << 24
define SubtreeFactsComputed:                         int 1 << 25
define SubtreeFactsNone:                             int 0
; every fact bit below the Computed marker
define SubtreeFactsAllBits:                          int 33554431
define SubtreeContainsLexicalThisOrSuper:            int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper

; The scope exclusions, spelled as the bits a scope CLEARS on the way up
; (subtreefacts.go spells them as the complement; SubtreeExclusionsNode is the
; Computed marker alone, which `subtree_facts` never hands out)
define SubtreeClearsFunction:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper | SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsArrowFunction:           int SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsProperty:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsModule:                  int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsObjectLiteral:           int SubtreeContainsObjectRestOrSpread
define SubtreeClearsVariableDeclarationList: int SubtreeContainsObjectRestOrSpread
define SubtreeClearsCatchClause:             int SubtreeContainsObjectRestOrSpread
define SubtreeClearsBindingPattern:          int SubtreeContainsRestOrSpread

; core.CompilerOptions, the slots the emit reads. Every unset option is its zero
; (a Tristate is `TristateUnknown`), as the yardstick's `&core.CompilerOptions{}`.
define EmitOptions
(
    target: int
    module_kind: int
    jsx: int
    remove_comments: bool
    no_emit_helpers: bool
    new_line: int
    verbatim_module_syntax: int
    isolated_modules: int
    experimental_decorators: int
    emit_decorator_metadata: int
    import_helpers: int
    rewrite_relative_import_extensions: int
    use_define_for_class_fields: int
    preserve_const_enums: int
    ; the driver chapter's slots (slice 243): a case's directives
    module_detection: int
    declaration: int
    source_map: int
    inline_source_map: int
    emit_declaration_only: int
    no_emit: int
    allow_js: int
    strict: int
    strict_null_checks: int
)
{
    function defaults() returns EmitOptions
        EmitOptions(ScriptTargetNone, ModuleKindNone, 0, false, false, NewLineKindNone, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, ModuleDetectionKindAuto, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown, TristateUnknown)

    ; the options of one test configuration, `name=value;name=value` with the
    ; names lower-cased by the runner (tests/casejs.py); an unknown name is
    ; ignored — the checker, the parser and the lib do not read these, so a
    ; name that reaches nothing is a directive the emit does not depend on
    function parse(host: ref[Page], text: Slice[char]) returns EmitOptions
    {
        var o EmitOptions.defaults()
        var start 0
        let n text.length as int
        while start <= n
        {
            var stop start
            while (stop < n) and (text[stop] <> (";" as char))
                set stop: stop + 1
            var eq start
            while (eq < stop) and (text[eq] <> ("=" as char))
                set eq: eq + 1
            if eq < stop
            {
                let key text.subslice(start as size_t, eq as size_t)
                let value text.subslice((eq + 1) as size_t, stop as size_t)
                set o: EmitOptions.apply(o, key, value)
            }
            set start: stop + 1
        }
        o
    }

    ; a Tristate read outside the package (a program root cannot see the constant)
    function on(value: int) returns bool
        value = TristateTrue

    function tristate(value: Slice[char]) returns int
    {
        if value.equals("true")
            return TristateTrue
        if value.equals("false")
            return TristateFalse
        TristateUnknown
    }

    function target_of(value: Slice[char]) returns int
    {
        if value.equals("es5")
            return 1
        if value.equals("es6") or value.equals("es2015")
            return ScriptTargetES2015
        if value.equals("es2016")
            return ScriptTargetES2016
        if value.equals("es2017")
            return ScriptTargetES2017
        if value.equals("es2018")
            return ScriptTargetES2018
        if value.equals("es2019")
            return ScriptTargetES2019
        if value.equals("es2020")
            return ScriptTargetES2020
        if value.equals("es2021")
            return ScriptTargetES2021
        if value.equals("es2022")
            return ScriptTargetES2022
        if value.equals("es2023")
            return ScriptTargetES2023
        if value.equals("es2024")
            return ScriptTargetES2024
        if value.equals("es2025")
            return ScriptTargetES2025
        if value.equals("esnext")
            return ScriptTargetLatest
        ScriptTargetNone
    }

    function module_of(value: Slice[char]) returns int
    {
        if value.equals("commonjs")
            return ModuleKindCommonJS
        if value.equals("amd")
            return ModuleKindAMD
        if value.equals("system")
            return ModuleKindSystem
        if value.equals("umd")
            return ModuleKindUMD
        if value.equals("es6") or value.equals("es2015")
            return ModuleKindES2015
        if value.equals("es2020")
            return ModuleKindES2020
        if value.equals("es2022")
            return ModuleKindES2022
        if value.equals("esnext")
            return ModuleKindESNext
        if value.equals("node16")
            return ModuleKindNode16
        if value.equals("node18")
            return ModuleKindNode18
        if value.equals("node20")
            return ModuleKindNode20
        if value.equals("nodenext")
            return ModuleKindNodeNext
        if value.equals("preserve")
            return ModuleKindPreserve
        ModuleKindNone
    }

    function jsx_of(value: Slice[char]) returns int
    {
        if value.equals("preserve")
            return JsxEmitPreserve
        if value.equals("react-native")
            return JsxEmitReactNative
        if value.equals("react-jsx")
            return JsxEmitReactJSX
        if value.equals("react-jsxdev")
            return JsxEmitReactJSXDev
        if value.equals("react")
            return JsxEmitReact
        JsxEmitNone
    }

    function apply(o_in: EmitOptions, key: Slice[char], value: Slice[char]) returns EmitOptions
    {
        var o o_in
        if key.equals("target")
            set o.target: EmitOptions.target_of(value)
        if key.equals("module")
            set o.module_kind: EmitOptions.module_of(value)
        if key.equals("jsx")
            set o.jsx: EmitOptions.jsx_of(value)
        if key.equals("removecomments")
            set o.remove_comments: value.equals("true")
        if key.equals("noemithelpers")
            set o.no_emit_helpers: value.equals("true")
        if key.equals("newline")
        {
            if value.equals("crlf")
                set o.new_line: NewLineKindCRLF
            if value.equals("lf")
                set o.new_line: NewLineKindLF
        }
        if key.equals("verbatimmodulesyntax")
            set o.verbatim_module_syntax: EmitOptions.tristate(value)
        if key.equals("isolatedmodules")
            set o.isolated_modules: EmitOptions.tristate(value)
        if key.equals("experimentaldecorators")
            set o.experimental_decorators: EmitOptions.tristate(value)
        if key.equals("emitdecoratormetadata")
            set o.emit_decorator_metadata: EmitOptions.tristate(value)
        if key.equals("importhelpers")
            set o.import_helpers: EmitOptions.tristate(value)
        if key.equals("rewriterelativeimportextensions")
            set o.rewrite_relative_import_extensions: EmitOptions.tristate(value)
        if key.equals("usedefineforclassfields")
            set o.use_define_for_class_fields: EmitOptions.tristate(value)
        if key.equals("preserveconstenums")
            set o.preserve_const_enums: EmitOptions.tristate(value)
        if key.equals("moduledetection")
        {
            if value.equals("legacy")
                set o.module_detection: ModuleDetectionKindLegacy
            if value.equals("force")
                set o.module_detection: ModuleDetectionKindForce
        }
        if key.equals("declaration")
            set o.declaration: EmitOptions.tristate(value)
        if key.equals("sourcemap")
            set o.source_map: EmitOptions.tristate(value)
        if key.equals("inlinesourcemap")
            set o.inline_source_map: EmitOptions.tristate(value)
        if key.equals("emitdeclarationonly")
            set o.emit_declaration_only: EmitOptions.tristate(value)
        if key.equals("noemit")
            set o.no_emit: EmitOptions.tristate(value)
        if key.equals("allowjs")
            set o.allow_js: EmitOptions.tristate(value)
        if key.equals("strict")
            set o.strict: EmitOptions.tristate(value)
        if key.equals("strictnullchecks")
            set o.strict_null_checks: EmitOptions.tristate(value)
        o
    }

    ; GetStrictOptionValue: an unset strict-family option follows `strict`
    function get_strict_option_value(this, value: int) returns bool
    {
        if value <> TristateUnknown
            return value = TristateTrue
        strict <> TristateFalse
    }

    function get_emit_script_target(this) returns int
    {
        if target <> ScriptTargetNone
            return target
        ; ScriptTargetLatestStandard
        ScriptTargetES2025
    }

    function get_emit_module_kind(this) returns int
    {
        if module_kind <> ModuleKindNone
            return module_kind
        let t this.get_emit_script_target()
        if t = ScriptTargetLatest
            return ModuleKindESNext
        if t >= ScriptTargetES2022
            return ModuleKindES2022
        if t >= ScriptTargetES2020
            return ModuleKindES2020
        if t >= ScriptTargetES2015
            return ModuleKindES2015
        ModuleKindCommonJS
    }

    function get_jsx_transform_enabled(this) returns bool
        (jsx = JsxEmitReact) or (jsx = JsxEmitReactJSX) or (jsx = JsxEmitReactJSXDev)

    function get_isolated_modules(this) returns bool
        (isolated_modules = TristateTrue) or (verbatim_module_syntax = TristateTrue)

    function get_use_define_for_class_fields(this) returns bool
    {
        if use_define_for_class_fields = TristateUnknown
            return this.get_emit_script_target() >= ScriptTargetES2022
        use_define_for_class_fields = TristateTrue
    }

    function should_preserve_const_enums(this) returns bool
        (preserve_const_enums = TristateTrue) or this.get_isolated_modules()

    ; ast.GetEmitModuleFormatOfFileWorker for a file with no package.json above
    ; it: the implied node format is CommonJS for `.cjs`/`.cts`, ESNext for
    ; `.mjs`/`.mts`, else the emit module kind itself.
    function get_emit_module_format_of_file(this, file_name: Slice[char]) returns int
    {
        let mk this.get_emit_module_kind()
        if (mk >= ModuleKindNode16) and (mk <= ModuleKindNodeNext)
        {
            if file_name.ends_with(".mjs") or file_name.ends_with(".mts")
                return ModuleKindESNext
            return ModuleKindCommonJS
        }
        if file_name.ends_with(".cjs") or file_name.ends_with(".cts")
            return ModuleKindCommonJS
        if file_name.ends_with(".mjs") or file_name.ends_with(".mts")
            return ModuleKindESNext
        mk
    }
}

define TransformerTagCommonJS: int 11

; commonjsmodule.go's four visitors, as sub tags on the NodeVisitor (§3.41)
define CjsSubTopLevel: int 1
define CjsSubTopLevelNested: int 2
define CjsSubDiscarded: int 3
define CjsSubAssignmentPattern: int 4

; transformers/destructuring.go
define FlattenLevelAll: int 0
define FlattenLevelObjectRest: int 1
; CreateAssignmentCallback as a tag: none (a plain assignment), the CommonJS
; export expressions
define FlattenCallbackNone: int 0
define FlattenCallbackCommonJS: int 1
define FlattenCallbackNamespace: int 2

; externalmoduleinfo.go: exportSpecifiers (local name → specifiers) and
; exportedBindings (declaration → export names), both ORDERED multimaps
define CjsExportSpecifierEntry
(
    name: Slice[char]
    specifier: ref[AstNode]
)

define CjsExportedBinding
(
    decl: ref[AstNode]
    name: ref[AstNode]
)

define ExternalModuleInfo
(
    external_imports: ref[Array[ref[AstNode]?]]
    export_specifiers: ref[Array[CjsExportSpecifierEntry]]
    exported_bindings: ref[Array[CjsExportedBinding]]
    exported_names: ref[Array[ref[AstNode]?]]
    exported_functions: ref[Array[ref[AstNode]?]]
    export_equals: ref[AstNode]?
    has_export_stars_to_export_values: bool
)
{
    function create(host: ref[Page]) returns ref[ExternalModuleInfo]
    {
        let imports &Array[ref[AstNode]?]^host()
        let specifiers &Array[CjsExportSpecifierEntry]^host()
        let bindings &Array[CjsExportedBinding]^host()
        let names &Array[ref[AstNode]?]^host()
        let functions &Array[ref[AstNode]?]^host()
        &ExternalModuleInfo^host(imports, specifiers, bindings, names, functions, null, false)
    }

    ; exportSpecifiers.Get(name)
    function export_specifiers_of(this, host: ref[Page], name: Slice[char]) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i 0
        while i < (export_specifiers.get_length() as int)
        {
            let e export_specifiers[i as size_t]
            if e.name.equals(name)
                out.add(e.specifier)
            set i: i + 1
        }
        out
    }

    ; exportedBindings.Get(decl)
    function exported_bindings_of(this, host: ref[Page], decl: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i 0
        while i < (exported_bindings.get_length() as int)
        {
            let e exported_bindings[i as size_t]
            if Transformer.same_node(e.decl, decl)
                out.add(e.name)
            set i: i + 1
        }
        out
    }
}

; destructuring.go's pendingDecl
define PendingDecl
(
    pending_expressions: ref[Array[ref[AstNode]?]]?
    name: ref[AstNode]
    value: ref[AstNode]?
    pos: int
    end: int
    original: ref[AstNode]?
)

define TransformerTagClassFields: int 12
; the ES2016–ES2021 downlevel transformers (slice 244)
define TransformerTagLogicalAssignment: int 13
define TransformerTagNullishCoalescing: int 14
define TransformerTagOptionalChain: int 15
define TransformerTagOptionalCatch: int 16
define TransformerTagObjectRestSpread: int 17
define TransformerTagForAwait: int 18
define TransformerTagTaggedTemplate: int 19
define TransformerTagAsync: int 20
define TransformerTagExponentiation: int 21

; their sub visitors
define EsSubFaFallback: int 1
define EsSubNoAsyncModifier: int 2
define EsSubSuperAccess: int 3
define EsSubAsBody: int 4
define EsSubAsFallback: int 5

; forAwaitHierarchyFacts
define FaFactsNone: int 0
define FaFactsHasLexicalThis: int 1
define FaFactsIterationContainer: int 2
define FaFactsAncestorMask: int 3
define FaFactsSourceFileExcludes: int 2
define FaFactsClassOrFunctionIncludes: int 1
define FaFactsClassOrFunctionExcludes: int 2
define FaFactsArrowFunctionIncludes: int 0
define FaFactsArrowFunctionExcludes: int 2
define FaFactsIterationStatementIncludes: int 2
define FaFactsIterationStatementExcludes: int 0

; asyncContextFlags
define AsContextNonTopLevel: int 1
define AsContextHasLexicalThis: int 2

define TransformerTagLegacyDecorators: int 22
define TransformerTagMetadata: int 23
define LdSubStaticSelfReferenceCheck: int 1

; legacydecorators.go allDecorators: the decorators of a declaration and, per
; parameter, the parameter's (null where none)
define AllDecorators
(
    decorators: ref[Array[ref[AstNode]?]]?
    parameters: ref[Array[ref[Array[ref[AstNode]?]]?]]?
)

; ast.AllAccessorDeclarations
define AccessorPair
(
    first_accessor: ref[AstNode]
    second_accessor: ref[AstNode]?
    get_accessor: ref[AstNode]?
    set_accessor: ref[AstNode]?
)

; classfields.go's nine visitors as sub tags, and a tenth for the walk
; memberContainsConstructorReference does with a closure
define CfSubModifier: int 1
define CfSubDiscarded: int 2
define CfSubHeritageClause: int 3
define CfSubAssignmentTarget: int 4
define CfSubClassElement: int 5
define CfSubAccessorFieldResult: int 6
define CfSubArrayAssignmentElement: int 7
define CfSubObjectAssignmentElement: int 8
define CfSubSubstitution: int 9
define CfSubConstructorReferenceCheck: int 10

; classFacts
define ClassFactsNone: int 0
define ClassFactsClassWasDecorated: int 1 << 0
define ClassFactsNeedsClassConstructorReference: int 1 << 1
define ClassFactsNeedsClassSuperReference: int 1 << 2
define ClassFactsNeedsSubstitutionForThisInClassStaticField: int 1 << 3
define ClassFactsWillHoistInitializersToConstructor: int 1 << 4

; printer.PrivateIdentifierKind: the helper's "f" / "m" / "a", and the untransformed marker
define PrivateKindField: int 1
define PrivateKindMethod: int 2
define PrivateKindAccessor: int 3
define PrivateKindUntransformed: int 4

; privateIdentifierInfo
define PrivateIdentifierInfo
(
    kind: int
    ; the WeakMap (instance field), the WeakSet (instance method / accessor) or
    ; the constructor (static member) that brand-checks the receiver
    brand_check_identifier: ref[AstNode]?
    is_static: bool
    ; a reserved name (#constructor) or a duplicate is invalid
    is_valid: bool
    ; the storage variable of a static field
    variable_name: ref[AstNode]?
    method_name: ref[AstNode]?
    getter_name: ref[AstNode]?
    setter_name: ref[AstNode]?
)

; privateEnvironment: the members by text, the generated identifiers by the
; node they were generated for (two maps, as the reference keeps them)
define PrivateMemberEntry
(
    name: Slice[char]
    info: ref[PrivateIdentifierInfo]
)

define PrivateGeneratedEntry
(
    node: ref[AstNode]
    info: ref[PrivateIdentifierInfo]
)

define PrivateEnvironment
(
    class_name: ref[AstNode]?
    weak_set_name: ref[AstNode]?
    members: ref[Array[PrivateMemberEntry]]
    generated_identifiers: ref[Array[PrivateGeneratedEntry]]
)
{
    function create(host: ref[Page]) returns ref[PrivateEnvironment]
    {
        let members &Array[PrivateMemberEntry]^host()
        let generated &Array[PrivateGeneratedEntry]^host()
        &PrivateEnvironment^host(null, null, members, generated)
    }
}

; classLexicalEnvironment
define ClassLexicalEnvironment
(
    facts: int
    class_constructor: ref[AstNode]?
    class_this: ref[AstNode]?
    super_class_reference: ref[AstNode]?
)

; classLexicalEnv: the linked list of class lexical environments
define ClassLexicalEnv
(
    previous: ref[ClassLexicalEnv]?
    data: ref[ClassLexicalEnvironment]?
    private_env: ref[PrivateEnvironment]?
)

; classAliases: class declaration (most original) → alias identifier
define ClassAliasEntry
(
    node: ref[AstNode]
    alias: ref[AstNode]
)

; transformers.TransformOptions: the context, the options, and the resolver —
; which is the checker here (§3.41), beside the binder for the file's flags.
define TransformOptions
(
    context: ref[EmitContext]
    options: EmitOptions
    checker: ref[Checker]?
    binder: ref[Binder]?
    file_info: ref[SourceFileInfo]
)

define Transformer
(
    host: ref[Page]
    tag: int
    context: ref[EmitContext]
    factory: ref[NodeFactory]
    visitor: ref[NodeVisitor]?
    opts: TransformOptions
    parent_node: ref[AstNode]?
    current_node: ref[AstNode]?
    components: ref[Array[ref[Transformer]?]]
    allowed_modifiers: int
    current_source_file: ref[AstNode]?
    import_require_statements: ref[Array[ref[AstNode]?]]?
    require_helper_name: ref[AstNode]?
    ; runtimesyntax.go's scope state (slice 238)
    current_scope: ref[AstNode]?
    current_scope_first_declarations: ref[Array[NameNode]]?
    current_enum: ref[AstNode]?
    current_namespace: ref[AstNode]?
    ; using.go's hoisting state (slice 239)
    export_bindings: ref[Array[NameNode]]?
    export_vars: ref[Array[ref[AstNode]?]]?
    default_export_binding: ref[AstNode]?
    export_equals_binding: ref[AstNode]?
    ; esdecorator.go's state (slice 240)
    esd_top: ref[EsdLexicalEntry]?
    esd_class_info: ref[EsdClassInfo]?
    esd_class_this: ref[AstNode]?
    esd_class_super: ref[AstNode]?
    esd_pending_expressions: ref[Array[ref[AstNode]?]]?
    esd_outer_this: ref[AstNode]?
    esd_private_static_in_file: bool
    esd_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; commonjsmodule.go's state (slice 241)
    cjs_info: ref[ExternalModuleInfo]?
    cjs_unique_exports: ref[Array[Slice[char]]]?
    cjs_has_export_default: bool
    cjs_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; classfields.go's state (slice 242)
    cf_initializers_using_set: bool
    cf_initializers_using_define: bool
    cf_initializers: bool
    cf_private_elements_or_static_blocks: bool
    cf_auto_accessors: bool
    cf_this_in_static_initializers: bool
    cf_super_in_static_initializers: bool
    cf_private_static_elements_in_file: bool
    cf_legacy_decorators: bool
    cf_pending_expressions: ref[Array[ref[AstNode]?]]?
    cf_pending_statements: ref[Array[ref[AstNode]?]]?
    cf_lexical_environment: ref[ClassLexicalEnv]?
    cf_current_class_container: ref[AstNode]?
    cf_current_class_element: ref[AstNode]?
    cf_class_aliases: ref[Array[ClassAliasEntry]]?
    cf_enclosing_class_declarations: ref[Array[ref[AstNode]?]]?
    cf_in_iteration_statement: bool
    cf_inside_computed_property_name: bool
    cf_visitors: ref[Array[ref[NodeVisitor]?]]?
    cf_check_found: bool
    cf_check_class_original: ref[AstNode]?
    cf_check_class_name: ref[AstNode]?
    ; the ES downlevel transformers' state (slice 244)
    ors_in_exported_variable_statement: bool
    ors_expression_result_is_unused: bool
    ors_parameters_with_preceding: ref[Array[ref[AstNode]?]]?
    tt_declarations: ref[Array[ref[AstNode]?]]?
    fa_enclosing_function_flags: int
    fa_hierarchy_facts: int
    sa_captured_super_properties: ref[Array[Slice[char]]]?
    sa_has_super_element_access: bool
    sa_has_super_property_assignment: bool
    sa_super_binding: ref[AstNode]?
    sa_super_index_binding: ref[AstNode]?
    as_context_flags: int
    as_enclosing_function_parameter_names: ref[Array[Slice[char]]]?
    as_lexical_arguments_binding: ref[AstNode]?
    as_lexical_arguments_used: bool
    es_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; legacy decorators and metadata (slice 245)
    ld_class_aliases: ref[Array[ClassAliasEntry]]?
    ld_enclosing_classes: ref[Array[ref[AstNode]?]]?
    ld_check_found: bool
    ld_check_class_original: ref[AstNode]?
    ld_visitors: ref[Array[ref[NodeVisitor]?]]?
    md_parent: ref[AstNode]?
    md_current_lexical_scope: ref[AstNode]?
    md_current_name_scope: ref[AstNode]?
    md_strict_null_checks: bool
    md_serializing_conditional_type_branch: bool
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
)
{
    ; NewTransformer: the visitor is the context's, with this transformer as its
    ; visit callback.
    function create(host: ref[Page], tag: int, opts: TransformOptions) returns ref[Transformer]
    {
        let comps &Array[ref[Transformer]?]^host()
        let no_tag: Slice[char] ""
        let t &Transformer^host(host, tag, opts.context, opts.context.the_factory(), null, opts, null, null, comps, 0, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, false, null, null, null, false, null, false, false, false, false, false, false, false, false, false, null, null, null, null, null, null, null, false, false, null, false, null, null, false, false, null, null, 0, 0, null, false, false, null, null, 0, null, null, false, null, null, null, false, null, null, null, null, null, false, false, 0, no_tag, 0)
        let v opts.context.new_node_visitor(VisitTagTransformer)
        set v.transformer: t
        set t.visitor: v
        t
    }

    procedure record_unported(this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    function the_visitor(this) returns ref[NodeVisitor]
        visitor as ref[NodeVisitor]

    function the_checker(this) returns ref[Checker]
        opts.checker as ref[Checker]

    procedure transform_source_file(this, file: ref[AstNode]) returns ref[AstNode]
    {
        let visited this.the_visitor().visit_node(file)
        if visited = null
        {
            this.record_unported("transform-dropped-source-file", tag)
            return file
        }
        visited as ref[AstNode]
    }

    ; the one `visit` — the func value of every transformer, by tag
    procedure visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if tag = TransformerTagTypeEraser
            return this.visit_type_eraser(node)
        if tag = TransformerTagUseStrict
            return this.visit_use_strict(node)
        if tag = TransformerTagESModule
            return this.visit_es_module(node)
        if tag = TransformerTagChain
            return this.visit_chain(node)
        if tag = TransformerTagModifierVisitor
            return this.visit_modifier(node)
        if tag = TransformerTagImportElision
            return this.visit_import_elision(node)
        if tag = TransformerTagRuntimeSyntax
            return this.visit_runtime_syntax(node)
        if tag = TransformerTagConstEnumInlining
            return this.visit_const_enum_inlining(node)
        if tag = TransformerTagUsing
            return this.visit_using(node)
        if tag = TransformerTagESDecorator
            return this.visit_es_decorator(node)
        if tag = TransformerTagCommonJS
            return this.visit_common_js(node)
        if tag = TransformerTagClassFields
            return this.visit_class_fields(node)
        if tag = TransformerTagLogicalAssignment
            return this.visit_logical_assignment(node)
        if tag = TransformerTagNullishCoalescing
            return this.visit_nullish_coalescing(node)
        if tag = TransformerTagOptionalChain
            return this.visit_optional_chain(node)
        if tag = TransformerTagOptionalCatch
            return this.visit_optional_catch(node)
        if tag = TransformerTagObjectRestSpread
            return this.visit_object_rest_spread(node)
        if tag = TransformerTagForAwait
            return this.visit_for_await(node)
        if tag = TransformerTagTaggedTemplate
            return this.visit_tagged_template_lift(node)
        if tag = TransformerTagAsync
            return this.visit_async(node)
        if tag = TransformerTagExponentiation
            return this.visit_exponentiation(node)
        if tag = TransformerTagLegacyDecorators
            return this.visit_legacy_decorators(node)
        if tag = TransformerTagMetadata
            return this.visit_metadata(node)
        this.record_unported("transformer-tag", tag)
        node
    }


    ; ═══ estransforms: the ES2016–ES2021 downlevel transformers (slice 244) ═══

    ; ═══ the ES2016–ES2021 downlevel transformers (slice 244) ═══

    ; ── exponentiation.go ──
    procedure visit_exponentiation(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsExponentiationOperator) = 0
            return node
        if node.kind = KindBinaryExpression
        {
            let op AstNode.binary_operator_kind(node)
            if op = KindAsteriskAsteriskEqualsToken
                return this.exp_visit_exponentiation_assignment_expression(node)
            if op = KindAsteriskAsteriskToken
            {
                let f factory
                let v this.the_visitor()
                let args &Array[ref[AstNode]?]^host()
                args.add(v.visit_node(AstNode.binary_left_of(node)))
                args.add(v.visit_node(AstNode.binary_right_of(node)))
                let result f.new_global_method_call("Math", "pow", args)
                set result.pos: node.pos
                set result.end: node.end
                return result
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    ; a **= b  →  a = Math.pow(a, b), the target evaluated once
    procedure exp_visit_exponentiation_assignment_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let left v.visit_node(AstNode.binary_left_of(node)) as ref[AstNode]
        let right v.visit_node(AstNode.binary_right_of(node)) as ref[AstNode]
        var target left
        var value left
        if left.kind = KindElementAccessExpression
        {
            let expression_temp f.new_temp_variable()
            context.add_variable_declaration(expression_temp)
            let argument_expression_temp f.new_temp_variable()
            context.add_variable_declaration(argument_expression_temp)
            let le AstNode.expression_of(left) as ref[AstNode]
            let la AstNode.element_access_argument_of(left) as ref[AstNode]
            let obj_expr f.new_assignment_expression(expression_temp, le)
            set obj_expr.pos: le.pos
            set obj_expr.end: le.end
            let access_expr f.new_assignment_expression(argument_expression_temp, la)
            set access_expr.pos: la.pos
            set access_expr.end: la.end
            set target: f.new_element_access_expression(obj_expr, null, access_expr, NodeFlagsNone)
            set value: f.new_element_access_expression(expression_temp, null, argument_expression_temp, NodeFlagsNone)
            set value.pos: left.pos
            set value.end: left.end
        }
        else
        {
            if left.kind = KindPropertyAccessExpression
            {
                let expression_temp f.new_temp_variable()
                context.add_variable_declaration(expression_temp)
                let le AstNode.expression_of(left) as ref[AstNode]
                let assignment f.new_assignment_expression(expression_temp, le)
                set assignment.pos: le.pos
                set assignment.end: le.end
                set target: f.new_property_access_expression(assignment, null, AstNode.name_of(left), NodeFlagsNone)
                set target.pos: left.pos
                set target.end: left.end
                set value: f.new_property_access_expression(expression_temp, null, AstNode.name_of(left), NodeFlagsNone)
                set value.pos: left.pos
                set value.end: left.end
            }
        }
        let args &Array[ref[AstNode]?]^host()
        args.add(value)
        args.add(right)
        let rhs f.new_global_method_call("Math", "pow", args)
        set rhs.pos: node.pos
        set rhs.end: node.end
        let result f.new_assignment_expression(target, rhs)
        set result.pos: node.pos
        set result.end: node.end
        result
    }

    ; ── utilities.go createNotNullCondition ──
    ;   left !== null && right !== void 0     (inverted: left === null || right === void 0)
    procedure create_not_null_condition(this, left: ref[AstNode], right: ref[AstNode], invert: bool) returns ref[AstNode]
    {
        let f factory
        var token KindExclamationEqualsEqualsToken
        var op KindAmpersandAmpersandToken
        if invert
        {
            set token: KindEqualsEqualsEqualsToken
            set op: KindBarBarToken
        }
        f.new_binary_expression(null, f.new_binary_expression(null, left, null, f.new_token(token), f.new_keyword_expression(KindNullKeyword)), null, f.new_token(op), f.new_binary_expression(null, right, null, f.new_token(token), f.new_void_zero_expression()))
    }

    ; ── nullishcoalescing.go ──
    procedure visit_nullish_coalescing(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsNullishCoalescing) = 0
            return node
        if (node.kind = KindBinaryExpression) and (AstNode.binary_operator_kind(node) = KindQuestionQuestionToken)
        {
            let f factory
            let v this.the_visitor()
            var left v.visit_node(AstNode.binary_left_of(node)) as ref[AstNode]
            var right left
            if Transformer.is_simple_copiable_expression(left) = false
            {
                let temp f.new_temp_variable()
                context.add_variable_declaration(temp)
                set right: temp
                set left: f.new_assignment_expression(temp, left)
            }
            return f.new_conditional_expression(this.create_not_null_condition(left, right, false), f.new_token(KindQuestionToken), right, f.new_token(KindColonToken), v.visit_node(AstNode.binary_right_of(node)))
        }
        this.the_visitor().visit_each_child(node)
    }

    ; ── optionalcatch.go ──
    procedure visit_optional_catch(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsMissingCatchClauseVariable) = 0
            return node
        if node.kind = KindCatchClause
        {
            if AstNode.catch_variable_declaration_of(node) = null
            {
                let f factory
                return f.new_catch_clause(f.new_variable_declaration(f.new_temp_variable(), null, null, null), this.the_visitor().visit_node(AstNode.catch_block_of(node)))
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    ; ── logicalassignment.go ──
    procedure visit_logical_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsLogicalAssignments) = 0
            return node
        if node.kind <> KindBinaryExpression
            return this.the_visitor().visit_each_child(node)
        let op AstNode.binary_operator_kind(node)
        var non_assignment_operator 0
        if op = KindBarBarEqualsToken
            set non_assignment_operator: KindBarBarToken
        if op = KindAmpersandAmpersandEqualsToken
            set non_assignment_operator: KindAmpersandAmpersandToken
        if op = KindQuestionQuestionEqualsToken
            set non_assignment_operator: KindQuestionQuestionToken
        if non_assignment_operator = 0
            return this.the_visitor().visit_each_child(node)
        let f factory
        let v this.the_visitor()
        var left Parser.skip_parentheses(v.visit_node(AstNode.binary_left_of(node))) as ref[AstNode]
        var assignment_target left
        let right Parser.skip_parentheses(v.visit_node(AstNode.binary_right_of(node))) as ref[AstNode]
        if Parser.is_access_expression(left)
        {
            let le AstNode.expression_of(left) as ref[AstNode]
            var property_access_target le
            var property_access_target_assignment le
            if Transformer.is_simple_copiable_expression(le) = false
            {
                let temp f.new_temp_variable()
                context.add_variable_declaration(temp)
                set property_access_target: temp
                set property_access_target_assignment: f.new_assignment_expression(temp, le)
            }
            if left.kind = KindPropertyAccessExpression
            {
                set assignment_target: f.new_property_access_expression(property_access_target, null, AstNode.name_of(left), NodeFlagsNone)
                set left: f.new_property_access_expression(property_access_target_assignment, null, AstNode.name_of(left), NodeFlagsNone)
            }
            else
            {
                let arg AstNode.element_access_argument_of(left) as ref[AstNode]
                var element_access_argument arg
                var argument_expr arg
                if Transformer.is_simple_copiable_expression(arg) = false
                {
                    let temp f.new_temp_variable()
                    context.add_variable_declaration(temp)
                    set element_access_argument: temp
                    set argument_expr: f.new_assignment_expression(temp, arg)
                }
                set assignment_target: f.new_element_access_expression(property_access_target, null, element_access_argument, NodeFlagsNone)
                set left: f.new_element_access_expression(property_access_target_assignment, null, argument_expr, NodeFlagsNone)
            }
        }
        f.new_binary_expression(null, left, null, f.new_token(non_assignment_operator), f.new_parenthesized_expression(f.new_assignment_expression(assignment_target, right)))
    }

    ; ── taggedtemplate.go: a tagged template with an invalid escape needs the
    ;    template object helper ──
    procedure visit_tagged_template_lift(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsInvalidTemplateEscape) = 0
            return node
        if node.kind = KindSourceFile
            return this.tt_visit_source_file(node)
        if node.kind = KindTaggedTemplateExpression
            return this.tt_process_tagged_template_expression(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure tt_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        set this.current_source_file: node
        set this.tt_declarations: null
        var visited this.the_visitor().visit_each_child(node) as ref[AstNode]
        if tt_declarations <> null
        {
            let decls tt_declarations as ref[Array[ref[AstNode]?]]
            if decls.get_length() > 0
            {
                let old AstNode.statements_of(visited)
                let statements &Array[ref[AstNode]?]^host()
                Transformer.add_all(statements, old)
                statements.add(f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone)))
                var sp 0
                var se 0
                if AstNode.list_range_of(node, AstNode.statements_of(node), &sp, &se)
                    f.set_list_range(statements, sp, se)
                set visited: f.update_source_file(visited, statements, AstNode.end_of_file_token_of(visited))
            }
        }
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(visited, helper as ref[EmitHelper])
            set h: h + 1
        }
        visited
    }

    function tt_has_invalid_escape(template: ref[AstNode]) returns bool
    {
        if template.kind = KindNoSubstitutionTemplateLiteral
            return (AstNode.string_token_flags_of(template) & TokenFlagsContainsInvalidEscape) <> 0
        if (AstNode.string_token_flags_of(AstNode.template_head_of(template)) & TokenFlagsContainsInvalidEscape) <> 0
            return true
        let spans AstNode.template_expression_spans_of(template)
        if spans = null
            return false
        let ss spans as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ss.get_length() as int)
        {
            if (AstNode.string_token_flags_of(Printer.template_span_literal_of(ss[i as size_t] as ref[AstNode])) & TokenFlagsContainsInvalidEscape) <> 0
                return true
            set i: i + 1
        }
        false
    }

    ; createTemplateCooked: `void 0` for an invalid cooked string
    procedure tt_create_template_cooked(this, template: ref[AstNode]) returns ref[AstNode]
    {
        if (AstNode.string_token_flags_of(template) & TokenFlagsIsInvalid) <> 0
            return factory.new_void_zero_expression()
        factory.new_string_literal(AstNode.literal_text_of(template), TokenFlagsNone)
    }

    ; getRawLiteral: the source text between the delimiters, newlines normalized
    procedure tt_raw_literal(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let full opts.file_info.text
        let start Scanner.skip_trivia(full, node.pos)
        var end_len 2
        if (node.kind = KindNoSubstitutionTemplateLiteral) or (node.kind = KindTemplateTail)
            set end_len: 1
        let raw full.subslice((start + 1) as size_t, (node.end - end_len) as size_t)
        let buf allocate_slice[char](host, raw.length)
        var n 0
        var i 0
        while i < (raw.length as int)
        {
            let c raw[i]
            if c = ("\r" as char)
            {
                buf.put(n as size_t, "\n" as char)
                set n: n + 1
                if (i + 1 < (raw.length as int)) and (raw[i + 1] = ("\n" as char))
                    set i: i + 1
            }
            else
            {
                buf.put(n as size_t, c)
                set n: n + 1
            }
            set i: i + 1
        }
        let result f.new_string_literal(buf.subslice(0, n as size_t), TokenFlagsNone)
        set result.pos: node.pos
        set result.end: node.end
        result
    }

    procedure tt_process_tagged_template_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let tag v.visit_node(AstNode.tagged_template_tag_of(node))
        let template AstNode.tagged_template_template_of(node) as ref[AstNode]
        if Transformer.tt_has_invalid_escape(template) = false
            return v.visit_each_child(node)
        let template_arguments &Array[ref[AstNode]?]^host()
        template_arguments.add(null)
        let cooked_strings &Array[ref[AstNode]?]^host()
        let raw_strings &Array[ref[AstNode]?]^host()
        if template.kind = KindNoSubstitutionTemplateLiteral
        {
            cooked_strings.add(this.tt_create_template_cooked(template))
            raw_strings.add(this.tt_raw_literal(template))
        }
        else
        {
            let head AstNode.template_head_of(template) as ref[AstNode]
            cooked_strings.add(this.tt_create_template_cooked(head))
            raw_strings.add(this.tt_raw_literal(head))
            let spans AstNode.template_expression_spans_of(template) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (spans.get_length() as int)
            {
                let span spans[i as size_t] as ref[AstNode]
                let literal Printer.template_span_literal_of(span) as ref[AstNode]
                cooked_strings.add(this.tt_create_template_cooked(literal))
                raw_strings.add(this.tt_raw_literal(literal))
                template_arguments.add(v.visit_node(AstNode.expression_of(span)))
                set i: i + 1
            }
        }
        let helper_call f.new_template_object_helper(f.new_array_literal_expression(cooked_strings, false), f.new_array_literal_expression(raw_strings, false))
        if opts.file_info.is_external_module
        {
            let temp_var f.new_unique_name("templateObject")
            if tt_declarations = null
                set this.tt_declarations: &Array[ref[AstNode]?]^host()
            (tt_declarations as ref[Array[ref[AstNode]?]]).add(f.new_variable_declaration(temp_var, null, null, null))
            template_arguments.put(0, f.new_logical_or_expression(temp_var, f.new_assignment_expression(temp_var, helper_call)))
        }
        else
            template_arguments.put(0, helper_call)
        let call f.new_call_expression(tag, null, null, template_arguments, NodeFlagsNone)
        set call.pos: node.pos
        set call.end: node.end
        call
    }

    ; ── optionalchain.go ──
    procedure visit_optional_chain(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsOptionalChaining) = 0
            return node
        let k node.kind
        if k = KindCallExpression
            return this.oc_visit_call_expression(node, false)
        if (k = KindPropertyAccessExpression) or (k = KindElementAccessExpression)
        {
            if (node.flags & NodeFlagsOptionalChain) <> 0
                return this.oc_visit_optional_expression(node, false, false)
            return this.the_visitor().visit_each_child(node)
        }
        if k = KindDeleteExpression
            return this.oc_visit_delete_expression(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure oc_visit_call_expression(this, node: ref[AstNode], capture_this_arg: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (node.flags & NodeFlagsOptionalChain) <> 0
            return this.oc_visit_optional_expression(node, capture_this_arg, false)
        let callee AstNode.expression_of(node) as ref[AstNode]
        if callee.kind = KindParenthesizedExpression
        {
            let unwrapped Parser.skip_parentheses(callee) as ref[AstNode]
            if (unwrapped.flags & NodeFlagsOptionalChain) <> 0
            {
                let expression this.oc_visit_parenthesized_expression(callee, true, false)
                let args v.visit_nodes(AstNode.call_arguments_of(node))
                if expression.kind = KindSyntheticReferenceExpression
                {
                    let args_list &Array[ref[AstNode]?]^host()
                    Transformer.add_all(args_list, args)
                    let res f.new_function_call_call(AstNode.expression_of(expression) as ref[AstNode], AstNode.synthetic_this_arg_of(expression) as ref[AstNode], args_list)
                    set res.pos: node.pos
                    set res.end: node.end
                    context.set_original(res, node)
                    return res
                }
                return f.update_call_expression(node, expression, null, null, args, node.flags)
            }
        }
        v.visit_each_child(node)
    }

    procedure oc_visit_parenthesized_expression(this, node: ref[AstNode], capture_this_arg: bool, is_delete: bool) returns ref[AstNode]
    {
        let f factory
        let expr this.oc_visit_non_optional_expression(AstNode.expression_of(node) as ref[AstNode], capture_this_arg, is_delete)
        if expr.kind = KindSyntheticReferenceExpression
        {
            let res f.new_synthetic_reference_expression(f.update_parenthesized_expression(node, AstNode.expression_of(expr)), AstNode.synthetic_this_arg_of(expr))
            context.set_original(res, node)
            return res
        }
        f.update_parenthesized_expression(node, expr)
    }

    procedure oc_visit_property_or_element_access_expression(this, node: ref[AstNode], capture_this_arg: bool, is_delete: bool) returns ref[AstNode]
    {
        let f factory
        let v this.the_visitor()
        if (node.flags & NodeFlagsOptionalChain) <> 0
            return this.oc_visit_optional_expression(node, capture_this_arg, is_delete) as ref[AstNode]
        var expression v.visit_node(AstNode.expression_of(node)) as ref[AstNode]
        var this_arg: ref[AstNode]? null
        if capture_this_arg
        {
            if Transformer.is_simple_copiable_expression(expression) = false
            {
                let temp f.new_temp_variable()
                context.add_variable_declaration(temp)
                set this_arg: temp
                set expression: f.new_assignment_expression(temp, expression)
            }
            else
                set this_arg: expression
        }
        if node.kind = KindPropertyAccessExpression
            set expression: f.update_property_access_expression(node, expression, null, v.visit_node(AstNode.name_of(node)), node.flags)
        else
            set expression: f.update_element_access_expression(node, expression, null, v.visit_node(AstNode.element_access_argument_of(node)), node.flags)
        if this_arg <> null
        {
            let res f.new_synthetic_reference_expression(expression, this_arg)
            context.set_original(res, node)
            return res
        }
        expression
    }

    procedure oc_visit_delete_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expr AstNode.expression_of(node) as ref[AstNode]
        let unwrapped Parser.skip_parentheses(expr) as ref[AstNode]
        if (unwrapped.flags & NodeFlagsOptionalChain) <> 0
            return this.oc_visit_non_optional_expression(expr, false, true)
        this.the_visitor().visit_each_child(node)
    }

    procedure oc_visit_non_optional_expression(this, node: ref[AstNode], capture_this_arg: bool, is_delete: bool) returns ref[AstNode]
    {
        let k node.kind
        if k = KindParenthesizedExpression
            return this.oc_visit_parenthesized_expression(node, capture_this_arg, is_delete)
        if (k = KindElementAccessExpression) or (k = KindPropertyAccessExpression)
            return this.oc_visit_property_or_element_access_expression(node, capture_this_arg, is_delete)
        if k = KindCallExpression
            return this.oc_visit_call_expression(node, capture_this_arg) as ref[AstNode]
        this.the_visitor().visit_node(node) as ref[AstNode]
    }

    ; flattenChain: the links of a chain from the outermost node down to the
    ; first `?.`, and the expression under it
    procedure oc_flatten_chain(this, chain_in: ref[AstNode], links: ref[Array[ref[AstNode]?]]) returns ref[AstNode]
    {
        var chain chain_in
        let reversed &Array[ref[AstNode]?]^host()
        reversed.add(chain)
        while (chain.kind <> KindTaggedTemplateExpression) and (AstNode.question_dot_token_of(chain) = null)
        {
            set chain: Printer.skip_partially_emitted_expressions(AstNode.expression_of(chain) as ref[AstNode])
            reversed.add(chain)
        }
        var i (reversed.get_length() as int) - 1
        while i >= 0
        {
            links.add(reversed[i as size_t])
            set i: i - 1
        }
        AstNode.expression_of(chain) as ref[AstNode]
    }

    function oc_is_call_chain(node: ref[AstNode]) returns bool
        (node.kind = KindCallExpression) and ((node.flags & NodeFlagsOptionalChain) <> 0)

    procedure oc_visit_optional_expression(this, node: ref[AstNode], capture_this_arg: bool, is_delete: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let chain &Array[ref[AstNode]?]^host()
        let expression this.oc_flatten_chain(node, chain)
        let first chain[0] as ref[AstNode]
        let left this.oc_visit_non_optional_expression(Printer.skip_partially_emitted_expressions(expression), Transformer.oc_is_call_chain(first), false)
        var left_this_arg: ref[AstNode]? null
        var captured_left left
        if left.kind = KindSyntheticReferenceExpression
        {
            set left_this_arg: AstNode.synthetic_this_arg_of(left)
            set captured_left: AstNode.expression_of(left) as ref[AstNode]
        }
        var left_expression f.restore_outer_expressions(expression, captured_left, OEKPartiallyEmittedExpressions) as ref[AstNode]
        if Transformer.is_simple_copiable_expression(captured_left) = false
        {
            let temp f.new_temp_variable()
            context.add_variable_declaration(temp)
            set captured_left: temp
            set left_expression: f.new_assignment_expression(temp, left_expression)
        }
        var right_expression captured_left
        var this_arg: ref[AstNode]? null
        let n chain.get_length() as int
        var i 0
        while i < n
        {
            let segment chain[i as size_t] as ref[AstNode]
            let sk segment.kind
            if (sk = KindElementAccessExpression) or (sk = KindPropertyAccessExpression)
            {
                if (i = (n - 1)) and capture_this_arg
                {
                    if Transformer.is_simple_copiable_expression(right_expression) = false
                    {
                        let temp f.new_temp_variable()
                        context.add_variable_declaration(temp)
                        set this_arg: temp
                        set right_expression: f.new_assignment_expression(temp, right_expression)
                    }
                    else
                        set this_arg: right_expression
                }
                if sk = KindElementAccessExpression
                    set right_expression: f.new_element_access_expression(right_expression, null, v.visit_node(AstNode.element_access_argument_of(segment)), NodeFlagsNone)
                else
                    set right_expression: f.new_property_access_expression(right_expression, null, v.visit_node(AstNode.name_of(segment)), NodeFlagsNone)
            }
            if sk = KindCallExpression
            {
                if (i = 0) and (left_this_arg <> null)
                {
                    var lta left_this_arg as ref[AstNode]
                    if context.has_auto_generate_info(lta) = false
                    {
                        set lta: f.clone(lta)
                        context.add_emit_flags(lta, EFNoComments)
                    }
                    var call_this_arg lta
                    if lta.kind = KindSuperKeyword
                        set call_this_arg: f.new_this_expression()
                    let args_list &Array[ref[AstNode]?]^host()
                    Transformer.add_all(args_list, v.visit_nodes(AstNode.call_arguments_of(segment)))
                    set right_expression: f.new_function_call_call(right_expression, call_this_arg, args_list)
                }
                else
                    set right_expression: f.new_call_expression(right_expression, null, null, v.visit_nodes(AstNode.call_arguments_of(segment)), NodeFlagsNone)
            }
            context.set_original(right_expression, segment)
            set i: i + 1
        }
        var target: ref[AstNode]? null
        if is_delete
            set target: f.new_conditional_expression(this.create_not_null_condition(left_expression, captured_left, true), f.new_token(KindQuestionToken), f.new_true_expression(), f.new_token(KindColonToken), f.new_delete_expression(right_expression))
        else
            set target: f.new_conditional_expression(this.create_not_null_condition(left_expression, captured_left, true), f.new_token(KindQuestionToken), f.new_void_zero_expression(), f.new_token(KindColonToken), right_expression)
        var t target as ref[AstNode]
        set t.pos: node.pos
        set t.end: node.end
        if this_arg <> null
            set t: f.new_synthetic_reference_expression(t, this_arg)
        context.set_original(t, node)
        t
    }

    ; ── objectrestspread.go ──
    procedure visit_object_rest_spread(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if ((Emitter.subtree_facts(node) & SubtreeContainsESObjectRestOrSpread) = 0) and (ors_parameters_with_preceding = null)
            return node
        let expression_result_is_unused ors_expression_result_is_unused
        set this.ors_expression_result_is_unused: false
        let result this.ors_visit_worker(node, expression_result_is_unused)
        set this.ors_expression_result_is_unused: expression_result_is_unused
        result
    }

    procedure ors_visit_worker(this, node: ref[AstNode], expression_result_is_unused: bool) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if k = KindSourceFile
        {
            let visited v.visit_each_child(node) as ref[AstNode]
            let helpers context.read_emit_helpers()
            var h 0
            while h < (helpers.get_length() as int)
            {
                let helper helpers[h as size_t]
                if helper <> null
                    context.add_emit_helper(visited, helper as ref[EmitHelper])
                set h: h + 1
            }
            return visited
        }
        if k = KindObjectLiteralExpression
            return this.ors_visit_object_literal_expression(node)
        if k = KindBinaryExpression
            return this.ors_visit_binary_expression(node, expression_result_is_unused)
        if k = KindExpressionStatement
        {
            set this.ors_expression_result_is_unused: true
            return v.visit_each_child(node)
        }
        if k = KindParenthesizedExpression
        {
            set this.ors_expression_result_is_unused: expression_result_is_unused
            return v.visit_each_child(node)
        }
        if k = KindForOfStatement
            return this.ors_visit_for_of_statement(node)
        if k = KindVariableStatement
            return this.ors_visit_variable_statement(node)
        if k = KindVariableDeclaration
            return this.ors_visit_variable_declaration(node)
        if k = KindCatchClause
            return this.ors_visit_catch_clause(node)
        if k = KindParameter
            return this.ors_visit_parameter(node)
        if (k = KindConstructor) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindMethodDeclaration) or (k = KindFunctionDeclaration) or (k = KindArrowFunction) or (k = KindFunctionExpression)
            return this.ors_visit_function_like(node)
        v.visit_each_child(node)
    }

    procedure ors_visit_parameter(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if ors_parameters_with_preceding <> null
        {
            if Transformer.list_contains(ors_parameters_with_preceding, node)
            {
                var name AstNode.name_of(node)
                if AstNode.is_binding_pattern(name)
                    set name: f.new_generated_name_for_node(node)
                return f.update_parameter_declaration(node, null, AstNode.dot_dot_dot_token_of(node), name, null, null, null)
            }
        }
        if (Emitter.subtree_facts(node) & SubtreeContainsObjectRestOrSpread) <> 0
            return f.update_parameter_declaration(node, null, AstNode.dot_dot_dot_token_of(node), f.new_generated_name_for_node(node), null, null, v.visit_node(AstNode.initializer_of(node)))
        v.visit_each_child(node)
    }

    ; collectParametersWithPrecedingObjectRestOrSpread: the parameters AFTER the
    ; first one carrying an object rest or spread, else null
    procedure ors_collect_parameters_with_preceding(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        var result: ref[Array[ref[AstNode]?]]? null
        let params AstNode.parameters_of(node)
        if params = null
            return null
        let ps params as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ps.get_length() as int)
        {
            let parameter ps[i as size_t] as ref[AstNode]
            if result <> null
                (result as ref[Array[ref[AstNode]?]]).add(parameter)
            else
            {
                if (Emitter.subtree_facts(parameter) & SubtreeContainsObjectRestOrSpread) <> 0
                    set result: &Array[ref[AstNode]?]^host()
            }
            set i: i + 1
        }
        result
    }

    ; the seven function-like visitors, each entering a parameter list context
    procedure ors_visit_function_like(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let old ors_parameters_with_preceding
        set this.ors_parameters_with_preceding: this.ors_collect_parameters_with_preceding(node)
        var result: ref[AstNode]? null
        let k node.kind
        let modifiers Printer.modifier_list_of(node)
        if k = KindConstructor
            set result: f.update_constructor_declaration(node, modifiers, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        if k = KindGetAccessor
            set result: f.update_get_accessor_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        if k = KindSetAccessor
            set result: f.update_set_accessor_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        if k = KindMethodDeclaration
            set result: f.update_method_declaration(node, modifiers, AstNode.asterisk_token_of(node), v.visit_node(AstNode.name_of(node)), AstNode.postfix_token_of(node), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        if k = KindFunctionDeclaration
            set result: f.update_function_declaration(node, modifiers, AstNode.asterisk_token_of(node), v.visit_node(AstNode.name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        if k = KindArrowFunction
            set result: f.update_arrow_function(node, modifiers, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, AstNode.equals_greater_than_token_of(node), this.ors_transform_function_body(node))
        if k = KindFunctionExpression
            set result: f.update_function_expression(node, modifiers, AstNode.asterisk_token_of(node), v.visit_node(AstNode.name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, this.ors_transform_function_body(node))
        set this.ors_parameters_with_preceding: old
        result
    }

    ; transformFunctionBody: the hoisted declarations of the body and the
    ; parameters' rest assignments go in front of it
    procedure ors_transform_function_body(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        context.start_variable_environment()
        var body v.visit_node(AstNode.body_of(node))
        let extras_in context.end_variable_environment()
        context.start_variable_environment()
        let new_statements this.ors_collect_object_rest_assignments(node)
        let extras context.end_and_merge_variable_environment(extras_in) as ref[Array[ref[AstNode]?]]
        if (new_statements.get_length() = 0) and (extras.get_length() = 0)
            return body
        if body = null
            set body: f.new_block(&Array[ref[AstNode]?]^host(), true)
        let b body as ref[AstNode]
        let prefix &Array[ref[AstNode]?]^host()
        let suffix &Array[ref[AstNode]?]^host()
        var block b
        if b.kind = KindBlock
        {
            let statements AstNode.statements_of(b) as ref[Array[ref[AstNode]?]]
            var custom false
            var i 0
            var rest_from (statements.get_length() as int)
            while i < (statements.get_length() as int)
            {
                let statement statements[i as size_t] as ref[AstNode]
                if (custom = false) and EmitContext.is_prologue_directive(statement)
                    prefix.add(statement)
                else
                {
                    if (context.emit_flags(statement) & EFCustomPrologue) <> 0
                    {
                        set custom: true
                        prefix.add(statement)
                    }
                    else
                    {
                        set rest_from: i
                        break
                    }
                }
                set i: i + 1
            }
            Transformer.add_all(suffix, Transformer.sub_list(host, statements, rest_from, statements.get_length() as int))
        }
        else
        {
            let ret f.new_return_statement(b)
            set ret.pos: b.pos
            set ret.end: b.end
            let list &Array[ref[AstNode]?]^host()
            f.set_list_range(list, b.pos, b.end)
            set block: f.new_block(list, true)
            suffix.add(ret)
        }
        let all &Array[ref[AstNode]?]^host()
        Transformer.add_all(all, prefix)
        Transformer.add_all(all, extras)
        Transformer.add_all(all, new_statements)
        Transformer.add_all(all, suffix)
        let old_list AstNode.statements_of(block)
        f.update_block(block, f.new_node_list_like(all, old_list), AstNode.multi_line_of(block))
    }

    ; the flattened declarations of one binding, as a `var` statement marked custom prologue
    procedure ors_declaration_statement(this, declarations: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let decls &Array[ref[AstNode]?]^host()
        if declarations.kind = KindSyntaxList
            Transformer.add_all(decls, AstNode.elements_of(declarations))
        else
            decls.add(declarations)
        let statement f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone))
        context.add_emit_flags(statement, EFCustomPrologue)
        statement
    }

    ; collectObjectRestAssignments
    procedure ors_collect_object_rest_assignments(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let f factory
        let v this.the_visitor()
        let results &Array[ref[AstNode]?]^host()
        let params AstNode.parameters_of(node)
        if params = null
            return results
        let ps params as ref[Array[ref[AstNode]?]]
        var contains_preceding false
        var i 0
        while i < (ps.get_length() as int)
        {
            let parameter ps[i as size_t] as ref[AstNode]
            set i: i + 1
            let name AstNode.name_of(parameter) as ref[AstNode]
            let initializer AstNode.initializer_of(parameter)
            if contains_preceding
            {
                if AstNode.is_binding_pattern(name)
                {
                    let elements AstNode.elements_of(name)
                    if Transformer.list_is_empty(elements) = false
                    {
                        let declarations Flattener.flatten_destructuring_binding(host, this, parameter, f.new_generated_name_for_node(parameter), FlattenLevelAll, false, false)
                        if declarations <> null
                            results.add(this.ors_declaration_statement(declarations as ref[AstNode]))
                    }
                    else
                    {
                        if initializer <> null
                        {
                            let statement f.new_expression_statement(f.new_assignment_expression(f.new_generated_name_for_node(parameter), v.visit_node(initializer)))
                            context.add_emit_flags(statement, EFCustomPrologue)
                            results.add(statement)
                        }
                    }
                }
                else
                {
                    if initializer <> null
                    {
                        ; if (name === void 0) { name = initializer; }
                        let pn f.clone(name)
                        set pn.pos: name.pos
                        set pn.end: name.end
                        context.add_emit_flags(pn, EFNoSourceMap)
                        let init_visited v.visit_node(initializer) as ref[AstNode]
                        context.add_emit_flags(init_visited, EFNoSourceMap | EFNoComments)
                        let assignment f.new_assignment_expression(pn, init_visited)
                        set assignment.pos: parameter.pos
                        set assignment.end: parameter.end
                        context.add_emit_flags(assignment, EFNoComments)
                        let one &Array[ref[AstNode]?]^host()
                        one.add(f.new_expression_statement(assignment))
                        let block f.new_block(one, false)
                        set block.pos: parameter.pos
                        set block.end: parameter.end
                        context.add_emit_flags(block, EFSingleLine | EFNoTrailingSourceMap | EFNoTokenSourceMaps | EFNoComments)
                        let undefined_text: Slice[char] "undefined"
                        let type_check f.new_type_check(f.clone(pn), undefined_text)
                        let statement f.new_if_statement(type_check, block, null)
                        set statement.pos: parameter.pos
                        set statement.end: parameter.end
                        context.add_emit_flags(statement, EFNoTokenSourceMaps | EFNoTrailingSourceMap | EFCustomPrologue | EFNoComments | EFStartOnNewLine)
                        results.add(statement)
                    }
                }
                continue
            }
            if (Emitter.subtree_facts(parameter) & SubtreeContainsObjectRestOrSpread) <> 0
            {
                set contains_preceding: true
                let declarations Flattener.flatten_destructuring_binding(host, this, parameter, f.new_generated_name_for_node(parameter), FlattenLevelObjectRest, false, true)
                if declarations <> null
                    results.add(this.ors_declaration_statement(declarations as ref[AstNode]))
            }
        }
        results
    }

    procedure ors_visit_catch_clause(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let decl AstNode.catch_variable_declaration_of(node)
        if decl <> null
        {
            let d decl as ref[AstNode]
            let name AstNode.name_of(d) as ref[AstNode]
            if AstNode.is_binding_pattern(name) and ((Emitter.subtree_facts(name) & SubtreeContainsObjectRestOrSpread) <> 0)
            {
                let temp f.new_generated_name_for_node(name)
                let updated_decl f.update_variable_declaration(d, name, null, null, temp)
                let visited_bindings Flattener.flatten_destructuring_binding(host, this, updated_decl, null, FlattenLevelObjectRest, false, false)
                var block v.visit_node(AstNode.catch_block_of(node)) as ref[AstNode]
                if visited_bindings <> null
                {
                    let vb visited_bindings as ref[AstNode]
                    let decls &Array[ref[AstNode]?]^host()
                    if vb.kind = KindSyntaxList
                        Transformer.add_all(decls, AstNode.elements_of(vb))
                    else
                        decls.add(vb)
                    let new_statement f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone))
                    let old AstNode.statements_of(block)
                    let statements &Array[ref[AstNode]?]^host()
                    statements.add(new_statement)
                    Transformer.add_all(statements, old)
                    set block: f.update_block(block, f.new_node_list_like(statements, old), AstNode.multi_line_of(block))
                }
                return f.update_catch_clause(node, f.update_variable_declaration(d, temp, null, null, null), block)
            }
        }
        v.visit_each_child(node)
    }

    procedure ors_visit_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        {
            let old ors_in_exported_variable_statement
            set this.ors_in_exported_variable_statement: true
            let result this.the_visitor().visit_each_child(node)
            set this.ors_in_exported_variable_statement: old
            return result
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure ors_visit_variable_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if ors_in_exported_variable_statement
        {
            set this.ors_in_exported_variable_statement: false
            let result this.ors_visit_variable_declaration_worker(node, true)
            set this.ors_in_exported_variable_statement: true
            return result
        }
        this.ors_visit_variable_declaration_worker(node, false)
    }

    procedure ors_visit_variable_declaration_worker(this, node: ref[AstNode], exported: bool) returns ref[AstNode]?
    {
        if AstNode.is_binding_pattern(AstNode.name_of(node)) and ((Emitter.subtree_facts(node) & SubtreeContainsObjectRestOrSpread) <> 0)
            return Flattener.flatten_destructuring_binding(host, this, node, null, FlattenLevelObjectRest, exported, false)
        this.the_visitor().visit_each_child(node)
    }

    procedure ors_visit_for_of_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        var needs (Emitter.subtree_facts(initializer) & SubtreeContainsObjectRestOrSpread) <> 0
        if Emitter.is_assignment_pattern(initializer) and Emitter.contains_object_rest_or_spread(initializer)
            set needs: true
        if needs
        {
            let initializer_without_parens Parser.skip_parentheses(initializer) as ref[AstNode]
            if (initializer_without_parens.kind = KindVariableDeclarationList) or Emitter.is_assignment_pattern(initializer_without_parens)
            {
                var body_pos 0 - 1
                var body_end 0 - 1
                var statements_pos 0 - 1
                var statements_end 0 - 1
                let temp f.new_temp_variable()
                let res v.visit_node(f.create_for_of_binding_statement(initializer_without_parens, temp))
                let statements &Array[ref[AstNode]?]^host()
                if res <> null
                    statements.add(res)
                let body Printer.statement_body_of(node)
                if body <> null
                {
                    let bd body as ref[AstNode]
                    if bd.kind = KindBlock
                    {
                        let bs AstNode.statements_of(bd) as ref[Array[ref[AstNode]?]]
                        var i 0
                        while i < (bs.get_length() as int)
                        {
                            let visited v.visit_each_child(bs[i as size_t])
                            if visited <> null
                                statements.add(visited)
                            set i: i + 1
                        }
                        set body_pos: bd.pos
                        set body_end: bd.end
                        AstNode.list_range_of(bd, bs, &statements_pos, &statements_end)
                    }
                    else
                    {
                        statements.add(v.visit_each_child(bd))
                        set body_pos: bd.pos
                        set body_end: bd.end
                        set statements_pos: bd.pos
                        set statements_end: bd.end
                    }
                }
                let decls &Array[ref[AstNode]?]^host()
                decls.add(f.new_variable_declaration(temp, null, null, null))
                let list f.new_variable_declaration_list(decls, NodeFlagsLet)
                set list.pos: initializer.pos
                set list.end: initializer.end
                let expr v.visit_each_child(AstNode.expression_of(node))
                f.set_list_range(statements, statements_pos, statements_end)
                let block f.new_block(statements, true)
                set block.pos: body_pos
                set block.end: body_end
                return f.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), list, expr, block)
            }
        }
        v.visit_each_child(node)
    }

    procedure ors_visit_binary_expression(this, node: ref[AstNode], expression_result_is_unused: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if Binder.is_destructuring_assignment(node) and Emitter.contains_object_rest_or_spread(AstNode.binary_left_of(node) as ref[AstNode])
            return Flattener.flatten_destructuring_assignment(host, this, node, expression_result_is_unused = false, FlattenLevelObjectRest, FlattenCallbackNone)
        if AstNode.binary_operator_kind(node) = KindCommaToken
        {
            set this.ors_expression_result_is_unused: true
            let left v.visit_node(AstNode.binary_left_of(node))
            set this.ors_expression_result_is_unused: expression_result_is_unused
            let right v.visit_node(AstNode.binary_right_of(node))
            return f.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), right)
        }
        v.visit_each_child(node)
    }

    ; visitObjectLiteralExpression: `{ a, ...b, c }` → `Object.assign({ a }, b, { c })`
    procedure ors_visit_object_literal_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if (Emitter.subtree_facts(node) & SubtreeContainsObjectRestOrSpread) = 0
            return this.the_visitor().visit_each_child(node)
        let objects this.ors_chunk_object_literal_elements(AstNode.properties_of(node))
        if objects.get_length() = 0
            return this.the_visitor().visit_each_child(node)
        var all objects
        if AstNode.kind_of(objects[0]) <> KindObjectLiteralExpression
        {
            set all: &Array[ref[AstNode]?]^host()
            all.add(f.new_object_literal_expression(&Array[ref[AstNode]?]^host(), false))
            Transformer.add_all(all, objects)
        }
        if all.get_length() > 1
        {
            var expression all[0] as ref[AstNode]
            var i 1
            while i < (all.get_length() as int)
            {
                let pair &Array[ref[AstNode]?]^host()
                pair.add(expression)
                pair.add(all[i as size_t])
                set expression: f.new_assign_helper(pair)
                set i: i + 1
            }
            return expression
        }
        f.new_assign_helper(all)
    }

    procedure ors_chunk_object_literal_elements(this, list: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]
    {
        let f factory
        let v this.the_visitor()
        let objects &Array[ref[AstNode]?]^host()
        if list = null
            return objects
        let elements list as ref[Array[ref[AstNode]?]]
        var chunk_object &Array[ref[AstNode]?]^host()
        var i 0
        while i < (elements.get_length() as int)
        {
            let e elements[i as size_t] as ref[AstNode]
            if e.kind = KindSpreadAssignment
            {
                if chunk_object.get_length() > 0
                {
                    objects.add(f.new_object_literal_expression(chunk_object, false))
                    set chunk_object: &Array[ref[AstNode]?]^host()
                }
                objects.add(v.visit_node(AstNode.expression_of(e)))
            }
            else
            {
                if e.kind = KindPropertyAssignment
                    chunk_object.add(f.new_property_assignment(null, AstNode.name_of(e), null, null, v.visit_node(AstNode.initializer_of(e))))
                else
                    chunk_object.add(v.visit_node(e))
            }
            set i: i + 1
        }
        if chunk_object.get_length() > 0
            objects.add(f.new_object_literal_expression(chunk_object, false))
        objects
    }

    ; ── utilities.go superAccessState: `super.x` inside an async body becomes
    ;    `_super.x` over an `Object.create(null, { x: { get: () => super.x } })` ──
    procedure sa_reset(this)
    {
        let f factory
        let empty: Slice[char] ""
        let super_text: Slice[char] "_super"
        let super_index_text: Slice[char] "_superIndex"
        set this.sa_captured_super_properties: &Array[Slice[char]]^host()
        set this.sa_has_super_element_access: false
        set this.sa_has_super_property_assignment: false
        set this.sa_super_binding: f.new_unique_name_ex(super_text, GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsFileLevel, empty, empty)
        set this.sa_super_index_binding: f.new_unique_name_ex(super_index_text, GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsFileLevel, empty, empty)
    }

    function sa_captured_count(this) returns int
    {
        if sa_captured_super_properties = null
            return 0
        (sa_captured_super_properties as ref[Array[Slice[char]]]).get_length() as int
    }

    ; the super-access visitor
    procedure sa_visit_super_access_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let sv this.es_visitor(EsSubSuperAccess)
        let k node.kind
        if k = KindCallExpression
        {
            if Checker.is_super_property(AstNode.expression_of(node))
                return this.sa_substitute_call_expression_with_super_access(node, sv)
            return sv.visit_each_child(node)
        }
        if k = KindPropertyAccessExpression
        {
            if AstNode.kind_of(AstNode.expression_of(node)) = KindSuperKeyword
                return f.new_property_access_expression(sa_super_binding, null, AstNode.name_of(node), NodeFlagsNone)
            return sv.visit_each_child(node)
        }
        if k = KindElementAccessExpression
        {
            if AstNode.kind_of(AstNode.expression_of(node)) = KindSuperKeyword
                return this.sa_create_super_element_access_in_async_method(AstNode.element_access_argument_of(node) as ref[AstNode])
            return sv.visit_each_child(node)
        }
        if (k = KindFunctionExpression) or (k = KindFunctionDeclaration) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindConstructor) or (k = KindClassDeclaration) or (k = KindClassExpression)
            return node
        sv.visit_each_child(node)
    }

    procedure sa_substitute_super_accesses_in_body(this, body: ref[AstNode]) returns ref[AstNode]
    {
        let sv this.es_visitor(EsSubSuperAccess)
        sv.visit_node(body) as ref[AstNode]
    }

    procedure sa_substitute_call_expression_with_super_access(this, call: ref[AstNode], visitor: ref[NodeVisitor]) returns ref[AstNode]?
    {
        let f factory
        let expression AstNode.expression_of(call) as ref[AstNode]
        var target: ref[AstNode]? null
        if expression.kind = KindPropertyAccessExpression
            set target: f.new_property_access_expression(sa_super_binding, null, AstNode.name_of(expression), NodeFlagsNone)
        else
        {
            if expression.kind = KindElementAccessExpression
                set target: this.sa_create_super_element_access_in_async_method(AstNode.element_access_argument_of(expression) as ref[AstNode])
            else
                return visitor.visit_each_child(call)
        }
        let call_target f.new_property_access_expression(target, null, f.new_identifier("call"), NodeFlagsNone)
        let all_args &Array[ref[AstNode]?]^host()
        all_args.add(f.new_this_expression())
        Transformer.add_all(all_args, visitor.visit_nodes(AstNode.call_arguments_of(call)))
        let result f.new_call_expression(call_target, null, null, all_args, NodeFlagsNone)
        set result.pos: call.pos
        set result.end: call.end
        result
    }

    procedure sa_create_super_element_access_in_async_method(this, argument_expression: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let args &Array[ref[AstNode]?]^host()
        args.add(argument_expression)
        let super_index_call f.new_call_expression(sa_super_index_binding, null, null, args, NodeFlagsNone)
        if sa_has_super_property_assignment
            return f.new_property_access_expression(super_index_call, null, f.new_identifier("value"), NodeFlagsNone)
        super_index_call
    }

    ; createSuperAccessVariableStatement:
    ;   const _super = Object.create(null, { x: { get: () => super.x[, set: v => super.x = v] } });
    procedure sa_create_super_access_variable_statement(this) returns ref[AstNode]
    {
        let f factory
        let accessors &Array[ref[AstNode]?]^host()
        let names sa_captured_super_properties as ref[Array[Slice[char]]]
        var i 0
        while i < (names.get_length() as int)
        {
            let name names[i as size_t]
            let descriptor_properties &Array[ref[AstNode]?]^host()
            let getter_body f.new_property_access_expression(f.new_keyword_expression(KindSuperKeyword), null, f.new_identifier(name), NodeFlagsNone)
            let no_params &Array[ref[AstNode]?]^host()
            let getter_arrow f.new_arrow_function(null, null, no_params, null, null, f.new_token(KindEqualsGreaterThanToken), getter_body)
            descriptor_properties.add(f.new_property_assignment(null, f.new_identifier("get"), null, null, getter_arrow))
            if sa_has_super_property_assignment
            {
                let v_param f.new_parameter_declaration(null, null, f.new_identifier("v"), null, null, null)
                let super_prop f.new_property_access_expression(f.new_keyword_expression(KindSuperKeyword), null, f.new_identifier(name), NodeFlagsNone)
                let assign_expr f.new_assignment_expression(super_prop, f.new_identifier("v"))
                let params &Array[ref[AstNode]?]^host()
                params.add(v_param)
                let setter_arrow f.new_arrow_function(null, null, params, null, null, f.new_token(KindEqualsGreaterThanToken), assign_expr)
                descriptor_properties.add(f.new_property_assignment(null, f.new_identifier("set"), null, null, setter_arrow))
            }
            let descriptor f.new_object_literal_expression(descriptor_properties, false)
            accessors.add(f.new_property_assignment(null, f.new_identifier(name), null, null, descriptor))
            set i: i + 1
        }
        let descriptors_object f.new_object_literal_expression(accessors, true)
        let create_args &Array[ref[AstNode]?]^host()
        create_args.add(f.new_keyword_expression(KindNullKeyword))
        create_args.add(descriptors_object)
        let object_create_call f.new_call_expression(f.new_property_access_expression(f.new_identifier("Object"), null, f.new_identifier("create"), NodeFlagsNone), null, null, create_args, NodeFlagsNone)
        let decls &Array[ref[AstNode]?]^host()
        decls.add(f.new_variable_declaration(sa_super_binding, null, null, object_create_call))
        f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsConst))
    }

    ; trackSuperAccess: what the body reads and writes through `super`
    procedure sa_track_super_access(this, node: ref[AstNode])
    {
        if sa_captured_super_properties = null
            return
        let names sa_captured_super_properties as ref[Array[Slice[char]]]
        let k node.kind
        if k = KindPropertyAccessExpression
        {
            if AstNode.kind_of(AstNode.expression_of(node)) = KindSuperKeyword
            {
                let text AstNode.identifier_text_of(AstNode.name_of(node))
                if Transformer.names_contain(names, text) = false
                    names.add(text)
            }
            return
        }
        if k = KindElementAccessExpression
        {
            if AstNode.kind_of(AstNode.expression_of(node)) = KindSuperKeyword
                set this.sa_has_super_element_access: true
            return
        }
        if k = KindBinaryExpression
        {
            if Parser.is_assignment_operator(AstNode.binary_operator_kind(node)) and Transformer.sa_assignment_target_contains_super_property(AstNode.binary_left_of(node) as ref[AstNode])
                set this.sa_has_super_property_assignment: true
            return
        }
        if k = KindPrefixUnaryExpression
        {
            if Transformer.sa_is_update_expression(node) and Transformer.sa_assignment_target_contains_super_property(AstNode.prefix_unary_operand_of(node) as ref[AstNode])
                set this.sa_has_super_property_assignment: true
            return
        }
        if k = KindPostfixUnaryExpression
        {
            if Transformer.sa_is_update_expression(node) and Transformer.sa_assignment_target_contains_super_property(AstNode.postfix_unary_operand_of(node) as ref[AstNode])
                set this.sa_has_super_property_assignment: true
        }
    }

    function sa_assignment_target_contains_super_property(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if (k = KindPropertyAccessExpression) or (k = KindElementAccessExpression)
            return AstNode.kind_of(AstNode.expression_of(node)) = KindSuperKeyword
        if k = KindParenthesizedExpression
            return Transformer.sa_assignment_target_contains_super_property(AstNode.expression_of(node) as ref[AstNode])
        if k = KindArrayLiteralExpression
        {
            let elements AstNode.elements_of(node) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                if Transformer.sa_assignment_target_contains_super_property(elements[i as size_t] as ref[AstNode])
                    return true
                set i: i + 1
            }
            return false
        }
        if k = KindObjectLiteralExpression
        {
            let props AstNode.properties_of(node) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (props.get_length() as int)
            {
                let prop props[i as size_t] as ref[AstNode]
                if prop.kind = KindPropertyAssignment
                {
                    if Transformer.sa_assignment_target_contains_super_property(AstNode.initializer_of(prop) as ref[AstNode])
                        return true
                }
                if prop.kind = KindShorthandPropertyAssignment
                {
                    if Transformer.sa_assignment_target_contains_super_property(AstNode.name_of(prop) as ref[AstNode])
                        return true
                }
                if prop.kind = KindSpreadAssignment
                {
                    if Transformer.sa_assignment_target_contains_super_property(AstNode.expression_of(prop) as ref[AstNode])
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if k = KindSpreadElement
            return Transformer.sa_assignment_target_contains_super_property(AstNode.expression_of(node) as ref[AstNode])
        false
    }

    function sa_is_update_expression(node: ref[AstNode]) returns bool
    {
        var op 0
        if node.kind = KindPrefixUnaryExpression
            set op: AstNode.prefix_unary_operator_kind(node)
        if node.kind = KindPostfixUnaryExpression
            set op: AstNode.postfix_unary_operator_of(node)
        (op = KindPlusPlusToken) or (op = KindMinusMinusToken)
    }

    ; isSimpleParameterList: identifiers without initializers
    function es_is_simple_parameter_list(params: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if params = null
            return true
        let ps params as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ps.get_length() as int)
        {
            let p ps[i as size_t] as ref[AstNode]
            if AstNode.initializer_of(p) <> null
                return false
            if AstNode.kind_of(AstNode.name_of(p)) <> KindIdentifier
                return false
            set i: i + 1
        }
        true
    }

    function es_function_flags(this, node: ref[AstNode]) returns int
        (opts.binder as ref[Binder]).get_function_flags(node)

    ; ── forawait.go: `for await` and async generators below ES2018 ──
    ; forAwaitHierarchyFacts
    function fa_affects_subtree(this, exclude_facts: int, include_facts: int) returns bool
        fa_hierarchy_facts <> ((fa_hierarchy_facts & (FaFactsAncestorMask xor exclude_facts)) | include_facts)

    procedure fa_enter_subtree(this, exclude_facts: int, include_facts: int) returns int
    {
        let ancestor_facts fa_hierarchy_facts
        set this.fa_hierarchy_facts: ((fa_hierarchy_facts & (FaFactsAncestorMask xor exclude_facts)) | include_facts) & FaFactsAncestorMask
        ancestor_facts
    }

    ; fallbackVisitor: a subtree without the facts still tracks `super` accesses
    procedure fa_fallback_visitor(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if sa_captured_super_properties = null
            return node
        let k node.kind
        if (k = KindFunctionExpression) or (k = KindFunctionDeclaration) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindConstructor)
            return node
        this.sa_track_super_access(node)
        let fv this.es_visitor(EsSubFaFallback)
        fv.visit_each_child(node)
    }

    procedure visit_for_await(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsForAwaitOrAsyncGenerator) = 0
            return this.fa_fallback_visitor(node)
        this.sa_track_super_access(node)
        let k node.kind
        if k = KindSourceFile
            return this.fa_visit_source_file(node)
        if k = KindAwaitExpression
            return this.fa_visit_await_expression(node)
        if k = KindYieldExpression
            return this.fa_visit_yield_expression(node)
        if k = KindReturnStatement
            return this.fa_visit_return_statement(node)
        if k = KindLabeledStatement
            return this.fa_visit_labeled_statement(node)
        if (k = KindDoStatement) or (k = KindWhileStatement) or (k = KindForInStatement) or (k = KindForStatement)
            return this.fa_with_facts(node, FaFactsIterationStatementExcludes, FaFactsIterationStatementIncludes, 0)
        if k = KindForOfStatement
            return this.fa_visit_for_of_statement(node, null)
        if k = KindConstructor
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 1)
        if k = KindMethodDeclaration
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 2)
        if k = KindGetAccessor
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 3)
        if k = KindSetAccessor
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 4)
        if k = KindFunctionDeclaration
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 5)
        if k = KindFunctionExpression
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 6)
        if k = KindArrowFunction
            return this.fa_with_facts(node, FaFactsArrowFunctionExcludes, FaFactsArrowFunctionIncludes, 7)
        if (k = KindClassDeclaration) or (k = KindClassExpression)
            return this.fa_with_facts(node, FaFactsClassOrFunctionExcludes, FaFactsClassOrFunctionIncludes, 0)
        this.the_visitor().visit_each_child(node)
    }

    ; doWithHierarchyFacts(cb, node, exclude, include); the callback as a number
    procedure fa_with_facts(this, node: ref[AstNode], exclude_facts: int, include_facts: int, which: int) returns ref[AstNode]?
    {
        if this.fa_affects_subtree(exclude_facts, include_facts)
        {
            let ancestor_facts this.fa_enter_subtree(exclude_facts, include_facts)
            let result this.fa_callback(node, which)
            set this.fa_hierarchy_facts: ancestor_facts
            return result
        }
        this.fa_callback(node, which)
    }

    procedure fa_callback(this, node: ref[AstNode], which: int) returns ref[AstNode]?
    {
        if which = 1
            return this.fa_visit_constructor_declaration(node)
        if which = 2
            return this.fa_visit_method_declaration(node)
        if which = 3
            return this.fa_visit_accessor_declaration(node, true)
        if which = 4
            return this.fa_visit_accessor_declaration(node, false)
        if which = 5
            return this.fa_visit_function_declaration(node)
        if which = 6
            return this.fa_visit_function_expression(node)
        if which = 7
            return this.fa_visit_arrow_function(node)
        this.the_visitor().visit_each_child(node)
    }

    function fa_is_async_generator(this) returns bool
        ((fa_enclosing_function_flags & FunctionFlagsAsync) <> 0) and ((fa_enclosing_function_flags & FunctionFlagsGenerator) <> 0)

    procedure fa_visit_await_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if this.fa_is_async_generator()
        {
            let result f.new_yield_expression(null, f.new_await_helper(this.the_visitor().visit_node(AstNode.expression_of(node)) as ref[AstNode]))
            set result.pos: node.pos
            set result.end: node.end
            context.set_original(result, node)
            return result
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure fa_visit_yield_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if this.fa_is_async_generator()
        {
            if AstNode.asterisk_token_of(node) <> null
            {
                let expression v.visit_node(AstNode.expression_of(node)) as ref[AstNode]
                let async_values_result f.new_async_values_helper(expression)
                set async_values_result.pos: expression.pos
                set async_values_result.end: expression.end
                let async_delegator_result f.new_async_delegator_helper(async_values_result)
                set async_delegator_result.pos: expression.pos
                set async_delegator_result.end: expression.end
                let inner_yield f.update_yield_expression(node, AstNode.asterisk_token_of(node), async_delegator_result)
                let awaited_yield f.new_await_helper(inner_yield)
                let result f.new_yield_expression(null, awaited_yield)
                set result.pos: node.pos
                set result.end: node.end
                context.set_original(result, node)
                return result
            }
            var inner_expression: ref[AstNode]? null
            if AstNode.expression_of(node) <> null
                set inner_expression: v.visit_node(AstNode.expression_of(node))
            else
                set inner_expression: f.new_void_zero_expression()
            let result f.new_yield_expression(null, this.fa_create_downlevel_await(inner_expression as ref[AstNode]))
            set result.pos: node.pos
            set result.end: node.end
            context.set_original(result, node)
            return result
        }
        v.visit_each_child(node)
    }

    procedure fa_visit_return_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if this.fa_is_async_generator()
        {
            var expression: ref[AstNode]? null
            if AstNode.expression_of(node) <> null
                set expression: this.the_visitor().visit_node(AstNode.expression_of(node))
            else
                set expression: f.new_void_zero_expression()
            return f.update_return_statement(node, this.fa_create_downlevel_await(expression as ref[AstNode]))
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure fa_visit_labeled_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (fa_enclosing_function_flags & FunctionFlagsAsync) <> 0
        {
            let statement Transformer.unwrap_innermost_statement_of_label(node)
            if (statement.kind = KindForOfStatement) and (AstNode.for_await_modifier_of(statement) <> null)
                return this.fa_visit_for_of_statement(statement, node)
            return factory.restore_enclosing_label(this.the_visitor().visit_node(statement) as ref[AstNode], node)
        }
        this.the_visitor().visit_each_child(node)
    }

    function unwrap_innermost_statement_of_label(node: ref[AstNode]) returns ref[AstNode]
    {
        var n node
        while true
        {
            let statement Printer.statement_body_of(n) as ref[AstNode]
            if statement.kind <> KindLabeledStatement
                return statement
            set n: statement
        }
        n
    }

    procedure fa_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let ancestor_facts this.fa_enter_subtree(FaFactsSourceFileExcludes, FaFactsNone)
        set this.ors_in_exported_variable_statement: false
        let visited this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(visited, helper as ref[EmitHelper])
            set h: h + 1
        }
        set this.fa_hierarchy_facts: ancestor_facts
        visited
    }

    procedure fa_visit_for_of_statement(this, node: ref[AstNode], outermost_labeled_statement: ref[AstNode]?) returns ref[AstNode]?
    {
        let ancestor_facts this.fa_enter_subtree(FaFactsIterationStatementExcludes, FaFactsIterationStatementIncludes)
        var result: ref[AstNode]? null
        if AstNode.for_await_modifier_of(node) <> null
            set result: this.fa_transform_for_await_of_statement(node, outermost_labeled_statement, ancestor_facts)
        else
            set result: factory.restore_enclosing_label(this.the_visitor().visit_each_child(node) as ref[AstNode], outermost_labeled_statement)
        set this.fa_hierarchy_facts: ancestor_facts
        result
    }

    ; convertForOfStatementHead: the body block with the bound value and the
    ; non-user-code flag in front
    procedure fa_convert_for_of_statement_head(this, node: ref[AstNode], bound_value: ref[AstNode], non_user_code: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let v this.the_visitor()
        let expr AstNode.expression_of(node) as ref[AstNode]
        let value f.new_temp_variable()
        context.add_variable_declaration(value)
        let iterator_value_statement f.new_expression_statement(f.new_assignment_expression(value, bound_value))
        context.set_source_map_range(iterator_value_statement, TextRange(expr.pos, expr.end))
        let exit_non_user_code_statement f.new_expression_statement(f.new_assignment_expression(non_user_code, f.new_keyword_expression(KindFalseKeyword)))
        context.set_source_map_range(exit_non_user_code_statement, TextRange(expr.pos, expr.end))
        let statements &Array[ref[AstNode]?]^host()
        statements.add(iterator_value_statement)
        statements.add(exit_non_user_code_statement)
        let binding f.create_for_of_binding_statement(AstNode.initializer_of(node) as ref[AstNode], value)
        statements.add(v.visit_node(binding))
        var body_pos 0 - 1
        var body_end 0 - 1
        var statements_pos 0 - 1
        var statements_end 0 - 1
        let statement v.visit_embedded_statement(Printer.statement_body_of(node)) as ref[AstNode]
        if statement.kind = KindBlock
        {
            let bs AstNode.statements_of(statement)
            Transformer.add_all(statements, bs)
            set body_pos: statement.pos
            set body_end: statement.end
            AstNode.list_range_of(statement, bs, &statements_pos, &statements_end)
        }
        else
            statements.add(statement)
        f.set_list_range(statements, statements_pos, statements_end)
        let block f.new_block(statements, true)
        set block.pos: body_pos
        set block.end: body_end
        block
    }

    procedure fa_create_downlevel_await(this, expression: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if (fa_enclosing_function_flags & FunctionFlagsGenerator) <> 0
            return f.new_yield_expression(null, f.new_await_helper(expression))
        f.new_await_expression(expression)
    }

    ; transformForAwaitOfStatement: the try/catch/finally over __asyncValues
    procedure fa_transform_for_await_of_statement(this, node: ref[AstNode], outermost_labeled_statement: ref[AstNode]?, ancestor_facts: int) returns ref[AstNode]
    {
        let f factory
        let v this.the_visitor()
        let node_expr AstNode.expression_of(node) as ref[AstNode]
        let expression v.visit_node(node_expr) as ref[AstNode]
        var iterator: ref[AstNode]? null
        var result: ref[AstNode]? null
        if expression.kind = KindIdentifier
        {
            set iterator: f.new_generated_name_for_node(expression)
            set result: f.new_generated_name_for_node(iterator as ref[AstNode])
        }
        else
        {
            set iterator: f.new_temp_variable()
            set result: f.new_temp_variable()
        }
        let it iterator as ref[AstNode]
        let res result as ref[AstNode]
        let non_user_code f.new_temp_variable()
        let done f.new_temp_variable()
        context.add_variable_declaration(done)
        let error_record f.new_unique_name("e")
        let catch_variable f.new_generated_name_for_node(error_record)
        let return_method f.new_temp_variable()
        let call_values f.new_async_values_helper(expression)
        set call_values.pos: node_expr.pos
        set call_values.end: node_expr.end
        let no_args &Array[ref[AstNode]?]^host()
        let call_next f.new_call_expression(f.new_property_access_expression(it, null, f.new_identifier("next"), NodeFlagsNone), null, null, no_args, NodeFlagsNone)
        let get_done f.new_property_access_expression(res, null, f.new_identifier("done"), NodeFlagsNone)
        let get_value f.new_property_access_expression(res, null, f.new_identifier("value"), NodeFlagsNone)
        let no_args2 &Array[ref[AstNode]?]^host()
        let call_return f.new_function_call_call(return_method, it, no_args2)
        context.add_variable_declaration(error_record)
        context.add_variable_declaration(return_method)
        var initializer: ref[AstNode]? null
        if (ancestor_facts & FaFactsIterationContainer) <> 0
        {
            let both &Array[ref[AstNode]?]^host()
            both.add(f.new_assignment_expression(error_record, f.new_void_zero_expression()))
            both.add(call_values)
            set initializer: f.inline_expressions(both)
        }
        else
            set initializer: call_values
        let iterator_decl f.new_variable_declaration(it, null, null, initializer)
        set iterator_decl.pos: node_expr.pos
        set iterator_decl.end: node_expr.end
        let decls &Array[ref[AstNode]?]^host()
        decls.add(f.new_variable_declaration(non_user_code, null, null, f.new_keyword_expression(KindTrueKeyword)))
        decls.add(iterator_decl)
        decls.add(f.new_variable_declaration(res, null, null, null))
        let var_decl_list f.new_variable_declaration_list(decls, NodeFlagsNone)
        set var_decl_list.pos: node_expr.pos
        set var_decl_list.end: node_expr.end
        let cond_parts &Array[ref[AstNode]?]^host()
        cond_parts.add(f.new_assignment_expression(res, this.fa_create_downlevel_await(call_next)))
        cond_parts.add(f.new_assignment_expression(done, get_done))
        cond_parts.add(f.new_prefix_unary_expression(KindExclamationToken, done))
        let condition f.inline_expressions(cond_parts)
        let incrementor f.new_assignment_expression(non_user_code, f.new_keyword_expression(KindTrueKeyword))
        let for_statement f.new_for_statement(var_decl_list, condition, incrementor, this.fa_convert_for_of_statement_head(node, get_value, non_user_code))
        set for_statement.pos: node.pos
        set for_statement.end: node.end
        context.add_emit_flags(for_statement, EFNoTokenTrailingSourceMaps)
        context.set_original(for_statement, node)
        let try_statements &Array[ref[AstNode]?]^host()
        try_statements.add(f.restore_enclosing_label(for_statement, outermost_labeled_statement))
        let try_block f.new_block(try_statements, true)
        let catch_props &Array[ref[AstNode]?]^host()
        catch_props.add(f.new_property_assignment(null, f.new_identifier("error"), null, null, catch_variable))
        let catch_statements &Array[ref[AstNode]?]^host()
        catch_statements.add(f.new_expression_statement(f.new_assignment_expression(error_record, f.new_object_literal_expression(catch_props, false))))
        let catch_body f.new_block(catch_statements, false)
        context.add_emit_flags(catch_body, EFSingleLine)
        let catch_clause f.new_catch_clause(f.new_variable_declaration(catch_variable, null, null, null), catch_body)
        let inner_if_condition f.new_binary_expression(null, f.new_binary_expression(null, f.new_prefix_unary_expression(KindExclamationToken, non_user_code), null, f.new_token(KindAmpersandAmpersandToken), f.new_prefix_unary_expression(KindExclamationToken, done)), null, f.new_token(KindAmpersandAmpersandToken), f.new_assignment_expression(return_method, f.new_property_access_expression(it, null, f.new_identifier("return"), NodeFlagsNone)))
        let inner_if_statement f.new_if_statement(inner_if_condition, f.new_expression_statement(this.fa_create_downlevel_await(call_return)), null)
        context.add_emit_flags(inner_if_statement, EFSingleLine)
        let inner_try_statements &Array[ref[AstNode]?]^host()
        inner_try_statements.add(inner_if_statement)
        let inner_try_block f.new_block(inner_try_statements, false)
        let inner_finally_if f.new_if_statement(error_record, f.new_throw_statement(f.new_property_access_expression(error_record, null, f.new_identifier("error"), NodeFlagsNone)), null)
        context.add_emit_flags(inner_finally_if, EFSingleLine)
        let inner_finally_statements &Array[ref[AstNode]?]^host()
        inner_finally_statements.add(inner_finally_if)
        let inner_finally_block f.new_block(inner_finally_statements, false)
        context.add_emit_flags(inner_finally_block, EFSingleLine)
        let inner_try_statement f.new_try_statement(inner_try_block, null, inner_finally_block)
        let finally_statements &Array[ref[AstNode]?]^host()
        finally_statements.add(inner_try_statement)
        let finally_block f.new_block(finally_statements, true)
        f.new_try_statement(try_block, catch_clause, finally_block)
    }

    procedure fa_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        let updated f.update_constructor_declaration(node, Printer.modifier_list_of(node), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, context.visit_function_body(AstNode.body_of(node), v))
        set this.fa_enclosing_function_flags: saved
        updated
    }

    procedure fa_visit_accessor_declaration(this, node: ref[AstNode], is_get: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        var updated: ref[AstNode]? null
        if is_get
            set updated: f.update_get_accessor_declaration(node, Printer.modifier_list_of(node), v.visit_node(AstNode.name_of(node)), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, context.visit_function_body(AstNode.body_of(node), v))
        else
            set updated: f.update_set_accessor_declaration(node, Printer.modifier_list_of(node), v.visit_node(AstNode.name_of(node)), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, context.visit_function_body(AstNode.body_of(node), v))
        set this.fa_enclosing_function_flags: saved
        updated
    }

    ; the modifiers without `async` (noAsyncModifierVisitor)
    procedure fa_modifiers_no_async(this, modifiers: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let nv this.es_visitor(EsSubNoAsyncModifier)
        nv.visit_modifiers(modifiers)
    }

    ; the shared shape of visitMethodDeclaration / visitFunctionDeclaration / visitFunctionExpression
    procedure fa_visit_method_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        var modifiers Printer.modifier_list_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsGenerator) <> 0
            set modifiers: this.fa_modifiers_no_async(modifiers)
        var asterisk_token AstNode.asterisk_token_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsAsync) <> 0
            set asterisk_token: null
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if this.fa_is_async_generator()
        {
            set parameters: this.fa_transform_async_generator_function_parameter_list(node)
            set body: this.fa_transform_async_generator_function_body(node)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_method_declaration(node, modifiers, asterisk_token, v.visit_node(AstNode.name_of(node)), null, null, parameters, null, null, body)
        set this.fa_enclosing_function_flags: saved
        updated
    }

    procedure fa_visit_function_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        var modifiers Printer.modifier_list_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsGenerator) <> 0
            set modifiers: this.fa_modifiers_no_async(modifiers)
        var asterisk_token AstNode.asterisk_token_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsAsync) <> 0
            set asterisk_token: null
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if this.fa_is_async_generator()
        {
            set parameters: this.fa_transform_async_generator_function_parameter_list(node)
            set body: this.fa_transform_async_generator_function_body(node)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_function_declaration(node, modifiers, asterisk_token, AstNode.name_of(node), null, parameters, null, null, body)
        set this.fa_enclosing_function_flags: saved
        updated
    }

    procedure fa_visit_function_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        var modifiers Printer.modifier_list_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsGenerator) <> 0
            set modifiers: this.fa_modifiers_no_async(modifiers)
        var asterisk_token AstNode.asterisk_token_of(node)
        if (fa_enclosing_function_flags & FunctionFlagsAsync) <> 0
            set asterisk_token: null
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if this.fa_is_async_generator()
        {
            set parameters: this.fa_transform_async_generator_function_parameter_list(node)
            set body: this.fa_transform_async_generator_function_body(node)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_function_expression(node, modifiers, asterisk_token, AstNode.name_of(node), null, parameters, null, null, body)
        set this.fa_enclosing_function_flags: saved
        updated
    }

    procedure fa_visit_arrow_function(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved fa_enclosing_function_flags
        set this.fa_enclosing_function_flags: this.es_function_flags(node)
        let updated f.update_arrow_function(node, Printer.modifier_list_of(node), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, AstNode.equals_greater_than_token_of(node), context.visit_function_body(AstNode.body_of(node), v))
        set this.fa_enclosing_function_flags: saved
        updated
    }

    ; transformAsyncGeneratorFunctionParameterList: the outer parameters of a
    ; non-simple list are generated names up to the first initializer or rest
    procedure fa_transform_async_generator_function_parameter_list(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        let v this.the_visitor()
        let params AstNode.parameters_of(node)
        if Transformer.es_is_simple_parameter_list(params)
            return context.visit_parameters(params, v)
        let new_parameters &Array[ref[AstNode]?]^host()
        let ps params as ref[Array[ref[AstNode]?]]
        let empty: Slice[char] ""
        var i 0
        while i < (ps.get_length() as int)
        {
            let param ps[i as size_t] as ref[AstNode]
            if (AstNode.initializer_of(param) <> null) or (AstNode.dot_dot_dot_token_of(param) <> null)
                break
            new_parameters.add(f.new_parameter_declaration(null, null, f.new_generated_name_for_node_ex(AstNode.name_of(param) as ref[AstNode], GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty), null, null, null))
            set i: i + 1
        }
        var pp 0
        var pe 0
        if AstNode.list_range_of(node, ps, &pp, &pe)
            f.set_list_range(new_parameters, pp, pe)
        new_parameters
    }

    ; transformAsyncGeneratorFunctionBody: `return __asyncGenerator(this, arguments, function* () { ... })`
    procedure fa_transform_async_generator_function_body(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let v this.the_visitor()
        var inner_parameters: ref[Array[ref[AstNode]?]]? null
        if Transformer.es_is_simple_parameter_list(AstNode.parameters_of(node)) = false
            set inner_parameters: context.visit_parameters(AstNode.parameters_of(node), v)
        let saved_captured sa_captured_super_properties
        let saved_element sa_has_super_element_access
        let saved_assignment sa_has_super_property_assignment
        let saved_super sa_super_binding
        let saved_super_index sa_super_index_binding
        this.sa_reset()
        let body AstNode.body_of(node) as ref[AstNode]
        var async_body f.update_block(body, v.visit_nodes(AstNode.statements_of(body)), AstNode.multi_line_of(body))
        set async_body: f.update_block(async_body, context.end_and_merge_variable_environment(AstNode.statements_of(async_body)), AstNode.multi_line_of(async_body))
        let emit_super_helpers (this.sa_captured_count() > 0) or sa_has_super_element_access
        if emit_super_helpers
            set async_body: this.sa_substitute_super_accesses_in_body(async_body)
        var inner_params inner_parameters
        if inner_params = null
            set inner_params: &Array[ref[AstNode]?]^host()
        var name: ref[AstNode]? null
        if AstNode.name_of(node) <> null
            set name: f.new_generated_name_for_node(AstNode.name_of(node) as ref[AstNode])
        let generator_func f.new_function_expression(null, f.new_token(KindAsteriskToken), name, null, inner_params, null, null, async_body)
        let return_statement f.new_return_statement(f.new_async_generator_helper(generator_func, (fa_hierarchy_facts & FaFactsHasLexicalThis) <> 0))
        context.start_variable_environment()
        if emit_super_helpers
        {
            if this.sa_captured_count() > 0
                context.add_initialization_statement(this.sa_create_super_access_variable_statement())
        }
        let outer_statements &Array[ref[AstNode]?]^host()
        outer_statements.add(return_statement)
        let block f.update_block(body, context.end_and_merge_variable_environment(outer_statements), AstNode.multi_line_of(body))
        if emit_super_helpers and sa_has_super_element_access
        {
            if sa_has_super_property_assignment
                context.add_emit_helper(block, context.helpers.advanced_async_super_helper)
            else
                context.add_emit_helper(block, context.helpers.async_super_helper)
        }
        set this.sa_captured_super_properties: saved_captured
        set this.sa_has_super_element_access: saved_element
        set this.sa_has_super_property_assignment: saved_assignment
        set this.sa_super_binding: saved_super
        set this.sa_super_index_binding: saved_super_index
        block
    }

    ; ── async.go: `async` functions below ES2017 through __awaiter ──
    function as_in_context(this, flags: int) returns bool
        (as_context_flags & flags) <> 0

    procedure as_set_context_flag(this, flag: int, on: bool)
    {
        if on
            set this.as_context_flags: as_context_flags | flag
        else
            set this.as_context_flags: as_context_flags & (SubtreeFactsAllBits xor flag)
    }

    ; fallbackVisitor: no await in the subtree, but `super` accesses and a
    ; captured `arguments` are still tracked and substituted
    procedure as_fallback_visitor(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (sa_captured_super_properties = null) and (as_lexical_arguments_binding = null)
            return node
        this.sa_track_super_access(node)
        let k node.kind
        if (k = KindFunctionExpression) or (k = KindFunctionDeclaration) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindConstructor)
            return node
        if (k = KindIdentifier) and (as_lexical_arguments_binding <> null)
        {
            let text AstNode.identifier_text_of(node)
            if text.equals("arguments") and (Binder.is_identifier_name(node) = false) and (Transformer.is_label_name(node) = false)
            {
                set this.as_lexical_arguments_used: true
                return as_lexical_arguments_binding
            }
        }
        let fv this.es_visitor(EsSubAsFallback)
        fv.visit_each_child(node)
    }

    ; ast.IsLabelName: the label of a labeled, break or continue statement
    function is_label_name(node: ref[AstNode]) returns bool
    {
        let parent AstNode.parent_node_of(node)
        if parent = null
            return false
        let p parent as ref[AstNode]
        if (p.kind <> KindLabeledStatement) and (p.kind <> KindBreakStatement) and (p.kind <> KindContinueStatement)
            return false
        AstNode.label_name_of(p) = node
    }

    procedure visit_async(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        var restore_lexical_this false
        if ((context.emit_flags(node) & EFNoLexicalThis) <> 0) and this.as_in_context(AsContextHasLexicalThis)
        {
            this.as_set_context_flag(AsContextHasLexicalThis, false)
            set restore_lexical_this: true
        }
        let result this.as_visit_worker(node)
        if restore_lexical_this
            this.as_set_context_flag(AsContextHasLexicalThis, true)
        result
    }

    procedure as_visit_worker(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & (SubtreeContainsAnyAwait | SubtreeContainsAwait)) = 0
            return this.as_fallback_visitor(node)
        this.sa_track_super_access(node)
        let k node.kind
        if k = KindAsyncKeyword
            return null
        if k = KindSourceFile
            return this.as_visit_source_file(node)
        if k = KindAwaitExpression
            return this.as_visit_await_expression(node)
        if k = KindMethodDeclaration
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 1)
        if k = KindFunctionDeclaration
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 2)
        if k = KindFunctionExpression
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 3)
        if k = KindArrowFunction
            return this.as_with_context(AsContextNonTopLevel, node, 4)
        if k = KindGetAccessor
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 5)
        if k = KindSetAccessor
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 6)
        if k = KindConstructor
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 7)
        if (k = KindClassDeclaration) or (k = KindClassExpression)
            return this.as_with_context(AsContextNonTopLevel | AsContextHasLexicalThis, node, 0)
        this.the_visitor().visit_each_child(node)
    }

    ; doWithContext(flags, cb, node)
    procedure as_with_context(this, flags: int, node: ref[AstNode], which: int) returns ref[AstNode]?
    {
        let flags_to_set flags & (SubtreeFactsAllBits xor as_context_flags)
        if flags_to_set <> 0
        {
            this.as_set_context_flag(flags_to_set, true)
            let result this.as_callback(node, which)
            this.as_set_context_flag(flags_to_set, false)
            return result
        }
        this.as_callback(node, which)
    }

    procedure as_callback(this, node: ref[AstNode], which: int) returns ref[AstNode]?
    {
        if which = 1
            return this.as_visit_method_declaration(node)
        if which = 2
            return this.as_visit_function_declaration(node)
        if which = 3
            return this.as_visit_function_expression(node)
        if which = 4
            return this.as_visit_arrow_function(node)
        if which = 5
            return this.as_visit_accessor_declaration(node, true)
        if which = 6
            return this.as_visit_accessor_declaration(node, false)
        if which = 7
            return this.as_visit_constructor_declaration(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure as_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.file_info.is_declaration_file
            return node
        this.as_set_context_flag(AsContextNonTopLevel, false)
        this.as_set_context_flag(AsContextHasLexicalThis, false)
        let visited this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(visited, helper as ref[EmitHelper])
            set h: h + 1
        }
        visited
    }

    ; visitAsyncBodyNode: the hoisting statements of an async body
    procedure as_visit_async_body_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if Transformer.as_is_node_with_possible_hoisted_declaration(node)
        {
            if k = KindVariableStatement
                return this.as_visit_variable_statement_in_async_body(node)
            if k = KindForStatement
                return this.as_visit_for_statement_in_async_body(node)
            if k = KindForInStatement
                return this.as_visit_for_in_or_of_statement_in_async_body(node, false)
            if k = KindForOfStatement
                return this.as_visit_for_in_or_of_statement_in_async_body(node, true)
            if k = KindCatchClause
                return this.as_visit_catch_clause_in_async_body(node)
            let bv this.es_visitor(EsSubAsBody)
            return bv.visit_each_child(node)
        }
        this.visit_async(node)
    }

    function as_is_node_with_possible_hoisted_declaration(node: ref[AstNode]) returns bool
    {
        let k node.kind
        (k = KindBlock) or (k = KindVariableStatement) or (k = KindWithStatement) or (k = KindIfStatement) or (k = KindSwitchStatement) or (k = KindCaseBlock) or (k = KindCaseClause) or (k = KindDefaultClause) or (k = KindLabeledStatement) or (k = KindForStatement) or (k = KindForInStatement) or (k = KindForOfStatement) or (k = KindDoStatement) or (k = KindWhileStatement) or (k = KindTryStatement) or (k = KindCatchClause)
    }

    procedure as_visit_catch_clause_in_async_body(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let bv this.es_visitor(EsSubAsBody)
        let catch_clause_names &Array[Slice[char]]^host()
        let decl AstNode.catch_variable_declaration_of(node)
        if decl <> null
            this.as_record_declaration_name(decl as ref[AstNode], catch_clause_names)
        var unshadowed: ref[Array[Slice[char]]]? null
        if as_enclosing_function_parameter_names <> null
        {
            let enclosing as_enclosing_function_parameter_names as ref[Array[Slice[char]]]
            var i 0
            while i < (catch_clause_names.get_length() as int)
            {
                let name catch_clause_names[i as size_t]
                if Transformer.names_contain(enclosing, name)
                {
                    if unshadowed = null
                    {
                        let copy &Array[Slice[char]]^host()
                        var j 0
                        while j < (enclosing.get_length() as int)
                        {
                            copy.add(enclosing[j as size_t])
                            set j: j + 1
                        }
                        set unshadowed: copy
                    }
                    set unshadowed: this.as_remove_name(unshadowed as ref[Array[Slice[char]]], name)
                }
                set i: i + 1
            }
        }
        if unshadowed <> null
        {
            let saved as_enclosing_function_parameter_names
            set this.as_enclosing_function_parameter_names: unshadowed
            let result bv.visit_each_child(node)
            set this.as_enclosing_function_parameter_names: saved
            return result
        }
        bv.visit_each_child(node)
    }

    ; the list without `name` (an Array does not shrink; a copy is the spelling)
    procedure as_remove_name(this, list: ref[Array[Slice[char]]], name: Slice[char]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        var i 0
        let n list.get_length() as int
        while i < n
        {
            let e list[i as size_t]
            if e.equals(name) = false
                out.add(e)
            set i: i + 1
        }
        out
    }

    procedure as_visit_variable_statement_in_async_body(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let decl_list Printer.declaration_list_of(node) as ref[AstNode]
        if this.as_is_variable_declaration_list_with_colliding_name(decl_list)
        {
            let expression this.as_visit_variable_declaration_list_with_colliding_names(decl_list, false)
            if expression <> null
                return factory.new_expression_statement(expression)
            return null
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure as_visit_for_in_or_of_statement_in_async_body(this, node: ref[AstNode], is_of: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let bv this.es_visitor(EsSubAsBody)
        let initializer AstNode.initializer_of(node)
        var visited_initializer: ref[AstNode]? null
        if this.as_is_variable_declaration_list_with_colliding_name(initializer)
            set visited_initializer: this.as_visit_variable_declaration_list_with_colliding_names(initializer as ref[AstNode], true)
        else
            set visited_initializer: v.visit_node(initializer)
        var await_modifier: ref[AstNode]? null
        if is_of
            set await_modifier: v.visit_node(AstNode.for_await_modifier_of(node))
        f.update_for_in_or_of_statement(node, await_modifier, visited_initializer, v.visit_node(AstNode.expression_of(node)), bv.visit_embedded_statement(Printer.statement_body_of(node)))
    }

    procedure as_visit_for_statement_in_async_body(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let bv this.es_visitor(EsSubAsBody)
        let initializer AstNode.initializer_of(node)
        var visited_initializer: ref[AstNode]? null
        if (initializer <> null) and this.as_is_variable_declaration_list_with_colliding_name(initializer)
            set visited_initializer: this.as_visit_variable_declaration_list_with_colliding_names(initializer as ref[AstNode], false)
        else
            set visited_initializer: v.visit_node(initializer)
        f.update_for_statement(node, visited_initializer, v.visit_node(AstNode.for_condition_of(node)), v.visit_node(AstNode.for_incrementor_of(node)), bv.visit_embedded_statement(Printer.statement_body_of(node)))
    }

    procedure as_visit_await_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.as_in_context(AsContextNonTopLevel) = false
            return this.the_visitor().visit_each_child(node)
        let yield_expr factory.new_yield_expression(null, this.the_visitor().visit_node(AstNode.expression_of(node)))
        set yield_expr.pos: node.pos
        set yield_expr.end: node.end
        context.set_original(yield_expr, node)
        yield_expr
    }

    procedure as_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        set this.as_lexical_arguments_binding: null
        set this.as_lexical_arguments_used: false
        let updated f.update_constructor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, this.as_transform_method_body(node))
        set this.as_lexical_arguments_binding: saved_binding
        set this.as_lexical_arguments_used: saved_used
        updated
    }

    procedure as_visit_method_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let function_flags this.es_function_flags(node)
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        set this.as_lexical_arguments_binding: null
        set this.as_lexical_arguments_used: false
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if (function_flags & FunctionFlagsAsync) <> 0
        {
            set parameters: this.as_transform_async_function_parameter_list(node)
            set body: this.as_transform_async_function_body(node, parameters)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: this.as_transform_method_body(node)
        }
        let updated f.update_method_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), AstNode.name_of(node), null, null, parameters, null, null, body)
        set this.as_lexical_arguments_binding: saved_binding
        set this.as_lexical_arguments_used: saved_used
        updated
    }

    procedure as_visit_accessor_declaration(this, node: ref[AstNode], is_get: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        set this.as_lexical_arguments_binding: null
        set this.as_lexical_arguments_used: false
        var updated: ref[AstNode]? null
        if is_get
            set updated: f.update_get_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.name_of(node), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, this.as_transform_method_body(node))
        else
            set updated: f.update_set_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.name_of(node), null, context.visit_parameters(AstNode.parameters_of(node), v), null, null, this.as_transform_method_body(node))
        set this.as_lexical_arguments_binding: saved_binding
        set this.as_lexical_arguments_used: saved_used
        updated
    }

    procedure as_visit_function_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let function_flags this.es_function_flags(node)
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        set this.as_lexical_arguments_binding: null
        set this.as_lexical_arguments_used: false
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if (function_flags & FunctionFlagsAsync) <> 0
        {
            set parameters: this.as_transform_async_function_parameter_list(node)
            set body: this.as_transform_async_function_body(node, parameters)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_function_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(AstNode.name_of(node)), null, parameters, null, null, body)
        set this.as_lexical_arguments_binding: saved_binding
        set this.as_lexical_arguments_used: saved_used
        updated
    }

    procedure as_visit_function_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let function_flags this.es_function_flags(node)
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        set this.as_lexical_arguments_binding: null
        set this.as_lexical_arguments_used: false
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if (function_flags & FunctionFlagsAsync) <> 0
        {
            set parameters: this.as_transform_async_function_parameter_list(node)
            set body: this.as_transform_async_function_body(node, parameters)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_function_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(AstNode.name_of(node)), null, parameters, null, null, body)
        set this.as_lexical_arguments_binding: saved_binding
        set this.as_lexical_arguments_used: saved_used
        updated
    }

    procedure as_visit_arrow_function(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        var restore false
        var saved_binding as_lexical_arguments_binding
        var saved_used as_lexical_arguments_used
        if (context.emit_flags(node) & EFNoLexicalArguments) <> 0
        {
            set restore: true
            set this.as_lexical_arguments_binding: null
            set this.as_lexical_arguments_used: false
        }
        let function_flags this.es_function_flags(node)
        var parameters: ref[Array[ref[AstNode]?]]? null
        var body: ref[AstNode]? null
        if (function_flags & FunctionFlagsAsync) <> 0
        {
            set parameters: this.as_transform_async_function_parameter_list(node)
            set body: this.as_transform_async_function_body(node, parameters)
        }
        else
        {
            set parameters: context.visit_parameters(AstNode.parameters_of(node), v)
            set body: context.visit_function_body(AstNode.body_of(node), v)
        }
        let updated f.update_arrow_function(node, v.visit_modifiers(Printer.modifier_list_of(node)), null, parameters, null, null, AstNode.equals_greater_than_token_of(node), body)
        if restore
        {
            set this.as_lexical_arguments_binding: saved_binding
            set this.as_lexical_arguments_used: saved_used
        }
        updated
    }

    procedure as_record_declaration_name(this, node: ref[AstNode], names: ref[Array[Slice[char]]])
    {
        let name AstNode.name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            let text AstNode.identifier_text_of(nm)
            if Transformer.names_contain(names, text) = false
                names.add(text)
            return
        }
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let element elements[i as size_t] as ref[AstNode]
                if element.kind <> KindOmittedExpression
                    this.as_record_declaration_name(element, names)
                set i: i + 1
            }
        }
    }

    function as_is_variable_declaration_list_with_colliding_name(this, node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if n.kind <> KindVariableDeclarationList
            return false
        if (n.flags & NodeFlagsBlockScoped) <> 0
            return false
        let decls Printer.declarations_of(n) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (decls.get_length() as int)
        {
            if this.as_collides_with_parameter_name(decls[i as size_t] as ref[AstNode])
                return true
            set i: i + 1
        }
        false
    }

    procedure as_visit_variable_declaration_list_with_colliding_names(this, node: ref[AstNode], has_receiver: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        this.as_hoist_variable_declaration_list(node)
        let decls Printer.declarations_of(node) as ref[Array[ref[AstNode]?]]
        let variables &Array[ref[AstNode]?]^host()
        var i 0
        while i < (decls.get_length() as int)
        {
            let decl decls[i as size_t] as ref[AstNode]
            if AstNode.initializer_of(decl) <> null
                variables.add(decl)
            set i: i + 1
        }
        if variables.get_length() = 0
        {
            if has_receiver
            {
                let name AstNode.name_of(decls[0]) as ref[AstNode]
                var target name
                if AstNode.is_binding_pattern(name)
                    set target: Transformer.convert_binding_pattern_to_assignment_pattern(context, name)
                return v.visit_node(target)
            }
            return null
        }
        let expressions &Array[ref[AstNode]?]^host()
        var j 0
        while j < (variables.get_length() as int)
        {
            expressions.add(this.as_transform_initialized_variable(variables[j as size_t] as ref[AstNode]))
            set j: j + 1
        }
        f.inline_expressions(expressions)
    }

    procedure as_hoist_variable_declaration_list(this, node: ref[AstNode])
    {
        let decls Printer.declarations_of(node) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (decls.get_length() as int)
        {
            this.as_hoist_variable(decls[i as size_t] as ref[AstNode])
            set i: i + 1
        }
    }

    procedure as_hoist_variable(this, node: ref[AstNode])
    {
        let name AstNode.name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            context.add_variable_declaration(nm)
            return
        }
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let element elements[i as size_t] as ref[AstNode]
                if element.kind <> KindOmittedExpression
                    this.as_hoist_variable(element)
                set i: i + 1
            }
        }
    }

    procedure as_transform_initialized_variable(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let name AstNode.name_of(node) as ref[AstNode]
        var target name
        if AstNode.is_binding_pattern(name)
            set target: Transformer.convert_binding_pattern_to_assignment_pattern(context, name)
        let converted f.new_assignment_expression(target, AstNode.initializer_of(node))
        context.set_source_map_range(converted, TextRange(node.pos, node.end))
        this.the_visitor().visit_node(converted)
    }

    function as_collides_with_parameter_name(this, node: ref[AstNode]) returns bool
    {
        let name AstNode.name_of(node)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            if as_enclosing_function_parameter_names = null
                return false
            return Transformer.names_contain(as_enclosing_function_parameter_names as ref[Array[Slice[char]]], AstNode.identifier_text_of(nm))
        }
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let element elements[i as size_t] as ref[AstNode]
                if (element.kind <> KindOmittedExpression) and this.as_collides_with_parameter_name(element)
                    return true
                set i: i + 1
            }
        }
        false
    }

    ; transformMethodBody: a non-async method still gets its `super` accesses
    ; captured for a nested async arrow
    procedure as_transform_method_body(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let saved_captured sa_captured_super_properties
        let saved_element sa_has_super_element_access
        let saved_assignment sa_has_super_property_assignment
        let saved_super sa_super_binding
        let saved_super_index sa_super_index_binding
        this.sa_reset()
        context.start_variable_environment()
        var updated context.visit_function_body(AstNode.body_of(node), v)
        var emit_super_helpers (this.sa_captured_count() > 0) or sa_has_super_element_access
        if emit_super_helpers
        {
            let original_flags this.es_function_flags(this.as_original_if_function_like(node))
            if (original_flags & FunctionFlagsAsyncGenerator) = FunctionFlagsAsyncGenerator
                set emit_super_helpers: false
        }
        if emit_super_helpers
        {
            if this.sa_captured_count() > 0
                context.add_initialization_statement(this.sa_create_super_access_variable_statement())
        }
        if updated <> null
        {
            let u updated as ref[AstNode]
            let merged_statements context.end_and_merge_variable_environment(AstNode.statements_of(u))
            if emit_super_helpers and sa_has_super_element_access and (AstNode.multi_line_of(u) = false)
            {
                let new_block f.new_block(merged_statements, true)
                set new_block.pos: u.pos
                set new_block.end: u.end
                set updated: new_block
            }
            else
                set updated: f.update_block(u, merged_statements, AstNode.multi_line_of(u))
            if emit_super_helpers and sa_has_super_element_access
            {
                if sa_has_super_property_assignment
                    context.add_emit_helper(updated as ref[AstNode], context.helpers.advanced_async_super_helper)
                else
                    context.add_emit_helper(updated as ref[AstNode], context.helpers.async_super_helper)
            }
        }
        else
            context.end_variable_environment()
        set this.sa_captured_super_properties: saved_captured
        set this.sa_has_super_element_access: saved_element
        set this.sa_has_super_property_assignment: saved_assignment
        set this.sa_super_binding: saved_super
        set this.sa_super_index_binding: saved_super_index
        updated
    }

    ; createCaptureArgumentsStatement: `var arguments_1 = arguments;`
    procedure as_create_capture_arguments_statement(this) returns ref[AstNode]
    {
        let f factory
        let decls &Array[ref[AstNode]?]^host()
        decls.add(f.new_variable_declaration(as_lexical_arguments_binding, null, null, f.new_identifier("arguments")))
        let statement f.new_variable_statement(null, f.new_variable_declaration_list(decls, NodeFlagsNone))
        context.add_emit_flags(statement, EFStartOnNewLine | EFCustomPrologue)
        statement
    }

    ; transformAsyncFunctionParameterList: the outer parameters of a non-simple
    ; list up to the first initializer or rest (an arrow keeps a `...args` for it)
    procedure as_transform_async_function_parameter_list(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        let v this.the_visitor()
        let params AstNode.parameters_of(node)
        if Transformer.es_is_simple_parameter_list(params)
            return context.visit_parameters(params, v)
        let new_parameters &Array[ref[AstNode]?]^host()
        let ps params as ref[Array[ref[AstNode]?]]
        let empty: Slice[char] ""
        var i 0
        while i < (ps.get_length() as int)
        {
            let param ps[i as size_t] as ref[AstNode]
            if (AstNode.initializer_of(param) <> null) or (AstNode.dot_dot_dot_token_of(param) <> null)
            {
                if node.kind = KindArrowFunction
                {
                    let args_text: Slice[char] "args"
                    new_parameters.add(f.new_parameter_declaration(null, f.new_token(KindDotDotDotToken), f.new_unique_name_ex(args_text, GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty), null, null, null))
                }
                break
            }
            new_parameters.add(f.new_parameter_declaration(null, null, f.new_generated_name_for_node_ex(AstNode.name_of(param) as ref[AstNode], GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty), null, null, null))
            set i: i + 1
        }
        var pp 0
        var pe 0
        if AstNode.list_range_of(node, ps, &pp, &pe)
            f.set_list_range(new_parameters, pp, pe)
        new_parameters
    }

    ; transformAsyncFunctionBody: `return __awaiter(this, arguments, void 0, function* () { ... })`
    procedure as_transform_async_function_body(this, node: ref[AstNode], outer_parameters: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let is_arrow node.kind = KindArrowFunction
        let saved_captured sa_captured_super_properties
        let saved_element sa_has_super_element_access
        let saved_assignment sa_has_super_property_assignment
        let saved_super sa_super_binding
        let saved_super_index sa_super_index_binding
        if is_arrow = false
            this.sa_reset()
        var inner_parameters: ref[Array[ref[AstNode]?]]? null
        if Transformer.es_is_simple_parameter_list(AstNode.parameters_of(node)) = false
            set inner_parameters: context.visit_parameters(AstNode.parameters_of(node), v)
        let saved_binding as_lexical_arguments_binding
        let saved_used as_lexical_arguments_used
        let capture_lexical_arguments as_lexical_arguments_binding = null
        if capture_lexical_arguments
        {
            set this.as_lexical_arguments_binding: f.new_unique_name("arguments")
            set this.as_lexical_arguments_used: false
        }
        var arguments_expression: ref[AstNode]? null
        if inner_parameters <> null
        {
            if is_arrow
            {
                let parameter_bindings &Array[ref[AstNode]?]^host()
                let ps AstNode.parameters_of(node) as ref[Array[ref[AstNode]?]]
                let outer outer_parameters as ref[Array[ref[AstNode]?]]
                let outer_len outer.get_length() as int
                var i 0
                while (i < (ps.get_length() as int)) and (i < outer_len)
                {
                    let original_parameter ps[i as size_t] as ref[AstNode]
                    let outer_parameter outer[i as size_t] as ref[AstNode]
                    if (AstNode.initializer_of(original_parameter) <> null) or (AstNode.dot_dot_dot_token_of(original_parameter) <> null)
                    {
                        parameter_bindings.add(f.new_spread_element(AstNode.name_of(outer_parameter)))
                        break
                    }
                    parameter_bindings.add(AstNode.name_of(outer_parameter))
                    set i: i + 1
                }
                set arguments_expression: f.new_array_literal_expression(parameter_bindings, false)
            }
            else
                set arguments_expression: f.new_identifier("arguments")
        }
        let saved_enclosing as_enclosing_function_parameter_names
        let names &Array[Slice[char]]^host()
        let params AstNode.parameters_of(node)
        if params <> null
        {
            let ps params as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ps.get_length() as int)
            {
                this.as_record_declaration_name(ps[i as size_t] as ref[AstNode], names)
                set i: i + 1
            }
        }
        set this.as_enclosing_function_parameter_names: names
        let has_lexical_this this.as_in_context(AsContextHasLexicalThis)
        var async_body this.as_transform_async_function_body_worker(AstNode.body_of(node) as ref[AstNode])
        set async_body: f.update_block(async_body, context.end_and_merge_variable_environment(AstNode.statements_of(async_body)), AstNode.multi_line_of(async_body))
        var emit_super_helpers false
        if sa_captured_super_properties <> null
            set emit_super_helpers: (this.sa_captured_count() > 0) or sa_has_super_element_access
        if emit_super_helpers
        {
            let sv this.es_visitor(EsSubSuperAccess)
            set inner_parameters: sv.visit_nodes(inner_parameters)
            set async_body: this.sa_substitute_super_accesses_in_body(async_body)
        }
        var result: ref[AstNode]? null
        if is_arrow = false
        {
            context.start_variable_environment()
            if emit_super_helpers
            {
                if this.sa_captured_count() > 0
                    context.add_initialization_statement(this.sa_create_super_access_variable_statement())
            }
            if capture_lexical_arguments and as_lexical_arguments_used
                context.add_initialization_statement(this.as_create_capture_arguments_statement())
            let statements &Array[ref[AstNode]?]^host()
            statements.add(f.new_return_statement(f.new_awaiter_helper(has_lexical_this, arguments_expression, inner_parameters, async_body)))
            let block f.new_block(context.end_and_merge_variable_environment(statements), true)
            let body AstNode.body_of(node) as ref[AstNode]
            set block.pos: body.pos
            set block.end: body.end
            if emit_super_helpers and sa_has_super_element_access
            {
                if sa_has_super_property_assignment
                    context.add_emit_helper(block, context.helpers.advanced_async_super_helper)
                else
                    context.add_emit_helper(block, context.helpers.async_super_helper)
            }
            set result: block
        }
        else
        {
            var r f.new_awaiter_helper(has_lexical_this, arguments_expression, inner_parameters, async_body)
            if capture_lexical_arguments and as_lexical_arguments_used
            {
                let block this.as_convert_to_function_block(r)
                let capture &Array[ref[AstNode]?]^host()
                capture.add(this.as_create_capture_arguments_statement())
                set r: f.update_block(block, context.merge_environment_list(AstNode.statements_of(block), capture), AstNode.multi_line_of(block))
            }
            set result: r
        }
        set this.as_enclosing_function_parameter_names: saved_enclosing
        if is_arrow = false
        {
            set this.sa_captured_super_properties: saved_captured
            set this.sa_has_super_element_access: saved_element
            set this.sa_has_super_property_assignment: saved_assignment
            set this.sa_super_binding: saved_super
            set this.sa_super_index_binding: saved_super_index
            set this.as_lexical_arguments_binding: saved_binding
            set this.as_lexical_arguments_used: saved_used
        }
        else
        {
            if capture_lexical_arguments and (as_lexical_arguments_used = false)
            {
                set this.as_lexical_arguments_binding: saved_binding
                set this.as_lexical_arguments_used: saved_used
            }
            else
            {
                if capture_lexical_arguments
                    set this.as_lexical_arguments_used: false
            }
        }
        result
    }

    procedure as_transform_async_function_body_worker(this, body: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let bv this.es_visitor(EsSubAsBody)
        if body.kind = KindBlock
            return f.update_block(body, bv.visit_nodes(AstNode.statements_of(body)), AstNode.multi_line_of(body))
        let visited bv.visit_node(body)
        let ret f.new_return_statement(visited)
        set ret.pos: body.pos
        set ret.end: body.end
        let list &Array[ref[AstNode]?]^host()
        list.add(ret)
        f.set_list_range(list, body.pos, body.end)
        let block f.new_block(list, false)
        set block.pos: body.pos
        set block.end: body.end
        block
    }

    procedure as_convert_to_function_block(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if node.kind = KindBlock
            return node
        let ret f.new_return_statement(node)
        set ret.pos: node.pos
        set ret.end: node.end
        context.set_original(ret, node)
        let list &Array[ref[AstNode]?]^host()
        list.add(ret)
        f.set_list_range(list, node.pos, node.end)
        let block f.new_block(list, true)
        set block.pos: node.pos
        set block.end: node.end
        block
    }

    function as_original_if_function_like(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let original context.most_original(node)
        if original <> null
        {
            if AstNode.is_function_like_declaration(original)
                return original as ref[AstNode]
        }
        node
    }

    ; the ES downlevel transformers' sub visitors, made on first use
    function es_visitor(this, sub: int) returns ref[NodeVisitor]
    {
        if es_visitors = null
        {
            let table &Array[ref[NodeVisitor]?]^host()
            var i 0
            while i <= 5
            {
                table.add(null)
                set i: i + 1
            }
            set this.es_visitors: table
        }
        let visitors es_visitors as ref[Array[ref[NodeVisitor]?]]
        let existing visitors[sub as size_t]
        if existing <> null
            return existing as ref[NodeVisitor]
        let v context.new_node_visitor(VisitTagTransformer)
        set v.transformer: this
        set v.sub_tag: sub
        visitors.put(sub as size_t, v)
        v
    }

    ; ═══ tstransforms/legacydecorators.go (slice 245) ═══

    procedure visit_legacy_decorators(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        ; we have to visit all identifiers in classes, just in case they require substitution
        if ((Emitter.subtree_facts(node) & SubtreeContainsDecorators) = 0) and (this.ld_enclosing_count() = 0)
            return node
        let k node.kind
        if k = KindIdentifier
            return this.ld_visit_identifier(node)
        if k = KindPropertyAccessExpression
            return this.ld_visit_property_access_expression(node)
        if k = KindDecorator
            return null
        if k = KindClassDeclaration
            return this.ld_visit_class_declaration(node)
        if k = KindClassExpression
            return this.ld_visit_class_expression(node)
        if k = KindConstructor
            return this.ld_visit_constructor_declaration(node)
        if k = KindMethodDeclaration
            return this.ld_visit_method_declaration(node)
        if k = KindSetAccessor
            return this.ld_visit_accessor_declaration(node, false)
        if k = KindGetAccessor
            return this.ld_visit_accessor_declaration(node, true)
        if k = KindPropertyDeclaration
            return this.ld_visit_property_declaration(node)
        if k = KindParameter
            return this.ld_visit_parameter_declaration(node)
        if k = KindSourceFile
        {
            set this.ld_class_aliases: &Array[ClassAliasEntry]^host()
            set this.ld_enclosing_classes: null
            let result this.the_visitor().visit_each_child(node) as ref[AstNode]
            let helpers context.read_emit_helpers()
            var h 0
            while h < (helpers.get_length() as int)
            {
                let helper helpers[h as size_t]
                if helper <> null
                    context.add_emit_helper(result, helper as ref[EmitHelper])
                set h: h + 1
            }
            set this.ld_class_aliases: null
            set this.ld_enclosing_classes: null
            return result
        }
        this.the_visitor().visit_each_child(node)
    }

    function ld_enclosing_count(this) returns int
    {
        if ld_enclosing_classes = null
            return 0
        (ld_enclosing_classes as ref[Array[ref[AstNode]?]]).get_length() as int
    }

    function ld_class_alias_of(this, declaration: ref[AstNode]) returns ref[AstNode]?
    {
        if ld_class_aliases = null
            return null
        let aliases ld_class_aliases as ref[Array[ClassAliasEntry]]
        var i 0
        while i < (aliases.get_length() as int)
        {
            let e aliases[i as size_t]
            if Transformer.same_node(e.node, declaration)
                return e.alias
            set i: i + 1
        }
        null
    }

    ; visitIdentifier: takes the place of `substituteIdentifier` in the strada transform
    procedure ld_visit_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if ld_enclosing_classes = null
            return node
        let enclosing ld_enclosing_classes as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (enclosing.get_length() as int)
        {
            let d enclosing[i as size_t] as ref[AstNode]
            let alias this.ld_class_alias_of(d)
            if alias <> null
            {
                let decl this.the_checker().get_referenced_value_declaration(context.most_original(node) as ref[AstNode])
                if decl <> null
                {
                    if Transformer.same_node(decl as ref[AstNode], context.most_original(d) as ref[AstNode])
                        return alias
                }
            }
            set i: i + 1
        }
        node
    }

    ; visitPropertyAccessExpression: the expression but not the name, since property
    ; access names should not be substituted
    procedure ld_visit_property_access_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expression this.the_visitor().visit_node(AstNode.expression_of(node))
        if Transformer.same_optional_node(expression, AstNode.expression_of(node)) = false
            return factory.update_property_access_expression(node, expression, AstNode.question_dot_token_of(node), AstNode.name_of(node), node.flags)
        node
    }

    function same_optional_node(a: ref[AstNode]?, b: ref[AstNode]?) returns bool
    {
        if a = null
            return b = null
        if b = null
            return false
        Transformer.same_node(a as ref[AstNode], b as ref[AstNode])
    }

    ; elideModifiers / elideNodes: an empty list keeping the original's range
    procedure ld_elide_list(this, nodes: ref[Array[ref[AstNode]?]]?, owner: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        if nodes = null
            return null
        let ns nodes as ref[Array[ref[AstNode]?]]
        if ns.get_length() = 0
            return nodes
        let replacement &Array[ref[AstNode]?]^host()
        var pos 0
        var end 0
        if AstNode.list_range_of(owner, ns, &pos, &end)
            factory.set_list_range(replacement, pos, end)
        replacement
    }

    ; finishClassElement: the comments for the original range, the source map after
    ; the decorators and modifiers
    procedure ld_finish_class_element(this, updated: ref[AstNode], original: ref[AstNode]) returns ref[AstNode]
    {
        if Transformer.same_node(updated, original) = false
        {
            context.set_comment_range(updated, TextRange(original.pos, original.end))
            context.set_source_map_range(updated, Transformer.move_range_past_modifiers(original))
        }
        updated
    }

    procedure ld_visit_parameter_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let updated f.update_parameter_declaration(node, this.ld_elide_list(Printer.modifier_list_of(node), node), AstNode.dot_dot_dot_token_of(node), v.visit_node(AstNode.name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        if Transformer.same_node(updated, node) = false
        {
            context.set_comment_range(updated, TextRange(node.pos, node.end))
            let new_loc Transformer.move_range_past_modifiers(node)
            set updated.pos: new_loc.pos
            set updated.end: new_loc.end
            context.set_source_map_range(updated, new_loc)
            context.set_emit_flags(AstNode.name_of(updated) as ref[AstNode], EFNoTrailingSourceMap)
        }
        updated
    }

    ; visitPropertyNameOfClassElement: a computed property on a decorated member is
    ; kept in a temporary for the decoration statements
    procedure ld_visit_property_name_of_class_element(this, member: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let name AstNode.name_of(member) as ref[AstNode]
        if (name.kind = KindComputedPropertyName) and Transformer.has_decorators(member)
        {
            let expression v.visit_node(AstNode.expression_of(name)) as ref[AstNode]
            let inner_expression Printer.skip_partially_emitted_expressions(expression)
            if Transformer.is_simple_inlineable_expression(inner_expression) = false
            {
                let generated_name f.new_generated_name_for_node(name)
                context.add_variable_declaration(generated_name)
                return f.update_computed_property_name(name, f.new_assignment_expression(generated_name, expression))
            }
        }
        v.visit_node(name)
    }

    procedure ld_visit_property_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (node.flags & NodeFlagsAmbient) <> 0
            return null
        if Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient | ModifierFlagsAbstract)
            return null
        this.ld_finish_class_element(f.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), this.ld_visit_property_name_of_class_element(node), null, null, v.visit_node(AstNode.initializer_of(node))), node)
    }

    procedure ld_visit_accessor_declaration(this, node: ref[AstNode], is_get: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        var updated: ref[AstNode]? null
        if is_get
            set updated: f.update_get_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), this.ld_visit_property_name_of_class_element(node), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        else
            set updated: f.update_set_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), this.ld_visit_property_name_of_class_element(node), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        this.ld_finish_class_element(updated as ref[AstNode], node)
    }

    procedure ld_visit_method_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        this.ld_finish_class_element(f.update_method_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), this.ld_visit_property_name_of_class_element(node), null, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node))), node)
    }

    procedure ld_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        f.update_constructor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
    }

    ; legacy decorators were not supported on class expressions
    procedure ld_visit_class_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        f.update_class_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.name_of(node), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
    }

    procedure ld_visit_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let ck this.the_checker()
        let decorated ck.class_or_constructor_parameter_is_decorated(true, node)
        if (decorated = false) and (ck.child_is_decorated(true, node, null) = false)
            return this.the_visitor().visit_each_child(node)
        if decorated
            return this.ld_transform_class_declaration_with_class_decorators(node, AstNode.name_of(node))
        this.ld_transform_class_declaration_without_class_decorators(node, AstNode.name_of(node))
    }

    ; transformClassDeclarationWithoutClassDecorators
    procedure ld_transform_class_declaration_without_class_decorators(this, node: ref[AstNode], name_in: ref[AstNode]?) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let modifiers v.visit_modifiers(Printer.modifier_list_of(node))
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        let initial_members v.visit_nodes(Printer.member_list_of(node))
        let decoration_statements &Array[ref[AstNode]?]^host()
        let members this.ld_transform_decorators_of_class_elements(node, initial_members, decoration_statements)
        var name name_in
        if (name = null) and (decoration_statements.get_length() > 0)
            set name: f.new_generated_name_for_node(node)
        let updated f.update_class_declaration(node, modifiers, name, null, heritage_clauses, members)
        if decoration_statements.get_length() = 0
            return updated
        let list &Array[ref[AstNode]?]^host()
        list.add(updated)
        Transformer.add_all(list, decoration_statements)
        f.new_syntax_list(list)
    }

    procedure ld_pop_enclosing_class(this)
    {
        let enclosing ld_enclosing_classes as ref[Array[ref[AstNode]?]]
        let n enclosing.get_length() as int
        let copy &Array[ref[AstNode]?]^host()
        var i 0
        while i < (n - 1)
        {
            copy.add(enclosing[i as size_t])
            set i: i + 1
        }
        set this.ld_enclosing_classes: copy
    }

    procedure ld_push_enclosing_class(this, cls: ref[AstNode])
    {
        if ld_enclosing_classes = null
            set this.ld_enclosing_classes: &Array[ref[AstNode]?]^host()
        (ld_enclosing_classes as ref[Array[ref[AstNode]?]]).add(cls)
    }

    function ld_is_not_export_or_default_or_decorator(node: ref[AstNode]) returns bool
    {
        let k node.kind
        (k <> KindDecorator) and (k <> KindExportKeyword) and (k <> KindDefaultKeyword)
    }

    function ld_is_class_static_block_declaration_or_static_property(node: ref[AstNode]) returns bool
    {
        if node.kind = KindClassStaticBlockDeclaration
            return true
        (node.kind = KindPropertyDeclaration) and Transformer.has_static_modifier(node)
    }

    ; transformClassDeclarationWithClassDecorators: `let C = class C {}; C = __decorate([dec], C);`
    ; with the alias and the export placement the four examples of the reference show
    procedure ld_transform_class_declaration_with_class_decorators(this, node: ref[AstNode], name: ref[AstNode]?) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let is_export Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let is_default Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
        var modifiers: ref[Array[ref[AstNode]?]]? null
        let original_modifiers Printer.modifier_list_of(node)
        if original_modifiers <> null
        {
            let oms original_modifiers as ref[Array[ref[AstNode]?]]
            if oms.get_length() > 0
            {
                let kept &Array[ref[AstNode]?]^host()
                var i 0
                while i < (oms.get_length() as int)
                {
                    let m oms[i as size_t] as ref[AstNode]
                    if Transformer.ld_is_not_export_or_default_or_decorator(m)
                        kept.add(m)
                    set i: i + 1
                }
                if kept.get_length() <> oms.get_length()
                {
                    var pos 0
                    var end 0
                    if AstNode.list_range_of(node, oms, &pos, &end)
                        f.set_list_range(kept, pos, end)
                    set modifiers: kept
                }
                else
                    set modifiers: original_modifiers
            }
        }
        let location Transformer.move_range_past_modifiers(node)
        let class_alias this.ld_get_class_alias_if_needed(node)
        if class_alias <> null
            this.ld_push_enclosing_class(node)
        ; always the local name for the class (the ES5 IIFE is not supported any more)
        let decl_name f.get_local_name_ex(node, false, true, false)
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        var members v.visit_nodes(Printer.member_list_of(node))
        let decoration_statements &Array[ref[AstNode]?]^host()
        set members: this.ld_transform_decorators_of_class_elements(node, members, decoration_statements)
        ; at ES2022 or later the class alias is reassigned before static initializers run
        var assign_class_alias_in_static_block false
        if (opts.options.get_emit_script_target() >= ScriptTargetES2022) and (class_alias <> null) and (members <> null)
        {
            let ms members as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ms.get_length() as int)
            {
                if Transformer.ld_is_class_static_block_declaration_or_static_property(ms[i as size_t] as ref[AstNode])
                    set assign_class_alias_in_static_block: true
                set i: i + 1
            }
        }
        if assign_class_alias_in_static_block
        {
            let ms members as ref[Array[ref[AstNode]?]]
            let block_statements &Array[ref[AstNode]?]^host()
            block_statements.add(f.new_expression_statement(f.new_assignment_expression(class_alias as ref[AstNode], f.new_keyword_expression(KindThisKeyword))))
            let member_list &Array[ref[AstNode]?]^host()
            member_list.add(f.new_class_static_block_declaration(null, f.new_block(block_statements, false)))
            Transformer.add_all(member_list, ms)
            var pos 0
            var end 0
            if AstNode.list_range_of(node, ms, &pos, &end)
                f.set_list_range(member_list, pos, end)
            set members: member_list
        }
        var expr_name name
        if name <> null
        {
            if context.has_auto_generate_info(name)
                set expr_name: null
        }
        let class_expression f.new_class_expression(modifiers, expr_name, null, heritage_clauses, members)
        context.set_original(class_expression, node)
        set class_expression.pos: location.pos
        set class_expression.end: location.end
        ; let ${name} = ${classExpression}, or `= alias = classExpression` when the class
        ; refers to itself
        var var_initializer class_expression
        if (class_alias <> null) and (assign_class_alias_in_static_block = false)
            set var_initializer: f.new_assignment_expression(class_alias as ref[AstNode], class_expression)
        let var_decl f.new_variable_declaration(decl_name, null, null, var_initializer)
        context.set_original(var_decl, node)
        let decls &Array[ref[AstNode]?]^host()
        decls.add(var_decl)
        let var_decl_list f.new_variable_declaration_list(decls, NodeFlagsLet)
        let var_statement f.new_variable_statement(null, var_decl_list)
        context.set_original(var_statement, node)
        set var_statement.pos: location.pos
        set var_statement.end: location.end
        context.set_comment_range(var_statement, TextRange(node.pos, node.end))
        let statements &Array[ref[AstNode]?]^host()
        statements.add(var_statement)
        Transformer.add_all(statements, decoration_statements)
        let constructor_decoration this.ld_get_constructor_decoration_statement(node)
        if constructor_decoration <> null
            statements.add(constructor_decoration)
        if is_export
        {
            if is_default
                statements.add(f.new_export_default(decl_name))
            else
                statements.add(f.new_external_module_export(f.get_declaration_name(node)))
        }
        if class_alias <> null
            this.ld_pop_enclosing_class()
        if statements.get_length() = 1
            return statements[0]
        f.new_syntax_list(statements)
    }

    ; hasInternalStaticReference: a member that refers to the class by name
    procedure ld_has_internal_static_reference(this, node: ref[AstNode]) returns bool
    {
        set this.ld_check_class_original: context.most_original(node)
        set this.ld_check_found: false
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ms members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ms.get_length() as int)
        {
            let member ms[i as size_t] as ref[AstNode]
            let cv this.ld_visitor(LdSubStaticSelfReferenceCheck)
            cv.visit_each_child(member)
            if ld_check_found
                return true
            set i: i + 1
        }
        false
    }

    ; isOrContainsStaticSelfReference, as the walk's callback
    procedure ld_check_static_self_reference(this, n: ref[AstNode])
    {
        if ld_check_found
            return
        if n.kind = KindIdentifier
        {
            let decl this.the_checker().get_referenced_value_declaration(context.most_original(n) as ref[AstNode])
            if (decl <> null) and (ld_check_class_original <> null)
            {
                if Transformer.same_node(decl as ref[AstNode], ld_check_class_original as ref[AstNode])
                    set this.ld_check_found: true
            }
            return
        }
        ; a property access: the expression only, never the name
        if n.kind = KindPropertyAccessExpression
        {
            this.ld_check_static_self_reference(AstNode.expression_of(n) as ref[AstNode])
            return
        }
        let cv this.ld_visitor(LdSubStaticSelfReferenceCheck)
        cv.visit_each_child(n)
    }

    procedure ld_visit_for_static_self_reference_check(this, n: ref[AstNode]) returns ref[AstNode]?
    {
        this.ld_check_static_self_reference(n)
        n
    }

    function ld_visitor(this, sub: int) returns ref[NodeVisitor]
    {
        if ld_visitors = null
        {
            let table &Array[ref[NodeVisitor]?]^host()
            var i 0
            while i <= 2
            {
                table.add(null)
                set i: i + 1
            }
            set this.ld_visitors: table
        }
        let visitors ld_visitors as ref[Array[ref[NodeVisitor]?]]
        let existing visitors[sub as size_t]
        if existing <> null
            return existing as ref[NodeVisitor]
        let v context.new_node_visitor(VisitTagTransformer)
        set v.transformer: this
        set v.sub_tag: sub
        visitors.put(sub as size_t, v)
        v
    }

    ; getClassAliasIfNeeded: a local alias for a decorated class with an internal
    ; reference to its static side (the double-binding of the class name)
    procedure ld_get_class_alias_if_needed(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if this.ld_has_internal_static_reference(node) = false
            return null
        var name_text: Slice[char] "default"
        let name AstNode.name_of(node)
        if name <> null
        {
            if context.has_auto_generate_info(name) = false
                set name_text: AstNode.identifier_text_of(name as ref[AstNode])
        }
        let class_alias f.new_unique_name(name_text)
        context.add_variable_declaration(class_alias)
        if ld_class_aliases = null
            set this.ld_class_aliases: &Array[ClassAliasEntry]^host()
        (ld_class_aliases as ref[Array[ClassAliasEntry]]).add(ClassAliasEntry(node, class_alias))
        class_alias
    }

    procedure ld_get_constructor_decoration_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expression this.ld_generate_constructor_decoration_expression(node)
        if expression = null
            return null
        let result factory.new_expression_statement(expression as ref[AstNode])
        context.set_original(result, node)
        result
    }

    ; generateConstructorDecorationExpression: `C = __decorate([dec], C)`; decorator
    ; expressions are evaluated outside the class body, so the enclosing class is
    ; popped while they are visited
    procedure ld_generate_constructor_decoration_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let all_decorators this.ld_get_all_decorators_of_class(node)
        var has_alias false
        if ld_enclosing_classes <> null
        {
            let enclosing ld_enclosing_classes as ref[Array[ref[AstNode]?]]
            let n enclosing.get_length() as int
            if n > 0
            {
                if Transformer.same_node(enclosing[(n - 1) as size_t] as ref[AstNode], node)
                    set has_alias: true
            }
        }
        if has_alias
            this.ld_pop_enclosing_class()
        let decorator_expressions this.ld_transform_all_decorators_of_declaration(all_decorators)
        if has_alias
            this.ld_push_enclosing_class(node)
        if decorator_expressions.get_length() = 0
            return null
        let class_alias this.ld_class_alias_of(node)
        let local_name f.get_declaration_name_ex(node, false, true)
        let decorate f.new_decorate_helper(decorator_expressions, local_name, null, null)
        var assignment_target decorate
        if class_alias <> null
            set assignment_target: f.new_assignment_expression(class_alias as ref[AstNode], decorate)
        let expression f.new_assignment_expression(local_name, assignment_target)
        context.set_emit_flags(expression, EFNoComments)
        context.set_source_map_range(expression, Transformer.move_range_past_modifiers(node))
        expression
    }

    function ld_decorator_contains_private_identifier_in_expression(decorator: ref[AstNode]) returns bool
        (Emitter.subtree_facts(decorator) & SubtreeContainsPrivateIdentifierInExpression) <> 0

    function ld_decorators_contain_private_identifier(decorators: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if decorators = null
            return false
        let ds decorators as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ds.get_length() as int)
        {
            if Transformer.ld_decorator_contains_private_identifier_in_expression(ds[i as size_t] as ref[AstNode])
                return true
            set i: i + 1
        }
        false
    }

    procedure ld_has_class_element_with_decorator_containing_private_identifier_in_expression(this, node: ref[AstNode]) returns bool
    {
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ms members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ms.get_length() as int)
        {
            let member ms[i as size_t] as ref[AstNode]
            set i: i + 1
            if AstNode.can_have_decorators(member) = false
                continue
            let all this.ld_get_all_decorators_of_class_element(member, node)
            if all = null
                continue
            let ad all as ref[AllDecorators]
            if Transformer.ld_decorators_contain_private_identifier(ad.decorators)
                return true
            if ad.parameters <> null
            {
                let ps ad.parameters as ref[Array[ref[Array[ref[AstNode]?]]?]]
                var p 0
                while p < (ps.get_length() as int)
                {
                    if Transformer.ld_decorators_contain_private_identifier(ps[p as size_t])
                        return true
                    set p: p + 1
                }
            }
        }
        false
    }

    ; getAllDecoratorsOfClass: the class's decorators and its constructor's parameter decorators
    procedure ld_get_all_decorators_of_class(this, node: ref[AstNode]) returns ref[AllDecorators]?
    {
        let decorators Transformer.decorators_of(host, node)
        let parameters this.ld_get_decorators_of_parameters(Transformer.get_first_constructor_with_body(node))
        if (decorators.get_length() = 0) and (parameters = null)
            return null
        &AllDecorators^host(decorators, parameters)
    }

    ; getAllDecoratorsOfClassElement(member, parent, useLegacyDecorators = true)
    procedure ld_get_all_decorators_of_class_element(this, member: ref[AstNode], parent: ref[AstNode]) returns ref[AllDecorators]?
    {
        let k member.kind
        if (k = KindGetAccessor) or (k = KindSetAccessor)
            return this.ld_get_all_decorators_of_accessors(member, parent)
        if k = KindMethodDeclaration
            return this.ld_get_all_decorators_of_method(member)
        if k = KindPropertyDeclaration
            return this.ld_get_all_decorators_of_property(member)
        null
    }

    procedure ld_get_all_decorators_of_accessors(this, accessor: ref[AstNode], parent: ref[AstNode]) returns ref[AllDecorators]?
    {
        if AstNode.body_of(accessor) = null
            return null
        let decls this.get_all_accessor_declarations(Printer.member_list_of(parent), accessor)
        var first_accessor_with_decorators: ref[AstNode]? null
        if Transformer.has_decorators(decls.first_accessor)
            set first_accessor_with_decorators: decls.first_accessor
        else
        {
            if decls.second_accessor <> null
            {
                if Transformer.has_decorators(decls.second_accessor as ref[AstNode])
                    set first_accessor_with_decorators: decls.second_accessor
            }
        }
        if first_accessor_with_decorators = null
            return null
        if Transformer.same_node(accessor, first_accessor_with_decorators as ref[AstNode]) = false
            return null
        let decorators Transformer.decorators_of(host, first_accessor_with_decorators as ref[AstNode])
        var parameters: ref[Array[ref[Array[ref[AstNode]?]]?]]? null
        if decls.set_accessor <> null
            set parameters: this.ld_get_decorators_of_parameters(decls.set_accessor)
        if (decorators.get_length() = 0) and (parameters = null)
            return null
        &AllDecorators^host(decorators, parameters)
    }

    procedure ld_get_all_decorators_of_property(this, property: ref[AstNode]) returns ref[AllDecorators]?
    {
        let decorators Transformer.decorators_of(host, property)
        if decorators.get_length() = 0
            return null
        &AllDecorators^host(decorators, null)
    }

    procedure ld_get_all_decorators_of_method(this, method: ref[AstNode]) returns ref[AllDecorators]?
    {
        if AstNode.body_of(method) = null
            return null
        let decorators Transformer.decorators_of(host, method)
        let parameters this.ld_get_decorators_of_parameters(method)
        if (decorators.get_length() = 0) and (parameters = null)
            return null
        &AllDecorators^host(decorators, parameters)
    }

    ; getDecoratorsOfParameters: one list per parameter (null where none), null when no
    ; parameter is decorated; a leading `this` parameter is skipped
    procedure ld_get_decorators_of_parameters(this, node: ref[AstNode]?) returns ref[Array[ref[Array[ref[AstNode]?]]?]]?
    {
        if node = null
            return null
        let parameters AstNode.parameters_of(node)
        if parameters = null
            return null
        let ps parameters as ref[Array[ref[AstNode]?]]
        var first_parameter_offset 0
        var num_parameters ps.get_length() as int
        if num_parameters > 0
        {
            if AstNode.is_this_parameter(ps[0] as ref[AstNode])
            {
                set first_parameter_offset: 1
                set num_parameters: num_parameters - 1
            }
        }
        var decorators: ref[Array[ref[Array[ref[AstNode]?]]?]]? null
        var i 0
        while i < num_parameters
        {
            let p ps[(i + first_parameter_offset) as size_t] as ref[AstNode]
            if (decorators <> null) or Transformer.has_decorators(p)
            {
                if decorators = null
                {
                    let table &Array[ref[Array[ref[AstNode]?]]?]^host()
                    var j 0
                    while j < num_parameters
                    {
                        table.add(null)
                        set j: j + 1
                    }
                    set decorators: table
                }
                (decorators as ref[Array[ref[Array[ref[AstNode]?]]?]]).put(i as size_t, Transformer.decorators_of(host, p))
            }
            set i: i + 1
        }
        decorators
    }

    ; transformDecoratorsOfClassElements: the decoration statements of the instance
    ; members then the static ones; into a static block when a decorator names a
    ; private identifier
    procedure ld_transform_decorators_of_class_elements(this, node: ref[AstNode], members: ref[Array[ref[AstNode]?]]?, decoration_statements: ref[Array[ref[AstNode]?]]) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        this.ld_add_class_element_decoration_statements(node, false, decoration_statements)
        this.ld_add_class_element_decoration_statements(node, true, decoration_statements)
        if this.ld_has_class_element_with_decorator_containing_private_identifier_in_expression(node)
        {
            let new_members &Array[ref[AstNode]?]^host()
            Transformer.add_all(new_members, members)
            let block_statements &Array[ref[AstNode]?]^host()
            Transformer.add_all(block_statements, decoration_statements)
            new_members.add(f.new_class_static_block_declaration(null, f.new_block(block_statements, true)))
            decoration_statements.clear()
            return new_members
        }
        members
    }

    procedure ld_add_class_element_decoration_statements(this, node: ref[AstNode], is_static: bool, statements: ref[Array[ref[AstNode]?]])
    {
        let members Printer.member_list_of(node)
        if members = null
            return
        let ms members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ms.get_length() as int)
        {
            let member ms[i as size_t] as ref[AstNode]
            set i: i + 1
            ; isDecoratedClassElement
            if (opts.binder as ref[Binder]).is_static(member) <> is_static
                continue
            if this.the_checker().node_or_child_is_decorated(true, member, node, null) = false
                continue
            let expr this.ld_generate_class_element_decoration_expression(node, member)
            if expr <> null
                statements.add(factory.new_expression_statement(expr as ref[AstNode]))
        }
    }

    ; generateClassElementDecorationExpression: `__decorate([...], C.prototype, "method", null)`
    procedure ld_generate_class_element_decoration_expression(this, node: ref[AstNode], member: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let all_decorators this.ld_get_all_decorators_of_class_element(member, node)
        let decorator_expressions this.ld_transform_all_decorators_of_declaration(all_decorators)
        if decorator_expressions.get_length() = 0
            return null
        let prefix this.ld_get_class_member_prefix(node, member)
        let member_name this.ld_get_expression_for_property_name(member, (member.flags & NodeFlagsAmbient) = 0)
        var descriptor: ref[AstNode]? null
        if (member.kind = KindPropertyDeclaration) and (Transformer.has_accessor_modifier(member) = false)
            set descriptor: f.new_void_zero_expression()
        else
            set descriptor: f.new_keyword_expression(KindNullKeyword)
        let helper f.new_decorate_helper(decorator_expressions, prefix, member_name, descriptor)
        context.set_emit_flags(helper, EFNoComments)
        context.set_source_map_range(helper, Transformer.move_range_past_modifiers(member))
        helper
    }

    function ld_is_synthetic_metadata_decorator(this, node: ref[AstNode]) returns bool
        context.is_call_to_helper(AstNode.expression_of(node) as ref[AstNode], "__metadata")

    ; transformAllDecoratorsOfDeclaration: the decorators, the parameter decorators,
    ; then the metadata decorators last
    procedure ld_transform_all_decorators_of_declaration(this, all_decorators: ref[AllDecorators]?) returns ref[Array[ref[AstNode]?]]
    {
        let results &Array[ref[AstNode]?]^host()
        if all_decorators = null
            return results
        let ad all_decorators as ref[AllDecorators]
        let metadata &Array[ref[AstNode]?]^host()
        let decorators &Array[ref[AstNode]?]^host()
        if ad.decorators <> null
        {
            let ds ad.decorators as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ds.get_length() as int)
            {
                let d ds[i as size_t] as ref[AstNode]
                if this.ld_is_synthetic_metadata_decorator(d)
                    metadata.add(d)
                else
                    decorators.add(d)
                set i: i + 1
            }
        }
        this.ld_transform_decorators(decorators, results)
        this.ld_transform_decorators_of_parameters(ad.parameters, results)
        this.ld_transform_decorators(metadata, results)
        results
    }

    procedure ld_transform_decorators_of_parameters(this, parameters: ref[Array[ref[Array[ref[AstNode]?]]?]]?, results: ref[Array[ref[AstNode]?]])
    {
        if parameters = null
            return
        let ps parameters as ref[Array[ref[Array[ref[AstNode]?]]?]]
        var i 0
        while i < (ps.get_length() as int)
        {
            let decorators ps[i as size_t]
            if decorators <> null
            {
                let ds decorators as ref[Array[ref[AstNode]?]]
                var j 0
                while j < (ds.get_length() as int)
                {
                    let decorator ds[j as size_t] as ref[AstNode]
                    let expression AstNode.expression_of(decorator) as ref[AstNode]
                    let helper factory.new_param_helper(this.the_visitor().visit_node(expression) as ref[AstNode], i, TextRange(expression.pos, expression.end))
                    context.set_emit_flags(helper, EFNoComments)
                    results.add(helper)
                    set j: j + 1
                }
            }
            set i: i + 1
        }
    }

    procedure ld_transform_decorators(this, decorators: ref[Array[ref[AstNode]?]], results: ref[Array[ref[AstNode]?]])
    {
        var i 0
        while i < (decorators.get_length() as int)
        {
            let d decorators[i as size_t] as ref[AstNode]
            results.add(this.the_visitor().visit_node(AstNode.expression_of(d)))
            set i: i + 1
        }
    }

    procedure ld_get_class_member_prefix(this, node: ref[AstNode], member: ref[AstNode]) returns ref[AstNode]
    {
        if (opts.binder as ref[Binder]).is_static(member)
            return factory.get_declaration_name(node)
        factory.new_property_access_expression(factory.get_declaration_name(node), null, factory.new_identifier("prototype"), NodeFlagsNone)
    }

    procedure ld_get_expression_for_property_name(this, member: ref[AstNode], generate_name_for_computed_property_name: bool) returns ref[AstNode]
    {
        let f factory
        let name AstNode.name_of(member) as ref[AstNode]
        if name.kind = KindPrivateIdentifier
        {
            let empty: Slice[char] ""
            return f.new_identifier(empty)
        }
        if name.kind = KindComputedPropertyName
        {
            let expression AstNode.expression_of(name) as ref[AstNode]
            if generate_name_for_computed_property_name and (Transformer.is_simple_inlineable_expression(expression) = false)
                return f.new_generated_name_for_node(name)
            return expression
        }
        if name.kind = KindIdentifier
            return f.new_string_literal(AstNode.identifier_text_of(name), TokenFlagsNone)
        DeepClone.deep_clone_node(host, f, name) as ref[AstNode]
    }

    ; ═══ tstransforms/metadata.go + typeserializer.go (slice 245) ═══
    ; the `design:type` / `design:paramtypes` / `design:returntype` decorators
    ; under emitDecoratorMetadata (the old format; USE_NEW_TYPE_METADATA_FORMAT is false)

    procedure visit_metadata(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsDecorators) = 0
            return node
        let k node.kind
        if k = KindClassDeclaration
            return this.md_visit_class_like(node, true)
        if k = KindClassExpression
            return this.md_visit_class_like(node, false)
        if k = KindPropertyDeclaration
            return this.md_visit_property_declaration(node)
        if k = KindMethodDeclaration
            return this.md_visit_method_declaration(node)
        if k = KindSetAccessor
            return this.md_visit_accessor(node, false)
        if k = KindGetAccessor
            return this.md_visit_accessor(node, true)
        if k = KindSourceFile
        {
            set this.md_parent: null
            set this.md_current_lexical_scope: node
            let updated this.the_visitor().visit_each_child(node) as ref[AstNode]
            let helpers context.read_emit_helpers()
            var h 0
            while h < (helpers.get_length() as int)
            {
                let helper helpers[h as size_t]
                if helper <> null
                    context.add_emit_helper(updated, helper as ref[EmitHelper])
                set h: h + 1
            }
            set this.md_parent: null
            set this.md_current_lexical_scope: null
            return updated
        }
        if (k = KindModuleBlock) or (k = KindBlock) or (k = KindCaseBlock)
        {
            let old_scope md_current_lexical_scope
            set this.md_current_lexical_scope: node
            let result this.the_visitor().visit_each_child(node)
            set this.md_current_lexical_scope: old_scope
            return result
        }
        this.the_visitor().visit_each_child(node)
    }

    function md_legacy_decorators(this) returns bool
        opts.options.experimental_decorators = TristateTrue

    procedure md_visit_class_like(this, node: ref[AstNode], is_declaration: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let old_parent md_parent
        set this.md_parent: node
        var result: ref[AstNode]? null
        if this.the_checker().class_or_constructor_parameter_is_decorated(this.md_legacy_decorators(), node) = false
            set result: v.visit_each_child(node)
        else
        {
            let modifiers this.md_inject_class_type_metadata(v.visit_modifiers(Printer.modifier_list_of(node)), node)
            if is_declaration
                set result: f.update_class_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), v.visit_nodes(AstNode.type_parameters_of(node)), v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
            else
                set result: f.update_class_expression(node, modifiers, v.visit_node(AstNode.name_of(node)), v.visit_nodes(AstNode.type_parameters_of(node)), v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
        }
        set this.md_parent: old_parent
        result
    }

    procedure md_visit_property_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if Transformer.has_decorators(node) = false
            return v.visit_each_child(node)
        let modifiers this.md_inject_class_element_type_metadata(v.visit_modifiers(Printer.modifier_list_of(node)), node, md_parent)
        f.update_property_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), v.visit_node(AstNode.postfix_token_of(node)), v.visit_node(AstNode.type_of(node)), v.visit_node(AstNode.initializer_of(node)))
    }

    procedure md_visit_method_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (Transformer.has_decorators(node) = false) and (this.ld_get_decorators_of_parameters(node) = null)
            return v.visit_each_child(node)
        let modifiers this.md_inject_class_element_type_metadata(v.visit_modifiers(Printer.modifier_list_of(node)), node, md_parent)
        f.update_method_declaration(node, modifiers, v.visit_node(AstNode.asterisk_token_of(node)), v.visit_node(AstNode.name_of(node)), v.visit_node(AstNode.postfix_token_of(node)), v.visit_nodes(AstNode.type_parameters_of(node)), v.visit_nodes(AstNode.parameters_of(node)), v.visit_node(AstNode.type_of(node)), v.visit_node(AstNode.full_signature_of(node)), v.visit_node(AstNode.body_of(node)))
    }

    procedure md_visit_accessor(this, node: ref[AstNode], is_get: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        var skip Transformer.has_decorators(node) = false
        if skip and (is_get = false)
        {
            if this.ld_get_decorators_of_parameters(node) <> null
                set skip: false
        }
        if skip
            return v.visit_each_child(node)
        let modifiers this.md_inject_class_element_type_metadata(v.visit_modifiers(Printer.modifier_list_of(node)), node, md_parent)
        if is_get
            return f.update_get_accessor_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), v.visit_nodes(AstNode.type_parameters_of(node)), v.visit_nodes(AstNode.parameters_of(node)), v.visit_node(AstNode.type_of(node)), v.visit_node(AstNode.full_signature_of(node)), v.visit_node(AstNode.body_of(node)))
        f.update_set_accessor_declaration(node, modifiers, v.visit_node(AstNode.name_of(node)), v.visit_nodes(AstNode.type_parameters_of(node)), v.visit_nodes(AstNode.parameters_of(node)), v.visit_node(AstNode.type_of(node)), v.visit_node(AstNode.full_signature_of(node)), v.visit_node(AstNode.body_of(node)))
    }

    function md_is_export_or_default(node: ref[AstNode]) returns bool
        (node.kind = KindDefaultKeyword) or (node.kind = KindExportKeyword)

    ; injectClassTypeMetadata: `export default` first, then the decorators, the
    ; metadata, the other modifiers
    procedure md_inject_class_type_metadata(this, list: ref[Array[ref[AstNode]?]]?, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        let metadata this.md_get_type_metadata(node, node)
        if metadata.get_length() = 0
            return list
        var original: ref[Array[ref[AstNode]?]]? list
        if (list = null) or ((list as ref[Array[ref[AstNode]?]]).get_length() = 0)
        {
            if list <> null
            {
                var pos 0
                var end 0
                if AstNode.list_range_of(node, list, &pos, &end)
                    f.set_list_range(metadata, pos, end)
            }
            return metadata
        }
        let originals list as ref[Array[ref[AstNode]?]]
        let result &Array[ref[AstNode]?]^host()
        var rest_start 0
        let first originals[0] as ref[AstNode]
        if Printer.is_modifier_kind(first.kind) and Transformer.md_is_export_or_default(first)
        {
            result.add(first)
            set rest_start: 1
            if originals.get_length() > 1
            {
                let second originals[1] as ref[AstNode]
                if Transformer.md_is_export_or_default(second)
                {
                    result.add(second)
                    set rest_start: 2
                }
            }
        }
        var i 0
        while i < (originals.get_length() as int)
        {
            let m originals[i as size_t] as ref[AstNode]
            if m.kind = KindDecorator
                result.add(m)
            set i: i + 1
        }
        Transformer.add_all(result, metadata)
        set i: rest_start
        while i < (originals.get_length() as int)
        {
            let m originals[i as size_t] as ref[AstNode]
            if Printer.is_modifier_kind(m.kind) and (m.kind <> KindDecorator)
                result.add(m)
            set i: i + 1
        }
        var pos 0
        var end 0
        if AstNode.list_range_of(node, originals, &pos, &end)
            f.set_list_range(result, pos, end)
        result
    }

    ; injectClassElementTypeMetadata: the decorators, the metadata, the modifiers
    procedure md_inject_class_element_type_metadata(this, list: ref[Array[ref[AstNode]?]]?, node: ref[AstNode], container: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        if container = null
            return list
        let c container as ref[AstNode]
        if Checker.is_class_like(c) = false
            return list
        if this.class_element_or_class_element_parameter_is_decorated(this.md_legacy_decorators(), node, c) = false
            return list
        let metadata this.md_get_type_metadata(node, c)
        if metadata.get_length() = 0
            return list
        if (list = null) or ((list as ref[Array[ref[AstNode]?]]).get_length() = 0)
        {
            if list <> null
            {
                var pos 0
                var end 0
                if AstNode.list_range_of(node, list, &pos, &end)
                    f.set_list_range(metadata, pos, end)
            }
            return metadata
        }
        let originals list as ref[Array[ref[AstNode]?]]
        let result &Array[ref[AstNode]?]^host()
        var i 0
        while i < (originals.get_length() as int)
        {
            let m originals[i as size_t] as ref[AstNode]
            if m.kind = KindDecorator
                result.add(m)
            set i: i + 1
        }
        Transformer.add_all(result, metadata)
        set i: 0
        while i < (originals.get_length() as int)
        {
            let m originals[i as size_t] as ref[AstNode]
            if Printer.is_modifier_kind(m.kind) and (m.kind <> KindDecorator)
                result.add(m)
            set i: i + 1
        }
        var pos 0
        var end 0
        if AstNode.list_range_of(node, originals, &pos, &end)
            f.set_list_range(result, pos, end)
        result
    }

    ; getTypeMetadata → getOldTypeMetadata (decorator metadata is not yet supported
    ; for ES decorators)
    procedure md_get_type_metadata(this, node: ref[AstNode], container: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let f factory
        let decorators &Array[ref[AstNode]?]^host()
        if this.md_legacy_decorators() = false
            return decorators
        if Transformer.md_should_add_type_metadata(node)
        {
            let type_metadata f.new_metadata_helper("design:type", this.ms_serialize_type_of_node_in(container, node, container))
            decorators.add(f.new_decorator(type_metadata))
        }
        if Transformer.md_should_add_param_types_metadata(node)
        {
            let param_types_metadata f.new_metadata_helper("design:paramtypes", this.ms_serialize_parameter_types_of_node_in(container, node, container))
            decorators.add(f.new_decorator(param_types_metadata))
        }
        if Transformer.md_should_add_return_type_metadata(node)
        {
            let return_type_metadata f.new_metadata_helper("design:returntype", this.ms_serialize_return_type_of_node_in(container, node))
            decorators.add(f.new_decorator(return_type_metadata))
        }
        decorators
    }

    function md_should_add_type_metadata(node: ref[AstNode]) returns bool
    {
        let k node.kind
        (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindPropertyDeclaration)
    }

    function md_should_add_return_type_metadata(node: ref[AstNode]) returns bool
        node.kind = KindMethodDeclaration

    function md_should_add_param_types_metadata(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if (k = KindClassDeclaration) or (k = KindClassExpression)
            return Transformer.get_first_constructor_with_body(node) <> null
        (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
    }

    ; ── the serializer, with its context (currentLexicalScope, currentNameScope,
    ; serializingConditionalTypeBranch) as fields ──

    procedure ms_serialize_type_of_node_in(this, name_scope: ref[AstNode]?, node: ref[AstNode], container: ref[AstNode]) returns ref[AstNode]
    {
        let saved_scope md_current_name_scope
        let saved_branch md_serializing_conditional_type_branch
        set this.md_current_name_scope: name_scope
        set this.md_serializing_conditional_type_branch: false
        let result this.ms_serialize_type_of_node(node, container)
        set this.md_current_name_scope: saved_scope
        set this.md_serializing_conditional_type_branch: saved_branch
        result
    }

    procedure ms_serialize_parameter_types_of_node_in(this, name_scope: ref[AstNode]?, node: ref[AstNode], container: ref[AstNode]) returns ref[AstNode]
    {
        let saved_scope md_current_name_scope
        let saved_branch md_serializing_conditional_type_branch
        set this.md_current_name_scope: name_scope
        set this.md_serializing_conditional_type_branch: false
        let result this.ms_serialize_parameter_types_of_node(node, container)
        set this.md_current_name_scope: saved_scope
        set this.md_serializing_conditional_type_branch: saved_branch
        result
    }

    procedure ms_serialize_return_type_of_node_in(this, name_scope: ref[AstNode]?, node: ref[AstNode]) returns ref[AstNode]
    {
        let saved_scope md_current_name_scope
        let saved_branch md_serializing_conditional_type_branch
        set this.md_current_name_scope: name_scope
        set this.md_serializing_conditional_type_branch: false
        let result this.ms_serialize_return_type_of_node(node)
        set this.md_current_name_scope: saved_scope
        set this.md_serializing_conditional_type_branch: saved_branch
        result
    }

    ; GetSetAccessorValueParameter
    function ms_get_set_accessor_value_parameter(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let parameters AstNode.parameters_of(node)
        if parameters = null
            return null
        let ps parameters as ref[Array[ref[AstNode]?]]
        if ps.get_length() = 0
            return null
        if ps.get_length() >= 2
        {
            if AstNode.is_this_parameter(ps[0] as ref[AstNode])
                return ps[1]
        }
        ps[0]
    }

    function ms_get_set_accessor_type_annotation_node(node: ref[AstNode]?) returns ref[AstNode]?
    {
        let p Transformer.ms_get_set_accessor_value_parameter(node)
        if p = null
            return null
        AstNode.type_of(p)
    }

    procedure ms_get_accessor_type_node(this, node: ref[AstNode], container: ref[AstNode]) returns ref[AstNode]?
    {
        let accessors this.get_all_accessor_declarations(Printer.member_list_of(container), node)
        if accessors.set_accessor <> null
            return Transformer.ms_get_set_accessor_type_annotation_node(accessors.set_accessor)
        if accessors.get_accessor <> null
            return AstNode.type_of(accessors.get_accessor)
        null
    }

    ; serializeTypeOfNode
    procedure ms_serialize_type_of_node(this, node: ref[AstNode], container: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let k node.kind
        if (k = KindPropertyDeclaration) or (k = KindParameter)
            return this.ms_serialize_type_node(AstNode.type_of(node))
        if (k = KindGetAccessor) or (k = KindSetAccessor)
            return this.ms_serialize_type_node(this.ms_get_accessor_type_node(node, container))
        if (k = KindClassDeclaration) or (k = KindClassExpression) or (k = KindMethodDeclaration)
            return f.new_identifier("Function")
        f.new_void_zero_expression()
    }

    ; serializeParameterTypesOfNode: `[Type, ...]` of the constructor or method
    procedure ms_serialize_parameter_types_of_node(this, node: ref[AstNode], container: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        var value_declaration: ref[AstNode]? null
        if Checker.is_class_like(node)
            set value_declaration: Transformer.get_first_constructor_with_body(node)
        else
        {
            if Parser.is_function_like_node(node) and Binder.node_is_present(AstNode.body_of(node))
                set value_declaration: node
        }
        let expressions &Array[ref[AstNode]?]^host()
        if value_declaration = null
            return f.new_array_literal_expression(expressions, false)
        let parameters this.ms_get_parameters_of_decorated_declaration(value_declaration as ref[AstNode], container)
        if parameters <> null
        {
            let ps parameters as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ps.get_length() as int)
            {
                let parameter ps[i as size_t] as ref[AstNode]
                set i: i + 1
                let name AstNode.name_of(parameter)
                if (i = 1) and (AstNode.kind_of(name) = KindIdentifier)
                {
                    if AstNode.identifier_text_of(name as ref[AstNode]).equals("this")
                        continue
                }
                if AstNode.dot_dot_dot_token_of(parameter) <> null
                    expressions.add(this.ms_serialize_type_node(Transformer.get_rest_parameter_element_type(AstNode.type_of(parameter))))
                else
                    expressions.add(this.ms_serialize_type_of_node(parameter, container))
            }
        }
        f.new_array_literal_expression(expressions, false)
    }

    procedure ms_get_parameters_of_decorated_declaration(this, node: ref[AstNode], container: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]?
    {
        if (container <> null) and (node.kind = KindGetAccessor)
        {
            let acc this.get_all_accessor_declarations(Printer.member_list_of(container as ref[AstNode]), node)
            if acc.set_accessor <> null
                return AstNode.parameters_of(acc.set_accessor)
        }
        AstNode.parameters_of(node)
    }

    ; ast.GetRestParameterElementType: `T[]` → T, `Array<T>` → T
    function get_rest_parameter_element_type(node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        let n node as ref[AstNode]
        if n.kind = KindArrayType
            return AstNode.array_element_type_of(n)
        if n.kind = KindTypeReference
        {
            let args AstNode.type_reference_arguments_of(n)
            if args <> null
            {
                let a args as ref[Array[ref[AstNode]?]]
                if a.get_length() > 0
                    return a[0]
            }
        }
        null
    }

    ; ast.IsAsyncFunction
    function is_async_function(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindArrowFunction) or (k = KindMethodDeclaration)
            return (AstNode.body_of(node) <> null) and (AstNode.asterisk_token_of(node) = null) and Transformer.has_syntactic_modifier(node, ModifierFlagsAsync)
        false
    }

    procedure ms_serialize_return_type_of_node(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if Parser.is_function_like_node(node) and (AstNode.type_of(node) <> null)
            return this.ms_serialize_type_node(AstNode.type_of(node))
        if Transformer.is_async_function(node)
            return f.new_identifier("Promise")
        f.new_void_zero_expression()
    }

    ; serializeTypeNode: the runtime constructor a type points to
    procedure ms_serialize_type_node(this, node_in: ref[AstNode]?) returns ref[AstNode]
    {
        let f factory
        if node_in = null
            return f.new_identifier("Object")
        let node Checker.skip_type_parentheses(node_in) as ref[AstNode]
        let k node.kind
        if (k = KindVoidKeyword) or (k = KindUndefinedKeyword) or (k = KindNeverKeyword)
            return f.new_void_zero_expression()
        if (k = KindFunctionType) or (k = KindConstructorType)
            return f.new_identifier("Function")
        if (k = KindArrayType) or (k = KindTupleType)
            return f.new_identifier("Array")
        if k = KindTypePredicate
        {
            if AstNode.type_predicate_asserts_modifier_of(node) <> null
                return f.new_void_zero_expression()
            return f.new_identifier("Boolean")
        }
        if k = KindBooleanKeyword
            return f.new_identifier("Boolean")
        if (k = KindTemplateLiteralType) or (k = KindStringKeyword)
            return f.new_identifier("String")
        if k = KindObjectKeyword
            return f.new_identifier("Object")
        if k = KindLiteralType
            return this.ms_serialize_literal_of_literal_type_node(AstNode.literal_type_inner_of(node) as ref[AstNode])
        if k = KindNumberKeyword
            return f.new_identifier("Number")
        if k = KindBigIntKeyword
            return this.ms_serialize_big_int_constructor()
        if k = KindSymbolKeyword
            return f.new_identifier("Symbol")
        if k = KindTypeReference
            return this.ms_serialize_type_reference_node(node)
        if k = KindIntersectionType
            return this.ms_serialize_union_or_intersection_constituents(AstNode.type_list_of(node), true)
        if k = KindUnionType
            return this.ms_serialize_union_or_intersection_constituents(AstNode.type_list_of(node), false)
        if k = KindConditionalType
        {
            let old_state md_serializing_conditional_type_branch
            set this.md_serializing_conditional_type_branch: true
            let branches &Array[ref[AstNode]?]^host()
            branches.add(AstNode.conditional_true_type_of(node))
            branches.add(AstNode.conditional_false_type_of(node))
            let result this.ms_serialize_union_or_intersection_constituents(branches, false)
            set this.md_serializing_conditional_type_branch: old_state
            return result
        }
        if k = KindTypeOperator
        {
            if AstNode.type_operator_operator_of(node) = KindReadonlyKeyword
                return this.ms_serialize_type_node(AstNode.type_operator_inner_of(node))
            return f.new_identifier("Object")
        }
        if (k = KindJSDocNullableType) or (k = KindJSDocNonNullableType) or (k = KindJSDocOptionalType)
            return this.ms_serialize_type_node(Printer.wrapped_inner_of(node))
        ; TypeQuery, IndexedAccessType, MappedType, TypeLiteral, any, unknown, this,
        ; ImportType, the JSDoc all/variadic types — and anything else — are Object
        f.new_identifier("Object")
    }

    procedure ms_serialize_union_or_intersection_constituents(this, types: ref[Array[ref[AstNode]?]]?, is_intersection: bool) returns ref[AstNode]
    {
        let f factory
        var serialized_type: ref[AstNode]? null
        if types <> null
        {
            let ts types as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ts.get_length() as int)
            {
                let type_node Checker.skip_type_parentheses(ts[i as size_t]) as ref[AstNode]
                set i: i + 1
                let k type_node.kind
                if k = KindNeverKeyword
                {
                    if is_intersection
                        return f.new_void_zero_expression()
                    continue
                }
                if k = KindUnknownKeyword
                {
                    if is_intersection = false
                        return f.new_identifier("Object")
                    continue
                }
                if k = KindAnyKeyword
                    return f.new_identifier("Object")
                if md_strict_null_checks = false
                {
                    var elide k = KindUndefinedKeyword
                    if k = KindLiteralType
                    {
                        if AstNode.kind_of(AstNode.literal_type_inner_of(type_node)) = KindNullKeyword
                            set elide: true
                    }
                    if elide
                        continue
                }
                let serialized_constituent this.ms_serialize_type_node(type_node)
                if serialized_constituent.kind = KindIdentifier
                {
                    if AstNode.identifier_text_of(serialized_constituent).equals("Object")
                        return serialized_constituent
                }
                if serialized_type <> null
                {
                    if this.ms_equate_serialized_type_nodes(serialized_type as ref[AstNode], serialized_constituent) = false
                        return f.new_identifier("Object")
                }
                else
                    set serialized_type: serialized_constituent
            }
        }
        if serialized_type <> null
            return serialized_type as ref[AstNode]
        f.new_void_zero_expression()
    }

    procedure ms_serialize_literal_of_literal_type_node(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let k node.kind
        if (k = KindStringLiteral) or (k = KindNoSubstitutionTemplateLiteral)
            return f.new_identifier("String")
        if k = KindPrefixUnaryExpression
        {
            let operand AstNode.prefix_unary_operand_of(node) as ref[AstNode]
            if (operand.kind = KindNumericLiteral) or (operand.kind = KindBigIntLiteral)
                return this.ms_serialize_literal_of_literal_type_node(operand)
            return f.new_identifier("Object")
        }
        if k = KindNumericLiteral
            return f.new_identifier("Number")
        if k = KindBigIntLiteral
            return this.ms_serialize_big_int_constructor()
        if (k = KindTrueKeyword) or (k = KindFalseKeyword)
            return f.new_identifier("Boolean")
        if k = KindNullKeyword
            return f.new_void_zero_expression()
        f.new_identifier("Object")
    }

    ; serializeTypeReferenceNode: what the checker says the name is at runtime
    procedure ms_serialize_type_reference_node(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        var serial_scope md_current_name_scope
        if serial_scope = null
            set serial_scope: md_current_lexical_scope
        let type_name AstNode.type_reference_name_of(node) as ref[AstNode]
        let kind this.the_checker().get_type_reference_serialization_kind(context.parse_node(type_name), context.parse_node(serial_scope))
        if kind = TypeReferenceSerializationKindUnknown
        {
            ; a conditional type's unresolved reference is any/unknown
            if md_serializing_conditional_type_branch
                return f.new_identifier("Object")
            let serialized this.ms_serialize_entity_name_as_expression_fallback(type_name)
            let temp f.new_temp_variable()
            context.add_variable_declaration(temp)
            return f.new_conditional_expression(f.new_type_check(f.new_assignment_expression(temp, serialized), "function"), f.new_token(KindQuestionToken), temp, f.new_token(KindColonToken), f.new_identifier("Object"))
        }
        if kind = TypeReferenceSerializationKindTypeWithConstructSignatureAndValue
            return this.ms_serialize_entity_name_as_expression(type_name) as ref[AstNode]
        if kind = TypeReferenceSerializationKindVoidNullableOrNeverType
            return f.new_void_zero_expression()
        if kind = TypeReferenceSerializationKindBigIntLikeType
            return this.ms_serialize_big_int_constructor()
        if kind = TypeReferenceSerializationKindBooleanType
            return f.new_identifier("Boolean")
        if kind = TypeReferenceSerializationKindNumberLikeType
            return f.new_identifier("Number")
        if kind = TypeReferenceSerializationKindStringLikeType
            return f.new_identifier("String")
        if kind = TypeReferenceSerializationKindArrayLikeType
            return f.new_identifier("Array")
        if kind = TypeReferenceSerializationKindESSymbolType
            return f.new_identifier("Symbol")
        if kind = TypeReferenceSerializationKindTypeWithCallSignature
            return f.new_identifier("Function")
        if kind = TypeReferenceSerializationKindPromise
            return f.new_identifier("Promise")
        f.new_identifier("Object")
    }

    procedure ms_serialize_big_int_constructor(this) returns ref[AstNode]
    {
        let f factory
        if opts.options.get_emit_script_target() >= ScriptTargetES2020
            return f.new_identifier("BigInt")
        f.new_conditional_expression(f.new_type_check(f.new_identifier("BigInt"), "function"), f.new_token(KindQuestionToken), f.new_identifier("BigInt"), f.new_token(KindColonToken), f.new_identifier("Object"))
    }

    ; serializeEntityNameAsExpression: a clone of the name that emulates a parse node
    procedure ms_serialize_entity_name_as_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if node.kind = KindIdentifier
        {
            let name f.clone(node)
            set name.pos: node.pos
            set name.end: node.end
            context.unset_original(name)
            set name.parent: context.parse_node(md_current_lexical_scope)
            return name
        }
        if node.kind = KindQualifiedName
            return f.new_property_access_expression(this.ms_serialize_entity_name_as_expression(AstNode.qualified_left_of(node) as ref[AstNode]) as ref[AstNode], null, AstNode.qualified_right_of(node), NodeFlagsNone)
        null
    }

    ; serializeEntityNameAsExpressionFallback: a name that may not exist at runtime
    procedure ms_serialize_entity_name_as_expression_fallback(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if node.kind = KindIdentifier
        {
            ; A -> typeof A !== "undefined" && A
            let copied this.ms_serialize_entity_name_as_expression(node) as ref[AstNode]
            return this.ms_create_checked_value(copied, copied)
        }
        let left_name AstNode.qualified_left_of(node) as ref[AstNode]
        if left_name.kind = KindIdentifier
        {
            ; A.B -> typeof A !== "undefined" && A.B
            return this.ms_create_checked_value(this.ms_serialize_entity_name_as_expression(left_name) as ref[AstNode], this.ms_serialize_entity_name_as_expression(node) as ref[AstNode])
        }
        ; A.B.C -> typeof A !== "undefined" && (_a = A.B) !== void 0 && _a.C
        let left this.ms_serialize_entity_name_as_expression_fallback(left_name)
        let temp f.new_temp_variable()
        context.add_variable_declaration(temp)
        f.new_logical_and_expression(f.new_logical_and_expression(AstNode.binary_left_of(left) as ref[AstNode], f.new_strict_inequality_expression(f.new_assignment_expression(temp, AstNode.binary_right_of(left) as ref[AstNode]), f.new_void_zero_expression())), f.new_property_access_expression(temp, null, AstNode.qualified_right_of(node), NodeFlagsNone))
    }

    ; `typeof left !== "undefined" && right`
    procedure ms_create_checked_value(this, left: ref[AstNode], right: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        f.new_logical_and_expression(f.new_strict_inequality_expression(f.new_type_of_expression(left), f.new_string_literal("undefined", TokenFlagsNone)), right)
    }

    procedure ms_equate_serialized_type_nodes(this, left: ref[AstNode], right: ref[AstNode]) returns bool
    {
        ; temp vars used in fallback
        if context.has_auto_generate_info(left)
            return context.has_auto_generate_info(right)
        let lk left.kind
        let rk right.kind
        if lk = KindIdentifier
        {
            if rk <> KindIdentifier
                return false
            let lt AstNode.identifier_text_of(left)
            return lt.equals(AstNode.identifier_text_of(right))
        }
        if lk = KindPropertyAccessExpression
        {
            if rk <> KindPropertyAccessExpression
                return false
            if this.ms_equate_serialized_type_nodes(AstNode.expression_of(left) as ref[AstNode], AstNode.expression_of(right) as ref[AstNode]) = false
                return false
            return this.ms_equate_serialized_type_nodes(AstNode.name_of(left) as ref[AstNode], AstNode.name_of(right) as ref[AstNode])
        }
        if lk = KindVoidExpression
        {
            if rk <> KindVoidExpression
                return false
            let le AstNode.expression_of(left) as ref[AstNode]
            let re AstNode.expression_of(right) as ref[AstNode]
            if (le.kind <> KindNumericLiteral) or (re.kind <> KindNumericLiteral)
                return false
            let lz AstNode.literal_text_of(le)
            if lz.equals("0") = false
                return false
            let rz AstNode.literal_text_of(re)
            return rz.equals("0")
        }
        if lk = KindStringLiteral
        {
            if rk <> KindStringLiteral
                return false
            let ls AstNode.literal_text_of(left)
            return ls.equals(AstNode.literal_text_of(right))
        }
        if lk = KindTypeOfExpression
            return (rk = KindTypeOfExpression) and this.ms_equate_serialized_type_nodes(AstNode.expression_of(left) as ref[AstNode], AstNode.expression_of(right) as ref[AstNode])
        if lk = KindParenthesizedExpression
            return (rk = KindParenthesizedExpression) and this.ms_equate_serialized_type_nodes(AstNode.expression_of(left) as ref[AstNode], AstNode.expression_of(right) as ref[AstNode])
        if lk = KindConditionalExpression
        {
            if rk <> KindConditionalExpression
                return false
            if this.ms_equate_serialized_type_nodes(AstNode.conditional_condition_of(left) as ref[AstNode], AstNode.conditional_condition_of(right) as ref[AstNode]) = false
                return false
            if this.ms_equate_serialized_type_nodes(AstNode.conditional_when_true_of(left) as ref[AstNode], AstNode.conditional_when_true_of(right) as ref[AstNode]) = false
                return false
            return this.ms_equate_serialized_type_nodes(AstNode.conditional_when_false_of(left) as ref[AstNode], AstNode.conditional_when_false_of(right) as ref[AstNode])
        }
        if lk = KindBinaryExpression
        {
            if rk <> KindBinaryExpression
                return false
            if AstNode.binary_operator_kind(left) <> AstNode.binary_operator_kind(right)
                return false
            if this.ms_equate_serialized_type_nodes(AstNode.binary_left_of(left) as ref[AstNode], AstNode.binary_left_of(right) as ref[AstNode]) = false
                return false
            return this.ms_equate_serialized_type_nodes(AstNode.binary_right_of(left) as ref[AstNode], AstNode.binary_right_of(right) as ref[AstNode])
        }
        false
    }

    ; ── ast/utilities.go: the get/set pair of an accessor, and the decorated-element
    ; question that needs it (slice 245) ──

    ; GetAllAccessorDeclarations(parentDeclarations, accessor)
    procedure get_all_accessor_declarations(this, parent_declarations: ref[Array[ref[AstNode]?]]?, accessor: ref[AstNode]) returns AccessorPair
    {
        let matches &Array[ref[AstNode]?]^host()
        if (opts.binder as ref[Binder]).has_dynamic_name(accessor)
            matches.add(accessor)
        else
        {
            let accessor_name AstNode.property_name_text_of(AstNode.name_of(accessor))
            let accessor_static (opts.binder as ref[Binder]).is_static(accessor)
            if parent_declarations <> null
            {
                let ms parent_declarations as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (ms.get_length() as int)
                {
                    let member ms[i as size_t] as ref[AstNode]
                    set i: i + 1
                    if (member.kind <> KindGetAccessor) and (member.kind <> KindSetAccessor)
                        continue
                    if (opts.binder as ref[Binder]).is_static(member) <> accessor_static
                        continue
                    if AstNode.property_name_text_of(AstNode.name_of(member)).equals(accessor_name)
                        matches.add(member)
                }
            }
        }
        Transformer.get_all_accessor_declarations_for_declaration(accessor, matches)
    }

    ; GetAllAccessorDeclarationsForDeclaration
    function get_all_accessor_declarations_for_declaration(accessor: ref[AstNode], declarations_of_symbol: ref[Array[ref[AstNode]?]]) returns AccessorPair
    {
        var other_kind KindGetAccessor
        if accessor.kind = KindGetAccessor
            set other_kind: KindSetAccessor
        var other_accessor: ref[AstNode]? null
        var i 0
        while i < (declarations_of_symbol.get_length() as int)
        {
            let d declarations_of_symbol[i as size_t] as ref[AstNode]
            set i: i + 1
            if d.kind = other_kind
            {
                set other_accessor: d
                break
            }
        }
        var first_accessor accessor
        var second_accessor other_accessor
        if other_accessor <> null
        {
            if (other_accessor as ref[AstNode]).pos < accessor.pos
            {
                set first_accessor: other_accessor as ref[AstNode]
                set second_accessor: accessor
            }
        }
        var set_accessor: ref[AstNode]? null
        var get_accessor: ref[AstNode]? null
        if accessor.kind = KindSetAccessor
        {
            set set_accessor: accessor
            set get_accessor: other_accessor
        }
        else
        {
            set get_accessor: accessor
            set set_accessor: other_accessor
        }
        AccessorPair(first_accessor, second_accessor, get_accessor, set_accessor)
    }

    ; ast.ClassElementOrClassElementParameterIsDecorated
    procedure class_element_or_class_element_parameter_is_decorated(this, use_legacy_decorators: bool, node: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        var parameters: ref[Array[ref[AstNode]?]]? null
        if (node.kind = KindGetAccessor) or (node.kind = KindSetAccessor)
        {
            let decls this.get_all_accessor_declarations(Printer.member_list_of(parent), node)
            var first_accessor_with_decorators: ref[AstNode]? null
            if Transformer.has_decorators(decls.first_accessor)
                set first_accessor_with_decorators: decls.first_accessor
            else
            {
                if decls.second_accessor <> null
                {
                    if Transformer.has_decorators(decls.second_accessor as ref[AstNode])
                        set first_accessor_with_decorators: decls.second_accessor
                }
            }
            if first_accessor_with_decorators = null
                return false
            if Transformer.same_node(node, first_accessor_with_decorators as ref[AstNode]) = false
                return false
            if decls.set_accessor <> null
                set parameters: AstNode.parameters_of(decls.set_accessor)
        }
        else
        {
            if node.kind = KindMethodDeclaration
                set parameters: AstNode.parameters_of(node)
        }
        if this.the_checker().node_is_decorated(use_legacy_decorators, node, parent, null)
            return true
        if parameters <> null
        {
            let ps parameters as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ps.get_length() as int)
            {
                let parameter ps[i as size_t] as ref[AstNode]
                set i: i + 1
                if AstNode.is_this_parameter(parameter)
                    continue
                if this.the_checker().node_is_decorated(use_legacy_decorators, parameter, node, parent)
                    return true
            }
        }
        false
    }

    ; ═══ tstransforms/importelision.go (slice 237) ═══

    procedure visit_import_elision(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if k = KindSourceFile
        {
            this.the_checker().mark_linked_references_recursively(context.most_original(node) as ref[AstNode])
            let saved current_source_file
            set this.current_source_file: node
            let visited v.visit_each_child(node)
            set this.current_source_file: saved
            return visited
        }
        if k = KindImportEqualsDeclaration
        {
            if AstNode.kind_of(AstNode.module_reference_of(node)) = KindExternalModuleReference
            {
                if this.should_emit_alias_declaration(node) = false
                    return null
            }
            else
            {
                if this.should_emit_import_equals_declaration(node) = false
                    return null
            }
            return v.visit_each_child(node)
        }
        if k = KindImportDeclaration
        {
            let import_clause AstNode.import_clause_of(node)
            if import_clause <> null
            {
                let visited v.visit_node(import_clause)
                if visited = null
                    return null
                return factory.update_import_declaration(node, Printer.modifier_list_of(node), visited, AstNode.module_specifier_of(node), v.visit_node(AstNode.import_attributes_of(node)))
            }
            return v.visit_each_child(node)
        }
        if k = KindImportClause
        {
            var name: ref[AstNode]? null
            if this.should_emit_alias_declaration(node)
                set name: Printer.declaration_name_of(node)
            let named_bindings v.visit_node(AstNode.named_bindings_of(node))
            if (name = null) and (named_bindings = null)
                return null
            return factory.update_import_clause(node, AstNode.import_clause_phase_modifier_of(node), name, named_bindings)
        }
        if k = KindNamespaceImport
        {
            if this.should_emit_alias_declaration(node) = false
                return null
            return node
        }
        if k = KindNamedImports
        {
            let elements v.visit_nodes(AstNode.elements_of(node))
            if Transformer.list_is_empty(elements)
                return null
            return factory.update_named_imports(node, elements)
        }
        if k = KindImportSpecifier
        {
            if this.should_emit_alias_declaration(node) = false
                return null
            return node
        }
        if k = KindExportAssignment
        {
            if (opts.options.verbatim_module_syntax <> TristateTrue) and (this.ie_is_value_alias_declaration(node) = false)
                return null
            return v.visit_each_child(node)
        }
        if k = KindExportDeclaration
        {
            var export_clause: ref[AstNode]? null
            let ec AstNode.export_clause_of(node)
            if ec <> null
            {
                set export_clause: v.visit_node(ec)
                if export_clause = null
                    return null
            }
            return factory.update_export_declaration(node, null, false, export_clause, v.visit_node(AstNode.module_specifier_of(node)), v.visit_node(AstNode.import_attributes_of(node)))
        }
        if k = KindNamedExports
        {
            let elements v.visit_nodes(AstNode.elements_of(node))
            if Transformer.list_is_empty(elements)
                return null
            return factory.update_named_exports(node, elements)
        }
        if k = KindExportSpecifier
        {
            if this.ie_is_value_alias_declaration(node) = false
                return null
            return node
        }
        if (k = KindModuleDeclaration) or (k = KindModuleBlock)
            return v.visit_each_child(node)
        node
    }

    procedure should_emit_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        if (node.flags & NodeFlagsJavaScriptFile) <> 0
            return true
        this.ie_is_referenced_alias_declaration(node)
    }

    procedure should_emit_import_equals_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.should_emit_alias_declaration(node)
            return true
        if opts.file_info.is_external_module
            return false
        this.ie_is_top_level_value_import_equals_with_entity_name(node)
    }

    procedure ie_is_referenced_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return true
        this.the_checker().is_referenced_alias_declaration(p as ref[AstNode])
    }

    procedure ie_is_value_alias_declaration(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return true
        this.the_checker().is_value_alias_declaration(p as ref[AstNode])
    }

    procedure ie_is_top_level_value_import_equals_with_entity_name(this, node: ref[AstNode]) returns bool
    {
        let p context.parse_node(node)
        if p = null
            return false
        this.the_checker().is_top_level_value_import_equals_with_entity_name(p as ref[AstNode])
    }

    ; ═══ tstransforms/runtimesyntax.go (slice 238) ═══
    ;
    ; TypeScript's RUNTIME syntax — enums, namespaces, `import x = N.M`,
    ; parameter properties, the exports of a namespace body — into JavaScript.
    ; The reference's `resolver` (binder.ReferenceResolver with EMPTY hooks) is
    ; `Checker.get_referenced_export_container`, its `emitResolver` the checker
    ; itself (§3.41). One said stop: a destructuring `export var {a} = x` inside a
    ; namespace needs FlattenDestructuringAssignment (transformers/destructuring.go),
    ; which lands with the ES chapter that needs it everywhere.

    procedure push_scope(this, node: ref[AstNode], saved_scope: ref[ref[AstNode]?], saved_names: ref[ref[Array[NameNode]]?])
    {
        set saved_scope: current_scope
        set saved_names: current_scope_first_declarations
        let k node.kind
        if k = KindSourceFile
        {
            set this.current_scope: node
            set this.current_source_file: node
            set this.current_scope_first_declarations: null
            return
        }
        if (k = KindCaseBlock) or (k = KindModuleBlock) or (k = KindBlock)
        {
            set this.current_scope: node
            set this.current_scope_first_declarations: null
            return
        }
        if (k = KindFunctionDeclaration) or (k = KindClassDeclaration) or (k = KindVariableStatement)
            this.record_declaration_in_scope(node)
    }

    procedure pop_scope(this, saved_scope: ref[AstNode]?, saved_names: ref[Array[NameNode]]?)
    {
        if current_scope <> saved_scope
            set this.current_scope_first_declarations: saved_names
        set this.current_scope: saved_scope
    }

    procedure visit_runtime_syntax(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        var saved_scope: ref[AstNode]? null
        var saved_names: ref[Array[NameNode]]? null
        this.push_scope(node, &saved_scope, &saved_names)
        let result this.visit_runtime_syntax_worker(node)
        this.pop_scope(saved_scope, saved_names)
        this.pop_node(grandparent)
        result
    }

    procedure visit_runtime_syntax_worker(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let facts Emitter.subtree_facts(node)
        if (facts & SubtreeContainsTypeScript) = 0
        {
            if (current_namespace = null) and (current_enum = null)
                return node
            if (facts & SubtreeContainsIdentifier) = 0
                return node
        }
        let k node.kind
        ; TypeScript parameter property modifiers are elided
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindReadonlyKeyword) or (k = KindOverrideKeyword)
            return null
        if k = KindEnumDeclaration
            return this.rs_visit_enum_declaration(node)
        if k = KindModuleDeclaration
            return this.rs_visit_module_declaration(node)
        if k = KindClassDeclaration
            return this.rs_visit_class_declaration(node)
        if k = KindClassExpression
            return this.rs_visit_class_expression(node)
        if k = KindConstructor
            return this.rs_visit_constructor_declaration(node)
        if k = KindFunctionDeclaration
            return this.rs_visit_function_declaration(node)
        if k = KindVariableStatement
            return this.rs_visit_variable_statement(node)
        if (k = KindExportDeclaration) or (k = KindImportDeclaration) or (k = KindImportClause)
        {
            ; do not emit ES6 imports and exports since they are illegal inside a namespace
            if this.rs_in_namespace_body()
                return null
            return v.visit_each_child(node)
        }
        if k = KindImportEqualsDeclaration
        {
            let external AstNode.kind_of(AstNode.module_reference_of(node)) = KindExternalModuleReference
            if this.rs_in_namespace_body() and external
                return null
            if (current_namespace <> null) and (current_scope <> null) and (AstNode.kind_of(current_scope) = KindBlock) and (external = false)
                return null
            return this.rs_visit_import_equals_declaration(node)
        }
        if k = KindIdentifier
            return this.rs_visit_identifier(node)
        if k = KindShorthandPropertyAssignment
            return this.rs_visit_shorthand_property_assignment(node)
        v.visit_each_child(node)
    }

    ; `tx.currentNamespace != nil && tx.currentScope != nil && tx.currentScope.Kind != KindBlock`
    function rs_in_namespace_body(this) returns bool
    {
        if current_namespace = null
            return false
        if current_scope = null
            return false
        AstNode.kind_of(current_scope) <> KindBlock
    }

    ; recordDeclarationInScope
    procedure record_declaration_in_scope(this, node: ref[AstNode])
    {
        let k node.kind
        if k = KindVariableStatement
        {
            let dl Printer.declaration_list_of(node)
            if dl <> null
                this.record_declaration_in_scope(dl as ref[AstNode])
            return
        }
        if k = KindVariableDeclarationList
        {
            this.record_declarations_in_scope(Printer.declarations_of(node))
            return
        }
        if (k = KindArrayBindingPattern) or (k = KindObjectBindingPattern)
        {
            this.record_declarations_in_scope(AstNode.elements_of(node))
            return
        }
        let name Printer.declaration_name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if nm.kind = KindIdentifier
        {
            if current_scope_first_declarations = null
                set this.current_scope_first_declarations: &Array[NameNode]^host()
            let table current_scope_first_declarations as ref[Array[NameNode]]
            let text AstNode.identifier_text_of(nm)
            if Transformer.first_declaration_of(table, text) = null
                table.add(NameNode(text, node))
            return
        }
        if AstNode.is_binding_pattern(nm)
            this.record_declaration_in_scope(nm)
    }

    procedure record_declarations_in_scope(this, list: ref[Array[ref[AstNode]?]]?)
    {
        if list = null
            return
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            let d l[i as size_t]
            set i: i + 1
            if d <> null
                this.record_declaration_in_scope(d as ref[AstNode])
        }
    }

    function first_declaration_of(table: ref[Array[NameNode]], text: Slice[char]) returns ref[AstNode]?
    {
        var i 0
        while i < (table.get_length() as int)
        {
            let e table[i as size_t]
            set i: i + 1
            if e.name.equals(text)
                return e.node
        }
        null
    }

    ; isFirstDeclarationInScope
    function is_first_declaration_in_scope(this, node: ref[AstNode]) returns bool
    {
        let name Printer.declaration_name_of(node)
        if name = null
            return false
        let nm name as ref[AstNode]
        if nm.kind <> KindIdentifier
            return false
        if current_scope_first_declarations = null
            return false
        let first Transformer.first_declaration_of(current_scope_first_declarations as ref[Array[NameNode]], AstNode.identifier_text_of(nm))
        if first = null
            return false
        first = node
    }

    ; isExportOfNamespace
    function is_export_of_namespace(this, node: ref[AstNode]) returns bool
    {
        if current_namespace = null
            return false
        if current_scope <> null
        {
            if AstNode.kind_of(current_scope) = KindBlock
                return false
        }
        (Transformer.modifier_flags_of(node) & ModifierFlagsExport) <> 0
    }

    ; getExpressionForPropertyName: `"foo"` for the identifier `foo`
    procedure rs_expression_for_property_name(this, member: ref[AstNode]) returns ref[AstNode]?
    {
        let name Printer.declaration_name_of(member)
        if name = null
            return null
        let nm name as ref[AstNode]
        let k nm.kind
        if k = KindPrivateIdentifier
        {
            let empty: Slice[char] ""
            return factory.new_identifier(empty)
        }
        if k = KindComputedPropertyName
            return this.the_visitor().visit_node(AstNode.expression_of(nm))
        if k = KindIdentifier
            return factory.new_string_literal(AstNode.identifier_text_of(nm), TokenFlagsNone)
        if k = KindStringLiteral
            return factory.new_string_literal(AstNode.literal_text_of(nm), TokenFlagsNone)
        if k = KindNumericLiteral
            return factory.new_numeric_literal(AstNode.literal_text_of(nm), TokenFlagsNone)
        nm
    }

    ; getEnumQualifiedElement: `E["A"]`
    procedure rs_enum_qualified_element(this, enum_node: ref[AstNode], member: ref[AstNode]) returns ref[AstNode]
    {
        let prop this.rs_namespace_qualified_element(this.rs_namespace_container_name(enum_node), this.rs_expression_for_property_name(member))
        context.add_emit_flags(prop, EFNoComments | EFNoNestedComments | EFNoSourceMap | EFNoNestedSourceMaps)
        prop
    }

    ; getNamespaceContainerName
    procedure rs_namespace_container_name(this, node: ref[AstNode]) returns ref[AstNode]
        factory.new_generated_name_for_node(node)

    ; getNamespaceQualifiedProperty
    procedure rs_namespace_qualified_property(this, ns: ref[AstNode], name: ref[AstNode]) returns ref[AstNode]
        factory.get_namespace_member_name(ns, name, false, true)

    ; getNamespaceQualifiedElement
    procedure rs_namespace_qualified_element(this, ns: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        let qualified factory.new_element_access_expression(ns, null, expression, NodeFlagsNone)
        if expression <> null
            context.assign_comment_and_source_map_ranges(qualified, expression as ref[AstNode])
        qualified
    }

    ; getExportQualifiedReferenceToDeclaration
    procedure rs_export_qualified_reference_to_declaration(this, node: ref[AstNode]) returns ref[AstNode]
    {
        if this.is_export_of_namespace(node)
            return factory.get_external_module_or_namespace_export_name(this.rs_namespace_container_name(current_namespace as ref[AstNode]), node, false, true)
        factory.get_declaration_name_ex(node, false, true)
    }

    ; addVarForDeclaration: `var name;` once per scope, answered whether it was added
    procedure rs_add_var_for_declaration(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode]) returns bool
    {
        this.record_declaration_in_scope(node)
        if this.is_first_declaration_in_scope(node) = false
            return false
        let name factory.get_local_name_ex(node, false, true, false)
        let var_decl factory.new_variable_declaration(name, null, null, null)
        var var_flags NodeFlagsNone
        if current_scope <> current_source_file
            set var_flags: NodeFlagsLet
        let decls &Array[ref[AstNode]?]^host()
        decls.add(var_decl)
        let var_decls factory.new_variable_declaration_list(decls, var_flags)
        ; Replicate modifierVisitor: strip decorators, TypeScript modifiers, and export when in namespace.
        var mask ModifierFlagsAll xor (ModifierFlagsTypeScriptModifier | ModifierFlagsDecorator)
        if current_namespace <> null
            set mask: mask & (ModifierFlagsAll xor ModifierFlagsExport)
        let modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), mask)
        let var_statement factory.new_variable_statement(modifiers, var_decls)
        context.set_original(var_decl, node)
        context.set_original(var_statement, node)
        ; Adjust the source map emit to match the old emitter.
        if node.kind = KindEnumDeclaration
            context.set_source_map_range(var_decls, TextRange.of_node(node))
        else
            context.set_source_map_range(var_statement, TextRange.of_node(node))
        ; Trailing comments for enum declaration should be emitted after the function closure
        ; instead of the variable statement
        context.set_comment_range(var_statement, TextRange.of_node(node))
        context.add_emit_flags(var_statement, EFNoTrailingComments)
        statements.add(var_statement)
        true
    }

    ; `(function (name) { ... })(name || (name = {}))` — the shape enum and
    ; module declarations share (visitEnumDeclaration / visitModuleDeclaration)
    procedure rs_visit_container_declaration(this, node: ref[AstNode], is_enum: bool) returns ref[AstNode]?
    {
        let statements &Array[ref[AstNode]?]^host()
        let var_added this.rs_add_var_for_declaration(statements, node)
        var emit_flags EFNone
        if var_added
        {
            if (opts.options.get_emit_module_kind() <> ModuleKindSystem) or (current_scope <> current_source_file)
                set emit_flags: emit_flags | EFNoLeadingComments
        }
        ;  x || (x = {})
        ;  exports.x || (exports.x = {})
        var arg factory.new_logical_or_expression(this.rs_export_qualified_reference_to_declaration(node), factory.new_assignment_expression(this.rs_export_qualified_reference_to_declaration(node), factory.new_object_literal_expression(&Array[ref[AstNode]?]^host(), false)))
        if this.is_export_of_namespace(node)
        {
            ;  x = (exports.x || (exports.x = {}))
            let local_name factory.get_local_name_ex(node, false, true, false)
            set arg: factory.new_assignment_expression(local_name, arg)
        }
        let param_name factory.new_generated_name_for_node(node)
        let name Printer.declaration_name_of(node)
        if name <> null
            context.set_source_map_range(param_name, TextRange.of_node(name as ref[AstNode]))
        let param factory.new_parameter_declaration(null, null, param_name, null, null, null)
        var body: ref[AstNode]? null
        if is_enum
            set body: this.rs_transform_enum_body(node)
        else
            set body: this.rs_transform_module_body(node, this.rs_namespace_container_name(node))
        let params &Array[ref[AstNode]?]^host()
        params.add(param)
        let func factory.new_function_expression(null, null, null, null, params, null, null, body)
        let args &Array[ref[AstNode]?]^host()
        args.add(arg)
        let call factory.new_call_expression(factory.new_parenthesized_expression(func), null, null, args, NodeFlagsNone)
        let statement factory.new_expression_statement(call)
        context.set_original(statement, node)
        context.assign_comment_and_source_map_ranges(statement, node)
        context.add_emit_flags(statement, emit_flags)
        statements.add(statement)
        factory.new_syntax_list(statements)
    }

    procedure rs_visit_enum_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.rs_should_emit_enum_declaration(node) = false
            return context.new_not_emitted_statement(node)
        this.rs_visit_container_declaration(node, true)
    }

    ; transformEnumBody
    procedure rs_transform_enum_body(this, node_in: ref[AstNode]) returns ref[AstNode]
    {
        let saved_enum current_enum
        set this.current_enum: node_in
        ; visit the children of `node` in advance to capture any references to enum members
        let node this.the_visitor().visit_each_child(node_in) as ref[AstNode]
        let statements &Array[ref[AstNode]?]^host()
        let members Printer.member_list_of(node)
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ml.get_length() as int)
            {
                this.rs_transform_enum_member(statements, node, i)
                set i: i + 1
            }
            var mp 0 - 1
            var me 0 - 1
            AstNode.list_range_of(current_source_file, members, &mp, &me)
            factory.set_list_range(statements, mp, me)
        }
        set this.current_enum: saved_enum
        factory.new_block(statements, true)
    }

    ; transformEnumMember: `E[E["A"] = 0] = "A";`
    procedure rs_transform_enum_member(this, statements: ref[Array[ref[AstNode]?]], enum_node: ref[AstNode], index: int)
    {
        let ml Printer.member_list_of(enum_node) as ref[Array[ref[AstNode]?]]
        let member ml[index as size_t] as ref[AstNode]
        let saved_parent parent_node
        set this.parent_node: current_node
        set this.current_node: member
        var expression AstNode.initializer_of(member)
        var use_explicit_reverse_mapping false
        let parse_node context.parse_node(member)
        let result this.the_checker().get_enum_member_value(parse_node)
        ; the reference's `result.Value` is a number, a string, or nil; here a
        ; String kind WITHOUT a buffer is the nil-but-syntactically-string case
        ; (Checker.eval_has_value)
        var has_value false
        if result.kind = EvalKindNumber
        {
            set expression: this.rs_constant_number_expression(result.bits)
            set use_explicit_reverse_mapping: true
            set has_value: true
        }
        if result.kind = EvalKindString
        {
            if Checker.eval_has_value(result)
            {
                set expression: factory.new_string_literal(result.text, TokenFlagsNone)
                set has_value: true
            }
        }
        if has_value = false
        {
            if expression = null
                set expression: factory.new_void_zero_expression()
            set use_explicit_reverse_mapping: result.is_syntactically_string = false
        }
        ;  E[E["A"] = 0] = "A";
        ;    ^^^^^^^^--_____
        set expression: factory.new_assignment_expression(this.rs_enum_qualified_element(enum_node, member), expression)
        if use_explicit_reverse_mapping
            set expression: factory.new_assignment_expression(factory.new_element_access_expression(this.rs_namespace_container_name(enum_node), null, expression, NodeFlagsNone), this.rs_expression_for_property_name(member))
        let member_statement factory.new_expression_statement(expression)
        context.assign_comment_and_source_map_ranges(expression as ref[AstNode], member)
        context.assign_comment_and_source_map_ranges(member_statement, member)
        statements.add(member_statement)
        set this.current_node: parent_node
        set this.parent_node: saved_parent
    }

    ; constantExpression for a jsnum value: the literal, `Infinity`, `NaN`, or
    ; a minus over the positive one
    procedure rs_constant_number_expression(this, bits: u64) returns ref[AstNode]
    {
        if jsnum_is_inf(bits)
        {
            let inf: Slice[char] "Infinity"
            if jsnum_double_of(bits) > 0.0
                return factory.new_identifier(inf)
            return factory.new_prefix_unary_expression(KindMinusToken, factory.new_identifier(inf))
        }
        if jsnum_is_nan(bits)
        {
            let nan: Slice[char] "NaN"
            return factory.new_identifier(nan)
        }
        if jsnum_double_of(bits) < 0.0
            return factory.new_prefix_unary_expression(KindMinusToken, this.rs_constant_number_expression(jsnum_negate_value(bits)))
        let buf allocate_slice[char](host, 64)
        let n jsnum_to_string(bits, buf)
        factory.new_numeric_literal(buf.subslice(0, n as size_t), TokenFlagsNone)
    }

    procedure rs_visit_module_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.rs_should_emit_module_declaration(node) = false
            return context.new_not_emitted_statement(node)
        this.rs_visit_container_declaration(node, false)
    }

    ; transformModuleBody
    procedure rs_transform_module_body(this, node_in: ref[AstNode], namespace_local_name: ref[AstNode]) returns ref[AstNode]
    {
        let saved_namespace current_namespace
        let saved_scope current_scope
        let saved_names current_scope_first_declarations
        set this.current_namespace: node_in
        set this.current_scope_first_declarations: null
        var statements: ref[Array[ref[AstNode]?]]? null
        context.start_variable_environment()
        var sp 0 - 1
        var se 0 - 1
        var bp 0 - 1
        var be 0 - 1
        let body_in Printer.module_body_of(node_in)
        if body_in <> null
        {
            if AstNode.kind_of(body_in) = KindModuleBlock
            {
                ; visit the children of `node` in advance to capture any references to namespace members
                let node this.the_visitor().visit_each_child(node_in) as ref[AstNode]
                let body Printer.module_body_of(node) as ref[AstNode]
                set statements: AstNode.statements_of(body)
                AstNode.list_range_of(current_source_file, statements, &sp, &se)
                set bp: body.pos
                set be: body.end
            }
            else
            {
                ; node.Body.Kind == KindModuleDeclaration
                let one &Array[ref[AstNode]?]^host()
                one.add(body_in)
                var changed false
                set statements: this.the_visitor().visit_slice(one, &changed)
                let inner Transformer.get_innermost_module_declaration_from_dotted_module(node_in)
                let inner_body Printer.module_body_of(inner)
                if inner_body <> null
                {
                    var ip 0 - 1
                    AstNode.list_range_of(current_source_file, AstNode.statements_of(inner_body as ref[AstNode]), &ip, &se)
                }
                set sp: 0 - 1
            }
        }
        set this.current_namespace: saved_namespace
        set this.current_scope: saved_scope
        set this.current_scope_first_declarations: saved_names
        set statements: context.end_and_merge_variable_environment(statements)
        let list &Array[ref[AstNode]?]^host()
        if statements <> null
        {
            let sl statements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (sl.get_length() as int)
            {
                list.add(sl[i as size_t])
                set i: i + 1
            }
        }
        factory.set_list_range(list, sp, se)
        let block factory.new_block(list, true)
        set block.pos: bp
        set block.end: be
        ; We only want to emit comment on the namespace which contains block body itself, not the containing namespaces.
        var no_comments true
        if body_in <> null
        {
            if AstNode.kind_of(body_in) = KindModuleBlock
                set no_comments: false
        }
        if no_comments
            context.add_emit_flags(block, EFNoComments)
        block
    }

    procedure rs_visit_import_equals_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let mr AstNode.module_reference_of(node) as ref[AstNode]
        if mr.kind = KindExternalModuleReference
            return this.the_visitor().visit_each_child(node)
        let module_reference factory.create_expression_from_entity_name(mr)
        context.set_emit_flags(module_reference, EFNoComments | EFNoNestedComments)
        let name Printer.declaration_name_of(node)
        if this.is_export_of_namespace(node) = false
        {
            ;  export var ${name} = ${moduleReference};
            ;  var ${name} = ${moduleReference};
            let var_decl factory.new_variable_declaration(name, null, null, module_reference)
            context.set_original(var_decl, node)
            let decls &Array[ref[AstNode]?]^host()
            decls.add(var_decl)
            let var_list factory.new_variable_declaration_list(decls, NodeFlagsNone)
            let var_modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsExport)
            let var_statement factory.new_variable_statement(var_modifiers, var_list)
            context.set_original(var_statement, node)
            context.assign_comment_and_source_map_ranges(var_statement, node)
            return var_statement
        }
        ; exports.${name} = ${moduleReference};
        let statement this.rs_create_export_statement(name as ref[AstNode], module_reference, TextRange.of_node(node), TextRange.of_node(node), node)
        set statement.pos: node.pos
        set statement.end: node.end
        statement
    }

    procedure rs_visit_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.is_export_of_namespace(node) = false
            return v.visit_each_child(node)
        let expressions &Array[ref[AstNode]?]^host()
        let decls Printer.declarations_of(Printer.declaration_list_of(node) as ref[AstNode])
        if decls <> null
        {
            let dl decls as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (dl.get_length() as int)
            {
                let declaration dl[i as size_t] as ref[AstNode]
                set i: i + 1
                if AstNode.initializer_of(declaration) = null
                    continue
                if AstNode.is_binding_pattern(Printer.declaration_name_of(declaration))
                {
                    ; the pattern flattened into namespace member assignments
                    let visited_decl v.visit_node(declaration) as ref[AstNode]
                    expressions.add(Flattener.flatten_destructuring_assignment(host, this, visited_decl, false, FlattenLevelAll, FlattenCallbackNamespace))
                    continue
                }
                let expression Transformer.convert_variable_declaration_to_assignment_expression(context, declaration)
                if expression <> null
                    expressions.add(expression)
            }
        }
        if expressions.get_length() = 0
            return null
        let expression factory.inline_expressions(expressions)
        let statement factory.new_expression_statement(expression)
        context.set_original(statement, node)
        context.assign_comment_and_source_map_ranges(statement, node)
        ; re-visit as the new node
        let saved_current current_node
        set this.current_node: statement
        let visited v.visit_each_child(statement)
        set this.current_node: saved_current
        visited
    }

    ; transformers.ConvertVariableDeclarationToAssignmentExpression, for an
    ; IDENTIFIER name (the binding-pattern half is the destructuring chapter's)
    function convert_variable_declaration_to_assignment_expression(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]?
    {
        let initializer AstNode.initializer_of(element)
        if initializer = null
            return null
        let name Printer.declaration_name_of(element)
        let assignment ctx.the_factory().new_assignment_expression(name, initializer)
        ctx.set_original(assignment, element)
        ctx.assign_comment_and_source_map_ranges(assignment, element)
        assignment
    }

    procedure rs_visit_function_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.is_export_of_namespace(node) = false
            return v.visit_each_child(node)
        let updated factory.update_function_declaration(node, v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExport)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        let export this.rs_create_export_statement_for_declaration(node)
        let pair &Array[ref[AstNode]?]^host()
        pair.add(updated)
        pair.add(export)
        factory.new_syntax_list(pair)
    }

    ; getParameterProperties
    procedure rs_parameter_properties(this, constructor: ref[AstNode]?) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        if constructor = null
            return out
        let c constructor as ref[AstNode]
        let params AstNode.parameters_of(c)
        if params = null
            return out
        let pl params as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (pl.get_length() as int)
        {
            let p pl[i as size_t]
            set i: i + 1
            if p = null
                continue
            if Transformer.is_parameter_property_declaration(p as ref[AstNode], c)
                out.add(p)
        }
        out
    }

    ; the property declarations a class gains for its parameter properties,
    ; prepended to the visited members (visitClassDeclaration / visitClassExpression)
    procedure rs_members_with_parameter_properties(this, node: ref[AstNode], members: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        let ctor Transformer.find_constructor(Printer.member_list_of(node))
        let parameter_properties this.rs_parameter_properties(ctor)
        if parameter_properties.get_length() = 0
            return members
        let new_members &Array[ref[AstNode]?]^host()
        var i 0
        while i < (parameter_properties.get_length() as int)
        {
            let parameter parameter_properties[i as size_t] as ref[AstNode]
            set i: i + 1
            let pname Printer.declaration_name_of(parameter)
            if AstNode.kind_of(pname) <> KindIdentifier
                continue
            let parameter_property factory.new_property_declaration(null, factory.clone(pname as ref[AstNode]), null, null, null)
            context.set_original(parameter_property, parameter)
            new_members.add(parameter_property)
        }
        if new_members.get_length() = 0
            return members
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var j 0
            while j < (ml.get_length() as int)
            {
                new_members.add(ml[j as size_t])
                set j: j + 1
            }
        }
        var mp 0 - 1
        var me 0 - 1
        AstNode.list_range_of(current_source_file, Printer.member_list_of(node), &mp, &me)
        factory.set_list_range(new_members, mp, me)
        new_members
    }

    function find_constructor(members: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]?
    {
        if members = null
            return null
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if AstNode.kind_of(m) = KindConstructor
                return m
        }
        null
    }

    procedure rs_visit_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let exported this.is_export_of_namespace(node)
        var modifiers: ref[Array[ref[AstNode]?]]? null
        if exported
            set modifiers: v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault))
        else
            set modifiers: v.visit_modifiers(Printer.modifier_list_of(node))
        var name v.visit_node(Printer.declaration_name_of(node))
        if name = null
        {
            let legacy opts.options.experimental_decorators = TristateTrue
            let decorated this.the_checker().child_is_decorated(legacy, node, null)
            if exported or decorated
                set name: factory.new_generated_name_for_node(node)
        }
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        let members this.rs_members_with_parameter_properties(node, v.visit_nodes(Printer.member_list_of(node)))
        let updated factory.update_class_declaration(node, modifiers, name, null, heritage_clauses, members)
        if exported
        {
            let export this.rs_create_export_statement_for_declaration(node)
            let pair &Array[ref[AstNode]?]^host()
            pair.add(updated)
            pair.add(export)
            return factory.new_syntax_list(pair)
        }
        updated
    }

    procedure rs_visit_class_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let modifiers v.visit_modifiers(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault))
        let name v.visit_node(Printer.declaration_name_of(node))
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        let members this.rs_members_with_parameter_properties(node, v.visit_nodes(Printer.member_list_of(node)))
        factory.update_class_expression(node, modifiers, name, null, heritage_clauses, members)
    }

    procedure rs_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let modifiers v.visit_modifiers(Printer.modifier_list_of(node))
        let parameters context.visit_parameters(AstNode.parameters_of(node), v)
        let body this.rs_visit_constructor_body(AstNode.body_of(node), node)
        factory.update_constructor_declaration(node, modifiers, null, parameters, null, null, body)
    }

    ; visitConstructorBody: `constructor (public x) {}` → `constructor (x) { this.x = x; }`
    procedure rs_visit_constructor_body(this, body_in: ref[AstNode]?, constructor: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let parameter_properties this.rs_parameter_properties(constructor)
        if (parameter_properties.get_length() = 0) or (body_in = null)
            return context.visit_function_body(body_in, v)
        let body body_in as ref[AstNode]
        let grandparent_of_body this.push_node(body)
        var saved_scope: ref[AstNode]? null
        var saved_names: ref[Array[NameNode]]? null
        this.push_scope(body, &saved_scope, &saved_names)
        context.start_variable_environment()
        let source AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
        let prologue_end factory.split_standard_prologue(source)
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < prologue_end
        {
            statements.add(source[i as size_t])
            set i: i + 1
        }
        let rest &Array[ref[AstNode]?]^host()
        while i < (source.get_length() as int)
        {
            rest.add(source[i as size_t])
            set i: i + 1
        }
        let assignments &Array[ref[AstNode]?]^host()
        var p 0
        while p < (parameter_properties.get_length() as int)
        {
            let parameter parameter_properties[p as size_t] as ref[AstNode]
            set p: p + 1
            let pname Printer.declaration_name_of(parameter)
            if AstNode.kind_of(pname) <> KindIdentifier
                continue
            let nm pname as ref[AstNode]
            let property_name factory.clone(nm)
            set property_name.parent: nm.parent
            context.add_emit_flags(property_name, EFNoComments | EFNoSourceMap)
            let local_name factory.clone(nm)
            set local_name.parent: nm.parent
            context.add_emit_flags(local_name, EFNoComments)
            let assignment factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(factory.new_this_expression(), null, property_name, NodeFlagsNone), local_name))
            context.set_original(assignment, parameter)
            context.add_emit_flags(assignment, EFStartOnNewLine)
            assignments.add(assignment)
        }
        let super_path Transformer.find_super_statement_index_path(host, rest, 0)
        if super_path <> null
            this.rs_transform_constructor_body_worker(statements, rest, super_path as ref[Array[int]], 0, assignments)
        else
        {
            Transformer.add_all(statements, assignments)
            var changed false
            Transformer.add_all(statements, v.visit_slice(rest, &changed))
        }
        let merged context.end_and_merge_variable_environment(statements)
        let list &Array[ref[AstNode]?]^host()
        Transformer.add_all(list, merged)
        var sp 0 - 1
        var se 0 - 1
        AstNode.list_range_of(current_source_file, source, &sp, &se)
        factory.set_list_range(list, sp, se)
        this.pop_scope(saved_scope, saved_names)
        this.pop_node(grandparent_of_body)
        let updated factory.new_block(list, true)
        context.set_original(updated, body)
        set updated.pos: body.pos
        set updated.end: body.end
        updated
    }

    ; transformConstructorBodyWorker: the parameter-property assignments go right
    ; after the statement holding `super()`, into a `try` block if that is where it sits
    procedure rs_transform_constructor_body_worker(this, out: ref[Array[ref[AstNode]?]], statements_in: ref[Array[ref[AstNode]?]], super_path: ref[Array[int]], depth: int, initializers: ref[Array[ref[AstNode]?]])
    {
        let v this.the_visitor()
        let super_index super_path[depth as size_t]
        let super_statement statements_in[super_index as size_t] as ref[AstNode]
        var changed false
        ; visit up to the statement containing `super`
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, 0, super_index), &changed))
        if super_statement.kind = KindTryStatement
        {
            let try_block AstNode.try_block_of(super_statement) as ref[AstNode]
            let grandparent_of_try this.push_node(super_statement)
            let grandparent_of_block this.push_node(try_block)
            var saved_scope: ref[AstNode]? null
            var saved_names: ref[Array[NameNode]]? null
            this.push_scope(try_block, &saved_scope, &saved_names)
            let try_statements &Array[ref[AstNode]?]^host()
            this.rs_transform_constructor_body_worker(try_statements, AstNode.statements_of(try_block) as ref[Array[ref[AstNode]?]], super_path, depth + 1, initializers)
            this.pop_scope(saved_scope, saved_names)
            this.pop_node(grandparent_of_block)
            var tp 0 - 1
            var te 0 - 1
            AstNode.list_range_of(current_source_file, AstNode.statements_of(try_block), &tp, &te)
            factory.set_list_range(try_statements, tp, te)
            out.add(factory.update_try_statement(super_statement, factory.update_block(try_block, try_statements, AstNode.multi_line_of(try_block)), v.visit_node(AstNode.catch_clause_of(super_statement)), v.visit_node(AstNode.finally_block_of(super_statement))))
            this.pop_node(grandparent_of_try)
        }
        else
        {
            ; visit the statement containing `super`, then insert the initializer statements
            Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, super_index, super_index + 1), &changed))
            Transformer.add_all(out, initializers)
        }
        ; visit the statements after `super`
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements_in, super_index + 1, statements_in.get_length() as int), &changed))
    }

    function sub_list(host: ref[Page], list: ref[Array[ref[AstNode]?]], from: int, to: int) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        var i from
        while i < to
        {
            out.add(list[i as size_t])
            set i: i + 1
        }
        out
    }

    function add_all(out: ref[Array[ref[AstNode]?]], list: ref[Array[ref[AstNode]?]]?)
    {
        if list = null
            return
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            out.add(l[i as size_t])
            set i: i + 1
        }
    }

    ; transformers.FindSuperStatementIndexPath: the indices, outermost first,
    ; to the statement holding the `super()` call (through `try` blocks); null
    ; when there is none
    function find_super_statement_index_path(host: ref[Page], statements: ref[Array[ref[AstNode]?]], start: int) returns ref[Array[int]]?
    {
        var i start
        while i < (statements.get_length() as int)
        {
            let statement statements[i as size_t]
            set i: i + 1
            if statement = null
                continue
            let s statement as ref[AstNode]
            if Transformer.get_super_call_from_statement(s) <> null
            {
                let path &Array[int]^host()
                path.add(i - 1)
                return path
            }
            if s.kind = KindTryStatement
            {
                let try_block AstNode.try_block_of(s)
                if try_block <> null
                {
                    let inner AstNode.statements_of(try_block as ref[AstNode])
                    if inner <> null
                    {
                        let rest Transformer.find_super_statement_index_path(host, inner as ref[Array[ref[AstNode]?]], 0)
                        if rest <> null
                        {
                            let path &Array[int]^host()
                            path.add(i - 1)
                            Transformer.add_all_ints(path, rest as ref[Array[int]])
                            return path
                        }
                    }
                }
            }
        }
        null
    }

    function add_all_ints(out: ref[Array[int]], list: ref[Array[int]])
    {
        var i 0
        while i < (list.get_length() as int)
        {
            out.add(list[i as size_t])
            set i: i + 1
        }
    }

    ; transformers.GetSuperCallFromStatement
    function get_super_call_from_statement(statement: ref[AstNode]) returns ref[AstNode]?
    {
        if statement.kind <> KindExpressionStatement
            return null
        let inner Printer.statement_expression_of(statement)
        if inner = null
            return null
        let e Checker.skip_parentheses(inner as ref[AstNode])
        if e.kind <> KindCallExpression
            return null
        if AstNode.kind_of(AstNode.expression_of(e)) = KindSuperKeyword
            return e
        null
    }

    procedure rs_visit_shorthand_property_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let name Printer.declaration_name_of(node) as ref[AstNode]
        let exported_or_imported_name this.rs_visit_expression_identifier(name)
        let oai AstNode.shorthand_object_assignment_initializer_of(node)
        if exported_or_imported_name <> name
        {
            var expression exported_or_imported_name
            if oai <> null
            {
                var equals_token AstNode.shorthand_equals_token_of(node)
                if equals_token = null
                    set equals_token: factory.new_token(KindEqualsToken)
                set expression: factory.new_binary_expression(null, expression, null, equals_token, v.visit_node(oai))
            }
            let updated factory.new_property_assignment(null, name, null, null, expression)
            set updated.pos: node.pos
            set updated.end: node.end
            context.set_original(updated, node)
            context.assign_comment_and_source_map_ranges(updated, node)
            return updated
        }
        factory.update_shorthand_property_assignment(node, null, exported_or_imported_name, null, null, AstNode.shorthand_equals_token_of(node), v.visit_node(oai))
    }

    procedure rs_visit_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if parent_node = null
            return node
        if Transformer.is_identifier_reference(node, parent_node as ref[AstNode])
            return this.rs_visit_expression_identifier(node)
        node
    }

    ; visitExpressionIdentifier: a reference to an export of the enclosing
    ; namespace or enum becomes `ns.name`
    procedure rs_visit_expression_identifier(this, node: ref[AstNode]) returns ref[AstNode]
    {
        if (current_enum = null) and (current_namespace = null)
            return node
        if context.has_auto_generate_info(node)
            return node
        if (context.emit_flags(node) & EFLocalName) <> 0
            return node
        let location context.most_original(node)
        if location = null
            return node
        let container this.the_checker().get_referenced_export_container(location as ref[AstNode], false)
        if container = null
            return node
        let c container as ref[AstNode]
        if (c.kind <> KindEnumDeclaration) and (c.kind <> KindModuleDeclaration)
            return node
        let container_name this.rs_namespace_container_name(c)
        let member_name factory.clone(node)
        context.set_emit_flags(member_name, EFNoComments | EFNoSourceMap)
        let expression factory.get_namespace_member_name(container_name, member_name, false, true)
        context.assign_comment_and_source_map_ranges(expression, node)
        expression
    }

    ; createExportStatementForDeclaration: `exports.x = x;` after the declaration
    procedure rs_create_export_statement_for_declaration(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let export_name factory.get_external_module_or_namespace_export_name(this.rs_namespace_container_name(current_namespace as ref[AstNode]), node, false, true)
        let local_name factory.get_local_name(node)
        let expression factory.new_assignment_expression(export_name, local_name)
        var range TextRange.of_node(node)
        let name Printer.declaration_name_of(node)
        if name <> null
            set range: TextRange((name as ref[AstNode]).pos, node.end)
        context.set_source_map_range(expression, range)
        let statement factory.new_expression_statement(expression)
        context.set_source_map_range(statement, TextRange(0 - 1, node.end))
        statement
    }

    procedure rs_create_export_assignment(this, name: ref[AstNode], expression: ref[AstNode], source_map_range: TextRange, original: ref[AstNode]) returns ref[AstNode]
    {
        let export_name this.rs_namespace_qualified_property(this.rs_namespace_container_name(current_namespace as ref[AstNode]), name)
        let export_assignment factory.new_assignment_expression(export_name, expression)
        context.set_original(export_assignment, original)
        context.set_source_map_range(export_assignment, source_map_range)
        export_assignment
    }

    procedure rs_create_export_statement(this, name: ref[AstNode], expression: ref[AstNode], assignment_range: TextRange, statement_range: TextRange, original: ref[AstNode]) returns ref[AstNode]
    {
        let export_statement factory.new_expression_statement(this.rs_create_export_assignment(name, expression, assignment_range, original))
        context.set_original(export_statement, original)
        context.set_source_map_range(export_statement, statement_range)
        export_statement
    }

    function rs_should_emit_enum_declaration(this, node: ref[AstNode]) returns bool
    {
        if this.the_checker().is_enum_const(node) = false
            return true
        opts.options.should_preserve_const_enums()
    }

    function rs_should_emit_module_declaration(this, node: ref[AstNode]) returns bool
    {
        let pn context.parse_node(node)
        if pn = null
            return true
        this.the_checker().is_instantiated_module(pn as ref[AstNode])
    }

    ; transformers.IsIdentifierReference: whether an identifier CHILD of `parent`
    ; is a reference (an expression) rather than a name
    function is_identifier_reference(name: ref[AstNode], parent: ref[AstNode]) returns bool
    {
        let k parent.kind
        if (k = KindBinaryExpression) or (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression) or (k = KindYieldExpression) or (k = KindAsExpression) or (k = KindSatisfiesExpression) or (k = KindElementAccessExpression) or (k = KindNonNullExpression) or (k = KindSpreadElement) or (k = KindSpreadAssignment) or (k = KindParenthesizedExpression) or (k = KindArrayLiteralExpression) or (k = KindDeleteExpression) or (k = KindTypeOfExpression) or (k = KindVoidExpression) or (k = KindAwaitExpression) or (k = KindTypeAssertionExpression) or (k = KindExpressionWithTypeArguments) or (k = KindJsxSelfClosingElement) or (k = KindJsxSpreadAttribute) or (k = KindJsxExpression) or (k = KindPartiallyEmittedExpression)
            return true
        if (k = KindComputedPropertyName) or (k = KindDecorator) or (k = KindIfStatement) or (k = KindDoStatement) or (k = KindWhileStatement) or (k = KindWithStatement) or (k = KindReturnStatement) or (k = KindSwitchStatement) or (k = KindCaseClause) or (k = KindThrowStatement) or (k = KindExpressionStatement) or (k = KindExportAssignment) or (k = KindPropertyAccessExpression) or (k = KindTemplateSpan)
            return Transformer.expression_child_of(parent) = name
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration) or (k = KindPropertySignature) or (k = KindPropertyAssignment) or (k = KindEnumMember) or (k = KindJsxAttribute)
            return AstNode.initializer_of(parent) = name
        if k = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(parent) = name
        if k = KindForStatement
        {
            if AstNode.initializer_of(parent) = name
                return true
            if AstNode.for_condition_of(parent) = name
                return true
            return AstNode.for_incrementor_of(parent) = name
        }
        if (k = KindForInStatement) or (k = KindForOfStatement)
        {
            if AstNode.initializer_of(parent) = name
                return true
            return AstNode.expression_of(parent) = name
        }
        if k = KindImportEqualsDeclaration
            return AstNode.module_reference_of(parent) = name
        if k = KindArrowFunction
            return AstNode.body_of(parent) = name
        if k = KindConditionalExpression
        {
            if AstNode.conditional_condition_of(parent) = name
                return true
            if AstNode.conditional_when_true_of(parent) = name
                return true
            return AstNode.conditional_when_false_of(parent) = name
        }
        if (k = KindCallExpression) or (k = KindNewExpression)
        {
            if AstNode.expression_of(parent) = name
                return true
            return Transformer.list_contains(AstNode.call_arguments_of(parent), name)
        }
        if k = KindTaggedTemplateExpression
            return AstNode.tagged_template_tag_of(parent) = name
        if k = KindImportAttribute
            return AstNode.import_attribute_value_of(parent) = name
        if (k = KindJsxOpeningElement) or (k = KindJsxClosingElement)
            return AstNode.jsx_tag_name_of(parent) = name
        false
    }

    ; the reference's Node.Expression() for the parents IsIdentifierReference asks
    function expression_child_of(parent: ref[AstNode]) returns ref[AstNode]?
    {
        let k parent.kind
        if k = KindPropertyAccessExpression
            return AstNode.property_access_expression_of(parent)
        if (k = KindComputedPropertyName) or (k = KindDecorator)
            return Printer.wrapped_inner_of(parent)
        if (k = KindExpressionStatement) or (k = KindThrowStatement) or (k = KindReturnStatement)
            return Printer.statement_expression_of(parent)
        if k = KindExportAssignment
            return Checker.export_assignment_expression_of(parent)
        if k = KindTemplateSpan
            return AstNode.expression_of(parent)
        ; if / do / while / with / switch / case clause
        AstNode.expression_of(parent)
    }

    function list_contains(list: ref[Array[ref[AstNode]?]]?, n: ref[AstNode]) returns bool
    {
        if list = null
            return false
        let l list as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (l.get_length() as int)
        {
            if l[i as size_t] = n
                return true
            set i: i + 1
        }
        false
    }

    ; ═══ inliners/constenum.go (slice 238) ═══
    ;
    ; A property or element access that the checker knows as a const enum
    ; member becomes its value, with the original text as a trailing `/* */`
    ; comment unless comments are removed.
    procedure visit_const_enum_inlining(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if (k <> KindPropertyAccessExpression) and (k <> KindElementAccessExpression)
            return v.visit_each_child(node)
        let parse context.parse_node(node)
        if parse = null
            return v.visit_each_child(node)
        let value this.the_checker().get_constant_value(parse as ref[AstNode])
        if value.kind = EvalKindNone
            return v.visit_each_child(node)
        var replacement: ref[AstNode]? null
        if value.kind = EvalKindNumber
            set replacement: this.rs_constant_number_expression(value.bits)
        if value.kind = EvalKindString
            set replacement: factory.new_string_literal(value.text, TokenFlagsNone)
        if replacement = null
            return v.visit_each_child(node)
        let r replacement as ref[AstNode]
        if opts.options.remove_comments = false
        {
            let original context.most_original(node)
            if original <> null
            {
                let o original as ref[AstNode]
                if Printer.node_is_synthesized(o) = false
                {
                    let original_text Printer.get_text_of_node_from_source_text(host, opts.file_info.text, o, false)
                    context.add_synthetic_trailing_comment(r, KindMultiLineCommentTrivia, Transformer.safe_multi_line_comment(host, original_text), false)
                }
            }
        }
        r
    }

    ; safeMultiLineComment: ` text ` with every `*/` inside spelled `*_/`
    function safe_multi_line_comment(host: ref[Page], text: Slice[char]) returns Slice[char]
    {
        let b StringBuilder^host()
        b.append(" " as char)
        var i 0
        while i < text.length
        {
            let c text[i]
            if (c = ("*" as char)) and (i + 1 < text.length)
            {
                if text[i + 1] = ("/" as char)
                {
                    b.append("*_/")
                    set i: i + 2
                    continue
                }
            }
            b.append(c)
            set i: i + 1
        }
        b.append(" " as char)
        Printer.slice_on(host, b.to_string())
    }

    ; ═══ estransforms/using.go (slice 239) ═══
    ;
    ; `using` / `await using` declarations into the `env` record, the
    ; `__addDisposableResource` calls and the try/catch/finally that disposes;
    ; the top-level statements after the first `using` move into the `try`,
    ; imports, exports, functions and classes hoisted out of it.

    procedure visit_using(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & SubtreeContainsUsing) = 0
            return node
        let k node.kind
        if k = KindSourceFile
            return this.us_visit_source_file(node)
        if k = KindBlock
            return this.us_visit_block(node)
        if k = KindForStatement
            return this.us_visit_for_statement(node)
        if k = KindForOfStatement
            return this.us_visit_for_of_statement(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure us_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.file_info.is_declaration_file
            return node
        let v this.the_visitor()
        var visited: ref[AstNode]? null
        let statements AstNode.statements_of(node) as ref[Array[ref[AstNode]?]]
        let using_kind Transformer.get_using_kind_of_statements(statements)
        if using_kind <> UsingKindNone
        {
            context.start_variable_environment()
            set this.export_bindings: &Array[NameNode]^host()
            set this.export_vars: null
            let prologue_end factory.split_standard_prologue(statements)
            let top_level &Array[ref[AstNode]?]^host()
            var changed false
            Transformer.add_all(top_level, v.visit_slice(Transformer.sub_list(host, statements, 0, prologue_end), &changed))
            ; Collect and transform any leading statements up to the first `using` or `await using`.
            let rest Transformer.sub_list(host, statements, prologue_end, statements.get_length() as int)
            var pos 0
            while pos < (rest.get_length() as int)
            {
                let statement rest[pos as size_t]
                if Transformer.get_using_kind(statement) <> UsingKindNone
                {
                    if pos > 0
                        Transformer.add_all(top_level, v.visit_slice(Transformer.sub_list(host, rest, 0, pos), &changed))
                    break
                }
                set pos: pos + 1
            }
            ; transform the rest of the body
            let env_binding this.us_create_env_binding()
            let body_statements this.us_transform_using_declarations(Transformer.sub_list(host, rest, pos, rest.get_length() as int), env_binding, top_level)
            ; add `export {}` declarations for any hoisted bindings.
            let bindings export_bindings as ref[Array[NameNode]]
            if bindings.get_length() > 0
            {
                let specifiers &Array[ref[AstNode]?]^host()
                var i 0
                while i < (bindings.get_length() as int)
                {
                    let binding bindings[i as size_t]
                    specifiers.add(binding.node)
                    set i: i + 1
                }
                top_level.add(factory.new_export_declaration(null, false, factory.new_named_exports(specifiers), null, null))
            }
            Transformer.add_all(top_level, context.end_variable_environment())
            if export_vars <> null
            {
                let modifiers &Array[ref[AstNode]?]^host()
                modifiers.add(factory.new_token(KindExportKeyword))
                top_level.add(factory.new_variable_statement(modifiers, factory.new_variable_declaration_list(export_vars, NodeFlagsLet)))
            }
            Transformer.add_all(top_level, this.us_create_downlevel_using_statements(body_statements, env_binding, using_kind = UsingKindAsync))
            if export_equals_binding <> null
                top_level.add(factory.new_export_assignment(null, true, null, export_equals_binding))
            set visited: factory.update_source_file(node, top_level, AstNode.end_of_file_token_of(node))
        }
        else
            set visited: v.visit_each_child(node)
        let result visited as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(result, helper as ref[EmitHelper])
            set h: h + 1
        }
        set this.export_vars: null
        set this.export_bindings: null
        set this.default_export_binding: null
        set this.export_equals_binding: null
        result
    }

    procedure us_visit_block(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let statements AstNode.statements_of(node) as ref[Array[ref[AstNode]?]]
        let using_kind Transformer.get_using_kind_of_statements(statements)
        if using_kind = UsingKindNone
            return v.visit_each_child(node)
        let prologue_end factory.split_standard_prologue(statements)
        let env_binding this.us_create_env_binding()
        let out &Array[ref[AstNode]?]^host()
        var changed false
        Transformer.add_all(out, v.visit_slice(Transformer.sub_list(host, statements, 0, prologue_end), &changed))
        let rest Transformer.sub_list(host, statements, prologue_end, statements.get_length() as int)
        Transformer.add_all(out, this.us_create_downlevel_using_statements(this.us_transform_using_declarations(rest, env_binding, null), env_binding, using_kind = UsingKindAsync))
        var sp 0 - 1
        var se 0 - 1
        AstNode.list_range_of(current_source_file, statements, &sp, &se)
        factory.set_list_range(out, sp, se)
        factory.update_block(node, out, AstNode.multi_line_of(node))
    }

    ; `for (using x = expr; cond; incr) { ... }` → `{ using x = expr; for (; cond; incr) { ... } }`
    procedure us_visit_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let initializer AstNode.initializer_of(node)
        if initializer = null
            return v.visit_each_child(node)
        if Transformer.is_using_variable_declaration_list(initializer as ref[AstNode]) = false
            return v.visit_each_child(node)
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_variable_statement(null, initializer))
        statements.add(factory.update_for_statement(node, null, AstNode.for_condition_of(node), AstNode.for_incrementor_of(node), Printer.statement_body_of(node)))
        v.visit_node(factory.new_block(statements, false))
    }

    ; `for (using x of y) { ... }` → `for (const x_1 of y) { using x = x_1; ... }`
    procedure us_visit_for_of_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let initializer AstNode.initializer_of(node)
        if initializer = null
            return v.visit_each_child(node)
        let init_node initializer as ref[AstNode]
        if Transformer.is_using_variable_declaration_list(init_node) = false
            return v.visit_each_child(node)
        let decls Printer.declarations_of(init_node)
        var for_decl: ref[AstNode]? null
        if decls <> null
        {
            let dl decls as ref[Array[ref[AstNode]?]]
            if dl.get_length() > 0
                set for_decl: dl[0]
        }
        if for_decl = null
            set for_decl: factory.new_variable_declaration(factory.new_temp_variable(), null, null, null)
        let fd for_decl as ref[AstNode]
        let is_await_using Transformer.get_using_kind_of_variable_declaration_list(init_node) = UsingKindAsync
        let fd_name Printer.declaration_name_of(fd) as ref[AstNode]
        let temp factory.new_generated_name_for_node(fd_name)
        let using_var factory.update_variable_declaration(fd, fd_name, null, null, temp)
        let one &Array[ref[AstNode]?]^host()
        one.add(using_var)
        var flags NodeFlagsUsing
        if is_await_using
            set flags: NodeFlagsAwaitUsing
        let using_var_statement factory.new_variable_statement(null, factory.new_variable_declaration_list(one, flags))
        let body Printer.statement_body_of(node) as ref[AstNode]
        var statement: ref[AstNode]? null
        if body.kind = KindBlock
        {
            let inner &Array[ref[AstNode]?]^host()
            inner.add(using_var_statement)
            Transformer.add_all(inner, AstNode.statements_of(body))
            set statement: factory.update_block(body, inner, AstNode.multi_line_of(body))
        }
        else
        {
            let inner &Array[ref[AstNode]?]^host()
            inner.add(using_var_statement)
            inner.add(body)
            set statement: factory.new_block(inner, true)
        }
        let temp_decls &Array[ref[AstNode]?]^host()
        temp_decls.add(factory.new_variable_declaration(temp, null, null, null))
        v.visit_node(factory.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), factory.new_variable_declaration_list(temp_decls, NodeFlagsConst), AstNode.expression_of(node), statement))
    }

    ; transformUsingDeclarations: the body statements, each `using` replaced by
    ; `const x = __addDisposableResource(env, init_node, async)`, the rest visited and
    ; — at the top level — hoisted
    procedure us_transform_using_declarations(this, statements_in: ref[Array[ref[AstNode]?]], env_binding: ref[AstNode], top_level: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]
    {
        let v this.the_visitor()
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < (statements_in.get_length() as int)
        {
            let statement statements_in[i as size_t]
            set i: i + 1
            if statement = null
                continue
            let s statement as ref[AstNode]
            let using_kind Transformer.get_using_kind(s)
            if using_kind <> UsingKindNone
            {
                let declaration_list Printer.declaration_list_of(s) as ref[AstNode]
                let declarations &Array[ref[AstNode]?]^host()
                var valid true
                let dl Printer.declarations_of(declaration_list)
                if dl <> null
                {
                    let list dl as ref[Array[ref[AstNode]?]]
                    var d 0
                    while d < (list.get_length() as int)
                    {
                        var declaration list[d as size_t] as ref[AstNode]
                        set d: d + 1
                        if AstNode.kind_of(Printer.declaration_name_of(declaration)) <> KindIdentifier
                        {
                            ; Since binding patterns are a grammar error, we reset `declarations` so we don't process this as a `using`.
                            set valid: false
                            break
                        }
                        ; perform a shallow transform for any named evaluation
                        if Transformer.is_named_evaluation(context, declaration)
                        {
                            let empty: Slice[char] ""
                            set declaration: Transformer.transform_named_evaluation(context, declaration, false, empty)
                        }
                        var initializer v.visit_node(AstNode.initializer_of(declaration))
                        if initializer = null
                            set initializer: factory.new_void_zero_expression()
                        declarations.add(factory.update_variable_declaration(declaration, Printer.declaration_name_of(declaration), null, null, factory.new_add_disposable_resource_helper(env_binding, initializer as ref[AstNode], using_kind = UsingKindAsync)))
                    }
                }
                ; Only replace the statement if it was valid.
                if valid and (declarations.get_length() > 0)
                {
                    let var_list factory.new_variable_declaration_list(declarations, NodeFlagsConst)
                    context.set_original(var_list, declaration_list)
                    set var_list.pos: declaration_list.pos
                    set var_list.end: declaration_list.end
                    this.us_hoist_or_append(statements, factory.update_variable_statement(s, null, var_list), top_level)
                    continue
                }
            }
            let result this.visit_using(s)
            if result = null
                continue
            let r result as ref[AstNode]
            if r.kind = KindSyntaxList
            {
                let children AstNode.elements_of(r)
                if children <> null
                {
                    let cl children as ref[Array[ref[AstNode]?]]
                    var c 0
                    while c < (cl.get_length() as int)
                    {
                        let child cl[c as size_t]
                        set c: c + 1
                        if child <> null
                            this.us_hoist_or_append(statements, child as ref[AstNode], top_level)
                    }
                }
            }
            else
                this.us_hoist_or_append(statements, r, top_level)
        }
        statements
    }

    ; hoistOrAppendNode: `hoist` answers the statement that stays in the body
    ; (or null), the top-level ones go out through `top_level`
    procedure us_hoist_or_append(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode], top_level: ref[Array[ref[AstNode]?]]?)
    {
        var kept: ref[AstNode]? node
        if top_level <> null
        {
            let tl top_level as ref[Array[ref[AstNode]?]]
            let k node.kind
            if (k = KindImportDeclaration) or (k = KindImportEqualsDeclaration) or (k = KindExportDeclaration) or (k = KindFunctionDeclaration)
            {
                ; NOTE: `node` has already been visited
                tl.add(node)
                set kept: null
            }
            if k = KindExportAssignment
                set kept: this.us_hoist_export_assignment(node)
            if k = KindClassDeclaration
                set kept: this.us_hoist_class_declaration(node)
            if k = KindVariableStatement
                set kept: this.us_hoist_variable_statement(node)
        }
        if kept <> null
            statements.add(kept)
    }

    procedure us_hoist_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_export_equals_of(node)
            return this.us_hoist_export_equals(node)
        this.us_hoist_export_default(node)
    }

    ; `export default expr;` → `var default_1; export { default_1 as default };` up top, `default_1 = expr;` in the body
    procedure us_hoist_export_default(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if default_export_binding <> null
            return node
        let default_text: Slice[char] "_default"
        let empty: Slice[char] ""
        set this.default_export_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
        let default_name: Slice[char] "default"
        this.us_hoist_binding_identifier(default_export_binding as ref[AstNode], true, factory.new_identifier(default_name), node)
        ; give a class or function expression an assigned name, if needed.
        var expression Checker.export_assignment_expression_of(node) as ref[AstNode]
        var inner Parser.skip_outer_expressions(expression, OEKAll) as ref[AstNode]
        if Transformer.is_named_evaluation(context, inner)
        {
            set inner: Transformer.transform_named_evaluation(context, inner, false, default_name)
            set expression: factory.restore_outer_expressions(expression, inner, OEKAll) as ref[AstNode]
        }
        factory.new_expression_statement(factory.new_assignment_expression(default_export_binding, expression))
    }

    ; `export = expr;` → `var default_1;` up top, `default_1 = expr;` in the body, `export = default_1;` after
    procedure us_hoist_export_equals(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if export_equals_binding <> null
            return node
        let default_text: Slice[char] "_default"
        let empty: Slice[char] ""
        set this.export_equals_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
        context.add_variable_declaration(export_equals_binding as ref[AstNode])
        factory.new_expression_statement(factory.new_assignment_expression(export_equals_binding, Checker.export_assignment_expression_of(node)))
    }

    ; a class declaration at the top level of a file with a top-level `using`
    ; becomes `C = class {}` in the body, its binding hoisted
    procedure us_hoist_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let name Printer.declaration_name_of(node)
        if (name = null) and (default_export_binding <> null)
            return node
        let is_exported Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let is_default Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
        var expression this.convert_class_declaration_to_class_expression(node)
        let empty: Slice[char] ""
        if name <> null
        {
            this.us_hoist_binding_identifier(factory.get_local_name(node), is_exported and (is_default = false), null, node)
            set expression: factory.new_assignment_expression(factory.get_declaration_name(node), expression)
            context.set_original(expression, node)
            context.set_source_map_range(expression, TextRange.of_node(node))
            context.set_comment_range(expression, TextRange.of_node(node))
            if Transformer.is_named_evaluation(context, expression)
                set expression: Transformer.transform_named_evaluation(context, expression, false, empty)
        }
        if is_default and (default_export_binding = null)
        {
            let default_text: Slice[char] "_default"
            set this.default_export_binding: factory.new_unique_name_ex(default_text, GeneratedIdentifierFlagsReservedInNestedScopes | GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic, empty, empty)
            let default_name: Slice[char] "default"
            this.us_hoist_binding_identifier(default_export_binding as ref[AstNode], true, factory.new_identifier(default_name), node)
            set expression: factory.new_assignment_expression(default_export_binding, expression)
            context.set_original(expression, node)
            if Transformer.is_named_evaluation(context, expression)
                set expression: Transformer.transform_named_evaluation(context, expression, false, default_name)
        }
        factory.new_expression_statement(expression)
    }

    procedure us_hoist_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expressions &Array[ref[AstNode]?]^host()
        let is_exported Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let dl Printer.declarations_of(Printer.declaration_list_of(node) as ref[AstNode])
        if dl <> null
        {
            let list dl as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (list.get_length() as int)
            {
                let variable list[i as size_t] as ref[AstNode]
                set i: i + 1
                this.us_hoist_binding_element(variable, is_exported, variable)
                if AstNode.initializer_of(variable) <> null
                    expressions.add(this.us_hoist_initialized_variable(variable))
            }
        }
        if expressions.get_length() = 0
            return null
        let statement factory.new_expression_statement(factory.inline_expressions(expressions))
        context.set_original(statement, node)
        context.set_comment_range(statement, TextRange.of_node(node))
        context.set_source_map_range(statement, TextRange.of_node(node))
        statement
    }

    procedure us_hoist_initialized_variable(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let name Printer.declaration_name_of(node) as ref[AstNode]
        var target: ref[AstNode]? null
        if name.kind = KindIdentifier
        {
            let t factory.clone(name)
            context.set_emit_flags(t, context.emit_flags(t) & (SubtreeFactsAllBits xor (EFLocalName | EFExportName)))
            set target: t
        }
        else
            set target: Transformer.convert_binding_pattern_to_assignment_pattern(context, name)
        let assignment factory.new_assignment_expression(target, AstNode.initializer_of(node))
        context.set_original(assignment, node)
        context.set_comment_range(assignment, TextRange.of_node(node))
        context.set_source_map_range(assignment, TextRange.of_node(node))
        assignment
    }

    procedure us_hoist_binding_element(this, node: ref[AstNode], is_exported_declaration: bool, original: ref[AstNode])
    {
        let name Printer.declaration_name_of(node)
        if name = null
            return
        let nm name as ref[AstNode]
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm)
            if elements = null
                return
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let element el[i as size_t]
                set i: i + 1
                if element = null
                    continue
                if Printer.declaration_name_of(element as ref[AstNode]) <> null
                    this.us_hoist_binding_element(element as ref[AstNode], is_exported_declaration, original)
            }
            return
        }
        this.us_hoist_binding_identifier(nm, is_exported_declaration, null, original)
    }

    procedure us_hoist_binding_identifier(this, node: ref[AstNode], is_export: bool, export_alias: ref[AstNode]?, original: ref[AstNode]?)
    {
        var name node
        if context.has_auto_generate_info(node) = false
            set name: factory.clone(node)
        if is_export
        {
            if (export_alias = null) and ((context.emit_flags(name) & EFLocalName) = 0)
            {
                let var_decl factory.new_variable_declaration(name, null, null, null)
                if original <> null
                    context.set_original(var_decl, original as ref[AstNode])
                if export_vars = null
                    set this.export_vars: &Array[ref[AstNode]?]^host()
                (export_vars as ref[Array[ref[AstNode]?]]).add(var_decl)
                return
            }
            var local_name: ref[AstNode]? null
            var export_name: ref[AstNode]? name
            if export_alias <> null
            {
                set local_name: name
                set export_name: export_alias
            }
            let specifier factory.new_export_specifier(false, local_name, export_name)
            if original <> null
                context.set_original(specifier, original as ref[AstNode])
            if export_bindings = null
                set this.export_bindings: &Array[NameNode]^host()
            let table export_bindings as ref[Array[NameNode]]
            let text AstNode.identifier_text_of(name)
            var found false
            var i 0
            while i < (table.get_length() as int)
            {
                let entry table[i as size_t]
                if entry.name.equals(text)
                {
                    table.put(i as size_t, NameNode(text, specifier))
                    set found: true
                }
                set i: i + 1
            }
            if found = false
                table.add(NameNode(text, specifier))
        }
        context.add_variable_declaration(name)
    }

    procedure us_create_env_binding(this) returns ref[AstNode]
    {
        let env: Slice[char] "env"
        factory.new_unique_name(env)
    }

    ; createDownlevelUsingStatements: the `env` record and the try/catch/finally
    procedure us_create_downlevel_using_statements(this, body_statements: ref[Array[ref[AstNode]?]], env_binding: ref[AstNode], async: bool) returns ref[Array[ref[AstNode]?]]
    {
        let statements &Array[ref[AstNode]?]^host()
        ;  const env_1 = { stack: [], error: void 0, hasError: false };
        let stack_name: Slice[char] "stack"
        let error_name: Slice[char] "error"
        let has_error_name: Slice[char] "hasError"
        let props &Array[ref[AstNode]?]^host()
        let empty_stack &Array[ref[AstNode]?]^host()
        props.add(factory.new_property_assignment(null, factory.new_identifier(stack_name), null, null, factory.new_array_literal_expression(empty_stack, false)))
        props.add(factory.new_property_assignment(null, factory.new_identifier(error_name), null, null, factory.new_void_zero_expression()))
        props.add(factory.new_property_assignment(null, factory.new_identifier(has_error_name), null, null, factory.new_false_expression()))
        let env_object factory.new_object_literal_expression(props, false)
        let env_decls &Array[ref[AstNode]?]^host()
        env_decls.add(factory.new_variable_declaration(env_binding, null, null, env_object))
        statements.add(factory.new_variable_statement(null, factory.new_variable_declaration_list(env_decls, NodeFlagsConst)))
        ;  try { <body> } catch (e_1) { env_1.error = e_1; env_1.hasError = true; } finally { __disposeResources(env_1); }
        let try_block factory.new_block(body_statements, true)
        let e_name: Slice[char] "e"
        let body_catch_binding factory.new_unique_name(e_name)
        let catch_statements &Array[ref[AstNode]?]^host()
        catch_statements.add(factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(env_binding, null, factory.new_identifier(error_name), NodeFlagsNone), body_catch_binding)))
        catch_statements.add(factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(env_binding, null, factory.new_identifier(has_error_name), NodeFlagsNone), factory.new_true_expression())))
        let catch_clause factory.new_catch_clause(factory.new_variable_declaration(body_catch_binding, null, null, null), factory.new_block(catch_statements, true))
        let finally_statements &Array[ref[AstNode]?]^host()
        if async
        {
            let result_name: Slice[char] "result"
            let result factory.new_unique_name(result_name)
            let result_decls &Array[ref[AstNode]?]^host()
            result_decls.add(factory.new_variable_declaration(result, null, null, factory.new_dispose_resources_helper(env_binding)))
            finally_statements.add(factory.new_variable_statement(null, factory.new_variable_declaration_list(result_decls, NodeFlagsConst)))
            finally_statements.add(factory.new_if_statement(result, factory.new_expression_statement(factory.new_await_expression(result)), null))
        }
        else
            finally_statements.add(factory.new_expression_statement(factory.new_dispose_resources_helper(env_binding)))
        let finally_block factory.new_block(finally_statements, true)
        statements.add(factory.new_try_statement(try_block, catch_clause, finally_block))
        statements
    }

    function is_using_variable_declaration_list(node: ref[AstNode]) returns bool
    {
        if node.kind <> KindVariableDeclarationList
            return false
        Transformer.get_using_kind_of_variable_declaration_list(node) <> UsingKindNone
    }

    function get_using_kind_of_variable_declaration_list(node: ref[AstNode]) returns int
    {
        let scoped node.flags & NodeFlagsBlockScoped
        if scoped = NodeFlagsAwaitUsing
            return UsingKindAsync
        if scoped = NodeFlagsUsing
            return UsingKindSync
        UsingKindNone
    }

    function get_using_kind(statement: ref[AstNode]?) returns int
    {
        if AstNode.kind_of(statement) <> KindVariableStatement
            return UsingKindNone
        let dl Printer.declaration_list_of(statement as ref[AstNode])
        if dl = null
            return UsingKindNone
        Transformer.get_using_kind_of_variable_declaration_list(dl as ref[AstNode])
    }

    function get_using_kind_of_statements(statements: ref[Array[ref[AstNode]?]]) returns int
    {
        var result UsingKindNone
        var i 0
        while i < (statements.get_length() as int)
        {
            let k Transformer.get_using_kind(statements[i as size_t])
            set i: i + 1
            if k = UsingKindAsync
                return UsingKindAsync
            if k > result
                set result: k
        }
        result
    }

    ; ═══ estransforms/utilities.go convertClassDeclarationToClassExpression ═══
    procedure convert_class_declaration_to_class_expression(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let updated factory.new_class_expression(Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault), Printer.declaration_name_of(node), AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), Printer.member_list_of(node))
        context.set_original(updated, node)
        set updated.pos: node.pos
        set updated.end: node.end
        updated
    }

    ; ═══ transformers/utilities.go ConvertBindingPatternToAssignmentPattern ═══
    function convert_binding_pattern_to_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        if element.kind = KindArrayBindingPattern
            return Transformer.convert_binding_element_to_array_assignment_pattern(ctx, element)
        Transformer.convert_binding_element_to_object_assignment_pattern(ctx, element)
    }

    function convert_binding_element_to_object_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let h ctx.host
        let properties &Array[ref[AstNode]?]^h()
        let elements AstNode.elements_of(element)
        if elements <> null
        {
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let e el[i as size_t]
                set i: i + 1
                if e <> null
                    properties.add(Transformer.convert_binding_element_to_object_assignment_element(ctx, e as ref[AstNode]))
            }
        }
        var ep 0 - 1
        var ee 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(element), elements, &ep, &ee)
        f.set_list_range(properties, ep, ee)
        let object f.new_object_literal_expression(properties, false)
        ctx.set_original(object, element)
        ctx.assign_comment_and_source_map_ranges(object, element)
        object
    }

    function convert_binding_element_to_array_assignment_pattern(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let h ctx.host
        let out &Array[ref[AstNode]?]^h()
        let elements AstNode.elements_of(element)
        if elements <> null
        {
            let el elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (el.get_length() as int)
            {
                let e el[i as size_t]
                set i: i + 1
                if e <> null
                    out.add(Transformer.convert_binding_element_to_array_assignment_element(ctx, e as ref[AstNode]))
            }
        }
        var ep 0 - 1
        var ee 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(element), elements, &ep, &ee)
        f.set_list_range(out, ep, ee)
        let array f.new_array_literal_expression(out, false)
        ctx.set_original(array, element)
        ctx.assign_comment_and_source_map_ranges(array, element)
        array
    }

    function convert_binding_element_to_array_assignment_element(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let name Printer.declaration_name_of(element)
        if name = null
        {
            let elision f.new_omitted_expression()
            ctx.set_original(elision, element)
            ctx.assign_comment_and_source_map_ranges(elision, element)
            return elision
        }
        if AstNode.dot_dot_dot_token_of(element) <> null
        {
            let spread f.new_spread_element(name)
            ctx.set_original(spread, element)
            ctx.assign_comment_and_source_map_ranges(spread, element)
            return spread
        }
        let expression Transformer.convert_binding_name_to_assignment_element_target(ctx, name as ref[AstNode])
        let initializer AstNode.initializer_of(element)
        if initializer <> null
        {
            let assignment f.new_assignment_expression(expression, initializer)
            ctx.set_original(assignment, element)
            ctx.assign_comment_and_source_map_ranges(assignment, element)
            return assignment
        }
        expression
    }

    function convert_binding_element_to_object_assignment_element(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let name Printer.declaration_name_of(element)
        if AstNode.dot_dot_dot_token_of(element) <> null
        {
            let spread f.new_spread_assignment(name)
            ctx.set_original(spread, element)
            ctx.assign_comment_and_source_map_ranges(spread, element)
            return spread
        }
        let property_name AstNode.property_name_of(element)
        let initializer AstNode.initializer_of(element)
        if property_name <> null
        {
            var expression Transformer.convert_binding_name_to_assignment_element_target(ctx, name as ref[AstNode])
            if initializer <> null
                set expression: f.new_assignment_expression(expression, initializer)
            let assignment f.new_property_assignment(null, property_name, null, null, expression)
            ctx.set_original(assignment, element)
            ctx.assign_comment_and_source_map_ranges(assignment, element)
            return assignment
        }
        var equals_token: ref[AstNode]? null
        if initializer <> null
            set equals_token: f.new_token(KindEqualsToken)
        let assignment f.new_shorthand_property_assignment(null, name, null, null, equals_token, initializer)
        ctx.set_original(assignment, element)
        ctx.assign_comment_and_source_map_ranges(assignment, element)
        assignment
    }

    function convert_binding_name_to_assignment_element_target(ctx: ref[EmitContext], element: ref[AstNode]) returns ref[AstNode]
    {
        if AstNode.is_binding_pattern(element)
            return Transformer.convert_binding_pattern_to_assignment_pattern(ctx, element)
        element
    }

    ; ═══ estransforms/namedevaluation.go ═══

    ; isClassNamedEvaluationHelperBlock: a `static {}` block holding only
    ; `__setFunctionName(this, <assignedName>)`
    function is_class_named_evaluation_helper_block(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassStaticBlockDeclaration
            return false
        let body Printer.static_block_body_of(node)
        if body = null
            return false
        let statements AstNode.statements_of(body as ref[AstNode])
        if statements = null
            return false
        let sl statements as ref[Array[ref[AstNode]?]]
        if sl.get_length() <> 1
            return false
        let statement sl[0]
        if AstNode.kind_of(statement) <> KindExpressionStatement
            return false
        let expression Printer.statement_expression_of(statement as ref[AstNode])
        if expression = null
            return false
        let helper_name: Slice[char] "__setFunctionName"
        if ctx.is_call_to_helper(expression as ref[AstNode], helper_name) = false
            return false
        let arguments AstNode.call_arguments_of(expression as ref[AstNode])
        if arguments = null
            return false
        let al arguments as ref[Array[ref[AstNode]?]]
        if al.get_length() < 2
            return false
        let arg1 al[1]
        let assigned ctx.assigned_name(node)
        if arg1 = null
            return false
        if assigned = null
            return false
        Transformer.same_node(arg1 as ref[AstNode], assigned as ref[AstNode])
    }

    ; pointer identity of two nodes, spelled where the planner reads `=` on two
    ; references as the identity test (a cast inside the comparison is not that)
    function same_node(a: ref[AstNode], b: ref[AstNode]) returns bool
        a = b

    function class_has_explicitly_assigned_name(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if ctx.assigned_name(node) = null
            return false
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if m <> null
            {
                if Transformer.is_class_named_evaluation_helper_block(ctx, m as ref[AstNode])
                    return true
            }
        }
        false
    }

    function class_has_declared_or_explicitly_assigned_name(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if Printer.declaration_name_of(node) <> null
            return true
        Transformer.class_has_explicitly_assigned_name(ctx, node)
    }

    ; IsAnonymousFunctionDefinition (no callback)
    function is_anonymous_function_definition(ctx: ref[EmitContext], node_in: ref[AstNode]?) returns bool
    {
        let skipped Parser.skip_outer_expressions(node_in, OEKAll)
        if skipped = null
            return false
        let node skipped as ref[AstNode]
        let k node.kind
        if k = KindClassExpression
            return Transformer.class_has_declared_or_explicitly_assigned_name(ctx, node) = false
        if k = KindFunctionExpression
            return Printer.declaration_name_of(node) = null
        if k = KindArrowFunction
            return true
        false
    }

    ; ast.IsNamedEvaluationSource
    function is_named_evaluation_source(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if k = KindPropertyAssignment
            return Transformer.is_proto_setter(Printer.declaration_name_of(node)) = false
        if k = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(node) <> null
        if k = KindVariableDeclaration
            return (AstNode.kind_of(Printer.declaration_name_of(node)) = KindIdentifier) and (AstNode.initializer_of(node) <> null)
        if (k = KindParameter) or (k = KindBindingElement)
            return (AstNode.kind_of(Printer.declaration_name_of(node)) = KindIdentifier) and (AstNode.initializer_of(node) <> null) and (AstNode.dot_dot_dot_token_of(node) = null)
        if k = KindPropertyDeclaration
            return AstNode.initializer_of(node) <> null
        if k = KindBinaryExpression
        {
            let op AstNode.kind_of(AstNode.binary_operator_token_of(node))
            if (op = KindEqualsToken) or (op = KindAmpersandAmpersandEqualsToken) or (op = KindBarBarEqualsToken) or (op = KindQuestionQuestionEqualsToken)
                return AstNode.kind_of(AstNode.binary_left_of(node)) = KindIdentifier
            return false
        }
        if k = KindExportAssignment
            return true
        false
    }

    function is_proto_setter(node: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(node)
        if (k <> KindIdentifier) and (k <> KindStringLiteral)
            return false
        let proto: Slice[char] "__proto__"
        if k = KindIdentifier
            return AstNode.identifier_text_of(node).equals(proto)
        AstNode.literal_text_of(node).equals(proto)
    }

    function is_named_evaluation(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if Transformer.is_named_evaluation_source(node) = false
            return false
        let k node.kind
        if k = KindShorthandPropertyAssignment
            return Transformer.is_anonymous_function_definition(ctx, AstNode.shorthand_object_assignment_initializer_of(node))
        if (k = KindPropertyAssignment) or (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration)
            return Transformer.is_anonymous_function_definition(ctx, AstNode.initializer_of(node))
        if k = KindBinaryExpression
            return Transformer.is_anonymous_function_definition(ctx, AstNode.binary_right_of(node))
        if k = KindExportAssignment
            return Transformer.is_anonymous_function_definition(ctx, Checker.export_assignment_expression_of(node))
        false
    }

    ; getAssignedNameOfIdentifier
    function assigned_name_of_identifier(ctx: ref[EmitContext], name: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let original ctx.most_original(Parser.skip_outer_expressions(expression, OEKAll))
        if original <> null
        {
            let o original as ref[AstNode]
            if (o.kind = KindClassDeclaration) or (o.kind = KindFunctionDeclaration)
            {
                if (Printer.declaration_name_of(o) = null) and Transformer.has_syntactic_modifier(o, ModifierFlagsDefault)
                {
                    let default_name: Slice[char] "default"
                    return f.new_string_literal(default_name, TokenFlagsNone)
                }
            }
        }
        f.new_string_literal_from_node(name)
    }

    ; getAssignedNameOfPropertyName: (assignedName, updatedName) through the out-cell
    function assigned_name_of_property_name(ctx: ref[EmitContext], name: ref[AstNode], assigned_name_text: Slice[char], updated_name: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        set updated_name: name
        if assigned_name_text.length > 0
            return f.new_string_literal(assigned_name_text, TokenFlagsNone)
        if Checker.is_property_name_literal(name.kind) or (name.kind = KindPrivateIdentifier)
            return f.new_string_literal_from_node(name)
        let expression AstNode.expression_of(name) as ref[AstNode]
        if Checker.is_property_name_literal(expression.kind) and (expression.kind <> KindIdentifier)
            return f.new_string_literal_from_node(expression)
        let assigned_name f.new_generated_name_for_node(name)
        ctx.add_variable_declaration(assigned_name)
        let key f.new_prop_key_helper(expression)
        let assignment f.new_assignment_expression(assigned_name, key)
        set updated_name: f.update_computed_property_name(name, assignment)
        assigned_name
    }

    ; createClassNamedEvaluationHelperBlock: `static { __setFunctionName(this, "C"); }`
    function create_class_named_evaluation_helper_block(ctx: ref[EmitContext], assigned_name: ref[AstNode], this_expression_in: ref[AstNode]?) returns ref[AstNode]
    {
        let f ctx.the_factory()
        var this_expression this_expression_in
        if this_expression = null
            set this_expression: f.new_this_expression()
        let empty: Slice[char] ""
        let expression f.new_set_function_name_helper(this_expression as ref[AstNode], assigned_name, empty)
        let statement f.new_expression_statement(expression)
        let h ctx.host
        let statements &Array[ref[AstNode]?]^h()
        statements.add(statement)
        let body f.new_block(statements, false)
        let block f.new_class_static_block_declaration(null, body)
        ctx.set_assigned_name(block, assigned_name)
        block
    }

    ; injectClassNamedEvaluationHelperBlockIfMissing
    function inject_class_named_evaluation_helper_block_if_missing(ctx: ref[EmitContext], node: ref[AstNode], assigned_name: ref[AstNode], this_expression: ref[AstNode]?) returns ref[AstNode]
    {
        if Transformer.class_has_explicitly_assigned_name(ctx, node)
            return node
        let f ctx.the_factory()
        let block Transformer.create_class_named_evaluation_helper_block(ctx, assigned_name, this_expression)
        let name Printer.declaration_name_of(node)
        if name <> null
        {
            let body Printer.static_block_body_of(block) as ref[AstNode]
            let first (AstNode.statements_of(body) as ref[Array[ref[AstNode]?]])[0] as ref[AstNode]
            ctx.set_source_map_range(first, TextRange.of_node(name as ref[AstNode]))
        }
        let members Printer.member_list_of(node)
        let h ctx.host
        let new_members &Array[ref[AstNode]?]^h()
        var insertion_index 0
        if members <> null
        {
            let ml members as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ml.get_length() as int)
            {
                let m ml[i as size_t]
                if m <> null
                {
                    if Transformer.is_class_this_assignment_block(ctx, m as ref[AstNode])
                        set insertion_index: i + 1
                }
                set i: i + 1
            }
            set i: 0
            while i < (ml.get_length() as int)
            {
                if i = insertion_index
                    new_members.add(block)
                new_members.add(ml[i as size_t])
                set i: i + 1
            }
            if insertion_index >= (ml.get_length() as int)
                new_members.add(block)
        }
        else
            new_members.add(block)
        var mp 0 - 1
        var me 0 - 1
        AstNode.list_range_of(Checker.source_file_of_node(node), members, &mp, &me)
        f.set_list_range(new_members, mp, me)
        var updated: ref[AstNode]? null
        if node.kind = KindClassDeclaration
            set updated: f.update_class_declaration(node, Printer.modifier_list_of(node), name, AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), new_members)
        else
            set updated: f.update_class_expression(node, Printer.modifier_list_of(node), name, AstNode.type_parameters_of(node), AstNode.heritage_clauses_of(node), new_members)
        let u updated as ref[AstNode]
        ctx.set_assigned_name(u, assigned_name)
        let ct ctx.class_this(node)
        if ct <> null
            ctx.set_class_this(u, ct)
        u
    }

    ; estransforms/classthis.go isClassThisAssignmentBlock: `static { _classThis = this; }`
    function is_class_this_assignment_block(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassStaticBlockDeclaration
            return false
        let body Printer.static_block_body_of(node)
        if body = null
            return false
        let statements AstNode.statements_of(body as ref[AstNode])
        if statements = null
            return false
        let sl statements as ref[Array[ref[AstNode]?]]
        if sl.get_length() <> 1
            return false
        let statement sl[0]
        if AstNode.kind_of(statement) <> KindExpressionStatement
            return false
        let expression Printer.statement_expression_of(statement as ref[AstNode])
        if expression = null
            return false
        let e expression as ref[AstNode]
        if Emitter.is_assignment_expression(e, true) = false
            return false
        let left AstNode.binary_left_of(e)
        if AstNode.kind_of(left) <> KindIdentifier
            return false
        let ct ctx.class_this(node)
        if ct = null
            return false
        if Transformer.same_node(ct as ref[AstNode], left as ref[AstNode]) = false
            return false
        AstNode.kind_of(AstNode.binary_right_of(e)) = KindThisKeyword
    }

    function finish_transform_named_evaluation(ctx: ref[EmitContext], expression: ref[AstNode], assigned_name: ref[AstNode], ignore_empty_string_literal: bool) returns ref[AstNode]
    {
        if ignore_empty_string_literal and (assigned_name.kind = KindStringLiteral)
        {
            if AstNode.literal_text_of(assigned_name).length = 0
                return expression
        }
        let f ctx.the_factory()
        let inner Parser.skip_outer_expressions(expression, OEKAll) as ref[AstNode]
        var updated: ref[AstNode]? null
        if inner.kind = KindClassExpression
            set updated: Transformer.inject_class_named_evaluation_helper_block_if_missing(ctx, inner, assigned_name, null)
        else
        {
            let empty: Slice[char] ""
            set updated: f.new_set_function_name_helper(inner, assigned_name, empty)
        }
        f.restore_outer_expressions(expression, updated, OEKAll) as ref[AstNode]
    }

    ; transformNamedEvaluation: a shallow transformation of a NamedEvaluation node
    function transform_named_evaluation(ctx: ref[EmitContext], node: ref[AstNode], ignore_empty_string_literal: bool, assigned_name_text: Slice[char]) returns ref[AstNode]
    {
        let f ctx.the_factory()
        let k node.kind
        if k = KindPropertyAssignment
        {
            var updated_name: ref[AstNode]? null
            let assigned_name Transformer.assigned_name_of_property_name(ctx, Printer.declaration_name_of(node) as ref[AstNode], assigned_name_text, &updated_name)
            let initializer Transformer.finish_transform_named_evaluation(ctx, AstNode.initializer_of(node) as ref[AstNode], assigned_name, ignore_empty_string_literal)
            return f.update_property_assignment(node, null, updated_name, null, null, initializer)
        }
        if k = KindShorthandPropertyAssignment
        {
            let name Printer.declaration_name_of(node) as ref[AstNode]
            let oai AstNode.shorthand_object_assignment_initializer_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, name, oai)
            let initializer Transformer.finish_transform_named_evaluation(ctx, oai, assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_shorthand_property_assignment(node, null, name, null, null, AstNode.shorthand_equals_token_of(node), initializer)
        }
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
        {
            let name Printer.declaration_name_of(node) as ref[AstNode]
            let init_node AstNode.initializer_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, name, init_node)
            let initializer Transformer.finish_transform_named_evaluation(ctx, init_node, assigned_name as ref[AstNode], ignore_empty_string_literal)
            if k = KindVariableDeclaration
                return f.update_variable_declaration(node, name, null, null, initializer)
            if k = KindParameter
                return f.update_parameter_declaration(node, null, AstNode.dot_dot_dot_token_of(node), name, null, null, initializer)
            return f.update_binding_element(node, AstNode.dot_dot_dot_token_of(node), AstNode.property_name_of(node), name, initializer)
        }
        if k = KindPropertyDeclaration
        {
            var updated_name: ref[AstNode]? null
            let assigned_name Transformer.assigned_name_of_property_name(ctx, Printer.declaration_name_of(node) as ref[AstNode], assigned_name_text, &updated_name)
            let initializer Transformer.finish_transform_named_evaluation(ctx, AstNode.initializer_of(node) as ref[AstNode], assigned_name, ignore_empty_string_literal)
            return f.update_property_declaration(node, Printer.modifier_list_of(node), updated_name, null, null, initializer)
        }
        if k = KindBinaryExpression
        {
            let left AstNode.binary_left_of(node) as ref[AstNode]
            let right AstNode.binary_right_of(node) as ref[AstNode]
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
                set assigned_name: Transformer.assigned_name_of_identifier(ctx, left, right)
            let new_right Transformer.finish_transform_named_evaluation(ctx, right, assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), new_right)
        }
        if k = KindExportAssignment
        {
            var assigned_name: ref[AstNode]? null
            if assigned_name_text.length > 0
                set assigned_name: f.new_string_literal(assigned_name_text, TokenFlagsNone)
            else
            {
                if AstNode.is_export_equals_of(node)
                {
                    let empty: Slice[char] ""
                    set assigned_name: f.new_string_literal(empty, TokenFlagsNone)
                }
                else
                {
                    let default_name: Slice[char] "default"
                    set assigned_name: f.new_string_literal(default_name, TokenFlagsNone)
                }
            }
            let expression Transformer.finish_transform_named_evaluation(ctx, Checker.export_assignment_expression_of(node) as ref[AstNode], assigned_name as ref[AstNode], ignore_empty_string_literal)
            return f.update_export_assignment(node, null, AstNode.is_export_equals_of(node), null, expression)
        }
        node
    }

    ; ═══ estransforms/esdecorator.go (slice 240) ═══
    ;
    ; The ES decorator transform: a decorated class becomes an IIFE that
    ; evaluates the decorators, applies them through `__esDecorate` and runs the
    ; extra initializers through `__runInitializers`, in the order of the
    ; specification's ClassDefinitionEvaluation (the header comment of the
    ; reference lists the thirteen steps). The reference's twelve extra
    ; visitors are the same transformer under a `sub_tag` (§3.42).

    ; the visitor for a sub tag, made on first use
    function esd_visitor(this, sub: int) returns ref[NodeVisitor]
    {
        if esd_visitors = null
        {
            let table &Array[ref[NodeVisitor]?]^host()
            var i 0
            while i <= 12
            {
                table.add(null)
                set i: i + 1
            }
            set this.esd_visitors: table
        }
        let visitors esd_visitors as ref[Array[ref[NodeVisitor]?]]
        let existing visitors[sub as size_t]
        if existing <> null
            return existing as ref[NodeVisitor]
        let v context.new_node_visitor(VisitTagTransformer)
        set v.transformer: this
        set v.sub_tag: sub
        visitors.put(sub as size_t, v)
        v
    }

    ; the sub visitors' `Visit`
    procedure visit_sub(this, node: ref[AstNode], sub: int) returns ref[AstNode]?
    {
        if tag = TransformerTagLegacyDecorators
        {
            if sub = LdSubStaticSelfReferenceCheck
                return this.ld_visit_for_static_self_reference_check(node)
        }
        if (tag >= TransformerTagLogicalAssignment) and (tag <= TransformerTagExponentiation)
        {
            if sub = EsSubFaFallback
                return this.fa_fallback_visitor(node)
            if sub = EsSubNoAsyncModifier
            {
                if node.kind = KindAsyncKeyword
                    return null
                return node
            }
            if sub = EsSubSuperAccess
                return this.sa_visit_super_access_node(node)
            if sub = EsSubAsBody
                return this.as_visit_async_body_node(node)
            if sub = EsSubAsFallback
                return this.as_fallback_visitor(node)
        }
        if tag = TransformerTagClassFields
        {
            if sub = CfSubModifier
                return this.cf_visit_modifier(node)
            if sub = CfSubDiscarded
                return this.cf_visit_discarded_value(node)
            if sub = CfSubHeritageClause
                return this.cf_visit_heritage_clause(node)
            if sub = CfSubAssignmentTarget
                return this.cf_visit_assignment_target(node)
            if sub = CfSubClassElement
                return this.cf_visit_class_element(node)
            if sub = CfSubAccessorFieldResult
                return this.cf_visit_accessor_field_result(node)
            if sub = CfSubArrayAssignmentElement
                return this.cf_visit_array_assignment_element(node)
            if sub = CfSubObjectAssignmentElement
                return this.cf_visit_object_assignment_element(node)
            if sub = CfSubSubstitution
                return this.cf_visit_for_substitution(node)
            if sub = CfSubConstructorReferenceCheck
                return this.cf_visit_for_constructor_reference_check(node)
        }
        if tag = TransformerTagCommonJS
        {
            if sub = CjsSubTopLevel
                return this.cjs_visit_top_level(node)
            if sub = CjsSubTopLevelNested
                return this.cjs_visit_top_level_nested(node)
            if sub = CjsSubDiscarded
                return this.cjs_visit_discarded_value(node)
            if sub = CjsSubAssignmentPattern
                return this.cjs_visit_assignment_pattern(node)
        }
        if tag = TransformerTagESDecorator
        {
            if sub = EsdSubOuterThis
                return this.esd_outer_this_visit(node)
            if sub = EsdSubDiscarded
                return this.esd_discarded_value_visit(node)
            if sub = EsdSubModifier
                return this.esd_modifier_visit(node)
            if sub = EsdSubExportStrippingModifier
                return this.esd_export_stripping_modifier_visit(node)
            if sub = EsdSubClassElement
                return this.esd_class_element_visit(node)
            if sub = EsdSubNonConstructorClassElement
                return this.esd_non_constructor_class_element_visit(node)
            if sub = EsdSubConstructorClassElement
                return this.esd_constructor_class_element_visit(node)
            if sub = EsdSubArrayAssignment
                return this.esd_visit_array_assignment_element(node)
            if sub = EsdSubObjectAssignment
                return this.esd_visit_object_assignment_element(node)
            if sub = EsdSubStaticOnlyModifier
            {
                if node.kind = KindStaticKeyword
                    return node
                return null
            }
            if sub = EsdSubAsyncOnlyModifier
            {
                if node.kind = KindAsyncKeyword
                    return node
                return null
            }
            if sub = EsdSubAccessorStrippingModifier
            {
                if node.kind = KindAccessorKeyword
                    return null
                return node
            }
        }
        this.record_unported("transformer-sub-tag", sub)
        node
    }

    ; ── the lexical stack ──

    procedure esd_update_state(this)
    {
        set this.esd_class_info: null
        set this.esd_class_this: null
        set this.esd_class_super: null
        if esd_top = null
            return
        let top esd_top as ref[EsdLexicalEntry]
        if top.kind = EsdLexicalKindClass
        {
            set this.esd_class_info: top.class_info
            return
        }
        if top.kind = EsdLexicalKindClassElement
        {
            let next top.next as ref[EsdLexicalEntry]
            set this.esd_class_info: next.class_info
            set this.esd_class_this: top.class_this
            set this.esd_class_super: top.class_super
            return
        }
        if top.kind = EsdLexicalKindName
        {
            let n1 top.next
            if n1 = null
                return
            let n2 (n1 as ref[EsdLexicalEntry]).next
            if n2 = null
                return
            let grandparent (n2 as ref[EsdLexicalEntry]).next
            if grandparent = null
                return
            let g grandparent as ref[EsdLexicalEntry]
            if g.kind = EsdLexicalKindClassElement
            {
                let gn g.next as ref[EsdLexicalEntry]
                set this.esd_class_info: gn.class_info
                set this.esd_class_this: g.class_this
                set this.esd_class_super: g.class_super
            }
        }
    }

    procedure esd_enter_class(this, ci: ref[EsdClassInfo]?)
    {
        set this.esd_top: &EsdLexicalEntry^host(EsdLexicalKindClass, esd_top, ci, esd_pending_expressions, null, null, 0)
        set this.esd_pending_expressions: null
        this.esd_update_state()
    }

    procedure esd_exit_class(this)
    {
        let top esd_top as ref[EsdLexicalEntry]
        set this.esd_pending_expressions: top.saved_pending_expressions
        set this.esd_top: top.next
        this.esd_update_state()
    }

    procedure esd_enter_class_element(this, node: ref[AstNode])
    {
        let entry &EsdLexicalEntry^host(EsdLexicalKindClassElement, esd_top, null, null, null, null, 0)
        set this.esd_top: entry
        var takes_this false
        if node.kind = KindClassStaticBlockDeclaration
            set takes_this: true
        if (node.kind = KindPropertyDeclaration) and Transformer.has_static_modifier(node)
            set takes_this: true
        if takes_this
        {
            let next entry.next as ref[EsdLexicalEntry]
            if next.class_info <> null
            {
                let ci next.class_info as ref[EsdClassInfo]
                set entry.class_this: ci.class_this
                set entry.class_super: ci.class_super
            }
        }
        this.esd_update_state()
    }

    procedure esd_exit_class_element(this)
    {
        let top esd_top as ref[EsdLexicalEntry]
        set this.esd_top: top.next
        this.esd_update_state()
    }

    procedure esd_enter_name(this)
    {
        set this.esd_top: &EsdLexicalEntry^host(EsdLexicalKindName, esd_top, null, null, null, null, 0)
        this.esd_update_state()
    }

    procedure esd_exit_name(this)
    {
        let top esd_top as ref[EsdLexicalEntry]
        set this.esd_top: top.next
        this.esd_update_state()
    }

    procedure esd_enter_other(this)
    {
        if esd_top <> null
        {
            let top esd_top as ref[EsdLexicalEntry]
            if top.kind = EsdLexicalKindOther
            {
                set top.depth: top.depth + 1
                return
            }
        }
        set this.esd_top: &EsdLexicalEntry^host(EsdLexicalKindOther, esd_top, null, esd_pending_expressions, null, null, 0)
        set this.esd_pending_expressions: null
        this.esd_update_state()
    }

    procedure esd_exit_other(this)
    {
        let top esd_top as ref[EsdLexicalEntry]
        if top.depth > 0
        {
            set top.depth: top.depth - 1
            return
        }
        set this.esd_pending_expressions: top.saved_pending_expressions
        set this.esd_top: top.next
        this.esd_update_state()
    }

    ; ── visit ──

    procedure esd_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        set this.esd_top: null
        set this.esd_private_static_in_file: false
        let visited this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(visited, helper as ref[EmitHelper])
            set h: h + 1
        }
        if esd_private_static_in_file
        {
            context.add_emit_flags(visited, EFTransformPrivateStaticElements)
            set this.esd_private_static_in_file: false
        }
        visited
    }

    procedure esd_outer_this_visit(this, n: ref[AstNode]) returns ref[AstNode]?
    {
        if ((Emitter.subtree_facts(n) & SubtreeContainsLexicalThis) = 0) and (n.kind <> KindThisKeyword)
            return n
        if n.kind = KindThisKeyword
        {
            if esd_outer_this = null
            {
                let text: Slice[char] "_outerThis"
                let empty: Slice[char] ""
                set this.esd_outer_this: factory.new_unique_name_ex(text, GeneratedIdentifierFlagsOptimistic, empty, empty)
            }
            return esd_outer_this
        }
        this.esd_visitor(EsdSubOuterThis).visit_each_child(n)
    }

    function esd_should_visit_node(this, node: ref[AstNode]) returns bool
    {
        let facts Emitter.subtree_facts(node)
        if (facts & SubtreeContainsDecorators) <> 0
            return true
        if (esd_class_this <> null) and ((facts & SubtreeContainsLexicalThis) <> 0)
            return true
        if (esd_class_this <> null) and (esd_class_super <> null) and ((facts & SubtreeContainsLexicalSuper) <> 0)
            return true
        false
    }

    procedure visit_es_decorator(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if node.kind = KindSourceFile
            return this.esd_visit_source_file(node)
        if this.esd_should_visit_node(node) = false
            return node
        let k node.kind
        ; Decorators are elided
        if k = KindDecorator
            return null
        if k = KindClassDeclaration
            return this.esd_visit_class_declaration(node)
        if k = KindClassExpression
            return this.esd_visit_class_expression(node)
        if (k = KindConstructor) or (k = KindPropertyDeclaration) or (k = KindClassStaticBlockDeclaration)
        {
            ; "Not supported outside of a class. Use 'classElementVisitor' instead."
            this.record_unported("es-decorator-element-outside-class", k)
            return null
        }
        if k = KindParameter
            return this.esd_visit_parameter_declaration(node)
        if k = KindBinaryExpression
            return this.esd_visit_binary_expression(node, false)
        if (k = KindPropertyAssignment) or (k = KindVariableDeclaration) or (k = KindBindingElement)
            return this.esd_visit_named_evaluation_site(node, AstNode.initializer_of(node))
        if k = KindExportAssignment
            return this.esd_visit_export_assignment(node)
        if k = KindThisKeyword
            return this.esd_visit_this_expression(node)
        if k = KindForStatement
            return this.esd_visit_for_statement(node)
        if k = KindExpressionStatement
            return this.esd_visit_expression_statement(node)
        if k = KindParenthesizedExpression
            return this.esd_visit_parenthesized_expression(node, false)
        if k = KindPartiallyEmittedExpression
            return this.esd_visit_partially_emitted_expression(node, false)
        if k = KindCallExpression
            return this.esd_visit_call_expression(node)
        if k = KindTaggedTemplateExpression
            return this.esd_visit_tagged_template_expression(node)
        if (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression)
            return this.esd_visit_pre_or_postfix_unary_expression(node, false)
        if k = KindPropertyAccessExpression
            return this.esd_visit_property_access_expression(node)
        if k = KindElementAccessExpression
            return this.esd_visit_element_access_expression(node)
        if k = KindComputedPropertyName
            return this.esd_visit_computed_property_name(node)
        if (k = KindMethodDeclaration) or (k = KindSetAccessor) or (k = KindGetAccessor) or (k = KindFunctionExpression) or (k = KindFunctionDeclaration)
        {
            this.esd_enter_other()
            let result v.visit_each_child(node)
            this.esd_exit_other()
            return result
        }
        v.visit_each_child(node)
    }

    procedure esd_modifier_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindDecorator
            return null
        node
    }

    procedure esd_class_element_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindConstructor
            return this.esd_visit_constructor_declaration(node)
        if k = KindMethodDeclaration
            return this.esd_visit_method_declaration(node)
        if k = KindGetAccessor
            return this.esd_visit_get_accessor_declaration(node)
        if k = KindSetAccessor
            return this.esd_visit_set_accessor_declaration(node)
        if k = KindPropertyDeclaration
            return this.esd_visit_property_declaration(node)
        if k = KindClassStaticBlockDeclaration
            return this.esd_visit_class_static_block_declaration(node)
        this.visit_es_decorator(node)
    }

    procedure esd_discarded_value_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression)
            return this.esd_visit_pre_or_postfix_unary_expression(node, true)
        if k = KindBinaryExpression
            return this.esd_visit_binary_expression(node, true)
        if k = KindParenthesizedExpression
            return this.esd_visit_parenthesized_expression(node, true)
        if k = KindPartiallyEmittedExpression
            return this.esd_visit_partially_emitted_expression(node, true)
        this.visit_es_decorator(node)
    }

    procedure esd_non_constructor_class_element_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindConstructor
            return node
        this.esd_class_element_visit(node)
    }

    procedure esd_constructor_class_element_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindConstructor
            return this.esd_class_element_visit(node)
        node
    }

    procedure esd_export_stripping_modifier_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindExportKeyword
            return null
        this.esd_modifier_visit(node)
    }

    ; getHelperVariableName: `_<get_|set_><private_><static_>name`
    procedure esd_helper_variable_name(this, node: ref[AstNode]) returns Slice[char]
    {
        let name Printer.declaration_name_of(node)
        let b StringBuilder^host()
        var declaration_name: Slice[char] "member"
        var done false
        if name <> null
        {
            let nm name as ref[AstNode]
            if (nm.kind = KindIdentifier) and (context.has_auto_generate_info(nm) = false)
            {
                set declaration_name: AstNode.identifier_text_of(nm)
                set done: true
            }
            if (done = false) and (nm.kind = KindPrivateIdentifier) and (context.has_auto_generate_info(nm) = false)
            {
                let text AstNode.identifier_text_of(nm)
                if text.length > 1
                    set declaration_name: text.slice_from(1)
                else
                {
                    let empty: Slice[char] ""
                    set declaration_name: empty
                }
                set done: true
            }
            if (done = false) and (nm.kind = KindStringLiteral)
            {
                if Checker.is_identifier_text(AstNode.literal_text_of(nm))
                {
                    set declaration_name: AstNode.literal_text_of(nm)
                    set done: true
                }
            }
        }
        if done = false
        {
            if (node.kind = KindClassDeclaration) or (node.kind = KindClassExpression)
            {
                let class_text: Slice[char] "class"
                set declaration_name: class_text
            }
        }
        b.append("_")
        if Transformer.has_static_modifier(node)
            b.append("static_")
        if name <> null
        {
            if AstNode.kind_of(name) = KindPrivateIdentifier
                b.append("private_")
        }
        if node.kind = KindGetAccessor
            b.append("get_")
        if node.kind = KindSetAccessor
            b.append("set_")
        b.append(declaration_name.data, declaration_name.length as size_t)
        Printer.slice_on(host, b.to_string())
    }

    procedure esd_create_helper_variable(this, node: ref[AstNode], suffix: Slice[char]) returns ref[AstNode]
    {
        let base this.esd_helper_variable_name(node)
        let b StringBuilder^host()
        b.append(base.data, base.length as size_t)
        b.append("_")
        b.append(suffix.data, suffix.length as size_t)
        let empty: Slice[char] ""
        factory.new_unique_name_ex(Printer.slice_on(host, b.to_string()), GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty)
    }

    procedure esd_create_let(this, name: ref[AstNode], initializer: ref[AstNode]?) returns ref[AstNode]
    {
        let decls &Array[ref[AstNode]?]^host()
        decls.add(factory.new_variable_declaration(name, null, null, initializer))
        factory.new_variable_statement(null, factory.new_variable_declaration_list(decls, NodeFlagsLet))
    }

    procedure esd_unique_file_level(this, text: Slice[char]) returns ref[AstNode]
    {
        let empty: Slice[char] ""
        factory.new_unique_name_ex(text, GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsFileLevel, empty, empty)
    }

    ; createClassInfo: a first pass over the members
    procedure esd_create_class_info(this, node: ref[AstNode]) returns ref[EsdClassInfo]
    {
        let checker this.the_checker()
        let metadata_text: Slice[char] "_metadata"
        let ci &EsdClassInfo^host(node, null, null, null, null, null, this.esd_unique_file_level(metadata_text), &Array[EsdMemberEntry]^host(), null, null, &Array[ref[AstNode]?]^host(), &Array[ref[AstNode]?]^host(), &Array[ref[AstNode]?]^host(), &Array[ref[AstNode]?]^host(), false, false, false, null, null)
        let members Printer.member_list_of(node)
        ; If the class itself is decorated, create a _classThis binding
        if checker.node_is_decorated(false, node, null, null)
        {
            var needs_unique_class_this false
            if members <> null
            {
                let ml members as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (ml.get_length() as int)
                {
                    let m ml[i as size_t]
                    set i: i + 1
                    if m = null
                        continue
                    let member m as ref[AstNode]
                    if (AstNode.is_private_identifier_class_element_declaration(member) or Transformer.is_auto_accessor_property_declaration(member)) and Transformer.has_static_modifier(member)
                        set needs_unique_class_this: true
                }
            }
            var flags GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsFileLevel
            if needs_unique_class_this
                set flags: GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsReservedInNestedScopes
            let class_this_text: Slice[char] "_classThis"
            let empty: Slice[char] ""
            set ci.class_this: factory.new_unique_name_ex(class_this_text, flags, empty, empty)
        }
        if members = null
            return ci
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if m = null
                continue
            let member m as ref[AstNode]
            if AstNode.is_method_or_accessor(member) and checker.node_or_child_is_decorated(false, member, node, null)
            {
                if Transformer.has_static_modifier(member)
                {
                    if ci.static_method_extra_initializers_name = null
                    {
                        let text: Slice[char] "_staticExtraInitializers"
                        set ci.static_method_extra_initializers_name: this.esd_unique_file_level(text)
                        var renamed_class_this: ref[AstNode]? ci.class_this
                        if renamed_class_this = null
                            set renamed_class_this: factory.new_this_expression()
                        let initializer factory.new_run_initializers_helper(renamed_class_this as ref[AstNode], ci.static_method_extra_initializers_name as ref[AstNode], null)
                        this.esd_set_name_range(initializer, node)
                        set ci.pending_static_initializers: Transformer.esd_append(host, ci.pending_static_initializers, initializer)
                    }
                }
                else
                {
                    if ci.instance_method_extra_initializers_name = null
                    {
                        let text: Slice[char] "_instanceExtraInitializers"
                        set ci.instance_method_extra_initializers_name: this.esd_unique_file_level(text)
                        let initializer factory.new_run_initializers_helper(factory.new_this_expression(), ci.instance_method_extra_initializers_name as ref[AstNode], null)
                        this.esd_set_name_range(initializer, node)
                        set ci.pending_instance_initializers: Transformer.esd_append(host, ci.pending_instance_initializers, initializer)
                    }
                }
            }
            if member.kind = KindClassStaticBlockDeclaration
            {
                if Transformer.is_class_named_evaluation_helper_block(context, member) = false
                    set ci.has_static_initializers: true
            }
            else
            {
                if member.kind = KindPropertyDeclaration
                {
                    if Transformer.has_static_modifier(member)
                    {
                        if (AstNode.initializer_of(member) <> null) or Transformer.has_decorators(member)
                            set ci.has_static_initializers: true
                    }
                    else
                    {
                        if Transformer.has_syntactic_modifier(member, ModifierFlagsAmbient) = false
                            set ci.has_non_ambient_instance_fields: true
                    }
                }
            }
            if (AstNode.is_private_identifier_class_element_declaration(member) or Transformer.is_auto_accessor_property_declaration(member)) and Transformer.has_static_modifier(member)
                set ci.has_static_private_class_elements: true
            ; exit early if possible
            if (ci.static_method_extra_initializers_name <> null) and (ci.instance_method_extra_initializers_name <> null) and ci.has_static_initializers and ci.has_non_ambient_instance_fields and ci.has_static_private_class_elements
                break
        }
        ci
    }

    ; the source-map range of a class-level initializer: the class name, else
    ; the class past its decorators
    procedure esd_set_name_range(this, initializer: ref[AstNode], node: ref[AstNode])
    {
        let name Printer.declaration_name_of(node)
        if name <> null
            context.set_source_map_range(initializer, TextRange.of_node(name as ref[AstNode]))
        else
            context.set_source_map_range(initializer, Transformer.move_range_past_decorators(node))
    }

    function esd_append(host: ref[Page], list: ref[Array[ref[AstNode]?]]?, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        var out list
        if out = null
            set out: &Array[ref[AstNode]?]^host()
        let o out as ref[Array[ref[AstNode]?]]
        o.add(node)
        o
    }

    function list_len(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return 0
        (list as ref[Array[ref[AstNode]?]]).get_length() as int
    }

    ; transformClassLike: the IIFE
    procedure esd_transform_class_like(this, node_in: ref[AstNode]) returns ref[AstNode]
    {
        let checker this.the_checker()
        let v this.the_visitor()
        context.start_variable_environment()
        var node node_in
        ; a decorated class without an assigned name gets `""`
        if (Transformer.class_has_declared_or_explicitly_assigned_name(context, node) = false) and checker.class_or_constructor_parameter_is_decorated(false, node)
        {
            let empty: Slice[char] ""
            set node: Transformer.inject_class_named_evaluation_helper_block_if_missing(context, node, factory.new_string_literal(empty, TokenFlagsNone), null)
        }
        let class_reference factory.get_local_name_ex(node, false, false, false)
        let ci this.esd_create_class_info(node)
        let class_definition_statements &Array[ref[AstNode]?]^host()
        let leading_block_statements &Array[ref[AstNode]?]^host()
        let trailing_block_statements &Array[ref[AstNode]?]^host()
        var synthetic_constructor: ref[AstNode]? null
        var heritage_clauses: ref[Array[ref[AstNode]?]]? null
        var should_transform_private_static_in_class false
        ; 1. Class decorators are evaluated outside the private name scope of the class.
        let class_decorators this.esd_transform_all_decorators_of_declaration(Transformer.decorators_of(host, node))
        if Transformer.list_len(class_decorators) > 0
        {
            let t1: Slice[char] "_classDecorators"
            let t2: Slice[char] "_classDescriptor"
            let t3: Slice[char] "_classExtraInitializers"
            set ci.class_decorators_name: this.esd_unique_file_level(t1)
            set ci.class_descriptor_name: this.esd_unique_file_level(t2)
            set ci.class_extra_initializers_name: this.esd_unique_file_level(t3)
            let decorators_array factory.new_array_literal_expression(class_decorators, false)
            class_definition_statements.add(this.esd_create_let(ci.class_decorators_name as ref[AstNode], decorators_array))
            class_definition_statements.add(this.esd_create_let(ci.class_descriptor_name as ref[AstNode], null))
            class_definition_statements.add(this.esd_create_let(ci.class_extra_initializers_name as ref[AstNode], factory.new_array_literal_expression(&Array[ref[AstNode]?]^host(), false)))
            class_definition_statements.add(this.esd_create_let(ci.class_this as ref[AstNode], null))
            if ci.has_static_private_class_elements
            {
                set should_transform_private_static_in_class: true
                set this.esd_private_static_in_file: true
            }
        }
        ; 2. ClassHeritage clause is evaluated outside of the private name scope of the class.
        var extends_clause: ref[AstNode]? null
        let clauses AstNode.heritage_clauses_of(node)
        if clauses <> null
        {
            let cl clauses as ref[Array[ref[AstNode]?]]
            var c 0
            while c < (cl.get_length() as int)
            {
                let clause cl[c as size_t]
                set c: c + 1
                if clause = null
                    continue
                if AstNode.heritage_clause_token_of(clause as ref[AstNode]) = KindExtendsKeyword
                {
                    set extends_clause: clause
                    break
                }
            }
        }
        var extends_element: ref[AstNode]? null
        if extends_clause <> null
        {
            let types AstNode.heritage_clause_types_of(extends_clause as ref[AstNode])
            if types <> null
            {
                let tl types as ref[Array[ref[AstNode]?]]
                if tl.get_length() > 0
                    set extends_element: tl[0]
            }
        }
        var extends_expression: ref[AstNode]? null
        if extends_element <> null
            set extends_expression: v.visit_node(AstNode.expression_of(extends_element))
        if extends_expression <> null
        {
            let ee extends_expression as ref[AstNode]
            ; Rewrite `super` in static initializers so that we can use the correct `this`.
            let super_text: Slice[char] "_classSuper"
            set ci.class_super: this.esd_unique_file_level(super_text)
            ; Ensure we do not give the class or function an assigned name due to the variable by prefixing it with `0, `.
            let unwrapped Parser.skip_outer_expressions(ee, OEKAll) as ref[AstNode]
            var safe_extends_expression ee
            var anonymous false
            if ((unwrapped.kind = KindClassExpression) or (unwrapped.kind = KindFunctionExpression)) and (Printer.declaration_name_of(unwrapped) = null)
                set anonymous: true
            if unwrapped.kind = KindArrowFunction
                set anonymous: true
            if anonymous
            {
                let zero: Slice[char] "0"
                set safe_extends_expression: factory.new_comma_expression(factory.new_numeric_literal(zero, TokenFlagsNone), ee)
            }
            class_definition_statements.add(this.esd_create_let(ci.class_super as ref[AstNode], safe_extends_expression))
            let updated_extends_element factory.update_expression_with_type_arguments(extends_element as ref[AstNode], ci.class_super, null)
            let one &Array[ref[AstNode]?]^host()
            one.add(updated_extends_element)
            let ec extends_clause as ref[AstNode]
            let updated_extends_clause factory.update_heritage_clause(ec, AstNode.heritage_clause_token_of(ec), one)
            let hc &Array[ref[AstNode]?]^host()
            hc.add(updated_extends_clause)
            set heritage_clauses: hc
        }
        var renamed_class_this: ref[AstNode]? ci.class_this
        if renamed_class_this = null
            set renamed_class_this: factory.new_this_expression()
        let rct renamed_class_this as ref[AstNode]
        ; 4. For each member, in two passes: the non-constructors, then the constructor
        this.esd_enter_class(ci)
        leading_block_statements.add(this.esd_create_metadata(ci.metadata_reference, ci.class_super))
        var members this.esd_visitor(EsdSubNonConstructorClassElement).visit_nodes(Printer.member_list_of(node))
        set members: this.esd_visitor(EsdSubConstructorClassElement).visit_nodes(members)
        ; Handle pending expressions (computed property names and decorator evaluations)
        if Transformer.list_len(esd_pending_expressions) > 0
        {
            set this.esd_outer_this: null
            let pending esd_pending_expressions as ref[Array[ref[AstNode]?]]
            var p 0
            while p < (pending.get_length() as int)
            {
                var expr pending[p as size_t] as ref[AstNode]
                set p: p + 1
                ; If a pending expression contains lexical `this`, capture it
                if (Emitter.subtree_facts(expr) & SubtreeContainsLexicalThis) <> 0
                    set expr: this.esd_visitor(EsdSubOuterThis).visit_node(expr) as ref[AstNode]
                leading_block_statements.add(factory.new_expression_statement(expr))
            }
            if esd_outer_this <> null
            {
                let prefixed &Array[ref[AstNode]?]^host()
                prefixed.add(this.esd_create_let(esd_outer_this as ref[AstNode], factory.new_this_expression()))
                Transformer.add_all(prefixed, class_definition_statements)
                class_definition_statements.clear()
                Transformer.add_all(class_definition_statements, prefixed)
            }
            set this.esd_pending_expressions: null
        }
        this.esd_exit_class()
        ; If there are instance initializers but no constructor, synthesize one
        if (Transformer.list_len(ci.pending_instance_initializers) > 0) and (Transformer.get_first_constructor_with_body(node) = null)
        {
            let initializer_statements this.esd_prepare_constructor(ci)
            if Transformer.list_len(initializer_statements) > 0
            {
                var is_derived_class false
                if extends_element <> null
                {
                    let inner Parser.skip_outer_expressions(AstNode.expression_of(extends_element), OEKAll)
                    if AstNode.kind_of(inner) <> KindNullKeyword
                        set is_derived_class: true
                }
                let constructor_statements &Array[ref[AstNode]?]^host()
                if is_derived_class
                {
                    let args_text: Slice[char] "arguments"
                    let spread_arguments factory.new_spread_element(factory.new_identifier(args_text))
                    let args &Array[ref[AstNode]?]^host()
                    args.add(spread_arguments)
                    let super_call factory.new_call_expression(factory.new_keyword_expression(KindSuperKeyword), null, null, args, NodeFlagsNone)
                    constructor_statements.add(factory.new_expression_statement(super_call))
                }
                Transformer.add_all(constructor_statements, initializer_statements)
                let constructor_body factory.new_block(constructor_statements, true)
                set synthetic_constructor: factory.new_constructor_declaration(null, null, &Array[ref[AstNode]?]^host(), null, null, constructor_body)
            }
        }
        ; Used in class definition steps 5,7,11
        if ci.static_method_extra_initializers_name <> null
            class_definition_statements.add(this.esd_create_let(ci.static_method_extra_initializers_name as ref[AstNode], factory.new_array_literal_expression(&Array[ref[AstNode]?]^host(), false)))
        ; Used in class definition steps 6,8, and construction
        if ci.instance_method_extra_initializers_name <> null
            class_definition_statements.add(this.esd_create_let(ci.instance_method_extra_initializers_name as ref[AstNode], factory.new_array_literal_expression(&Array[ref[AstNode]?]^host(), false)))
        ; Used in class definition steps 7, 8, 12, and construction: static member vars first, then non-static
        if ci.member_infos.get_length() > 0
        {
            this.esd_emit_member_info_declarations(ci, true, class_definition_statements)
            this.esd_emit_member_info_declarations(ci, false, class_definition_statements)
        }
        ; 5.-8. the element decorators are applied
        Transformer.add_all(leading_block_statements, ci.static_non_field_decoration_statements)
        Transformer.add_all(leading_block_statements, ci.non_static_non_field_decoration_statements)
        Transformer.add_all(leading_block_statements, ci.static_field_decoration_statements)
        Transformer.add_all(leading_block_statements, ci.non_static_field_decoration_statements)
        ; 9. Class decorators are applied; 10. Class binding is initialized
        if (ci.class_descriptor_name <> null) and (ci.class_decorators_name <> null) and (ci.class_extra_initializers_name <> null) and (ci.class_this <> null)
        {
            let value_text: Slice[char] "value"
            let name_text: Slice[char] "name"
            let props &Array[ref[AstNode]?]^host()
            props.add(factory.new_property_assignment(null, factory.new_identifier(value_text), null, null, rct))
            let class_descriptor factory.new_object_literal_expression(props, false)
            let class_descriptor_assignment factory.new_assignment_expression(ci.class_descriptor_name, class_descriptor)
            let class_name_reference factory.new_property_access_expression(rct, null, factory.new_identifier(name_text), NodeFlagsNone)
            let context_obj factory.new_es_decorate_class_context_object(class_name_reference, ci.metadata_reference)
            let es_decorate_helper factory.new_es_decorate_helper(factory.new_token(KindNullKeyword), class_descriptor_assignment, ci.class_decorators_name as ref[AstNode], context_obj, factory.new_token(KindNullKeyword), ci.class_extra_initializers_name as ref[AstNode])
            let es_decorate_statement factory.new_expression_statement(es_decorate_helper)
            context.set_source_map_range(es_decorate_statement, Transformer.move_range_past_decorators(node))
            leading_block_statements.add(es_decorate_statement)
            ;   C = _classThis = _classDescriptor.value;
            let class_descriptor_value_ref factory.new_property_access_expression(ci.class_descriptor_name, null, factory.new_identifier(value_text), NodeFlagsNone)
            let class_this_assignment factory.new_assignment_expression(ci.class_this, class_descriptor_value_ref)
            let class_reference_assignment factory.new_assignment_expression(class_reference, class_this_assignment)
            leading_block_statements.add(factory.new_expression_statement(class_reference_assignment))
        }
        ;   if (metadata) Object.defineProperty(C, Symbol.metadata, { ... });
        leading_block_statements.add(this.esd_create_symbol_metadata(rct, ci.metadata_reference))
        ; 11. Static extra initializers; 12. Static fields are initialized
        if Transformer.list_len(ci.pending_static_initializers) > 0
        {
            let pending ci.pending_static_initializers as ref[Array[ref[AstNode]?]]
            var p 0
            while p < (pending.get_length() as int)
            {
                let initializer pending[p as size_t] as ref[AstNode]
                set p: p + 1
                let initializer_statement factory.new_expression_statement(initializer)
                context.set_source_map_range(initializer_statement, context.source_map_range(initializer))
                trailing_block_statements.add(initializer_statement)
            }
            set ci.pending_static_initializers: null
        }
        ; 13. Class extra initializers
        if ci.class_extra_initializers_name <> null
        {
            let run_class_initializers_helper factory.new_run_initializers_helper(rct, ci.class_extra_initializers_name as ref[AstNode], null)
            let run_class_initializers_statement factory.new_expression_statement(run_class_initializers_helper)
            this.esd_set_name_range(run_class_initializers_statement, node)
            trailing_block_statements.add(run_class_initializers_statement)
        }
        ; If there are no other static initializers to run, combine the leading and trailing block statements
        if (leading_block_statements.get_length() > 0) and (trailing_block_statements.get_length() > 0) and (ci.has_static_initializers = false)
        {
            Transformer.add_all(leading_block_statements, trailing_block_statements)
            trailing_block_statements.clear()
        }
        var leading_static_block: ref[AstNode]? null
        if leading_block_statements.get_length() > 0
            set leading_static_block: factory.new_class_static_block_declaration(null, factory.new_block(leading_block_statements, true))
        if (leading_static_block <> null) and should_transform_private_static_in_class
            context.set_emit_flags(leading_static_block as ref[AstNode], EFTransformPrivateStaticElements)
        var trailing_static_block: ref[AstNode]? null
        if trailing_block_statements.get_length() > 0
            set trailing_static_block: factory.new_class_static_block_declaration(null, factory.new_block(trailing_block_statements, true))
        ; Assemble new members list
        if (leading_static_block <> null) or (synthetic_constructor <> null) or (trailing_static_block <> null)
        {
            let old_members members as ref[Array[ref[AstNode]?]]
            let new_members &Array[ref[AstNode]?]^host()
            var existing_index 0 - 1
            var m 0
            while m < (old_members.get_length() as int)
            {
                let member old_members[m as size_t]
                if member <> null
                {
                    if Transformer.is_class_named_evaluation_helper_block(context, member as ref[AstNode])
                    {
                        set existing_index: m
                        break
                    }
                }
                set m: m + 1
            }
            if leading_static_block <> null
            {
                set m: 0
                while m <= existing_index
                {
                    new_members.add(old_members[m as size_t])
                    set m: m + 1
                }
                new_members.add(leading_static_block)
                while m < (old_members.get_length() as int)
                {
                    new_members.add(old_members[m as size_t])
                    set m: m + 1
                }
            }
            else
                Transformer.add_all(new_members, old_members)
            if synthetic_constructor <> null
                new_members.add(synthetic_constructor)
            if trailing_static_block <> null
                new_members.add(trailing_static_block)
            var mp 0 - 1
            var me 0 - 1
            AstNode.list_range_of(current_source_file, members, &mp, &me)
            factory.set_list_range(new_members, mp, me)
            set members: new_members
        }
        let lexical_environment context.end_variable_environment()
        var class_expression: ref[AstNode]? null
        if Transformer.list_len(class_decorators) > 0
        {
            var ce factory.new_class_expression(null, null, null, heritage_clauses, members)
            context.set_original(ce, node)
            if ci.class_this <> null
                set ce: this.esd_inject_class_this_assignment_if_missing(ce, ci.class_this as ref[AstNode])
            set class_expression: ce
            ;   var C = class { ... }; return C;
            let class_reference_declaration factory.new_variable_declaration(class_reference, null, null, ce)
            let decls &Array[ref[AstNode]?]^host()
            decls.add(class_reference_declaration)
            let class_reference_var_decl_list factory.new_variable_declaration_list(decls, NodeFlagsNone)
            var return_expr: ref[AstNode]? class_reference
            if ci.class_this <> null
                set return_expr: factory.new_assignment_expression(class_reference, ci.class_this)
            class_definition_statements.add(factory.new_variable_statement(null, class_reference_var_decl_list))
            class_definition_statements.add(factory.new_return_statement(return_expr))
        }
        else
        {
            ;   return <classExpression>;
            let ce factory.new_class_expression(null, Printer.declaration_name_of(node), null, heritage_clauses, members)
            context.set_original(ce, node)
            set class_expression: ce
            class_definition_statements.add(factory.new_return_statement(ce))
        }
        let cx class_expression as ref[AstNode]
        if should_transform_private_static_in_class
        {
            context.add_emit_flags(cx, EFTransformPrivateStaticElements)
            let cms Printer.member_list_of(cx)
            if cms <> null
            {
                let cml cms as ref[Array[ref[AstNode]?]]
                var m 0
                while m < (cml.get_length() as int)
                {
                    let member cml[m as size_t]
                    set m: m + 1
                    if member = null
                        continue
                    let mm member as ref[AstNode]
                    if (AstNode.is_private_identifier_class_element_declaration(mm) or Transformer.is_auto_accessor_property_declaration(mm)) and Transformer.has_static_modifier(mm)
                        context.add_emit_flags(mm, EFTransformPrivateStaticElements)
                }
            }
        }
        var changed false
        let merged context.merge_environment(class_definition_statements, lexical_environment, &changed) as ref[Array[ref[AstNode]?]]
        factory.new_immediately_invoked_arrow_function(merged)
    }

    ; emitMemberInfoDeclarations: the `let` declarations of the member info
    ; variables, static or non-static
    procedure esd_emit_member_info_declarations(this, ci: ref[EsdClassInfo], is_static: bool, out: ref[Array[ref[AstNode]?]])
    {
        var i 0
        while i < (ci.member_infos.get_length() as int)
        {
            let entry ci.member_infos[i as size_t]
            set i: i + 1
            if Transformer.is_static_member(entry.member) <> is_static
                continue
            let mi entry.info
            out.add(this.esd_create_let(mi.member_decorators_name as ref[AstNode], null))
            if mi.member_initializers_name <> null
                out.add(this.esd_create_let(mi.member_initializers_name as ref[AstNode], factory.new_array_literal_expression(&Array[ref[AstNode]?]^host(), false)))
            if mi.member_extra_initializers_name <> null
                out.add(this.esd_create_let(mi.member_extra_initializers_name as ref[AstNode], factory.new_array_literal_expression(&Array[ref[AstNode]?]^host(), false)))
            if mi.member_descriptor_name <> null
                out.add(this.esd_create_let(mi.member_descriptor_name as ref[AstNode], null))
        }
    }

    function esd_is_decorated_class_like(this, node: ref[AstNode]) returns bool
    {
        let checker this.the_checker()
        if checker.class_or_constructor_parameter_is_decorated(false, node)
            return true
        checker.child_is_decorated(false, node, null)
    }

    procedure esd_visit_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.esd_is_decorated_class_like(node)
        {
            let statements &Array[ref[AstNode]?]^host()
            var original_class: ref[AstNode]? context.most_original(node)
            if original_class <> null
            {
                let oc original_class as ref[AstNode]
                if (oc.kind <> KindClassDeclaration) and (oc.kind <> KindClassExpression)
                    set original_class: node
            }
            else
                set original_class: node
            let oc original_class as ref[AstNode]
            var class_name: ref[AstNode]? null
            let original_name Printer.declaration_name_of(oc)
            if original_name <> null
                set class_name: factory.new_string_literal_from_node(original_name as ref[AstNode])
            else
            {
                let default_text: Slice[char] "default"
                set class_name: factory.new_string_literal(default_text, TokenFlagsNone)
            }
            let is_export Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
            let is_default Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
            var class_node node
            if Printer.declaration_name_of(node) = null
                set class_node: Transformer.inject_class_named_evaluation_helper_block_if_missing(context, class_node, class_name as ref[AstNode], null)
            if is_export and is_default
            {
                let iife this.esd_transform_class_like(class_node)
                if Printer.declaration_name_of(class_node) <> null
                {
                    ;   let C = (() => { ... })();  export default C;
                    let var_decl factory.new_variable_declaration(factory.get_local_name(class_node), null, null, iife)
                    context.set_original(var_decl, class_node)
                    let decls &Array[ref[AstNode]?]^host()
                    decls.add(var_decl)
                    statements.add(factory.new_variable_statement(null, factory.new_variable_declaration_list(decls, NodeFlagsLet)))
                    let export_statement factory.new_export_default(factory.get_declaration_name(class_node))
                    context.set_original(export_statement, class_node)
                    context.assign_comment_range(export_statement, class_node)
                    context.set_source_map_range(export_statement, Transformer.move_range_past_decorators(class_node))
                    statements.add(export_statement)
                }
                else
                {
                    ;   export default (() => { ... })();
                    let export_statement factory.new_export_default(iife)
                    context.set_original(export_statement, class_node)
                    context.assign_comment_range(export_statement, class_node)
                    context.set_source_map_range(export_statement, Transformer.move_range_past_decorators(class_node))
                    statements.add(export_statement)
                }
            }
            else
            {
                ;   let C = (() => { ... })();
                let iife this.esd_transform_class_like(class_node)
                let modifiers this.esd_visitor(EsdSubExportStrippingModifier).visit_modifiers(Printer.modifier_list_of(class_node))
                let decl_name factory.get_local_name_ex(class_node, false, true, false)
                let var_decl factory.new_variable_declaration(decl_name, null, null, iife)
                context.set_original(var_decl, class_node)
                let decls &Array[ref[AstNode]?]^host()
                decls.add(var_decl)
                let var_statement factory.new_variable_statement(modifiers, factory.new_variable_declaration_list(decls, NodeFlagsLet))
                context.set_original(var_statement, class_node)
                context.assign_comment_range(var_statement, class_node)
                statements.add(var_statement)
                if is_export
                {
                    ;   export { C };
                    let export_statement factory.new_external_module_export(decl_name)
                    context.set_original(export_statement, class_node)
                    statements.add(export_statement)
                }
            }
            return this.single_or_many(statements)
        }
        ; Non-decorated class
        let modifiers this.esd_visitor(EsdSubModifier).visit_modifiers(Printer.modifier_list_of(node))
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        this.esd_enter_class(null)
        let members this.esd_visitor(EsdSubClassElement).visit_nodes(Printer.member_list_of(node))
        this.esd_exit_class()
        factory.update_class_declaration(node, modifiers, Printer.declaration_name_of(node), null, heritage_clauses, members)
    }

    procedure esd_visit_class_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if this.esd_is_decorated_class_like(node)
        {
            let iife this.esd_transform_class_like(node)
            context.set_original(iife, node)
            return iife
        }
        let modifiers this.esd_visitor(EsdSubModifier).visit_modifiers(Printer.modifier_list_of(node))
        let heritage_clauses v.visit_nodes(AstNode.heritage_clauses_of(node))
        this.esd_enter_class(null)
        let members this.esd_visitor(EsdSubClassElement).visit_nodes(Printer.member_list_of(node))
        this.esd_exit_class()
        factory.update_class_expression(node, modifiers, Printer.declaration_name_of(node), null, heritage_clauses, members)
    }

    ; prepareConstructor: the `__runInitializers()` statement for the instance
    ; extra initializers, when no field can carry them
    procedure esd_prepare_constructor(this, ci: ref[EsdClassInfo]) returns ref[Array[ref[AstNode]?]]?
    {
        if Transformer.list_len(ci.pending_instance_initializers) = 0
            return null
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_expression_statement(factory.inline_expressions(ci.pending_instance_initializers as ref[Array[ref[AstNode]?]])))
        set ci.pending_instance_initializers: null
        statements
    }

    procedure esd_transform_constructor_body_worker(this, out: ref[Array[ref[AstNode]?]], statements_in: ref[Array[ref[AstNode]?]], statement_offset: int, super_path: ref[Array[int]], depth: int, initializer_statements: ref[Array[ref[AstNode]?]])
    {
        let v this.the_visitor()
        let super_statement_index super_path[depth as size_t]
        var i statement_offset
        while i < super_statement_index
        {
            out.add(v.visit_node(statements_in[i as size_t]))
            set i: i + 1
        }
        let super_statement statements_in[super_statement_index as size_t] as ref[AstNode]
        if super_statement.kind = KindTryStatement
        {
            let try_block_node AstNode.try_block_of(super_statement) as ref[AstNode]
            let try_block_statements &Array[ref[AstNode]?]^host()
            this.esd_transform_constructor_body_worker(try_block_statements, AstNode.statements_of(try_block_node) as ref[Array[ref[AstNode]?]], 0, super_path, depth + 1, initializer_statements)
            let new_try_block factory.new_block(try_block_statements, true)
            set new_try_block.pos: try_block_node.pos
            set new_try_block.end: try_block_node.end
            let updated factory.update_try_statement(super_statement, new_try_block, v.visit_node(AstNode.catch_clause_of(super_statement)), v.visit_node(AstNode.finally_block_of(super_statement)))
            out.add(updated)
        }
        else
        {
            out.add(v.visit_node(super_statement))
            Transformer.add_all(out, initializer_statements)
        }
        set i: super_statement_index + 1
        while i < (statements_in.get_length() as int)
        {
            out.add(v.visit_node(statements_in[i as size_t]))
            set i: i + 1
        }
    }

    procedure esd_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        this.esd_enter_class_element(node)
        let modifiers this.esd_visitor(EsdSubModifier).visit_modifiers(Printer.modifier_list_of(node))
        let parameters v.visit_nodes(AstNode.parameters_of(node))
        var body: ref[AstNode]? null
        let ctor_body AstNode.body_of(node)
        if (ctor_body <> null) and (esd_class_info <> null)
        {
            let initializer_statements this.esd_prepare_constructor(esd_class_info as ref[EsdClassInfo])
            if Transformer.list_len(initializer_statements) > 0
            {
                let inits initializer_statements as ref[Array[ref[AstNode]?]]
                let cb ctor_body as ref[AstNode]
                let source AstNode.statements_of(cb) as ref[Array[ref[AstNode]?]]
                let prologue_end factory.split_standard_prologue(source)
                let stmts &Array[ref[AstNode]?]^host()
                var i 0
                while i < prologue_end
                {
                    stmts.add(source[i as size_t])
                    set i: i + 1
                }
                let rest Transformer.sub_list(host, source, prologue_end, source.get_length() as int)
                let super_path Transformer.find_super_statement_index_path(host, rest, 0)
                if super_path <> null
                    this.esd_transform_constructor_body_worker(stmts, rest, 0, super_path as ref[Array[int]], 0, inits)
                else
                {
                    Transformer.add_all(stmts, inits)
                    var changed false
                    Transformer.add_all(stmts, v.visit_slice(rest, &changed))
                }
                let b factory.new_block(stmts, true)
                context.set_original(b, cb)
                set b.pos: cb.pos
                set b.end: cb.end
                set body: b
            }
        }
        if body = null
            set body: v.visit_node(ctor_body)
        this.esd_exit_class_element()
        factory.update_constructor_declaration(node, modifiers, null, parameters, null, null, body)
    }

    procedure esd_finish_class_element(this, updated: ref[AstNode], original: ref[AstNode]) returns ref[AstNode]
    {
        if updated <> original
        {
            context.assign_comment_range(updated, original)
            context.set_source_map_range(updated, Transformer.move_range_past_decorators(original))
        }
        updated
    }

    ; partialTransformClassElement: decorators collected, the context object,
    ; the `__esDecorate` statement queued, the name visited
    procedure esd_partial_transform_class_element(this, member: ref[AstNode], ci: ref[EsdClassInfo]?, descriptor_kind: int) returns EsdPartialResult
    {
        var result EsdPartialResult(null, null, null, null, null, null, null)
        if ci = null
        {
            set result.modifiers: this.esd_visitor(EsdSubModifier).visit_modifiers(Printer.modifier_list_of(member))
            this.esd_enter_name()
            set result.name: this.esd_visit_property_name(Printer.declaration_name_of(member))
            this.esd_exit_name()
            return result
        }
        let info ci as ref[EsdClassInfo]
        ; Decorator expressions evaluate outside the class body, so `this` should NOT be replaced with `_classThis`.
        let saved_class_this esd_class_this
        set this.esd_class_this: null
        let member_decorators this.esd_transform_all_decorators_of_declaration(Transformer.decorators_of(host, member))
        set this.esd_class_this: saved_class_this
        let modifiers this.esd_visitor(EsdSubModifier).visit_modifiers(Printer.modifier_list_of(member))
        set result.modifiers: modifiers
        let name Printer.declaration_name_of(member)
        if Transformer.list_len(member_decorators) > 0
        {
            let decorators_text: Slice[char] "decorators"
            let member_decorators_name this.esd_create_helper_variable(member, decorators_text)
            let member_decorators_array factory.new_array_literal_expression(member_decorators as ref[Array[ref[AstNode]?]], false)
            let member_decorators_assignment factory.new_assignment_expression(member_decorators_name, member_decorators_array)
            let mi &EsdMemberInfo^host(member_decorators_name, null, null, null)
            info.member_infos.add(EsdMemberEntry(member, mi))
            set this.esd_pending_expressions: Transformer.esd_append(host, esd_pending_expressions, member_decorators_assignment)
            ; Determine decorator kind
            var kind: Slice[char] "field"
            if member.kind = KindGetAccessor
                set kind: "getter"
            if member.kind = KindSetAccessor
                set kind: "setter"
            if member.kind = KindMethodDeclaration
                set kind: "method"
            if Transformer.is_auto_accessor_property_declaration(member)
                set kind: "accessor"
            ; Determine the property name for the context
            var property_name_computed false
            var property_name_expr: ref[AstNode]? null
            if name <> null
            {
                let nm name as ref[AstNode]
                var decided false
                if (nm.kind = KindIdentifier) or (nm.kind = KindPrivateIdentifier)
                {
                    set property_name_expr: nm
                    set decided: true
                }
                if (decided = false) and Checker.is_property_name_literal(nm.kind)
                {
                    set property_name_computed: true
                    set property_name_expr: factory.new_string_literal_from_node(nm)
                    set decided: true
                }
                if (decided = false) and (nm.kind = KindComputedPropertyName)
                {
                    let cpn_expression AstNode.expression_of(nm) as ref[AstNode]
                    if Checker.is_property_name_literal(cpn_expression.kind) and (cpn_expression.kind <> KindIdentifier)
                    {
                        set property_name_computed: true
                        set property_name_expr: factory.new_string_literal_from_node(cpn_expression)
                    }
                    else
                    {
                        this.esd_enter_name()
                        var updated_name: ref[AstNode]? null
                        set result.referenced_name: this.esd_visit_referenced_property_name(nm, &updated_name)
                        set result.name: updated_name
                        this.esd_exit_name()
                        set property_name_computed: true
                        set property_name_expr: result.referenced_name
                    }
                }
            }
            var is_private false
            if name <> null
            {
                if AstNode.kind_of(name) = KindPrivateIdentifier
                    set is_private: true
            }
            let has_get (member.kind = KindPropertyDeclaration) or (member.kind = KindGetAccessor) or (member.kind = KindMethodDeclaration)
            let has_set (member.kind = KindPropertyDeclaration) or (member.kind = KindSetAccessor)
            let context_obj factory.new_es_decorate_class_element_context_object(kind, property_name_computed, property_name_expr, Transformer.is_static_member(member), is_private, has_get, has_set, info.metadata_reference)
            if AstNode.is_method_or_accessor(member)
            {
                var method_extra_initializers_name info.instance_method_extra_initializers_name
                if Transformer.is_static_member(member)
                    set method_extra_initializers_name: info.static_method_extra_initializers_name
                var descriptor_arg: ref[AstNode]? null
                if AstNode.is_private_identifier_class_element_declaration(member) and (descriptor_kind <> EsdDescriptorNone)
                {
                    ; For private members, extract the method/accessor body into a descriptor object.
                    let async_mods this.esd_visitor(EsdSubAsyncOnlyModifier).visit_modifiers(modifiers)
                    let descriptor this.esd_create_descriptor(member, async_mods, descriptor_kind)
                    let descriptor_text: Slice[char] "descriptor"
                    set mi.member_descriptor_name: this.esd_create_helper_variable(member, descriptor_text)
                    set result.descriptor_name: mi.member_descriptor_name
                    set descriptor_arg: factory.new_assignment_expression(mi.member_descriptor_name, descriptor)
                }
                else
                    set descriptor_arg: factory.new_token(KindNullKeyword)
                let es_decorate_expr factory.new_es_decorate_helper(factory.new_this_expression(), descriptor_arg as ref[AstNode], member_decorators_name, context_obj, factory.new_token(KindNullKeyword), method_extra_initializers_name as ref[AstNode])
                let es_decorate_statement factory.new_expression_statement(es_decorate_expr)
                context.set_source_map_range(es_decorate_statement, Transformer.move_range_past_decorators(member))
                this.esd_append_decoration_statement(info, member, es_decorate_statement)
            }
            else
            {
                if member.kind = KindPropertyDeclaration
                {
                    let initializers_text: Slice[char] "initializers"
                    let extra_text: Slice[char] "extraInitializers"
                    set mi.member_initializers_name: this.esd_create_helper_variable(member, initializers_text)
                    set mi.member_extra_initializers_name: this.esd_create_helper_variable(member, extra_text)
                    set result.initializers_name: mi.member_initializers_name
                    set result.extra_initializers_name: mi.member_extra_initializers_name
                    if Transformer.is_static_member(member)
                        set result.this_arg: info.class_this
                    var ctor_arg: ref[AstNode]? null
                    if Transformer.is_auto_accessor_property_declaration(member)
                        set ctor_arg: factory.new_this_expression()
                    else
                        set ctor_arg: factory.new_token(KindNullKeyword)
                    var descriptor_arg: ref[AstNode]? null
                    if AstNode.is_private_identifier_class_element_declaration(member) and Transformer.has_accessor_modifier(member) and (descriptor_kind <> EsdDescriptorNone)
                    {
                        let descriptor this.esd_create_descriptor(member, null, descriptor_kind)
                        let descriptor_text: Slice[char] "descriptor"
                        set mi.member_descriptor_name: this.esd_create_helper_variable(member, descriptor_text)
                        set result.descriptor_name: mi.member_descriptor_name
                        set descriptor_arg: factory.new_assignment_expression(mi.member_descriptor_name, descriptor)
                    }
                    else
                        set descriptor_arg: factory.new_token(KindNullKeyword)
                    let es_decorate_expr factory.new_es_decorate_helper(ctor_arg as ref[AstNode], descriptor_arg as ref[AstNode], member_decorators_name, context_obj, mi.member_initializers_name as ref[AstNode], mi.member_extra_initializers_name as ref[AstNode])
                    let es_decorate_statement factory.new_expression_statement(es_decorate_expr)
                    context.set_source_map_range(es_decorate_statement, Transformer.move_range_past_decorators(member))
                    this.esd_append_decoration_statement(info, member, es_decorate_statement)
                }
            }
        }
        if result.name = null
        {
            this.esd_enter_name()
            set result.name: this.esd_visit_property_name(name)
            this.esd_exit_name()
        }
        if (Transformer.list_len(modifiers) = 0) and ((member.kind = KindMethodDeclaration) or (member.kind = KindPropertyDeclaration))
        {
            ; Don't emit leading comments on the name for methods and properties without modifiers
            if result.name <> null
                context.set_emit_flags(result.name as ref[AstNode], EFNoLeadingComments)
        }
        result
    }

    procedure esd_append_decoration_statement(this, ci: ref[EsdClassInfo], member: ref[AstNode], stmt: ref[AstNode])
    {
        if AstNode.is_method_or_accessor(member) or Transformer.is_auto_accessor_property_declaration(member)
        {
            if Transformer.is_static_member(member)
                ci.static_non_field_decoration_statements.add(stmt)
            else
                ci.non_static_non_field_decoration_statements.add(stmt)
            return
        }
        if (member.kind = KindPropertyDeclaration) and (Transformer.is_auto_accessor_property_declaration(member) = false)
        {
            if Transformer.is_static_member(member)
                ci.static_field_decoration_statements.add(stmt)
            else
                ci.non_static_field_decoration_statements.add(stmt)
        }
    }

    procedure esd_visit_method_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        this.esd_enter_class_element(node)
        let result this.esd_partial_transform_class_element(node, esd_class_info, EsdDescriptorMethod)
        if result.descriptor_name <> null
        {
            this.esd_exit_class_element()
            return this.esd_finish_class_element(this.esd_create_method_descriptor_forwarder(result.modifiers, result.name, result.descriptor_name as ref[AstNode]), node)
        }
        let parameters v.visit_nodes(AstNode.parameters_of(node))
        let body v.visit_node(AstNode.body_of(node))
        this.esd_exit_class_element()
        this.esd_finish_class_element(factory.update_method_declaration(node, result.modifiers, AstNode.asterisk_token_of(node), result.name, null, null, parameters, null, null, body), node)
    }

    procedure esd_visit_get_accessor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        this.esd_enter_class_element(node)
        let result this.esd_partial_transform_class_element(node, esd_class_info, EsdDescriptorGet)
        if result.descriptor_name <> null
        {
            this.esd_exit_class_element()
            return this.esd_finish_class_element(this.esd_create_get_accessor_descriptor_forwarder(result.modifiers, result.name, result.descriptor_name as ref[AstNode]), node)
        }
        let parameters v.visit_nodes(AstNode.parameters_of(node))
        let body v.visit_node(AstNode.body_of(node))
        this.esd_exit_class_element()
        this.esd_finish_class_element(factory.update_get_accessor_declaration(node, result.modifiers, result.name, null, parameters, null, null, body), node)
    }

    procedure esd_visit_set_accessor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        this.esd_enter_class_element(node)
        let result this.esd_partial_transform_class_element(node, esd_class_info, EsdDescriptorSet)
        if result.descriptor_name <> null
        {
            this.esd_exit_class_element()
            return this.esd_finish_class_element(this.esd_create_set_accessor_descriptor_forwarder(result.modifiers, result.name, result.descriptor_name as ref[AstNode]), node)
        }
        let parameters v.visit_nodes(AstNode.parameters_of(node))
        let body v.visit_node(AstNode.body_of(node))
        this.esd_exit_class_element()
        this.esd_finish_class_element(factory.update_set_accessor_declaration(node, result.modifiers, result.name, null, parameters, null, null, body), node)
    }

    procedure esd_visit_class_static_block_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        this.esd_enter_class_element(node)
        var result: ref[AstNode]? null
        if Transformer.is_class_named_evaluation_helper_block(context, node)
        {
            set result: v.visit_each_child(node)
            let assigned_name context.assigned_name(node)
            if (assigned_name <> null) and (result <> node)
                context.set_assigned_name(result as ref[AstNode], assigned_name)
        }
        else
        {
            if Transformer.is_class_this_assignment_block(context, node)
            {
                let saved_class_this esd_class_this
                set this.esd_class_this: null
                set result: v.visit_each_child(node)
                set this.esd_class_this: saved_class_this
            }
            else
            {
                ; a nested variable environment keeps this block's temps scoped to it
                context.start_variable_environment()
                set result: v.visit_each_child(node)
                let var_statements context.end_variable_environment()
                if var_statements.get_length() > 0
                {
                    let block_body Printer.static_block_body_of(result as ref[AstNode]) as ref[AstNode]
                    let new_stmts &Array[ref[AstNode]?]^host()
                    Transformer.add_all(new_stmts, var_statements)
                    Transformer.add_all(new_stmts, AstNode.statements_of(block_body))
                    set result: factory.new_class_static_block_declaration(null, factory.new_block(new_stmts, AstNode.multi_line_of(block_body)))
                }
                if esd_class_info <> null
                {
                    let ci esd_class_info as ref[EsdClassInfo]
                    set ci.has_static_initializers: true
                    if Transformer.list_len(ci.pending_static_initializers) > 0
                    {
                        ; a separate static block for the pending initializers, preceding this one
                        let stmts &Array[ref[AstNode]?]^host()
                        let pending ci.pending_static_initializers as ref[Array[ref[AstNode]?]]
                        var p 0
                        while p < (pending.get_length() as int)
                        {
                            let init_expr pending[p as size_t] as ref[AstNode]
                            set p: p + 1
                            let init_stmt factory.new_expression_statement(init_expr)
                            context.set_source_map_range(init_stmt, context.source_map_range(init_expr))
                            stmts.add(init_stmt)
                        }
                        let static_block factory.new_class_static_block_declaration(null, factory.new_block(stmts, true))
                        set ci.pending_static_initializers: null
                        this.esd_exit_class_element()
                        let pair &Array[ref[AstNode]?]^host()
                        pair.add(static_block)
                        pair.add(result)
                        return this.single_or_many(pair)
                    }
                }
            }
        }
        this.esd_exit_class_element()
        result
    }

    procedure esd_visit_property_declaration(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        var node node_in
        if this.esd_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), AstNode.initializer_of(node)), empty)
        }
        this.esd_enter_class_element(node)
        var descriptor_kind EsdDescriptorNone
        if Transformer.has_accessor_modifier(node)
            set descriptor_kind: EsdDescriptorAccessor
        let result this.esd_partial_transform_class_element(node, esd_class_info, descriptor_kind)
        context.start_variable_environment()
        var initializer v.visit_node(AstNode.initializer_of(node))
        if result.initializers_name <> null
        {
            var this_arg: ref[AstNode]? result.this_arg
            if this_arg = null
                set this_arg: factory.new_this_expression()
            if initializer = null
                set initializer: factory.new_void_zero_expression()
            set initializer: factory.new_run_initializers_helper(this_arg as ref[AstNode], result.initializers_name as ref[AstNode], initializer)
        }
        if Transformer.is_static_member(node) and (esd_class_info <> null) and (initializer <> null)
        {
            ; bound first: `set (x as ref[T]).field` is a silent no-op (root CLAUDE.md)
            let ci esd_class_info as ref[EsdClassInfo]
            set ci.has_static_initializers: true
        }
        let declarations context.end_variable_environment()
        if declarations.get_length() > 0
        {
            let stmts &Array[ref[AstNode]?]^host()
            Transformer.add_all(stmts, declarations)
            stmts.add(factory.new_return_statement(initializer))
            set initializer: factory.new_immediately_invoked_arrow_function(stmts)
        }
        if esd_class_info <> null
        {
            let ci esd_class_info as ref[EsdClassInfo]
            if Transformer.is_static_member(node)
            {
                set initializer: this.esd_inject_pending_initializers(ci, true, initializer)
                if result.extra_initializers_name <> null
                {
                    var this_arg: ref[AstNode]? ci.class_this
                    if this_arg = null
                        set this_arg: factory.new_this_expression()
                    set ci.pending_static_initializers: Transformer.esd_append(host, ci.pending_static_initializers, factory.new_run_initializers_helper(this_arg as ref[AstNode], result.extra_initializers_name as ref[AstNode], null))
                }
            }
            else
            {
                set initializer: this.esd_inject_pending_initializers(ci, false, initializer)
                if result.extra_initializers_name <> null
                    set ci.pending_instance_initializers: Transformer.esd_append(host, ci.pending_instance_initializers, factory.new_run_initializers_helper(factory.new_this_expression(), result.extra_initializers_name as ref[AstNode], null))
            }
        }
        this.esd_exit_class_element()
        if Transformer.has_accessor_modifier(node) and (result.descriptor_name <> null)
        {
            ;  accessor #x = 1;  →  #x_1 = 1; get #x() {...} set #x(value) {...}
            let comment_range context.comment_range(node)
            let source_map_range context.source_map_range(node)
            let prop_name Printer.declaration_name_of(node) as ref[AstNode]
            var getter_name result.name
            var setter_name result.name
            if prop_name.kind = KindComputedPropertyName
            {
                let pn_expression AstNode.expression_of(prop_name) as ref[AstNode]
                if Transformer.is_simple_inlineable_expression(pn_expression) = false
                {
                    let cache_assignment Transformer.find_computed_property_name_cache_assignment(prop_name)
                    if cache_assignment <> null
                    {
                        set getter_name: factory.update_computed_property_name(prop_name, v.visit_node(pn_expression))
                        set setter_name: factory.update_computed_property_name(prop_name, AstNode.binary_left_of(cache_assignment as ref[AstNode]))
                    }
                    else
                    {
                        let temp factory.new_temp_variable()
                        context.set_source_map_range(temp, TextRange.of_node(pn_expression))
                        context.add_variable_declaration(temp)
                        let expression v.visit_node(pn_expression)
                        let assignment factory.new_assignment_expression(temp, expression)
                        context.set_source_map_range(assignment, TextRange.of_node(pn_expression))
                        set getter_name: factory.update_computed_property_name(prop_name, assignment)
                        set setter_name: factory.update_computed_property_name(prop_name, temp)
                    }
                }
            }
            let modifiers_without_accessor this.esd_visitor(EsdSubAccessorStrippingModifier).visit_modifiers(result.modifiers)
            let backing_field Transformer.create_accessor_property_backing_field(factory, node, modifiers_without_accessor, initializer)
            context.set_original(backing_field, node)
            context.set_emit_flags(backing_field, EFNoComments)
            context.set_source_map_range(backing_field, source_map_range)
            context.set_source_map_range(Printer.declaration_name_of(backing_field) as ref[AstNode], context.source_map_range(prop_name))
            let getter this.esd_create_get_accessor_descriptor_forwarder(modifiers_without_accessor, getter_name, result.descriptor_name as ref[AstNode])
            context.set_original(getter, node)
            context.set_comment_range(getter, comment_range)
            context.set_source_map_range(getter, source_map_range)
            let setter this.esd_create_set_accessor_descriptor_forwarder(modifiers_without_accessor, setter_name, result.descriptor_name as ref[AstNode])
            context.set_original(setter, node)
            context.set_emit_flags(setter, EFNoComments)
            context.set_source_map_range(setter, source_map_range)
            let three &Array[ref[AstNode]?]^host()
            three.add(backing_field)
            three.add(getter)
            three.add(setter)
            return this.single_or_many(three)
        }
        this.esd_finish_class_element(factory.update_property_declaration(node, result.modifiers, result.name, null, null, initializer), node)
    }

    procedure esd_visit_this_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if esd_class_this <> null
            return esd_class_this
        node
    }

    procedure esd_visit_call_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let callee AstNode.expression_of(node)
        if Checker.is_super_property(callee) and (esd_class_this <> null)
        {
            let expression v.visit_node(callee) as ref[AstNode]
            let arguments_list v.visit_nodes(AstNode.call_arguments_of(node)) as ref[Array[ref[AstNode]?]]
            let invocation factory.new_function_call_call(expression, esd_class_this as ref[AstNode], arguments_list)
            context.set_original(invocation, node)
            set invocation.pos: node.pos
            set invocation.end: node.end
            return invocation
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_tagged_template_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let tag_node AstNode.tagged_template_tag_of(node)
        if Checker.is_super_property(tag_node) and (esd_class_this <> null)
        {
            let tag_visited v.visit_node(tag_node) as ref[AstNode]
            let bound_tag factory.new_function_bind_call(tag_visited, esd_class_this as ref[AstNode], &Array[ref[AstNode]?]^host())
            context.set_original(bound_tag, node)
            set bound_tag.pos: node.pos
            set bound_tag.end: node.end
            let template v.visit_node(AstNode.tagged_template_template_of(node))
            return factory.update_tagged_template_expression(node, bound_tag, null, null, template, node.flags)
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_property_access_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let name AstNode.property_access_name_of(node)
        if Checker.is_super_property(node) and (AstNode.kind_of(name) = KindIdentifier) and (esd_class_this <> null) and (esd_class_super <> null)
        {
            let property_name factory.new_string_literal_from_node(name as ref[AstNode])
            let super_property factory.new_reflect_get_call(esd_class_super as ref[AstNode], property_name, esd_class_this as ref[AstNode])
            let target AstNode.expression_of(node) as ref[AstNode]
            context.set_original(super_property, target)
            set super_property.pos: target.pos
            set super_property.end: target.end
            return super_property
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_element_access_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if Checker.is_super_property(node) and (esd_class_this <> null) and (esd_class_super <> null)
        {
            let property_name v.visit_node(AstNode.element_access_argument_of(node)) as ref[AstNode]
            let super_property factory.new_reflect_get_call(esd_class_super as ref[AstNode], property_name, esd_class_this as ref[AstNode])
            let target AstNode.expression_of(node) as ref[AstNode]
            context.set_original(super_property, target)
            set super_property.pos: target.pos
            set super_property.end: target.end
            return super_property
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_parameter_declaration(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        var node node_in
        if this.esd_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), AstNode.initializer_of(node)), empty)
        }
        let updated factory.update_parameter_declaration(node, null, AstNode.dot_dot_dot_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        if updated <> node
        {
            context.set_comment_range(updated, TextRange.of_node(node))
            let new_loc Transformer.move_range_past_modifiers(node)
            set updated.pos: new_loc.pos
            set updated.end: new_loc.end
            context.set_source_map_range(updated, new_loc)
            let uname Printer.declaration_name_of(updated)
            if uname <> null
                context.set_emit_flags(uname as ref[AstNode], EFNoTrailingSourceMap)
        }
        updated
    }

    ; isNamedEvaluationAnd(ctx, node, isAnonymousClassNeedingAssignedName)
    function esd_is_named_evaluation_needing_name(this, node: ref[AstNode]) returns bool
    {
        if Transformer.is_named_evaluation_source(node) = false
            return false
        let k node.kind
        var expr: ref[AstNode]? null
        if k = KindShorthandPropertyAssignment
            set expr: AstNode.shorthand_object_assignment_initializer_of(node)
        if (k = KindPropertyAssignment) or (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration)
            set expr: AstNode.initializer_of(node)
        if k = KindBinaryExpression
            set expr: AstNode.binary_right_of(node)
        if k = KindExportAssignment
            set expr: Checker.export_assignment_expression_of(node)
        if Transformer.is_anonymous_function_definition(context, expr) = false
            return false
        let inner Parser.skip_outer_expressions(expr, OEKAll) as ref[AstNode]
        this.esd_is_anonymous_class_needing_assigned_name(inner)
    }

    function esd_is_anonymous_class_needing_assigned_name(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassExpression
            return false
        if Printer.declaration_name_of(node) <> null
            return false
        this.esd_is_decorated_class_like(node)
    }

    ; canIgnoreEmptyStringLiteralInAssignedName
    function esd_can_ignore_empty_string_literal_in_assigned_name(checker: ref[Checker], node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let inner Parser.skip_outer_expressions(node, OEKAll) as ref[AstNode]
        if inner.kind <> KindClassExpression
            return false
        if Printer.declaration_name_of(inner) <> null
            return false
        checker.class_or_constructor_parameter_is_decorated(false, inner) = false
    }

    procedure esd_visit_named_evaluation_site(this, node_in: ref[AstNode], class_expr: ref[AstNode]?) returns ref[AstNode]?
    {
        var node node_in
        if this.esd_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), class_expr), empty)
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let discarded this.esd_visitor(EsdSubDiscarded)
        factory.update_for_statement(node, discarded.visit_node(AstNode.initializer_of(node)), v.visit_node(AstNode.for_condition_of(node)), discarded.visit_node(AstNode.for_incrementor_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), v))
    }

    procedure esd_visit_expression_statement(this, node: ref[AstNode]) returns ref[AstNode]?
        this.esd_visitor(EsdSubDiscarded).visit_each_child(node)

    procedure esd_visit_binary_expression(this, node_in: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        let v this.the_visitor()
        var node node_in
        if Binder.is_destructuring_assignment(node)
        {
            let left this.esd_visit_assignment_pattern(AstNode.binary_left_of(node) as ref[AstNode])
            let right v.visit_node(AstNode.binary_right_of(node))
            return factory.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), right)
        }
        if Emitter.is_assignment_expression(node, false)
        {
            if this.esd_is_named_evaluation_needing_name(node)
            {
                let empty: Slice[char] ""
                set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), AstNode.binary_right_of(node)), empty)
                return v.visit_each_child(node)
            }
            let left AstNode.binary_left_of(node) as ref[AstNode]
            if Checker.is_super_property(left) and (esd_class_this <> null) and (esd_class_super <> null)
            {
                var setter_name: ref[AstNode]? null
                if left.kind = KindElementAccessExpression
                    set setter_name: v.visit_node(AstNode.element_access_argument_of(left))
                if left.kind = KindPropertyAccessExpression
                {
                    let pname AstNode.property_access_name_of(left)
                    if AstNode.kind_of(pname) = KindIdentifier
                        set setter_name: factory.new_string_literal_from_node(pname as ref[AstNode])
                }
                if setter_name <> null
                {
                    var sname setter_name as ref[AstNode]
                    var expression v.visit_node(AstNode.binary_right_of(node)) as ref[AstNode]
                    let op AstNode.kind_of(AstNode.binary_operator_token_of(node))
                    if Parser.is_compound_assignment(op)
                    {
                        var getter_name sname
                        if Transformer.is_simple_inlineable_expression(sname) = false
                        {
                            set getter_name: factory.new_temp_variable()
                            context.add_variable_declaration(getter_name)
                            set sname: factory.new_assignment_expression(getter_name, sname)
                        }
                        let super_property_get factory.new_reflect_get_call(esd_class_super as ref[AstNode], getter_name, esd_class_this as ref[AstNode])
                        context.set_original(super_property_get, left)
                        set super_property_get.pos: left.pos
                        set super_property_get.end: left.end
                        set expression: factory.new_binary_expression(null, super_property_get, null, factory.new_token(Transformer.non_assignment_operator_for_compound_assignment(op)), expression)
                        set expression.pos: node.pos
                        set expression.end: node.end
                    }
                    var temp: ref[AstNode]? null
                    if discarded = false
                    {
                        set temp: factory.new_temp_variable()
                        context.add_variable_declaration(temp as ref[AstNode])
                        set expression: factory.new_assignment_expression(temp, expression)
                        set expression.pos: node.pos
                        set expression.end: node.end
                    }
                    set expression: factory.new_reflect_set_call(esd_class_super as ref[AstNode], sname, expression, esd_class_this as ref[AstNode])
                    context.set_original(expression, node)
                    set expression.pos: node.pos
                    set expression.end: node.end
                    if temp <> null
                    {
                        set expression: factory.new_comma_expression(expression, temp)
                        set expression.pos: node.pos
                        set expression.end: node.end
                    }
                    return expression
                }
            }
        }
        if AstNode.kind_of(AstNode.binary_operator_token_of(node)) = KindCommaToken
        {
            let discarded_v this.esd_visitor(EsdSubDiscarded)
            let left discarded_v.visit_node(AstNode.binary_left_of(node))
            var right: ref[AstNode]? null
            if discarded
                set right: discarded_v.visit_node(AstNode.binary_right_of(node))
            else
                set right: v.visit_node(AstNode.binary_right_of(node))
            return factory.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), right)
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_pre_or_postfix_unary_expression(this, node: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        let v this.the_visitor()
        var operator_kind 0
        var operand_node: ref[AstNode]? null
        if node.kind = KindPrefixUnaryExpression
        {
            set operator_kind: AstNode.prefix_unary_operator_kind(node)
            set operand_node: AstNode.prefix_unary_operand_of(node)
        }
        else
        {
            set operator_kind: AstNode.postfix_unary_operator_of(node)
            set operand_node: AstNode.postfix_unary_operand_of(node)
        }
        if (operator_kind = KindPlusPlusToken) or (operator_kind = KindMinusMinusToken)
        {
            let operand Checker.skip_parentheses(operand_node as ref[AstNode])
            if Checker.is_super_property(operand) and (esd_class_this <> null) and (esd_class_super <> null)
            {
                var setter_name: ref[AstNode]? null
                if operand.kind = KindElementAccessExpression
                    set setter_name: v.visit_node(AstNode.element_access_argument_of(operand))
                if operand.kind = KindPropertyAccessExpression
                {
                    let pname AstNode.property_access_name_of(operand)
                    if AstNode.kind_of(pname) = KindIdentifier
                        set setter_name: factory.new_string_literal_from_node(pname as ref[AstNode])
                }
                if setter_name <> null
                {
                    var sname setter_name as ref[AstNode]
                    var getter_name sname
                    if Transformer.is_simple_inlineable_expression(sname) = false
                    {
                        set getter_name: factory.new_temp_variable()
                        context.add_variable_declaration(getter_name)
                        set sname: factory.new_assignment_expression(getter_name, sname)
                    }
                    var expression factory.new_reflect_get_call(esd_class_super as ref[AstNode], getter_name, esd_class_this as ref[AstNode])
                    context.set_original(expression, node)
                    set expression.pos: node.pos
                    set expression.end: node.end
                    var temp: ref[AstNode]? null
                    if discarded = false
                    {
                        set temp: factory.new_temp_variable()
                        context.add_variable_declaration(temp as ref[AstNode])
                    }
                    set expression: Transformer.expand_pre_or_postfix_increment_or_decrement_expression(factory, context, node, expression, temp)
                    set expression: factory.new_reflect_set_call(esd_class_super as ref[AstNode], sname, expression, esd_class_this as ref[AstNode])
                    context.set_original(expression, node)
                    set expression.pos: node.pos
                    set expression.end: node.end
                    if temp <> null
                    {
                        set expression: factory.new_comma_expression(expression, temp)
                        set expression.pos: node.pos
                        set expression.end: node.end
                    }
                    return expression
                }
            }
        }
        v.visit_each_child(node)
    }

    ; visitReferencedPropertyName: (referencedName, updatedName)
    procedure esd_visit_referenced_property_name(this, node: ref[AstNode], updated_name: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let v this.the_visitor()
        if Checker.is_property_name_literal(node.kind) or (node.kind = KindPrivateIdentifier)
        {
            set updated_name: v.visit_node(node)
            return factory.new_string_literal_from_node(node)
        }
        let cpn_expression AstNode.expression_of(node) as ref[AstNode]
        if Checker.is_property_name_literal(cpn_expression.kind) and (cpn_expression.kind <> KindIdentifier)
        {
            set updated_name: v.visit_node(node)
            return factory.new_string_literal_from_node(cpn_expression)
        }
        let referenced_name factory.new_generated_name_for_node(node)
        context.add_variable_declaration(referenced_name)
        let key factory.new_prop_key_helper(v.visit_node(cpn_expression) as ref[AstNode])
        let assignment factory.new_assignment_expression(referenced_name, key)
        set updated_name: factory.update_computed_property_name(node, this.esd_inject_pending_expressions(assignment))
        referenced_name
    }

    procedure esd_visit_property_name(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if AstNode.kind_of(node) = KindComputedPropertyName
            return this.esd_visit_computed_property_name(node as ref[AstNode])
        this.the_visitor().visit_node(node)
    }

    procedure esd_visit_computed_property_name(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        var expression this.the_visitor().visit_node(AstNode.expression_of(node)) as ref[AstNode]
        if Transformer.is_simple_inlineable_expression(expression) = false
            set expression: this.esd_inject_pending_expressions(expression)
        factory.update_computed_property_name(node, expression)
    }

    procedure esd_visit_destructuring_assignment_target(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if (node.kind = KindObjectLiteralExpression) or (node.kind = KindArrayLiteralExpression)
            return this.esd_visit_assignment_pattern(node)
        if Checker.is_super_property(node) and (esd_class_this <> null) and (esd_class_super <> null)
        {
            var property_name: ref[AstNode]? null
            if node.kind = KindElementAccessExpression
                set property_name: v.visit_node(AstNode.element_access_argument_of(node))
            if node.kind = KindPropertyAccessExpression
            {
                let pname AstNode.property_access_name_of(node)
                if AstNode.kind_of(pname) = KindIdentifier
                    set property_name: factory.new_string_literal_from_node(pname as ref[AstNode])
            }
            if property_name <> null
            {
                let param_name factory.new_temp_variable()
                let expression factory.new_assignment_target_wrapper(param_name, factory.new_reflect_set_call(esd_class_super as ref[AstNode], property_name as ref[AstNode], param_name, esd_class_this as ref[AstNode]))
                context.set_original(expression, node)
                set expression.pos: node.pos
                set expression.end: node.end
                return expression
            }
        }
        v.visit_each_child(node)
    }

    procedure esd_visit_assignment_element(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        var node node_in
        if Emitter.is_assignment_expression(node, true)
        {
            if this.esd_is_named_evaluation_needing_name(node)
            {
                let empty: Slice[char] ""
                set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), AstNode.binary_right_of(node)), empty)
            }
            let assignment_target this.esd_visit_destructuring_assignment_target(AstNode.binary_left_of(node) as ref[AstNode])
            let initializer this.the_visitor().visit_node(AstNode.binary_right_of(node))
            return factory.update_binary_expression(node, null, assignment_target, null, AstNode.binary_operator_token_of(node), initializer)
        }
        this.esd_visit_destructuring_assignment_target(node)
    }

    procedure esd_visit_assignment_rest_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expression AstNode.expression_of(node)
        if Binder.is_left_hand_side_expression(expression)
            return factory.update_spread_element(node, this.esd_visit_destructuring_assignment_target(expression as ref[AstNode]))
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_array_assignment_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindSpreadElement
            return this.esd_visit_assignment_rest_element(node)
        if node.kind <> KindOmittedExpression
            return this.esd_visit_assignment_element(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_assignment_property_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let name v.visit_node(Printer.declaration_name_of(node))
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        if Emitter.is_assignment_expression(initializer, true)
            return factory.update_property_assignment(node, null, name, null, null, this.esd_visit_assignment_element(initializer))
        if Binder.is_left_hand_side_expression(initializer)
            return factory.update_property_assignment(node, null, name, null, null, this.esd_visit_destructuring_assignment_target(initializer))
        v.visit_each_child(node)
    }

    procedure esd_visit_shorthand_assignment_property(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        var node node_in
        if this.esd_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, Transformer.esd_can_ignore_empty_string_literal_in_assigned_name(this.the_checker(), AstNode.shorthand_object_assignment_initializer_of(node)), empty)
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_assignment_rest_property(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expression AstNode.expression_of(node)
        if Binder.is_left_hand_side_expression(expression)
            return factory.update_spread_assignment(node, this.esd_visit_destructuring_assignment_target(expression as ref[AstNode]))
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_object_assignment_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindSpreadAssignment
            return this.esd_visit_assignment_rest_property(node)
        if node.kind = KindShorthandPropertyAssignment
            return this.esd_visit_shorthand_assignment_property(node)
        if node.kind = KindPropertyAssignment
            return this.esd_visit_assignment_property_node(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure esd_visit_assignment_pattern(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindArrayLiteralExpression
        {
            let elements this.esd_visitor(EsdSubArrayAssignment).visit_nodes(AstNode.elements_of(node))
            return factory.update_array_literal_expression(node, elements, AstNode.multi_line_of(node))
        }
        let properties this.esd_visitor(EsdSubObjectAssignment).visit_nodes(Emitter.pattern_elements_of(node))
        factory.update_object_literal_expression(node, properties, AstNode.multi_line_of(node))
    }

    procedure esd_visit_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
        this.esd_visit_named_evaluation_site(node, Checker.export_assignment_expression_of(node))

    procedure esd_visit_parenthesized_expression(this, node: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        var expression: ref[AstNode]? null
        if discarded
            set expression: this.esd_visitor(EsdSubDiscarded).visit_node(AstNode.expression_of(node))
        else
            set expression: this.the_visitor().visit_node(AstNode.expression_of(node))
        factory.update_parenthesized_expression(node, expression)
    }

    procedure esd_visit_partially_emitted_expression(this, node: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        var expression: ref[AstNode]? null
        if discarded
            set expression: this.esd_visitor(EsdSubDiscarded).visit_node(Printer.wrapped_inner_of(node))
        else
            set expression: this.the_visitor().visit_node(Printer.wrapped_inner_of(node))
        factory.update_partially_emitted_expression(node, expression)
    }

    ; prependExpressions: the pending expressions before a target, parentheses kept
    procedure esd_prepend_expressions(this, pending: ref[Array[ref[AstNode]?]]?, expression: ref[AstNode]?) returns ref[AstNode]?
    {
        if Transformer.list_len(pending) = 0
            return expression
        let p pending as ref[Array[ref[AstNode]?]]
        if expression = null
            return factory.inline_expressions(p)
        let e expression as ref[AstNode]
        if e.kind = KindParenthesizedExpression
        {
            let exprs &Array[ref[AstNode]?]^host()
            Transformer.add_all(exprs, p)
            exprs.add(AstNode.expression_of(e))
            return factory.update_parenthesized_expression(e, factory.inline_expressions(exprs))
        }
        let exprs &Array[ref[AstNode]?]^host()
        Transformer.add_all(exprs, p)
        exprs.add(e)
        factory.inline_expressions(exprs)
    }

    procedure esd_inject_pending_expressions(this, expression: ref[AstNode]) returns ref[AstNode]
    {
        let result this.esd_prepend_expressions(esd_pending_expressions, expression) as ref[AstNode]
        if result <> expression
            set this.esd_pending_expressions: null
        result
    }

    procedure esd_inject_pending_initializers(this, ci: ref[EsdClassInfo], is_static: bool, expression: ref[AstNode]?) returns ref[AstNode]?
    {
        var pending: ref[Array[ref[AstNode]?]]? ci.pending_instance_initializers
        if is_static
            set pending: ci.pending_static_initializers
        let result this.esd_prepend_expressions(pending, expression)
        if result <> expression
        {
            if is_static
                set ci.pending_static_initializers: null
            else
                set ci.pending_instance_initializers: null
        }
        result
    }

    ; transformAllDecoratorsOfDeclaration
    procedure esd_transform_all_decorators_of_declaration(this, decorators: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if Transformer.list_len(decorators) = 0
            return null
        let dl decorators as ref[Array[ref[AstNode]?]]
        let result &Array[ref[AstNode]?]^host()
        var i 0
        while i < (dl.get_length() as int)
        {
            let d dl[i as size_t]
            set i: i + 1
            if d <> null
                result.add(this.esd_transform_decorator(d as ref[AstNode]))
        }
        result
    }

    ; transformDecorator: the expression, an access expression bound to its `this`
    procedure esd_transform_decorator(this, decorator: ref[AstNode]) returns ref[AstNode]
    {
        let expression this.the_visitor().visit_node(Printer.wrapped_inner_of(decorator)) as ref[AstNode]
        context.set_emit_flags(expression, EFNoComments)
        let inner Parser.skip_outer_expressions(expression, OEKAll)
        if Parser.is_access_expression(inner)
        {
            var this_arg: ref[AstNode]? null
            let target this.esd_create_call_binding(expression, &this_arg)
            let bind_call factory.new_function_bind_call(target, this_arg as ref[AstNode], &Array[ref[AstNode]?]^host())
            return factory.restore_outer_expressions(expression, bind_call, OEKAll) as ref[AstNode]
        }
        expression
    }

    ; createCallBinding: (target, thisArg)
    procedure esd_create_call_binding(this, expression: ref[AstNode], this_arg: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let callee Parser.skip_outer_expressions(expression, OEKAll) as ref[AstNode]
        if Checker.is_super_property(callee) or (callee.kind = KindSuperKeyword)
        {
            set this_arg: factory.new_this_expression()
            return callee
        }
        if (context.emit_flags(callee) & EFHelperName) <> 0
        {
            set this_arg: factory.new_void_zero_expression()
            return callee
        }
        if callee.kind = KindPropertyAccessExpression
        {
            let object AstNode.expression_of(callee) as ref[AstNode]
            if Transformer.esd_should_be_captured_in_temp_variable(object)
            {
                let temp factory.new_temp_variable()
                context.add_variable_declaration(temp)
                let assign factory.new_assignment_expression(temp, object)
                set assign.pos: object.pos
                set assign.end: object.end
                let target factory.new_property_access_expression(assign, null, AstNode.property_access_name_of(callee), NodeFlagsNone)
                set target.pos: callee.pos
                set target.end: callee.end
                set this_arg: temp
                return target
            }
            set this_arg: object
            return callee
        }
        if callee.kind = KindElementAccessExpression
        {
            let object AstNode.expression_of(callee) as ref[AstNode]
            if Transformer.esd_should_be_captured_in_temp_variable(object)
            {
                let temp factory.new_temp_variable()
                context.add_variable_declaration(temp)
                let assign factory.new_assignment_expression(temp, object)
                set assign.pos: object.pos
                set assign.end: object.end
                let target factory.new_element_access_expression(assign, null, AstNode.element_access_argument_of(callee), NodeFlagsNone)
                set target.pos: callee.pos
                set target.end: callee.end
                set this_arg: temp
                return target
            }
            set this_arg: object
            return callee
        }
        set this_arg: factory.new_void_zero_expression()
        expression
    }

    function esd_should_be_captured_in_temp_variable(node: ref[AstNode]) returns bool
    {
        let target Checker.skip_parentheses(node)
        let k target.kind
        if k = KindIdentifier
            return true
        if (k = KindThisKeyword) or (k = KindNumericLiteral) or (k = KindBigIntLiteral) or (k = KindStringLiteral)
            return false
        true
    }

    ; createDescriptorMethod: a "value", "get" or "set" method of a pseudo-PropertyDescriptor
    procedure esd_create_descriptor_method(this, original: ref[AstNode], name: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, asterisk_token: ref[AstNode]?, kind: Slice[char], parameters: ref[Array[ref[AstNode]?]]?, body_in: ref[AstNode]?) returns ref[AstNode]
    {
        var body body_in
        if body = null
            set body: factory.new_block(&Array[ref[AstNode]?]^host(), false)
        let func_expr factory.new_function_expression(modifiers, asterisk_token, null, null, parameters, null, null, body)
        context.set_original(func_expr, original)
        context.set_source_map_range(func_expr, Transformer.move_range_past_decorators(original))
        context.set_emit_flags(func_expr, EFNoComments)
        var prefix: Slice[char] ""
        let get_text: Slice[char] "get"
        let set_text: Slice[char] "set"
        if kind.equals(get_text) or kind.equals(set_text)
            set prefix: kind
        let function_name factory.new_string_literal_from_node(name)
        let named_function factory.new_set_function_name_helper(func_expr, function_name, prefix)
        let method factory.new_property_assignment(null, factory.new_identifier(kind), null, null, named_function)
        context.set_original(method, original)
        context.set_source_map_range(method, Transformer.move_range_past_decorators(original))
        context.set_emit_flags(method, EFNoComments)
        method
    }

    ; the four createDescriptor callbacks by kind
    procedure esd_create_descriptor(this, member: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, kind: int) returns ref[AstNode]
    {
        let v this.the_visitor()
        let name Printer.declaration_name_of(member) as ref[AstNode]
        let props &Array[ref[AstNode]?]^host()
        if kind = EsdDescriptorMethod
        {
            let value_text: Slice[char] "value"
            props.add(this.esd_create_descriptor_method(member, name, modifiers, AstNode.asterisk_token_of(member), value_text, v.visit_nodes(AstNode.parameters_of(member)), v.visit_node(AstNode.body_of(member))))
            return factory.new_object_literal_expression(props, false)
        }
        if kind = EsdDescriptorGet
        {
            let get_text: Slice[char] "get"
            props.add(this.esd_create_descriptor_method(member, name, modifiers, null, get_text, &Array[ref[AstNode]?]^host(), v.visit_node(AstNode.body_of(member))))
            return factory.new_object_literal_expression(props, false)
        }
        if kind = EsdDescriptorSet
        {
            let set_text: Slice[char] "set"
            props.add(this.esd_create_descriptor_method(member, name, modifiers, null, set_text, v.visit_nodes(AstNode.parameters_of(member)), v.visit_node(AstNode.body_of(member))))
            return factory.new_object_literal_expression(props, false)
        }
        ; the auto-accessor: get/set over the generated backing field
        let empty: Slice[char] ""
        let storage_suffix: Slice[char] "_accessor_storage"
        let backing_field_name factory.new_generated_private_name_for_node_ex(name, 0, empty, storage_suffix)
        let value_text: Slice[char] "value"
        let get_text: Slice[char] "get"
        let set_text: Slice[char] "set"
        let get_body_statements &Array[ref[AstNode]?]^host()
        get_body_statements.add(factory.new_return_statement(factory.new_property_access_expression(factory.new_this_expression(), null, backing_field_name, NodeFlagsNone)))
        props.add(this.esd_create_descriptor_method(member, name, null, null, get_text, &Array[ref[AstNode]?]^host(), factory.new_block(get_body_statements, false)))
        let set_params &Array[ref[AstNode]?]^host()
        set_params.add(factory.new_parameter_declaration(null, null, factory.new_identifier(value_text), null, null, null))
        let set_body_statements &Array[ref[AstNode]?]^host()
        set_body_statements.add(factory.new_expression_statement(factory.new_assignment_expression(factory.new_property_access_expression(factory.new_this_expression(), null, backing_field_name, NodeFlagsNone), factory.new_identifier(value_text))))
        props.add(this.esd_create_descriptor_method(member, name, null, null, set_text, set_params, factory.new_block(set_body_statements, false)))
        factory.new_object_literal_expression(props, false)
    }

    ; a MethodDeclaration forwarding to its descriptor: `get name() { return _desc.value; }`
    procedure esd_create_method_descriptor_forwarder(this, modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, descriptor_name: ref[AstNode]) returns ref[AstNode]
    {
        let static_only this.esd_visitor(EsdSubStaticOnlyModifier).visit_modifiers(modifiers)
        let value_text: Slice[char] "value"
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_return_statement(factory.new_property_access_expression(descriptor_name, null, factory.new_identifier(value_text), NodeFlagsNone)))
        factory.new_get_accessor_declaration(static_only, name, null, &Array[ref[AstNode]?]^host(), null, null, factory.new_block(statements, false))
    }

    ; `get name() { return _desc.get.call(this); }`
    procedure esd_create_get_accessor_descriptor_forwarder(this, modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, descriptor_name: ref[AstNode]) returns ref[AstNode]
    {
        let static_only this.esd_visitor(EsdSubStaticOnlyModifier).visit_modifiers(modifiers)
        let get_text: Slice[char] "get"
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_return_statement(factory.new_function_call_call(factory.new_property_access_expression(descriptor_name, null, factory.new_identifier(get_text), NodeFlagsNone), factory.new_this_expression(), &Array[ref[AstNode]?]^host())))
        factory.new_get_accessor_declaration(static_only, name, null, &Array[ref[AstNode]?]^host(), null, null, factory.new_block(statements, false))
    }

    ; `set name(value) { return _desc.set.call(this, value); }`
    procedure esd_create_set_accessor_descriptor_forwarder(this, modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, descriptor_name: ref[AstNode]) returns ref[AstNode]
    {
        let static_only this.esd_visitor(EsdSubStaticOnlyModifier).visit_modifiers(modifiers)
        let set_text: Slice[char] "set"
        let value_text: Slice[char] "value"
        let params &Array[ref[AstNode]?]^host()
        params.add(factory.new_parameter_declaration(null, null, factory.new_identifier(value_text), null, null, null))
        let args &Array[ref[AstNode]?]^host()
        args.add(factory.new_identifier(value_text))
        let statements &Array[ref[AstNode]?]^host()
        statements.add(factory.new_return_statement(factory.new_function_call_call(factory.new_property_access_expression(descriptor_name, null, factory.new_identifier(set_text), NodeFlagsNone), factory.new_this_expression(), args)))
        factory.new_set_accessor_declaration(static_only, name, null, params, null, null, factory.new_block(statements, false))
    }

    ; createMetadata: `const _metadata = typeof Symbol === "function" && Symbol.metadata ? Object.create(<super>) : void 0;`
    procedure esd_create_metadata(this, name: ref[AstNode], class_super: ref[AstNode]?) returns ref[AstNode]
    {
        var super_metadata: ref[AstNode]? null
        if class_super <> null
            set super_metadata: this.esd_create_symbol_metadata_reference(class_super as ref[AstNode])
        else
            set super_metadata: factory.new_token(KindNullKeyword)
        let object_text: Slice[char] "Object"
        let create_text: Slice[char] "create"
        let symbol_text: Slice[char] "Symbol"
        let metadata_text: Slice[char] "metadata"
        let function_text: Slice[char] "function"
        let args &Array[ref[AstNode]?]^host()
        args.add(super_metadata)
        let object_create factory.new_call_expression(factory.new_property_access_expression(factory.new_identifier(object_text), null, factory.new_identifier(create_text), NodeFlagsNone), null, null, args, NodeFlagsNone)
        let symbol_check factory.new_logical_and_expression(factory.new_type_check(factory.new_identifier(symbol_text), function_text), factory.new_property_access_expression(factory.new_identifier(symbol_text), null, factory.new_identifier(metadata_text), NodeFlagsNone))
        let conditional factory.new_conditional_expression(symbol_check, factory.new_token(KindQuestionToken), object_create, factory.new_token(KindColonToken), factory.new_void_zero_expression())
        let decls &Array[ref[AstNode]?]^host()
        decls.add(factory.new_variable_declaration(name, null, null, conditional))
        factory.new_variable_statement(null, factory.new_variable_declaration_list(decls, NodeFlagsConst))
    }

    ; createSymbolMetadata: `if (metadata) Object.defineProperty(target, Symbol.metadata, {...});`
    procedure esd_create_symbol_metadata(this, target: ref[AstNode], value: ref[AstNode]) returns ref[AstNode]
    {
        let object_text: Slice[char] "Object"
        let define_text: Slice[char] "defineProperty"
        let symbol_text: Slice[char] "Symbol"
        let metadata_text: Slice[char] "metadata"
        let enumerable_text: Slice[char] "enumerable"
        let configurable_text: Slice[char] "configurable"
        let writable_text: Slice[char] "writable"
        let value_text: Slice[char] "value"
        let symbol_metadata factory.new_property_access_expression(factory.new_identifier(symbol_text), null, factory.new_identifier(metadata_text), NodeFlagsNone)
        let props &Array[ref[AstNode]?]^host()
        props.add(factory.new_property_assignment(null, factory.new_identifier(enumerable_text), null, null, factory.new_true_expression()))
        props.add(factory.new_property_assignment(null, factory.new_identifier(configurable_text), null, null, factory.new_true_expression()))
        props.add(factory.new_property_assignment(null, factory.new_identifier(writable_text), null, null, factory.new_true_expression()))
        props.add(factory.new_property_assignment(null, factory.new_identifier(value_text), null, null, value))
        let descriptor factory.new_object_literal_expression(props, false)
        let args &Array[ref[AstNode]?]^host()
        args.add(target)
        args.add(symbol_metadata)
        args.add(descriptor)
        let define_property factory.new_call_expression(factory.new_property_access_expression(factory.new_identifier(object_text), null, factory.new_identifier(define_text), NodeFlagsNone), null, null, args, NodeFlagsNone)
        let if_statement factory.new_if_statement(value, factory.new_expression_statement(define_property), null)
        context.set_emit_flags(if_statement, EFSingleLine)
        if_statement
    }

    procedure esd_create_symbol_metadata_reference(this, class_super: ref[AstNode]) returns ref[AstNode]
    {
        let symbol_text: Slice[char] "Symbol"
        let metadata_text: Slice[char] "metadata"
        let symbol_metadata factory.new_property_access_expression(factory.new_identifier(symbol_text), null, factory.new_identifier(metadata_text), NodeFlagsNone)
        let element_access factory.new_element_access_expression(class_super, null, symbol_metadata, NodeFlagsNone)
        factory.new_binary_expression(null, element_access, null, factory.new_token(KindQuestionQuestionToken), factory.new_token(KindNullKeyword))
    }

    ; injectClassThisAssignmentIfMissing: `static { _classThis = this; }` first
    procedure esd_inject_class_this_assignment_if_missing(this, node: ref[AstNode], class_this: ref[AstNode]) returns ref[AstNode]
    {
        if Transformer.class_has_class_this_assignment(context, node)
            return node
        let expression factory.new_assignment_expression(class_this, factory.new_this_expression())
        let statement factory.new_expression_statement(expression)
        let body_statements &Array[ref[AstNode]?]^host()
        body_statements.add(statement)
        let static_block factory.new_class_static_block_declaration(null, factory.new_block(body_statements, false))
        context.set_class_this(static_block, class_this)
        let name Printer.declaration_name_of(node)
        if name <> null
            context.set_source_map_range(statement, TextRange.of_node(name as ref[AstNode]))
        let new_members &Array[ref[AstNode]?]^host()
        new_members.add(static_block)
        let members Printer.member_list_of(node)
        Transformer.add_all(new_members, members)
        var mp 0 - 1
        var me 0 - 1
        AstNode.list_range_of(current_source_file, members, &mp, &me)
        factory.set_list_range(new_members, mp, me)
        var updated: ref[AstNode]? null
        if node.kind = KindClassDeclaration
            set updated: factory.update_class_declaration(node, Printer.modifier_list_of(node), name, null, AstNode.heritage_clauses_of(node), new_members)
        else
            set updated: factory.update_class_expression(node, Printer.modifier_list_of(node), name, null, AstNode.heritage_clauses_of(node), new_members)
        let u updated as ref[AstNode]
        context.set_class_this(u, class_this)
        u
    }

    function class_has_class_this_assignment(ctx: ref[EmitContext], node: ref[AstNode]) returns bool
    {
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if m <> null
            {
                if Transformer.is_class_this_assignment_block(ctx, m as ref[AstNode])
                    return true
            }
        }
        false
    }

    ; ── transformers/utilities.go and ast utilities the transform asks ──

    ; MoveRangePastModifiers
    function move_range_past_modifiers(node: ref[AstNode]) returns TextRange
    {
        if (node.kind = KindPropertyDeclaration) or (node.kind = KindMethodDeclaration)
        {
            let name Printer.declaration_name_of(node)
            if name <> null
                return TextRange((name as ref[AstNode]).pos, node.end)
        }
        let modifiers Printer.modifier_list_of(node)
        if modifiers <> null
        {
            let ml modifiers as ref[Array[ref[AstNode]?]]
            if ml.get_length() > 0
            {
                let last ml[(ml.get_length() - 1) as size_t]
                if last <> null
                {
                    let l last as ref[AstNode]
                    if l.end >= 0
                        return TextRange(l.end, node.end)
                }
            }
        }
        Transformer.move_range_past_decorators(node)
    }

    ; MoveRangePastDecorators
    function move_range_past_decorators(node: ref[AstNode]) returns TextRange
    {
        let modifiers Printer.modifier_list_of(node)
        var last_decorator: ref[AstNode]? null
        if modifiers <> null
        {
            let ml modifiers as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (ml.get_length() as int)
            {
                let m ml[i as size_t]
                set i: i + 1
                if AstNode.kind_of(m) = KindDecorator
                    set last_decorator: m
            }
        }
        if last_decorator <> null
        {
            let ld last_decorator as ref[AstNode]
            if ld.end >= 0
                return TextRange(ld.end, node.end)
        }
        TextRange.of_node(node)
    }

    ; GetNonAssignmentOperatorForCompoundAssignment
    function non_assignment_operator_for_compound_assignment(kind: int) returns int
    {
        if kind = KindPlusEqualsToken
            return KindPlusToken
        if kind = KindMinusEqualsToken
            return KindMinusToken
        if kind = KindAsteriskEqualsToken
            return KindAsteriskToken
        if kind = KindAsteriskAsteriskEqualsToken
            return KindAsteriskAsteriskToken
        if kind = KindSlashEqualsToken
            return KindSlashToken
        if kind = KindPercentEqualsToken
            return KindPercentToken
        if kind = KindLessThanLessThanEqualsToken
            return KindLessThanLessThanToken
        if kind = KindGreaterThanGreaterThanEqualsToken
            return KindGreaterThanGreaterThanToken
        if kind = KindGreaterThanGreaterThanGreaterThanEqualsToken
            return KindGreaterThanGreaterThanGreaterThanToken
        if kind = KindAmpersandEqualsToken
            return KindAmpersandToken
        if kind = KindBarEqualsToken
            return KindBarToken
        if kind = KindCaretEqualsToken
            return KindCaretToken
        if kind = KindBarBarEqualsToken
            return KindBarBarToken
        if kind = KindAmpersandAmpersandEqualsToken
            return KindAmpersandAmpersandToken
        if kind = KindQuestionQuestionEqualsToken
            return KindQuestionQuestionToken
        kind
    }

    ; classfields.go findComputedPropertyNameCacheAssignment: the `_a = expr`
    ; a computed name's expression may already carry
    function find_computed_property_name_cache_assignment(name: ref[AstNode]) returns ref[AstNode]?
    {
        var node: ref[AstNode]? AstNode.expression_of(name)
        while node <> null
        {
            let n Parser.skip_outer_expressions(node, 0) as ref[AstNode]
            if (n.kind = KindBinaryExpression) and (AstNode.kind_of(AstNode.binary_operator_token_of(n)) = KindCommaToken)
            {
                set node: AstNode.binary_right_of(n)
                continue
            }
            if Emitter.is_assignment_expression(n, true) and (AstNode.kind_of(AstNode.binary_left_of(n)) = KindIdentifier)
                return n
            break
        }
        null
    }

    ; estransforms/utilities.go createAccessorPropertyBackingField
    function create_accessor_property_backing_field(f: ref[NodeFactory], node: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, initializer: ref[AstNode]?) returns ref[AstNode]
    {
        let empty: Slice[char] ""
        let storage_suffix: Slice[char] "_accessor_storage"
        f.update_property_declaration(node, modifiers, f.new_generated_private_name_for_node_ex(Printer.declaration_name_of(node) as ref[AstNode], 0, empty, storage_suffix), null, null, initializer)
    }

    ; classfields.go expandPreOrPostfixIncrementOrDecrementExpression
    function expand_pre_or_postfix_increment_or_decrement_expression(f: ref[NodeFactory], ctx: ref[EmitContext], node: ref[AstNode], expression_in: ref[AstNode], result_variable: ref[AstNode]?) returns ref[AstNode]
    {
        var operator_kind 0
        var operand: ref[AstNode]? null
        if node.kind = KindPrefixUnaryExpression
        {
            set operator_kind: AstNode.prefix_unary_operator_kind(node)
            set operand: AstNode.prefix_unary_operand_of(node)
        }
        else
        {
            set operator_kind: AstNode.postfix_unary_operator_of(node)
            set operand: AstNode.postfix_unary_operand_of(node)
        }
        let o operand as ref[AstNode]
        let temp f.new_temp_variable()
        ctx.add_variable_declaration(temp)
        var expression f.new_assignment_expression(temp, expression_in)
        set expression.pos: o.pos
        set expression.end: o.end
        var operation: ref[AstNode]? null
        if node.kind = KindPrefixUnaryExpression
            set operation: f.new_prefix_unary_expression(operator_kind, temp)
        else
            set operation: f.new_postfix_unary_expression(temp, operator_kind)
        var op operation as ref[AstNode]
        set op.pos: node.pos
        set op.end: node.end
        if result_variable <> null
        {
            set op: f.new_assignment_expression(result_variable, op)
            set op.pos: node.pos
            set op.end: node.end
        }
        set expression: f.new_comma_expression(expression, op)
        set expression.pos: node.pos
        set expression.end: node.end
        if node.kind = KindPostfixUnaryExpression
        {
            set expression: f.new_comma_expression(expression, temp)
            set expression.pos: node.pos
            set expression.end: node.end
        }
        expression
    }

    function has_static_modifier(node: ref[AstNode]) returns bool
        (Transformer.modifier_flags_of(node) & ModifierFlagsStatic) <> 0

    function has_accessor_modifier(node: ref[AstNode]) returns bool
        (Transformer.modifier_flags_of(node) & ModifierFlagsAccessor) <> 0

    ; ast.IsStatic: a static class element, or a static block
    function is_static_member(node: ref[AstNode]) returns bool
    {
        if node.kind = KindClassStaticBlockDeclaration
            return true
        Transformer.has_static_modifier(node)
    }

    ; ast.IsAutoAccessorPropertyDeclaration
    function is_auto_accessor_property_declaration(node: ref[AstNode]) returns bool
    {
        if node.kind <> KindPropertyDeclaration
            return false
        Transformer.has_accessor_modifier(node)
    }

    ; ast.GetFirstConstructorWithBody
    function get_first_constructor_with_body(node: ref[AstNode]) returns ref[AstNode]?
    {
        let members Printer.member_list_of(node)
        if members = null
            return null
        let ml members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ml.get_length() as int)
        {
            let m ml[i as size_t]
            set i: i + 1
            if AstNode.kind_of(m) = KindConstructor
            {
                let body AstNode.body_of(m as ref[AstNode])
                if body <> null
                {
                    if Parser.node_is_missing(body) = false
                        return m
                }
            }
        }
        null
    }

    ; transformers.IsSimpleCopiableExpression / IsSimpleInlineableExpression
    function is_simple_copiable_expression(expression: ref[AstNode]) returns bool
    {
        let k expression.kind
        if (k = KindStringLiteral) or (k = KindNoSubstitutionTemplateLiteral) or (k = KindNumericLiteral) or (k = KindIdentifier)
            return true
        Printer.is_keyword_kind(k)
    }

    function is_simple_inlineable_expression(expression: ref[AstNode]) returns bool
    {
        if expression.kind = KindIdentifier
            return false
        Transformer.is_simple_copiable_expression(expression)
    }

    ; ── the AST questions the transformers ask (ast/utilities.go) ──

    ; GetSyntacticModifierFlags over the COMPLETE modifier list (§3.5jh)
    function modifier_flags_of(n: ref[AstNode]?) returns int
    {
        let mods Printer.modifier_list_of(n)
        if mods = null
            return ModifierFlagsNone
        let list mods as ref[Array[ref[AstNode]?]]
        var flags ModifierFlagsNone
        var i 0
        while i < (list.get_length() as int)
        {
            set flags: flags | AstNode.modifier_to_flag(AstNode.kind_of(list[i as size_t]))
            set i: i + 1
        }
        flags
    }

    function has_syntactic_modifier(n: ref[AstNode]?, flag: int) returns bool
        (Transformer.modifier_flags_of(n) & flag) <> 0

    function has_decorators(n: ref[AstNode]?) returns bool
        (Transformer.modifier_flags_of(n) & ModifierFlagsDecorator) <> 0

    ; Node.Decorators(): the decorators of the modifier list, in order
    function decorators_of(host: ref[Page], n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        let mods Printer.modifier_list_of(n)
        if mods = null
            return out
        let list mods as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (list.get_length() as int)
        {
            let m list[i as size_t]
            if AstNode.is_decorator(m)
                out.add(m)
            set i: i + 1
        }
        out
    }

    ; IsParameterPropertyDeclaration(node, parent)
    function is_parameter_property_declaration(n: ref[AstNode], parent: ref[AstNode]?) returns bool
    {
        if n.kind <> KindParameter
            return false
        if parent = null
            return false
        if (parent as ref[AstNode]).kind <> KindConstructor
            return false
        Transformer.has_syntactic_modifier(n, ModifierFlagsParameterPropertyModifier)
    }

    function get_innermost_module_declaration_from_dotted_module(n: ref[AstNode]) returns ref[AstNode]
    {
        var m n
        while true
        {
            let body Printer.module_body_of(m)
            if body = null
                return m
            let b body as ref[AstNode]
            if b.kind <> KindModuleDeclaration
                return m
            set m: b
        }
        m
    }

    function is_assertion_expression(n: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(n)
        (k = KindTypeAssertionExpression) or (k = KindAsExpression)
    }

    ; SingleOrMany
    procedure single_or_many(this, nodes: ref[Array[ref[AstNode]?]]) returns ref[AstNode]?
    {
        let n nodes.get_length() as int
        if n = 0
            return null
        if n = 1
            return nodes[0]
        factory.new_syntax_list(nodes)
    }

    ; SplitStandardPrologue / SplitCustomPrologue: the index where the prologue ends
    function standard_prologue_end(statements: ref[Array[ref[AstNode]?]]) returns int
    {
        var i 0
        while i < (statements.get_length() as int)
        {
            if EmitContext.is_prologue_directive(statements[i as size_t]) = false
                return i
            set i: i + 1
        }
        i
    }

    function custom_prologue_end(this, statements: ref[Array[ref[AstNode]?]], from: int) returns int
    {
        var i from
        while i < (statements.get_length() as int)
        {
            if context.is_custom_prologue(statements[i as size_t]) = false
                return i
            set i: i + 1
        }
        i
    }

    ; ═══ tstransforms/typeeraser.go ═══

    procedure push_node(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent parent_node
        set this.parent_node: current_node
        set this.current_node: node
        grandparent
    }

    procedure pop_node(this, grandparent: ref[AstNode]?)
    {
        set this.current_node: parent_node
        set this.parent_node: grandparent
    }

    procedure elide(this, node: ref[AstNode]) returns ref[AstNode]?
        context.new_not_emitted_statement(node)

    procedure visit_type_eraser(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        ; a subtree without TypeScript facts is left UNTOUCHED — which is why a
        ; bodiless overload prints as `f() { }` and a `static constructor` keeps
        ; its modifier (§3.5ji 6)
        if (Emitter.subtree_facts(node) & SubtreeContainsTypeScript) = 0
            return node
        if Checker.is_statement(node) and Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient)
            return this.elide(node)
        let grandparent this.push_node(node)
        let result this.visit_type_eraser_worker(node)
        this.pop_node(grandparent)
        result
    }

    procedure visit_type_eraser_worker(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let k node.kind
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindAbstractKeyword) or (k = KindOverrideKeyword) or (k = KindConstKeyword) or (k = KindDeclareKeyword) or (k = KindReadonlyKeyword) or (k = KindArrayType) or (k = KindTupleType) or (k = KindOptionalType) or (k = KindRestType) or (k = KindTypeLiteral) or (k = KindTypePredicate) or (k = KindTypeParameter) or (k = KindAnyKeyword) or (k = KindUnknownKeyword) or (k = KindBooleanKeyword) or (k = KindStringKeyword) or (k = KindNumberKeyword) or (k = KindNeverKeyword) or (k = KindVoidKeyword) or (k = KindSymbolKeyword) or (k = KindConstructorType) or (k = KindFunctionType) or (k = KindTypeQuery) or (k = KindTypeReference) or (k = KindUnionType) or (k = KindIntersectionType) or (k = KindConditionalType) or (k = KindParenthesizedType) or (k = KindThisType) or (k = KindTypeOperator) or (k = KindIndexedAccessType) or (k = KindMappedType) or (k = KindLiteralType) or (k = KindIndexSignature) or (k = KindImportType)
            return null
        if (k = KindInKeyword) or (k = KindOutKeyword)
        {
            if parent_node = null
                return null
            if (parent_node as ref[AstNode]).kind <> KindBinaryExpression
                return null
            return v.visit_each_child(node)
        }
        if k = KindJSImportDeclaration
            return null
        if (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindInterfaceDeclaration)
            return this.elide(node)
        if k = KindNamespaceExportDeclaration
            return null
        if k = KindModuleDeclaration
        {
            let name Printer.declaration_name_of(node)
            var keep AstNode.kind_of(name) = KindIdentifier
            if keep
            {
                if this.the_checker().is_instantiated_module(node) = false
                    set keep: false
            }
            if keep
            {
                if Printer.module_body_of(Transformer.get_innermost_module_declaration_from_dotted_module(node)) = null
                    set keep: false
            }
            if keep = false
                return this.elide(node)
            return v.visit_each_child(node)
        }
        if k = KindExpressionWithTypeArguments
            return factory.update_expression_with_type_arguments(node, v.visit_node(AstNode.expression_of(node)), null)
        if k = KindPropertyDeclaration
        {
            if (opts.options.experimental_decorators = TristateTrue) and Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient | ModifierFlagsAbstract) and Transformer.has_decorators(node)
                return factory.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
            if Transformer.has_syntactic_modifier(node, ModifierFlagsAmbient | ModifierFlagsAbstract)
                return null
            return factory.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        }
        if k = KindConstructor
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return null
            return factory.update_constructor_declaration(node, null, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if k = KindMethodDeclaration
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return null
            return factory.update_method_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            if Parser.node_is_missing(AstNode.body_of(node)) and Transformer.has_syntactic_modifier(node, ModifierFlagsAbstract)
                return null
            var body v.visit_node(AstNode.body_of(node))
            if body = null
                set body: factory.new_block(&Array[ref[AstNode]?]^host(), false)
            if k = KindGetAccessor
                return factory.update_get_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, body)
            return factory.update_set_accessor_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, body)
        }
        if k = KindVariableDeclaration
        {
            let updated factory.update_variable_declaration(node, v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
            let type_node AstNode.type_of(node)
            if type_node <> null
                context.set_type_node(Printer.declaration_name_of(updated) as ref[AstNode], type_node)
            return updated
        }
        if k = KindHeritageClause
        {
            let token AstNode.heritage_clause_token_of(node)
            if token = KindImplementsKeyword
                return null
            return factory.update_heritage_clause(node, token, v.visit_nodes(AstNode.heritage_clause_types_of(node)))
        }
        if k = KindClassDeclaration
            return factory.update_class_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
        if k = KindClassExpression
            return factory.update_class_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node)))
        if k = KindFunctionDeclaration
        {
            if Parser.node_is_missing(AstNode.body_of(node))
                return this.elide(node)
            return factory.update_function_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        }
        if k = KindFunctionExpression
            return factory.update_function_expression(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.asterisk_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
        if k = KindArrowFunction
            return factory.update_arrow_function(node, v.visit_modifiers(Printer.modifier_list_of(node)), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, AstNode.equals_greater_than_token_of(node), v.visit_node(AstNode.body_of(node)))
        if k = KindParameter
        {
            if AstNode.is_this_parameter(node)
                return null
            var modifiers: ref[Array[ref[AstNode]?]]? null
            if Transformer.is_parameter_property_declaration(node, parent_node)
                set modifiers: Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsParameterPropertyModifier)
            if Transformer.has_decorators(node)
            {
                var changed false
                let visited v.visit_slice(Transformer.decorators_of(host, node), &changed)
                if modifiers = null
                    set modifiers: visited
                else
                {
                    let merged &Array[ref[AstNode]?]^host()
                    let ms modifiers as ref[Array[ref[AstNode]?]]
                    var i 0
                    while i < (ms.get_length() as int)
                    {
                        merged.add(ms[i as size_t])
                        set i: i + 1
                    }
                    set i: 0
                    while i < (visited.get_length() as int)
                    {
                        merged.add(visited[i as size_t])
                        set i: i + 1
                    }
                    set modifiers: merged
                }
            }
            return factory.update_parameter_declaration(node, modifiers, AstNode.dot_dot_dot_token_of(node), v.visit_node(Printer.declaration_name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
        }
        if k = KindCallExpression
            return factory.update_call_expression(node, v.visit_node(AstNode.expression_of(node)), AstNode.question_dot_token_of(node), null, v.visit_nodes(AstNode.call_arguments_of(node)), node.flags)
        if k = KindNewExpression
            return factory.update_new_expression(node, v.visit_node(AstNode.expression_of(node)), null, v.visit_nodes(AstNode.call_arguments_of(node)))
        if k = KindTaggedTemplateExpression
            return factory.update_tagged_template_expression(node, v.visit_node(AstNode.tagged_template_tag_of(node)), AstNode.question_dot_token_of(node), null, v.visit_node(AstNode.tagged_template_template_of(node)), node.flags)
        if (k = KindNonNullExpression) or (k = KindTypeAssertionExpression) or (k = KindAsExpression) or (k = KindSatisfiesExpression)
        {
            let partial factory.new_partially_emitted_expression(v.visit_node(AstNode.expression_of(node)))
            context.set_original(partial, node)
            set partial.pos: node.pos
            set partial.end: node.end
            return partial
        }
        if k = KindParenthesizedExpression
        {
            if Checker.is_jsdoc_type_assertion(node) = false
            {
                let inner AstNode.expression_of(node)
                let expression Parser.skip_outer_expressions(inner, OEKAllExceptAssertionsOrExpressionsWithTypeArguments)
                if Transformer.is_assertion_expression(expression) or (AstNode.kind_of(expression) = KindSatisfiesExpression)
                {
                    let partial factory.new_partially_emitted_expression(v.visit_node(inner))
                    context.set_original(partial, node)
                    set partial.pos: node.pos
                    set partial.end: node.end
                    return partial
                }
            }
            return v.visit_each_child(node)
        }
        if k = KindJsxSelfClosingElement
            return factory.update_jsx_self_closing_element(node, v.visit_node(AstNode.jsx_tag_name_of(node)), null, v.visit_node(AstNode.jsx_attributes_of(node)))
        if k = KindJsxOpeningElement
            return factory.update_jsx_opening_element(node, v.visit_node(AstNode.jsx_tag_name_of(node)), null, v.visit_node(AstNode.jsx_attributes_of(node)))
        if k = KindImportEqualsDeclaration
        {
            if AstNode.is_type_only_of(node)
                return null
            return v.visit_each_child(node)
        }
        if k = KindImportDeclaration
        {
            let import_clause AstNode.import_clause_of(node)
            if import_clause = null
                return node
            let visited_clause v.visit_node(import_clause)
            if visited_clause = null
                return null
            return factory.update_import_declaration(node, Printer.modifier_list_of(node), visited_clause, AstNode.module_specifier_of(node), AstNode.import_attributes_of(node))
        }
        if k = KindImportClause
        {
            if AstNode.is_type_only_of(node)
                return null
            let name Printer.declaration_name_of(node)
            let named_bindings v.visit_node(AstNode.named_bindings_of(node))
            if (name = null) and (named_bindings = null)
                return null
            return factory.update_import_clause(node, AstNode.import_clause_phase_modifier_of(node), name, named_bindings)
        }
        if k = KindNamedImports
        {
            let elements AstNode.elements_of(node)
            if Transformer.list_is_empty(elements)
                return node
            let visited v.visit_nodes(elements)
            if (opts.options.verbatim_module_syntax <> TristateTrue) and Transformer.list_is_empty(visited)
                return null
            return factory.update_named_imports(node, visited)
        }
        if k = KindImportSpecifier
        {
            if Printer.specifier_is_type_only_of(node)
                return null
            return node
        }
        if k = KindExportDeclaration
        {
            if AstNode.is_type_only_of(node)
                return null
            var export_clause: ref[AstNode]? null
            let ec AstNode.export_clause_of(node)
            if ec <> null
            {
                set export_clause: v.visit_node(ec)
                if export_clause = null
                    return null
            }
            return factory.update_export_declaration(node, null, false, export_clause, v.visit_node(AstNode.module_specifier_of(node)), v.visit_node(AstNode.import_attributes_of(node)))
        }
        if k = KindNamedExports
        {
            let elements AstNode.elements_of(node)
            if Transformer.list_is_empty(elements)
                return node
            let visited v.visit_nodes(elements)
            if (opts.options.verbatim_module_syntax <> TristateTrue) and Transformer.list_is_empty(visited)
                return null
            return factory.update_named_exports(node, visited)
        }
        if k = KindExportSpecifier
        {
            if Printer.specifier_is_type_only_of(node)
                return null
            return node
        }
        if k = KindEnumDeclaration
        {
            if this.the_checker().is_enum_const(node)
                return node
            return v.visit_each_child(node)
        }
        v.visit_each_child(node)
    }

    function list_is_empty(list: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if list = null
            return true
        ((list as ref[Array[ref[AstNode]?]]).get_length() as int) = 0
    }

    ; ═══ transformers/modifiervisitor.go ═══

    procedure visit_modifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let flags AstNode.modifier_to_flag(node.kind)
        if (flags <> ModifierFlagsNone) and ((flags & allowed_modifiers) = 0)
            return null
        node
    }

    ; ExtractModifiers
    function extract_modifiers(host: ref[Page], opts: TransformOptions, modifiers: ref[Array[ref[AstNode]?]]?, allowed: int) returns ref[Array[ref[AstNode]?]]?
    {
        if modifiers = null
            return null
        let tx Transformer.create(host, TransformerTagModifierVisitor, opts)
        set tx.allowed_modifiers: allowed
        tx.the_visitor().visit_modifiers(modifiers)
    }

    ; ═══ transformers/chain.go ═══

    procedure visit_chain(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind <> KindSourceFile
        {
            ; the reference PANICS ("Chained transform passed non-sourcefile initial node")
            this.record_unported("chain-non-source-file", node.kind)
            return node
        }
        var result node
        var i 0
        while i < (components.get_length() as int)
        {
            let t components[i as size_t] as ref[Transformer]
            set result: t.transform_source_file(result)
            if t.unported_count > 0
                this.record_unported(t.unported_tag, t.unported_detail)
            set i: i + 1
        }
        result
    }

    ; ═══ estransforms/usestrict.go ═══

    procedure visit_use_strict(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind <> KindSourceFile
            return node
        let info opts.file_info
        if info.script_kind = ScriptKindJSON
            return node
        let is_external_module info.is_external_module
        let module_kind opts.options.get_emit_module_kind()
        let format opts.options.get_emit_module_format_of_file(info.file_name)
        if is_external_module and (module_kind >= ModuleKindES2015) and ((module_kind = ModuleKindPreserve) or (format >= ModuleKindES2015))
            return node
        let old AstNode.statements_of(node)
        var statements old
        if statements = null
            set statements: &Array[ref[AstNode]?]^host()
        let ensured factory.ensure_use_strict(statements as ref[Array[ref[AstNode]?]])
        if ensured = statements
            return node
        let statement_list factory.new_node_list_like(ensured, old)
        factory.update_source_file(node, statement_list, AstNode.end_of_file_token_of(node))
    }

    ; ═══ moduletransforms/esmodule.go ═══

    procedure visit_es_module(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindSourceFile
            return this.es_visit_source_file(node)
        if k = KindImportDeclaration
            return this.es_visit_import_declaration(node)
        if k = KindImportEqualsDeclaration
            return this.es_visit_import_equals_declaration(node)
        if k = KindExportAssignment
            return this.es_visit_export_assignment(node)
        if k = KindExportDeclaration
            return this.es_visit_export_declaration(node)
        if k = KindCallExpression
            return this.es_visit_call_expression(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure es_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let info opts.file_info
        if info.is_declaration_file
            return node
        if (info.is_external_module = false) and (opts.options.get_isolated_modules() = false)
            return node
        set this.current_source_file: node
        set this.import_require_statements: null
        var result this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var i 0
        while i < (helpers.get_length() as int)
        {
            context.add_emit_helper(result, helpers[i as size_t] as ref[EmitHelper])
            set i: i + 1
        }
        let external_helpers_import_declaration this.create_external_helpers_import_declaration_if_needed(result, opts.options.get_emit_module_format_of_file(info.file_name))
        if (external_helpers_import_declaration <> null) or (import_require_statements <> null)
        {
            let old AstNode.statements_of(result)
            var src old
            if src = null
                set src: &Array[ref[AstNode]?]^host()
            let s src as ref[Array[ref[AstNode]?]]
            let n s.get_length() as int
            let prologue_end Transformer.standard_prologue_end(s)
            let custom_end this.custom_prologue_end(s, prologue_end)
            let statements &Array[ref[AstNode]?]^host()
            var j 0
            while j < custom_end
            {
                statements.add(s[j as size_t])
                set j: j + 1
            }
            if external_helpers_import_declaration <> null
                statements.add(this.the_visitor().visit_node(external_helpers_import_declaration))
            if import_require_statements <> null
            {
                let irs import_require_statements as ref[Array[ref[AstNode]?]]
                var r 0
                while r < (irs.get_length() as int)
                {
                    statements.add(irs[r as size_t])
                    set r: r + 1
                }
            }
            while j < n
            {
                statements.add(s[j as size_t])
                set j: j + 1
            }
            set result: factory.update_source_file(result, factory.new_node_list_like(statements, old), AstNode.end_of_file_token_of(node))
        }
        if info.is_external_module and (opts.options.get_emit_module_kind() <> ModuleKindPreserve) and (Transformer.some_external_module_indicator(AstNode.statements_of(result)) = false)
        {
            let old AstNode.statements_of(result)
            let statements &Array[ref[AstNode]?]^host()
            if old <> null
            {
                let s old as ref[Array[ref[AstNode]?]]
                var j 0
                while j < (s.get_length() as int)
                {
                    statements.add(s[j as size_t])
                    set j: j + 1
                }
            }
            statements.add(this.create_empty_imports())
            set result: factory.update_source_file(result, factory.new_node_list_like(statements, old), AstNode.end_of_file_token_of(node))
        }
        set this.import_require_statements: null
        set this.current_source_file: null
        result
    }

    function some_external_module_indicator(statements: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if statements = null
            return false
        let s statements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (s.get_length() as int)
        {
            if Parser.statement_is_external_module_indicator(s[i as size_t])
                return true
            set i: i + 1
        }
        false
    }

    ; createEmptyImports: `export {};`
    procedure create_empty_imports(this) returns ref[AstNode]
        factory.new_export_declaration(null, false, factory.new_named_exports(&Array[ref[AstNode]?]^host()), null, null)

    ; rewriteModuleSpecifier: identity unless rewriteRelativeImportExtensions
    ; (a said stop when the option is on — the extension rewrite needs tspath
    ; and outputpaths this port has not reached)
    procedure rewrite_module_specifier(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if opts.options.rewrite_relative_import_extensions = TristateTrue
            this.record_unported("rewrite-relative-import-extensions", 0)
        node
    }

    ; createExternalHelpersImportDeclarationIfNeeded (externalmoduleinfo.go): under
    ; importHelpers, `import tslib = require("tslib")` for a CommonJS emit (the
    ; printer then writes `tslib_1.__helper`), a named import of every helper the
    ; file requested for an ES module (aliased where the name is taken in the file)
    procedure create_external_helpers_import_declaration_if_needed(this, source_file: ref[AstNode], file_module_kind: int) returns ref[AstNode]?
    {
        if opts.options.import_helpers <> TristateTrue
            return null
        ; IsEffectiveExternalModule(sourceFile, options)
        var effective opts.file_info.is_external_module
        if this.the_checker().is_effective_external_module()
            set effective: true
        if effective = false
            return null
        let f factory
        let module_kind opts.options.get_emit_module_kind()
        let helpers this.get_imported_helpers(source_file)
        if (file_module_kind = ModuleKindCommonJS) or ((file_module_kind = ModuleKindNone) and (module_kind = ModuleKindCommonJS))
        {
            let external_helpers_module_name this.get_or_create_external_helpers_module_name_if_needed(source_file, helpers, false, false, file_module_kind)
            if external_helpers_module_name = null
                return null
            let decl f.new_import_equals_declaration(null, false, external_helpers_module_name, f.new_external_module_reference(f.new_string_literal("tslib", TokenFlagsNone)))
            context.add_emit_flags(decl, EFCustomPrologue)
            return decl
        }
        let helper_names &Array[Slice[char]]^host()
        var i 0
        while i < (helpers.get_length() as int)
        {
            let helper helpers[i as size_t] as ref[EmitHelper]
            if (helper.import_name.length > 0) and (Transformer.names_contain(helper_names, helper.import_name) = false)
                helper_names.add(helper.import_name)
            set i: i + 1
        }
        if helper_names.get_length() = 0
            return null
        Transformer.sort_names(helper_names)
        let import_specifiers &Array[ref[AstNode]?]^host()
        var j 0
        while j < (helper_names.get_length() as int)
        {
            let name helper_names[j as size_t]
            if opts.file_info.has_identifier(name)
                import_specifiers.add(f.new_import_specifier(false, f.new_identifier(name), f.new_unscoped_helper_name(name)))
            else
                import_specifiers.add(f.new_import_specifier(false, null, f.new_identifier(name)))
            set j: j + 1
        }
        let named_bindings f.new_named_imports(import_specifiers)
        let parse_node context.most_original(source_file) as ref[AstNode]
        context.add_emit_flags(parse_node, EFExternalHelpers)
        let decl f.new_import_declaration(null, f.new_import_clause(KindUnknown, null, named_bindings), f.new_string_literal("tslib", TokenFlagsNone), null)
        context.add_emit_flags(decl, EFCustomPrologue)
        decl
    }

    ; getImportedHelpers: the file's unscoped helpers
    function get_imported_helpers(this, source_file: ref[AstNode]) returns ref[Array[ref[EmitHelper]?]]
    {
        let out &Array[ref[EmitHelper]?]^host()
        let all context.get_emit_helpers(source_file)
        if all = null
            return out
        let hs all as ref[Array[ref[EmitHelper]?]]
        var i 0
        while i < (hs.get_length() as int)
        {
            let h hs[i as size_t]
            if h <> null
            {
                if (h as ref[EmitHelper]).scoped = false
                    out.add(h)
            }
            set i: i + 1
        }
        out
    }

    ; getOrCreateExternalHelpersModuleNameIfNeeded
    procedure get_or_create_external_helpers_module_name_if_needed(this, node: ref[AstNode], helpers: ref[Array[ref[EmitHelper]?]], has_export_stars_to_export_values: bool, has_import_star_or_import_default: bool, file_module_kind: int) returns ref[AstNode]?
    {
        let existing context.get_external_helpers_module_name(node)
        if existing <> null
            return existing
        var create helpers.get_length() > 0
        if (has_export_stars_to_export_values or has_import_star_or_import_default) and (file_module_kind < ModuleKindSystem)
            set create: true
        if create = false
            return null
        let name factory.new_unique_name("tslib")
        context.set_external_helpers_module_name(node, name)
        name
    }

    ; a byte-wise `<` (stringutil.CompareStringsCaseSensitive)
    function slice_less(a: Slice[char], b: Slice[char]) returns bool
    {
        var i 0
        while (i < (a.length as int)) and (i < (b.length as int))
        {
            let ca a[i] as int
            let cb b[i] as int
            if ca < cb
                return true
            if ca > cb
                return false
            set i: i + 1
        }
        (a.length as int) < (b.length as int)
    }

    function sort_names(list: ref[Array[Slice[char]]])
    {
        let n list.get_length() as int
        var i 1
        while i < n
        {
            let key list[i as size_t]
            var j i - 1
            while j >= 0
            {
                let prev list[j as size_t]
                if Transformer.slice_less(key, prev) = false
                    break
                list.put((j + 1) as size_t, prev)
                set j: j - 1
            }
            list.put((j + 1) as size_t, key)
            set i: i + 1
        }
    }

    procedure es_visit_import_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.rewrite_relative_import_extensions <> TristateTrue
            return node
        let updated_module_specifier this.rewrite_module_specifier(AstNode.module_specifier_of(node))
        factory.update_import_declaration(node, null, this.the_visitor().visit_node(AstNode.import_clause_of(node)), updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
    }

    procedure es_visit_import_equals_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.get_emit_module_kind() < ModuleKindNode16
            return null
        ; the node16+ `import x = require(...)` lowering (createRequireCall and the
        ; `_createRequire` prologue) — a said stop until a module kind reaches it
        this.record_unported("esmodule-import-equals", node.kind)
        null
    }

    procedure es_visit_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_export_equals_of(node) = false
            return this.the_visitor().visit_each_child(node)
        if opts.options.get_emit_module_kind() <> ModuleKindPreserve
            return null
        let f factory
        let statement f.new_expression_statement(f.new_assignment_expression(f.new_property_access_expression(f.new_identifier("module"), null, f.new_identifier("exports"), NodeFlagsNone), this.the_visitor().visit_node(Printer.statement_expression_of(node))))
        context.set_original(statement, node)
        statement
    }

    procedure es_visit_export_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let module_specifier AstNode.module_specifier_of(node)
        if module_specifier = null
            return node
        let updated_module_specifier this.rewrite_module_specifier(module_specifier)
        let export_clause AstNode.export_clause_of(node)
        ; the RAW module option, as the reference reads it here
        if (opts.options.module_kind > ModuleKindES2015) or (export_clause = null) or (AstNode.kind_of(export_clause) <> KindNamespaceExport)
            return factory.update_export_declaration(node, null, false, export_clause, updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
        ; ES2015: `export * as ns from "m"` becomes an import plus a named export
        let ec export_clause as ref[AstNode]
        let old_identifier Printer.declaration_name_of(ec) as ref[AstNode]
        let f factory
        let synth_name f.new_generated_name_for_node(old_identifier)
        let import_decl f.new_import_declaration(null, f.new_import_clause(KindUnknown, null, f.new_namespace_import(synth_name)), updated_module_specifier, this.the_visitor().visit_node(AstNode.import_attributes_of(node)))
        context.set_original(import_decl, ec)
        var export_decl: ref[AstNode]? null
        if Checker.module_export_name_is_default(old_identifier)
            set export_decl: f.new_export_assignment(null, false, null, synth_name)
        else
        {
            let specifiers &Array[ref[AstNode]?]^host()
            specifiers.add(f.new_export_specifier(false, synth_name, old_identifier))
            set export_decl: f.new_export_declaration(null, false, f.new_named_exports(specifiers), null, null)
        }
        context.set_original(export_decl as ref[AstNode], node)
        let both &Array[ref[AstNode]?]^host()
        both.add(import_decl)
        both.add(export_decl)
        this.single_or_many(both)
    }

    procedure es_visit_call_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.options.rewrite_relative_import_extensions = TristateTrue
        {
            if (Parser.is_import_call(node) and (Transformer.list_is_empty(AstNode.call_arguments_of(node)) = false)) or (Checker.is_in_json_file(node) = false and Parser.is_require_call(node, false) and ((node.flags & NodeFlagsJavaScriptFile) <> 0))
                this.record_unported("rewrite-relative-import-extensions", node.kind)
        }
        this.the_visitor().visit_each_child(node)
    }

    ; ═══ moduletransforms/commonjsmodule.go + externalmoduleinfo.go (slice 241) ═══

    ; the four visitors of NewCommonJSModuleTransformer, as sub tags, made on first use
    function cjs_visitor(this, sub: int) returns ref[NodeVisitor]
    {
        if cjs_visitors = null
        {
            let table &Array[ref[NodeVisitor]?]^host()
            var i 0
            while i <= 4
            {
                table.add(null)
                set i: i + 1
            }
            set this.cjs_visitors: table
        }
        let visitors cjs_visitors as ref[Array[ref[NodeVisitor]?]]
        let existing visitors[sub as size_t]
        if existing <> null
            return existing as ref[NodeVisitor]
        let v context.new_node_visitor(VisitTagTransformer)
        set v.transformer: this
        set v.sub_tag: sub
        visitors.put(sub as size_t, v)
        v
    }

    ; visitTopLevel
    procedure cjs_visit_top_level(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cjs_visit_top_level_no_stack(node)
        this.pop_node(grandparent)
        result
    }

    procedure cjs_visit_top_level_no_stack(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindImportDeclaration
            return this.cjs_visit_top_level_import_declaration(node)
        if k = KindImportEqualsDeclaration
            return this.cjs_visit_top_level_import_equals_declaration(node)
        if k = KindExportDeclaration
            return this.cjs_visit_top_level_export_declaration(node)
        if k = KindExportAssignment
            return this.cjs_visit_top_level_export_assignment(node)
        if k = KindFunctionDeclaration
            return this.cjs_visit_top_level_function_declaration(node)
        if k = KindClassDeclaration
            return this.cjs_visit_top_level_class_declaration(node)
        if k = KindVariableStatement
            return this.cjs_visit_top_level_variable_statement(node)
        this.cjs_visit_top_level_nested_no_stack(node)
    }

    ; visitTopLevelNested
    procedure cjs_visit_top_level_nested(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cjs_visit_top_level_nested_no_stack(node)
        this.pop_node(grandparent)
        result
    }

    procedure cjs_visit_top_level_nested_no_stack(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindVariableStatement
            return this.cjs_visit_top_level_variable_statement(node)
        if k = KindForStatement
            return this.cjs_visit_top_level_nested_for_statement(node)
        if (k = KindForInStatement) or (k = KindForOfStatement)
            return this.cjs_visit_top_level_nested_for_in_or_of_statement(node)
        if k = KindDoStatement
            return this.cjs_visit_top_level_nested_do_statement(node)
        if k = KindWhileStatement
            return this.cjs_visit_top_level_nested_while_statement(node)
        if k = KindLabeledStatement
            return this.cjs_visit_top_level_nested_labeled_statement(node)
        if k = KindWithStatement
            return this.cjs_visit_top_level_nested_with_statement(node)
        if k = KindIfStatement
            return this.cjs_visit_top_level_nested_if_statement(node)
        if k = KindSwitchStatement
            return this.cjs_visit_top_level_nested_switch_statement(node)
        if k = KindCaseBlock
            return this.cjs_visit_top_level_nested_case_block(node)
        if (k = KindCaseClause) or (k = KindDefaultClause)
            return this.cjs_visit_top_level_nested_case_or_default_clause(node)
        if k = KindTryStatement
            return this.cjs_visit_top_level_nested_try_statement(node)
        if k = KindCatchClause
            return this.cjs_visit_top_level_nested_catch_clause(node)
        if k = KindBlock
            return this.cjs_visit_top_level_nested_block(node)
        this.cjs_visit_no_stack(node, false)
    }

    ; visit: source elements that are not top-level or top-level nested statements
    procedure visit_common_js(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cjs_visit_no_stack(node, false)
        this.pop_node(grandparent)
        result
    }

    procedure cjs_visit_no_stack(this, node: ref[AstNode], result_is_discarded: bool) returns ref[AstNode]?
    {
        ; no dynamic imports or identifiers in the subtree: nothing to do
        if (node.kind <> KindSourceFile) and ((Emitter.subtree_facts(node) & (SubtreeContainsDynamicImport | SubtreeContainsIdentifier)) = 0)
            return node
        let k node.kind
        if k = KindSourceFile
            return this.cjs_visit_source_file(node)
        if k = KindForStatement
            return this.cjs_visit_for_statement(node)
        if (k = KindForInStatement) or (k = KindForOfStatement)
            return this.cjs_visit_for_in_or_of_statement(node)
        if (k = KindExpressionStatement) or (k = KindVoidExpression)
        {
            let dv this.cjs_visitor(CjsSubDiscarded)
            return dv.visit_each_child(node)
        }
        if k = KindParenthesizedExpression
            return factory.update_parenthesized_expression(node, this.cjs_visit_maybe_discarded(AstNode.expression_of(node), result_is_discarded))
        if k = KindPartiallyEmittedExpression
            return factory.update_partially_emitted_expression(node, this.cjs_visit_maybe_discarded(AstNode.expression_of(node), result_is_discarded))
        if k = KindCallExpression
            return this.cjs_visit_call_expression(node)
        if k = KindTaggedTemplateExpression
            return this.cjs_visit_tagged_template_expression(node)
        if k = KindBinaryExpression
            return this.cjs_visit_binary_expression(node, result_is_discarded)
        if k = KindPrefixUnaryExpression
            return this.cjs_visit_prefix_unary_expression(node)
        if k = KindPostfixUnaryExpression
            return this.cjs_visit_postfix_unary_expression(node, result_is_discarded)
        if k = KindShorthandPropertyAssignment
            return this.cjs_visit_shorthand_property_assignment(node)
        if k = KindIdentifier
            return this.cjs_visit_identifier(node)
        this.the_visitor().visit_each_child(node)
    }

    ; core.IfElse(resultIsDiscarded, tx.discardedValueVisitor, tx.Visitor()).VisitNode(x)
    procedure cjs_visit_maybe_discarded(this, node: ref[AstNode]?, result_is_discarded: bool) returns ref[AstNode]?
    {
        if result_is_discarded
        {
            let dv this.cjs_visitor(CjsSubDiscarded)
            return dv.visit_node(node)
        }
        this.the_visitor().visit_node(node)
    }

    ; visitDiscardedValue
    procedure cjs_visit_discarded_value(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cjs_visit_no_stack(node, true)
        this.pop_node(grandparent)
        result
    }

    ; visitAssignmentPattern
    procedure cjs_visit_assignment_pattern(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cjs_visit_assignment_pattern_no_stack(node)
        this.pop_node(grandparent)
        result
    }

    procedure cjs_visit_assignment_pattern_no_stack(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if (k = KindObjectLiteralExpression) or (k = KindArrayLiteralExpression)
        {
            let av this.cjs_visitor(CjsSubAssignmentPattern)
            return av.visit_each_child(node)
        }
        if k = KindPropertyAssignment
            return this.cjs_visit_assignment_property(node)
        if k = KindShorthandPropertyAssignment
            return this.cjs_visit_shorthand_assignment_property(node)
        if k = KindSpreadAssignment
            return factory.update_spread_assignment(node, this.cjs_visit_destructuring_assignment_target(AstNode.expression_of(node) as ref[AstNode]))
        if k = KindSpreadElement
            return factory.update_spread_element(node, this.cjs_visit_destructuring_assignment_target(AstNode.expression_of(node) as ref[AstNode]))
        if AstNode.is_expression_node(node)
            return this.cjs_visit_assignment_element(node)
        this.cjs_visit_no_stack(node, false)
    }

    procedure cjs_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let info opts.file_info
        if info.is_declaration_file
            return node
        ; IsEffectiveExternalModule: the stored indicator — the file info carries
        ; the forced-by-format arm (a .cts/.mts file) the parser cannot see
        var effective info.is_external_module
        if this.the_checker().is_effective_external_module()
            set effective: true
        if (effective = false) and ((Emitter.subtree_facts(node) & SubtreeContainsDynamicImport) = 0)
            return node
        set this.current_source_file: node
        set this.cjs_info: this.collect_external_module_info(node)
        let updated this.cjs_transform_common_js_module(node)
        set this.current_source_file: null
        set this.cjs_info: null
        updated
    }

    ; shouldEmitUnderscoreUnderscoreESModule
    function cjs_should_emit_underscore_underscore_es_module(this) returns bool
    {
        let b opts.binder as ref[Binder]
        let info cjs_info as ref[ExternalModuleInfo]
        let file_name opts.file_info.file_name
        let is_js file_name.ends_with(".js") or file_name.ends_with(".jsx") or file_name.ends_with(".mjs") or file_name.ends_with(".cjs")
        let cjs_indicator b.common_js_module_indicator_of()
        let is_external b.is_external_module_of()
        ; ExternalModuleIndicator == nil || its Kind == KindSourceFile: the second
        ; arm is the FORCE arm, unreachable under the oracle's zeroed options
        if is_js and (cjs_indicator <> null) and (is_external = false)
            return false
        if (info.export_equals = null) and opts.file_info.is_external_module
            return true
        false
    }

    ; createUnderscoreUnderscoreESModule:
    ;   Object.defineProperty(exports, "__esModule", { value: true });
    procedure cjs_create_underscore_underscore_es_module(this) returns ref[AstNode]
    {
        let f factory
        let props &Array[ref[AstNode]?]^host()
        props.add(f.new_property_assignment(null, f.new_identifier("value"), null, null, f.new_true_expression()))
        let args &Array[ref[AstNode]?]^host()
        args.add(f.new_identifier("exports"))
        args.add(f.new_string_literal("__esModule", TokenFlagsNone))
        args.add(f.new_object_literal_expression(props, false))
        let statement f.new_expression_statement(f.new_call_expression(f.new_property_access_expression(f.new_identifier("Object"), null, f.new_identifier("defineProperty"), NodeFlagsNone), null, null, args, NodeFlagsNone))
        context.set_emit_flags(statement, EFCustomPrologue)
        statement
    }

    ; exports.<name> / exports["<name>"] as an assignment target
    procedure cjs_exports_access(this, name: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if name.kind = KindStringLiteral
            return f.new_element_access_expression(f.new_identifier("exports"), null, f.new_string_literal_from_node(name), NodeFlagsNone)
        let cloned f.clone(name)
        context.set_emit_flags(cloned, EFNoSourceMap | EFNoComments)
        f.new_property_access_expression(f.new_identifier("exports"), null, cloned, NodeFlagsNone)
    }

    ; transformCommonJSModule
    procedure cjs_transform_common_js_module(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let info cjs_info as ref[ExternalModuleInfo]
        let tv this.cjs_visitor(CjsSubTopLevel)
        context.start_variable_environment()
        let source AstNode.statements_of(node) as ref[Array[ref[AstNode]?]]
        let n source.get_length() as int
        ; the standard prologue directives (e.g. "use strict")
        let prologue_end Transformer.standard_prologue_end(source)
        let statements &Array[ref[AstNode]?]^host()
        var i 0
        while i < prologue_end
        {
            statements.add(source[i as size_t])
            set i: i + 1
        }
        ; custom prologues from other transformations
        let custom_end this.custom_prologue_end(source, prologue_end)
        var changed false
        Transformer.add_all(statements, tv.visit_slice(Transformer.sub_list(host, source, prologue_end, custom_end), &changed))
        ; `Object.defineProperty(exports, "__esModule", { value: true });`
        if this.cjs_should_emit_underscore_underscore_es_module()
            statements.add(this.cjs_create_underscore_underscore_es_module())
        ; initialize all exports to `undefined`: exports.a = exports.b = void 0;
        let names info.exported_names
        let l names.get_length() as int
        var start 0
        while start < l
        {
            var right f.new_void_zero_expression()
            var stop start + 50
            if stop > l
                set stop: l
            var j start
            while j < stop
            {
                let next_id names[j as size_t] as ref[AstNode]
                let left this.cjs_exports_access(next_id)
                set right: f.new_assignment_expression(left, right)
                set j: j + 1
            }
            let statement f.new_expression_statement(right)
            context.add_emit_flags(statement, EFCustomPrologue)
            statements.add(statement)
            set start: start + 50
        }
        ; exports for function declarations: exports.f = f; — custom prologue so
        ; they sort before the external helpers import
        let exported_functions_start statements.get_length() as int
        let funcs info.exported_functions
        var fi 0
        while fi < (funcs.get_length() as int)
        {
            this.cjs_append_exports_of_class_or_function_declaration(statements, funcs[fi as size_t] as ref[AstNode])
            set fi: fi + 1
        }
        var si exported_functions_start
        while si < (statements.get_length() as int)
        {
            context.add_emit_flags(statements[si as size_t] as ref[AstNode], EFCustomPrologue)
            set si: si + 1
        }
        ; the remaining statements
        Transformer.add_all(statements, tv.visit_slice(Transformer.sub_list(host, source, custom_end, n), &changed))
        ; `module.exports = ...` if needed
        this.cjs_append_export_equals_if_needed(statements)
        ; merge temp variables into the statement list
        let merged context.end_and_merge_variable_environment(statements) as ref[Array[ref[AstNode]?]]
        var sp 0
        var se 0
        if AstNode.list_range_of(node, source, &sp, &se)
            f.set_list_range(merged, sp, se)
        var result f.update_source_file(node, merged, AstNode.end_of_file_token_of(node))
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(result, helper as ref[EmitHelper])
            set h: h + 1
        }
        let external_helpers_import_declaration this.create_external_helpers_import_declaration_if_needed(result, opts.options.get_emit_module_format_of_file(opts.file_info.file_name))
        if external_helpers_import_declaration <> null
        {
            let rs AstNode.statements_of(result) as ref[Array[ref[AstNode]?]]
            let pe Transformer.standard_prologue_end(rs)
            let ce this.custom_prologue_end(rs, pe)
            let out &Array[ref[AstNode]?]^host()
            Transformer.add_all(out, Transformer.sub_list(host, rs, 0, ce))
            out.add(tv.visit_node(external_helpers_import_declaration))
            Transformer.add_all(out, Transformer.sub_list(host, rs, ce, rs.get_length() as int))
            var rp 0
            var re 0
            if AstNode.list_range_of(result, rs, &rp, &re)
                f.set_list_range(out, rp, re)
            set result: f.update_source_file(result, out, AstNode.end_of_file_token_of(node))
        }
        result
    }

    ; appendExportEqualsIfNeeded: `module.exports = <expression>;`
    procedure cjs_append_export_equals_if_needed(this, statements: ref[Array[ref[AstNode]?]])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals = null
            return
        let ee info.export_equals as ref[AstNode]
        let expression_result this.cjs_visit_export_equals(ee)
        if expression_result = null
            return
        let f factory
        let statement f.new_expression_statement(f.new_assignment_expression(f.new_property_access_expression(f.new_identifier("module"), null, f.new_identifier("exports"), NodeFlagsNone), expression_result))
        context.assign_comment_and_source_map_ranges(statement, ee)
        context.add_emit_flags(statement, EFNoComments)
        statements.add(statement)
    }

    procedure cjs_visit_export_equals(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.the_visitor().visit_node(AstNode.expression_of(node))
        this.pop_node(grandparent)
        result
    }

    ; appendExportsOfImportDeclaration
    procedure cjs_append_exports_of_import_declaration(this, statements: ref[Array[ref[AstNode]?]], decl: ref[AstNode])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals <> null
            return
        let import_clause AstNode.import_clause_of(decl)
        if import_clause = null
            return
        let ic import_clause as ref[AstNode]
        let seen &Array[Slice[char]]^host()
        if AstNode.name_of(ic) <> null
            this.cjs_append_exports_of_declaration(statements, ic, seen, false)
        let named_bindings AstNode.named_bindings_of(ic)
        if named_bindings = null
            return
        let nb named_bindings as ref[AstNode]
        if nb.kind = KindNamespaceImport
            this.cjs_append_exports_of_declaration(statements, nb, seen, false)
        if nb.kind = KindNamedImports
        {
            let elements AstNode.elements_of(nb)
            if elements <> null
            {
                let es elements as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (es.get_length() as int)
                {
                    this.cjs_append_exports_of_declaration(statements, es[i as size_t] as ref[AstNode], seen, true)
                    set i: i + 1
                }
            }
        }
    }

    ; appendExportsOfVariableStatement
    procedure cjs_append_exports_of_variable_statement(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode])
        this.cjs_append_exports_of_variable_declaration_list(statements, Printer.declaration_list_of(node) as ref[AstNode], false)

    ; appendExportsOfVariableDeclarationList
    procedure cjs_append_exports_of_variable_declaration_list(this, statements: ref[Array[ref[AstNode]?]], node: ref[AstNode], is_for_in_or_of_initializer: bool)
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals <> null
            return
        let decls Printer.declarations_of(node)
        if decls = null
            return
        let ds decls as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ds.get_length() as int)
        {
            this.cjs_append_exports_of_binding_element(statements, ds[i as size_t] as ref[AstNode], is_for_in_or_of_initializer)
            set i: i + 1
        }
    }

    ; appendExportsOfBindingElement
    procedure cjs_append_exports_of_binding_element(this, statements: ref[Array[ref[AstNode]?]], decl: ref[AstNode], is_for_in_or_of_initializer: bool)
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals <> null
            return
        let name AstNode.name_of(decl)
        if name = null
            return
        let nm name as ref[AstNode]
        if AstNode.is_binding_pattern(nm)
        {
            let elements AstNode.elements_of(nm) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let element elements[i as size_t] as ref[AstNode]
                if element.kind <> KindOmittedExpression
                    this.cjs_append_exports_of_binding_element(statements, element, is_for_in_or_of_initializer)
                set i: i + 1
            }
            return
        }
        if context.has_auto_generate_info(nm)
            return
        if (decl.kind = KindVariableDeclaration) and (AstNode.initializer_of(decl) = null) and (is_for_in_or_of_initializer = false)
            return
        this.cjs_append_exports_of_declaration(statements, decl, null, false)
    }

    ; appendExportsOfClassOrFunctionDeclaration
    procedure cjs_append_exports_of_class_or_function_declaration(this, statements: ref[Array[ref[AstNode]?]], decl: ref[AstNode])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals <> null
            return
        let f factory
        let seen &Array[Slice[char]]^host()
        if Transformer.has_syntactic_modifier(decl, ModifierFlagsExport)
        {
            var export_name: ref[AstNode]? null
            if Transformer.has_syntactic_modifier(decl, ModifierFlagsDefault)
                set export_name: f.new_identifier("default")
            else
                set export_name: f.get_declaration_name(decl)
            let export_value f.get_local_name(decl)
            this.cjs_append_export_statement(statements, seen, export_name as ref[AstNode], export_value, true, TextRange(decl.pos, decl.end), false, false)
        }
        if AstNode.name_of(decl) <> null
            this.cjs_append_exports_of_declaration(statements, decl, seen, false)
    }

    ; appendExportsOfDeclaration
    procedure cjs_append_exports_of_declaration(this, statements: ref[Array[ref[AstNode]?]], decl: ref[AstNode], seen_in: ref[Array[Slice[char]]]?, live_binding: bool)
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if info.export_equals <> null
            return
        var seen: ref[Array[Slice[char]]]? seen_in
        if seen = null
            set seen: &Array[Slice[char]]^host()
        let s seen as ref[Array[Slice[char]]]
        let name AstNode.name_of(decl)
        if info.export_specifiers.get_length() = 0
            return
        if name = null
            return
        if AstNode.kind_of(name) <> KindIdentifier
            return
        let decl_name factory.get_declaration_name(decl)
        let export_specifiers info.export_specifiers_of(host, AstNode.identifier_text_of(decl_name))
        if export_specifiers.get_length() = 0
            return
        let export_value this.cjs_visit_expression_identifier(decl_name)
        var i 0
        while i < (export_specifiers.get_length() as int)
        {
            let export_specifier export_specifiers[i as size_t] as ref[AstNode]
            let sn AstNode.name_of(export_specifier) as ref[AstNode]
            this.cjs_append_export_statement(statements, s, sn, export_value, true, TextRange(sn.pos, sn.end), false, live_binding)
            set i: i + 1
        }
    }

    ; appendExportStatement
    procedure cjs_append_export_statement(this, statements: ref[Array[ref[AstNode]?]], seen: ref[Array[Slice[char]]], export_name: ref[AstNode], expression: ref[AstNode], has_location: bool, location: TextRange, allow_comments: bool, live_binding: bool)
    {
        if export_name.kind <> KindStringLiteral
        {
            let text Checker.module_export_name_text(export_name)
            if Transformer.names_contain(seen, text)
                return
            seen.add(text)
        }
        statements.add(this.cjs_create_export_statement(export_name, expression, has_location, location, allow_comments, live_binding))
    }

    ; createExportStatement
    procedure cjs_create_export_statement(this, name: ref[AstNode], value: ref[AstNode], has_location: bool, location: TextRange, allow_comments: bool, live_binding: bool) returns ref[AstNode]
    {
        let statement factory.new_expression_statement(this.cjs_create_export_expression(name, value, false, location, live_binding))
        if has_location
            context.set_comment_range(statement, location)
        context.add_emit_flags(statement, EFStartOnNewLine)
        if allow_comments = false
            context.add_emit_flags(statement, EFNoComments)
        statement
    }

    ; createExportExpression
    procedure cjs_create_export_expression(this, name: ref[AstNode], value: ref[AstNode], has_location: bool, location: TextRange, live_binding: bool) returns ref[AstNode]
    {
        let f factory
        var expression: ref[AstNode]? null
        if live_binding
        {
            ; Object.defineProperty(exports, "<name>", { enumerable: true, get: function () { return <value>; } });
            let body_statements &Array[ref[AstNode]?]^host()
            body_statements.add(f.new_return_statement(value))
            let no_params &Array[ref[AstNode]?]^host()
            let getter f.new_function_expression(null, null, null, null, no_params, null, null, f.new_block(body_statements, false))
            let props &Array[ref[AstNode]?]^host()
            props.add(f.new_property_assignment(null, f.new_identifier("enumerable"), null, null, f.new_true_expression()))
            props.add(f.new_property_assignment(null, f.new_identifier("get"), null, null, getter))
            let args &Array[ref[AstNode]?]^host()
            args.add(f.new_identifier("exports"))
            args.add(f.new_string_literal_from_node(name))
            args.add(f.new_object_literal_expression(props, false))
            set expression: f.new_call_expression(f.new_property_access_expression(f.new_identifier("Object"), null, f.new_identifier("defineProperty"), NodeFlagsNone), null, null, args, NodeFlagsNone)
        }
        else
        {
            var left: ref[AstNode]? null
            if name.kind = KindStringLiteral
                set left: f.new_element_access_expression(f.new_identifier("exports"), null, f.new_string_literal_from_node(name), NodeFlagsNone)
            else
                set left: f.new_property_access_expression(f.new_identifier("exports"), null, f.clone(name), NodeFlagsNone)
            set expression: f.new_assignment_expression(left, value)
        }
        let e expression as ref[AstNode]
        if has_location
            context.set_comment_range(e, location)
        e
    }

    ; getExternalModuleNameLiteral: the module specifier as a fresh string literal
    ; (the amd-module / outFile / renamedDependencies renames are all nil here)
    procedure cjs_external_module_name_literal(this, import_node: ref[AstNode]) returns ref[AstNode]?
    {
        let module_name AstNode.get_external_module_name(import_node)
        if module_name = null
            return null
        let mn module_name as ref[AstNode]
        if mn.kind <> KindStringLiteral
            return null
        factory.new_string_literal(AstNode.literal_text_of(mn), TokenFlagsNone)
    }

    ; createRequireCall
    procedure cjs_create_require_call(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let args &Array[ref[AstNode]?]^host()
        let module_name this.cjs_external_module_name_literal(node)
        if module_name <> null
            args.add(this.rewrite_module_specifier(module_name))
        factory.new_call_expression(factory.new_identifier("require"), null, null, args, NodeFlagsNone)
    }

    ; ast.GetNamespaceDeclarationNode, all three arms (the checker's own reads
    ; the import clause only)
    function cjs_namespace_declaration_node(node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration)
        {
            let clause AstNode.import_clause_of(node)
            if clause = null
                return null
            let nb AstNode.named_bindings_of(clause)
            if AstNode.kind_of(nb) = KindNamespaceImport
                return nb
            return null
        }
        if k = KindImportEqualsDeclaration
            return node
        if k = KindExportDeclaration
        {
            let ec AstNode.export_clause_of(node)
            if AstNode.kind_of(ec) = KindNamespaceExport
                return ec
        }
        null
    }

    ; ast.IsDefaultImport
    function cjs_is_default_import(node: ref[AstNode]) returns bool
    {
        let k node.kind
        if (k = KindImportDeclaration) or (k = KindJSImportDeclaration)
        {
            let clause AstNode.import_clause_of(node)
            if clause = null
                return false
            return AstNode.name_of(clause) <> null
        }
        false
    }

    ; isNamedDefaultReference
    function cjs_is_named_default_reference(e: ref[AstNode]) returns bool
        Checker.module_export_name_is_default(Checker.property_name_or_name_of(e))

    ; containsDefaultReference
    function cjs_contains_default_reference(node: ref[AstNode]?) returns bool
    {
        if node = null
            return false
        let n node as ref[AstNode]
        if (n.kind <> KindNamedImports) and (n.kind <> KindNamedExports)
            return false
        let elements AstNode.elements_of(n)
        if elements = null
            return false
        let es elements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (es.get_length() as int)
        {
            if Transformer.cjs_is_named_default_reference(es[i as size_t] as ref[AstNode])
                return true
            set i: i + 1
        }
        false
    }

    ; getExportNeedsImportStarHelper
    function cjs_export_needs_import_star_helper(node: ref[AstNode]) returns bool
        Transformer.cjs_namespace_declaration_node(node) <> null

    ; getImportNeedsImportStarHelper
    function cjs_import_needs_import_star_helper(node: ref[AstNode]) returns bool
    {
        if Transformer.cjs_namespace_declaration_node(node) <> null
            return true
        let clause AstNode.import_clause_of(node)
        if clause = null
            return false
        let bindings AstNode.named_bindings_of(clause)
        if bindings = null
            return false
        let b bindings as ref[AstNode]
        if b.kind <> KindNamedImports
            return false
        let elements AstNode.elements_of(b) as ref[Array[ref[AstNode]?]]
        let n elements.get_length() as int
        var default_ref_count 0
        var i 0
        while i < n
        {
            if Transformer.cjs_is_named_default_reference(elements[i as size_t] as ref[AstNode])
                set default_ref_count: default_ref_count + 1
            set i: i + 1
        }
        ; import star is required if there are default named refs mixed with
        ; non-default refs, or non-default refs beside a default import
        if (default_ref_count > 0) and (default_ref_count <> n)
            return true
        if ((n - default_ref_count) <> 0) and Transformer.cjs_is_default_import(node)
            return true
        false
    }

    ; getImportNeedsImportDefaultHelper
    function cjs_import_needs_import_default_helper(node: ref[AstNode]) returns bool
    {
        if Transformer.cjs_import_needs_import_star_helper(node)
            return false
        if Transformer.cjs_is_default_import(node)
            return true
        let clause AstNode.import_clause_of(node)
        if clause = null
            return false
        let bindings AstNode.named_bindings_of(clause)
        if AstNode.kind_of(bindings) <> KindNamedImports
            return false
        Transformer.cjs_contains_default_reference(bindings)
    }

    procedure cjs_helper_expression_for_export(this, node: ref[AstNode], inner_expr: ref[AstNode]) returns ref[AstNode]
    {
        if Transformer.cjs_export_needs_import_star_helper(node)
            return this.the_visitor().visit_node(factory.new_import_star_helper(inner_expr)) as ref[AstNode]
        inner_expr
    }

    procedure cjs_helper_expression_for_import(this, node: ref[AstNode], inner_expr: ref[AstNode]) returns ref[AstNode]
    {
        if Transformer.cjs_import_needs_import_star_helper(node)
            return this.the_visitor().visit_node(factory.new_import_star_helper(inner_expr)) as ref[AstNode]
        if Transformer.cjs_import_needs_import_default_helper(node)
            return this.the_visitor().visit_node(factory.new_import_default_helper(inner_expr)) as ref[AstNode]
        inner_expr
    }

    ; visitTopLevelImportDeclaration
    procedure cjs_visit_top_level_import_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let import_clause AstNode.import_clause_of(node)
        if import_clause = null
        {
            ; import "mod";
            let statement f.new_expression_statement(this.cjs_create_require_call(node))
            context.set_original(statement, node)
            context.assign_comment_and_source_map_ranges(statement, node)
            return statement
        }
        let statements &Array[ref[AstNode]?]^host()
        let variables &Array[ref[AstNode]?]^host()
        let namespace_declaration Transformer.cjs_namespace_declaration_node(node)
        let is_default Transformer.cjs_is_default_import(node)
        if (namespace_declaration <> null) and (is_default = false)
        {
            ; import * as n from "mod";
            let ns_name AstNode.name_of(namespace_declaration) as ref[AstNode]
            variables.add(f.new_variable_declaration(f.clone(ns_name), null, null, this.cjs_helper_expression_for_import(node, this.cjs_create_require_call(node))))
        }
        else
        {
            ; import d from "mod"; import { x, y } from "mod"; import d, { x, y } from "mod"; import d, * as n from "mod";
            variables.add(f.new_variable_declaration(f.new_generated_name_for_node(node), null, null, this.cjs_helper_expression_for_import(node, this.cjs_create_require_call(node))))
            if (namespace_declaration <> null) and is_default
            {
                let ns_name AstNode.name_of(namespace_declaration) as ref[AstNode]
                variables.add(f.new_variable_declaration(f.clone(ns_name), null, null, f.new_generated_name_for_node(node)))
            }
        }
        let var_statement f.new_variable_statement(null, f.new_variable_declaration_list(variables, NodeFlagsConst))
        context.set_original(var_statement, node)
        context.assign_comment_and_source_map_ranges(var_statement, node)
        statements.add(var_statement)
        this.cjs_append_exports_of_import_declaration(statements, node)
        this.single_or_many(statements)
    }

    ; visitTopLevelImportEqualsDeclaration
    procedure cjs_visit_top_level_import_equals_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if AstNode.kind_of(AstNode.module_reference_of(node)) <> KindExternalModuleReference
        {
            ; import m = n; — handled by the runtime-syntax transformer before this one
            this.record_unported("commonjs-internal-import-equals", 0)
            return node
        }
        let statements &Array[ref[AstNode]?]^host()
        let name AstNode.name_of(node) as ref[AstNode]
        if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        {
            ; export import m = require("mod");
            let statement f.new_expression_statement(this.cjs_create_export_expression(name, this.cjs_create_require_call(node), true, TextRange(node.pos, node.end), false))
            context.set_original(statement, node)
            context.assign_comment_and_source_map_ranges(statement, node)
            statements.add(statement)
        }
        else
        {
            ; import m = require("mod");
            let variables &Array[ref[AstNode]?]^host()
            variables.add(f.new_variable_declaration(f.clone(name), null, null, this.cjs_create_require_call(node)))
            let statement f.new_variable_statement(null, f.new_variable_declaration_list(variables, NodeFlagsConst))
            context.set_original(statement, node)
            context.assign_comment_and_source_map_ranges(statement, node)
            statements.add(statement)
        }
        this.cjs_append_exports_of_declaration(statements, node, null, false)
        this.single_or_many(statements)
    }

    ; visitTopLevelExportDeclaration
    procedure cjs_visit_top_level_export_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if AstNode.module_specifier_of(node) = null
            return null
        let generated_name f.new_generated_name_for_node(node)
        let export_clause AstNode.export_clause_of(node)
        if AstNode.kind_of(export_clause) = KindNamedExports
        {
            ; export { x, y } from "mod";
            let statements &Array[ref[AstNode]?]^host()
            let variables &Array[ref[AstNode]?]^host()
            variables.add(f.new_variable_declaration(generated_name, null, null, this.cjs_create_require_call(node)))
            let var_statement f.new_variable_statement(null, f.new_variable_declaration_list(variables, NodeFlagsNone))
            context.set_original(var_statement, node)
            context.assign_comment_and_source_map_ranges(var_statement, node)
            statements.add(var_statement)
            let elements AstNode.elements_of(export_clause) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let specifier elements[i as size_t] as ref[AstNode]
                let specifier_name Checker.property_name_or_name_of(specifier) as ref[AstNode]
                let export_needs_import_default Checker.module_export_name_is_default(specifier_name)
                var target generated_name
                if export_needs_import_default
                    set target: f.new_import_default_helper(generated_name)
                let sn AstNode.name_of(specifier) as ref[AstNode]
                var export_name: ref[AstNode]? null
                if sn.kind = KindStringLiteral
                    set export_name: f.new_string_literal_from_node(sn)
                else
                    set export_name: f.get_export_name(specifier)
                var exported_value: ref[AstNode]? null
                if specifier_name.kind = KindStringLiteral
                    set exported_value: f.new_element_access_expression(target, null, specifier_name, NodeFlagsNone)
                else
                    set exported_value: f.new_property_access_expression(target, null, specifier_name, NodeFlagsNone)
                let statement f.new_expression_statement(this.cjs_create_export_expression(export_name as ref[AstNode], exported_value as ref[AstNode], false, TextRange(0, 0), true))
                context.set_original(statement, specifier)
                context.assign_comment_and_source_map_ranges(statement, specifier)
                statements.add(statement)
                set i: i + 1
            }
            return this.single_or_many(statements)
        }
        if export_clause <> null
        {
            ; export * as ns from "mod"; export * as default from "mod";
            let ec_name AstNode.name_of(export_clause) as ref[AstNode]
            var export_name: ref[AstNode]? null
            if ec_name.kind = KindStringLiteral
                set export_name: f.new_string_literal_from_node(ec_name)
            else
                set export_name: f.clone(ec_name)
            let statement f.new_expression_statement(this.cjs_create_export_expression(export_name as ref[AstNode], this.cjs_helper_expression_for_export(node, this.cjs_create_require_call(node)), false, TextRange(0, 0), false))
            context.set_original(statement, node)
            context.assign_comment_and_source_map_ranges(statement, node)
            return statement
        }
        ; export * from "mod";
        let statement f.new_expression_statement(this.the_visitor().visit_node(f.new_export_star_helper(this.cjs_create_require_call(node), f.new_identifier("exports"))))
        context.set_original(statement, node)
        context.assign_comment_and_source_map_ranges(statement, node)
        statement
    }

    ; visitTopLevelExportAssignment
    procedure cjs_visit_top_level_export_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_export_equals_of(node)
            return null
        let visited this.the_visitor().visit_node(AstNode.expression_of(node)) as ref[AstNode]
        this.cjs_create_export_statement(factory.new_identifier("default"), visited, true, TextRange(node.pos, node.end), true, false)
    }

    ; visitTopLevelFunctionDeclaration
    procedure cjs_visit_top_level_function_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        if Transformer.has_syntactic_modifier(node, ModifierFlagsExport) = false
            return v.visit_each_child(node)
        let modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault)
        factory.update_function_declaration(node, modifiers, AstNode.asterisk_token_of(node), factory.get_declaration_name(node), null, v.visit_nodes(AstNode.parameters_of(node)), null, null, v.visit_node(AstNode.body_of(node)))
    }

    ; visitTopLevelClassDeclaration
    procedure cjs_visit_top_level_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let v this.the_visitor()
        let statements &Array[ref[AstNode]?]^host()
        if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        {
            let modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault)
            statements.add(factory.update_class_declaration(node, v.visit_modifiers(modifiers), factory.get_declaration_name(node), null, v.visit_nodes(AstNode.heritage_clauses_of(node)), v.visit_nodes(Printer.member_list_of(node))))
        }
        else
            statements.add(v.visit_each_child(node))
        this.cjs_append_exports_of_class_or_function_declaration(statements, node)
        this.single_or_many(statements)
    }

    ; the two commit closures of visitTopLevelVariableStatement
    procedure cjs_commit_pending_variables(this, node: ref[AstNode], statements: ref[Array[ref[AstNode]?]], variables: ref[Array[ref[AstNode]?]], modifiers: ref[Array[ref[AstNode]?]]?)
    {
        if variables.get_length() = 0
            return
        let f factory
        let list Printer.declaration_list_of(node) as ref[AstNode]
        let statement f.update_variable_statement(node, modifiers, f.update_variable_declaration_list(list, variables, list.flags))
        if statements.get_length() > 0
            context.add_emit_flags(statement, EFNoComments)
        statements.add(statement)
    }

    procedure cjs_commit_pending_expressions(this, node: ref[AstNode], statements: ref[Array[ref[AstNode]?]], expressions: ref[Array[ref[AstNode]?]])
    {
        if expressions.get_length() = 0
            return
        let f factory
        let statement f.new_expression_statement(f.inline_expressions(expressions) as ref[AstNode])
        context.assign_comment_and_source_map_ranges(statement, node)
        if statements.get_length() > 0
            context.add_emit_flags(statement, EFNoComments)
        statements.add(statement)
    }

    ; visitTopLevelVariableStatement
    procedure cjs_visit_top_level_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if Transformer.has_syntactic_modifier(node, ModifierFlagsExport) = false
            return this.cjs_visit_top_level_nested_variable_statement(node)
        ; export var a = b;
        let f factory
        let v this.the_visitor()
        let statements &Array[ref[AstNode]?]^host()
        var variables &Array[ref[AstNode]?]^host()
        var expressions &Array[ref[AstNode]?]^host()
        var modifiers: ref[Array[ref[AstNode]?]]? null
        let list Printer.declaration_list_of(node) as ref[AstNode]
        let decls Printer.declarations_of(list) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (decls.get_length() as int)
        {
            let variable decls[i as size_t] as ref[AstNode]
            let name AstNode.name_of(variable) as ref[AstNode]
            let init_node AstNode.initializer_of(variable)
            var handled false
            if (name.kind = KindIdentifier) and ((context.emit_flags(name) & EFLocalName) <> 0)
            {
                ; a "local name": a class or function declaration converted into a
                ; variable declaration, which an `export { x }` will follow
                set handled: true
                if modifiers = null
                    set modifiers: Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor ModifierFlagsExportDefault)
                var updated variable
                if init_node <> null
                    set updated: f.update_variable_declaration(variable, name, null, null, this.cjs_create_export_expression(name, v.visit_node(init_node) as ref[AstNode], false, TextRange(0, 0), false))
                ; pushVariable
                if expressions.get_length() > 0
                {
                    this.cjs_commit_pending_expressions(node, statements, expressions)
                    set expressions: &Array[ref[AstNode]?]^host()
                }
                variables.add(updated)
            }
            if (handled = false) and (init_node <> null) and (AstNode.is_binding_pattern(name) = false)
            {
                let ik AstNode.kind_of(init_node)
                if (ik = KindArrowFunction) or (ik = KindFunctionExpression) or (ik = KindClassExpression)
                {
                    ; preserve variable declarations for functions and classes to assign names
                    set handled: true
                    if expressions.get_length() > 0
                    {
                        this.cjs_commit_pending_expressions(node, statements, expressions)
                        set expressions: &Array[ref[AstNode]?]^host()
                    }
                    variables.add(f.new_variable_declaration(name, AstNode.exclamation_token_of(variable), null, v.visit_node(init_node)))
                    let property_access f.new_property_access_expression(f.new_identifier("exports"), null, name, NodeFlagsNone)
                    context.assign_comment_and_source_map_ranges(property_access, name)
                    ; pushExpression
                    if variables.get_length() > 0
                    {
                        this.cjs_commit_pending_variables(node, statements, variables, modifiers)
                        set variables: &Array[ref[AstNode]?]^host()
                    }
                    expressions.add(f.new_assignment_expression(property_access, f.clone(name)))
                }
            }
            if handled = false
            {
                var expression: ref[AstNode]? null
                if name.kind = KindIdentifier
                {
                    let e this.cjs_transform_initialized_variable(variable)
                    if e <> null
                        set expression: v.visit_node(e)
                }
                else
                {
                    if AstNode.is_binding_pattern(name)
                        set expression: this.cjs_transform_initialized_variable(variable)
                    else
                    {
                        let e Transformer.convert_variable_declaration_to_assignment_expression(context, variable)
                        if e <> null
                            set expression: v.visit_node(e)
                    }
                }
                if expression <> null
                {
                    if variables.get_length() > 0
                    {
                        this.cjs_commit_pending_variables(node, statements, variables, modifiers)
                        set variables: &Array[ref[AstNode]?]^host()
                    }
                    expressions.add(expression)
                }
            }
            set i: i + 1
        }
        this.cjs_commit_pending_variables(node, statements, variables, modifiers)
        this.cjs_commit_pending_expressions(node, statements, expressions)
        this.cjs_append_exports_of_variable_statement(statements, node)
        this.single_or_many(statements)
    }

    ; transformInitializedVariable
    procedure cjs_transform_initialized_variable(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let init_node AstNode.initializer_of(node)
        if init_node = null
            return null
        let name AstNode.name_of(node) as ref[AstNode]
        if AstNode.is_binding_pattern(name)
        {
            ; the binding pattern as a destructuring assignment, visited as one
            let assignment Transformer.convert_variable_declaration_to_assignment_expression(context, node) as ref[AstNode]
            let grandparent this.push_node(assignment)
            let result this.cjs_visit_destructuring_assignment(assignment, true)
            this.pop_node(grandparent)
            return result
        }
        let property_access factory.new_property_access_expression(factory.new_identifier("exports"), null, name, NodeFlagsNone)
        context.assign_comment_and_source_map_ranges(property_access, name)
        factory.new_assignment_expression(property_access, init_node)
    }

    ; visitTopLevelNestedVariableStatement
    procedure cjs_visit_top_level_nested_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let statements &Array[ref[AstNode]?]^host()
        statements.add(this.the_visitor().visit_each_child(node))
        this.cjs_append_exports_of_variable_statement(statements, node)
        this.single_or_many(statements)
    }

    ; visitTopLevelNestedForStatement
    procedure cjs_visit_top_level_nested_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let dv this.cjs_visitor(CjsSubDiscarded)
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        let initializer AstNode.initializer_of(node)
        if initializer <> null
        {
            let init_node initializer as ref[AstNode]
            if (init_node.kind = KindVariableDeclarationList) and ((init_node.flags & NodeFlagsBlockScoped) = 0)
            {
                let export_statements &Array[ref[AstNode]?]^host()
                this.cjs_append_exports_of_variable_declaration_list(export_statements, init_node, false)
                if export_statements.get_length() > 0
                {
                    ; export { x }; for (var x = 0; ;) { }  →  var x = 0; exports.x = x; for (; ;) { }
                    let statements &Array[ref[AstNode]?]^host()
                    let var_decl_list dv.visit_node(init_node)
                    statements.add(f.new_variable_statement(null, var_decl_list))
                    Transformer.add_all(statements, export_statements)
                    let condition v.visit_node(AstNode.for_condition_of(node))
                    let incrementor dv.visit_node(AstNode.for_incrementor_of(node))
                    let body context.visit_iteration_body(Printer.statement_body_of(node), nv)
                    statements.add(f.update_for_statement(node, null, condition, incrementor, body))
                    return this.single_or_many(statements)
                }
            }
        }
        f.update_for_statement(node, dv.visit_node(initializer), v.visit_node(AstNode.for_condition_of(node)), dv.visit_node(AstNode.for_incrementor_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), nv))
    }

    ; visitTopLevelNestedForInOrOfStatement
    procedure cjs_visit_top_level_nested_for_in_or_of_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let dv this.cjs_visitor(CjsSubDiscarded)
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        let init_node AstNode.initializer_of(node) as ref[AstNode]
        if (init_node.kind = KindVariableDeclarationList) and ((init_node.flags & NodeFlagsBlockScoped) = 0)
        {
            let export_statements &Array[ref[AstNode]?]^host()
            this.cjs_append_exports_of_variable_declaration_list(export_statements, init_node, true)
            if export_statements.get_length() > 0
            {
                ; export { x }; for (var x in y) { ... }  →  for (var x in y) { exports.x = x; ... }
                let initializer dv.visit_node(init_node)
                let expression v.visit_node(AstNode.expression_of(node))
                let body_in context.visit_iteration_body(Printer.statement_body_of(node), nv)
                var body: ref[AstNode]? null
                if AstNode.kind_of(body_in) = KindBlock
                {
                    let block body_in as ref[AstNode]
                    let old AstNode.statements_of(block)
                    let body_statements &Array[ref[AstNode]?]^host()
                    Transformer.add_all(body_statements, export_statements)
                    Transformer.add_all(body_statements, old)
                    set body: f.update_block(block, f.new_node_list_like(body_statements, old), AstNode.multi_line_of(block))
                }
                else
                {
                    let body_statements &Array[ref[AstNode]?]^host()
                    Transformer.add_all(body_statements, export_statements)
                    body_statements.add(body_in)
                    set body: f.new_block(body_statements, true)
                }
                return f.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), initializer, expression, body)
            }
        }
        f.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), dv.visit_node(init_node), v.visit_node(AstNode.expression_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), nv))
    }

    procedure cjs_visit_top_level_nested_do_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_do_statement(node, context.visit_iteration_body(Printer.statement_body_of(node), nv), this.the_visitor().visit_node(AstNode.expression_of(node)))
    }

    procedure cjs_visit_top_level_nested_while_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_while_statement(node, this.the_visitor().visit_node(AstNode.expression_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), nv))
    }

    procedure cjs_visit_top_level_nested_labeled_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        var statement nv.visit_embedded_statement(Printer.statement_body_of(node))
        if statement = null
            set statement: factory.new_empty_statement()
        factory.update_labeled_statement(node, AstNode.label_name_of(node), statement)
    }

    procedure cjs_visit_top_level_nested_with_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_with_statement(node, this.the_visitor().visit_node(AstNode.expression_of(node)), nv.visit_embedded_statement(Printer.statement_body_of(node)))
    }

    procedure cjs_visit_top_level_nested_if_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        let expression this.the_visitor().visit_node(AstNode.expression_of(node))
        var then_statement nv.visit_embedded_statement(AstNode.then_statement_of(node))
        if then_statement = null
            set then_statement: factory.new_block(&Array[ref[AstNode]?]^host(), false)
        let else_statement nv.visit_embedded_statement(AstNode.else_statement_of(node))
        factory.update_if_statement(node, expression, then_statement, else_statement)
    }

    procedure cjs_visit_top_level_nested_switch_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_switch_statement(node, this.the_visitor().visit_node(AstNode.expression_of(node)), nv.visit_node(AstNode.case_block_of(node)))
    }

    procedure cjs_visit_top_level_nested_case_block(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        nv.visit_each_child(node)
    }

    procedure cjs_visit_top_level_nested_case_or_default_clause(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_case_or_default_clause(node, this.the_visitor().visit_node(AstNode.expression_of(node)), nv.visit_nodes(AstNode.statements_of(node)))
    }

    procedure cjs_visit_top_level_nested_try_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        nv.visit_each_child(node)
    }

    procedure cjs_visit_top_level_nested_catch_clause(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_catch_clause(node, AstNode.catch_variable_declaration_of(node), nv.visit_node(AstNode.catch_block_of(node)))
    }

    procedure cjs_visit_top_level_nested_block(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        nv.visit_each_child(node)
    }

    procedure cjs_visit_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let dv this.cjs_visitor(CjsSubDiscarded)
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_for_statement(node, dv.visit_node(AstNode.initializer_of(node)), this.the_visitor().visit_node(AstNode.for_condition_of(node)), dv.visit_node(AstNode.for_incrementor_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), nv))
    }

    procedure cjs_visit_for_in_or_of_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let dv this.cjs_visitor(CjsSubDiscarded)
        let nv this.cjs_visitor(CjsSubTopLevelNested)
        factory.update_for_in_or_of_statement(node, AstNode.for_await_modifier_of(node), dv.visit_node(AstNode.initializer_of(node)), this.the_visitor().visit_node(AstNode.expression_of(node)), context.visit_iteration_body(Printer.statement_body_of(node), nv))
    }

    ; visitBinaryExpression: a destructuring assignment, an assignment to an
    ; exported identifier, or a comma expression whose value may be discarded
    procedure cjs_visit_binary_expression(this, node: ref[AstNode], result_is_discarded: bool) returns ref[AstNode]?
    {
        if Binder.is_destructuring_assignment(node)
            return this.cjs_visit_destructuring_assignment(node, result_is_discarded)
        if Emitter.is_assignment_expression(node, false)
            return this.cjs_visit_assignment_expression(node)
        if AstNode.binary_operator_kind(node) = KindCommaToken
        {
            let dv this.cjs_visitor(CjsSubDiscarded)
            let left dv.visit_node(AstNode.binary_left_of(node))
            let right this.cjs_visit_maybe_discarded(AstNode.binary_right_of(node), result_is_discarded)
            return factory.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), right)
        }
        this.the_visitor().visit_each_child(node)
    }

    ; the identifiers this transformer rewrites: not generated unless file-level
    ; reserved, and never a local name
    function cjs_is_rewritable_identifier(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindIdentifier
            return false
        if context.has_auto_generate_info(node)
        {
            if this.cjs_is_file_level_reserved_generated_identifier(node) = false
                return false
        }
        (context.emit_flags(node) & EFLocalName) = 0
    }

    ; visitAssignmentExpression: every export of an assigned exported symbol is updated
    procedure cjs_visit_assignment_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let left AstNode.binary_left_of(node) as ref[AstNode]
        if this.cjs_is_rewritable_identifier(left)
        {
            let exported_names this.cjs_get_exports(left)
            if exported_names.get_length() > 0
            {
                var expression this.the_visitor().visit_each_child(node) as ref[AstNode]
                var i 0
                while i < (exported_names.get_length() as int)
                {
                    set expression: this.cjs_create_export_expression(exported_names[i as size_t] as ref[AstNode], expression, true, TextRange(node.pos, node.end), false)
                    set i: i + 1
                }
                return expression
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    ; visitDestructuringAssignment
    procedure cjs_visit_destructuring_assignment(this, node: ref[AstNode], value_is_discarded: bool) returns ref[AstNode]?
    {
        if this.cjs_destructuring_needs_flattening(AstNode.binary_left_of(node) as ref[AstNode])
            return Flattener.flatten_destructuring_assignment(host, this, node, value_is_discarded = false, FlattenLevelAll, FlattenCallbackCommonJS)
        this.the_visitor().visit_each_child(node)
    }

    ; destructuringNeedsFlattening: does the target hold an exported identifier
    ; that native destructuring cannot update
    procedure cjs_destructuring_needs_flattening(this, node: ref[AstNode]) returns bool
    {
        if node.kind = KindObjectLiteralExpression
        {
            let props AstNode.properties_of(node) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (props.get_length() as int)
            {
                let elem props[i as size_t] as ref[AstNode]
                let k elem.kind
                if k = KindPropertyAssignment
                {
                    if this.cjs_destructuring_needs_flattening(AstNode.initializer_of(elem) as ref[AstNode])
                        return true
                }
                if k = KindShorthandPropertyAssignment
                {
                    if this.cjs_destructuring_needs_flattening(AstNode.name_of(elem) as ref[AstNode])
                        return true
                }
                if k = KindSpreadAssignment
                {
                    if this.cjs_destructuring_needs_flattening(AstNode.expression_of(elem) as ref[AstNode])
                        return true
                }
                if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
                    return false
                set i: i + 1
            }
            return false
        }
        if node.kind = KindArrayLiteralExpression
        {
            let elements AstNode.elements_of(node) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let elem elements[i as size_t] as ref[AstNode]
                if elem.kind = KindSpreadElement
                {
                    if this.cjs_destructuring_needs_flattening(AstNode.expression_of(elem) as ref[AstNode])
                        return true
                }
                else
                {
                    if this.cjs_destructuring_needs_flattening(elem)
                        return true
                }
                set i: i + 1
            }
            return false
        }
        if node.kind = KindIdentifier
        {
            let exported_names this.cjs_get_exports(node)
            let count exported_names.get_length() as int
            if (context.emit_flags(node) & EFExportName) <> 0
                return count > 1
            if count = 0
                return false
            ; a single direct export under the identifier's own name is rewritten
            ; to `exports.X` natively; re-aliased or multi-exported names are not
            if count = 1
            {
                let direct this.cjs_is_direct_export(node)
                if direct
                {
                    let first exported_names[0] as ref[AstNode]
                    if Checker.module_export_name_text(first).equals(AstNode.identifier_text_of(node))
                        return false
                }
            }
            return true
        }
        false
    }

    ; createAllExportExpressions: the flattener's assignment callback
    procedure cjs_create_all_export_expressions(this, name: ref[AstNode], value: ref[AstNode], has_location: bool, location: TextRange) returns ref[AstNode]
    {
        let f factory
        let exported_names this.cjs_get_exports(name)
        let direct this.cjs_is_direct_export(name)
        if exported_names.get_length() > 0
        {
            var expression: ref[AstNode]? null
            if direct
            {
                ; exports.name = value
                let export_name f.clone(name)
                context.add_emit_flags(export_name, EFNoComments | EFNoSourceMap)
                let property_access f.new_property_access_expression(f.new_identifier("exports"), null, export_name, NodeFlagsNone)
                context.add_emit_flags(property_access, EFNoComments)
                let e f.new_assignment_expression(property_access, value)
                context.assign_comment_and_source_map_ranges(e, name)
                set expression: e
            }
            else
                set expression: f.new_assignment_expression(name, value)
            var result expression as ref[AstNode]
            var i 0
            while i < (exported_names.get_length() as int)
            {
                set result: this.cjs_create_export_expression(exported_names[i as size_t] as ref[AstNode], result, has_location, location, false)
                set i: i + 1
            }
            return result
        }
        if direct
        {
            let export_name f.clone(name)
            context.add_emit_flags(export_name, EFNoComments | EFNoSourceMap)
            let property_access f.new_property_access_expression(f.new_identifier("exports"), null, export_name, NodeFlagsNone)
            context.add_emit_flags(property_access, EFNoComments)
            let result f.new_assignment_expression(property_access, value)
            context.assign_comment_and_source_map_ranges(result, name)
            return result
        }
        f.new_assignment_expression(name, value)
    }

    ; isDirectExport: `export let x` rather than `let x; export { x }`
    procedure cjs_is_direct_export(this, name: ref[AstNode]) returns bool
    {
        let export_container this.the_checker().get_referenced_export_container(context.most_original(name) as ref[AstNode], false)
        AstNode.kind_of(export_container) = KindSourceFile
    }

    procedure cjs_visit_assignment_property(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let av this.cjs_visitor(CjsSubAssignmentPattern)
        factory.update_property_assignment(node, null, this.the_visitor().visit_node(AstNode.name_of(node)), null, null, av.visit_node(AstNode.initializer_of(node)))
    }

    procedure cjs_visit_shorthand_assignment_property(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let name AstNode.name_of(node) as ref[AstNode]
        var target this.cjs_visit_destructuring_assignment_target_no_stack(name) as ref[AstNode]
        let oai AstNode.shorthand_object_assignment_initializer_of(node)
        if target.kind = KindIdentifier
            return f.update_shorthand_property_assignment(node, null, target, null, null, AstNode.shorthand_equals_token_of(node), v.visit_node(oai))
        if oai <> null
        {
            var equals_token AstNode.shorthand_equals_token_of(node)
            if equals_token = null
                set equals_token: f.new_token(KindEqualsToken)
            set target: f.new_binary_expression(null, target, null, equals_token, v.visit_node(oai))
        }
        let updated f.new_property_assignment(null, name, null, null, target)
        context.set_original(updated, node)
        context.assign_comment_and_source_map_ranges(updated, node)
        updated
    }

    procedure cjs_visit_assignment_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindBinaryExpression
        {
            if AstNode.binary_operator_kind(node) = KindEqualsToken
                return factory.update_binary_expression(node, null, this.cjs_visit_destructuring_assignment_target(AstNode.binary_left_of(node) as ref[AstNode]), null, AstNode.binary_operator_token_of(node), this.the_visitor().visit_node(AstNode.binary_right_of(node)))
        }
        this.cjs_visit_destructuring_assignment_target_no_stack(node)
    }

    procedure cjs_visit_destructuring_assignment_target(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        var result: ref[AstNode]? null
        if (node.kind = KindObjectLiteralExpression) or (node.kind = KindArrayLiteralExpression)
            set result: this.cjs_visit_assignment_pattern_no_stack(node)
        else
            set result: this.cjs_visit_destructuring_assignment_target_no_stack(node)
        this.pop_node(grandparent)
        result
    }

    ; visitDestructuringAssignmentTargetNoStack:
    ;   { x: x } = y  →  { x: { set value(v) { exports.x = x = v; } }.value } = y
    procedure cjs_visit_destructuring_assignment_target_no_stack(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if this.cjs_is_rewritable_identifier(node) = false
            return this.cjs_visit_no_stack(node, false)
        let f factory
        var expression this.cjs_visit_expression_identifier(node)
        let exported_names this.cjs_get_exports(node)
        if exported_names.get_length() = 0
            return expression
        let empty: Slice[char] ""
        let value_text: Slice[char] "value"
        let value f.new_unique_name_ex(value_text, GeneratedIdentifierFlagsOptimistic, empty, empty)
        set expression: f.new_assignment_expression(expression, value)
        var i 0
        while i < (exported_names.get_length() as int)
        {
            set expression: this.cjs_create_export_expression(exported_names[i as size_t] as ref[AstNode], expression, false, TextRange(0, 0), false)
            set i: i + 1
        }
        let statement_list &Array[ref[AstNode]?]^host()
        statement_list.add(f.new_expression_statement(expression))
        let params &Array[ref[AstNode]?]^host()
        params.add(f.new_parameter_declaration(null, null, value, null, null, null))
        let value_setter f.new_set_accessor_declaration(null, f.new_identifier("value"), null, params, null, null, f.new_block(statement_list, false))
        let property_list &Array[ref[AstNode]?]^host()
        property_list.add(value_setter)
        let obj f.new_object_literal_expression(property_list, false)
        f.new_property_access_expression(obj, null, f.new_identifier("value"), NodeFlagsNone)
    }

    ; visitPrefixUnaryExpression: ++x on an exported x updates every export
    procedure cjs_visit_prefix_unary_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let op AstNode.prefix_unary_operator_kind(node)
        let operand AstNode.prefix_unary_operand_of(node) as ref[AstNode]
        if ((op = KindPlusPlusToken) or (op = KindMinusMinusToken)) and (operand.kind = KindIdentifier) and ((context.emit_flags(operand) & EFLocalName) = 0)
        {
            let exported_names this.cjs_get_exports(operand)
            if exported_names.get_length() > 0
            {
                var expression factory.update_prefix_unary_expression(node, op, this.the_visitor().visit_node(operand))
                var i 0
                while i < (exported_names.get_length() as int)
                {
                    set expression: this.cjs_create_export_expression(exported_names[i as size_t] as ref[AstNode], expression, false, TextRange(0, 0), false)
                    context.assign_comment_and_source_map_ranges(expression, node)
                    set i: i + 1
                }
                return expression
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    ; visitPostfixUnaryExpression:
    ;   x++ (discarded)  →  exports.x = (x++, x)
    ;   y = x++          →  y = (exports.x = (_a = x++, x), _a)
    procedure cjs_visit_postfix_unary_expression(this, node: ref[AstNode], result_is_discarded: bool) returns ref[AstNode]?
    {
        let f factory
        let op AstNode.postfix_unary_operator_of(node)
        let operand AstNode.postfix_unary_operand_of(node) as ref[AstNode]
        if ((op = KindPlusPlusToken) or (op = KindMinusMinusToken)) and (operand.kind = KindIdentifier) and ((context.emit_flags(operand) & EFLocalName) = 0)
        {
            let exported_names this.cjs_get_exports(operand)
            if exported_names.get_length() > 0
            {
                var temp: ref[AstNode]? null
                var expression f.update_postfix_unary_expression(node, this.the_visitor().visit_node(operand), op)
                if result_is_discarded = false
                {
                    let t f.new_temp_variable()
                    context.add_variable_declaration(t)
                    set temp: t
                    set expression: f.new_assignment_expression(t, expression)
                    context.assign_comment_and_source_map_ranges(expression, node)
                }
                set expression: f.new_comma_expression(expression, f.clone(operand))
                context.assign_comment_and_source_map_ranges(expression, node)
                var i 0
                while i < (exported_names.get_length() as int)
                {
                    set expression: this.cjs_create_export_expression(exported_names[i as size_t] as ref[AstNode], expression, false, TextRange(0, 0), false)
                    context.assign_comment_and_source_map_ranges(expression, node)
                    set i: i + 1
                }
                if temp <> null
                {
                    set expression: f.new_comma_expression(expression, temp)
                    context.assign_comment_and_source_map_ranges(expression, node)
                }
                return expression
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    ; ast.ShouldTransformImportCall
    function cjs_should_transform_import_call(this) returns bool
    {
        let module_kind opts.options.get_emit_module_kind()
        if ((module_kind >= ModuleKindNode16) and (module_kind <= ModuleKindNodeNext)) or (module_kind = ModuleKindPreserve)
            return false
        opts.options.get_emit_module_format_of_file(opts.file_info.file_name) < ModuleKindES2015
    }

    ; visitCallExpression: an indirect call of an imported binding, `import()`
    ; and `require()` rewrites
    procedure cjs_visit_call_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        var needs_rewrite false
        if opts.options.rewrite_relative_import_extensions = TristateTrue
        {
            if AstNode.is_import_call(node) and (Transformer.list_is_empty(AstNode.call_arguments_of(node)) = false)
                set needs_rewrite: true
            if Parser.is_in_js_file(node) and Parser.is_require_call(node, false)
                set needs_rewrite: true
        }
        if AstNode.is_import_call(node) and this.cjs_should_transform_import_call()
            return this.cjs_visit_import_call_expression(node, needs_rewrite)
        if needs_rewrite
            return this.cjs_shim_or_rewrite_import_or_require_call(node)
        let callee AstNode.expression_of(node) as ref[AstNode]
        if callee.kind = KindIdentifier
        {
            ; import { f } from "mod"; f();  →  (0, mod_1.f)();  — the printer applies
            ; the indirection by way of EFIndirectCall
            let expression this.cjs_visit_expression_identifier(callee)
            let updated f.update_call_expression(node, expression, AstNode.question_dot_token_of(node), null, v.visit_nodes(AstNode.call_arguments_of(node)), node.flags)
            if (expression.kind <> KindIdentifier) and ((context.emit_flags(callee) & EFHelperName) = 0)
                context.add_emit_flags(updated, EFIndirectCall)
            return updated
        }
        v.visit_each_child(node)
    }

    ; visitImportCallExpression
    procedure cjs_visit_import_call_expression(this, node: ref[AstNode], rewrite_or_shim: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (opts.options.get_emit_module_kind() = ModuleKindNone) and (opts.options.get_emit_script_target() >= ScriptTargetES2020)
            return v.visit_each_child(node)
        let external_module_name this.cjs_external_module_name_literal(node)
        var first_in: ref[AstNode]? null
        let args AstNode.call_arguments_of(node)
        if args <> null
        {
            let a args as ref[Array[ref[AstNode]?]]
            if a.get_length() > 0
                set first_in: a[0]
        }
        let first_argument v.visit_node(first_in)
        ; the external module name only where it differs from the first argument,
        ; so the argument's quote style survives
        var argument: ref[AstNode]? null
        var use_external false
        if external_module_name <> null
        {
            let emn external_module_name as ref[AstNode]
            if first_argument = null
                set use_external: true
            else
            {
                let fa first_argument as ref[AstNode]
                if fa.kind <> KindStringLiteral
                    set use_external: true
                else
                {
                    if AstNode.literal_text_of(fa).equals(AstNode.literal_text_of(emn)) = false
                        set use_external: true
                }
            }
        }
        if use_external
            set argument: external_module_name
        else
        {
            if (first_argument <> null) and rewrite_or_shim
            {
                let fa first_argument as ref[AstNode]
                if fa.kind = KindStringLiteral
                    set argument: this.rewrite_module_specifier(fa)
                else
                    set argument: f.new_rewrite_relative_import_extensions_helper(fa, opts.options.jsx = JsxEmitPreserve)
            }
            else
                set argument: first_argument
        }
        this.cjs_create_import_call_expression_common_js(argument)
    }

    ; createImportCallExpressionCommonJS:
    ;   import(x)  →  Promise.resolve(`${x}`).then((s) => require(s))
    procedure cjs_create_import_call_expression_common_js(this, arg: ref[AstNode]?) returns ref[AstNode]
    {
        let f factory
        var need_sync_eval false
        if arg <> null
        {
            if Transformer.is_simple_inlineable_expression(arg as ref[AstNode]) = false
                set need_sync_eval: true
        }
        let promise_resolve_arguments &Array[ref[AstNode]?]^host()
        let empty: Slice[char] ""
        if need_sync_eval
        {
            let spans &Array[ref[AstNode]?]^host()
            spans.add(f.new_template_span(arg, f.new_template_tail(empty, empty, TokenFlagsNone)))
            promise_resolve_arguments.add(f.new_template_expression(f.new_template_head(empty, empty, TokenFlagsNone), spans))
        }
        let promise_resolve_call f.new_call_expression(f.new_property_access_expression(f.new_identifier("Promise"), null, f.new_identifier("resolve"), NodeFlagsNone), null, null, promise_resolve_arguments, NodeFlagsNone)
        let require_arguments &Array[ref[AstNode]?]^host()
        if need_sync_eval
            require_arguments.add(f.new_identifier("s"))
        else
        {
            if arg <> null
                require_arguments.add(arg)
        }
        let require_call f.new_import_star_helper(f.new_call_expression(f.new_identifier("require"), null, null, require_arguments, NodeFlagsNone))
        let parameters &Array[ref[AstNode]?]^host()
        if need_sync_eval
            parameters.add(f.new_parameter_declaration(null, null, f.new_identifier("s"), null, null, null))
        let fn f.new_arrow_function(null, null, parameters, null, null, f.new_token(KindEqualsGreaterThanToken), require_call)
        let then_args &Array[ref[AstNode]?]^host()
        then_args.add(fn)
        f.new_call_expression(f.new_property_access_expression(promise_resolve_call, null, f.new_identifier("then"), NodeFlagsNone), null, null, then_args, NodeFlagsNone)
    }

    ; shimOrRewriteImportOrRequireCall
    procedure cjs_shim_or_rewrite_import_or_require_call(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let expression v.visit_node(AstNode.expression_of(node))
        var arguments_list AstNode.call_arguments_of(node)
        let args arguments_list as ref[Array[ref[AstNode]?]]
        if args.get_length() > 0
        {
            var first_argument args[0] as ref[AstNode]
            var first_argument_changed false
            if Parser.is_string_literal_like(first_argument)
            {
                let rewritten this.rewrite_module_specifier(first_argument) as ref[AstNode]
                set first_argument_changed: Transformer.same_node(rewritten, first_argument) = false
                set first_argument: rewritten
            }
            else
            {
                set first_argument: f.new_rewrite_relative_import_extensions_helper(first_argument, opts.options.jsx = JsxEmitPreserve)
                set first_argument_changed: true
            }
            var rest_changed false
            let rest v.visit_slice(Transformer.sub_list(host, args, 1, args.get_length() as int), &rest_changed)
            if first_argument_changed or rest_changed
            {
                let out &Array[ref[AstNode]?]^host()
                out.add(first_argument)
                Transformer.add_all(out, rest)
                set arguments_list: f.new_node_list_like(out, args)
            }
        }
        f.update_call_expression(node, expression, AstNode.question_dot_token_of(node), null, arguments_list, node.flags)
    }

    ; visitTaggedTemplateExpression: f`` on an imported f is an indirect call
    procedure cjs_visit_tagged_template_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let tag AstNode.tagged_template_tag_of(node) as ref[AstNode]
        if tag.kind = KindIdentifier
        {
            let expression this.cjs_visit_expression_identifier(tag)
            let updated factory.update_tagged_template_expression(node, expression, null, null, this.the_visitor().visit_node(AstNode.tagged_template_template_of(node)), node.flags)
            if (expression.kind <> KindIdentifier) and ((context.emit_flags(tag) & EFHelperName) = 0)
                context.add_emit_flags(updated, EFIndirectCall)
            return updated
        }
        this.the_visitor().visit_each_child(node)
    }

    ; visitShorthandPropertyAssignment: a shorthand of an imported or exported name
    procedure cjs_visit_shorthand_property_assignment(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let name AstNode.name_of(node) as ref[AstNode]
        let exported_or_imported_name this.cjs_visit_expression_identifier(name)
        let oai AstNode.shorthand_object_assignment_initializer_of(node)
        if Transformer.same_node(exported_or_imported_name, name) = false
        {
            ; a shorthand with an assignment initializer is probably part of a
            ; destructuring assignment
            var expression exported_or_imported_name
            if oai <> null
                set expression: f.new_assignment_expression(expression, v.visit_node(oai))
            let assignment f.new_property_assignment(null, name, null, null, expression)
            set assignment.pos: node.pos
            set assignment.end: node.end
            context.assign_comment_and_source_map_ranges(assignment, node)
            return assignment
        }
        f.update_shorthand_property_assignment(node, null, exported_or_imported_name, null, null, AstNode.shorthand_equals_token_of(node), v.visit_node(oai))
    }

    ; visitIdentifier: an identifier in an expression position
    procedure cjs_visit_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if parent_node <> null
        {
            if Transformer.is_identifier_reference(node, parent_node as ref[AstNode])
                return this.cjs_visit_expression_identifier(node)
        }
        node
    }

    ; visitExpressionIdentifier: an identifier that might reference an imported
    ; or exported symbol
    procedure cjs_visit_expression_identifier(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let info context.get_auto_generate_info(node)
        if info <> null
        {
            let ag info as ref[AutoGenerateInfo]
            if (ag.flags & GeneratedIdentifierFlagsAllowNameSubstitution) = 0
                return node
        }
        let flags context.emit_flags(node)
        if (flags & EFHelperName) <> 0
            return node
        if (flags & EFLocalName) <> 0
            return node
        if this.cjs_is_declaration_name_of_enum_or_namespace(node)
            return node
        let original context.most_original(node) as ref[AstNode]
        let export_container this.the_checker().get_referenced_export_container(original, (flags & EFExportName) <> 0)
        if AstNode.kind_of(export_container) = KindSourceFile
        {
            let reference f.new_property_access_expression(f.new_identifier("exports"), null, f.clone(node), NodeFlagsNone)
            context.assign_comment_and_source_map_ranges(reference, node)
            set reference.pos: node.pos
            set reference.end: node.end
            return reference
        }
        let import_declaration this.the_checker().get_referenced_import_declaration(original)
        if import_declaration = null
            return node
        let id import_declaration as ref[AstNode]
        if id.kind = KindImportClause
        {
            ; the resolver answers parse-tree declarations; the parent is the import declaration
            let reference f.new_property_access_expression(f.new_generated_name_for_node(AstNode.parent_node_of(id) as ref[AstNode]), null, f.new_identifier("default"), NodeFlagsNone)
            context.assign_comment_and_source_map_ranges(reference, node)
            set reference.pos: node.pos
            set reference.end: node.end
            return reference
        }
        if id.kind = KindImportSpecifier
        {
            let name Checker.property_name_or_name_of(id) as ref[AstNode]
            var decl: ref[AstNode]? Checker.find_ancestor_kind(id, KindImportDeclaration)
            if decl = null
                set decl: id
            let target f.new_generated_name_for_node(decl as ref[AstNode])
            var reference: ref[AstNode]? null
            if name.kind = KindStringLiteral
                set reference: f.new_element_access_expression(target, null, f.new_string_literal_from_node(name), NodeFlagsNone)
            else
            {
                let reference_name f.clone(name)
                context.add_emit_flags(reference_name, EFNoSourceMap | EFNoComments)
                set reference: f.new_property_access_expression(target, null, reference_name, NodeFlagsNone)
            }
            let r reference as ref[AstNode]
            context.assign_comment_and_source_map_ranges(r, node)
            set r.pos: node.pos
            set r.end: node.end
            return r
        }
        node
    }

    ; isDeclarationNameOfEnumOrNamespace (moduletransforms/utilities.go)
    procedure cjs_is_declaration_name_of_enum_or_namespace(this, node: ref[AstNode]) returns bool
    {
        let original context.most_original(node)
        if original = null
            return false
        let o original as ref[AstNode]
        let parent AstNode.parent_node_of(o)
        if parent = null
            return false
        let p parent as ref[AstNode]
        if (p.kind = KindEnumDeclaration) or (p.kind = KindModuleDeclaration)
            return AstNode.name_of(p) = original
        false
    }

    ; isFileLevelReservedGeneratedIdentifier
    function cjs_is_file_level_reserved_generated_identifier(this, name: ref[AstNode]) returns bool
    {
        let info context.get_auto_generate_info(name)
        if info = null
            return false
        let ag info as ref[AutoGenerateInfo]
        let wanted GeneratedIdentifierFlagsFileLevel | GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsReservedInNestedScopes
        (ag.flags & wanted) = wanted
    }

    ; getExports: the exported names of an identifier
    procedure cjs_get_exports(this, name: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let info cjs_info as ref[ExternalModuleInfo]
        if context.has_auto_generate_info(name) = false
        {
            let original context.most_original(name) as ref[AstNode]
            let import_declaration this.the_checker().get_referenced_import_declaration(original)
            if import_declaration <> null
                return info.exported_bindings_of(host, import_declaration as ref[AstNode])
            ; an exported namespace or enum may merge with an ambient declaration
            ; that has no JS emit, so every value export of the symbol is read
            let bindings &Array[ref[AstNode]?]^host()
            let declarations this.the_checker().get_referenced_value_declarations(original)
            if declarations <> null
            {
                let ds declarations as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (ds.get_length() as int)
                {
                    let exported_bindings info.exported_bindings_of(host, ds[i as size_t] as ref[AstNode])
                    var j 0
                    while j < (exported_bindings.get_length() as int)
                    {
                        let binding exported_bindings[j as size_t] as ref[AstNode]
                        if Transformer.list_contains(bindings, binding) = false
                            bindings.add(binding)
                        set j: j + 1
                    }
                    set i: i + 1
                }
            }
            return bindings
        }
        let exported_names &Array[ref[AstNode]?]^host()
        if this.cjs_is_file_level_reserved_generated_identifier(name)
        {
            let export_specifiers info.export_specifiers_of(host, AstNode.identifier_text_of(name))
            var i 0
            while i < (export_specifiers.get_length() as int)
            {
                exported_names.add(AstNode.name_of(export_specifiers[i as size_t]))
                set i: i + 1
            }
        }
        exported_names
    }

    ; ── externalmoduleinfo.go ──

    ; collectExternalModuleInfo
    procedure collect_external_module_info(this, source_file: ref[AstNode]) returns ref[ExternalModuleInfo]
    {
        let out ExternalModuleInfo.create(host)
        set this.cjs_info: out
        set this.cjs_unique_exports: &Array[Slice[char]]^host()
        set this.cjs_has_export_default: false
        var has_import_star false
        var has_import_default false
        let statements AstNode.statements_of(source_file) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (statements.get_length() as int)
        {
            let node statements[i as size_t] as ref[AstNode]
            set i: i + 1
            let k node.kind
            if k = KindNotEmittedStatement
            {
                ; an elided `declare export = x` must still be collected
                let original context.most_original(node)
                if AstNode.kind_of(original) = KindExportAssignment
                {
                    let o original as ref[AstNode]
                    if AstNode.is_export_equals_of(o) and (out.export_equals = null)
                        set out.export_equals: o
                }
                continue
            }
            if k = KindImportDeclaration
            {
                out.external_imports.add(node)
                if (has_import_star = false) and Transformer.cjs_import_needs_import_star_helper(node)
                    set has_import_star: true
                if (has_import_default = false) and Transformer.cjs_import_needs_import_default_helper(node)
                    set has_import_default: true
                continue
            }
            if k = KindImportEqualsDeclaration
            {
                if AstNode.kind_of(AstNode.module_reference_of(node)) = KindExternalModuleReference
                    out.external_imports.add(node)
                continue
            }
            if k = KindExportDeclaration
            {
                let export_clause AstNode.export_clause_of(node)
                if AstNode.module_specifier_of(node) <> null
                {
                    out.external_imports.add(node)
                    if export_clause = null
                        set out.has_export_stars_to_export_values: true
                    else
                    {
                        let ec export_clause as ref[AstNode]
                        if ec.kind = KindNamedExports
                        {
                            this.cjs_add_exported_names_for_export_declaration(node)
                            if has_import_default = false
                                set has_import_default: Transformer.cjs_contains_default_reference(ec)
                        }
                        else
                        {
                            ; export * as ns from "mod"
                            let name AstNode.name_of(ec) as ref[AstNode]
                            if this.cjs_add_unique_export(Checker.module_export_name_text(name))
                            {
                                this.cjs_add_exported_binding(node, name)
                                out.exported_names.add(name)
                            }
                            set has_import_star: true
                        }
                    }
                }
                else
                    this.cjs_add_exported_names_for_export_declaration(node)
                continue
            }
            if k = KindExportAssignment
            {
                if AstNode.is_export_equals_of(node) and (out.export_equals = null)
                    set out.export_equals: node
                continue
            }
            if k = KindVariableStatement
            {
                if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
                {
                    let decls Printer.declarations_of(Printer.declaration_list_of(node) as ref[AstNode]) as ref[Array[ref[AstNode]?]]
                    var d 0
                    while d < (decls.get_length() as int)
                    {
                        this.cjs_collect_exported_variable_info(decls[d as size_t] as ref[AstNode])
                        set d: d + 1
                    }
                }
                continue
            }
            if k = KindFunctionDeclaration
            {
                if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
                    this.cjs_add_exported_function_declaration(node, null, Transformer.has_syntactic_modifier(node, ModifierFlagsDefault))
                continue
            }
            if k = KindClassDeclaration
            {
                if Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
                {
                    if Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
                    {
                        ; export default class { }
                        if cjs_has_export_default = false
                        {
                            var name AstNode.name_of(node)
                            if name = null
                                set name: factory.new_generated_name_for_node(node)
                            this.cjs_add_exported_binding(node, name as ref[AstNode])
                            set this.cjs_has_export_default: true
                        }
                    }
                    else
                    {
                        ; export class x { }
                        let name AstNode.name_of(node)
                        if name <> null
                        {
                            let nm name as ref[AstNode]
                            if this.cjs_add_unique_export(AstNode.identifier_text_of(nm))
                            {
                                this.cjs_add_exported_binding(node, nm)
                                out.exported_names.add(nm)
                            }
                        }
                    }
                }
            }
        }
        out
    }

    function cjs_add_unique_export(this, name: Slice[char]) returns bool
    {
        let u cjs_unique_exports as ref[Array[Slice[char]]]
        if Transformer.names_contain(u, name)
            return false
        u.add(name)
        true
    }

    procedure cjs_remove_unique_export(this, name: Slice[char])
    {
        let u cjs_unique_exports as ref[Array[Slice[char]]]
        let kept &Array[Slice[char]]^host()
        var i 0
        while i < (u.get_length() as int)
        {
            let e u[i as size_t]
            if e.equals(name) = false
                kept.add(e)
            set i: i + 1
        }
        set this.cjs_unique_exports: kept
    }

    procedure cjs_add_exported_binding(this, decl: ref[AstNode], name: ref[AstNode])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        info.exported_bindings.add(CjsExportedBinding(context.most_original(decl) as ref[AstNode], name))
    }

    ; addExportedNamesForExportDeclaration
    procedure cjs_add_exported_names_for_export_declaration(this, node: ref[AstNode])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        let elements AstNode.elements_of(AstNode.export_clause_of(node))
        if elements = null
            return
        let es elements as ref[Array[ref[AstNode]?]]
        let has_module_specifier AstNode.module_specifier_of(node) <> null
        var i 0
        while i < (es.get_length() as int)
        {
            let specifier es[i as size_t] as ref[AstNode]
            set i: i + 1
            let specifier_name AstNode.name_of(specifier) as ref[AstNode]
            let specifier_name_text Checker.module_export_name_text(specifier_name)
            if this.cjs_add_unique_export(specifier_name_text) = false
                continue
            let name Checker.property_name_or_name_of(specifier) as ref[AstNode]
            if name.kind <> KindStringLiteral
            {
                if has_module_specifier = false
                    info.export_specifiers.add(CjsExportSpecifierEntry(AstNode.identifier_text_of(name), specifier))
                let original context.most_original(name) as ref[AstNode]
                var decl this.the_checker().get_referenced_import_declaration(original)
                if decl = null
                    set decl: this.the_checker().get_referenced_value_declaration(original)
                if decl <> null
                {
                    let d decl as ref[AstNode]
                    if d.kind = KindFunctionDeclaration
                    {
                        this.cjs_remove_unique_export(specifier_name_text)
                        this.cjs_add_exported_function_declaration(d, specifier_name, Checker.module_export_name_is_default(specifier_name))
                        continue
                    }
                    this.cjs_add_exported_binding(d, specifier_name)
                }
            }
            info.exported_names.add(specifier_name)
        }
    }

    ; addExportedFunctionDeclaration
    procedure cjs_add_exported_function_declaration(this, node: ref[AstNode], name_in: ref[AstNode]?, is_default: bool)
    {
        let info cjs_info as ref[ExternalModuleInfo]
        let original context.most_original(node) as ref[AstNode]
        if Transformer.list_contains(info.exported_functions, original) = false
            info.exported_functions.add(original)
        var name: ref[AstNode]? name_in
        if is_default
        {
            ; export default function() { }  →  function x() { } + export { x as default };
            if cjs_has_export_default
                return
            if name = null
                set name: factory.new_generated_name_for_node(node)
            this.cjs_add_exported_binding(node, name as ref[AstNode])
            set this.cjs_has_export_default: true
            return
        }
        ; export function x() { }  →  function x() { } + export { x }
        if name = null
            set name: AstNode.name_of(node)
        let nm name as ref[AstNode]
        if this.cjs_add_unique_export(Checker.module_export_name_text(nm))
            this.cjs_add_exported_binding(node, nm)
    }

    ; collectExportedVariableInfo
    procedure cjs_collect_exported_variable_info(this, decl: ref[AstNode])
    {
        let info cjs_info as ref[ExternalModuleInfo]
        let name AstNode.name_of(decl) as ref[AstNode]
        if AstNode.is_binding_pattern(name)
        {
            let elements AstNode.elements_of(name) as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (elements.get_length() as int)
            {
                let element elements[i as size_t] as ref[AstNode]
                if element.kind = KindBindingElement
                {
                    if AstNode.name_of(element) <> null
                        this.cjs_collect_exported_variable_info(element)
                }
                set i: i + 1
            }
            return
        }
        if context.has_auto_generate_info(name)
            return
        let text AstNode.identifier_text_of(name)
        if this.cjs_add_unique_export(text)
        {
            info.exported_names.add(name)
            if (context.emit_flags(name) & EFLocalName) <> 0
                this.cjs_add_exported_binding(decl, name)
        }
    }

    ; ── transformers/destructuring.go: the assignment callback and the helpers
    ;    the flattener asks the transformer for ──

    procedure flatten_create_assignment(this, callback: int, name: ref[AstNode], value: ref[AstNode], has_location: bool, location: TextRange) returns ref[AstNode]
    {
        if callback = FlattenCallbackCommonJS
            return this.cjs_create_all_export_expressions(name, value, has_location, location)
        var target name
        ; runtimesyntax.go createNamespaceExportExpression: `N.x = value`
        if callback = FlattenCallbackNamespace
            set target: this.rs_namespace_qualified_property(this.rs_namespace_container_name(current_namespace as ref[AstNode]), name)
        let expression factory.new_assignment_expression(target, value)
        if has_location
        {
            set expression.pos: location.pos
            set expression.end: location.end
        }
        expression
    }

    ; NewRestHelper (printer/factory.go): __rest(value, ["a", "b", ...])
    procedure new_rest_helper(this, value: ref[AstNode], elements: ref[Array[ref[AstNode]?]], computed_temp_variables: ref[Array[ref[AstNode]?]], pos: int, end: int) returns ref[AstNode]
    {
        let f factory
        context.request_emit_helper(context.helpers.rest_helper)
        let property_names &Array[ref[AstNode]?]^host()
        var computed_temp_variable_offset 0
        let n elements.get_length() as int
        var i 0
        while i < (n - 1)
        {
            let element elements[i as size_t] as ref[AstNode]
            let property_name Transformer.try_get_property_name_of_binding_or_assignment_element(element)
            if property_name <> null
            {
                let pn property_name as ref[AstNode]
                if pn.kind = KindComputedPropertyName
                {
                    let temp computed_temp_variables[computed_temp_variable_offset as size_t] as ref[AstNode]
                    set computed_temp_variable_offset: computed_temp_variable_offset + 1
                    ; typeof _tmp === "symbol" ? _tmp : _tmp + ""
                    let symbol_text: Slice[char] "symbol"
                    let empty: Slice[char] ""
                    property_names.add(f.new_conditional_expression(f.new_type_check(temp, symbol_text), f.new_token(KindQuestionToken), temp, f.new_token(KindColonToken), f.new_binary_expression(null, temp, null, f.new_token(KindPlusToken), f.new_string_literal(empty, TokenFlagsNone))))
                }
                else
                    property_names.add(f.new_string_literal_from_node(pn))
            }
            set i: i + 1
        }
        let prop_names f.new_array_literal_expression(property_names, false)
        set prop_names.pos: pos
        set prop_names.end: end
        let args &Array[ref[AstNode]?]^host()
        args.add(value)
        args.add(prop_names)
        f.helper_call("__rest", args)
    }

    ; ast.TryGetPropertyNameOfBindingOrAssignmentElement
    function try_get_property_name_of_binding_or_assignment_element(binding_element: ref[AstNode]) returns ref[AstNode]?
    {
        let k binding_element.kind
        if k = KindBindingElement
        {
            ; `a` in `let { a: b } = ...`, `[a]`, `"a"`, `1`
            let property_name AstNode.property_name_of(binding_element)
            if property_name <> null
            {
                let pn property_name as ref[AstNode]
                if (pn.kind = KindComputedPropertyName) and Binder.is_string_or_numeric_literal_like(AstNode.expression_of(pn))
                    return AstNode.expression_of(pn)
                return pn
            }
        }
        if k = KindPropertyAssignment
        {
            let property_name AstNode.name_of(binding_element)
            if property_name <> null
            {
                let pn property_name as ref[AstNode]
                if (pn.kind = KindComputedPropertyName) and Binder.is_string_or_numeric_literal_like(AstNode.expression_of(pn))
                    return AstNode.expression_of(pn)
                return pn
            }
        }
        if k = KindSpreadAssignment
            return AstNode.name_of(binding_element)
        let target Emitter.target_of_binding_or_assignment_element(binding_element)
        if target <> null
        {
            if Checker.is_property_name_kind(AstNode.kind_of(target))
                return target
        }
        null
    }

    ; ast.GetRestIndicatorOfBindingOrAssignmentElement
    function rest_indicator_of_binding_or_assignment_element(binding_element: ref[AstNode]) returns ref[AstNode]?
    {
        let k binding_element.kind
        if (k = KindParameter) or (k = KindBindingElement)
            return AstNode.dot_dot_dot_token_of(binding_element)
        if (k = KindSpreadElement) or (k = KindSpreadAssignment)
            return binding_element
        null
    }

    ; GetInitializerOfBindingOrAssignmentElement
    function get_initializer_of_binding_or_assignment_element(binding_element: ref[AstNode]?) returns ref[AstNode]?
    {
        if binding_element = null
            return null
        let be binding_element as ref[AstNode]
        if Emitter.is_declaration_binding_element(be)
            return AstNode.initializer_of(be)
        if be.kind = KindPropertyAssignment
        {
            let initializer AstNode.initializer_of(be)
            if initializer <> null
            {
                let init_node initializer as ref[AstNode]
                if Emitter.is_assignment_expression(init_node, true)
                    return AstNode.binary_right_of(init_node)
            }
            return null
        }
        if be.kind = KindShorthandPropertyAssignment
            return AstNode.shorthand_object_assignment_initializer_of(be)
        if Emitter.is_assignment_expression(be, true)
            return AstNode.binary_right_of(be)
        if be.kind = KindSpreadElement
            return Transformer.get_initializer_of_binding_or_assignment_element(AstNode.expression_of(be))
        null
    }

    ; BindingOrAssignmentElementAssignsToName
    function binding_or_assignment_element_assigns_to_name(element: ref[AstNode], name: Slice[char]) returns bool
    {
        let target Emitter.target_of_binding_or_assignment_element(element)
        if target = null
            return false
        let t target as ref[AstNode]
        if AstNode.is_binding_pattern(t) or Emitter.is_assignment_pattern(t)
        {
            let elements Emitter.pattern_elements_of(t)
            if elements = null
                return false
            let es elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (es.get_length() as int)
            {
                if Transformer.binding_or_assignment_element_assigns_to_name(es[i as size_t] as ref[AstNode], name)
                    return true
                set i: i + 1
            }
            return false
        }
        if t.kind = KindIdentifier
            return AstNode.identifier_text_of(t).equals(name)
        false
    }

    ; BindingOrAssignmentElementContainsNonLiteralComputedName
    function binding_or_assignment_element_contains_non_literal_computed_name(element: ref[AstNode]) returns bool
    {
        let property_name Transformer.try_get_property_name_of_binding_or_assignment_element(element)
        if property_name <> null
        {
            let pn property_name as ref[AstNode]
            if (pn.kind = KindComputedPropertyName) and (Printer.is_literal_kind(AstNode.kind_of(AstNode.expression_of(pn))) = false)
                return true
        }
        let target Emitter.target_of_binding_or_assignment_element(element)
        if target = null
            return false
        let t target as ref[AstNode]
        if (AstNode.is_binding_pattern(t) = false) and (Emitter.is_assignment_pattern(t) = false)
            return false
        let elements Emitter.pattern_elements_of(t)
        if elements = null
            return false
        let es elements as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (es.get_length() as int)
        {
            if Transformer.binding_or_assignment_element_contains_non_literal_computed_name(es[i as size_t] as ref[AstNode])
                return true
            set i: i + 1
        }
        false
    }

    ; isSimpleBindingOrAssignmentElement
    function is_simple_binding_or_assignment_element(element: ref[AstNode]) returns bool
    {
        let target Emitter.target_of_binding_or_assignment_element(element)
        if target = null
            return true
        let t target as ref[AstNode]
        if t.kind = KindOmittedExpression
            return true
        let property_name Transformer.try_get_property_name_of_binding_or_assignment_element(element)
        if property_name <> null
        {
            if Checker.is_property_name_literal(AstNode.kind_of(property_name)) = false
                return false
        }
        let initializer Transformer.get_initializer_of_binding_or_assignment_element(element)
        if initializer <> null
        {
            if Transformer.is_simple_inlineable_expression(initializer as ref[AstNode]) = false
                return false
        }
        if AstNode.is_binding_pattern(t) or Emitter.is_assignment_pattern(t)
        {
            let elements Emitter.pattern_elements_of(t)
            if elements = null
                return true
            let es elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (es.get_length() as int)
            {
                if Transformer.is_simple_binding_or_assignment_element(es[i as size_t] as ref[AstNode]) = false
                    return false
                set i: i + 1
            }
            return true
        }
        t.kind = KindIdentifier
    }

    ; ═══ estransforms/classfields.go (slice 242) ═══

    ; newClassFieldsTransformer's computed configuration
    procedure cf_configure(this)
    {
        let language_version opts.options.get_emit_script_target()
        let use_define opts.options.get_use_define_for_class_fields()
        set this.cf_legacy_decorators: opts.options.experimental_decorators = TristateTrue
        ; Set semantics when useDefineForClassFields is false
        set this.cf_initializers_using_set: use_define = false
        ; Define semantics when useDefineForClassFields and target < ES2022
        set this.cf_initializers_using_define: use_define and (language_version < ScriptTargetES2022)
        set this.cf_initializers: cf_initializers_using_set or cf_initializers_using_define
        ; private members and class static blocks below ES2022
        set this.cf_private_elements_or_static_blocks: language_version < ScriptTargetES2022
        ; `accessor` fields below ESNext
        set this.cf_auto_accessors: language_version < ScriptTargetLatest
        ; `this` in a static initializer below ES2022, since the assignment moves out of the class body
        set this.cf_this_in_static_initializers: language_version < ScriptTargetES2022
        set this.cf_super_in_static_initializers: cf_this_in_static_initializers
    }

    function cf_visitor(this, sub: int) returns ref[NodeVisitor]
    {
        if cf_visitors = null
        {
            let table &Array[ref[NodeVisitor]?]^host()
            var i 0
            while i <= 10
            {
                table.add(null)
                set i: i + 1
            }
            set this.cf_visitors: table
        }
        let visitors cf_visitors as ref[Array[ref[NodeVisitor]?]]
        let existing visitors[sub as size_t]
        if existing <> null
            return existing as ref[NodeVisitor]
        let v context.new_node_visitor(VisitTagTransformer)
        set v.transformer: this
        set v.sub_tag: sub
        visitors.put(sub as size_t, v)
        v
    }

    function cf_lex_facts(this) returns int
    {
        if cf_lexical_environment = null
            return ClassFactsNone
        let env cf_lexical_environment as ref[ClassLexicalEnv]
        if env.data = null
            return ClassFactsNone
        (env.data as ref[ClassLexicalEnvironment]).facts
    }

    ; tx.lexicalEnvironment != nil && tx.lexicalEnvironment.data != nil
    function cf_lex_data(this) returns ref[ClassLexicalEnvironment]?
    {
        if cf_lexical_environment = null
            return null
        (cf_lexical_environment as ref[ClassLexicalEnv]).data
    }

    ; requiresBlockScopedVar: a class expression directly inside a loop body
    function cf_requires_block_scoped_var(this) returns bool
    {
        if cf_in_iteration_statement = false
            return false
        if cf_current_class_container = null
            return false
        AstNode.kind_of(cf_current_class_container) = KindClassExpression
    }

    ; classExpressionNeedsBlockScopedTemp
    function cf_class_expression_needs_block_scoped_temp(this) returns bool
    {
        if this.cf_requires_block_scoped_var() = false
            return false
        let members Printer.member_list_of(cf_current_class_container as ref[AstNode]) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (members.get_length() as int)
        {
            let member members[i as size_t] as ref[AstNode]
            if (member.kind = KindPropertyDeclaration) and (Transformer.has_static_modifier(member) = false)
            {
                let name AstNode.name_of(member)
                if AstNode.kind_of(name) = KindComputedPropertyName
                    return true
            }
            set i: i + 1
        }
        false
    }

    procedure cf_visit_source_file(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if opts.file_info.is_declaration_file
            return node
        set this.cf_lexical_environment: null
        set this.cf_private_static_elements_in_file: (context.emit_flags(node) & EFTransformPrivateStaticElements) <> 0
        set this.cf_class_aliases: &Array[ClassAliasEntry]^host()
        set this.cf_enclosing_class_declarations: &Array[ref[AstNode]?]^host()
        let visited this.the_visitor().visit_each_child(node) as ref[AstNode]
        let helpers context.read_emit_helpers()
        var h 0
        while h < (helpers.get_length() as int)
        {
            let helper helpers[h as size_t]
            if helper <> null
                context.add_emit_helper(visited, helper as ref[EmitHelper])
            set h: h + 1
        }
        set this.cf_class_aliases: null
        set this.cf_enclosing_class_declarations: &Array[ref[AstNode]?]^host()
        visited
    }

    procedure cf_visit_modifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindAccessorKeyword
        {
            if this.cf_should_transform_auto_accessors_in_current_class()
                return null
            return node
        }
        if Printer.is_modifier_kind(node.kind)
            return node
        null
    }

    ; visitForSubstitution: class alias substitution in subtrees without class
    ; field or lexical this/super transforms — never the name of a property access
    procedure cf_visit_for_substitution(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindIdentifier
            return this.cf_visit_identifier(node)
        if node.kind = KindPropertyAccessExpression
        {
            if AstNode.kind_of(AstNode.name_of(node)) = KindIdentifier
                return this.cf_visit_property_access_expression_for_substitution(node)
        }
        let sv this.cf_visitor(CfSubSubstitution)
        sv.visit_each_child(node)
    }

    function cf_has_class_aliases(this) returns bool
    {
        if cf_class_aliases = null
            return false
        (cf_class_aliases as ref[Array[ClassAliasEntry]]).get_length() > 0
    }

    ; visit: the main visitor
    procedure visit_class_fields(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let grandparent this.push_node(node)
        let result this.cf_visit_no_stack(node)
        this.pop_node(grandparent)
        result
    }

    procedure cf_visit_no_stack(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (Emitter.subtree_facts(node) & (SubtreeContainsClassFields | SubtreeContainsLexicalThisOrSuper)) = 0
        {
            ; alias substitution continues into non-class-field subtrees
            if (cf_current_class_container <> null) and this.cf_has_class_aliases()
                return this.cf_visit_for_substitution(node)
            return node
        }
        let k node.kind
        if k = KindSourceFile
            return this.cf_visit_source_file(node)
        if k = KindClassDeclaration
            return this.cf_visit_class_declaration(node)
        if k = KindClassExpression
            return this.cf_visit_class_expression(node)
        if (k = KindClassStaticBlockDeclaration) or (k = KindPropertyDeclaration)
        {
            ; "Use `classElementVisitor` instead."
            this.record_unported("class-fields-element-outside-class", k)
            return node
        }
        if k = KindPropertyAssignment
            return this.cf_visit_named_evaluation_site(node, false, false)
        if k = KindVariableStatement
            return this.cf_visit_variable_statement(node)
        if (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
            return this.cf_visit_named_evaluation_site(node, false, false)
        if k = KindExportAssignment
            return this.cf_visit_named_evaluation_site(node, true, true)
        if k = KindPrivateIdentifier
            return this.cf_visit_private_identifier(node)
        if k = KindPropertyAccessExpression
            return this.cf_visit_property_access_expression(node)
        if k = KindElementAccessExpression
            return this.cf_visit_element_access_expression(node)
        if (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression)
            return this.cf_visit_pre_or_postfix_unary_expression(node, false)
        if k = KindBinaryExpression
            return this.cf_visit_binary_expression(node, false)
        if k = KindParenthesizedExpression
            return this.cf_visit_parenthesized_expression(node, false)
        if k = KindCallExpression
            return this.cf_visit_call_expression(node)
        if k = KindExpressionStatement
            return this.cf_visit_expression_statement(node)
        if k = KindTaggedTemplateExpression
            return this.cf_visit_tagged_template_expression(node)
        if k = KindForStatement
            return this.cf_visit_for_statement(node)
        if (k = KindForInStatement) or (k = KindForOfStatement) or (k = KindDoStatement) or (k = KindWhileStatement)
            return this.cf_with_in_iteration(true, node)
        if k = KindThisKeyword
            return this.cf_visit_this_expression(node)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression)
        {
            let saved cf_in_iteration_statement
            set this.cf_in_iteration_statement: false
            let result this.cf_visit_function_expression_or_declaration(node)
            set this.cf_in_iteration_statement: saved
            return result
        }
        if (k = KindConstructor) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
        {
            let saved cf_in_iteration_statement
            set this.cf_in_iteration_statement: false
            let result this.cf_with_class_element(node, node)
            set this.cf_in_iteration_statement: saved
            return result
        }
        this.the_visitor().visit_each_child(node)
    }

    ; setInIterationStatementAnd(inIteration, visitEachChildOfNode, node)
    procedure cf_with_in_iteration(this, in_iteration: bool, node: ref[AstNode]) returns ref[AstNode]?
    {
        let saved cf_in_iteration_statement
        set this.cf_in_iteration_statement: in_iteration
        let result this.the_visitor().visit_each_child(node)
        set this.cf_in_iteration_statement: saved
        result
    }

    ; setCurrentClassElementAnd(classElement, visitEachChildOfNode, node)
    procedure cf_with_class_element(this, class_element: ref[AstNode]?, node: ref[AstNode]) returns ref[AstNode]?
    {
        let saved cf_current_class_element
        set this.cf_current_class_element: class_element
        let result this.the_visitor().visit_each_child(node)
        set this.cf_current_class_element: saved
        result
    }

    ; the named-evaluation sites: PropertyAssignment, VariableDeclaration,
    ; Parameter, BindingElement, ExportAssignment (default / `""` for export=)
    procedure cf_visit_named_evaluation_site(this, node_in: ref[AstNode], is_export_assignment: bool, ignore_empty: bool) returns ref[AstNode]?
    {
        var node node_in
        if this.cf_is_named_evaluation_needing_name(node)
        {
            var assigned_name: Slice[char] ""
            if is_export_assignment and (AstNode.is_export_equals_of(node) = false)
                set assigned_name: "default"
            set node: Transformer.transform_named_evaluation(context, node, ignore_empty, assigned_name)
        }
        this.the_visitor().visit_each_child(node)
    }

    ; isNamedEvaluationAnd(ctx, node, isAnonymousClassNeedingAssignedName)
    function cf_is_named_evaluation_needing_name(this, node: ref[AstNode]) returns bool
    {
        if Transformer.is_named_evaluation_source(node) = false
            return false
        let k node.kind
        var expr: ref[AstNode]? null
        if k = KindShorthandPropertyAssignment
            set expr: AstNode.shorthand_object_assignment_initializer_of(node)
        if (k = KindPropertyAssignment) or (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement) or (k = KindPropertyDeclaration)
            set expr: AstNode.initializer_of(node)
        if k = KindBinaryExpression
            set expr: AstNode.binary_right_of(node)
        if k = KindExportAssignment
            set expr: Checker.export_assignment_expression_of(node)
        if Transformer.is_anonymous_function_definition(context, expr) = false
            return false
        let inner Parser.skip_outer_expressions(expr, OEKAll) as ref[AstNode]
        this.cf_is_anonymous_class_needing_assigned_name(inner)
    }

    ; visitDiscardedValue
    procedure cf_visit_discarded_value(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if (k = KindPrefixUnaryExpression) or (k = KindPostfixUnaryExpression)
            return this.cf_visit_pre_or_postfix_unary_expression(node, true)
        if k = KindBinaryExpression
            return this.cf_visit_binary_expression(node, true)
        if k = KindParenthesizedExpression
            return this.cf_visit_parenthesized_expression(node, true)
        this.visit_class_fields(node)
    }

    ; visitHeritageClause
    procedure cf_visit_heritage_clause(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindHeritageClause
        {
            let hv this.cf_visitor(CfSubHeritageClause)
            return hv.visit_each_child(node)
        }
        if node.kind = KindExpressionWithTypeArguments
            return this.cf_visit_expression_with_type_arguments_in_heritage_clause(node)
        this.visit_class_fields(node)
    }

    ; visitAssignmentTarget
    procedure cf_visit_assignment_target(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (node.kind = KindObjectLiteralExpression) or (node.kind = KindArrayLiteralExpression)
            return this.cf_visit_assignment_pattern(node)
        this.visit_class_fields(node)
    }

    ; the `super` rewrite in a static initializer applies when: the option, a
    ; current static element, a lexical environment with data
    function cf_static_super_context(this) returns ref[ClassLexicalEnvironment]?
    {
        if cf_super_in_static_initializers = false
            return null
        if cf_current_class_element = null
            return null
        if Transformer.is_static_property_declaration_or_class_static_block(cf_current_class_element as ref[AstNode]) = false
            return null
        this.cf_lex_data()
    }

    procedure cf_visit_destructuring_assignment_target(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (node.kind = KindObjectLiteralExpression) or (node.kind = KindArrayLiteralExpression)
            return this.cf_visit_assignment_pattern(node)
        if node.kind = KindPropertyAccessExpression
        {
            if AstNode.kind_of(AstNode.name_of(node)) = KindPrivateIdentifier
                return this.cf_wrap_private_identifier_for_destructuring_target(node)
        }
        if Checker.is_super_property(node)
        {
            let data this.cf_static_super_context()
            if data <> null
            {
                let d data as ref[ClassLexicalEnvironment]
                if (d.facts & ClassFactsClassWasDecorated) <> 0
                    return this.cf_visit_invalid_super_property(node)
                if (d.class_constructor <> null) and (d.super_class_reference <> null)
                {
                    var name: ref[AstNode]? null
                    if node.kind = KindElementAccessExpression
                        set name: v.visit_node(AstNode.element_access_argument_of(node))
                    if node.kind = KindPropertyAccessExpression
                    {
                        let pn AstNode.name_of(node) as ref[AstNode]
                        if pn.kind = KindIdentifier
                            set name: f.new_string_literal_from_node(pn)
                    }
                    if name <> null
                    {
                        let temp f.new_temp_variable()
                        let set_expr f.new_reflect_set_call(d.super_class_reference as ref[AstNode], name as ref[AstNode], temp, d.class_constructor as ref[AstNode])
                        return f.new_assignment_target_wrapper(temp, set_expr)
                    }
                }
            }
        }
        v.visit_each_child(node)
    }

    ; visitClassElement
    procedure cf_visit_class_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let k node.kind
        if k = KindConstructor
        {
            let saved cf_current_class_element
            set this.cf_current_class_element: node
            let result this.cf_visit_constructor_declaration(node)
            set this.cf_current_class_element: saved
            return result
        }
        if (k = KindGetAccessor) or (k = KindSetAccessor) or (k = KindMethodDeclaration)
        {
            let saved cf_current_class_element
            set this.cf_current_class_element: node
            let result this.cf_visit_method_or_accessor_declaration(node)
            set this.cf_current_class_element: saved
            return result
        }
        if k = KindPropertyDeclaration
        {
            let saved cf_current_class_element
            set this.cf_current_class_element: node
            let result this.cf_visit_property_declaration(node)
            set this.cf_current_class_element: saved
            return result
        }
        if k = KindClassStaticBlockDeclaration
        {
            let saved cf_current_class_element
            set this.cf_current_class_element: node
            let result this.cf_visit_class_static_block_declaration(node)
            set this.cf_current_class_element: saved
            return result
        }
        if k = KindComputedPropertyName
            return this.cf_visit_computed_property_name(node)
        if k = KindSemicolonClassElement
            return node
        if Printer.is_modifier_kind(k) or (k = KindDecorator)
            return this.cf_visit_modifier(node)
        this.visit_class_fields(node)
    }

    ; visitPropertyName
    procedure cf_visit_property_name(this, name: ref[AstNode]?) returns ref[AstNode]?
    {
        if AstNode.kind_of(name) = KindComputedPropertyName
            return this.cf_visit_computed_property_name(name as ref[AstNode])
        this.the_visitor().visit_node(name)
    }

    ; visitAccessorFieldResult: the second pass over an auto-accessor's three results
    procedure cf_visit_accessor_field_result(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindPropertyDeclaration
            return this.cf_transform_field_initializer(node)
        if (node.kind = KindGetAccessor) or (node.kind = KindSetAccessor)
            return this.cf_visit_class_element(node)
        this.record_unported("class-fields-accessor-result", node.kind)
        null
    }

    function cf_class_alias_of(this, declaration: ref[AstNode]) returns ref[AstNode]?
    {
        if cf_class_aliases = null
            return null
        let aliases cf_class_aliases as ref[Array[ClassAliasEntry]]
        var i 0
        while i < (aliases.get_length() as int)
        {
            let e aliases[i as size_t]
            if Transformer.same_node(e.node, declaration)
                return e.alias
            set i: i + 1
        }
        null
    }

    procedure cf_set_class_alias(this, declaration: ref[AstNode], alias: ref[AstNode])
    {
        let aliases cf_class_aliases as ref[Array[ClassAliasEntry]]
        var i 0
        while i < (aliases.get_length() as int)
        {
            let e aliases[i as size_t]
            if Transformer.same_node(e.node, declaration)
            {
                aliases.put(i as size_t, ClassAliasEntry(declaration, alias))
                return
            }
            set i: i + 1
        }
        aliases.add(ClassAliasEntry(declaration, alias))
    }

    ; visitIdentifier: Strada's trySubstituteClassAlias — an identifier that
    ; resolves to a class declaration with a registered alias
    procedure cf_visit_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let declaration this.the_checker().get_referenced_value_declaration(context.most_original(node) as ref[AstNode])
        if declaration = null
            return node
        let d declaration as ref[AstNode]
        let alias this.cf_class_alias_of(d)
        if alias = null
            return node
        if Transformer.list_contains(cf_enclosing_class_declarations, d) = false
            return node
        let cloned factory.clone(alias as ref[AstNode])
        context.set_source_map_range(cloned, TextRange(node.pos, node.end))
        context.set_comment_range(cloned, TextRange(node.pos, node.end))
        cloned
    }

    ; visitPrivateIdentifier: an undeclared private name becomes an empty identifier
    procedure cf_visit_private_identifier(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if cf_private_elements_or_static_blocks = false
            return node
        if parent_node <> null
        {
            if Checker.is_statement(parent_node as ref[AstNode])
                return node
        }
        let empty: Slice[char] ""
        let result factory.new_identifier(empty)
        context.set_original(result, node)
        result
    }

    ; transformPrivateIdentifierInInExpression: `#id in expr`
    procedure cf_transform_private_identifier_in_in_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let info this.cf_access_private_identifier(AstNode.binary_left_of(node) as ref[AstNode])
        if info <> null
        {
            let i info as ref[PrivateIdentifierInfo]
            let receiver this.the_visitor().visit_node(AstNode.binary_right_of(node)) as ref[AstNode]
            let result factory.new_class_private_field_in_helper(i.brand_check_identifier as ref[AstNode], receiver)
            context.set_original(result, node)
            return result
        }
        ; an undeclared private name: later transformers report it
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_variable_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let saved_pending_statements cf_pending_statements
        set this.cf_pending_statements: null
        let visited_node this.the_visitor().visit_each_child(node)
        if cf_pending_statements <> null
        {
            let ps cf_pending_statements as ref[Array[ref[AstNode]?]]
            if ps.get_length() > 0
            {
                let result &Array[ref[AstNode]?]^host()
                result.add(visited_node)
                Transformer.add_all(result, ps)
                set this.cf_pending_statements: saved_pending_statements
                return factory.new_syntax_list(result)
            }
        }
        set this.cf_pending_statements: saved_pending_statements
        visited_node
    }

    procedure cf_add_pending_expression(this, expression: ref[AstNode])
    {
        if cf_pending_expressions = null
            set this.cf_pending_expressions: &Array[ref[AstNode]?]^host()
        (cf_pending_expressions as ref[Array[ref[AstNode]?]]).add(expression)
    }

    procedure cf_add_pending_statement(this, statement: ref[AstNode])
    {
        if cf_pending_statements = null
            set this.cf_pending_statements: &Array[ref[AstNode]?]^host()
        (cf_pending_statements as ref[Array[ref[AstNode]?]]).add(statement)
    }

    function cf_pending_expression_count(this) returns int
    {
        if cf_pending_expressions = null
            return 0
        (cf_pending_expressions as ref[Array[ref[AstNode]?]]).get_length() as int
    }

    ; injectPendingExpressions
    procedure cf_inject_pending_expressions(this, expression_in: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if this.cf_pending_expression_count() = 0
            return expression_in
        let pending cf_pending_expressions as ref[Array[ref[AstNode]?]]
        var expression expression_in
        if expression_in.kind = KindParenthesizedExpression
        {
            pending.add(AstNode.expression_of(expression_in))
            set expression: f.update_parenthesized_expression(expression_in, f.inline_expressions(pending))
        }
        else
        {
            pending.add(expression_in)
            set expression: f.inline_expressions(pending) as ref[AstNode]
        }
        set this.cf_pending_expressions: null
        expression
    }

    ; visitComputedPropertyName: evaluated in the ENCLOSING scope (the outer
    ; lexical environment), as Strada's onEmitNode switches to it
    procedure cf_visit_computed_property_name(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let saved_lexical_environment cf_lexical_environment
        let saved_inside cf_inside_computed_property_name
        set this.cf_inside_computed_property_name: true
        if cf_lexical_environment <> null
        {
            let env cf_lexical_environment as ref[ClassLexicalEnv]
            if env.previous <> null
                set this.cf_lexical_environment: env.previous
        }
        let expression this.the_visitor().visit_node(AstNode.expression_of(node)) as ref[AstNode]
        set this.cf_lexical_environment: saved_lexical_environment
        set this.cf_inside_computed_property_name: saved_inside
        factory.update_computed_property_name(node, this.cf_inject_pending_expressions(expression))
    }

    procedure cf_visit_constructor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if cf_current_class_container <> null
            return this.cf_transform_constructor(node, cf_current_class_container as ref[AstNode])
        this.the_visitor().visit_each_child(node)
    }

    function cf_should_transform_class_element_to_weak_map(this, node: ref[AstNode]) returns bool
    {
        if cf_private_elements_or_static_blocks
            return true
        this.cf_should_always_transform_private_static_elements(node)
    }

    function cf_should_always_transform_private_static_elements(this, node: ref[AstNode]) returns bool
    {
        if Transformer.has_static_modifier(node) = false
            return false
        (context.emit_flags(node) & EFTransformPrivateStaticElements) <> 0
    }

    ; the flag on a CLASS node (no static modifier to ask for)
    function cf_node_has_transform_private_static_elements_flag(this, node: ref[AstNode]) returns bool
        (context.emit_flags(node) & EFTransformPrivateStaticElements) <> 0

    procedure cf_visit_method_or_accessor_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let cv this.cf_visitor(CfSubClassElement)
        if AstNode.is_private_identifier_class_element_declaration(node) = false
            return cv.visit_each_child(node)
        if this.cf_should_transform_class_element_to_weak_map(node) = false
            return cv.visit_each_child(node)
        ; invalid code stays untransformed
        let info this.cf_access_private_identifier(AstNode.name_of(node) as ref[AstNode])
        if info = null
        {
            this.record_unported("class-fields-undeclared-private-name", node.kind)
            return node
        }
        if (info as ref[PrivateIdentifierInfo]).is_valid = false
            return node
        let function_name this.cf_hoisted_function_name(node)
        if function_name <> null
        {
            let modifiers Transformer.extract_modifiers(host, opts, Printer.modifier_list_of(node), ModifierFlagsAll xor (ModifierFlagsStatic | ModifierFlagsAccessor))
            context.start_variable_environment()
            let saved cf_in_iteration_statement
            set this.cf_in_iteration_statement: false
            let body context.visit_function_body(AstNode.body_of(node), v)
            let params v.visit_nodes(AstNode.parameters_of(node))
            set this.cf_in_iteration_statement: saved
            let func_expr f.new_function_expression(modifiers, AstNode.asterisk_token_of(node), function_name, null, params, null, null, body)
            this.cf_add_pending_expression(f.new_assignment_expression(function_name, func_expr))
        }
        ; the method declaration leaves the class
        null
    }

    ; visitFunctionExpressionOrDeclaration: a function synthesized from a STATIC
    ; class member keeps the current class element so `this` still substitutes
    procedure cf_visit_function_expression_or_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (cf_current_class_element <> null) and (cf_current_class_container <> null)
        {
            let original context.most_original(node)
            if (original <> null) and (Transformer.same_node(original as ref[AstNode], node) = false)
            {
                let members Printer.member_list_of(cf_current_class_container as ref[AstNode]) as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (members.get_length() as int)
                {
                    let member members[i as size_t] as ref[AstNode]
                    let mo context.most_original(member)
                    if mo <> null
                    {
                        if Transformer.same_node(mo as ref[AstNode], original as ref[AstNode]) and Transformer.is_static_member(member)
                            return this.the_visitor().visit_each_child(node)
                    }
                    set i: i + 1
                }
            }
        }
        this.cf_with_class_element(null, node)
    }

    ; getHoistedFunctionName
    function cf_hoisted_function_name(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let info this.cf_access_private_identifier(AstNode.name_of(node) as ref[AstNode])
        if info = null
            return null
        let i info as ref[PrivateIdentifierInfo]
        if i.kind = PrivateKindMethod
            return i.method_name
        if i.kind = PrivateKindAccessor
        {
            if node.kind = KindGetAccessor
                return i.getter_name
            if node.kind = KindSetAccessor
                return i.setter_name
        }
        null
    }

    function cf_try_get_class_this(this) returns ref[AstNode]?
    {
        let class_this this.cf_try_get_class_this_no_container()
        if class_this <> null
            return class_this
        if cf_current_class_container <> null
            return AstNode.name_of(cf_current_class_container)
        null
    }

    function cf_try_get_class_this_no_container(this) returns ref[AstNode]?
    {
        let lex this.cf_get_class_lexical_environment()
        if lex.class_this <> null
            return lex.class_this
        if lex.class_constructor <> null
            return lex.class_constructor
        null
    }

    ; CreateModifiersFromModifierFlags, in the reference's flag order
    procedure cf_modifiers_from_flags(this, flags: int) returns ref[Array[ref[AstNode]?]]
    {
        let f factory
        let result &Array[ref[AstNode]?]^host()
        if (flags & ModifierFlagsExport) <> 0
            result.add(f.new_token(KindExportKeyword))
        if (flags & ModifierFlagsAmbient) <> 0
            result.add(f.new_token(KindDeclareKeyword))
        if (flags & ModifierFlagsDefault) <> 0
            result.add(f.new_token(KindDefaultKeyword))
        if (flags & ModifierFlagsConst) <> 0
            result.add(f.new_token(KindConstKeyword))
        if (flags & ModifierFlagsPublic) <> 0
            result.add(f.new_token(KindPublicKeyword))
        if (flags & ModifierFlagsPrivate) <> 0
            result.add(f.new_token(KindPrivateKeyword))
        if (flags & ModifierFlagsProtected) <> 0
            result.add(f.new_token(KindProtectedKeyword))
        if (flags & ModifierFlagsAbstract) <> 0
            result.add(f.new_token(KindAbstractKeyword))
        if (flags & ModifierFlagsStatic) <> 0
            result.add(f.new_token(KindStaticKeyword))
        if (flags & ModifierFlagsOverride) <> 0
            result.add(f.new_token(KindOverrideKeyword))
        if (flags & ModifierFlagsReadonly) <> 0
            result.add(f.new_token(KindReadonlyKeyword))
        if (flags & ModifierFlagsAccessor) <> 0
            result.add(f.new_token(KindAccessorKeyword))
        if (flags & ModifierFlagsAsync) <> 0
            result.add(f.new_token(KindAsyncKeyword))
        if (flags & ModifierFlagsIn) <> 0
            result.add(f.new_token(KindInKeyword))
        if (flags & ModifierFlagsOut) <> 0
            result.add(f.new_token(KindOutKeyword))
        result
    }

    ; modifiers.ModifierFlags over a list
    function cf_modifier_list_flags(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return 0
        let l list as ref[Array[ref[AstNode]?]]
        var flags 0
        var i 0
        while i < (l.get_length() as int)
        {
            let m l[i as size_t]
            if m <> null
                set flags: flags | AstNode.modifier_to_flag(AstNode.kind_of(m))
            set i: i + 1
        }
        flags
    }

    ; transformAutoAccessor:  accessor x = 1;  →  #x = 1; get x() { return this.#x; } set x(value) { this.#x = value; }
    procedure cf_transform_auto_accessor(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let comment_range context.comment_range(node)
        let source_map_range context.source_map_range(node)
        ; two declarations where there was one: cache a computed property name
        let name AstNode.name_of(node) as ref[AstNode]
        var getter_name name
        var setter_name name
        if name.kind = KindComputedPropertyName
        {
            let ne AstNode.expression_of(name) as ref[AstNode]
            if Transformer.is_simple_inlineable_expression(ne) = false
            {
                let cache_assignment Transformer.find_computed_property_name_cache_assignment(name)
                if cache_assignment <> null
                {
                    set getter_name: f.update_computed_property_name(name, v.visit_node(ne))
                    set setter_name: f.update_computed_property_name(name, AstNode.binary_left_of(cache_assignment))
                }
                else
                {
                    let temp f.new_temp_variable()
                    context.set_source_map_range(temp, TextRange(ne.pos, ne.end))
                    context.add_variable_declaration(temp)
                    let expression v.visit_node(ne)
                    let assignment f.new_assignment_expression(temp, expression)
                    context.set_source_map_range(assignment, TextRange(ne.pos, ne.end))
                    set getter_name: f.update_computed_property_name(name, assignment)
                    set setter_name: f.update_computed_property_name(name, temp)
                }
            }
        }
        let mv this.cf_visitor(CfSubModifier)
        let modifiers mv.visit_modifiers(Printer.modifier_list_of(node))
        let backing_field Transformer.create_accessor_property_backing_field(f, node, modifiers, AstNode.initializer_of(node))
        context.set_original(backing_field, node)
        context.add_emit_flags(backing_field, EFNoComments)
        context.set_source_map_range(backing_field, source_map_range)
        var receiver: ref[AstNode]? null
        if Transformer.is_static_member(node)
            set receiver: this.cf_try_get_class_this()
        if receiver = null
            set receiver: f.new_this_expression()
        let r receiver as ref[AstNode]
        let getter this.cf_create_accessor_property_get_redirector(node, modifiers, getter_name, r)
        context.set_original(getter, node)
        context.set_comment_range(getter, comment_range)
        context.set_source_map_range(getter, source_map_range)
        ; a fresh copy of the modifiers, so comments are not duplicated
        var setter_modifiers: ref[Array[ref[AstNode]?]]? null
        if modifiers <> null
            set setter_modifiers: this.cf_modifiers_from_flags(Transformer.cf_modifier_list_flags(modifiers))
        let setter this.cf_create_accessor_property_set_redirector(node, setter_modifiers, setter_name, r)
        context.set_original(setter, node)
        context.add_emit_flags(setter, EFNoComments)
        context.set_source_map_range(setter, source_map_range)
        ; the results, visited in a second pass
        let three &Array[ref[AstNode]?]^host()
        three.add(backing_field)
        three.add(getter)
        three.add(setter)
        let av this.cf_visitor(CfSubAccessorFieldResult)
        var changed false
        f.new_syntax_list(av.visit_slice(three, &changed))
    }

    procedure cf_transform_private_field_initializer(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let mv this.cf_visitor(CfSubModifier)
        if this.cf_should_transform_class_element_to_weak_map(node)
        {
            ; private elements become WeakMap/WeakSet entries: the node is elided
            let info this.cf_access_private_identifier(AstNode.name_of(node) as ref[AstNode])
            if info = null
            {
                this.record_unported("class-fields-undeclared-private-name", node.kind)
                return node
            }
            let i info as ref[PrivateIdentifierInfo]
            if i.is_valid = false
                return node
            ; a valid private static field while static blocks stay: a static block initializer
            if i.is_static and (cf_private_elements_or_static_blocks = false)
            {
                let statement this.cf_transform_property_or_class_static_block(node, f.new_this_expression())
                if statement <> null
                {
                    let one &Array[ref[AstNode]?]^host()
                    one.add(statement)
                    return f.new_class_static_block_declaration(null, f.new_block(one, true))
                }
            }
            return null
        }
        if cf_initializers_using_set and (Transformer.has_static_modifier(node) = false) and ((this.cf_lex_facts() & ClassFactsWillHoistInitializersToConstructor) <> 0)
            return f.update_property_declaration(node, v.visit_modifiers(Printer.modifier_list_of(node)), AstNode.name_of(node), null, null, null)
        var n node
        if this.cf_is_named_evaluation_needing_name(n)
        {
            let empty: Slice[char] ""
            set n: Transformer.transform_named_evaluation(context, n, false, empty)
        }
        f.update_property_declaration(n, mv.visit_modifiers(Printer.modifier_list_of(n)), this.cf_visit_property_name(AstNode.name_of(n)), null, null, v.visit_node(AstNode.initializer_of(n)))
    }

    procedure cf_transform_public_field_initializer(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let mv this.cf_visitor(CfSubModifier)
        if cf_initializers and (Transformer.is_auto_accessor_property_declaration(node) = false)
        {
            ; the property is elided; its initializer moves to the constructor, and a
            ; computed property name is still evaluated
            let name AstNode.name_of(node) as ref[AstNode]
            let expr this.cf_property_name_expression_if_needed(name, (AstNode.initializer_of(node) <> null) or opts.options.get_use_define_for_class_fields())
            if expr <> null
            {
                let flat &Array[ref[AstNode]?]^host()
                Transformer.cf_flatten_comma_list(expr as ref[AstNode], flat)
                var i 0
                while i < (flat.get_length() as int)
                {
                    this.cf_add_pending_expression(flat[i as size_t] as ref[AstNode])
                    set i: i + 1
                }
            }
            ; at ES2022+ with useDefineForClassFields false, a static initializer becomes
            ; `static { this.x = ...; }` so `this` is the constructor
            if Transformer.is_static_member(node) and (cf_private_elements_or_static_blocks = false)
            {
                let initializer_statement this.cf_transform_property_or_class_static_block(node, f.new_this_expression())
                if initializer_statement <> null
                {
                    let one &Array[ref[AstNode]?]^host()
                    one.add(initializer_statement)
                    let static_block f.new_class_static_block_declaration(null, f.new_block(one, false))
                    context.set_original(static_block, node)
                    context.set_comment_range(static_block, TextRange(node.pos, node.end))
                    context.add_emit_flags(initializer_statement as ref[AstNode], EFNoComments)
                    return static_block
                }
            }
            return null
        }
        f.update_property_declaration(node, mv.visit_modifiers(Printer.modifier_list_of(node)), this.cf_visit_property_name(AstNode.name_of(node)), null, null, v.visit_node(AstNode.initializer_of(node)))
    }

    procedure cf_transform_field_initializer(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if AstNode.is_private_identifier_class_element_declaration(node)
            return this.cf_transform_private_field_initializer(node)
        this.cf_transform_public_field_initializer(node)
    }

    function cf_should_transform_auto_accessors_in_current_class(this) returns bool
    {
        if cf_auto_accessors
            return true
        ; at ESNext with useDefineForClassFields false, only where the class hoists
        ; initializers to the constructor
        (this.cf_lex_facts() & ClassFactsWillHoistInitializersToConstructor) <> 0
    }

    procedure cf_visit_property_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if Transformer.is_auto_accessor_property_declaration(node)
        {
            var transform this.cf_should_transform_auto_accessors_in_current_class()
            if Transformer.has_static_modifier(node) and this.cf_should_always_transform_private_static_elements(node)
                set transform: true
            if transform
                return this.cf_transform_auto_accessor(node)
        }
        this.cf_transform_field_initializer(node)
    }

    function cf_private_kind_text(kind: int) returns Slice[char]
    {
        if kind = PrivateKindMethod
            return "m"
        if kind = PrivateKindAccessor
            return "a"
        "f"
    }

    procedure cf_create_private_identifier_access(this, info: ref[PrivateIdentifierInfo], receiver: ref[AstNode]) returns ref[AstNode]
    {
        let visited this.the_visitor().visit_node(receiver) as ref[AstNode]
        this.cf_create_private_identifier_access_helper(info, visited)
    }

    procedure cf_create_private_identifier_access_helper(this, info: ref[PrivateIdentifierInfo], receiver: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        context.set_comment_range(receiver, TextRange(0 - 1, receiver.end))
        let state info.brand_check_identifier as ref[AstNode]
        let kind_text Transformer.cf_private_kind_text(info.kind)
        if info.kind = PrivateKindAccessor
            return f.new_class_private_field_get_helper(receiver, state, kind_text, info.getter_name)
        if info.kind = PrivateKindMethod
            return f.new_class_private_field_get_helper(receiver, state, kind_text, info.method_name)
        var fn: ref[AstNode]? null
        if info.is_static
            set fn: info.variable_name
        f.new_class_private_field_get_helper(receiver, state, kind_text, fn)
    }

    procedure cf_visit_property_access_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let name AstNode.name_of(node) as ref[AstNode]
        if name.kind = KindPrivateIdentifier
        {
            let info this.cf_access_private_identifier(name)
            if info <> null
            {
                let result this.cf_create_private_identifier_access(info as ref[PrivateIdentifierInfo], AstNode.expression_of(node) as ref[AstNode])
                context.set_original(result, node)
                set result.pos: node.pos
                set result.end: node.end
                return result
            }
        }
        if Checker.is_super_property(node) and (name.kind = KindIdentifier)
        {
            let data this.cf_static_super_context()
            if data <> null
            {
                let d data as ref[ClassLexicalEnvironment]
                if (d.facts & ClassFactsClassWasDecorated) <> 0
                    return this.cf_visit_invalid_super_property(node)
                if (d.class_constructor <> null) and (d.super_class_reference <> null)
                {
                    ; `super.x` → `Reflect.get(_baseTemp, "x", _classTemp)`
                    let expr AstNode.expression_of(node) as ref[AstNode]
                    let super_property f.new_reflect_get_call(d.super_class_reference as ref[AstNode], f.new_string_literal_from_node(name), d.class_constructor as ref[AstNode])
                    context.set_original(super_property, expr)
                    set super_property.pos: expr.pos
                    set super_property.end: expr.end
                    return super_property
                }
            }
        }
        ; only the expression is visited when the name is an identifier, so a
        ; property name is never substituted with a class alias
        if name.kind = KindIdentifier
            return this.cf_visit_property_access_expression_for_substitution(node)
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_property_access_expression_for_substitution(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expr AstNode.expression_of(node) as ref[AstNode]
        let expression this.the_visitor().visit_node(expr)
        if expression = null
            return node
        if Transformer.same_node(expression as ref[AstNode], expr)
            return node
        factory.update_property_access_expression(node, expression, AstNode.question_dot_token_of(node), AstNode.name_of(node), node.flags)
    }

    procedure cf_visit_element_access_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if Checker.is_super_property(node)
        {
            let data this.cf_static_super_context()
            if data <> null
            {
                let d data as ref[ClassLexicalEnvironment]
                if (d.facts & ClassFactsClassWasDecorated) <> 0
                    return this.cf_visit_invalid_super_property(node)
                if (d.class_constructor <> null) and (d.super_class_reference <> null)
                {
                    ; `super[x]` → `Reflect.get(_baseTemp, x, _classTemp)`
                    let expr AstNode.expression_of(node) as ref[AstNode]
                    let super_property f.new_reflect_get_call(d.super_class_reference as ref[AstNode], this.the_visitor().visit_node(AstNode.element_access_argument_of(node)) as ref[AstNode], d.class_constructor as ref[AstNode])
                    context.set_original(super_property, expr)
                    set super_property.pos: expr.pos
                    set super_property.end: expr.end
                    return super_property
                }
            }
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_pre_or_postfix_unary_expression(this, node: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let is_prefix node.kind = KindPrefixUnaryExpression
        var operator_kind 0
        var operand: ref[AstNode]? null
        if is_prefix
        {
            set operator_kind: AstNode.prefix_unary_operator_kind(node)
            set operand: AstNode.prefix_unary_operand_of(node)
        }
        else
        {
            set operator_kind: AstNode.postfix_unary_operator_of(node)
            set operand: AstNode.postfix_unary_operand_of(node)
        }
        if (operator_kind = KindPlusPlusToken) or (operator_kind = KindMinusMinusToken)
        {
            let operand_skipped Parser.skip_parentheses(operand) as ref[AstNode]
            var is_private_access false
            if operand_skipped.kind = KindPropertyAccessExpression
            {
                if AstNode.kind_of(AstNode.name_of(operand_skipped)) = KindPrivateIdentifier
                    set is_private_access: true
            }
            if is_private_access
            {
                let info this.cf_access_private_identifier(AstNode.name_of(operand_skipped) as ref[AstNode])
                if info <> null
                {
                    let i info as ref[PrivateIdentifierInfo]
                    let receiver v.visit_node(AstNode.expression_of(operand_skipped)) as ref[AstNode]
                    var initialize_expression: ref[AstNode]? null
                    let read_expression this.cf_create_copiable_receiver_expr(receiver, &initialize_expression)
                    var expression this.cf_create_private_identifier_access_helper(i, read_expression)
                    var temp: ref[AstNode]? null
                    if (is_prefix = false) and (discarded = false)
                    {
                        let t f.new_temp_variable()
                        context.add_variable_declaration(t)
                        set temp: t
                    }
                    set expression: Transformer.expand_pre_or_postfix_increment_or_decrement_expression(f, context, node, expression, temp)
                    var assign_receiver read_expression
                    if initialize_expression <> null
                        set assign_receiver: initialize_expression as ref[AstNode]
                    set expression: this.cf_create_private_identifier_assignment(i, assign_receiver, expression, KindEqualsToken)
                    context.set_original(expression, node)
                    set expression.pos: node.pos
                    set expression.end: node.end
                    if temp <> null
                    {
                        set expression: f.new_comma_expression(expression, temp)
                        set expression.pos: node.pos
                        set expression.end: node.end
                    }
                    return expression
                }
            }
            else
            {
                if Checker.is_super_property(operand_skipped)
                {
                    let data this.cf_static_super_context()
                    if data <> null
                    {
                        ; `++super.a` → `(Reflect.set(_baseTemp, "a", (_a = Reflect.get(_baseTemp, "a", _classTemp), _b = ++_a), _classTemp), _b)`
                        let d data as ref[ClassLexicalEnvironment]
                        if (d.facts & ClassFactsClassWasDecorated) <> 0
                        {
                            let visited_expr this.cf_visit_invalid_super_property(operand_skipped)
                            if is_prefix
                                return f.update_prefix_unary_expression(node, operator_kind, visited_expr)
                            return f.update_postfix_unary_expression(node, visited_expr, operator_kind)
                        }
                        if (d.class_constructor <> null) and (d.super_class_reference <> null)
                        {
                            var setter_name: ref[AstNode]? null
                            var getter_name: ref[AstNode]? null
                            if operand_skipped.kind = KindPropertyAccessExpression
                            {
                                let pn AstNode.name_of(operand_skipped) as ref[AstNode]
                                if pn.kind = KindIdentifier
                                {
                                    set getter_name: f.new_string_literal_from_node(pn)
                                    set setter_name: getter_name
                                }
                            }
                            if operand_skipped.kind = KindElementAccessExpression
                            {
                                let arg AstNode.element_access_argument_of(operand_skipped) as ref[AstNode]
                                if Transformer.is_simple_inlineable_expression(arg)
                                {
                                    set getter_name: arg
                                    set setter_name: arg
                                }
                                else
                                {
                                    let g f.new_temp_variable()
                                    context.add_variable_declaration(g)
                                    set getter_name: g
                                    set setter_name: f.new_assignment_expression(g, v.visit_node(arg))
                                }
                            }
                            if (setter_name <> null) and (getter_name <> null)
                            {
                                var expression f.new_reflect_get_call(d.super_class_reference as ref[AstNode], getter_name as ref[AstNode], d.class_constructor as ref[AstNode])
                                set expression.pos: operand_skipped.pos
                                set expression.end: operand_skipped.end
                                var temp: ref[AstNode]? null
                                if discarded = false
                                {
                                    let t f.new_temp_variable()
                                    context.add_variable_declaration(t)
                                    set temp: t
                                }
                                set expression: Transformer.expand_pre_or_postfix_increment_or_decrement_expression(f, context, node, expression, temp)
                                set expression: f.new_reflect_set_call(d.super_class_reference as ref[AstNode], setter_name as ref[AstNode], expression, d.class_constructor as ref[AstNode])
                                context.set_original(expression, node)
                                set expression.pos: node.pos
                                set expression.end: node.end
                                if temp <> null
                                {
                                    set expression: f.new_comma_expression(expression, temp)
                                    set expression.pos: node.pos
                                    set expression.end: node.end
                                }
                                return expression
                            }
                        }
                    }
                }
            }
        }
        v.visit_each_child(node)
    }

    procedure cf_visit_for_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let dv this.cf_visitor(CfSubDiscarded)
        let v this.the_visitor()
        let initializer dv.visit_node(AstNode.initializer_of(node))
        let condition v.visit_node(AstNode.for_condition_of(node))
        let incrementor dv.visit_node(AstNode.for_incrementor_of(node))
        let saved cf_in_iteration_statement
        set this.cf_in_iteration_statement: true
        let body context.visit_iteration_body(Printer.statement_body_of(node), v)
        set this.cf_in_iteration_statement: saved
        factory.update_for_statement(node, initializer, condition, incrementor, body)
    }

    ; visitExpressionStatement: a bare private identifier statement (`#;`) is
    ; kept, so the runtime throws a SyntaxError
    procedure cf_visit_expression_statement(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if (AstNode.kind_of(AstNode.expression_of(node)) = KindPrivateIdentifier) and cf_private_elements_or_static_blocks
            return node
        let dv this.cf_visitor(CfSubDiscarded)
        factory.update_expression_statement(node, dv.visit_node(AstNode.expression_of(node)))
    }

    ; createCopiableReceiverExpr: (readExpression, initializeExpression)
    procedure cf_create_copiable_receiver_expr(this, receiver: ref[AstNode], initialize_expression: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let f factory
        var cloned receiver
        if Printer.node_is_synthesized(receiver) = false
            set cloned: f.clone(receiver)
        if Transformer.is_simple_inlineable_expression(receiver)
        {
            set initialize_expression: null
            return cloned
        }
        let read_expression f.new_temp_variable()
        context.add_variable_declaration(read_expression)
        set initialize_expression: f.new_assignment_expression(read_expression, cloned)
        read_expression
    }

    procedure cf_visit_call_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let callee AstNode.expression_of(node) as ref[AstNode]
        var is_private_call false
        if callee.kind = KindPropertyAccessExpression
        {
            let pn AstNode.name_of(callee) as ref[AstNode]
            if pn.kind = KindPrivateIdentifier
            {
                if this.cf_access_private_identifier(pn) <> null
                    set is_private_call: true
            }
        }
        if is_private_call
        {
            ; obj.#x(): bind `this` through `.call`
            var target: ref[AstNode]? null
            let this_arg this.cf_create_call_binding(callee, &target)
            let visited_target v.visit_node(target) as ref[AstNode]
            let visited_this_arg v.visit_node(this_arg)
            let visited_args v.visit_nodes(AstNode.call_arguments_of(node))
            let all_args &Array[ref[AstNode]?]^host()
            all_args.add(visited_this_arg)
            Transformer.add_all(all_args, visited_args)
            if (node.flags & NodeFlagsOptionalChain) <> 0
                return f.update_call_expression(node, f.new_property_access_expression(visited_target, AstNode.question_dot_token_of(node), f.new_identifier("call"), NodeFlagsOptionalChain), null, null, all_args, node.flags)
            return f.update_call_expression(node, f.new_property_access_expression(visited_target, null, f.new_identifier("call"), NodeFlagsNone), null, null, all_args, node.flags)
        }
        if Checker.is_super_property(callee)
        {
            let data this.cf_static_super_context()
            if data <> null
            {
                let d data as ref[ClassLexicalEnvironment]
                if d.class_constructor <> null
                {
                    ; `super.f(...)` → `Reflect.get(_baseTemp, "f", _classTemp).call(_classTemp, ...)`
                    let args v.visit_nodes(AstNode.call_arguments_of(node))
                    let args_list &Array[ref[AstNode]?]^host()
                    Transformer.add_all(args_list, args)
                    let invocation f.new_function_call_call(v.visit_node(callee) as ref[AstNode], d.class_constructor as ref[AstNode], args_list)
                    context.set_original(invocation, node)
                    set invocation.pos: node.pos
                    set invocation.end: node.end
                    return invocation
                }
            }
        }
        v.visit_each_child(node)
    }

    procedure cf_visit_tagged_template_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let tag AstNode.tagged_template_tag_of(node) as ref[AstNode]
        var is_private_tag false
        if tag.kind = KindPropertyAccessExpression
        {
            let pn AstNode.name_of(tag) as ref[AstNode]
            if pn.kind = KindPrivateIdentifier
            {
                if this.cf_access_private_identifier(pn) <> null
                    set is_private_tag: true
            }
        }
        if is_private_tag
        {
            var target: ref[AstNode]? null
            let this_arg this.cf_create_call_binding(tag, &target)
            let bind_args &Array[ref[AstNode]?]^host()
            bind_args.add(v.visit_node(this_arg))
            let bind_expr f.new_call_expression(f.new_property_access_expression(v.visit_node(target), null, f.new_identifier("bind"), NodeFlagsNone), null, null, bind_args, NodeFlagsNone)
            return f.update_tagged_template_expression(node, bind_expr, null, null, v.visit_node(AstNode.tagged_template_template_of(node)), node.flags)
        }
        if Checker.is_super_property(tag)
        {
            let data this.cf_static_super_context()
            if data <> null
            {
                let d data as ref[ClassLexicalEnvironment]
                if d.class_constructor <> null
                {
                    ; super.f`x` → Reflect.get(_baseTemp, "f", _classTemp).bind(_classTemp)`x`
                    let no_args &Array[ref[AstNode]?]^host()
                    let invocation f.new_function_bind_call(v.visit_node(tag) as ref[AstNode], d.class_constructor as ref[AstNode], no_args)
                    context.set_original(invocation, node)
                    set invocation.pos: node.pos
                    set invocation.end: node.end
                    return f.update_tagged_template_expression(node, invocation, null, null, v.visit_node(AstNode.tagged_template_template_of(node)), node.flags)
                }
            }
        }
        v.visit_each_child(node)
    }

    ; transformClassStaticBlockDeclaration: the block as an IIFE, when static blocks are transformed
    procedure cf_transform_class_static_block_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if cf_private_elements_or_static_blocks = false
            return null
        let body Printer.static_block_body_of(node) as ref[AstNode]
        let body_statements AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
        if Transformer.is_class_this_assignment_block(context, node)
        {
            let first body_statements[0] as ref[AstNode]
            let result v.visit_node(AstNode.expression_of(first))
            ; a no-op `_classThis = _classThis` is dropped
            if result <> null
            {
                let r result as ref[AstNode]
                if Emitter.is_assignment_expression(r, true)
                {
                    let left AstNode.binary_left_of(r)
                    let right AstNode.binary_right_of(r)
                    if left = right
                        return null
                }
            }
            return result
        }
        if Transformer.is_class_named_evaluation_helper_block(context, node)
        {
            let first body_statements[0] as ref[AstNode]
            return v.visit_node(AstNode.expression_of(first))
        }
        context.start_variable_environment()
        let saved cf_current_class_element
        set this.cf_current_class_element: node
        var changed false
        let visited v.visit_slice(body_statements, &changed)
        set this.cf_current_class_element: saved
        let statements context.end_and_merge_variable_environment(visited) as ref[Array[ref[AstNode]?]]
        let iife f.new_immediately_invoked_arrow_function(statements)
        let arrow_function Parser.skip_parentheses(AstNode.expression_of(iife)) as ref[AstNode]
        context.set_original(arrow_function, node)
        context.add_emit_flags(arrow_function, EFNoLexicalArguments)
        ; the statement list keeps the block's range, so detached comments print
        let arrow_body AstNode.body_of(arrow_function) as ref[AstNode]
        var sp 0
        var se 0
        if AstNode.list_range_of(body, body_statements, &sp, &se)
            f.set_list_range(AstNode.statements_of(arrow_body) as ref[Array[ref[AstNode]?]], sp, se)
        context.set_original(iife, node)
        context.assign_source_map_range(iife, node)
        context.add_emit_flags(arrow_function, EFNoLexicalThis)
        iife
    }

    ; isAnonymousClassNeedingAssignedNameWorker
    function cf_is_anonymous_class_needing_assigned_name(this, node: ref[AstNode]) returns bool
    {
        if node.kind <> KindClassExpression
            return false
        if AstNode.name_of(node) <> null
            return false
        let statics this.cf_static_properties_and_class_static_blocks(node)
        var i 0
        while i < (statics.get_length() as int)
        {
            if Transformer.is_class_named_evaluation_helper_block(context, statics[i as size_t] as ref[AstNode])
                return false
            set i: i + 1
        }
        this.cf_has_transformable_statics(node, statics)
    }

    ; the `hasTransformableStatics` predicate the two class visitors share
    function cf_has_transformable_statics(this, node: ref[AstNode], statics: ref[Array[ref[AstNode]?]]) returns bool
    {
        if (cf_private_elements_or_static_blocks = false) and (this.cf_node_has_transform_private_static_elements_flag(node) = false)
            return false
        var i 0
        while i < (statics.get_length() as int)
        {
            let n statics[i as size_t] as ref[AstNode]
            if n.kind = KindClassStaticBlockDeclaration
                return true
            if AstNode.is_private_identifier_class_element_declaration(n)
                return true
            if cf_initializers and Transformer.cf_is_initialized_property(n)
                return true
            set i: i + 1
        }
        false
    }

    function cf_is_initialized_property(n: ref[AstNode]) returns bool
    {
        if n.kind <> KindPropertyDeclaration
            return false
        AstNode.initializer_of(n) <> null
    }

    procedure cf_visit_binary_expression(this, node_in: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        var node node_in
        if Binder.is_destructuring_assignment(node)
        {
            ; ({ x: obj.#x } = ...), ({ x: super.x } = ...)
            let saved_pending cf_pending_expressions
            set this.cf_pending_expressions: null
            let atv this.cf_visitor(CfSubAssignmentTarget)
            let updated f.update_binary_expression(node, null, atv.visit_node(AstNode.binary_left_of(node)), null, AstNode.binary_operator_token_of(node), v.visit_node(AstNode.binary_right_of(node)))
            var result updated
            if this.cf_pending_expression_count() > 0
            {
                let pending cf_pending_expressions as ref[Array[ref[AstNode]?]]
                pending.add(updated)
                set result: f.inline_expressions(pending) as ref[AstNode]
            }
            set this.cf_pending_expressions: saved_pending
            return result
        }
        if Emitter.is_assignment_expression(node, false)
        {
            if this.cf_is_named_evaluation_needing_name(node)
            {
                let empty: Slice[char] ""
                set node: Transformer.transform_named_evaluation(context, node, false, empty)
            }
            let node_left AstNode.binary_left_of(node) as ref[AstNode]
            let left Parser.skip_outer_expressions(node_left, OEKPartiallyEmittedExpressions | OEKParentheses) as ref[AstNode]
            let operator_kind AstNode.binary_operator_kind(node)
            var is_private_target false
            if left.kind = KindPropertyAccessExpression
            {
                if AstNode.kind_of(AstNode.name_of(left)) = KindPrivateIdentifier
                    set is_private_target: true
            }
            if is_private_target
            {
                ; obj.#x = ...
                let info this.cf_access_private_identifier(AstNode.name_of(left) as ref[AstNode])
                if info <> null
                {
                    let result this.cf_create_private_identifier_assignment(info as ref[PrivateIdentifierInfo], AstNode.expression_of(left) as ref[AstNode], AstNode.binary_right_of(node) as ref[AstNode], operator_kind)
                    context.set_original(result, node)
                    set result.pos: node.pos
                    set result.end: node.end
                    return result
                }
            }
            else
            {
                if Checker.is_super_property(node_left)
                {
                    let data this.cf_static_super_context()
                    if data <> null
                    {
                        ; super.x = ..., super[x] = ..., super.x += ...
                        let d data as ref[ClassLexicalEnvironment]
                        if (d.facts & ClassFactsClassWasDecorated) <> 0
                            return f.update_binary_expression(node, null, this.cf_visit_invalid_super_property(node_left), null, AstNode.binary_operator_token_of(node), v.visit_node(AstNode.binary_right_of(node)))
                        if (d.class_constructor <> null) and (d.super_class_reference <> null)
                        {
                            var setter_name: ref[AstNode]? null
                            if node_left.kind = KindElementAccessExpression
                                set setter_name: v.visit_node(AstNode.element_access_argument_of(node_left))
                            if node_left.kind = KindPropertyAccessExpression
                            {
                                let pn AstNode.name_of(node_left) as ref[AstNode]
                                if pn.kind = KindIdentifier
                                    set setter_name: f.new_string_literal_from_node(pn)
                            }
                            if setter_name <> null
                            {
                                ; `super.x = 1` → `(Reflect.set(_baseTemp, "x", _a = 1, _classTemp), _a)`
                                var sn setter_name as ref[AstNode]
                                var expression v.visit_node(AstNode.binary_right_of(node)) as ref[AstNode]
                                if Parser.is_compound_assignment(operator_kind)
                                {
                                    var getter_name sn
                                    if Transformer.is_simple_inlineable_expression(sn) = false
                                    {
                                        let g f.new_temp_variable()
                                        context.add_variable_declaration(g)
                                        set getter_name: g
                                        set sn: f.new_assignment_expression(g, sn)
                                    }
                                    let super_property_get f.new_reflect_get_call(d.super_class_reference as ref[AstNode], getter_name, d.class_constructor as ref[AstNode])
                                    context.set_original(super_property_get, node_left)
                                    set super_property_get.pos: node_left.pos
                                    set super_property_get.end: node_left.end
                                    set expression: f.new_binary_expression(null, super_property_get, null, f.new_token(Transformer.non_assignment_operator_for_compound_assignment(operator_kind)), expression)
                                    set expression.pos: node.pos
                                    set expression.end: node.end
                                }
                                var temp: ref[AstNode]? null
                                if discarded = false
                                {
                                    let t f.new_temp_variable()
                                    context.add_variable_declaration(t)
                                    set temp: t
                                    set expression: f.new_assignment_expression(t, expression)
                                    set expression.pos: node.pos
                                    set expression.end: node.end
                                }
                                set expression: f.new_reflect_set_call(d.super_class_reference as ref[AstNode], sn, expression, d.class_constructor as ref[AstNode])
                                context.set_original(expression, node)
                                set expression.pos: node.pos
                                set expression.end: node.end
                                if temp <> null
                                {
                                    set expression: f.new_comma_expression(expression, temp)
                                    set expression.pos: node.pos
                                    set expression.end: node.end
                                }
                                return expression
                            }
                        }
                    }
                }
            }
        }
        if (AstNode.binary_operator_kind(node) = KindInKeyword) and (AstNode.kind_of(AstNode.binary_left_of(node)) = KindPrivateIdentifier)
            return this.cf_transform_private_identifier_in_in_expression(node)
        v.visit_each_child(node)
    }

    procedure cf_visit_parenthesized_expression(this, node: ref[AstNode], discarded: bool) returns ref[AstNode]?
    {
        if discarded
        {
            let dv this.cf_visitor(CfSubDiscarded)
            return factory.update_parenthesized_expression(node, dv.visit_node(AstNode.expression_of(node)))
        }
        factory.update_parenthesized_expression(node, this.the_visitor().visit_node(AstNode.expression_of(node)))
    }

    procedure cf_create_private_identifier_assignment(this, info: ref[PrivateIdentifierInfo], receiver_in: ref[AstNode], right_in: ref[AstNode], operator_kind: int) returns ref[AstNode]
    {
        let f factory
        let v this.the_visitor()
        var receiver v.visit_node(receiver_in) as ref[AstNode]
        var right v.visit_node(right_in) as ref[AstNode]
        if Parser.is_compound_assignment(operator_kind)
        {
            var initialize_expression: ref[AstNode]? null
            let read_expression this.cf_create_copiable_receiver_expr(receiver, &initialize_expression)
            if initialize_expression <> null
                set receiver: initialize_expression as ref[AstNode]
            else
                set receiver: read_expression
            set right: f.new_binary_expression(null, this.cf_create_private_identifier_access_helper(info, read_expression), null, f.new_token(Transformer.non_assignment_operator_for_compound_assignment(operator_kind)), right)
        }
        context.set_comment_range(receiver, TextRange(0 - 1, receiver.end))
        let state info.brand_check_identifier as ref[AstNode]
        let kind_text Transformer.cf_private_kind_text(info.kind)
        if info.kind = PrivateKindAccessor
            return f.new_class_private_field_set_helper(receiver, state, right, kind_text, info.setter_name)
        if info.kind = PrivateKindMethod
            return f.new_class_private_field_set_helper(receiver, state, right, kind_text, null)
        var fn: ref[AstNode]? null
        if info.is_static
            set fn: info.variable_name
        f.new_class_private_field_set_helper(receiver, state, right, kind_text, fn)
    }

    ; getPrivateInstanceMethodsAndAccessors
    function cf_private_instance_methods_and_accessors(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let out &Array[ref[AstNode]?]^host()
        let members Printer.member_list_of(node)
        if members = null
            return out
        let ms members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ms.get_length() as int)
        {
            let member ms[i as size_t] as ref[AstNode]
            if Transformer.cf_is_non_static_method_or_accessor_with_private_name(member)
                out.add(member)
            set i: i + 1
        }
        out
    }

    ; memberContainsConstructorReference: the walk Strada answered with
    ; NodeCheckFlags.ContainsConstructorReference, done with the resolver
    procedure cf_member_contains_constructor_reference(this, member: ref[AstNode], class_decl: ref[AstNode]) returns bool
    {
        set this.cf_check_class_original: context.most_original(class_decl)
        set this.cf_check_class_name: Printer.declaration_name_of(class_decl)
        set this.cf_check_found: false
        ; only the body and the initializer, never a computed name
        if member.kind = KindClassStaticBlockDeclaration
        {
            let body Printer.static_block_body_of(member)
            if body <> null
                this.cf_check_constructor_reference(body as ref[AstNode])
        }
        else
        {
            let body AstNode.body_of(member)
            if body <> null
                this.cf_check_constructor_reference(body as ref[AstNode])
        }
        if (cf_check_found = false) and (member.kind = KindPropertyDeclaration)
        {
            let initializer AstNode.initializer_of(member)
            if initializer <> null
                this.cf_check_constructor_reference(initializer as ref[AstNode])
        }
        cf_check_found
    }

    procedure cf_check_constructor_reference(this, n: ref[AstNode])
    {
        if cf_check_found
            return
        if n.kind = KindIdentifier
        {
            var is_class_name false
            if cf_check_class_name <> null
                set is_class_name: Transformer.same_node(cf_check_class_name as ref[AstNode], n)
            if is_class_name = false
            {
                let decl this.the_checker().get_referenced_value_declaration(n)
                if (decl <> null) and (cf_check_class_original <> null)
                {
                    if Transformer.same_node(decl as ref[AstNode], cf_check_class_original as ref[AstNode])
                        set this.cf_check_found: true
                }
            }
            return
        }
        ; a property access: the expression only, never the name
        if n.kind = KindPropertyAccessExpression
        {
            this.cf_check_constructor_reference(AstNode.expression_of(n) as ref[AstNode])
            return
        }
        let cv this.cf_visitor(CfSubConstructorReferenceCheck)
        cv.visit_each_child(n)
    }

    ; the walk's visitor: every child checked, the node itself unchanged
    procedure cf_visit_for_constructor_reference_check(this, n: ref[AstNode]) returns ref[AstNode]?
    {
        this.cf_check_constructor_reference(n)
        n
    }

    procedure cf_class_contains_constructor_reference(this, node: ref[AstNode]) returns bool
    {
        let members Printer.member_list_of(node)
        if members = null
            return false
        let ms members as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (ms.get_length() as int)
        {
            if this.cf_member_contains_constructor_reference(ms[i as size_t] as ref[AstNode], node)
                return true
            set i: i + 1
        }
        false
    }

    ; getClassFacts
    procedure cf_get_class_facts(this, node: ref[AstNode]) returns int
    {
        var facts ClassFactsNone
        let original context.most_original(node)
        if original <> null
        {
            let o original as ref[AstNode]
            if Checker.is_class_like(o)
            {
                if this.the_checker().class_or_constructor_parameter_is_decorated(cf_legacy_decorators, o)
                    set facts: facts | ClassFactsClassWasDecorated
            }
        }
        if cf_private_elements_or_static_blocks
        {
            if Transformer.class_has_class_this_assignment(context, node) or Transformer.class_has_explicitly_assigned_name(context, node)
                set facts: facts | ClassFactsNeedsClassConstructorReference
        }
        var contains_public_instance_fields false
        var contains_initialized_public_instance_fields false
        var contains_instance_private_elements false
        var contains_instance_auto_accessors false
        let members Printer.member_list_of(node) as ref[Array[ref[AstNode]?]]
        let has_class_this context.class_this(node) <> null
        let is_nameless AstNode.name_of(node) = null
        var i 0
        while i < (members.get_length() as int)
        {
            let member members[i as size_t] as ref[AstNode]
            set i: i + 1
            if Transformer.is_static_member(member)
            {
                let mname AstNode.name_of(member)
                let is_auto Transformer.is_auto_accessor_property_declaration(member)
                var private_or_auto false
                if mname <> null
                {
                    if (AstNode.kind_of(mname) = KindPrivateIdentifier) or is_auto
                        set private_or_auto: true
                }
                if private_or_auto and cf_private_elements_or_static_blocks
                    set facts: facts | ClassFactsNeedsClassConstructorReference
                else
                {
                    if is_auto and cf_auto_accessors and is_nameless and (has_class_this = false)
                        set facts: facts | ClassFactsNeedsClassConstructorReference
                }
                if (member.kind = KindPropertyDeclaration) or (member.kind = KindClassStaticBlockDeclaration)
                {
                    let mf Emitter.subtree_facts(member)
                    if cf_this_in_static_initializers and ((mf & SubtreeContainsLexicalThis) <> 0)
                    {
                        set facts: facts | ClassFactsNeedsSubstitutionForThisInClassStaticField
                        if (facts & ClassFactsClassWasDecorated) = 0
                            set facts: facts | ClassFactsNeedsClassConstructorReference
                    }
                    if cf_super_in_static_initializers and ((mf & SubtreeContainsLexicalSuper) <> 0)
                    {
                        if (facts & ClassFactsClassWasDecorated) = 0
                            set facts: facts | ClassFactsNeedsClassConstructorReference | ClassFactsNeedsClassSuperReference
                    }
                }
                continue
            }
            let mo context.most_original(member)
            var is_abstract false
            if mo <> null
                set is_abstract: Transformer.has_syntactic_modifier(mo, ModifierFlagsAbstract)
            if is_abstract
                continue
            if Transformer.is_auto_accessor_property_declaration(member)
            {
                set contains_instance_auto_accessors: true
                if AstNode.is_private_identifier_class_element_declaration(member)
                    set contains_instance_private_elements: true
                continue
            }
            if AstNode.is_private_identifier_class_element_declaration(member)
            {
                set contains_instance_private_elements: true
                if this.cf_member_contains_constructor_reference(member, node)
                    set facts: facts | ClassFactsNeedsClassConstructorReference
                continue
            }
            if member.kind = KindPropertyDeclaration
            {
                set contains_public_instance_fields: true
                if AstNode.initializer_of(member) <> null
                    set contains_initialized_public_instance_fields: true
            }
        }
        var will_hoist false
        if cf_initializers_using_define and contains_public_instance_fields
            set will_hoist: true
        if cf_initializers_using_set and contains_initialized_public_instance_fields
            set will_hoist: true
        if cf_private_elements_or_static_blocks and contains_instance_private_elements
            set will_hoist: true
        if cf_private_elements_or_static_blocks and contains_instance_auto_accessors and cf_auto_accessors
            set will_hoist: true
        if will_hoist
            set facts: facts | ClassFactsWillHoistInitializersToConstructor
        facts
    }

    procedure cf_visit_expression_with_type_arguments_in_heritage_clause(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if (this.cf_lex_facts() & ClassFactsNeedsClassSuperReference) <> 0
        {
            let empty: Slice[char] ""
            let temp f.new_temp_variable_ex(GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty)
            context.add_variable_declaration(temp)
            let lex this.cf_get_class_lexical_environment()
            set lex.super_class_reference: temp
            return f.update_expression_with_type_arguments(node, f.new_assignment_expression(temp, this.the_visitor().visit_node(AstNode.expression_of(node))), null)
        }
        let hv this.cf_visitor(CfSubHeritageClause)
        hv.visit_each_child(node)
    }

    ; visitInNewClassLexicalEnvironment: the shared frame of the two class visitors
    procedure cf_visit_in_new_class_lexical_environment(this, node: ref[AstNode], is_declaration: bool) returns ref[AstNode]?
    {
        let f factory
        let saved_current_class_container cf_current_class_container
        let saved_pending_expressions cf_pending_expressions
        let saved_lexical_environment cf_lexical_environment
        set this.cf_current_class_container: node
        set this.cf_pending_expressions: null
        this.cf_start_class_lexical_environment()
        let original context.most_original(node) as ref[AstNode]
        let enclosing cf_enclosing_class_declarations as ref[Array[ref[AstNode]?]]
        enclosing.add(original)
        if cf_private_elements_or_static_blocks or this.cf_node_has_transform_private_static_elements_flag(node)
        {
            ; ast.GetNameOfDeclaration: a class EXPRESSION without a name answers the
            ; name it is assigned to (`const C = class {}` prefixes its privates `_C_`) —
            ; through the CURRENT node's parent only, as the reference: a class an
            ; earlier transformer rebuilt has none and stays unprefixed (§3.5jq 4)
            var name Printer.declaration_name_of(node)
            if (name = null) and (node.kind = KindClassExpression)
                set name: Binder.get_assigned_name(node)
            if AstNode.kind_of(name) = KindIdentifier
            {
                let env this.cf_get_private_identifier_environment()
                set env.class_name: name
            }
            else
            {
                let assigned_name context.assigned_name(node)
                if AstNode.kind_of(assigned_name) = KindStringLiteral
                {
                    let an assigned_name as ref[AstNode]
                    let text_source_node context.text_source(an)
                    if AstNode.kind_of(text_source_node) = KindIdentifier
                    {
                        let env this.cf_get_private_identifier_environment()
                        set env.class_name: text_source_node
                    }
                    else
                    {
                        if Checker.is_identifier_text(AstNode.literal_text_of(an))
                        {
                            let env this.cf_get_private_identifier_environment()
                            set env.class_name: f.new_identifier(AstNode.literal_text_of(an))
                        }
                    }
                }
            }
        }
        if cf_private_elements_or_static_blocks
        {
            let private_instance_methods_and_accessors this.cf_private_instance_methods_and_accessors(node)
            if private_instance_methods_and_accessors.get_length() > 0
            {
                let env this.cf_get_private_identifier_environment()
                let empty: Slice[char] ""
                let instances: Slice[char] "instances"
                set env.weak_set_name: this.cf_create_hoisted_variable_for_class(instances, AstNode.name_of(private_instance_methods_and_accessors[0]) as ref[AstNode], empty)
            }
        }
        let facts this.cf_get_class_facts(node)
        if facts <> ClassFactsNone
        {
            let lex this.cf_get_class_lexical_environment()
            set lex.facts: facts
        }
        var result: ref[AstNode]? null
        if is_declaration
            set result: this.cf_visit_class_declaration_in_new_class_lexical_environment(node, facts)
        else
            set result: this.cf_visit_class_expression_in_new_class_lexical_environment(node, facts)
        this.cf_remove_enclosing_class_declaration(original)
        this.cf_end_class_lexical_environment()
        set this.cf_current_class_container: saved_current_class_container
        set this.cf_pending_expressions: saved_pending_expressions
        set this.cf_lexical_environment: saved_lexical_environment
        result
    }

    procedure cf_remove_enclosing_class_declaration(this, original: ref[AstNode])
    {
        let list cf_enclosing_class_declarations as ref[Array[ref[AstNode]?]]
        let kept &Array[ref[AstNode]?]^host()
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e <> null
            {
                if Transformer.same_node(e as ref[AstNode], original) = false
                    kept.add(e)
            }
            set i: i + 1
        }
        set this.cf_enclosing_class_declarations: kept
    }

    procedure cf_visit_class_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
        this.cf_visit_in_new_class_lexical_environment(node, true)

    procedure cf_new_reserved_temp(this) returns ref[AstNode]
    {
        let empty: Slice[char] ""
        factory.new_temp_variable_ex(GeneratedIdentifierFlagsReservedInNestedScopes, empty, empty)
    }

    procedure cf_visit_class_declaration_in_new_class_lexical_environment(this, node: ref[AstNode], facts: int) returns ref[AstNode]?
    {
        let f factory
        ; private static fields, or a static field with `this`/`super`: a temp holds the class
        var pending_class_reference_assignment: ref[AstNode]? null
        let class_this context.class_this(node)
        if (facts & ClassFactsNeedsClassConstructorReference) <> 0
        {
            ; `_classThis` can be reused only while static blocks are transformed (the
            ; assignment then precedes them); otherwise a decorator's replacement
            ; constructor would be overwritten
            if cf_private_elements_or_static_blocks and (class_this <> null)
            {
                let ct class_this as ref[AstNode]
                let lex this.cf_get_class_lexical_environment()
                set lex.class_constructor: ct
                set pending_class_reference_assignment: f.new_assignment_expression(ct, f.get_local_name(node))
            }
            else
            {
                let temp this.cf_new_reserved_temp()
                context.add_variable_declaration(temp)
                let lex this.cf_get_class_lexical_environment()
                set lex.class_constructor: f.clone(temp)
                set pending_class_reference_assignment: f.new_assignment_expression(temp, f.get_local_name(node))
            }
        }
        if class_this <> null
        {
            let lex this.cf_get_class_lexical_environment()
            set lex.class_this: class_this
        }
        let is_class_with_constructor_reference this.cf_class_contains_constructor_reference(node)
        ; the alias is registered BEFORE the members are visited (substitution is eager here)
        let alias this.cf_get_class_lexical_environment().class_constructor
        if is_class_with_constructor_reference and (alias <> null)
            this.cf_set_class_alias(context.most_original(node) as ref[AstNode], alias as ref[AstNode])
        let mv this.cf_visitor(CfSubModifier)
        let hv this.cf_visitor(CfSubHeritageClause)
        var modifiers mv.visit_modifiers(Printer.modifier_list_of(node))
        let heritage_clauses hv.visit_nodes(AstNode.heritage_clauses_of(node))
        var members_prologue: ref[AstNode]? null
        let members this.cf_transform_class_members(node, &members_prologue)
        let statements &Array[ref[AstNode]?]^host()
        if pending_class_reference_assignment <> null
        {
            let with_first &Array[ref[AstNode]?]^host()
            with_first.add(pending_class_reference_assignment)
            Transformer.add_all(with_first, cf_pending_expressions)
            set this.cf_pending_expressions: with_first
        }
        ; pending expressions from elided or moved computed property names
        if this.cf_pending_expression_count() > 0
            statements.add(f.new_expression_statement(f.inline_expressions(cf_pending_expressions as ref[Array[ref[AstNode]?]]) as ref[AstNode]))
        ; a nameless declaration with static initializers needs a generated name,
        ; since those move outside the class body
        var name AstNode.name_of(node)
        if cf_initializers_using_set or cf_private_elements_or_static_blocks
        {
            let static_properties this.cf_static_properties_and_class_static_blocks(node)
            if static_properties.get_length() > 0
            {
                if name = null
                    set name: f.new_generated_name_for_node(node)
                this.cf_add_property_or_class_static_block_statements(statements, static_properties, f.get_local_name(node))
            }
        }
        let is_export Transformer.has_syntactic_modifier(node, ModifierFlagsExport)
        let is_default Transformer.has_syntactic_modifier(node, ModifierFlagsDefault)
        if (statements.get_length() > 0) and is_export and is_default
        {
            set modifiers: Transformer.extract_modifiers(host, opts, modifiers, ModifierFlagsAll xor ModifierFlagsExportDefault)
            statements.add(f.new_export_assignment(null, false, null, f.get_local_name(node)))
        }
        let updated_class f.update_class_declaration(node, modifiers, name, null, heritage_clauses, members)
        let result &Array[ref[AstNode]?]^host()
        if members_prologue <> null
            result.add(f.new_expression_statement(members_prologue))
        result.add(updated_class)
        Transformer.add_all(result, statements)
        f.new_syntax_list(result)
    }

    procedure cf_visit_class_expression(this, node: ref[AstNode]) returns ref[AstNode]?
        this.cf_visit_in_new_class_lexical_environment(node, false)

    procedure cf_declare_class_temp(this, temp: ref[AstNode])
    {
        if this.cf_class_expression_needs_block_scoped_temp()
            context.add_lexical_declaration(temp)
        else
            context.add_variable_declaration(temp)
    }

    procedure cf_visit_class_expression_in_new_class_lexical_environment(this, node: ref[AstNode], facts: int) returns ref[AstNode]?
    {
        let f factory
        ; a class expression that was a decorated class declaration writes its
        ; pending expressions as STATEMENTS after the variable statement
        let is_decorated_class_declaration (facts & ClassFactsClassWasDecorated) <> 0
        let class_this context.class_this(node)
        if class_this <> null
        {
            let lex this.cf_get_class_lexical_environment()
            set lex.class_this: class_this
        }
        var temp: ref[AstNode]? null
        if (facts & ClassFactsNeedsClassConstructorReference) <> 0
        {
            if (cf_private_elements_or_static_blocks or this.cf_node_has_transform_private_static_elements_flag(node)) and (class_this <> null)
            {
                let lex this.cf_get_class_lexical_environment()
                set lex.class_constructor: class_this
                set temp: class_this
            }
            else
            {
                let t this.cf_new_reserved_temp()
                this.cf_declare_class_temp(t)
                let lex this.cf_get_class_lexical_environment()
                set lex.class_constructor: f.clone(t)
                set temp: t
            }
        }
        let static_properties_or_class_static_blocks this.cf_static_properties_and_class_static_blocks(node)
        ; whether the expression will be wrapped in a temp is decided BEFORE the
        ; members are visited (the alias is substituted eagerly)
        var is_class_with_constructor_reference false
        var has_transformable_statics false
        var defer_temp_declaration false
        if is_decorated_class_declaration = false
        {
            set is_class_with_constructor_reference: this.cf_class_contains_constructor_reference(node)
            set has_transformable_statics: this.cf_has_transformable_statics(node, static_properties_or_class_static_blocks)
            ; private instance elements transformed to WeakMap/WeakSet add pending expressions
            var will_have_private_pending_expressions false
            if cf_private_elements_or_static_blocks
            {
                let members Printer.member_list_of(node) as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (members.get_length() as int)
                {
                    let n members[i as size_t] as ref[AstNode]
                    if AstNode.is_private_identifier_class_element_declaration(n) and (Transformer.has_static_modifier(n) = false) and this.cf_should_transform_class_element_to_weak_map(n)
                        set will_have_private_pending_expressions: true
                    set i: i + 1
                }
            }
            let will_need_temp_wrapper has_transformable_statics or will_have_private_pending_expressions
            if is_class_with_constructor_reference and will_need_temp_wrapper and (this.cf_get_class_lexical_environment().class_constructor = null)
            {
                ; the temp is made early for the alias; its declaration waits, to keep
                ; the reference's declaration order
                let t this.cf_new_reserved_temp()
                set temp: t
                set defer_temp_declaration: true
                let lex this.cf_get_class_lexical_environment()
                set lex.class_constructor: f.clone(t)
            }
            let alias this.cf_get_class_lexical_environment().class_constructor
            if is_class_with_constructor_reference and will_need_temp_wrapper and (alias <> null)
                this.cf_set_class_alias(context.most_original(node) as ref[AstNode], alias as ref[AstNode])
        }
        let mv this.cf_visitor(CfSubModifier)
        let hv this.cf_visitor(CfSubHeritageClause)
        let modifiers mv.visit_modifiers(Printer.modifier_list_of(node))
        let heritage_clauses hv.visit_nodes(AstNode.heritage_clauses_of(node))
        var members_prologue: ref[AstNode]? null
        let members this.cf_transform_class_members(node, &members_prologue)
        if defer_temp_declaration
            this.cf_declare_class_temp(temp as ref[AstNode])
        let class_expression f.update_class_expression(node, modifiers, AstNode.name_of(node), null, heritage_clauses, members)
        let expressions &Array[ref[AstNode]?]^host()
        if members_prologue <> null
            expressions.add(members_prologue)
        if is_decorated_class_declaration = false
        {
            if has_transformable_statics or (this.cf_pending_expression_count() > 0)
            {
                if temp = null
                {
                    let t this.cf_new_reserved_temp()
                    this.cf_declare_class_temp(t)
                    set temp: t
                    let lex this.cf_get_class_lexical_environment()
                    set lex.class_constructor: f.clone(t)
                    if is_class_with_constructor_reference
                        this.cf_set_class_alias(context.most_original(node) as ref[AstNode], lex.class_constructor as ref[AstNode])
                }
                let tp temp as ref[AstNode]
                expressions.add(f.new_assignment_expression(tp, class_expression))
                ; pending expressions left over from elided or relocated computed property names
                Transformer.add_all(expressions, cf_pending_expressions)
                Transformer.add_all(expressions, this.cf_generate_initialized_property_expressions_or_class_static_block(static_properties_or_class_static_blocks, tp))
                expressions.add(f.clone(tp))
            }
            else
                expressions.add(class_expression)
        }
        else
        {
            ; the decorated class declaration path: static properties as statements
            ; through pendingStatements, matching the class declaration's output
            if this.cf_pending_expression_count() > 0
            {
                let pending cf_pending_expressions as ref[Array[ref[AstNode]?]]
                var i 0
                while i < (pending.get_length() as int)
                {
                    this.cf_add_pending_statement(f.new_expression_statement(pending[i as size_t]))
                    set i: i + 1
                }
            }
            if static_properties_or_class_static_blocks.get_length() > 0
            {
                var class_this_or_name class_this
                if class_this_or_name = null
                    set class_this_or_name: f.get_local_name(node)
                if cf_pending_statements = null
                    set this.cf_pending_statements: &Array[ref[AstNode]?]^host()
                this.cf_add_property_or_class_static_block_statements(cf_pending_statements as ref[Array[ref[AstNode]?]], static_properties_or_class_static_blocks, class_this_or_name as ref[AstNode])
            }
            if temp <> null
                expressions.add(f.new_assignment_expression(temp, class_expression))
            else
            {
                if cf_private_elements_or_static_blocks and (class_this <> null)
                    expressions.add(f.new_assignment_expression(class_this, class_expression))
                else
                    expressions.add(class_expression)
            }
        }
        if expressions.get_length() > 1
        {
            context.add_emit_flags(class_expression, EFIndented)
            var i 0
            while i < (expressions.get_length() as int)
            {
                context.add_emit_flags(expressions[i as size_t] as ref[AstNode], EFStartOnNewLine)
                set i: i + 1
            }
        }
        f.inline_expressions(expressions)
    }

    procedure cf_visit_class_static_block_declaration(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if cf_private_elements_or_static_blocks = false
            return this.the_visitor().visit_each_child(node)
        ; static blocks of classes are transformed in the class visitors
        null
    }

    ; visitThisExpression: Strada's substituteThisExpression, done eagerly
    procedure cf_visit_this_expression(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let data this.cf_lex_data()
        if cf_inside_computed_property_name and cf_this_in_static_initializers and (data <> null)
        {
            ; `this` in a computed property name of an ES-decorated class stays: the
            ; decorator transformer wrapped it in an arrow IIFE already
            let d data as ref[ClassLexicalEnvironment]
            if ((d.facts & ClassFactsClassWasDecorated) = 0) or cf_legacy_decorators
            {
                let class_this this.cf_try_get_class_this_no_container()
                if class_this <> null
                    return class_this
            }
        }
        if cf_this_in_static_initializers and (cf_current_class_element <> null) and (data <> null)
        {
            let ce cf_current_class_element as ref[AstNode]
            var static_context ce.kind = KindClassStaticBlockDeclaration
            if (ce.kind = KindPropertyDeclaration) and Transformer.has_static_modifier(ce)
                set static_context: true
            if static_context
            {
                let class_this this.cf_try_get_class_this_no_container()
                if class_this <> null
                    return class_this
                ; a legacy-decorated class without a constructor reference: `(void 0)`
                let d data as ref[ClassLexicalEnvironment]
                if ((d.facts & ClassFactsClassWasDecorated) <> 0) and cf_legacy_decorators
                    return factory.new_parenthesized_expression(factory.new_void_zero_expression())
            }
        }
        node
    }

    ; transformClassMembers: (members, prologue) through the out-cell
    procedure cf_transform_class_members(this, node: ref[AstNode], prologue: ref[ref[AstNode]?]) returns ref[Array[ref[AstNode]?]]?
    {
        let f factory
        set prologue: null
        let should_transform_private_static_elements_in_class (context.emit_flags(node) & EFTransformPrivateStaticElements) <> 0
        let member_list Printer.member_list_of(node) as ref[Array[ref[AstNode]?]]
        ; declare the private names
        if cf_private_elements_or_static_blocks or cf_private_static_elements_in_file
        {
            var i 0
            while i < (member_list.get_length() as int)
            {
                let member member_list[i as size_t] as ref[AstNode]
                if AstNode.is_private_identifier_class_element_declaration(member)
                {
                    if this.cf_should_transform_class_element_to_weak_map(member)
                        this.cf_add_private_identifier_to_environment(member)
                    else
                    {
                        let env this.cf_get_private_identifier_environment()
                        this.cf_set_private_identifier(env, AstNode.name_of(member) as ref[AstNode], &PrivateIdentifierInfo^host(PrivateKindUntransformed, null, false, false, null, null, null, null))
                    }
                }
                set i: i + 1
            }
            if cf_private_elements_or_static_blocks
            {
                if this.cf_private_instance_methods_and_accessors(node).get_length() > 0
                    this.cf_create_brand_check_weak_set_for_private_methods()
            }
            if this.cf_should_transform_auto_accessors_in_current_class()
            {
                var j 0
                while j < (member_list.get_length() as int)
                {
                    let member member_list[j as size_t] as ref[AstNode]
                    if Transformer.is_auto_accessor_property_declaration(member)
                    {
                        let empty: Slice[char] ""
                        let storage_suffix: Slice[char] "_accessor_storage"
                        let storage_name f.new_generated_private_name_for_node_ex(AstNode.name_of(member) as ref[AstNode], 0, empty, storage_suffix)
                        if cf_private_elements_or_static_blocks or (should_transform_private_static_elements_in_class and Transformer.has_static_modifier(member))
                            this.cf_add_private_identifier_property_declaration_to_environment(member, storage_name)
                        else
                        {
                            ; untransformed only where the first loop did not register it
                            ; (an ES-decorated private auto-accessor's backing field)
                            let env this.cf_get_private_identifier_environment()
                            if this.cf_get_private_identifier(env, storage_name) = null
                                this.cf_set_private_identifier(env, storage_name, &PrivateIdentifierInfo^host(PrivateKindUntransformed, null, false, false, null, null, null, null))
                        }
                    }
                    set j: j + 1
                }
            }
        }
        let cv this.cf_visitor(CfSubClassElement)
        var members cv.visit_nodes(member_list) as ref[Array[ref[AstNode]?]]
        ; a synthetic constructor if necessary
        var has_constructor false
        var k 0
        while k < (members.get_length() as int)
        {
            if AstNode.kind_of(members[k as size_t]) = KindConstructor
                set has_constructor: true
            set k: k + 1
        }
        var synthetic_constructor: ref[AstNode]? null
        if has_constructor = false
            set synthetic_constructor: this.cf_transform_constructor(null, node)
        ; pending expressions go into a class static block at the top of the class,
        ; unless static blocks are transformed too
        var synthetic_static_block: ref[AstNode]? null
        if (cf_private_elements_or_static_blocks = false) and (this.cf_pending_expression_count() > 0)
        {
            var statement f.new_expression_statement(f.inline_expressions(cf_pending_expressions as ref[Array[ref[AstNode]?]]) as ref[AstNode])
            if (Emitter.subtree_facts(statement) & SubtreeContainsLexicalThisOrSuper) <> 0
            {
                ; `this` or `super` from a computed property name: evaluated in an arrow
                ; function so the outer scope's are captured
                let temp f.new_temp_variable()
                context.add_variable_declaration(temp)
                let no_params &Array[ref[AstNode]?]^host()
                let block_statements &Array[ref[AstNode]?]^host()
                block_statements.add(statement)
                let arrow f.new_arrow_function(null, null, no_params, null, null, f.new_token(KindEqualsGreaterThanToken), f.new_block(block_statements, false))
                set prologue: f.new_assignment_expression(temp, arrow)
                let no_args &Array[ref[AstNode]?]^host()
                set statement: f.new_expression_statement(f.new_call_expression(temp, null, null, no_args, NodeFlagsNone))
            }
            let one &Array[ref[AstNode]?]^host()
            one.add(statement)
            set synthetic_static_block: f.new_class_static_block_declaration(null, f.new_block(one, false))
            set this.cf_pending_expressions: null
        }
        if (synthetic_constructor <> null) or (synthetic_static_block <> null)
        {
            let members_array &Array[ref[AstNode]?]^host()
            ; the classThis assignment block and the named evaluation helper block stay on top
            var class_this_idx 0 - 1
            var named_eval_idx 0 - 1
            var m 0
            while m < (members.get_length() as int)
            {
                let n members[m as size_t] as ref[AstNode]
                if (class_this_idx < 0) and Transformer.is_class_this_assignment_block(context, n)
                    set class_this_idx: m
                if (named_eval_idx < 0) and Transformer.is_class_named_evaluation_helper_block(context, n)
                    set named_eval_idx: m
                set m: m + 1
            }
            if class_this_idx >= 0
                members_array.add(members[class_this_idx as size_t])
            if named_eval_idx >= 0
                members_array.add(members[named_eval_idx as size_t])
            if synthetic_constructor <> null
                members_array.add(synthetic_constructor)
            if synthetic_static_block <> null
                members_array.add(synthetic_static_block)
            var q 0
            while q < (members.get_length() as int)
            {
                if (q <> class_this_idx) and (q <> named_eval_idx)
                    members_array.add(members[q as size_t])
                set q: q + 1
            }
            var mp 0
            var me 0
            if AstNode.list_range_of(node, member_list, &mp, &me)
                f.set_list_range(members_array, mp, me)
            set members: members_array
        }
        members
    }

    procedure cf_create_brand_check_weak_set_for_private_methods(this)
    {
        let f factory
        let env this.cf_get_private_identifier_environment()
        if env.weak_set_name = null
        {
            this.record_unported("class-fields-weak-set-name", 0)
            return
        }
        let no_args &Array[ref[AstNode]?]^host()
        this.cf_add_pending_expression(f.new_assignment_expression(env.weak_set_name, f.new_new_expression(f.new_identifier("WeakSet"), null, no_args)))
    }

    ; transformConstructor
    procedure cf_transform_constructor(this, constructor: ref[AstNode]?, container: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        if (this.cf_lex_facts() & ClassFactsWillHoistInitializersToConstructor) = 0
        {
            if constructor <> null
                return v.visit_each_child(constructor)
            return null
        }
        let extends_clause_element Checker.get_extends_heritage_clause_element(container)
        var is_derived_class false
        if extends_clause_element <> null
        {
            let base Parser.skip_outer_expressions(AstNode.expression_of(extends_clause_element), OEKAll)
            if AstNode.kind_of(base) <> KindNullKeyword
                set is_derived_class: true
        }
        var parameters: ref[Array[ref[AstNode]?]]? null
        if constructor <> null
            set parameters: v.visit_nodes(AstNode.parameters_of(constructor))
        let body this.cf_transform_constructor_body(container, constructor, is_derived_class)
        if body = null
        {
            if constructor <> null
                return v.visit_each_child(constructor)
            return null
        }
        if constructor <> null
            return f.update_constructor_declaration(constructor as ref[AstNode], null, null, parameters, null, null, body)
        if parameters = null
            set parameters: &Array[ref[AstNode]?]^host()
        let result f.new_constructor_declaration(null, null, parameters, null, null, body)
        set result.pos: container.pos
        set result.end: container.end
        result
    }

    ; the run of parameter-property assignments after the prologue and `super()`
    function cf_skip_parameter_property_statements(this, statements: ref[Array[ref[AstNode]?]], offset_in: int, constructor: ref[AstNode]) returns int
    {
        var offset offset_in
        while offset < (statements.get_length() as int)
        {
            let stmt statements[offset as size_t] as ref[AstNode]
            let orig context.most_original(stmt)
            if orig = null
                return offset
            if Transformer.is_parameter_property_declaration(orig as ref[AstNode], constructor) = false
                return offset
            set offset: offset + 1
        }
        offset
    }

    ; transformConstructorBodyWorker: the statements around a `super()` found at
    ; super_path[depth] (a try statement recurses one level down)
    procedure cf_transform_constructor_body_worker(this, statements_out: ref[Array[ref[AstNode]?]], statements_in: ref[Array[ref[AstNode]?]], statement_offset_in: int, super_path: ref[Array[int]], super_path_depth: int, initializer_statements: ref[Array[ref[AstNode]?]], constructor: ref[AstNode])
    {
        let f factory
        let v this.the_visitor()
        let super_statement_index super_path[super_path_depth as size_t]
        let super_statement statements_in[super_statement_index as size_t] as ref[AstNode]
        var changed false
        ; the statements before super
        Transformer.add_all(statements_out, v.visit_slice(Transformer.sub_list(host, statements_in, statement_offset_in, super_statement_index), &changed))
        var statement_offset super_statement_index + 1
        if super_statement.kind = KindTryStatement
        {
            let try_block AstNode.try_block_of(super_statement) as ref[AstNode]
            let try_statements AstNode.statements_of(try_block) as ref[Array[ref[AstNode]?]]
            let try_block_statements &Array[ref[AstNode]?]^host()
            this.cf_transform_constructor_body_worker(try_block_statements, try_statements, 0, super_path, super_path_depth + 1, initializer_statements, constructor)
            var tp 0
            var te 0
            if AstNode.list_range_of(try_block, try_statements, &tp, &te)
                f.set_list_range(try_block_statements, tp, te)
            let catch_clause v.visit_node(AstNode.catch_clause_of(super_statement))
            let finally_block v.visit_node(AstNode.finally_block_of(super_statement))
            statements_out.add(f.update_try_statement(super_statement, f.update_block(try_block, try_block_statements, AstNode.multi_line_of(try_block)), catch_clause, finally_block))
        }
        else
        {
            Transformer.add_all(statements_out, v.visit_slice(Transformer.sub_list(host, statements_in, super_statement_index, super_statement_index + 1), &changed))
            ; the property initializers follow `super()` and the parameter-property assignments
            set statement_offset: this.cf_skip_parameter_property_statements(statements_in, statement_offset, constructor)
            Transformer.add_all(statements_out, initializer_statements)
        }
        Transformer.add_all(statements_out, v.visit_slice(Transformer.sub_list(host, statements_in, statement_offset, statements_in.get_length() as int), &changed))
    }

    ; transformConstructorBody
    procedure cf_transform_constructor_body(this, container: ref[AstNode], constructor: ref[AstNode]?, is_derived_class: bool) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let instance_properties this.cf_get_properties(container, false, false)
        var properties instance_properties
        if opts.options.get_use_define_for_class_fields() = false
        {
            let filtered &Array[ref[AstNode]?]^host()
            var i 0
            while i < (instance_properties.get_length() as int)
            {
                let prop instance_properties[i as size_t] as ref[AstNode]
                var keep AstNode.initializer_of(prop) <> null
                if AstNode.kind_of(AstNode.name_of(prop)) = KindPrivateIdentifier
                    set keep: true
                if Transformer.has_accessor_modifier(prop)
                    set keep: true
                if keep
                    filtered.add(prop)
                set i: i + 1
            }
            set properties: filtered
        }
        let private_methods_and_accessors this.cf_private_instance_methods_and_accessors(container)
        let needs_constructor_body (properties.get_length() > 0) or (private_methods_and_accessors.get_length() > 0)
        ; a synthetic constructor only where property initializers move
        if (constructor = null) and (needs_constructor_body = false)
            return context.visit_function_body(null, v)
        context.start_variable_environment()
        let needs_synthetic_constructor (constructor = null) and is_derived_class
        let statements &Array[ref[AstNode]?]^host()
        let initializer_statements &Array[ref[AstNode]?]^host()
        let receiver f.new_this_expression()
        ; private methods can be called in property initializers: they come first
        this.cf_add_instance_method_statements(initializer_statements, private_methods_and_accessors, receiver)
        if constructor <> null
        {
            let ctor constructor as ref[AstNode]
            let parameter_properties &Array[ref[AstNode]?]^host()
            let non_parameter_properties &Array[ref[AstNode]?]^host()
            var i 0
            while i < (instance_properties.get_length() as int)
            {
                let prop instance_properties[i as size_t] as ref[AstNode]
                if Transformer.is_parameter_property_declaration(context.most_original(prop) as ref[AstNode], ctor)
                    parameter_properties.add(prop)
                set i: i + 1
            }
            var j 0
            while j < (properties.get_length() as int)
            {
                let prop properties[j as size_t] as ref[AstNode]
                if Transformer.is_parameter_property_declaration(context.most_original(prop) as ref[AstNode], ctor) = false
                    non_parameter_properties.add(prop)
                set j: j + 1
            }
            this.cf_add_property_or_class_static_block_statements(initializer_statements, parameter_properties, receiver)
            this.cf_add_property_or_class_static_block_statements(initializer_statements, non_parameter_properties, receiver)
        }
        else
            this.cf_add_property_or_class_static_block_statements(initializer_statements, properties, receiver)
        var ctor_body: ref[AstNode]? null
        if constructor <> null
            set ctor_body: AstNode.body_of(constructor)
        if ctor_body <> null
        {
            let ctor constructor as ref[AstNode]
            let body ctor_body as ref[AstNode]
            let body_statements AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
            ; the prologue is copied
            var p 0
            while p < (body_statements.get_length() as int)
            {
                let stmt body_statements[p as size_t]
                if EmitContext.is_prologue_directive(stmt) = false
                    break
                statements.add(stmt)
                set p: p + 1
            }
            var statement_offset statements.get_length() as int
            let super_path Transformer.find_super_statement_index_path(host, body_statements, statement_offset)
            var has_super false
            if super_path <> null
            {
                if (super_path as ref[Array[int]]).get_length() > 0
                    set has_super: true
            }
            if has_super
                this.cf_transform_constructor_body_worker(statements, body_statements, statement_offset, super_path as ref[Array[int]], 0, initializer_statements, ctor)
            else
            {
                set statement_offset: this.cf_skip_parameter_property_statements(body_statements, statement_offset, ctor)
                Transformer.add_all(statements, initializer_statements)
                var changed false
                Transformer.add_all(statements, v.visit_slice(Transformer.sub_list(host, body_statements, statement_offset, body_statements.get_length() as int), &changed))
            }
        }
        else
        {
            if needs_synthetic_constructor
            {
                ; super(...arguments);
                let args &Array[ref[AstNode]?]^host()
                args.add(f.new_spread_element(f.new_identifier("arguments")))
                statements.add(f.new_expression_statement(f.new_call_expression(f.new_keyword_expression(KindSuperKeyword), null, null, args, NodeFlagsNone)))
            }
            Transformer.add_all(statements, initializer_statements)
        }
        let merged context.end_and_merge_variable_environment(statements) as ref[Array[ref[AstNode]?]]
        if (merged.get_length() = 0) and (constructor = null)
            return null
        var multi_line false
        if ctor_body <> null
        {
            let body ctor_body as ref[AstNode]
            let body_statements AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
            if body_statements.get_length() >= merged.get_length()
                set multi_line: AstNode.multi_line_of(body)
            else
                set multi_line: merged.get_length() > 0
        }
        else
            set multi_line: merged.get_length() > 0
        if ctor_body <> null
        {
            let body ctor_body as ref[AstNode]
            let body_statements AstNode.statements_of(body) as ref[Array[ref[AstNode]?]]
            var bp 0
            var be 0
            if AstNode.list_range_of(body, body_statements, &bp, &be)
                f.set_list_range(merged, bp, be)
        }
        else
        {
            let member_list Printer.member_list_of(container) as ref[Array[ref[AstNode]?]]
            var mp 0
            var me 0
            if AstNode.list_range_of(container, member_list, &mp, &me)
                f.set_list_range(merged, mp, me)
        }
        let block f.new_block(merged, multi_line)
        if ctor_body <> null
        {
            let body ctor_body as ref[AstNode]
            set block.pos: body.pos
            set block.end: body.end
        }
        block
    }

    ; addPropertyOrClassStaticBlockStatements
    procedure cf_add_property_or_class_static_block_statements(this, statements: ref[Array[ref[AstNode]?]], properties: ref[Array[ref[AstNode]?]], receiver: ref[AstNode])
    {
        var i 0
        while i < (properties.get_length() as int)
        {
            let property properties[i as size_t] as ref[AstNode]
            set i: i + 1
            if Transformer.is_static_member(property) and (cf_private_elements_or_static_blocks = false)
                continue
            let statement this.cf_transform_property_or_class_static_block(property, receiver)
            if statement <> null
                statements.add(statement)
        }
    }

    procedure cf_transform_property_or_class_static_block(this, property: ref[AstNode], receiver: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        var expression: ref[AstNode]? null
        if property.kind = KindClassStaticBlockDeclaration
        {
            let saved cf_current_class_element
            set this.cf_current_class_element: property
            set expression: this.cf_transform_class_static_block_declaration(property)
            set this.cf_current_class_element: saved
        }
        else
            set expression: this.cf_transform_property(property, receiver)
        if expression = null
            return null
        let e expression as ref[AstNode]
        let statement f.new_expression_statement(e)
        context.set_original(statement, property)
        context.add_emit_flags(statement, context.emit_flags(property) & EFNoComments)
        context.set_comment_range(statement, TextRange(property.pos, property.end))
        let property_original_node context.most_original(property) as ref[AstNode]
        if property_original_node.kind = KindParameter
        {
            context.set_source_map_range(statement, TextRange(property_original_node.pos, property_original_node.end))
            context.add_emit_flags(statement, EFNoComments)
        }
        else
            context.set_source_map_range(statement, Transformer.move_range_past_modifiers(property))
        ; setOriginal copied the emit node: the expression drops its synthesized comments
        context.set_synthetic_leading_comments(e, null)
        context.set_synthetic_trailing_comments(e, null)
        ; an auto-accessor's comments belong to the synthesized getter
        if Transformer.has_accessor_modifier(property_original_node)
            context.add_emit_flags(statement, EFNoComments)
        statement
    }

    ; generateInitializedPropertyExpressionsOrClassStaticBlock
    procedure cf_generate_initialized_property_expressions_or_class_static_block(this, properties: ref[Array[ref[AstNode]?]], receiver: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let expressions &Array[ref[AstNode]?]^host()
        var i 0
        while i < (properties.get_length() as int)
        {
            let property properties[i as size_t] as ref[AstNode]
            set i: i + 1
            var expression: ref[AstNode]? null
            if property.kind = KindClassStaticBlockDeclaration
            {
                let saved cf_current_class_element
                set this.cf_current_class_element: property
                set expression: this.cf_transform_class_static_block_declaration(property)
                set this.cf_current_class_element: saved
            }
            else
                set expression: this.cf_transform_property(property, receiver)
            if expression = null
                continue
            let e expression as ref[AstNode]
            context.set_original_ex(e, property, true)
            context.assign_comment_and_source_map_ranges(e, property)
            expressions.add(e)
        }
        expressions
    }

    ; transformProperty
    procedure cf_transform_property(this, property: ref[AstNode], receiver: ref[AstNode]) returns ref[AstNode]?
    {
        let saved_current_class_element cf_current_class_element
        let transformed this.cf_transform_property_worker(property, receiver)
        if (transformed <> null) and Transformer.has_static_modifier(property)
        {
            let t transformed as ref[AstNode]
            context.add_emit_flags(t, EFNoLexicalThis)
            if this.cf_lex_facts() <> 0
            {
                ; the member's lexical environment is captured
                context.set_original(t, property)
                context.set_source_map_range(t, context.source_map_range(AstNode.name_of(property) as ref[AstNode]))
            }
        }
        set this.cf_current_class_element: saved_current_class_element
        transformed
    }

    procedure cf_transform_property_worker(this, property_in: ref[AstNode], receiver: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let emit_assignment opts.options.get_use_define_for_class_fields() = false
        var property property_in
        if this.cf_is_named_evaluation_needing_name(property)
        {
            let empty: Slice[char] ""
            set property: Transformer.transform_named_evaluation(context, property, false, empty)
        }
        var property_name AstNode.name_of(property) as ref[AstNode]
        if Transformer.has_accessor_modifier(property)
        {
            let empty: Slice[char] ""
            let storage_suffix: Slice[char] "_accessor_storage"
            set property_name: f.new_generated_private_name_for_node_ex(property_name, 0, empty, storage_suffix)
        }
        else
        {
            if property_name.kind = KindComputedPropertyName
            {
                if Transformer.is_simple_inlineable_expression(AstNode.expression_of(property_name) as ref[AstNode]) = false
                    set property_name: f.update_computed_property_name(property_name, f.new_generated_name_for_node(property_name))
            }
        }
        if Transformer.has_static_modifier(property)
            set this.cf_current_class_element: property
        if (property_name.kind = KindPrivateIdentifier) and this.cf_should_transform_class_element_to_weak_map(property)
        {
            let info this.cf_access_private_identifier(property_name)
            if info <> null
            {
                let i info as ref[PrivateIdentifierInfo]
                if i.kind = PrivateKindField
                {
                    if i.is_static = false
                        return this.cf_create_private_instance_field_initializer(f, receiver, v.visit_node(AstNode.initializer_of(property)), i.brand_check_identifier as ref[AstNode])
                    return this.cf_create_private_static_field_initializer(f, i.variable_name as ref[AstNode], v.visit_node(AstNode.initializer_of(property)))
                }
                return null
            }
            this.record_unported("class-fields-undeclared-private-name", property.kind)
            return null
        }
        if ((property_name.kind = KindPrivateIdentifier) or Transformer.has_static_modifier(property)) and (AstNode.initializer_of(property) = null)
            return null
        let property_original_node context.most_original(property) as ref[AstNode]
        if Transformer.has_syntactic_modifier(property_original_node, ModifierFlagsAbstract)
            return null
        var initializer v.visit_node(AstNode.initializer_of(property))
        let original_parent AstNode.parent_node_of(property_original_node)
        if Transformer.is_parameter_property_declaration(property_original_node, original_parent) and (property_name.kind = KindIdentifier)
        {
            ; a parameter property overrides the initializer; an initializer here is
            ; a decorator's `__runInitializers`, which runs first
            let local_name f.clone(property_name)
            if initializer <> null
            {
                var init_expr initializer as ref[AstNode]
                ; unwrap `(__runInitializers(this, _instanceExtraInitializers), void 0)`
                if init_expr.kind = KindParenthesizedExpression
                {
                    let inner AstNode.expression_of(init_expr) as ref[AstNode]
                    if AstNode.binary_operator_kind(inner) = KindCommaToken
                    {
                        let left AstNode.binary_left_of(inner) as ref[AstNode]
                        let right AstNode.binary_right_of(inner) as ref[AstNode]
                        if context.is_call_to_helper(left, "__runInitializers") and (right.kind = KindVoidExpression)
                        {
                            if AstNode.kind_of(AstNode.expression_of(right)) = KindNumericLiteral
                                set init_expr: left
                        }
                    }
                }
                let both &Array[ref[AstNode]?]^host()
                both.add(init_expr)
                both.add(local_name)
                set initializer: f.inline_expressions(both)
            }
            else
                set initializer: local_name
            context.add_emit_flags(property_name, EFNoComments | EFNoSourceMap)
            let orig_name AstNode.name_of(property_original_node) as ref[AstNode]
            context.set_source_map_range(local_name, TextRange(orig_name.pos, orig_name.end))
            context.add_emit_flags(local_name, EFNoComments)
        }
        else
        {
            if initializer = null
                set initializer: f.new_void_zero_expression()
        }
        if emit_assignment or (property_name.kind = KindPrivateIdentifier)
        {
            let member_access Transformer.cf_create_member_access_for_property_name(f, context, receiver, property_name, property_name)
            context.add_emit_flags(member_access, EFNoLeadingComments)
            return f.new_assignment_expression(member_access, initializer)
        }
        ; useDefineForClassFields: Object.defineProperty
        var name: ref[AstNode]? null
        if property_name.kind = KindComputedPropertyName
            set name: AstNode.expression_of(property_name)
        else
        {
            if property_name.kind = KindIdentifier
                set name: f.new_string_literal(AstNode.identifier_text_of(property_name), TokenFlagsNone)
            else
                set name: property_name
        }
        let props &Array[ref[AstNode]?]^host()
        props.add(f.new_property_assignment(null, f.new_identifier("enumerable"), null, null, f.new_true_expression()))
        props.add(f.new_property_assignment(null, f.new_identifier("configurable"), null, null, f.new_true_expression()))
        props.add(f.new_property_assignment(null, f.new_identifier("writable"), null, null, f.new_true_expression()))
        props.add(f.new_property_assignment(null, f.new_identifier("value"), null, null, initializer))
        let descriptor f.new_object_literal_expression(props, true)
        f.new_object_define_property_call(receiver, name as ref[AstNode], descriptor)
    }

    ; addInstanceMethodStatements: the brand-check initializer of private methods
    procedure cf_add_instance_method_statements(this, statements: ref[Array[ref[AstNode]?]], methods: ref[Array[ref[AstNode]?]], receiver: ref[AstNode])
    {
        if (cf_private_elements_or_static_blocks = false) or (methods.get_length() = 0)
            return
        let env this.cf_get_private_identifier_environment()
        if env.weak_set_name = null
        {
            this.record_unported("class-fields-weak-set-name", 0)
            return
        }
        statements.add(factory.new_expression_statement(this.cf_create_private_instance_method_initializer(factory, receiver, env.weak_set_name as ref[AstNode])))
    }

    procedure cf_visit_invalid_super_property(this, node: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        if node.kind = KindPropertyAccessExpression
            return f.update_property_access_expression(node, f.new_void_zero_expression(), null, AstNode.name_of(node), node.flags)
        f.update_element_access_expression(node, f.new_void_zero_expression(), null, this.the_visitor().visit_node(AstNode.element_access_argument_of(node)), node.flags)
    }

    ; getPropertyNameExpressionIfNeeded: a computed name's expression, cached in
    ; a generated variable when it must be reused
    procedure cf_property_name_expression_if_needed(this, name: ref[AstNode], should_hoist: bool) returns ref[AstNode]?
    {
        let f factory
        if name.kind <> KindComputedPropertyName
            return null
        let cache_assignment Transformer.find_computed_property_name_cache_assignment(name)
        ; the outer lexical environment, as Strada's onEmitNode switches to it
        let saved_lexical_environment cf_lexical_environment
        let saved_inside cf_inside_computed_property_name
        set this.cf_inside_computed_property_name: true
        if cf_lexical_environment <> null
        {
            let env cf_lexical_environment as ref[ClassLexicalEnv]
            if env.previous <> null
                set this.cf_lexical_environment: env.previous
        }
        let expression this.the_visitor().visit_node(AstNode.expression_of(name)) as ref[AstNode]
        set this.cf_lexical_environment: saved_lexical_environment
        set this.cf_inside_computed_property_name: saved_inside
        let inner_expression Printer.skip_partially_emitted_expressions(expression)
        let inlinable Transformer.is_simple_inlineable_expression(inner_expression)
        var already_transformed cache_assignment <> null
        if Emitter.is_assignment_expression(inner_expression, true)
        {
            let left AstNode.binary_left_of(inner_expression) as ref[AstNode]
            if (left.kind = KindIdentifier) and context.has_auto_generate_info(left)
                set already_transformed: true
        }
        if (already_transformed = false) and (inlinable = false) and should_hoist
        {
            let generated_name f.new_generated_name_for_node(name)
            if this.cf_requires_block_scoped_var()
                context.add_lexical_declaration(generated_name)
            else
                context.add_variable_declaration(generated_name)
            return f.new_assignment_expression(generated_name, expression)
        }
        if inlinable or (inner_expression.kind = KindIdentifier)
            return null
        expression
    }

    procedure cf_start_class_lexical_environment(this)
        set this.cf_lexical_environment: &ClassLexicalEnv^host(cf_lexical_environment, null, null)

    procedure cf_end_class_lexical_environment(this)
        set this.cf_lexical_environment: (cf_lexical_environment as ref[ClassLexicalEnv]).previous

    function cf_get_class_lexical_environment(this) returns ref[ClassLexicalEnvironment]
    {
        let env cf_lexical_environment as ref[ClassLexicalEnv]
        if env.data = null
            set env.data: &ClassLexicalEnvironment^host(ClassFactsNone, null, null, null)
        env.data as ref[ClassLexicalEnvironment]
    }

    function cf_get_private_identifier_environment(this) returns ref[PrivateEnvironment]
    {
        let env cf_lexical_environment as ref[ClassLexicalEnv]
        if env.private_env = null
            set env.private_env: PrivateEnvironment.create(host)
        env.private_env as ref[PrivateEnvironment]
    }

    ; the brand check identifier of a static member: classThis, else classConstructor
    function cf_static_brand_check(this, lex: ref[ClassLexicalEnvironment]) returns ref[AstNode]?
    {
        if lex.class_this <> null
            return lex.class_this
        lex.class_constructor
    }

    procedure cf_add_private_identifier_property_declaration_to_environment(this, node: ref[AstNode], name: ref[AstNode])
    {
        let f factory
        let lex this.cf_get_class_lexical_environment()
        let env this.cf_get_private_identifier_environment()
        let is_static Transformer.has_static_modifier(node)
        let previous_info this.cf_get_private_identifier(env, name)
        let is_valid (this.cf_is_reserved_private_name(name) = false) and (previous_info = null)
        let empty: Slice[char] ""
        if is_static
        {
            let brand_check_identifier this.cf_static_brand_check(lex)
            let variable_name this.cf_create_hoisted_variable_for_private_name(name, empty)
            this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindField, brand_check_identifier, true, is_valid, variable_name, null, null, null))
            return
        }
        let weak_map_name this.cf_create_hoisted_variable_for_private_name(name, empty)
        this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindField, weak_map_name, false, is_valid, null, null, null, null))
        let no_args &Array[ref[AstNode]?]^host()
        this.cf_add_pending_expression(f.new_assignment_expression(weak_map_name, f.new_new_expression(f.new_identifier("WeakMap"), null, no_args)))
    }

    procedure cf_add_private_identifier_method_to_environment(this, name: ref[AstNode], lex: ref[ClassLexicalEnvironment], env: ref[PrivateEnvironment], is_static: bool, is_valid: bool)
    {
        let empty: Slice[char] ""
        let method_name this.cf_create_hoisted_variable_for_private_name(name, empty)
        var brand_check_identifier: ref[AstNode]? null
        if is_static
            set brand_check_identifier: this.cf_static_brand_check(lex)
        else
            set brand_check_identifier: env.weak_set_name
        this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindMethod, brand_check_identifier, is_static, is_valid, null, method_name, null, null))
    }

    procedure cf_add_private_identifier_get_accessor_to_environment(this, name: ref[AstNode], lex: ref[ClassLexicalEnvironment], env: ref[PrivateEnvironment], is_static: bool, is_valid: bool, previous_info: ref[PrivateIdentifierInfo]?)
    {
        let suffix: Slice[char] "_get"
        let getter_name this.cf_create_hoisted_variable_for_private_name(name, suffix)
        var brand_check_identifier: ref[AstNode]? null
        if is_static
            set brand_check_identifier: this.cf_static_brand_check(lex)
        else
            set brand_check_identifier: env.weak_set_name
        if previous_info <> null
        {
            let p previous_info as ref[PrivateIdentifierInfo]
            if (p.kind = PrivateKindAccessor) and (p.is_static = is_static) and (p.getter_name = null)
            {
                set p.getter_name: getter_name
                return
            }
        }
        this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindAccessor, brand_check_identifier, is_static, is_valid, null, null, getter_name, null))
    }

    procedure cf_add_private_identifier_set_accessor_to_environment(this, name: ref[AstNode], lex: ref[ClassLexicalEnvironment], env: ref[PrivateEnvironment], is_static: bool, is_valid: bool, previous_info: ref[PrivateIdentifierInfo]?)
    {
        let suffix: Slice[char] "_set"
        let setter_name this.cf_create_hoisted_variable_for_private_name(name, suffix)
        var brand_check_identifier: ref[AstNode]? null
        if is_static
            set brand_check_identifier: this.cf_static_brand_check(lex)
        else
            set brand_check_identifier: env.weak_set_name
        if previous_info <> null
        {
            let p previous_info as ref[PrivateIdentifierInfo]
            if (p.kind = PrivateKindAccessor) and (p.is_static = is_static) and (p.setter_name = null)
            {
                set p.setter_name: setter_name
                return
            }
        }
        this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindAccessor, brand_check_identifier, is_static, is_valid, null, null, null, setter_name))
    }

    procedure cf_add_private_identifier_auto_accessor_to_environment(this, name: ref[AstNode], lex: ref[ClassLexicalEnvironment], env: ref[PrivateEnvironment], is_static: bool, is_valid: bool)
    {
        let get_suffix: Slice[char] "_get"
        let set_suffix: Slice[char] "_set"
        let getter_name this.cf_create_hoisted_variable_for_private_name(name, get_suffix)
        let setter_name this.cf_create_hoisted_variable_for_private_name(name, set_suffix)
        var brand_check_identifier: ref[AstNode]? null
        if is_static
            set brand_check_identifier: this.cf_static_brand_check(lex)
        else
            set brand_check_identifier: env.weak_set_name
        this.cf_set_private_identifier(env, name, &PrivateIdentifierInfo^host(PrivateKindAccessor, brand_check_identifier, is_static, is_valid, null, null, getter_name, setter_name))
    }

    procedure cf_add_private_identifier_to_environment(this, node: ref[AstNode])
    {
        let lex this.cf_get_class_lexical_environment()
        let env this.cf_get_private_identifier_environment()
        let name AstNode.name_of(node) as ref[AstNode]
        let is_static Transformer.has_static_modifier(node)
        let previous_info this.cf_get_private_identifier(env, name)
        let is_valid (this.cf_is_reserved_private_name(name) = false) and (previous_info = null)
        if Transformer.is_auto_accessor_property_declaration(node)
        {
            this.cf_add_private_identifier_auto_accessor_to_environment(name, lex, env, is_static, is_valid)
            return
        }
        let k node.kind
        if k = KindPropertyDeclaration
        {
            this.cf_add_private_identifier_property_declaration_to_environment(node, name)
            return
        }
        if k = KindMethodDeclaration
        {
            this.cf_add_private_identifier_method_to_environment(name, lex, env, is_static, is_valid)
            return
        }
        if k = KindGetAccessor
        {
            this.cf_add_private_identifier_get_accessor_to_environment(name, lex, env, is_static, is_valid, previous_info)
            return
        }
        if k = KindSetAccessor
            this.cf_add_private_identifier_set_accessor_to_environment(name, lex, env, is_static, is_valid, previous_info)
    }

    procedure cf_set_private_identifier(this, env: ref[PrivateEnvironment], name: ref[AstNode], info: ref[PrivateIdentifierInfo])
    {
        if context.has_auto_generate_info(name)
        {
            let key context.get_node_for_generated_name(name)
            let list env.generated_identifiers
            var i 0
            while i < (list.get_length() as int)
            {
                let e list[i as size_t]
                if Transformer.same_node(e.node, key)
                {
                    list.put(i as size_t, PrivateGeneratedEntry(key, info))
                    return
                }
                set i: i + 1
            }
            list.add(PrivateGeneratedEntry(key, info))
            return
        }
        let text AstNode.identifier_text_of(name)
        let members env.members
        var j 0
        while j < (members.get_length() as int)
        {
            let e members[j as size_t]
            if e.name.equals(text)
            {
                members.put(j as size_t, PrivateMemberEntry(text, info))
                return
            }
            set j: j + 1
        }
        members.add(PrivateMemberEntry(text, info))
    }

    function cf_get_private_identifier(this, env: ref[PrivateEnvironment], name: ref[AstNode]) returns ref[PrivateIdentifierInfo]?
    {
        if context.has_auto_generate_info(name)
        {
            let key context.get_node_for_generated_name(name)
            let list env.generated_identifiers
            var i 0
            while i < (list.get_length() as int)
            {
                let e list[i as size_t]
                if Transformer.same_node(e.node, key)
                    return e.info
                set i: i + 1
            }
            return null
        }
        let text AstNode.identifier_text_of(name)
        let members env.members
        var j 0
        while j < (members.get_length() as int)
        {
            let e members[j as size_t]
            if e.name.equals(text)
                return e.info
            set j: j + 1
        }
        null
    }

    ; createHoistedVariableForClass: `_<className>_<nameText>` or `_<nameText>`
    procedure cf_create_hoisted_variable_for_class(this, name_text: Slice[char], node: ref[AstNode], suffix: Slice[char]) returns ref[AstNode]
    {
        let f factory
        let env this.cf_get_private_identifier_environment()
        let sb StringBuilder^host()
        sb.append("_")
        if env.class_name <> null
        {
            let cn AstNode.identifier_text_of(env.class_name)
            sb.append(cn.data, cn.length as size_t)
            sb.append("_")
        }
        sb.append(name_text.data, name_text.length as size_t)
        let text Printer.slice_on(host, sb.to_string())
        let empty: Slice[char] ""
        let identifier f.new_unique_name_ex(text, GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsReservedInNestedScopes, empty, suffix)
        if this.cf_requires_block_scoped_var()
            context.add_lexical_declaration(identifier)
        else
            context.add_variable_declaration(identifier)
        identifier
    }

    procedure cf_create_hoisted_variable_for_class_from_node(this, name: ref[AstNode], suffix: Slice[char]) returns ref[AstNode]
    {
        let f factory
        let env this.cf_get_private_identifier_environment()
        let sb StringBuilder^host()
        sb.append("_")
        if env.class_name <> null
        {
            let cn AstNode.identifier_text_of(env.class_name)
            sb.append(cn.data, cn.length as size_t)
            sb.append("_")
        }
        let prefix Printer.slice_on(host, sb.to_string())
        let identifier f.new_generated_name_for_node_ex(name, GeneratedIdentifierFlagsOptimistic | GeneratedIdentifierFlagsReservedInNestedScopes, prefix, suffix)
        if this.cf_requires_block_scoped_var()
            context.add_lexical_declaration(identifier)
        else
            context.add_variable_declaration(identifier)
        identifier
    }

    procedure cf_create_hoisted_variable_for_private_name(this, name: ref[AstNode], suffix: Slice[char]) returns ref[AstNode]
    {
        ; a generated name (an auto-accessor's backing field) resolves by node
        if context.has_auto_generate_info(name)
            return this.cf_create_hoisted_variable_for_class_from_node(name, suffix)
        var text AstNode.identifier_text_of(name)
        if text.length > 0
        {
            if text[0] = ("#" as char)
                set text: text.slice_from(1)
        }
        this.cf_create_hoisted_variable_for_class(text, name, suffix)
    }

    ; accessPrivateIdentifier: the innermost environment that declares the name
    function cf_access_private_identifier(this, name: ref[AstNode]) returns ref[PrivateIdentifierInfo]?
    {
        var env cf_lexical_environment
        while env <> null
        {
            let e env as ref[ClassLexicalEnv]
            if e.private_env <> null
            {
                let info this.cf_get_private_identifier(e.private_env as ref[PrivateEnvironment], name)
                if info <> null
                {
                    if (info as ref[PrivateIdentifierInfo]).kind = PrivateKindUntransformed
                        return null
                    return info
                }
            }
            set env: e.previous
        }
        null
    }

    procedure cf_wrap_private_identifier_for_destructuring_target(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let parameter f.new_generated_name_for_node(node)
        let info this.cf_access_private_identifier(AstNode.name_of(node) as ref[AstNode])
        if info = null
            return v.visit_each_child(node)
        let expr AstNode.expression_of(node) as ref[AstNode]
        var receiver expr
        ; `this` and `super` cannot be copied into the function
        var capture (expr.kind = KindThisKeyword) or (expr.kind = KindSuperKeyword)
        if Transformer.is_simple_copiable_expression(expr) = false
            set capture: true
        if capture
        {
            let temp this.cf_new_reserved_temp()
            context.add_variable_declaration(temp)
            this.cf_add_pending_expression(f.new_assignment_expression(temp, v.visit_node(expr)))
            set receiver: temp
        }
        let assign_expr this.cf_create_private_identifier_assignment(info as ref[PrivateIdentifierInfo], receiver, parameter, KindEqualsToken)
        f.new_assignment_target_wrapper(parameter, assign_expr)
    }

    procedure cf_visit_assignment_element(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        var node node_in
        if this.cf_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, false, empty)
        }
        if Emitter.is_assignment_expression(node, true)
        {
            let left this.cf_visit_destructuring_assignment_target(AstNode.binary_left_of(node) as ref[AstNode])
            let right this.the_visitor().visit_node(AstNode.binary_right_of(node))
            return f.update_binary_expression(node, null, left, null, AstNode.binary_operator_token_of(node), right)
        }
        this.cf_visit_destructuring_assignment_target(node)
    }

    procedure cf_visit_assignment_rest_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expr AstNode.expression_of(node) as ref[AstNode]
        if Binder.is_left_hand_side_expression(expr)
            return factory.update_spread_element(node, this.cf_visit_destructuring_assignment_target(expr))
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_array_assignment_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if Transformer.cf_is_array_binding_or_assignment_element(node)
        {
            if node.kind = KindSpreadElement
                return this.cf_visit_assignment_rest_element(node)
            if node.kind <> KindOmittedExpression
                return this.cf_visit_assignment_element(node)
        }
        this.the_visitor().visit_each_child(node)
    }

    ; ast.IsArrayBindingOrAssignmentElement
    function cf_is_array_binding_or_assignment_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        if (k = KindBindingElement) or (k = KindOmittedExpression) or (k = KindSpreadElement) or (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
            return true
        if Binder.is_left_hand_side_expression(n)
            return true
        Emitter.is_assignment_expression(n, true)
    }

    procedure cf_visit_assignment_property(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        let v this.the_visitor()
        let name v.visit_node(AstNode.name_of(node))
        let initializer AstNode.initializer_of(node) as ref[AstNode]
        if Emitter.is_assignment_expression(initializer, true)
            return f.update_property_assignment(node, null, name, null, null, this.cf_visit_assignment_element(initializer))
        if Binder.is_left_hand_side_expression(initializer)
            return f.update_property_assignment(node, null, name, null, null, this.cf_visit_destructuring_assignment_target(initializer))
        v.visit_each_child(node)
    }

    procedure cf_visit_shorthand_assignment_property(this, node_in: ref[AstNode]) returns ref[AstNode]?
    {
        var node node_in
        if this.cf_is_named_evaluation_needing_name(node)
        {
            let empty: Slice[char] ""
            set node: Transformer.transform_named_evaluation(context, node, false, empty)
        }
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_assignment_rest_property(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let expr AstNode.expression_of(node) as ref[AstNode]
        if Binder.is_left_hand_side_expression(expr)
            return factory.update_spread_assignment(node, this.cf_visit_destructuring_assignment_target(expr))
        this.the_visitor().visit_each_child(node)
    }

    procedure cf_visit_object_assignment_element(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if node.kind = KindSpreadAssignment
            return this.cf_visit_assignment_rest_property(node)
        if node.kind = KindShorthandPropertyAssignment
            return this.cf_visit_shorthand_assignment_property(node)
        if node.kind = KindPropertyAssignment
            return this.cf_visit_assignment_property(node)
        this.the_visitor().visit_each_child(node)
    }

    ; visitAssignmentPattern:  [ this.#x ] = [...]  →  [ { set value(v) { this.#x = v; } }.value ] = [...]
    procedure cf_visit_assignment_pattern(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let f factory
        if node.kind = KindArrayLiteralExpression
        {
            let av this.cf_visitor(CfSubArrayAssignmentElement)
            return f.update_array_literal_expression(node, av.visit_nodes(AstNode.elements_of(node)), AstNode.multi_line_of(node))
        }
        let ov this.cf_visitor(CfSubObjectAssignmentElement)
        f.update_object_literal_expression(node, ov.visit_nodes(AstNode.properties_of(node)), AstNode.multi_line_of(node))
    }

    procedure cf_create_private_static_field_initializer(this, f: ref[NodeFactory], variable_name: ref[AstNode], initializer_in: ref[AstNode]?) returns ref[AstNode]
    {
        var initializer initializer_in
        if initializer = null
            set initializer: f.new_void_zero_expression()
        let props &Array[ref[AstNode]?]^host()
        props.add(f.new_property_assignment(null, f.new_identifier("value"), null, null, initializer))
        f.new_assignment_expression(variable_name, f.new_object_literal_expression(props, false))
    }

    procedure cf_create_private_instance_field_initializer(this, f: ref[NodeFactory], receiver: ref[AstNode], initializer_in: ref[AstNode]?, weak_map_name: ref[AstNode]) returns ref[AstNode]
    {
        var initializer initializer_in
        if initializer = null
            set initializer: f.new_void_zero_expression()
        let args &Array[ref[AstNode]?]^host()
        args.add(receiver)
        args.add(initializer)
        f.new_method_call(weak_map_name, f.new_identifier("set"), args)
    }

    procedure cf_create_private_instance_method_initializer(this, f: ref[NodeFactory], receiver: ref[AstNode], weak_set_name: ref[AstNode]) returns ref[AstNode]
    {
        let args &Array[ref[AstNode]?]^host()
        args.add(receiver)
        f.new_method_call(weak_set_name, f.new_identifier("add"), args)
    }

    function cf_is_reserved_private_name(this, node: ref[AstNode]) returns bool
    {
        if (node.kind = KindPrivateIdentifier) and context.has_auto_generate_info(node)
            return false
        AstNode.identifier_text_of(node).equals("#constructor")
    }

    function is_static_property_declaration_or_class_static_block(node: ref[AstNode]) returns bool
    {
        if node.kind = KindClassStaticBlockDeclaration
            return true
        (node.kind = KindPropertyDeclaration) and Transformer.has_static_modifier(node)
    }

    function cf_get_properties(this, node: ref[AstNode], require_initializer: bool, is_static: bool) returns ref[Array[ref[AstNode]?]]
    {
        let result &Array[ref[AstNode]?]^host()
        let members Printer.member_list_of(node) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (members.get_length() as int)
        {
            let member members[i as size_t] as ref[AstNode]
            set i: i + 1
            if member.kind <> KindPropertyDeclaration
                continue
            if require_initializer and (AstNode.initializer_of(member) = null)
                continue
            if Transformer.has_static_modifier(member) = is_static
                result.add(member)
        }
        result
    }

    function cf_static_properties_and_class_static_blocks(this, node: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        let result &Array[ref[AstNode]?]^host()
        let members Printer.member_list_of(node) as ref[Array[ref[AstNode]?]]
        var i 0
        while i < (members.get_length() as int)
        {
            let member members[i as size_t] as ref[AstNode]
            if member.kind = KindClassStaticBlockDeclaration
                result.add(member)
            else
            {
                if (member.kind = KindPropertyDeclaration) and Transformer.has_static_modifier(member)
                    result.add(member)
            }
            set i: i + 1
        }
        result
    }

    function cf_is_non_static_method_or_accessor_with_private_name(member: ref[AstNode]) returns bool
    {
        if Transformer.is_static_member(member)
            return false
        if (AstNode.is_method_or_accessor(member) = false) and (Transformer.is_auto_accessor_property_declaration(member) = false)
            return false
        AstNode.kind_of(AstNode.name_of(member)) = KindPrivateIdentifier
    }

    function cf_create_member_access_for_property_name(f: ref[NodeFactory], ctx: ref[EmitContext], receiver: ref[AstNode], name: ref[AstNode], location: ref[AstNode]) returns ref[AstNode]
    {
        if name.kind = KindComputedPropertyName
        {
            let expression f.new_element_access_expression(receiver, null, AstNode.expression_of(name), NodeFlagsNone)
            set expression.pos: location.pos
            set expression.end: location.end
            return expression
        }
        var expression: ref[AstNode]? null
        if (name.kind = KindIdentifier) or (name.kind = KindPrivateIdentifier)
            set expression: f.new_property_access_expression(receiver, null, name, NodeFlagsNone)
        else
            set expression: f.new_element_access_expression(receiver, null, name, NodeFlagsNone)
        let e expression as ref[AstNode]
        ctx.set_comment_range(e, TextRange(name.pos, name.end))
        ctx.set_source_map_range(e, TextRange(name.pos, name.end))
        ctx.add_emit_flags(e, EFNoNestedSourceMaps)
        e
    }

    ; createCallBinding: (thisArg, target) through the out-cell
    procedure cf_create_call_binding(this, node: ref[AstNode], target: ref[ref[AstNode]?]) returns ref[AstNode]
    {
        let f factory
        if Checker.is_super_property(node)
        {
            set target: node
            return f.new_this_expression()
        }
        if node.kind = KindPropertyAccessExpression
        {
            let expr AstNode.expression_of(node) as ref[AstNode]
            if Transformer.cf_should_be_captured_in_temp_variable(expr)
            {
                let this_arg f.new_temp_variable()
                context.add_variable_declaration(this_arg)
                set target: f.new_property_access_expression(f.new_parenthesized_expression(f.new_assignment_expression(this_arg, expr)), null, AstNode.name_of(node), NodeFlagsNone)
                return this_arg
            }
            set target: node
            return expr
        }
        set target: node
        f.new_void_zero_expression()
    }

    function cf_should_be_captured_in_temp_variable(node: ref[AstNode]) returns bool
    {
        let target Parser.skip_parentheses(node) as ref[AstNode]
        let k target.kind
        if (k = KindIdentifier) or (k = KindThisKeyword) or (k = KindNumericLiteral) or (k = KindBigIntLiteral) or (k = KindStringLiteral)
            return false
        true
    }

    procedure cf_create_accessor_property_get_redirector(this, node: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode], receiver: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let empty: Slice[char] ""
        let storage_suffix: Slice[char] "_accessor_storage"
        let backing_field_name f.new_generated_private_name_for_node_ex(AstNode.name_of(node) as ref[AstNode], 0, empty, storage_suffix)
        let return_stmt f.new_return_statement(f.new_property_access_expression(receiver, null, backing_field_name, NodeFlagsNone))
        let body_statements &Array[ref[AstNode]?]^host()
        body_statements.add(return_stmt)
        let no_params &Array[ref[AstNode]?]^host()
        f.new_get_accessor_declaration(modifiers, name, null, no_params, null, null, f.new_block(body_statements, false))
    }

    procedure cf_create_accessor_property_set_redirector(this, node: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode], receiver: ref[AstNode]) returns ref[AstNode]
    {
        let f factory
        let empty: Slice[char] ""
        let storage_suffix: Slice[char] "_accessor_storage"
        let backing_field_name f.new_generated_private_name_for_node_ex(AstNode.name_of(node) as ref[AstNode], 0, empty, storage_suffix)
        let value_param f.new_parameter_declaration(null, null, f.new_identifier("value"), null, null, null)
        let assign_expr f.new_assignment_expression(f.new_property_access_expression(receiver, null, backing_field_name, NodeFlagsNone), f.new_identifier("value"))
        let body_statements &Array[ref[AstNode]?]^host()
        body_statements.add(f.new_expression_statement(assign_expr))
        let params &Array[ref[AstNode]?]^host()
        params.add(value_param)
        f.new_set_accessor_declaration(modifiers, name, null, params, null, null, f.new_block(body_statements, false))
    }

    ; flattenCommaList: a comma expression tree as a sequence
    function cf_flatten_comma_list(node: ref[AstNode], out: ref[Array[ref[AstNode]?]])
    {
        if (node.kind = KindParenthesizedExpression) and Printer.node_is_synthesized(node)
        {
            Transformer.cf_flatten_comma_list(AstNode.expression_of(node) as ref[AstNode], out)
            return
        }
        if AstNode.binary_operator_kind(node) = KindCommaToken
        {
            Transformer.cf_flatten_comma_list(AstNode.binary_left_of(node) as ref[AstNode], out)
            Transformer.cf_flatten_comma_list(AstNode.binary_right_of(node) as ref[AstNode], out)
            return
        }
        out.add(node)
    }

    ; IsEmptyArrayLiteral || IsEmptyObjectLiteral
    function is_empty_array_or_object_literal(node: ref[AstNode]) returns bool
    {
        if node.kind = KindArrayLiteralExpression
            return Transformer.list_is_empty(AstNode.elements_of(node))
        if node.kind = KindObjectLiteralExpression
            return Transformer.list_is_empty(AstNode.properties_of(node))
        false
    }

    function names_contain(list: ref[Array[Slice[char]]], name: Slice[char]) returns bool
    {
        var i 0
        while i < (list.get_length() as int)
        {
            let e list[i as size_t]
            if e.equals(name)
                return true
            set i: i + 1
        }
        false
    }

    ; strconv.Itoa
    function decimal_slice(host: ref[Page], value: int) returns Slice[char]
    {
        let buf allocate_slice[char](host, 24)
        let n Parser.write_decimal(buf, value)
        buf.subslice(0, n as size_t)
    }
}

; transformers/destructuring.go's flattener: the state of one flattening, with
; the two MODES (assignment / binding) as a flag where the reference installs
; four callbacks, and the assignment callback as a tag the transformer dispatches
; (`Transformer.flatten_create_assignment`).
define Flattener
(
    host: ref[Page]
    tx: ref[Transformer]
    level: int
    callback: int
    binding_mode: bool
    expressions: ref[Array[ref[AstNode]?]]
    declarations: ref[Array[ref[PendingDecl]?]]
    has_transformed_prior_element: bool
    hoist_temp_variables: bool
)
{
    function create(host: ref[Page], tx: ref[Transformer], level: int, callback: int, binding_mode: bool, hoist_temp_variables: bool) returns ref[Flattener]
    {
        let expressions &Array[ref[AstNode]?]^host()
        let declarations &Array[ref[PendingDecl]?]^host()
        &Flattener^host(host, tx, level, callback, binding_mode, expressions, declarations, false, hoist_temp_variables)
    }

    ; FlattenDestructuringAssignment
    function flatten_destructuring_assignment(host: ref[Page], tx: ref[Transformer], node: ref[AstNode], needs_value: bool, level: int, callback: int) returns ref[AstNode]
    {
        let f Flattener.create(host, tx, level, callback, false, true)
        f.flatten_assignment(node, needs_value)
    }

    ; FlattenDestructuringBinding: one VariableDeclaration, a SyntaxList of them, or null
    function flatten_destructuring_binding(host: ref[Page], tx: ref[Transformer], node: ref[AstNode], rval: ref[AstNode]?, level: int, hoist_temp_variables: bool, skip_initializer: bool) returns ref[AstNode]?
    {
        let f Flattener.create(host, tx, level, FlattenCallbackNone, true, hoist_temp_variables)
        f.flatten_binding(node, rval, skip_initializer)
    }

    function the_factory(this) returns ref[NodeFactory]
        tx.factory

    function the_context(this) returns ref[EmitContext]
        tx.context

    ; createArrayBindingOrAssignmentPattern / createObjectBindingOrAssignmentPattern
    procedure create_array_pattern(this, elements: ref[Array[ref[AstNode]?]]) returns ref[AstNode]
    {
        let f this.the_factory()
        if binding_mode
            return f.new_binding_pattern(KindArrayBindingPattern, elements)
        f.new_array_literal_expression(elements, false)
    }

    procedure create_object_pattern(this, elements: ref[Array[ref[AstNode]?]]) returns ref[AstNode]
    {
        let f this.the_factory()
        if binding_mode
            return f.new_binding_pattern(KindObjectBindingPattern, elements)
        f.new_object_literal_expression(elements, false)
    }

    ; createArrayBindingOrAssignmentElement
    procedure create_array_element(this, expr: ref[AstNode]) returns ref[AstNode]
    {
        if binding_mode
            return this.the_factory().new_binding_element(null, null, expr, null)
        expr
    }

    ; emitBindingOrAssignment: emitAssignment / emitBinding
    procedure emit_binding_or_assignment(this, target: ref[AstNode], value_in: ref[AstNode]?, pos: int, end: int, original: ref[AstNode]?)
    {
        let f this.the_factory()
        let ctx this.the_context()
        if binding_mode
        {
            var value value_in
            if expressions.get_length() > 0
            {
                expressions.add(value_in)
                set value: f.inline_expressions(expressions)
                set this.expressions: &Array[ref[AstNode]?]^host()
            }
            declarations.add(&PendingDecl^host(null, target, value, pos, end, original))
            return
        }
        var expression: ref[AstNode]? null
        if (callback <> FlattenCallbackNone) and (target.kind = KindIdentifier)
            set expression: tx.flatten_create_assignment(callback, target, value_in as ref[AstNode], true, TextRange(pos, end))
        else
        {
            let e f.new_assignment_expression(tx.the_visitor().visit_node(target), value_in)
            set e.pos: pos
            set e.end: end
            set expression: e
        }
        let ex expression as ref[AstNode]
        if original <> null
            ctx.set_original(ex, original as ref[AstNode])
        expressions.add(ex)
    }

    ; ensureIdentifier
    procedure ensure_identifier(this, value: ref[AstNode], reuse_identifier_expressions: bool, pos: int, end: int) returns ref[AstNode]
    {
        if reuse_identifier_expressions and (value.kind = KindIdentifier)
            return value
        let f this.the_factory()
        let temp f.new_temp_variable()
        if hoist_temp_variables
        {
            this.the_context().add_variable_declaration(temp)
            let assign f.new_assignment_expression(temp, value)
            set assign.pos: pos
            set assign.end: end
            expressions.add(assign)
        }
        else
            this.emit_binding_or_assignment(temp, value, pos, end, null)
        temp
    }

    ; createDefaultValueCheck: value === void 0 ? defaultValue : value
    procedure create_default_value_check(this, value_in: ref[AstNode], default_value: ref[AstNode], pos: int, end: int) returns ref[AstNode]
    {
        let f this.the_factory()
        let value this.ensure_identifier(value_in, true, pos, end)
        let undefined_text: Slice[char] "undefined"
        f.new_conditional_expression(f.new_type_check(value, undefined_text), f.new_token(KindQuestionToken), default_value, f.new_token(KindColonToken), value)
    }

    ; createDestructuringPropertyAccess
    procedure create_destructuring_property_access(this, value: ref[AstNode], property_name: ref[AstNode]) returns ref[AstNode]
    {
        let f this.the_factory()
        if property_name.kind = KindComputedPropertyName
        {
            let visited tx.the_visitor().visit_node(AstNode.expression_of(property_name)) as ref[AstNode]
            let argument_expression this.ensure_identifier(visited, false, property_name.pos, property_name.end)
            return f.new_element_access_expression(value, null, argument_expression, NodeFlagsNone)
        }
        if Binder.is_string_or_numeric_literal_like(property_name) or (property_name.kind = KindBigIntLiteral)
            return f.new_element_access_expression(value, null, f.clone(property_name), NodeFlagsNone)
        f.new_property_access_expression(value, null, f.new_identifier(AstNode.identifier_text_of(property_name)), NodeFlagsNone)
    }

    ; flattenDestructuringAssignment (the entry point's body)
    procedure flatten_assignment(this, node_in: ref[AstNode], needs_value: bool) returns ref[AstNode]
    {
        let f this.the_factory()
        let v tx.the_visitor()
        var node node_in
        var pos node.pos
        var end node.end
        var value: ref[AstNode]? null
        if Binder.is_destructuring_assignment(node)
        {
            set value: AstNode.binary_right_of(node)
            ; `[] = x` and `{} = x` peel down to the innermost assignment
            while Transformer.is_empty_array_or_object_literal(AstNode.binary_left_of(node) as ref[AstNode])
            {
                if Binder.is_destructuring_assignment(value)
                {
                    set node: value as ref[AstNode]
                    set pos: node.pos
                    set end: node.end
                    set value: AstNode.binary_right_of(node)
                }
                else
                    return v.visit_node(value) as ref[AstNode]
            }
        }
        if value <> null
        {
            let visited v.visit_node(value) as ref[AstNode]
            set value: visited
            var must_copy false
            if visited.kind = KindIdentifier
            {
                if Transformer.binding_or_assignment_element_assigns_to_name(node, AstNode.identifier_text_of(visited))
                    set must_copy: true
            }
            if Transformer.binding_or_assignment_element_contains_non_literal_computed_name(node)
                set must_copy: true
            if must_copy
                set value: this.ensure_identifier(visited, false, pos, end)
            else
            {
                if needs_value
                    set value: this.ensure_identifier(visited, true, pos, end)
                else
                {
                    if Printer.node_is_synthesized(node)
                    {
                        set pos: visited.pos
                        set end: visited.end
                    }
                }
            }
        }
        this.flatten_binding_or_assignment_element(node, value, pos, end, Binder.is_destructuring_assignment(node))
        if (value <> null) and needs_value
        {
            if expressions.get_length() = 0
                return value as ref[AstNode]
            expressions.add(value)
        }
        let res f.inline_expressions(expressions)
        if res <> null
            return res as ref[AstNode]
        f.new_omitted_expression()
    }

    ; flattenDestructuringBinding (the entry point's body)
    procedure flatten_binding(this, node_in: ref[AstNode], rval: ref[AstNode]?, skip_initializer: bool) returns ref[AstNode]?
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let ctx this.the_context()
        var node node_in
        if node.kind = KindVariableDeclaration
        {
            let initializer Transformer.get_initializer_of_binding_or_assignment_element(node)
            if initializer <> null
            {
                let init_node initializer as ref[AstNode]
                var must_copy false
                if init_node.kind = KindIdentifier
                {
                    if Transformer.binding_or_assignment_element_assigns_to_name(node, AstNode.identifier_text_of(init_node))
                        set must_copy: true
                }
                if Transformer.binding_or_assignment_element_contains_non_literal_computed_name(node)
                    set must_copy: true
                if must_copy
                {
                    let visited v.visit_node(init_node) as ref[AstNode]
                    let temp this.ensure_identifier(visited, false, init_node.pos, init_node.end)
                    set node: f.update_variable_declaration(node, AstNode.name_of(node), null, null, temp)
                }
            }
        }
        this.flatten_binding_or_assignment_element(node, rval, node.pos, node.end, skip_initializer)
        if expressions.get_length() > 0
        {
            let temp f.new_temp_variable()
            if hoist_temp_variables
            {
                let value f.inline_expressions(expressions)
                set this.expressions: &Array[ref[AstNode]?]^host()
                this.emit_binding_or_assignment(temp, value, 0 - 1, 0 - 1, null)
            }
            else
            {
                ctx.add_variable_declaration(temp)
                let last declarations[(declarations.get_length() - 1) as size_t] as ref[PendingDecl]
                let pending &Array[ref[AstNode]?]^host()
                Transformer.add_all(pending, last.pending_expressions)
                pending.add(f.new_assignment_expression(temp, last.value))
                Transformer.add_all(pending, expressions)
                set last.pending_expressions: pending
                set last.value: temp
            }
        }
        let decls &Array[ref[AstNode]?]^host()
        var i 0
        while i < (declarations.get_length() as int)
        {
            let pending declarations[i as size_t] as ref[PendingDecl]
            var expr pending.value
            if pending.pending_expressions <> null
            {
                let pe pending.pending_expressions as ref[Array[ref[AstNode]?]]
                if pe.get_length() > 0
                {
                    let all &Array[ref[AstNode]?]^host()
                    Transformer.add_all(all, pe)
                    all.add(pending.value)
                    set expr: f.inline_expressions(all)
                }
            }
            let decl f.new_variable_declaration(pending.name, null, null, expr)
            set decl.pos: pending.pos
            set decl.end: pending.end
            if pending.original <> null
                ctx.set_original(decl, pending.original as ref[AstNode])
            decls.add(decl)
            set i: i + 1
        }
        if decls.get_length() = 1
            return decls[0]
        if decls.get_length() = 0
            return null
        f.new_syntax_list(decls)
    }

    ; flattenBindingOrAssignmentElement
    procedure flatten_binding_or_assignment_element(this, element: ref[AstNode], value_in: ref[AstNode]?, pos: int, end: int, skip_initializer: bool)
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let binding_target_opt Emitter.target_of_binding_or_assignment_element(element)
        if binding_target_opt = null
            return
        let binding_target binding_target_opt as ref[AstNode]
        var value value_in
        if skip_initializer = false
        {
            let initializer v.visit_node(Transformer.get_initializer_of_binding_or_assignment_element(element))
            if initializer <> null
            {
                let init_node initializer as ref[AstNode]
                if value <> null
                {
                    let checked this.create_default_value_check(value as ref[AstNode], init_node, pos, end)
                    set value: checked
                    if (Transformer.is_simple_copiable_expression(init_node) = false) and (AstNode.is_binding_pattern(binding_target) or Emitter.is_assignment_pattern(binding_target))
                        set value: this.ensure_identifier(checked, true, pos, end)
                }
                else
                    set value: init_node
            }
            else
            {
                if value = null
                    set value: f.new_void_zero_expression()
            }
        }
        let tk binding_target.kind
        if (tk = KindObjectBindingPattern) or (tk = KindObjectLiteralExpression)
        {
            this.flatten_object_pattern(element, binding_target, value as ref[AstNode], pos, end)
            return
        }
        if (tk = KindArrayBindingPattern) or (tk = KindArrayLiteralExpression)
        {
            this.flatten_array_pattern(element, binding_target, value as ref[AstNode], pos, end)
            return
        }
        this.emit_binding_or_assignment(binding_target, value, pos, end, element)
    }

    ; flattenObjectBindingOrAssignmentPattern
    procedure flatten_object_pattern(this, parent: ref[AstNode], pattern: ref[AstNode], value_in: ref[AstNode], pos: int, end: int)
    {
        let f this.the_factory()
        let v tx.the_visitor()
        let elements Emitter.pattern_elements_of(pattern) as ref[Array[ref[AstNode]?]]
        let num_elements elements.get_length() as int
        var value value_in
        if num_elements <> 1
        {
            let reuse_identifier_expressions (Emitter.is_declaration_binding_element(parent) = false) or (num_elements <> 0)
            set value: this.ensure_identifier(value_in, reuse_identifier_expressions, pos, end)
        }
        var binding_elements &Array[ref[AstNode]?]^host()
        let computed_temp_variables &Array[ref[AstNode]?]^host()
        var i 0
        while i < num_elements
        {
            let element elements[i as size_t] as ref[AstNode]
            if Transformer.rest_indicator_of_binding_or_assignment_element(element) = null
            {
                let property_name Transformer.try_get_property_name_of_binding_or_assignment_element(element) as ref[AstNode]
                let target Emitter.target_of_binding_or_assignment_element(element) as ref[AstNode]
                let rest_facts SubtreeContainsRestOrSpread | SubtreeContainsObjectRestOrSpread
                if (level >= FlattenLevelObjectRest) and ((Emitter.subtree_facts(element) & rest_facts) = 0) and ((Emitter.subtree_facts(target) & rest_facts) = 0) and (property_name.kind <> KindComputedPropertyName)
                    binding_elements.add(v.visit_node(element))
                else
                {
                    if binding_elements.get_length() > 0
                    {
                        this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
                        set binding_elements: &Array[ref[AstNode]?]^host()
                    }
                    let rhs_value this.create_destructuring_property_access(value, property_name)
                    if property_name.kind = KindComputedPropertyName
                        computed_temp_variables.add(AstNode.element_access_argument_of(rhs_value))
                    this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                }
            }
            else
            {
                if i = (num_elements - 1)
                {
                    if binding_elements.get_length() > 0
                    {
                        this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
                        set binding_elements: &Array[ref[AstNode]?]^host()
                    }
                    let rhs_value tx.new_rest_helper(value, elements, computed_temp_variables, pattern.pos, pattern.end)
                    this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                }
            }
            set i: i + 1
        }
        if binding_elements.get_length() > 0
            this.emit_binding_or_assignment(this.create_object_pattern(binding_elements), value, pos, end, pattern)
    }

    ; flattenArrayBindingOrAssignmentPattern
    procedure flatten_array_pattern(this, parent: ref[AstNode], pattern: ref[AstNode], value_in: ref[AstNode], pos: int, end: int)
    {
        let f this.the_factory()
        let elements Emitter.pattern_elements_of(pattern) as ref[Array[ref[AstNode]?]]
        let num_elements elements.get_length() as int
        var value value_in
        var all_omitted true
        var oi 0
        while oi < num_elements
        {
            if AstNode.kind_of(elements[oi as size_t]) <> KindOmittedExpression
                set all_omitted: false
            set oi: oi + 1
        }
        if ((num_elements <> 1) and ((level < FlattenLevelObjectRest) or (num_elements = 0))) or all_omitted
        {
            let reuse_identifier_expressions (Emitter.is_declaration_binding_element(parent) = false) or (num_elements <> 0)
            set value: this.ensure_identifier(value_in, reuse_identifier_expressions, pos, end)
        }
        let binding_elements &Array[ref[AstNode]?]^host()
        let rest_ids &Array[ref[AstNode]?]^host()
        let rest_elements &Array[ref[AstNode]?]^host()
        var i 0
        while i < num_elements
        {
            let element elements[i as size_t] as ref[AstNode]
            if level >= FlattenLevelObjectRest
            {
                var needs_temp (Emitter.subtree_facts(element) & SubtreeContainsObjectRestOrSpread) <> 0
                if has_transformed_prior_element and (Transformer.is_simple_binding_or_assignment_element(element) = false)
                    set needs_temp: true
                if needs_temp
                {
                    set this.has_transformed_prior_element: true
                    let temp f.new_temp_variable()
                    if hoist_temp_variables
                        this.the_context().add_variable_declaration(temp)
                    rest_ids.add(temp)
                    rest_elements.add(element)
                    binding_elements.add(this.create_array_element(temp))
                }
                else
                    binding_elements.add(element)
            }
            else
            {
                if element.kind <> KindOmittedExpression
                {
                    if Transformer.rest_indicator_of_binding_or_assignment_element(element) = null
                    {
                        let index_text Transformer.decimal_slice(host, i)
                        let rhs_value f.new_element_access_expression(value, null, f.new_numeric_literal(index_text, TokenFlagsNone), NodeFlagsNone)
                        this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                    }
                    else
                    {
                        if i = (num_elements - 1)
                        {
                            let rhs_value f.new_array_slice_call(value, i)
                            this.flatten_binding_or_assignment_element(element, rhs_value, element.pos, element.end, false)
                        }
                    }
                }
            }
            set i: i + 1
        }
        if binding_elements.get_length() > 0
            this.emit_binding_or_assignment(this.create_array_pattern(binding_elements), value, pos, end, pattern)
        var r 0
        while r < (rest_ids.get_length() as int)
        {
            let element rest_elements[r as size_t] as ref[AstNode]
            this.flatten_binding_or_assignment_element(element, rest_ids[r as size_t], element.pos, element.end, false)
            set r: r + 1
        }
    }
}

; ═══ compiler/emitter.go, the JS half, over the corpus's default options ═══

; What the driver scans a file for before it decides which transformers it
; needs: each bit names a transformer this port has not ported yet.
define EmitFacts
(
    has_import_or_export: bool
    has_runtime_syntax: bool
    has_decorator: bool
    has_using: bool
    has_auto_accessor: bool
    has_dynamic_import: bool
)

define Emitter
(
    host: ref[Page]
    unported_count: int
    unported_tag: Slice[char]
    unported_detail: int
)
{
    function create(host: ref[Page]) returns ref[Emitter]
    {
        let no_tag: Slice[char] ""
        &Emitter^host(host, 0, no_tag, 0)
    }

    procedure record_unported(this, tag_text: Slice[char], detail: int)
    {
        if unported_count = 0
        {
            set this.unported_tag: tag_text
            set this.unported_detail: detail
        }
        set this.unported_count: unported_count + 1
    }

    ; ast.isFileForcedToBeModuleByFormat under moduleDetection "auto": a file
    ; whose implied node format is ESNext (`.mts`/`.mjs`), or a `.mts`/`.mjs`
    ; file outright, is an external module whatever its statements say. The
    ; parser's `external_module_indicator` reads the statements only; the
    ; emitter's file record ORs this in.

    ; Node.SubtreeFacts(): the cached facts of a node, the Computed marker
    ; stripped
    function subtree_facts(n: ref[AstNode]) returns int
    {
        var f n.subtree_facts
        if (f & SubtreeFactsComputed) = 0
        {
            set f: Emitter.compute_subtree_facts(n) | SubtreeFactsComputed
            set n.subtree_facts: f
        }
        f & SubtreeFactsAllBits
    }

    function clear_facts(f: int, mask: int) returns int
        f & (SubtreeFactsAllBits xor mask)

    ; propagateSubtreeFacts(child): nil → none; a type-syntax node answers
    ; SubtreeContainsTypeScript whatever it holds; every other kind answers its
    ; facts minus the bits its scope keeps to itself
    function sf(c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        Emitter.propagate_subtree_facts(c as ref[AstNode])
    }

    function propagate_subtree_facts(n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        let f Emitter.subtree_facts(n)
        if k = KindCatchClause
            return Emitter.clear_facts(f, SubtreeClearsCatchClause)
        if k = KindVariableDeclarationList
            return Emitter.clear_facts(f, SubtreeClearsVariableDeclarationList)
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern)
            return Emitter.clear_facts(f, SubtreeClearsBindingPattern)
        if (k = KindFunctionDeclaration) or (k = KindFunctionExpression) or (k = KindConstructor)
            return Emitter.clear_facts(f, SubtreeClearsFunction)
        if (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
            return Emitter.clear_facts(f, SubtreeClearsFunction) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindPropertyDeclaration
            return Emitter.clear_facts(f, SubtreeClearsProperty) | Emitter.sf(Printer.declaration_name_of(n))
        if k = KindModuleDeclaration
            return Emitter.clear_facts(f, SubtreeClearsModule)
        if k = KindObjectLiteralExpression
            return Emitter.clear_facts(f, SubtreeClearsObjectLiteral)
        if k = KindArrowFunction
            return Emitter.clear_facts(f, SubtreeClearsArrowFunction)
        f
    }

    ; propagateNodeListSubtreeFacts(children, propagateSubtreeFacts)
    function sfl(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sf(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; propagateEraseableSyntaxSubtreeFacts / propagateEraseableSyntaxListSubtreeFacts
    function sfe(c: ref[AstNode]?) returns int
    {
        if c = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    function sfel(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        SubtreeContainsTypeScript
    }

    ; propagateObjectBindingElementSubtreeFacts: a `...rest` inside `{ }` is an
    ; OBJECT rest
    function sfobe(c: ref[AstNode]?) returns int
    {
        var facts Emitter.sf(c)
        if (facts & SubtreeContainsRestOrSpread) <> 0
        {
            set facts: Emitter.clear_facts(facts, SubtreeContainsRestOrSpread)
            set facts: facts | SubtreeContainsObjectRestOrSpread | SubtreeContainsESObjectRestOrSpread
        }
        facts
    }

    ; propagateBindingElementSubtreeFacts: an array pattern's rest is cleared
    function sfbe(c: ref[AstNode]?) returns int
        Emitter.clear_facts(Emitter.sf(c), SubtreeContainsRestOrSpread)

    function sfl_object_binding(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfobe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    function sfl_array_binding(list: ref[Array[ref[AstNode]?]]?) returns int
    {
        if list = null
            return SubtreeFactsNone
        let l list as ref[Array[ref[AstNode]?]]
        var facts SubtreeFactsNone
        var i 0
        while i < (l.get_length() as int)
        {
            set facts: facts | Emitter.sfbe(l[i as size_t])
            set i: i + 1
        }
        facts
    }

    ; The kinds whose record embeds TypeSyntaxBase in the reference (every
    ; TypeNodeBase kind, the JSDoc types, the five type elements, the type
    ; parameter, interface, type alias and `export as namespace`): their facts are
    ; SubtreeContainsTypeScript, computed and propagated alike
    function is_type_syntax_kind(k: int) returns bool
    {
        if (k = KindTypeReference) or (k = KindTypeQuery) or (k = KindImportType) or (k = KindFunctionType) or (k = KindConstructorType) or (k = KindUnionType) or (k = KindIntersectionType) or (k = KindConditionalType) or (k = KindTypeOperator) or (k = KindInferType) or (k = KindArrayType) or (k = KindIndexedAccessType) or (k = KindLiteralType) or (k = KindThisType) or (k = KindTypePredicate) or (k = KindMappedType) or (k = KindTypeLiteral) or (k = KindTupleType) or (k = KindNamedTupleMember) or (k = KindOptionalType) or (k = KindRestType) or (k = KindParenthesizedType) or (k = KindTemplateLiteralType) or (k = KindTemplateLiteralTypeSpan)
            return true
        if (k = KindJSDocTypeExpression) or (k = KindJSDocNameReference) or (k = KindJSDocNonNullableType) or (k = KindJSDocNullableType) or (k = KindJSDocAllType) or (k = KindJSDocVariadicType) or (k = KindJSDocOptionalType) or (k = KindJSDocSignature) or (k = KindJSDocTypeLiteral)
            return true
        if (k = KindInterfaceDeclaration) or (k = KindTypeAliasDeclaration) or (k = KindJSTypeAliasDeclaration) or (k = KindNamespaceExportDeclaration) or (k = KindCallSignature) or (k = KindConstructSignature) or (k = KindIndexSignature) or (k = KindMethodSignature) or (k = KindPropertySignature) or (k = KindTypeParameter)
            return true
        false
    }

    ; Token.computeSubtreeFacts
    function token_subtree_facts(k: int) returns int
    {
        if k = KindUsingKeyword
            return SubtreeContainsUsing
        if (k = KindPublicKeyword) or (k = KindPrivateKeyword) or (k = KindProtectedKeyword) or (k = KindReadonlyKeyword) or (k = KindAbstractKeyword) or (k = KindDeclareKeyword) or (k = KindConstKeyword) or (k = KindAnyKeyword) or (k = KindNumberKeyword) or (k = KindBigIntKeyword) or (k = KindNeverKeyword) or (k = KindObjectKeyword) or (k = KindInKeyword) or (k = KindOutKeyword) or (k = KindOverrideKeyword) or (k = KindStringKeyword) or (k = KindBooleanKeyword) or (k = KindSymbolKeyword) or (k = KindVoidKeyword) or (k = KindUnknownKeyword) or (k = KindUndefinedKeyword) or (k = KindExportKeyword)
            return SubtreeContainsTypeScript
        if k = KindAccessorKeyword
            return SubtreeContainsClassFields
        if k = KindAsyncKeyword
            return SubtreeContainsAnyAwait
        if k = KindSuperKeyword
            return SubtreeContainsLexicalSuper
        if k = KindThisKeyword
            return SubtreeContainsLexicalThis
        if (k = KindAsteriskAsteriskToken) or (k = KindAsteriskAsteriskEqualsToken)
            return SubtreeContainsExponentiationOperator
        if k = KindQuestionQuestionToken
            return SubtreeContainsNullishCoalescing
        if k = KindQuestionDotToken
            return SubtreeContainsOptionalChaining
        if (k = KindQuestionQuestionEqualsToken) or (k = KindBarBarEqualsToken) or (k = KindAmpersandAmpersandEqualsToken)
            return SubtreeContainsLogicalAssignments
        ; JsxOpeningFragment / JsxClosingFragment are Token-arm nodes here
        if (k = KindJsxOpeningFragment) or (k = KindJsxClosingFragment)
            return SubtreeContainsJsx
        SubtreeFactsNone
    }

    function async_generator_facts(is_async: bool, is_generator: bool) returns int
    {
        if is_async and is_generator
            return SubtreeContainsForAwaitOrAsyncGenerator
        if is_async
            return SubtreeContainsAnyAwait
        SubtreeFactsNone
    }

    ; the 110 computeSubtreeFacts, by record and — where records are shared —
    ; by kind
    function compute_subtree_facts(n: ref[AstNode]) returns int
    {
        let k n.kind
        if Emitter.is_type_syntax_kind(k)
            return SubtreeContainsTypeScript
        choose n.data
            when d: Token
                return Emitter.token_subtree_facts(k)
            when d: Identifier
                return SubtreeContainsIdentifier
            when d: PrivateIdentifier
                return SubtreeContainsClassFields
            when d: NoSubstitutionTemplateLiteral
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateHead
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateMiddle
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: TemplateTail
            {
                if (d.token_flags & TokenFlagsContainsInvalidEscape) <> 0
                    return SubtreeContainsInvalidTemplateEscape
                return SubtreeFactsNone
            }
            when d: SourceFile
                return Emitter.sfl(d.statements)
            when d: Block
                return Emitter.sfl(d.statements)
            when d: ModuleBlock
                return Emitter.sfl(d.statements)
            when d: ExpressionStatement
                return Emitter.sf(d.expression)
            when d: ThrowStatement
                return Emitter.sf(d.expression)
            when d: VariableStatement
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.declaration_list)
            }
            when d: VariableDeclarationList
            {
                var f Emitter.sfl(d.declarations)
                if (n.flags & NodeFlagsUsing) <> 0
                    set f: f | SubtreeContainsUsing
                return f
            }
            when d: VariableDeclaration
                return Emitter.sf(d.name) | Emitter.sfe(d.exclamation_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            when d: IfStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.then_statement) | Emitter.sf(d.else_statement)
            when d: DoStatement
                return Emitter.sf(d.statement) | Emitter.sf(d.expression)
            when d: WhileStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: WithStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.condition) | Emitter.sf(d.incrementor) | Emitter.sf(d.statement)
            when d: ForInStatement
                return Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
            when d: ForOfStatement
            {
                var f Emitter.sf(d.initializer) | Emitter.sf(d.expression) | Emitter.sf(d.statement)
                if d.await_modifier <> null
                    set f: f | SubtreeContainsForAwaitOrAsyncGenerator
                return f
            }
            when d: ReturnStatement
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: SwitchStatement
                return Emitter.sf(d.expression) | Emitter.sf(d.case_block)
            when d: CaseBlock
                return Emitter.sfl(d.elements)
            when d: CaseClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: DefaultClause
                return Emitter.sf(d.expression) | Emitter.sfl(d.statements)
            when d: TryStatement
                return Emitter.sf(d.try_block) | Emitter.sf(d.catch_clause) | Emitter.sf(d.finally_block)
            when d: CatchClause
            {
                var f Emitter.sf(d.variable_declaration) | Emitter.sf(d.block)
                if d.variable_declaration = null
                    set f: f | SubtreeContainsMissingCatchClauseVariable
                return f
            }
            when d: LabeledStatement
                return Emitter.sf(d.label_name) | Emitter.sf(d.statement)
            when d: ObjectBindingPattern
                return Emitter.sfl_object_binding(d.elements)
            when d: ArrayBindingPattern
                return Emitter.sfl_array_binding(d.elements)
            when d: Parameter
            {
                if AstNode.is_this_identifier(d.name)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.question_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer)
            }
            when d: BindingElement
            {
                var f Emitter.sf(d.property_name) | Emitter.sf(d.name) | Emitter.sf(d.initializer)
                if d.dot_dot_dot_token <> null
                    set f: f | SubtreeContainsRestOrSpread
                return f
            }
            when d: FunctionDeclaration
            {
                let flags Transformer.modifier_flags_of(n)
                if (d.body = null) or ((flags & ModifierFlagsAmbient) <> 0)
                    return SubtreeContainsTypeScript
                let is_async (flags & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: ClassDeclaration
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: ClassExpression
                return Emitter.class_like_subtree_facts(n, d.modifiers, d.name, d.type_parameters, d.heritage_clauses, d.members)
            when d: HeritageClause
            {
                if d.token = KindExtendsKeyword
                    return Emitter.sfl(d.types)
                if d.token = KindImplementsKeyword
                    return SubtreeContainsTypeScript
                return SubtreeFactsNone
            }
            when d: EnumMember
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsTypeScript
            when d: EnumDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfl(d.members) | SubtreeContainsTypeScript
            }
            when d: ModuleDeclaration
            {
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.body) | SubtreeContainsTypeScript
            }
            when d: ImportEqualsDeclaration
            {
                if d.is_type_only or (d.module_reference.kind <> KindExternalModuleReference)
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sf(d.module_reference)
            }
            when d: ImportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ExportSpecifier
            {
                if d.is_type_only
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.property_name) | Emitter.sf(d.name)
            }
            when d: ImportClause
            {
                if d.phase_modifier = KindTypeKeyword
                    return SubtreeContainsTypeScript
                return Emitter.sf(d.name) | Emitter.sf(d.named_bindings)
            }
            when d: ImportDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.import_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
            when d: ExportAssignment
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.type_node) | Emitter.sf(d.expression)
                if d.is_export_equals
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: ExportDeclaration
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.export_clause) | Emitter.sf(d.module_specifier) | Emitter.sf(d.attributes)
                if d.is_type_only
                    set f: f | SubtreeContainsTypeScript
                return f
            }
            when d: NamespaceImport
                return Emitter.sf(d.inner)
            when d: NamespaceExport
                return Emitter.sf(d.inner)
            when d: ExternalModuleReference
                return Emitter.sf(d.inner)
            when d: NamedImports
                return Emitter.sfl(d.elements)
            when d: NamedExports
                return Emitter.sfl(d.elements)
            when d: ImportAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.value)
            when d: ImportAttributes
                return Emitter.sfl(d.attributes)
            when d: ConstructorDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                return Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
            }
            when d: GetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: SetAccessorDeclaration
                return Emitter.accessor_subtree_facts(d.modifiers, d.name, d.type_parameters, d.parameters, d.type_node, d.full_signature, d.body)
            when d: MethodDeclaration
            {
                if d.body = null
                    return SubtreeContainsTypeScript
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sf(d.body) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: PropertyDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.name) | Emitter.sfe(d.postfix_token) | Emitter.sfe(d.type_node) | Emitter.sf(d.initializer) | SubtreeContainsClassFields
            when d: ClassStaticBlockDeclaration
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.body) | SubtreeContainsClassFields
            when d: BinaryExpression
            {
                let op d.operator_token.kind
                var f Emitter.sfl(d.modifiers) | Emitter.sf(d.left) | Emitter.sf(d.type_node) | Emitter.sf(d.operator_token) | Emitter.sf(d.right)
                if (op = KindInKeyword) and AstNode.is_private_identifier(d.left)
                    set f: f | SubtreeContainsClassFields | SubtreeContainsPrivateIdentifierInExpression
                if op = KindEqualsToken
                {
                    let lk d.left.kind
                    if (lk = KindObjectLiteralExpression) or (lk = KindArrayLiteralExpression)
                    {
                        if Emitter.contains_object_rest_or_spread(d.left)
                            set f: f | SubtreeContainsObjectRestOrSpread
                    }
                }
                return f
            }
            when d: YieldExpression
                return Emitter.sf(d.expression) | SubtreeContainsForAwaitOrAsyncGenerator
            when d: ArrowFunction
            {
                var f Emitter.sfl(d.modifiers) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body)
                if (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                    set f: f | SubtreeContainsAnyAwait
                return f
            }
            when d: FunctionExpression
            {
                let is_async (Transformer.modifier_flags_of(n) & ModifierFlagsAsync) <> 0
                let is_generator d.asterisk_token <> null
                return Emitter.sfl(d.modifiers) | Emitter.sf(d.asterisk_token) | Emitter.sf(d.name) | Emitter.sfel(d.type_parameters) | Emitter.sfl(d.parameters) | Emitter.sfe(d.type_node) | Emitter.sfe(d.full_signature) | Emitter.sf(d.body) | Emitter.async_generator_facts(is_async, is_generator)
            }
            when d: AsExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: SatisfiesExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: TypeAssertionExpression
                return Emitter.sf(d.expression) | SubtreeContainsTypeScript
            when d: NonNullExpression
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript
            when d: PropertyAccessExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.name)
                if AstNode.kind_of(d.name) <> KindIdentifier
                    set f: f | SubtreeContainsPrivateIdentifierInExpression
                return f
            }
            when d: ElementAccessExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sf(d.argument_expression)
            when d: CallExpression
            {
                var f Emitter.sf(d.expression) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
                if AstNode.kind_of(d.expression) = KindImportKeyword
                    set f: f | SubtreeContainsDynamicImport
                return f
            }
            when d: NewExpression
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments) | Emitter.sfl(d.arguments)
            when d: MetaProperty
                return Emitter.clear_facts(Emitter.sf(d.name), SubtreeContainsIdentifier)
            when d: SpreadElement
                return Emitter.sf(d.inner) | SubtreeContainsRestOrSpread
            when d: TaggedTemplateExpression
                return Emitter.sf(d.tag) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.template)
            when d: ArrayLiteralExpression
                return Emitter.sfl(d.elements)
            when d: ObjectLiteralExpression
                return Emitter.sfl(d.elements)
            when d: SpreadAssignment
                return Emitter.sf(d.inner) | SubtreeContainsESObjectRestOrSpread | SubtreeContainsObjectRestOrSpread
            when d: PropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.initializer)
            when d: ShorthandPropertyAssignment
                return Emitter.sf(d.name) | Emitter.sf(d.type_node) | Emitter.sf(d.object_assignment_initializer) | SubtreeContainsTypeScript
            when d: AwaitExpression
                return Emitter.sf(d.inner) | SubtreeContainsAwait | SubtreeContainsAnyAwait | SubtreeContainsForAwaitOrAsyncGenerator
            when d: DeleteExpression
                return Emitter.sf(d.inner)
            when d: TypeOfExpression
                return Emitter.sf(d.inner)
            when d: VoidExpression
                return Emitter.sf(d.inner)
            when d: ParenthesizedExpression
                return Emitter.sf(d.inner)
            when d: PartiallyEmittedExpression
                return Emitter.sf(d.inner)
            when d: ComputedPropertyName
                return Emitter.sf(d.inner)
            when d: PrefixUnaryExpression
                return Emitter.sf(d.operand)
            when d: PostfixUnaryExpression
                return Emitter.sf(d.operand)
            when d: ConditionalExpression
                return Emitter.sf(d.condition) | Emitter.sf(d.question_token) | Emitter.sf(d.when_true) | Emitter.sf(d.colon_token) | Emitter.sf(d.when_false)
            when d: TemplateExpression
                return Emitter.sf(d.head) | Emitter.sfl(d.template_spans)
            when d: TaggedTemplateExpression
                return Emitter.sf(d.tag) | Emitter.sf(d.question_dot_token) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.template)
            when d: TemplateSpan
                return Emitter.sf(d.expression) | Emitter.sf(d.literal)
            when d: ExpressionWithTypeArguments
                return Emitter.sf(d.expression) | Emitter.sfel(d.type_arguments)
            when d: QualifiedName
                return Emitter.sf(d.left) | Emitter.sf(d.right)
            when d: SyntheticReferenceExpression
                return Emitter.sf(d.expression) | Emitter.sf(d.this_arg)
            when d: Decorator
                return Emitter.sf(d.inner) | SubtreeContainsTypeScript | SubtreeContainsDecorators
            when d: JsxElement
                return Emitter.sf(d.opening_element) | Emitter.sfl(d.children) | Emitter.sf(d.closing_element) | SubtreeContainsJsx
            when d: JsxAttributes
                return Emitter.sfl(d.elements) | SubtreeContainsJsx
            when d: JsxNamespacedName
                return Emitter.sf(d.namespace_name) | Emitter.sf(d.name) | SubtreeContainsJsx
            when d: JsxOpeningElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxSelfClosingElement
                return Emitter.sf(d.tag_name) | Emitter.sfel(d.type_arguments) | Emitter.sf(d.attributes) | SubtreeContainsJsx
            when d: JsxFragment
                return Emitter.sfl(d.children) | SubtreeContainsJsx
            when d: JsxAttribute
                return Emitter.sf(d.name) | Emitter.sf(d.initializer) | SubtreeContainsJsx
            when d: JsxSpreadAttribute
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxClosingElement
                return Emitter.sf(d.inner) | SubtreeContainsJsx
            when d: JsxExpression
                return Emitter.sf(d.expression) | SubtreeContainsJsx
            when d: JsxText
                return SubtreeContainsJsx
            else
                return SubtreeFactsNone
        SubtreeFactsNone
    }

    ; ClassLikeBase.computeSubtreeFacts
    function class_like_subtree_facts(n: ref[AstNode], modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, heritage_clauses: ref[Array[ref[AstNode]?]]?, members: ref[Array[ref[AstNode]?]]?) returns int
    {
        if (Transformer.modifier_flags_of(n) & ModifierFlagsAmbient) <> 0
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(heritage_clauses) | Emitter.sfl(members)
    }

    ; AccessorDeclarationBase.computeSubtreeFacts
    function accessor_subtree_facts(modifiers: ref[Array[ref[AstNode]?]]?, name: ref[AstNode]?, type_parameters: ref[Array[ref[AstNode]?]]?, parameters: ref[Array[ref[AstNode]?]]?, type_node: ref[AstNode]?, full_signature: ref[AstNode]?, body: ref[AstNode]?) returns int
    {
        if body = null
            return SubtreeContainsTypeScript
        Emitter.sfl(modifiers) | Emitter.sf(name) | Emitter.sfel(type_parameters) | Emitter.sfl(parameters) | Emitter.sfe(type_node) | Emitter.sfe(full_signature) | Emitter.sf(body)
    }

    ; ── ast/utilities.go: the binding-pattern questions the facts ask ──

    ; IsAssignmentPattern
    function is_assignment_pattern(n: ref[AstNode]?) returns bool
    {
        let k AstNode.kind_of(n)
        (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
    }

    ; GetElementsOfBindingOrAssignmentPattern
    function elements_of_binding_or_assignment_pattern(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        let k n.kind
        if (k = KindObjectBindingPattern) or (k = KindArrayBindingPattern) or (k = KindArrayLiteralExpression) or (k = KindObjectLiteralExpression)
            return Emitter.pattern_elements_of(n)
        null
    }

    ; the ElementListData arms a binding or assignment pattern can be
    function pattern_elements_of(n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]?
    {
        choose n.data
            when d: ObjectBindingPattern
                return d.elements
            when d: ArrayBindingPattern
                return d.elements
            when d: ArrayLiteralExpression
                return d.elements
            when d: ObjectLiteralExpression
                return d.elements
        null
    }

    ; IsDeclarationBindingElement
    function is_declaration_binding_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindVariableDeclaration) or (k = KindParameter) or (k = KindBindingElement)
    }

    ; IsObjectLiteralElement
    function is_object_literal_element(n: ref[AstNode]) returns bool
    {
        let k n.kind
        (k = KindPropertyAssignment) or (k = KindShorthandPropertyAssignment) or (k = KindSpreadAssignment) or (k = KindMethodDeclaration) or (k = KindGetAccessor) or (k = KindSetAccessor)
    }

    ; GetTargetOfBindingOrAssignmentElement
    function target_of_binding_or_assignment_element(n: ref[AstNode]?) returns ref[AstNode]?
    {
        if n = null
            return null
        let e n as ref[AstNode]
        if Emitter.is_declaration_binding_element(e)
            return Printer.declaration_name_of(e)
        if Emitter.is_object_literal_element(e)
        {
            let k e.kind
            if k = KindPropertyAssignment
                return Emitter.target_of_binding_or_assignment_element(AstNode.initializer_of(e))
            if k = KindShorthandPropertyAssignment
                return Printer.declaration_name_of(e)
            if k = KindSpreadAssignment
                return Emitter.target_of_binding_or_assignment_element(AstNode.expression_of(e))
            return null
        }
        if Emitter.is_assignment_expression(e, true)
            return Emitter.target_of_binding_or_assignment_element(AstNode.binary_left_of(e))
        if e.kind = KindSpreadElement
            return Emitter.target_of_binding_or_assignment_element(AstNode.expression_of(e))
        e
    }

    ; IsAssignmentExpression(node, excludeCompoundAssignment)
    function is_assignment_expression(n: ref[AstNode], exclude_compound: bool) returns bool
    {
        if n.kind <> KindBinaryExpression
            return false
        let op AstNode.kind_of(AstNode.binary_operator_token_of(n))
        if exclude_compound
        {
            if op <> KindEqualsToken
                return false
        }
        if exclude_compound = false
        {
            if Parser.is_assignment_operator(op) = false
                return false
        }
        Parser.is_left_hand_side_expression_kind(AstNode.kind_of(AstNode.binary_left_of(n)))
    }

    ; ContainsObjectRestOrSpread
    function contains_object_rest_or_spread(n: ref[AstNode]) returns bool
    {
        if (Emitter.subtree_facts(n) & SubtreeContainsObjectRestOrSpread) <> 0
            return true
        if (Emitter.subtree_facts(n) & SubtreeContainsESObjectRestOrSpread) <> 0
        {
            ; check for nested spread assignments, otherwise '{ x: { a, ...b } = foo } = c'
            ; will not be correctly interpreted by the rest/spread transformer
            let elements Emitter.elements_of_binding_or_assignment_pattern(n)
            if elements = null
                return false
            let l elements as ref[Array[ref[AstNode]?]]
            var i 0
            while i < (l.get_length() as int)
            {
                let target Emitter.target_of_binding_or_assignment_element(l[i as size_t])
                set i: i + 1
                if target = null
                    continue
                let t target as ref[AstNode]
                if Emitter.is_assignment_pattern(t) = false
                    continue
                if (Emitter.subtree_facts(t) & SubtreeContainsObjectRestOrSpread) <> 0
                    return true
                if (Emitter.subtree_facts(t) & SubtreeContainsESObjectRestOrSpread) <> 0
                {
                    if Emitter.contains_object_rest_or_spread(t)
                        return true
                }
            }
        }
        false
    }

    ; internal/vfs/internal/internal.go decodeBytes + decodeUtf16: the compiler
    ; host reads a source file THROUGH this — a UTF-16 file (either byte order
    ; mark) is transcoded to UTF-8 and a UTF-8 mark is dropped — while the
    ; yardstick oracles read the raw bytes (os.ReadFile). The emit baseline is
    ; the decoded file's, so the emit path decodes and the other six do not;
    ; tscaly_dump re-parses the decoded text for the emit alone. Answers true
    ; when `out` holds a DIFFERENT text than `text` (a mark was found).
    function decode_bytes(text: Slice[char], out: ref[StringBuilder]) returns bool
    {
        let n text.length
        if n >= 2
        {
            let b0 text[0] as int
            let b1 text[1] as int
            if (b0 = 0xFF) and (b1 = 0xFE)
            {
                Emitter.decode_utf16(text, 2, true, out)
                return true
            }
            if (b0 = 0xFE) and (b1 = 0xFF)
            {
                Emitter.decode_utf16(text, 2, false, out)
                return true
            }
        }
        if n >= 3
        {
            if ((text[0] as int) = 0xEF) and ((text[1] as int) = 0xBB) and ((text[2] as int) = 0xBF)
            {
                out.append(text.data + 3, (n - 3) as size_t)
                return true
            }
        }
        false
    }

    ; decodeUtf16: the code units in the given byte order (an odd trailing byte
    ; is dropped, as binary.Read's len/2 does), unicode/utf16.Decode's pairing
    ; (an unpaired surrogate becomes U+FFFD), then UTF-8.
    function decode_utf16(text: Slice[char], start: int, little_endian: bool, out: ref[StringBuilder])
    {
        let units (text.length - start) / 2
        var i 0
        while i < units
        {
            var u Emitter.utf16_unit_at(text, start + i * 2, little_endian)
            set i: i + 1
            var cp u
            if (u >= 0xD800) and (u < 0xDC00)
            {
                set cp: 0xFFFD
                if i < units
                {
                    let lo Emitter.utf16_unit_at(text, start + i * 2, little_endian)
                    if (lo >= 0xDC00) and (lo < 0xE000)
                    {
                        set cp: 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00)
                        set i: i + 1
                    }
                }
            }
            if (u >= 0xDC00) and (u < 0xE000)
                set cp: 0xFFFD
            Emitter.append_utf8(out, cp)
        }
    }

    function utf16_unit_at(text: Slice[char], at: int, little_endian: bool) returns int
    {
        let a text[at] as int
        let b text[at + 1] as int
        if little_endian
            return (a & 0xFF) | ((b & 0xFF) << 8)
        ((a & 0xFF) << 8) | (b & 0xFF)
    }

    function append_utf8(out: ref[StringBuilder], cp: int)
    {
        if cp < 0x80
        {
            out.append(cp as char)
            return
        }
        if cp < 0x800
        {
            out.append((0xC0 | (cp >> 6)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        if cp < 0x10000
        {
            out.append((0xE0 | (cp >> 12)) as char)
            out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
            out.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        out.append((0xF0 | (cp >> 18)) as char)
        out.append((0x80 | ((cp >> 12) & 0x3F)) as char)
        out.append((0x80 | ((cp >> 6) & 0x3F)) as char)
        out.append((0x80 | (cp & 0x3F)) as char)
    }

    function is_file_forced_to_be_module_by_format(file_name: Slice[char], options: EmitOptions) returns bool
    {
        ; a declaration file still needs an explicit `export {}` (the caller's
        ; IsDeclarationFileName guard in ast/parseoptions.go)
        if file_name.ends_with(".d.ts") or file_name.ends_with(".d.mts") or file_name.ends_with(".d.cts")
            return false
        ; moduleDetection force: every non-declaration file is a module
        if options.module_detection = ModuleDetectionKindForce
            return true
        if options.module_detection = ModuleDetectionKindLegacy
            return false
        ; GetImpliedNodeFormatForEmitWorker answers ESNext only for an .mjs/.mts file
        ; (or a package.json `type: module`, which no case here carries) — the module
        ; KIND alone forces nothing (§3.5jp)
        file_name.ends_with(".mts") or file_name.ends_with(".mjs") or file_name.ends_with(".cts") or file_name.ends_with(".cjs")
    }

    ; the file's identifier table (sourceFile.Identifiers): every Identifier and
    ; PrivateIdentifier text in the tree, once
    function collect_identifiers(host: ref[Page], node: ref[AstNode], out: ref[Array[Slice[char]]])
    {
        let k node.kind
        if (k = KindIdentifier) or (k = KindPrivateIdentifier)
        {
            let text AstNode.identifier_text_of(node)
            if NameGenerator.names_contain(out, text) = false
                out.add(text)
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            Emitter.collect_identifiers(host, child as ref[AstNode], out)
            set i: i + 1
        }
    }

    procedure scan(this, node: ref[AstNode], checker: ref[Checker], facts: ref[EmitFacts])
    {
        let k node.kind
        if (k = KindImportDeclaration) or (k = KindExportDeclaration) or (k = KindExportAssignment) or (k = KindNamespaceExportDeclaration) or (k = KindImportEqualsDeclaration)
            set facts.has_import_or_export: true
        if k = KindEnumDeclaration
            set facts.has_runtime_syntax: true
        ; an INTERNAL `import x = N.M` (an entity-name reference) is rewritten to
        ; `var x = N.M` by runtimesyntax.go's visitImportEqualsDeclaration
        if k = KindImportEqualsDeclaration
        {
            if AstNode.kind_of(AstNode.module_reference_of(node)) <> KindExternalModuleReference
                set facts.has_runtime_syntax: true
        }
        if k = KindModuleDeclaration
        {
            ; the eraser drops a non-instantiated one itself; an instantiated one
            ; is the runtime-syntax transformer's
            if checker.is_instantiated_module(node)
                set facts.has_runtime_syntax: true
        }
        if k = KindParameter
        {
            if Transformer.is_parameter_property_declaration(node, node.parent)
                set facts.has_runtime_syntax: true
        }
        if k = KindDecorator
            set facts.has_decorator: true
        if k = KindVariableDeclarationList
        {
            if (node.flags & NodeFlagsUsing) <> 0
                set facts.has_using: true
        }
        if k = KindAccessorKeyword
            set facts.has_auto_accessor: true
        if k = KindCallExpression
        {
            if Parser.is_import_call(node)
                set facts.has_dynamic_import: true
        }
        if k = KindMetaProperty
        {
            if AstNode.meta_property_keyword_token_of(node) = KindImportKeyword
                set facts.has_dynamic_import: true
        }
        var i 0
        while true
        {
            let child AstNode.child_at(node, i)
            if child = null
                break
            this.scan(child as ref[AstNode], checker, facts)
            set i: i + 1
        }
    }

    ; emitJSFile for one file under the default options: the transformers in
    ; getScriptTransformers' order, then the printer. The JS text is APPENDED to
    ; `out`, the caller's builder; a said stop leaves `unported_count` > 0 and
    ; appends nothing. ★Neither a returned nor a stored String survives this
    ; routine: `to_string()` constructs on the CALLER page, which for a call
    ; made here is this routine's own region — gone with the return, and the
    ; text read back as garbage three units in (root CLAUDE.md, the out-param
    ; class). The bytes are copied out while the region lives.
    procedure emit_js(this, file: ref[AstNode], info: ref[SourceFileInfo], options: EmitOptions, checker: ref[Checker], binder: ref[Binder], out: ref[StringBuilder])
    {
        ; sourceFileMayBeEmitted: no JS for a declaration file, nor for JSON
        ; without an outDir
        if info.is_declaration_file
            return
        if info.script_kind = ScriptKindJSON
            return
        ; a JavaScript file is not in the program without allowJs (the yardstick's
        ; default options), so the reference emits nothing for it: 158 `.js`,
        ; 4 `.jsx` and 2 `.cjs` units of the corpus, every reference answer empty
        if (info.script_kind = ScriptKindJS) or (info.script_kind = ScriptKindJSX)
        {
            if options.allow_js <> TristateTrue
                return
        }
        var facts EmitFacts(false, false, false, false, false, false)
        this.scan(file, checker, &facts)
        ; getScriptTransformers, each gate a transformer not yet ported
        let import_elision_enabled (options.verbatim_module_syntax <> TristateTrue) and ((file.flags & NodeFlagsJavaScriptFile) = 0)
        ; the declaration emitter and the source map generator are chapters of
        ; their own (the reference's emitDeclarationFile, printSourceFile)
        if options.emit_declaration_only = TristateTrue
            this.record_unported("emit-declaration", 0)
        if (options.source_map = TristateTrue) or (options.inline_source_map = TristateTrue)
            this.record_unported("emit-sourcemap", 0)
        if options.get_jsx_transform_enabled()
            this.record_unported("transform-jsx", 0)
        ; estransforms.GetESTransformer at the default target: using, ES decorators, class fields
        let target options.get_emit_script_target()
        if target < ScriptTargetES2015
            this.record_unported("transform-es-downlevel", target)
        let module_kind options.get_emit_module_kind()
        let format options.get_emit_module_format_of_file(info.file_name)
        if module_kind = ModuleKindPreserve
            this.record_unported("transform-module-preserve", 0)
        else
        {
            ; getModuleTransformer: ES2015..NodeNext → the implied module transformer,
            ; Preserve → ESM, System → its own transformer, the rest → CommonJS
            if module_kind = ModuleKindSystem
                this.record_unported("transform-system", module_kind)
        }
        if unported_count > 0
            return
        let context EmitContext.create(host, AstNode.list_ranges_of(file))
        let opts TransformOptions(context, options, checker, binder, info)
        var current file
        ; use type nodes to add metadata decorators
        let metadata_tx Transformer.create(host, TransformerTagMetadata, opts)
        if options.emit_decorator_metadata = TristateTrue
        {
            set metadata_tx.md_strict_null_checks: options.get_strict_option_value(options.strict_null_checks)
            set current: metadata_tx.transform_source_file(current)
        }
        let eraser Transformer.create(host, TransformerTagTypeEraser, opts)
        set current: eraser.transform_source_file(current)
        let elision Transformer.create(host, TransformerTagImportElision, opts)
        if import_elision_enabled
            set current: elision.transform_source_file(current)
        ; transform `enum`, `namespace`, and parameter properties
        let runtime Transformer.create(host, TransformerTagRuntimeSyntax, opts)
        set current: runtime.transform_source_file(current)
        let legacy_tx Transformer.create(host, TransformerTagLegacyDecorators, opts)
        if options.experimental_decorators = TristateTrue
            set current: legacy_tx.transform_source_file(current)
        ; estransforms.GetESTransformer: at ESNext only ES decorators and class
        ; fields; from ES2025 down (NewESNextTransformer) `using` runs first
        let using_tx Transformer.create(host, TransformerTagUsing, opts)
        if target < ScriptTargetLatest
            set current: using_tx.transform_source_file(current)
        ; newESDecoratorTransformer: nothing to do under experimentalDecorators or
        ; at ESNext with useDefineForClassFields
        let es_decorators Transformer.create(host, TransformerTagESDecorator, opts)
        if (options.experimental_decorators <> TristateTrue) and ((target < ScriptTargetLatest) or (options.get_use_define_for_class_fields() = false))
            set current: es_decorators.transform_source_file(current)
        ; newClassFieldsTransformer: nothing at ESNext with useDefineForClassFields
        let class_fields Transformer.create(host, TransformerTagClassFields, opts)
        if (target < ScriptTargetLatest) or (options.get_use_define_for_class_fields() = false)
        {
            class_fields.cf_configure()
            set current: class_fields.transform_source_file(current)
        }
        ; the rest of GetESTransformer's chains, one transformer per target step
        let logical_tx Transformer.create(host, TransformerTagLogicalAssignment, opts)
        if target < ScriptTargetES2021
            set current: logical_tx.transform_source_file(current)
        let nullish_tx Transformer.create(host, TransformerTagNullishCoalescing, opts)
        let chain_tx Transformer.create(host, TransformerTagOptionalChain, opts)
        if target < ScriptTargetES2020
        {
            set current: nullish_tx.transform_source_file(current)
            set current: chain_tx.transform_source_file(current)
        }
        let catch_tx Transformer.create(host, TransformerTagOptionalCatch, opts)
        if target < ScriptTargetES2019
            set current: catch_tx.transform_source_file(current)
        let ors_tx Transformer.create(host, TransformerTagObjectRestSpread, opts)
        let forawait_tx Transformer.create(host, TransformerTagForAwait, opts)
        let tagged_tx Transformer.create(host, TransformerTagTaggedTemplate, opts)
        if target < ScriptTargetES2018
        {
            set current: ors_tx.transform_source_file(current)
            set current: forawait_tx.transform_source_file(current)
            set current: tagged_tx.transform_source_file(current)
        }
        let async_tx Transformer.create(host, TransformerTagAsync, opts)
        if target < ScriptTargetES2017
            set current: async_tx.transform_source_file(current)
        let exp_tx Transformer.create(host, TransformerTagExponentiation, opts)
        if target < ScriptTargetES2016
            set current: exp_tx.transform_source_file(current)
        let use_strict Transformer.create(host, TransformerTagUseStrict, opts)
        set current: use_strict.transform_source_file(current)
        ; the implied module transformer: ESM by the file's format, else CommonJS
        ; (moduletransforms/impliedmodule.go; ES2015..NodeNext, Preserve → ESM)
        var module_tag TransformerTagESModule
        if format < ModuleKindES2015
            set module_tag: TransformerTagCommonJS
        let es_module Transformer.create(host, module_tag, opts)
        set current: es_module.transform_source_file(current)
        ; inlining (formerly done via substitutions)
        let inliner Transformer.create(host, TransformerTagConstEnumInlining, opts)
        if options.get_isolated_modules() = false
            set current: inliner.transform_source_file(current)
        if metadata_tx.unported_count > 0
            this.record_unported(metadata_tx.unported_tag, metadata_tx.unported_detail)
        if eraser.unported_count > 0
            this.record_unported(eraser.unported_tag, eraser.unported_detail)
        if legacy_tx.unported_count > 0
            this.record_unported(legacy_tx.unported_tag, legacy_tx.unported_detail)
        if elision.unported_count > 0
            this.record_unported(elision.unported_tag, elision.unported_detail)
        if runtime.unported_count > 0
            this.record_unported(runtime.unported_tag, runtime.unported_detail)
        if using_tx.unported_count > 0
            this.record_unported(using_tx.unported_tag, using_tx.unported_detail)
        if es_decorators.unported_count > 0
            this.record_unported(es_decorators.unported_tag, es_decorators.unported_detail)
        if class_fields.unported_count > 0
            this.record_unported(class_fields.unported_tag, class_fields.unported_detail)
        if logical_tx.unported_count > 0
            this.record_unported(logical_tx.unported_tag, logical_tx.unported_detail)
        if nullish_tx.unported_count > 0
            this.record_unported(nullish_tx.unported_tag, nullish_tx.unported_detail)
        if chain_tx.unported_count > 0
            this.record_unported(chain_tx.unported_tag, chain_tx.unported_detail)
        if catch_tx.unported_count > 0
            this.record_unported(catch_tx.unported_tag, catch_tx.unported_detail)
        if ors_tx.unported_count > 0
            this.record_unported(ors_tx.unported_tag, ors_tx.unported_detail)
        if forawait_tx.unported_count > 0
            this.record_unported(forawait_tx.unported_tag, forawait_tx.unported_detail)
        if tagged_tx.unported_count > 0
            this.record_unported(tagged_tx.unported_tag, tagged_tx.unported_detail)
        if async_tx.unported_count > 0
            this.record_unported(async_tx.unported_tag, async_tx.unported_detail)
        if exp_tx.unported_count > 0
            this.record_unported(exp_tx.unported_tag, exp_tx.unported_detail)
        if use_strict.unported_count > 0
            this.record_unported(use_strict.unported_tag, use_strict.unported_detail)
        if es_module.unported_count > 0
            this.record_unported(es_module.unported_tag, es_module.unported_detail)
        if inliner.unported_count > 0
            this.record_unported(inliner.unported_tag, inliner.unported_detail)
        if unported_count > 0
            return
        ; the printer, over the TRANSFORMED file (its record's node is the one it prints)
        set info.node: current
        let printer_options PrinterOptions(options.remove_comments, options.new_line, options.no_emit_helpers, options.target, false, false, false, false, false, false, false, false)
        let printer Printer.create(host, printer_options, context)
        let writer TextWriter.create(host, printer_options.new_line_character(), 0)
        printer.write_node(current, info, writer, null)
        ; printSourceFile: no source maps, so a line, then the text
        writer.write_line()
        if printer.unported_count > 0
        {
            this.record_unported(printer.unported_tag, printer.unported_detail)
            return
        }
        let text writer.to_string()
        out.append(text.get_buffer(), text.get_length())
    }
}
