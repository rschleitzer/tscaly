        Transformer.dt_select_by_module_name(result, DiagReturn_type_of_public_getter_0_from_exported_class_has_or_is_using_name_1_from_external_module_2_but_cannot_be_named, DiagReturn_type_of_public_getter_0_from_exported_class_has_or_is_using_name_1_from_private_module_2, DiagReturn_type_of_public_getter_0_from_exported_class_has_or_is_using_private_name_1)
