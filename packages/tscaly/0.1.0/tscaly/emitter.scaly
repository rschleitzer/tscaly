        }
        ; "Attempted to set a declaration diagnostic context for unhandled node kind"
        this.record_unported("dts-diagnostic-context", k)
        DtDiagnostic(null, 0, null)
    }

    function dt_select_by_module_name(result: SymbolAccessibilityResult, module_not_nameable: int, private_module: int, non_module: int) returns int
    {
        if result.error_module_name.length > 0
        {
            if result.accessibility = SymbolAccessibilityCannotBeNamed
                return module_not_nameable
            return private_module
        }
        non_module
    }

    function dt_select_by_module_name_no_name_check(result: SymbolAccessibilityResult, private_module: int, non_module: int) returns int
    {
        if result.error_module_name.length > 0
            return private_module
        non_module
    }

    function dt_accessor_name_visibility_code(node: ref[AstNode], result: SymbolAccessibilityResult) returns int
    {
        if Transformer.is_static_member(node)
