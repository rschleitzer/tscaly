    ; the enum map of option `i` at the lower-cased key: the value text, empty
    ; when the key is not in the map (or the option has no map)
    function enum_value(i: int, key: Slice[char]) returns Slice[char]
    {
        if i = 37
        {
            if key.equals("es5")
                return "lib.es5.d.ts"
            if key.equals("es6")
                return "lib.es2015.d.ts"
            if key.equals("es2015")
                return "lib.es2015.d.ts"
            if key.equals("es7")
                return "lib.es2016.d.ts"
