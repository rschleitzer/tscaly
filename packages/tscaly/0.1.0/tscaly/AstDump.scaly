; SPDX-License-Identifier: Apache-2.0
;
; AstDump — our half of the PARSER yardstick's dump, moved out of the program.
;
; ★★★ IT LIVES HERE SO THAT TWO DRIVERS CAN SHARE IT, and that is the whole
; reason it moved (slice 58). `tscaly_ast` carried these three sections inline;
; `tscaly_dump` produces all five artifacts of a unit in ONE process, and two
; copies of a dump body that must stay in step is a worse defect than the 220 s
; the combined program buys. SymbolDump and TypeDump were already on this side of
; the line; these were the last three sections that were not.
;
; ★★ THREE SECTIONS, IN THIS ORDER, because that is the order the oracle prints
; them in: the pre-order tree walk, then `sf.Diagnostics()`, then
; `sf.JSDiagnostics()` — the third being a list of its own that the second does
; not include (slice 24).
;
; ★ THE DIAGNOSTICS ARE IN EMISSION ORDER AND NOT SORTED. `finishSourceFile` does
; `SetDiagnostics(attachFileToDiagnostics(p.diagnostics, result))` with no sort and
; no filter, so the list is compared exactly as it was appended — which is why a
; scan error has to be appended at the moment of scanning rather than collected
; and merged afterwards.
;
; ★ One StringBuilder and one write, the idiom TypeDump uses: the program it came
; from printed a line at a time through the prelude's `print`, i.e. a `puts` per
; line. Same bytes, one syscall. ★And it matters for more than speed — the
; prelude's `print` and `Console.print` are DIFFERENT STREAMS to the same fd
; (stdio's buffer against a raw write), so a program that mixes them reorders its
; own output. One stream per program run; see tscaly_types.scaly, where that cost
; 97 units.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.io.Console
use tscaly.ast.AstNode

define AstDump
{
    procedure write(host: pointer[Page], file: pointer[AstNode])
    {
        let sb StringBuilder^host()
        AstDump.tree(sb, file, 0)

        var di 0
        let dn AstNode.diagnostic_count(file)
        while di < dn
        {
            var dpos 0
            var dend 0
            var dcode 0
            if AstNode.diagnostic_at(file, di, &dpos, &dend, &dcode)
            {
                sb.append("D ")
                sb.append(dpos)
                sb.append(" " as char)
                sb.append(dend)
                sb.append(" " as char)
                sb.append(dcode)
                sb.append("\n" as char)
            }
            set di: di + 1
        }

        var ji 0
        let jn AstNode.js_diagnostic_count(file)
        while ji < jn
        {
            var jpos 0
            var jend 0
            var jcode 0
            if AstNode.js_diagnostic_at(file, ji, &jpos, &jend, &jcode)
            {
                sb.append("J ")
                sb.append(jpos)
                sb.append(" " as char)
                sb.append(jend)
                sb.append(" " as char)
                sb.append(jcode)
                sb.append("\n" as char)
            }
            set ji: ji + 1
        }

        let s sb.to_string()
        Console.print(s.to_c_string())
    }

    procedure tree(sb: pointer[StringBuilder], n: pointer[AstNode], depth: int)
    {
        sb.append(depth)
        sb.append(" " as char)
        sb.append(AstNode.kind_of(n))
        sb.append(" " as char)
        sb.append(AstNode.pos_of(n))
        sb.append(" " as char)
        sb.append(AstNode.end_of(n))
        sb.append(" " as char)
        sb.append(AstNode.flags_of(n))
        sb.append("\n" as char)
        var i 0
        let count AstNode.child_count(n)
        while i < count
        {
            AstDump.tree(sb, AstNode.child_at(n, i), depth + 1)
            set i: i + 1
        }
    }
}
