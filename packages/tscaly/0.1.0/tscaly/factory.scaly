    ; UpdateTryStatement
    procedure update_try_statement(this, node: ref[AstNode], try_block: ref[AstNode]?, catch_clause: ref[AstNode]?, finally_block: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: TryStatement
            {
                var changed false
                let cmp_try_block: ref[AstNode]? d.try_block
                if try_block <> cmp_try_block
                    set changed: true
                let cmp_catch_clause: ref[AstNode]? d.catch_clause
                if catch_clause <> cmp_catch_clause
                    set changed: true
                let cmp_finally_block: ref[AstNode]? d.finally_block
                if finally_block <> cmp_finally_block
                    set changed: true
                if changed
                    return this.update_node(this.new_try_statement(try_block, catch_clause, finally_block), node)
                return node
            }
        node
    }

    ; NewCatchClause
    procedure new_catch_clause(this, variable_declaration: ref[AstNode]?, block: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindCatchClause, NodeData.CatchClause(CatchClauseData(variable_declaration, (block as ref[AstNode]))))
        n
