                if changed
                    return this.update_node(this.new_binding_pattern(node.kind, elements), node)
                return node
            }
            when d: ArrayBindingPattern
            {
                var changed false
                let cmp_elements: ref[Array[ref[AstNode]?]]? d.elements
                if elements <> cmp_elements
                    set changed: true
