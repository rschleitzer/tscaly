    ; NewCaseBlock
    procedure new_case_block(this, clauses: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        let n this.new_node(KindCaseBlock, NodeData.CaseBlock(ElementListData((clauses as ref[Array[ref[AstNode]?]]), false)))
        n
    }

    ; UpdateCaseBlock
    procedure update_case_block(this, node: ref[AstNode], clauses: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        choose node.data
            when d: CaseBlock
            {
                var changed false
                let cmp_elements: ref[Array[ref[AstNode]?]]? d.elements
                if clauses <> cmp_elements
                    set changed: true
                if changed
                    return this.update_node(this.new_case_block(clauses), node)
                return node
            }
        node
    }

    ; NewCaseOrDefaultClause
    procedure new_case_or_default_clause(this, kind: int, expression: ref[AstNode]?, statements: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        var n: ref[AstNode]? null
        if kind = KindCaseClause
            set n: this.new_node(kind, NodeData.CaseClause(CaseOrDefaultClauseData(expression, statements)))
        if n = null
            set n: this.new_node(kind, NodeData.DefaultClause(CaseOrDefaultClauseData(expression, statements)))
        let node n as ref[AstNode]
        node
    }

    ; UpdateCaseOrDefaultClause
    procedure update_case_or_default_clause(this, node: ref[AstNode], expression: ref[AstNode]?, statements: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        choose node.data
            when d: CaseClause
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statements: ref[Array[ref[AstNode]?]]? d.statements
                if statements <> cmp_statements
                    set changed: true
                if changed
                    return this.update_node(this.new_case_or_default_clause(node.kind, expression, statements), node)
                return node
            }
            when d: DefaultClause
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statements: ref[Array[ref[AstNode]?]]? d.statements
                if statements <> cmp_statements
                    set changed: true
                if changed
                    return this.update_node(this.new_case_or_default_clause(node.kind, expression, statements), node)
                return node
            }
        node
    }

