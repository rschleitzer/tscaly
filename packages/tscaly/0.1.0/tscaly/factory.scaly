    }

    ; NewSwitchStatement
    procedure new_switch_statement(this, expression: ref[AstNode]?, case_block: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindSwitchStatement, NodeData.SwitchStatement(SwitchStatementData((expression as ref[AstNode]), (case_block as ref[AstNode]))))
        n
    }

    ; UpdateSwitchStatement
    procedure update_switch_statement(this, node: ref[AstNode], expression: ref[AstNode]?, case_block: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: SwitchStatement
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_case_block: ref[AstNode]? d.case_block
                if case_block <> cmp_case_block
                    set changed: true
                if changed
                    return this.update_node(this.new_switch_statement(expression, case_block), node)
