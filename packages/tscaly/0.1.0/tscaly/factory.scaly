    ; NewTryStatement
    procedure new_try_statement(this, try_block: ref[AstNode]?, catch_clause: ref[AstNode]?, finally_block: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindTryStatement, NodeData.TryStatement(TryStatementData((try_block as ref[AstNode]), catch_clause, finally_block)))
        n
