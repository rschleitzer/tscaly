; ast.NodeVisitor. `visit_tag` names the callback the reference passes as a func
; value (§3.18): the deep-clone visitor here, each transformer in its own slice.
; `hooks_tag` names the hook set: none, the emit context's, the deep clone's.
define VisitTagNone: int 0
define VisitTagDeepClone: int 1
define HooksTagNone: int 0
define HooksTagEmitContext: int 1
define HooksTagDeepClone: int 2

define NodeVisitor
(
    host: ref[Page]
    factory: ref[NodeFactory]
    visit_tag: int
    hooks_tag: int
    synthetic_location: bool
)
{
    function create(host: ref[Page], factory: ref[NodeFactory], visit_tag: int, hooks_tag: int) returns ref[NodeVisitor]
        &NodeVisitor^host(host, factory, visit_tag, hooks_tag, false)

    ; VisitEachChild: the per-kind dispatch (generated).
    procedure visit_each_child(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if visit_tag = VisitTagNone
            return node
        let n node as ref[AstNode]
        choose n.data
            when d: QualifiedName
                return factory.update_qualified_name(n, this.visit_node_h(d.left), this.visit_node_h(d.right))
            when d: ComputedPropertyName
                return factory.update_computed_property_name(n, this.visit_node_h(d.inner))
            when d: Decorator
                return factory.update_decorator(n, this.visit_node_h(d.inner))
            when d: IfStatement
                return factory.update_if_statement(n, this.visit_node_h(d.expression), this.visit_embedded_statement_h(d.then_statement), this.visit_embedded_statement_h(d.else_statement))
            when d: DoStatement
                return factory.update_do_statement(n, this.visit_iteration_body_h(d.statement), this.visit_node_h(d.expression))
            when d: WhileStatement
                return factory.update_while_statement(n, this.visit_node_h(d.expression), this.visit_iteration_body_h(d.statement))
            when d: ForStatement
                return factory.update_for_statement(n, this.visit_node_h(d.initializer), this.visit_node_h(d.condition), this.visit_node_h(d.incrementor), this.visit_iteration_body_h(d.statement))
            when d: ForInStatement
                return factory.update_for_in_or_of_statement(n, this.visit_node_h(d.await_modifier), this.visit_node_h(d.initializer), this.visit_node_h(d.expression), this.visit_iteration_body_h(d.statement))
            when d: ForOfStatement
                return factory.update_for_in_or_of_statement(n, this.visit_node_h(d.await_modifier), this.visit_node_h(d.initializer), this.visit_node_h(d.expression), this.visit_iteration_body_h(d.statement))
            when d: BreakStatement
                return factory.update_break_statement(n, this.visit_node_h(d.label_name))
            when d: ContinueStatement
                return factory.update_continue_statement(n, this.visit_node_h(d.label_name))
            when d: ReturnStatement
                return factory.update_return_statement(n, this.visit_node_h(d.expression))
            when d: WithStatement
                return factory.update_with_statement(n, this.visit_node_h(d.expression), this.visit_embedded_statement_h(d.statement))
            when d: SwitchStatement
                return factory.update_switch_statement(n, this.visit_node_h(d.expression), this.visit_node_h(d.case_block))
            when d: CaseBlock
                return factory.update_case_block(n, this.visit_nodes_h(d.elements))
            when d: CaseClause
                return factory.update_case_or_default_clause(n, this.visit_node_h(d.expression), this.visit_nodes_h(d.statements))
            when d: DefaultClause
                return factory.update_case_or_default_clause(n, this.visit_node_h(d.expression), this.visit_nodes_h(d.statements))
            when d: ThrowStatement
                return factory.update_throw_statement(n, this.visit_node_h(d.expression))
            when d: TryStatement
                return factory.update_try_statement(n, this.visit_node_h(d.try_block), this.visit_node_h(d.catch_clause), this.visit_node_h(d.finally_block))
            when d: CatchClause
                return factory.update_catch_clause(n, this.visit_node_h(d.variable_declaration), this.visit_node_h(d.block))
            when d: LabeledStatement
                return factory.update_labeled_statement(n, this.visit_node_h(d.label_name), this.visit_embedded_statement_h(d.statement))
            when d: ExpressionStatement
                return factory.update_expression_statement(n, this.visit_node_h(d.expression))
            when d: Block
                return factory.update_block(n, this.visit_nodes_h(d.statements), d.multi_line)
            when d: VariableStatement
                return factory.update_variable_statement(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.declaration_list))
            when d: VariableDeclaration
                return factory.update_variable_declaration(n, this.visit_node_h(d.name), this.visit_node_h(d.exclamation_token), this.visit_node_h(d.type_node), this.visit_node_h(d.initializer))
            when d: VariableDeclarationList
                return factory.update_variable_declaration_list(n, this.visit_nodes_h(d.declarations), n.flags)
            when d: ObjectBindingPattern
                return factory.update_binding_pattern(n, this.visit_nodes_h(d.elements))
            when d: ArrayBindingPattern
                return factory.update_binding_pattern(n, this.visit_nodes_h(d.elements))
            when d: Parameter
                return factory.update_parameter_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.dot_dot_dot_token), this.visit_node_h(d.name), this.visit_node_h(d.question_token), this.visit_node_h(d.type_node), this.visit_node_h(d.initializer))
            when d: BindingElement
                return factory.update_binding_element(n, this.visit_node_h(d.dot_dot_dot_token), this.visit_node_h(d.property_name), this.visit_node_h(d.name), this.visit_node_h(d.initializer))
            when d: MissingDeclaration
                return factory.update_missing_declaration(n, this.visit_modifiers_h(d.elements))
            when d: FunctionDeclaration
                return factory.update_function_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.asterisk_token), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: ClassDeclaration
                return factory.update_class_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.heritage_clauses), this.visit_nodes_h(d.members))
            when d: ClassExpression
                return factory.update_class_expression(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.heritage_clauses), this.visit_nodes_h(d.members))
            when d: HeritageClause
                return factory.update_heritage_clause(n, d.token, this.visit_nodes_h(d.types))
            when d: InterfaceDeclaration
                return factory.update_interface_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.heritage_clauses), this.visit_nodes_h(d.members))
            when d: TypeAliasDeclaration
                return factory.update_type_alias_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_node_h(d.type_node))
            when d: EnumMember
                return factory.update_enum_member(n, this.visit_node_h(d.name), this.visit_node_h(d.initializer))
            when d: EnumDeclaration
                return factory.update_enum_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.members))
            when d: ModuleBlock
                return factory.update_module_block(n, this.visit_nodes_h(d.statements))
            when d: ImportDeclaration
                return factory.update_import_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.import_clause), this.visit_node_h(d.module_specifier), this.visit_node_h(d.attributes))
            when d: ExternalModuleReference
                return factory.update_external_module_reference(n, this.visit_node_h(d.inner))
            when d: NamespaceImport
                return factory.update_namespace_import(n, this.visit_node_h(d.inner))
            when d: NamedImports
                return factory.update_named_imports(n, this.visit_nodes_h(d.elements))
            when d: ExportAssignment
                return factory.update_export_assignment(n, this.visit_modifiers_h(d.modifiers), d.is_export_equals, this.visit_node_h(d.type_node), this.visit_node_h(d.expression))
            when d: NamespaceExportDeclaration
                return factory.update_namespace_export_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name))
            when d: NamespaceExport
                return factory.update_namespace_export(n, this.visit_node_h(d.inner))
            when d: NamedExports
                return factory.update_named_exports(n, this.visit_nodes_h(d.elements))
            when d: ExportSpecifier
                return factory.update_export_specifier(n, d.is_type_only, this.visit_node_h(d.property_name), this.visit_node_h(d.name))
            when d: CallSignature
                return factory.update_call_signature_declaration(n, this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: ConstructSignature
                return factory.update_construct_signature_declaration(n, this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: ConstructorDeclaration
                return factory.update_constructor_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: GetAccessorDeclaration
                return factory.update_get_accessor_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: SetAccessorDeclaration
                return factory.update_set_accessor_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: IndexSignatureDeclaration
                return factory.update_index_signature_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: MethodSignature
                return factory.update_method_signature_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: MethodDeclaration
                return factory.update_method_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.asterisk_token), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: PropertySignature
                return factory.update_property_signature_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_node_h(d.type_node), this.visit_node_h(d.initializer))
            when d: PropertyDeclaration
                return factory.update_property_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_node_h(d.type_node), this.visit_node_h(d.initializer))
            when d: ClassStaticBlockDeclaration
                return factory.update_class_static_block_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.body))
            when d: BinaryExpression
                return factory.update_binary_expression(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.left), this.visit_node_h(d.type_node), this.visit_node_h(d.operator_token), this.visit_node_h(d.right))
            when d: PrefixUnaryExpression
                return factory.update_prefix_unary_expression(n, d.operator_kind, this.visit_node_h(d.operand))
            when d: PostfixUnaryExpression
                return factory.update_postfix_unary_expression(n, this.visit_node_h(d.operand), d.operator_kind)
            when d: YieldExpression
                return factory.update_yield_expression(n, this.visit_node_h(d.asterisk_token), this.visit_node_h(d.expression))
            when d: ArrowFunction
                return factory.update_arrow_function(n, this.visit_modifiers_h(d.modifiers), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_node_h(d.equals_greater_than_token), this.visit_function_body_h(d.body))
            when d: FunctionExpression
                return factory.update_function_expression(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.asterisk_token), this.visit_node_h(d.name), this.visit_nodes_h(d.type_parameters), this.visit_parameters_h(d.parameters), this.visit_node_h(d.type_node), this.visit_node_h(d.full_signature), this.visit_function_body_h(d.body))
            when d: AsExpression
                return factory.update_as_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.type_node))
            when d: SatisfiesExpression
                return factory.update_satisfies_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.type_node))
            when d: ConditionalExpression
                return factory.update_conditional_expression(n, this.visit_node_h(d.condition), this.visit_node_h(d.question_token), this.visit_node_h(d.when_true), this.visit_node_h(d.colon_token), this.visit_node_h(d.when_false))
            when d: PropertyAccessExpression
                return factory.update_property_access_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.question_dot_token), this.visit_node_h(d.name), n.flags)
            when d: ElementAccessExpression
                return factory.update_element_access_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.question_dot_token), this.visit_node_h(d.argument_expression), n.flags)
            when d: CallExpression
                return factory.update_call_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.question_dot_token), this.visit_nodes_h(d.type_arguments), this.visit_nodes_h(d.arguments), n.flags)
            when d: NewExpression
                return factory.update_new_expression(n, this.visit_node_h(d.expression), this.visit_nodes_h(d.type_arguments), this.visit_nodes_h(d.arguments))
            when d: MetaProperty
                return factory.update_meta_property(n, d.keyword_token, this.visit_node_h(d.name))
            when d: NonNullExpression
                return factory.update_non_null_expression(n, this.visit_node_h(d.inner), n.flags)
            when d: SpreadElement
                return factory.update_spread_element(n, this.visit_node_h(d.inner))
            when d: TemplateExpression
                return factory.update_template_expression(n, this.visit_node_h(d.head), this.visit_nodes_h(d.template_spans))
            when d: TemplateSpan
                return factory.update_template_span(n, this.visit_node_h(d.expression), this.visit_node_h(d.literal))
            when d: TaggedTemplateExpression
                return factory.update_tagged_template_expression(n, this.visit_node_h(d.tag), this.visit_node_h(d.question_dot_token), this.visit_nodes_h(d.type_arguments), this.visit_node_h(d.template), n.flags)
            when d: ParenthesizedExpression
                return factory.update_parenthesized_expression(n, this.visit_node_h(d.inner))
            when d: ArrayLiteralExpression
                return factory.update_array_literal_expression(n, this.visit_nodes_h(d.elements), d.multi_line)
            when d: ObjectLiteralExpression
                return factory.update_object_literal_expression(n, this.visit_nodes_h(d.elements), d.multi_line)
            when d: SpreadAssignment
                return factory.update_spread_assignment(n, this.visit_node_h(d.inner))
            when d: PropertyAssignment
                return factory.update_property_assignment(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_node_h(d.type_node), this.visit_node_h(d.initializer))
            when d: ShorthandPropertyAssignment
                return factory.update_shorthand_property_assignment(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.postfix_token), this.visit_node_h(d.type_node), this.visit_node_h(d.equals_token), this.visit_node_h(d.object_assignment_initializer))
            when d: DeleteExpression
                return factory.update_delete_expression(n, this.visit_node_h(d.inner))
            when d: TypeOfExpression
                return factory.update_type_of_expression(n, this.visit_node_h(d.inner))
            when d: VoidExpression
                return factory.update_void_expression(n, this.visit_node_h(d.inner))
            when d: AwaitExpression
                return factory.update_await_expression(n, this.visit_node_h(d.inner))
            when d: TypeAssertionExpression
                return factory.update_type_assertion(n, this.visit_node_h(d.type_node), this.visit_node_h(d.expression))
            when d: UnionType
                return factory.update_union_type_node(n, this.visit_nodes_h(d.types))
            when d: IntersectionType
                return factory.update_intersection_type_node(n, this.visit_nodes_h(d.types))
            when d: ConditionalType
                return factory.update_conditional_type_node(n, this.visit_node_h(d.check_type), this.visit_node_h(d.extends_type), this.visit_node_h(d.true_type), this.visit_node_h(d.false_type))
            when d: TypeOperator
                return factory.update_type_operator_node(n, d.operator_kind, this.visit_node_h(d.inner))
            when d: InferType
                return factory.update_infer_type_node(n, this.visit_node_h(d.inner))
            when d: ArrayType
                return factory.update_array_type_node(n, this.visit_node_h(d.inner))
            when d: IndexedAccessType
                return factory.update_indexed_access_type_node(n, this.visit_node_h(d.object_type), this.visit_node_h(d.index_type))
            when d: TypeReference
                return factory.update_type_reference_node(n, this.visit_node_h(d.type_name), this.visit_nodes_h(d.type_arguments))
            when d: ExpressionWithTypeArguments
                return factory.update_expression_with_type_arguments(n, this.visit_node_h(d.expression), this.visit_nodes_h(d.type_arguments))
            when d: LiteralType
                return factory.update_literal_type_node(n, this.visit_node_h(d.inner))
            when d: TypePredicate
                return factory.update_type_predicate_node(n, this.visit_node_h(d.asserts_modifier), this.visit_node_h(d.parameter_name), this.visit_node_h(d.type_node))
            when d: ImportAttribute
                return factory.update_import_attribute(n, this.visit_node_h(d.name), this.visit_node_h(d.value))
            when d: ImportAttributes
                return factory.update_import_attributes(n, d.token, this.visit_nodes_h(d.attributes), d.multi_line)
            when d: TypeQuery
                return factory.update_type_query_node(n, this.visit_node_h(d.expr_name), this.visit_nodes_h(d.type_arguments))
            when d: MappedType
                return factory.update_mapped_type_node(n, this.visit_node_h(d.readonly_token), this.visit_node_h(d.type_parameter), this.visit_node_h(d.name_type), this.visit_node_h(d.question_token), this.visit_node_h(d.type_node), this.visit_nodes_h(d.members))
            when d: TypeLiteral
                return factory.update_type_literal_node(n, this.visit_nodes_h(d.members))
            when d: TupleType
                return factory.update_tuple_type_node(n, this.visit_nodes_h(d.types))
            when d: NamedTupleMember
                return factory.update_named_tuple_member(n, this.visit_node_h(d.dot_dot_dot_token), this.visit_node_h(d.name), this.visit_node_h(d.question_token), this.visit_node_h(d.type_node))
            when d: OptionalType
                return factory.update_optional_type_node(n, this.visit_node_h(d.inner))
            when d: RestType
                return factory.update_rest_type_node(n, this.visit_node_h(d.inner))
            when d: ParenthesizedType
                return factory.update_parenthesized_type_node(n, this.visit_node_h(d.inner))
            when d: FunctionType
                return factory.update_function_type_node(n, this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: ConstructorType
                return factory.update_constructor_type_node(n, this.visit_modifiers_h(d.modifiers), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: TemplateLiteralType
                return factory.update_template_literal_type_node(n, this.visit_node_h(d.head), this.visit_nodes_h(d.template_spans))
            when d: TemplateLiteralTypeSpan
                return factory.update_template_literal_type_span(n, this.visit_node_h(d.expression), this.visit_node_h(d.literal))
            when d: PartiallyEmittedExpression
                return factory.update_partially_emitted_expression(n, this.visit_node_h(d.inner))
            when d: JsxElement
                return factory.update_jsx_element(n, this.visit_node_h(d.opening_element), this.visit_nodes_h(d.children), this.visit_node_h(d.closing_element))
            when d: JsxAttributes
                return factory.update_jsx_attributes(n, this.visit_nodes_h(d.elements))
            when d: JsxNamespacedName
                return factory.update_jsx_namespaced_name(n, this.visit_node_h(d.namespace_name), this.visit_node_h(d.name))
            when d: JsxOpeningElement
                return factory.update_jsx_opening_element(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.type_arguments), this.visit_node_h(d.attributes))
            when d: JsxSelfClosingElement
                return factory.update_jsx_self_closing_element(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.type_arguments), this.visit_node_h(d.attributes))
            when d: JsxFragment
                return factory.update_jsx_fragment(n, this.visit_node_h(d.opening_fragment), this.visit_nodes_h(d.children), this.visit_node_h(d.closing_fragment))
            when d: JsxAttribute
                return factory.update_jsx_attribute(n, this.visit_node_h(d.name), this.visit_node_h(d.initializer))
            when d: JsxSpreadAttribute
                return factory.update_jsx_spread_attribute(n, this.visit_node_h(d.inner))
            when d: JsxClosingElement
                return factory.update_jsx_closing_element(n, this.visit_node_h(d.inner))
            when d: JsxExpression
                return factory.update_jsx_expression(n, this.visit_node_h(d.dot_dot_dot_token), this.visit_node_h(d.expression))
            when d: JSDoc
                return factory.update_js_doc(n, this.visit_nodes_h(d.comment), this.visit_nodes_h(d.tags))
            when d: JSDocTypeExpression
                return factory.update_js_doc_type_expression(n, this.visit_node_h(d.inner))
            when d: JSDocNonNullableType
                return factory.update_js_doc_non_nullable_type(n, this.visit_node_h(d.inner))
            when d: JSDocNullableType
                return factory.update_js_doc_nullable_type(n, this.visit_node_h(d.inner))
            when d: JSDocVariadicType
                return factory.update_js_doc_variadic_type(n, this.visit_node_h(d.inner))
            when d: JSDocOptionalType
                return factory.update_js_doc_optional_type(n, this.visit_node_h(d.inner))
            when d: JSDocTypeTag
                return factory.update_js_doc_type_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocUnknownTag
                return factory.update_js_doc_unknown_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocTemplateTag
                return factory.update_js_doc_template_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.constraint), this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.comment))
            when d: JSDocReturnTag
                return factory.update_js_doc_return_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocPublicTag
                return factory.update_js_doc_public_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocPrivateTag
                return factory.update_js_doc_private_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocProtectedTag
                return factory.update_js_doc_protected_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocReadonlyTag
                return factory.update_js_doc_readonly_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocOverrideTag
                return factory.update_js_doc_override_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocDeprecatedTag
                return factory.update_js_doc_deprecated_tag(n, this.visit_node_h(d.tag_name), this.visit_nodes_h(d.comment))
            when d: JSDocSeeTag
                return factory.update_js_doc_see_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocImplementsTag
                return factory.update_js_doc_implements_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocAugmentsTag
                return factory.update_js_doc_augments_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocSatisfiesTag
                return factory.update_js_doc_satisfies_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocThrowsTag
                return factory.update_js_doc_throws_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocThisTag
                return factory.update_js_doc_this_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocImportTag
                return factory.update_js_doc_import_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.import_clause), this.visit_node_h(d.module_specifier), this.visit_node_h(d.attributes), this.visit_nodes_h(d.comment))
            when d: JSDocCallbackTag
                return factory.update_js_doc_callback_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.type_expression), this.visit_node_h(d.name), this.visit_nodes_h(d.comment))
            when d: JSDocOverloadTag
                return factory.update_js_doc_overload_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.node), this.visit_nodes_h(d.comment))
            when d: JSDocTypedefTag
                return factory.update_js_doc_typedef_tag(n, this.visit_node_h(d.tag_name), this.visit_node_h(d.type_expression), this.visit_node_h(d.name), this.visit_nodes_h(d.comment))
            when d: JSDocSignature
                return factory.update_js_doc_signature(n, this.visit_nodes_h(d.type_parameters), this.visit_nodes_h(d.parameters), this.visit_node_h(d.type_node))
            when d: JSDocNameReference
                return factory.update_js_doc_name_reference(n, this.visit_node_h(d.inner))
            when d: ModuleDeclaration
                return factory.update_module_declaration(n, this.visit_modifiers_h(d.modifiers), d.keyword, this.visit_node_h(d.name), this.visit_node_h(d.body))
            when d: ImportEqualsDeclaration
                return factory.update_import_equals_declaration(n, this.visit_modifiers_h(d.modifiers), d.is_type_only, this.visit_node_h(d.name), this.visit_node_h(d.module_reference))
            when d: ExportDeclaration
                return factory.update_export_declaration(n, this.visit_modifiers_h(d.modifiers), d.is_type_only, this.visit_node_h(d.export_clause), this.visit_node_h(d.module_specifier), this.visit_node_h(d.attributes))
            when d: ImportType
                return factory.update_import_type_node(n, d.is_type_of, this.visit_node_h(d.argument), this.visit_node_h(d.attributes), this.visit_node_h(d.qualifier), this.visit_nodes_h(d.type_arguments))
            when d: ImportClause
                return factory.update_import_clause(n, d.phase_modifier, this.visit_node_h(d.name), this.visit_node_h(d.named_bindings))
            when d: ImportSpecifier
                return factory.update_import_specifier(n, d.is_type_only, this.visit_node_h(d.property_name), this.visit_node_h(d.name))
            when d: JSDocLink
                return factory.update_js_doc_link(n, this.visit_node_h(d.inner), d.inner)
            when d: JSDocLinkPlain
                return factory.update_js_doc_link_plain(n, this.visit_node_h(d.inner), d.inner)
            when d: JSDocLinkCode
                return factory.update_js_doc_link_code(n, this.visit_node_h(d.inner), d.inner)
            when d: TypeParameter
                return factory.update_type_parameter_declaration(n, this.visit_modifiers_h(d.modifiers), this.visit_node_h(d.name), this.visit_node_h(d.constraint), this.visit_node_h(d.expression), this.visit_node_h(d.default_type))
            when d: SyntheticReferenceExpression
                return factory.update_synthetic_reference_expression(n, this.visit_node_h(d.expression), this.visit_node_h(d.this_arg))
        node
    }

    ; ── visitor.go, hand-written ─────────────────────────────────────────────

    ; The `Visit` callback (§3.18: the tag is the func value).
    procedure visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        if visit_tag = VisitTagDeepClone
            return this.deep_clone_visit(node)
        node
    }

    ; VisitNode: the callback, and a one-element SyntaxList unwrapped.
    procedure visit_node(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if visit_tag = VisitTagNone
            return node
        var visited this.visit(node as ref[AstNode])
        if visited <> null
        {
            let v visited as ref[AstNode]
            if v.kind = KindSyntaxList
            {
                let children this.syntax_list_children(v)
                if (children.get_length() as int) <> 1
                    return null
                set visited: children[0 as size_t]
            }
        }
        visited
    }

    function syntax_list_children(this, n: ref[AstNode]) returns ref[Array[ref[AstNode]?]]
    {
        choose n.data
            when sl: SyntaxList
                return sl.elements
        &Array[ref[AstNode]?]^host()
    }

    ; VisitEmbeddedStatement: the callback, lifted to a block when it answers several.
    procedure visit_embedded_statement(this, node: ref[AstNode]?) returns ref[AstNode]?
    {
        if node = null
            return null
        if visit_tag = VisitTagNone
            return node
        let visited this.visit(node as ref[AstNode])
        if visited = null
            return null
        this.lift_to_block(visited)
    }

    ; VisitNodes: a rebuilt list keeps the original's extent.
    procedure visit_nodes(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if nodes = null
            return nodes
        if visit_tag = VisitTagNone
            return nodes
        var changed false
        let result this.visit_slice(nodes as ref[Array[ref[AstNode]?]], &changed)
        if changed
            return factory.new_node_list_like(result, nodes)
        nodes
    }

    procedure visit_modifiers(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
        this.visit_nodes(nodes)

    ; VisitSlice: the first element the callback changes or drops starts a copy;
    ; a SyntaxList answer splices its children in.
    procedure visit_slice(this, nodes: ref[Array[ref[AstNode]?]], changed: ref[bool]) returns ref[Array[ref[AstNode]?]]
    {
        set changed: false
        let n nodes.get_length() as int
        var i 0
        while i < n
        {
            let node nodes[i as size_t]
            var visited: ref[AstNode]? null
            if node <> null
                set visited: this.visit(node as ref[AstNode])
            var same false
            if visited <> null
            {
                if visited = node
                    set same: true
            }
            if same = false
            {
                let updated &Array[ref[AstNode]?]^host()
                var k 0
                while k < i
                {
                    updated.add(nodes[k as size_t])
                    set k: k + 1
                }
                while true
                {
                    if visited <> null
                    {
                        let v visited as ref[AstNode]
                        if v.kind = KindSyntaxList
                        {
                            let children this.syntax_list_children(v)
                            var c 0
                            while c < (children.get_length() as int)
                            {
                                updated.add(children[c as size_t])
                                set c: c + 1
                            }
                        }
                        else
                            updated.add(visited)
                    }
                    set i: i + 1
                    if i >= n
                        break
                    let next nodes[i as size_t]
                    set visited: null
                    if next <> null
                        set visited: this.visit(next as ref[AstNode])
                }
                set changed: true
                return updated
            }
            set i: i + 1
        }
        nodes
    }

    ; liftToBlock: several statements become one multi-line block.
    procedure lift_to_block(this, node: ref[AstNode]) returns ref[AstNode]
    {
        if node.kind <> KindSyntaxList
            return node
        let children this.syntax_list_children(node)
        if (children.get_length() as int) = 1
        {
            let only children[0 as size_t]
            if only <> null
                return only as ref[AstNode]
        }
        factory.new_block(children, true)
    }

    ; ── the hook-aware forms VisitEachChild calls (visitor.go's lowercase ones) ──

    procedure visit_node_h(this, node: ref[AstNode]?) returns ref[AstNode]?
        this.visit_node(node)

    procedure visit_embedded_statement_h(this, node: ref[AstNode]?) returns ref[AstNode]?
        this.visit_embedded_statement(node)

    procedure visit_iteration_body_h(this, node: ref[AstNode]?) returns ref[AstNode]?
        this.visit_embedded_statement_h(node)

    procedure visit_function_body_h(this, node: ref[AstNode]?) returns ref[AstNode]?
        this.visit_node_h(node)

    procedure visit_token_h(this, node: ref[AstNode]?) returns ref[AstNode]?
        this.visit_node(node)

    procedure visit_nodes_h(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if hooks_tag = HooksTagDeepClone
            return this.deep_clone_visit_nodes(nodes)
        this.visit_nodes(nodes)
    }

    procedure visit_modifiers_h(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if hooks_tag = HooksTagDeepClone
            return this.deep_clone_visit_nodes(nodes)
        this.visit_modifiers(nodes)
    }

    procedure visit_parameters_h(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
        this.visit_nodes_h(nodes)

    procedure visit_top_level_statements_h(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
        this.visit_nodes_h(nodes)

    ; ── deepclone.go ─────────────────────────────────────────────────────────

    ; The deep-clone callback: a node whose children changed is the rebuilt
    ; one; a leaf is cloned outright, and the clones cascade up through the
    ; updaters. A synthetic location is (-1, -1).
    procedure deep_clone_visit(this, node: ref[AstNode]) returns ref[AstNode]?
    {
        let visited this.visit_each_child(node)
        if visited <> null
        {
            if visited <> node
            {
                if synthetic_location
                {
                    set (visited as ref[AstNode]).pos: 0 - 1
                    set (visited as ref[AstNode]).end: 0 - 1
                }
                return visited
            }
        }
        let c factory.clone(node)
        if synthetic_location
        {
            set c.pos: 0 - 1
            set c.end: 0 - 1
        }
        c
    }

    ; The deep clone's VisitNodes hook: an unchanged list is CLONED (a fresh
    ; Array over the same elements, same extent); with synthetic locations the
    ; list has no extent and a trailing comma is kept as the last element's
    ; (-2, -2) location, exactly the reference's marker.
    procedure deep_clone_visit_nodes(this, nodes: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
    {
        if nodes = null
            return null
        let list nodes as ref[Array[ref[AstNode]?]]
        let visited this.visit_nodes(nodes)
        var new_list: ref[Array[ref[AstNode]?]]? visited
        if visited = nodes
        {
            let copy &Array[ref[AstNode]?]^host()
            var i 0
            while i < (list.get_length() as int)
            {
                copy.add(list[i as size_t])
                set i: i + 1
            }
            set new_list: factory.new_node_list_like(copy, nodes)
        }
        if synthetic_location
        {
            let nl new_list as ref[Array[ref[AstNode]?]]
            if factory.list_has_trailing_comma(nodes)
            {
                let n nl.get_length() as int
                if n > 0
                {
                    let last nl[(n - 1) as size_t]
                    if last <> null
                    {
                        set (last as ref[AstNode]).pos: 0 - 2
                        set (last as ref[AstNode]).end: 0 - 2
                    }
                }
            }
        }
        new_list
    }
}

; getDeepCloneVisitor / DeepCloneNode / DeepCloneReparse
define DeepClone
(
    host: ref[Page]
)
{
    function visitor(host: ref[Page], f: ref[NodeFactory], synthetic_location: bool) returns ref[NodeVisitor]
    {
        let v NodeVisitor.create(host, f, VisitTagDeepClone, HooksTagDeepClone)
        set v.synthetic_location: synthetic_location
        v
    }

    procedure deep_clone_node(host: ref[Page], f: ref[NodeFactory], node: ref[AstNode]?) returns ref[AstNode]?
        DeepClone.visitor(host, f, true).visit_node(node)

    procedure deep_clone_reparse(host: ref[Page], f: ref[NodeFactory], node_in: ref[AstNode]?) returns ref[AstNode]?
    {
        if node_in = null
            return null
        let node DeepClone.visitor(host, f, false).visit_node(node_in)
        if node = null
            return null
        let n node as ref[AstNode]
        NodeFactory.set_parent_in_children(n)
        set n.flags: n.flags | NodeFlagsReparsed
        n
    }

    procedure deep_clone_reparse_modifiers(host: ref[Page], f: ref[NodeFactory], modifiers: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]?
        DeepClone.visitor(host, f, false).visit_modifiers(modifiers)
}

