    ; NewBindingPattern
    procedure new_binding_pattern(this, kind: int, elements: ref[Array[ref[AstNode]?]]?) returns ref[AstNode]
    {
        var n: ref[AstNode]? null
        if kind = KindObjectBindingPattern
            set n: this.new_node(kind, NodeData.ObjectBindingPattern(ElementListData((elements as ref[Array[ref[AstNode]?]]), false)))
        if n = null
            set n: this.new_node(kind, NodeData.ArrayBindingPattern(ElementListData((elements as ref[Array[ref[AstNode]?]]), false)))
        let node n as ref[AstNode]
        node
    }

