; SPDX-License-Identifier: Apache-2.0
;
; factory — internal/ast's NODE FACTORY and NODE VISITOR, GENERATED by
; packages/tscaly/tools/genfactory.py from the reference's ast_generated.go against
; this port's node records (slice 231). ★DO NOT EDIT the generated block; edit the
; generator (the hand-written visitor block at the end is part of the generator's
; FACTORY_TAIL). Field mapping: snake case, `Type` → `type_node`, and the override
; table in the generator where the port named a slot differently or shares a
; record between kinds. A constructor parameter the port's record has no slot for
; is accepted and DROPPED (template raw text and flags, JSDoc link text, the
; checker-internal synthetic expression) — each is named in the generator.
;
; ★ The factory belongs to an emit: `context` is the printer's EmitContext whose
; three hooks (OnCreate marks a node synthesized, OnUpdate/OnClone record the
; original) run when it is set; a factory without one (the deep-clone visitor's
; default) runs none, as the reference's zero NodeFactory does. `list_ranges` is
; the source file's list-range table, so a list a visitor rebuilds keeps the
; extent the original had (the reference copies `list.Loc`).

use scaly.memory.Page
use scaly.containers.Array
use tscaly.ast.*
use tscaly.printer.EmitContext

define NodeFactory
(
    host: ref[Page]
    context: ref[EmitContext]?
    list_ranges: ref[Array[ListRange]]?
    node_count: int
    text_count: int
)
{
    function create(host: ref[Page], context: ref[EmitContext]?, list_ranges: ref[Array[ListRange]]?) returns ref[NodeFactory]
        &NodeFactory^host(host, context, list_ranges, 0, 0)

    ; newNode: raw region memory, every slot set (AstNode.alloc zero-fills nothing),
    ; the location undefined (-1, -1), then the context's OnCreate.
    procedure new_node(this, kind: int, data: NodeData) returns ref[AstNode]
    {
        let n AstNode.alloc(host)
        set n.kind: kind
        set n.flags: NodeFlagsNone
        set n.pos: 0 - 1
        set n.end: 0 - 1
        set n.data: data
        set n.parent: null
        set n.symbol: null
        set n.local_symbol: null
        set n.locals: null
        set n.flow_node: null
        set n.end_flow_node: null
        set n.return_flow_node: null
        set n.fallthrough_flow_node: null
        set n.original: null
        set n.emit_index: 0
        set n.emit_context_id: 0
        set this.node_count: node_count + 1
        if context <> null
            (context as ref[EmitContext]).on_create(n)
        n
    }

    ; updateNode: a changed node takes the original's flags and location, and the
    ; context records the original.
    procedure update_node(this, updated: ref[AstNode], original: ref[AstNode]) returns ref[AstNode]
    {
        if updated <> original
        {
            set updated.flags: original.flags
            set updated.pos: original.pos
            set updated.end: original.end
            if context <> null
                (context as ref[EmitContext]).on_update(updated, original)
        }
        updated
    }

    procedure clone_node(this, updated: ref[AstNode], original: ref[AstNode]) returns ref[AstNode]
    {
        this.update_node(updated, original)
        if updated <> original
        {
            if context <> null
                (context as ref[EmitContext]).on_clone(updated, original)
        }
        updated
    }

    ; NewNodeList over a list the visitor rebuilt: a fresh Array with the same
    ; elements' extent as `like` (`list.Loc = nodes.Loc`), recorded in the file's table.
    procedure new_node_list_like(this, nodes: ref[Array[ref[AstNode]?]], like: ref[Array[ref[AstNode]?]]?) returns ref[Array[ref[AstNode]?]]
    {
        if list_ranges <> null
        {
            if like <> null
            {
                var p 0
                var e 0
                if AstNode.find_list_range(list_ranges, like, &p, &e)
                    (list_ranges as ref[Array[ListRange]]).add(ListRange(nodes, p, e))
            }
        }
        nodes
    }

    function empty_text() returns Slice[char]
        ""

    ; NodeList.HasTrailingComma: the last element ends before the list does. A
    ; list with no recorded extent has the reference's undefined (-1, -1), so a
    ; last element at (-2, -2) — the deep clone's marker — answers true.
    function list_has_trailing_comma(this, nodes: ref[Array[ref[AstNode]?]]?) returns bool
    {
        if nodes = null
            return false
        let list nodes as ref[Array[ref[AstNode]?]]
        let n list.get_length() as int
        if n = 0
            return false
        let last list[(n - 1) as size_t]
        if last = null
            return false
        var p 0 - 1
        var e 0 - 1
        if list_ranges <> null
            AstNode.find_list_range(list_ranges, nodes, &p, &e)
        (last as ref[AstNode]).end < e
    }

    ; SetParentInChildren, over the port's child enumerator.
    function set_parent_in_children(node: ref[AstNode])
    {
        var i 0
        while true
        {
            let c AstNode.child_at(node, i)
            if c = null
                break
            let child c as ref[AstNode]
            set child.parent: node
            NodeFactory.set_parent_in_children(child)
            set i: i + 1
        }
    }

    ; NewToken
    procedure new_token(this, kind: int) returns ref[AstNode]
    {
        let n this.new_node(kind, NodeData.Token(TokenData()))
        n
    }

    ; NewIdentifier
    procedure new_identifier(this, text: Slice[char]) returns ref[AstNode]
    {
        let n this.new_node(KindIdentifier, NodeData.Identifier(IdentifierData(text)))
        n
    }

    ; NewPrivateIdentifier
    procedure new_private_identifier(this, text: Slice[char]) returns ref[AstNode]
    {
        let n this.new_node(KindPrivateIdentifier, NodeData.PrivateIdentifier(IdentifierData(text)))
        n
    }

    ; NewQualifiedName
    procedure new_qualified_name(this, left: ref[AstNode]?, right: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindQualifiedName, NodeData.QualifiedName(QualifiedNameData((left as ref[AstNode]), right)))
        n
    }

    ; UpdateQualifiedName
    procedure update_qualified_name(this, node: ref[AstNode], left: ref[AstNode]?, right: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: QualifiedName
            {
                var changed false
                let cmp_left: ref[AstNode]? d.left
                if left <> cmp_left
                    set changed: true
                let cmp_right: ref[AstNode]? d.right
                if right <> cmp_right
                    set changed: true
                if changed
                    return this.update_node(this.new_qualified_name(left, right), node)
                return node
            }
        node
    }

    ; NewComputedPropertyName
    procedure new_computed_property_name(this, expression: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindComputedPropertyName, NodeData.ComputedPropertyName(WrappedTypeData(expression)))
        n
    }

    ; UpdateComputedPropertyName
    procedure update_computed_property_name(this, node: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: ComputedPropertyName
            {
                var changed false
                let cmp_inner: ref[AstNode]? d.inner
                if expression <> cmp_inner
                    set changed: true
                if changed
                    return this.update_node(this.new_computed_property_name(expression), node)
                return node
            }
        node
    }

    ; NewDecorator
    procedure new_decorator(this, expression: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindDecorator, NodeData.Decorator(WrappedTypeData(expression)))
        n
    }

    ; UpdateDecorator
    procedure update_decorator(this, node: ref[AstNode], expression: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: Decorator
            {
                var changed false
                let cmp_inner: ref[AstNode]? d.inner
                if expression <> cmp_inner
                    set changed: true
                if changed
                    return this.update_node(this.new_decorator(expression), node)
                return node
            }
        node
    }

    ; NewEmptyStatement
    procedure new_empty_statement(this) returns ref[AstNode]
    {
        let n this.new_node(KindEmptyStatement, NodeData.EmptyStatement(EmptyStatementData()))
        n
    }

    ; NewIfStatement
    procedure new_if_statement(this, expression: ref[AstNode]?, then_statement: ref[AstNode]?, else_statement: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindIfStatement, NodeData.IfStatement(IfStatementData(expression, (then_statement as ref[AstNode]), else_statement)))
        n
    }

    ; UpdateIfStatement
    procedure update_if_statement(this, node: ref[AstNode], expression: ref[AstNode]?, then_statement: ref[AstNode]?, else_statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: IfStatement
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_then_statement: ref[AstNode]? d.then_statement
                if then_statement <> cmp_then_statement
                    set changed: true
                let cmp_else_statement: ref[AstNode]? d.else_statement
                if else_statement <> cmp_else_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_if_statement(expression, then_statement, else_statement), node)
                return node
            }
        node
    }

    ; NewDoStatement
    procedure new_do_statement(this, statement: ref[AstNode]?, expression: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindDoStatement, NodeData.DoStatement(DoStatementData((statement as ref[AstNode]), (expression as ref[AstNode]))))
        n
    }

    ; UpdateDoStatement
    procedure update_do_statement(this, node: ref[AstNode], statement: ref[AstNode]?, expression: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: DoStatement
            {
                var changed false
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                if changed
                    return this.update_node(this.new_do_statement(statement, expression), node)
                return node
            }
        node
    }

    ; NewWhileStatement
    procedure new_while_statement(this, expression: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindWhileStatement, NodeData.WhileStatement(ControlledStatementData((expression as ref[AstNode]), (statement as ref[AstNode]))))
        n
    }

    ; UpdateWhileStatement
    procedure update_while_statement(this, node: ref[AstNode], expression: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: WhileStatement
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_while_statement(expression, statement), node)
                return node
            }
        node
    }

    ; NewForStatement
    procedure new_for_statement(this, initializer: ref[AstNode]?, condition: ref[AstNode]?, incrementor: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindForStatement, NodeData.ForStatement(ForStatementData(initializer, condition, incrementor, (statement as ref[AstNode]))))
        n
    }

    ; UpdateForStatement
    procedure update_for_statement(this, node: ref[AstNode], initializer: ref[AstNode]?, condition: ref[AstNode]?, incrementor: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: ForStatement
            {
                var changed false
                let cmp_initializer: ref[AstNode]? d.initializer
                if initializer <> cmp_initializer
                    set changed: true
                let cmp_condition: ref[AstNode]? d.condition
                if condition <> cmp_condition
                    set changed: true
                let cmp_incrementor: ref[AstNode]? d.incrementor
                if incrementor <> cmp_incrementor
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_for_statement(initializer, condition, incrementor, statement), node)
                return node
            }
        node
    }

    ; NewForInOrOfStatement
    procedure new_for_in_or_of_statement(this, kind: int, await_modifier: ref[AstNode]?, initializer: ref[AstNode]?, expression: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        var n: ref[AstNode]? null
        if kind = KindForInStatement
            set n: this.new_node(kind, NodeData.ForInStatement(ForInOrOfStatementData(await_modifier, (initializer as ref[AstNode]), (expression as ref[AstNode]), (statement as ref[AstNode]))))
        if n = null
            set n: this.new_node(kind, NodeData.ForOfStatement(ForInOrOfStatementData(await_modifier, (initializer as ref[AstNode]), (expression as ref[AstNode]), (statement as ref[AstNode]))))
        let node n as ref[AstNode]
        node
    }

    ; UpdateForInOrOfStatement
    procedure update_for_in_or_of_statement(this, node: ref[AstNode], await_modifier: ref[AstNode]?, initializer: ref[AstNode]?, expression: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: ForInStatement
            {
                var changed false
                let cmp_await_modifier: ref[AstNode]? d.await_modifier
                if await_modifier <> cmp_await_modifier
                    set changed: true
                let cmp_initializer: ref[AstNode]? d.initializer
                if initializer <> cmp_initializer
                    set changed: true
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_for_in_or_of_statement(node.kind, await_modifier, initializer, expression, statement), node)
                return node
            }
            when d: ForOfStatement
            {
                var changed false
                let cmp_await_modifier: ref[AstNode]? d.await_modifier
                if await_modifier <> cmp_await_modifier
                    set changed: true
                let cmp_initializer: ref[AstNode]? d.initializer
                if initializer <> cmp_initializer
                    set changed: true
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_for_in_or_of_statement(node.kind, await_modifier, initializer, expression, statement), node)
                return node
            }
        node
    }

    ; NewBreakStatement
    procedure new_break_statement(this, label_name: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindBreakStatement, NodeData.BreakStatement(BreakOrContinueStatementData(label_name)))
        n
    }

    ; UpdateBreakStatement
    procedure update_break_statement(this, node: ref[AstNode], label_name: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: BreakStatement
            {
                var changed false
                let cmp_label_name: ref[AstNode]? d.label_name
                if label_name <> cmp_label_name
                    set changed: true
                if changed
