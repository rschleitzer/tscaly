    ; UpdateWithStatement
    procedure update_with_statement(this, node: ref[AstNode], expression: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: WithStatement
            {
                var changed false
                let cmp_expression: ref[AstNode]? d.expression
                if expression <> cmp_expression
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
                if statement <> cmp_statement
                    set changed: true
                if changed
                    return this.update_node(this.new_with_statement(expression, statement), node)
                return node
