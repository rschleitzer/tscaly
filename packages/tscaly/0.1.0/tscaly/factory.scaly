    ; UpdateCatchClause
    procedure update_catch_clause(this, node: ref[AstNode], variable_declaration: ref[AstNode]?, block: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: CatchClause
            {
                var changed false
                let cmp_variable_declaration: ref[AstNode]? d.variable_declaration
                if variable_declaration <> cmp_variable_declaration
                    set changed: true
                let cmp_block: ref[AstNode]? d.block
                if block <> cmp_block
                    set changed: true
                if changed
                    return this.update_node(this.new_catch_clause(variable_declaration, block), node)
                return node
            }
        node
    }

    ; NewDebuggerStatement
    procedure new_debugger_statement(this) returns ref[AstNode]
    {
        let n this.new_node(KindDebuggerStatement, NodeData.Token(TokenData()))
        n
    }

    ; NewLabeledStatement
    procedure new_labeled_statement(this, label_name: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        let n this.new_node(KindLabeledStatement, NodeData.LabeledStatement(LabeledStatementData((label_name as ref[AstNode]), (statement as ref[AstNode]))))
        n
    }

    ; UpdateLabeledStatement
    procedure update_labeled_statement(this, node: ref[AstNode], label_name: ref[AstNode]?, statement: ref[AstNode]?) returns ref[AstNode]
    {
        choose node.data
            when d: LabeledStatement
            {
                var changed false
                let cmp_label_name: ref[AstNode]? d.label_name
                if label_name <> cmp_label_name
                    set changed: true
                let cmp_statement: ref[AstNode]? d.statement
