                if tag <> cmp_tag
                    set changed: true
                let cmp_question_dot_token: ref[AstNode]? d.question_dot_token
                if question_dot_token <> cmp_question_dot_token
                    set changed: true
                let cmp_type_arguments: ref[Array[ref[AstNode]?]]? d.type_arguments
                if type_arguments <> cmp_type_arguments
                    set changed: true
                let cmp_template: ref[AstNode]? d.template
                if template <> cmp_template
                    set changed: true
                if flags <> node.flags
                    set changed: true
                if changed
                    return this.update_node(this.new_tagged_template_expression(tag, question_dot_token, type_arguments, template, flags), node)
                return node
            }
        node
    }

