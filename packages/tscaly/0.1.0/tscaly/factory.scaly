    ; UpdateTaggedTemplateExpression
    procedure update_tagged_template_expression(this, node: ref[AstNode], tag: ref[AstNode]?, question_dot_token: ref[AstNode]?, type_arguments: ref[Array[ref[AstNode]?]]?, template: ref[AstNode]?, flags: int) returns ref[AstNode]
