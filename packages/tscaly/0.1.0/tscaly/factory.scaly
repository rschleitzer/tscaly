    ; NewTaggedTemplateExpression
    procedure new_tagged_template_expression(this, tag: ref[AstNode]?, question_dot_token: ref[AstNode]?, type_arguments: ref[Array[ref[AstNode]?]]?, template: ref[AstNode]?, flags: int) returns ref[AstNode]
    {
        let n this.new_node(KindTaggedTemplateExpression, NodeData.TaggedTemplateExpression(TaggedTemplateData((tag as ref[AstNode]), question_dot_token, type_arguments, template)))
        set n.flags: n.flags | (flags & NodeFlagsOptionalChain)
        n
