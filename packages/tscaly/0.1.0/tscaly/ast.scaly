    ; A JSDoc tag's TypeExpression slot. The three tag SHAPES that carry one, and
    ; the shape decides which slot it is — the one-slot tags call it
    ; TypeExpression outright, the named tags (@typedef, @callback) put it in the
    ; middle slot, and the parameter/property tag has its own field.
    function jsdoc_type_expression_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when t: JSDocTypeTag
                return t.node
            when t: JSDocReturnTag
                return t.node
            when t: JSDocThisTag
                return t.node
            when t: JSDocSatisfiesTag
                return t.node
            when t: JSDocThrowsTag
                return t.node
            when t: JSDocOverloadTag
                return t.node
            when t: JSDocSeeTag
                return t.node
            when nt: JSDocTypedefTag
                return nt.type_expression
            when nt: JSDocCallbackTag
                return nt.type_expression
            when pt: JSDocParameterOrPropertyTag
                return pt.type_expression
        null
    }

    ; A JSDocImplementsTag's / JSDocAugmentsTag's ClassName — the same one slot
    ; the shared record carries.
    function jsdoc_class_name_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when t: JSDocImplementsTag
                return t.node
            when t: JSDocAugmentsTag
                return t.node
        null
    }

    ; A JSDoc tag's comment list — the reference's Node.CommentList().
    function jsdoc_tag_comment_of(n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        if n = null
            return null
        choose n.data
            when t: JSDocUnknownTag
                return t.comment
            when t: JSDocPublicTag
                return t.comment
            when t: JSDocPrivateTag
                return t.comment
            when t: JSDocProtectedTag
                return t.comment
            when t: JSDocReadonlyTag
                return t.comment
            when t: JSDocOverrideTag
                return t.comment
            when t: JSDocDeprecatedTag
                return t.comment
            when t: JSDocTypeTag
                return t.comment
            when t: JSDocReturnTag
                return t.comment
            when t: JSDocSeeTag
                return t.comment
            when t: JSDocImplementsTag
                return t.comment
            when t: JSDocAugmentsTag
                return t.comment
            when t: JSDocSatisfiesTag
                return t.comment
            when t: JSDocThrowsTag
                return t.comment
            when t: JSDocThisTag
                return t.comment
            when t: JSDocOverloadTag
                return t.comment
            when t: JSDocTemplateTag
                return t.comment
            when t: JSDocImportTag
                return t.comment
            when t: JSDocTypedefTag
                return t.comment
            when t: JSDocCallbackTag
                return t.comment
            when t: JSDocParameterOrPropertyTag
                return t.comment
        null
    }

    ; A JSDoc comment's Tags list.
    function jsdoc_tags_of(n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        if n = null
            return null
        choose n.data
            when d: JSDoc
                return d.tags
        null
    }

    ; JSDocParameterOrPropertyTag's two flag fields.
    function jsdoc_param_is_bracketed(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        choose n.data
            when pt: JSDocParameterOrPropertyTag
                return pt.is_bracketed
        false
    }

    function jsdoc_param_is_name_first(n: pointer[AstNode]) returns bool
    {
        if n = null
            return false
        choose n.data
