    ; The parser's hand-over of CheckJsDirective. It is a SETTER rather than an
    ; init argument because process_pragmas runs AFTER the SourceFile node is
    ; built and finished — finishSourceFile's own order — and the reparse path
    ; builds a second node that gets its own pragma pass.
    procedure set_check_js_directive(n: ref[AstNode], v: int)
    {
        choose n.data
            when sf: SourceFile
            {
                var d sf
                set d.check_js_directive: v
                set n.data: NodeData.SourceFile(d)
            }
    }

    function check_js_directive_of(n: ref[AstNode]?) returns int
    {
        if n = null
            return CheckJsDirectiveNone
        let node n as ref[AstNode]
        choose node.data
            when sf: SourceFile
                return sf.check_js_directive
        CheckJsDirectiveNone
    }

    ; ── children ────────────────────────────────────────────────────────────
    ;
    ; The reference's ForEachChild(v Visitor), as an index pair. The mapping is a
    ; deliberate one and belongs in the vocabulary: ForEachChild takes a
    ; CALLBACK, and Scaly's only escaping-closure form is `return \x: …` — a
    ; recursive walk that builds a fresh closure per level is exactly the shape
    ; the escape checker exists to reject. An index pair needs no callback, and
    ; it lets the walk live in the caller, where the recursion is plain.
    ;
    ; ★ THE ORDER IS PART OF WHAT THE YARDSTICK COMPARES. Each arm below lists
    ; its slots in the reference's own ForEachChild order; a port that visits a
    ; node's children in a different order is a different tree and the dump says
    ; so. The slot lists are transcribed from ast_generated.go, not inferred.
    ;
    ; Null slots are SKIPPED, exactly as `visit(v, node.X)` skips a nil — so the
    ; i-th child is the i-th PRESENT one, and `child_count` is where the skipping
    ; stops. Both functions walk the same slot list for that reason: two
    ; independent switches would be two places to get the order wrong.

    function child_count(n: ref[AstNode]?) returns int
    {
        var i 0
        while child_at(n as ref[AstNode], i) <> null
            set i: i + 1
        i
    }

    ; ── the two slot shapes ─────────────────────────────────────────────────
    ;
    ; The reference's ForEachChild body is a chain of `visit(v, node.X)` and
    ; `visitNodeList(v, node.Xs)`, each of which SKIPS a nil. These two pairs are
    ; that chain, read by index: ask the slot for its i-th child, and if it has
    ; none, subtract what it did contribute and ask the next.
    ;
    ; Writing it this way rather than open-coding each arm is not tidiness. A
    ; four-slot node open-coded is twenty lines of near-identical cursor
    ; arithmetic, and the ORDER of those lines is the thing the yardstick
    ; compares — a transcription error there is a different tree. Two lines per
    ; slot keeps the arm readable AGAINST ast_generated.go, which is how it is
    ; checked.

    function child_slot(n: ref[AstNode]?, i: int) returns ref[AstNode]?
    {
        if n = null
            return null
        if i = 0
            return n
        null
    }

    function slot_count(n: ref[AstNode]?) returns int
    {
        if n = null
            return 0
        1
    }

    function child_in_list(a: ref[Array[ref[AstNode]?]]?, i: int) returns ref[AstNode]?
    {
        if a = null
            return null
        if i < a.get_length() as int
            return *(a.get_buffer() + i)
        null
    }

    function list_count(a: ref[Array[ref[AstNode]?]]?) returns int
    {
        if a = null
            return 0
        a.get_length() as int
    }

    ; The three JSDoc tag SHAPES, one helper each, because eighteen union arms
    ; share them — see the arms below for why they are not written out.

    function jsdoc_tag_child(tag_name: ref[AstNode], comment: ref[Array[ref[AstNode]?]]?, i: int) returns ref[AstNode]?
    {
        var k i
        let a child_slot(tag_name, k)
        if a <> null
            return a
        set k: k - slot_count(tag_name)
        child_in_list(comment, k)
    }

    function jsdoc_one_slot_tag_child(tag_name: ref[AstNode], node: ref[AstNode]?, comment: ref[Array[ref[AstNode]?]]?, i: int) returns ref[AstNode]?
    {
        var k i
        let a child_slot(tag_name, k)
        if a <> null
            return a
        set k: k - slot_count(tag_name)
        let b child_slot(node, k)
        if b <> null
            return b
        set k: k - slot_count(node)
        child_in_list(comment, k)
    }

    function jsdoc_named_tag_child(tag_name: ref[AstNode], type_expression: ref[AstNode]?, name: ref[AstNode]?, comment: ref[Array[ref[AstNode]?]]?, i: int) returns ref[AstNode]?
    {
        var k i
        let a child_slot(tag_name, k)
        if a <> null
            return a
        set k: k - slot_count(tag_name)
        let b child_slot(type_expression, k)
        if b <> null
            return b
        set k: k - slot_count(type_expression)
        let c child_slot(name, k)
        if c <> null
            return c
        set k: k - slot_count(name)
        child_in_list(comment, k)
    }

    function child_at(n: ref[AstNode], i: int) returns ref[AstNode]?
    {
        choose n.data

            ; SourceFile: statements, then the end-of-file token.
            when f: SourceFile
            {
                var k i
                let a child_in_list(f.statements, k)
                if a <> null
                    return a
                set k: k - list_count(f.statements)
                return child_slot(f.end_of_file_token, k)
            }

            when b: Block
                return child_in_list(b.statements, i)

            when e: ExpressionStatement
                return child_slot(e.expression, i)

            when rs: ReturnStatement
                return child_slot(rs.expression, i)

            ; expression, thenStatement, elseStatement.
            when ifs: IfStatement
            {
                var k i
                let a child_slot(ifs.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ifs.expression)
                let b child_slot(ifs.then_statement, k)
                if b <> null
                    return b
                set k: k - slot_count(ifs.then_statement)
                return child_slot(ifs.else_statement, k)
            }

            ; VariableStatement: the modifier list, then the declaration list.
            ; The modifiers come FIRST — visitModifiers before visit(DeclarationList)
            ; in the reference — and they are ordinary nodes here, one Token per
            ; keyword, so `export declare var x` shows two children before the
            ; list.
            when v: VariableStatement
            {
                var k i
                let m child_in_list(v.modifiers, k)
                if m <> null
                    return m
                set k: k - list_count(v.modifiers)
                return child_slot(v.declaration_list, k)
            }

            when l: VariableDeclarationList
                return child_in_list(l.declarations, i)

            ; name, exclamationToken, type, initializer — in that order.
            when d: VariableDeclaration
            {
                var k i
                let a child_slot(d.name, k)
                if a <> null
                    return a
                set k: k - slot_count(d.name)
                let b child_slot(d.exclamation_token, k)
                if b <> null
                    return b
                set k: k - slot_count(d.exclamation_token)
                let c child_slot(d.type_node, k)
                if c <> null
                    return c
                set k: k - slot_count(d.type_node)
                return child_slot(d.initializer, k)
            }

            ; ── the type surface ────────────────────────────────────────────
            ;
            ; modifiers, name, typeParameters, type.
            when ta: TypeAliasDeclaration
            {
                var k i
                let a child_in_list(ta.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ta.modifiers)
                let b child_slot(ta.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ta.name)
                let c child_in_list(ta.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(ta.type_parameters)
                return child_slot(ta.type_node, k)
            }

            ; The reparser's JS spelling of the same node — same record, same
            ; slot list, its own arm (slice 22).
            when jta: JSTypeAliasDeclaration
            {
                var k i
                let a child_in_list(jta.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(jta.modifiers)
                let b child_slot(jta.name, k)
                if b <> null
                    return b
                set k: k - slot_count(jta.name)
                let c child_in_list(jta.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(jta.type_parameters)
                return child_slot(jta.type_node, k)
            }

            ; modifiers, name, constraint, expression, defaultType.
            when tp: TypeParameter
            {
                var k i
                let a child_in_list(tp.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(tp.modifiers)
                let b child_slot(tp.name, k)
                if b <> null
                    return b
                set k: k - slot_count(tp.name)
                let c child_slot(tp.constraint, k)
                if c <> null
                    return c
                set k: k - slot_count(tp.constraint)
                let d child_slot(tp.expression, k)
                if d <> null
                    return d
                set k: k - slot_count(tp.expression)
                return child_slot(tp.default_type, k)
            }

            when tr: TypeReference
            {
                var k i
                let a child_slot(tr.type_name, k)
                if a <> null
                    return a
                set k: k - slot_count(tr.type_name)
                return child_in_list(tr.type_arguments, k)
            }

            when tq: TypeQuery
            {
                var k i
                let a child_slot(tq.expr_name, k)
                if a <> null
                    return a
                set k: k - slot_count(tq.expr_name)
                return child_in_list(tq.type_arguments, k)
            }

            when qn: QualifiedName
            {
                var k i
                let a child_slot(qn.left, k)
                if a <> null
                    return a
                set k: k - slot_count(qn.left)
                return child_slot(qn.right, k)
            }

            when ia: IndexedAccessType
            {
                var k i
                let a child_slot(ia.object_type, k)
                if a <> null
                    return a
                set k: k - slot_count(ia.object_type)
                return child_slot(ia.index_type, k)
            }

            when ct: ConditionalType
            {
                var k i
                let a child_slot(ct.check_type, k)
                if a <> null
                    return a
                set k: k - slot_count(ct.check_type)
                let b child_slot(ct.extends_type, k)
                if b <> null
                    return b
                set k: k - slot_count(ct.extends_type)
                let c child_slot(ct.true_type, k)
                if c <> null
                    return c
                set k: k - slot_count(ct.true_type)
                return child_slot(ct.false_type, k)
            }

            when pr: TypePredicate
            {
                var k i
                let a child_slot(pr.asserts_modifier, k)
                if a <> null
                    return a
                set k: k - slot_count(pr.asserts_modifier)
                let b child_slot(pr.parameter_name, k)
                if b <> null
                    return b
                set k: k - slot_count(pr.parameter_name)
                return child_slot(pr.type_node, k)
            }

            when nt: NamedTupleMember
            {
                var k i
                let a child_slot(nt.dot_dot_dot_token, k)
                if a <> null
                    return a
                set k: k - slot_count(nt.dot_dot_dot_token)
                let b child_slot(nt.name, k)
                if b <> null
                    return b
                set k: k - slot_count(nt.name)
                let c child_slot(nt.question_token, k)
                if c <> null
                    return c
                set k: k - slot_count(nt.question_token)
                return child_slot(nt.type_node, k)
            }

            ; ── signatures ──────────────────────────────────────────────────
            ;
            ; modifiers, dotDotDotToken, name, questionToken, type, initializer.
            when pd: Parameter
            {
                var k i
                let a child_in_list(pd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(pd.modifiers)
                let b child_slot(pd.dot_dot_dot_token, k)
                if b <> null
                    return b
                set k: k - slot_count(pd.dot_dot_dot_token)
                let c child_slot(pd.name, k)
                if c <> null
                    return c
                set k: k - slot_count(pd.name)
                let d child_slot(pd.question_token, k)
                if d <> null
                    return d
                set k: k - slot_count(pd.question_token)
                let e child_slot(pd.type_node, k)
                if e <> null
                    return e
                set k: k - slot_count(pd.type_node)
                return child_slot(pd.initializer, k)
            }

            ; modifiers, asteriskToken, name, typeParameters, parameters, type,
            ; [fullSignature — see the record], body.
            when fd: FunctionDeclaration
            {
                var k i
                let a child_in_list(fd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(fd.modifiers)
                let b child_slot(fd.asterisk_token, k)
                if b <> null
                    return b
                set k: k - slot_count(fd.asterisk_token)
                let c child_slot(fd.name, k)
                if c <> null
                    return c
                set k: k - slot_count(fd.name)
                let d child_in_list(fd.type_parameters, k)
                if d <> null
                    return d
                set k: k - list_count(fd.type_parameters)
                let e child_in_list(fd.parameters, k)
                if e <> null
                    return e
                set k: k - list_count(fd.parameters)
                let f child_slot(fd.type_node, k)
                if f <> null
                    return f
                set k: k - slot_count(fd.type_node)
                let g child_slot(fd.full_signature, k)
                if g <> null
                    return g
                set k: k - slot_count(fd.full_signature)
                return child_slot(fd.body, k)
            }

            ; typeParameters, parameters, type.
            when ft: FunctionType
            {
                var k i
                let a child_in_list(ft.type_parameters, k)
                if a <> null
                    return a
                set k: k - list_count(ft.type_parameters)
                let b child_in_list(ft.parameters, k)
                if b <> null
                    return b
                set k: k - list_count(ft.parameters)
                return child_slot(ft.type_node, k)
            }

            ; modifiers, typeParameters, parameters, type.
            when cs: ConstructorType
            {
                var k i
                let a child_in_list(cs.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(cs.modifiers)
                let b child_in_list(cs.type_parameters, k)
                if b <> null
                    return b
                set k: k - list_count(cs.type_parameters)
                let c child_in_list(cs.parameters, k)
                if c <> null
                    return c
                set k: k - list_count(cs.parameters)
                return child_slot(cs.type_node, k)
            }

            when ut: UnionType
                return child_in_list(ut.types, i)
            when it: IntersectionType
                return child_in_list(it.types, i)
            when tt: TupleType
                return child_in_list(tt.types, i)

            ; The one-child type nodes. Same shape, distinct kinds.
            when at: ArrayType
                return child_slot(at.inner, i)
            when pt: ParenthesizedType
                return child_slot(pt.inner, i)
            when ot: TypeOperator
                return child_slot(ot.inner, i)
            when rt: RestType
                return child_slot(rt.inner, i)
            when opt: OptionalType
                return child_slot(opt.inner, i)
            when inf: InferType
                return child_slot(inf.inner, i)
            when lt: LiteralType
                return child_slot(lt.inner, i)
            when pu: PrefixUnaryExpression
                return child_slot(pu.operand, i)
            when jn: JSDocNullableType
                return child_slot(jn.inner, i)
            when jnn: JSDocNonNullableType
                return child_slot(jnn.inner, i)

            ; ── the expression ladder ───────────────────────────────────────
            ;
            ; left, [type], operatorToken, right — the bracketed slot is the
            ; JSDoc reparser's and is never filled on the parse path (see the
            ; record).
            when be: BinaryExpression
            {
                var k i
                let z child_in_list(be.modifiers, k)
                if z <> null
                    return z
                set k: k - list_count(be.modifiers)
                let a child_slot(be.left, k)
                if a <> null
                    return a
                set k: k - slot_count(be.left)
                let t child_slot(be.type_node, k)
                if t <> null
                    return t
                set k: k - slot_count(be.type_node)
                let b child_slot(be.operator_token, k)
                if b <> null
                    return b
                set k: k - slot_count(be.operator_token)
                return child_slot(be.right, k)
            }

            ; condition, questionToken, whenTrue, colonToken, whenFalse. The two
            ; punctuation tokens ARE children — dropping them would shift every
            ; index after them.
            when ce: ConditionalExpression
            {
                var k i
                let a child_slot(ce.condition, k)
                if a <> null
                    return a
                set k: k - slot_count(ce.condition)
                let b child_slot(ce.question_token, k)
                if b <> null
                    return b
                set k: k - slot_count(ce.question_token)
                let c child_slot(ce.when_true, k)
                if c <> null
                    return c
                set k: k - slot_count(ce.when_true)
                let d child_slot(ce.colon_token, k)
                if d <> null
                    return d
                set k: k - slot_count(ce.colon_token)
                return child_slot(ce.when_false, k)
            }

            when ye: YieldExpression
            {
                var k i
                let a child_slot(ye.asterisk_token, k)
                if a <> null
                    return a
                set k: k - slot_count(ye.asterisk_token)
                return child_slot(ye.expression, k)
            }

            ; expression, then type — the opposite order to TypeAssertion below.
            when ae: AsExpression
            {
                var k i
                let a child_slot(ae.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ae.expression)
                return child_slot(ae.type_node, k)
            }

            when se: SatisfiesExpression
            {
                var k i
                let a child_slot(se.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(se.expression)
                return child_slot(se.type_node, k)
            }

            ; type, then expression.
            when tas: TypeAssertionExpression
            {
                var k i
                let a child_slot(tas.type_node, k)
                if a <> null
                    return a
                set k: k - slot_count(tas.type_node)
                return child_slot(tas.expression, k)
            }

            when pa: PropertyAccessExpression
            {
                var k i
                let a child_slot(pa.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(pa.expression)
                let b child_slot(pa.question_dot_token, k)
                if b <> null
                    return b
                set k: k - slot_count(pa.question_dot_token)
                return child_slot(pa.name, k)
            }

            when ea: ElementAccessExpression
            {
                var k i
                let a child_slot(ea.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ea.expression)
                let b child_slot(ea.question_dot_token, k)
                if b <> null
                    return b
                set k: k - slot_count(ea.question_dot_token)
                return child_slot(ea.argument_expression, k)
            }

            when call: CallExpression
            {
                var k i
                let a child_slot(call.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(call.expression)
                let b child_slot(call.question_dot_token, k)
                if b <> null
                    return b
                set k: k - slot_count(call.question_dot_token)
                let c child_in_list(call.type_arguments, k)
                if c <> null
                    return c
                set k: k - list_count(call.type_arguments)
                return child_in_list(call.arguments, k)
            }

            when ne: NewExpression
            {
                var k i
                let a child_slot(ne.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ne.expression)
                let b child_in_list(ne.type_arguments, k)
                if b <> null
                    return b
                set k: k - list_count(ne.type_arguments)
                return child_in_list(ne.arguments, k)
            }

            when ewta: ExpressionWithTypeArguments
            {
                var k i
                let a child_slot(ewta.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ewta.expression)
                return child_in_list(ewta.type_arguments, k)
            }

            ; modifiers, typeParameters, parameters, type, [fullSignature],
            ; equalsGreaterThanToken, body.
            when af: ArrowFunction
            {
                var k i
                let a child_in_list(af.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(af.modifiers)
                let b child_in_list(af.type_parameters, k)
                if b <> null
                    return b
                set k: k - list_count(af.type_parameters)
                let c child_in_list(af.parameters, k)
                if c <> null
                    return c
                set k: k - list_count(af.parameters)
                let d child_slot(af.type_node, k)
                if d <> null
                    return d
                set k: k - slot_count(af.type_node)
                let fs child_slot(af.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(af.full_signature)
                let e child_slot(af.equals_greater_than_token, k)
                if e <> null
                    return e
                set k: k - slot_count(af.equals_greater_than_token)
                return child_slot(af.body, k)
            }

            ; modifiers, asteriskToken, name, typeParameters, parameters, type,
            ; [fullSignature], body — the same list the declaration has.
            when fe: FunctionExpression
            {
                var k i
                let a child_in_list(fe.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(fe.modifiers)
                let b child_slot(fe.asterisk_token, k)
                if b <> null
                    return b
                set k: k - slot_count(fe.asterisk_token)
                let c child_slot(fe.name, k)
                if c <> null
                    return c
                set k: k - slot_count(fe.name)
                let d child_in_list(fe.type_parameters, k)
                if d <> null
                    return d
                set k: k - list_count(fe.type_parameters)
                let e child_in_list(fe.parameters, k)
                if e <> null
                    return e
                set k: k - list_count(fe.parameters)
                let f child_slot(fe.type_node, k)
                if f <> null
                    return f
                set k: k - slot_count(fe.type_node)
                let fs child_slot(fe.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(fe.full_signature)
                return child_slot(fe.body, k)
            }

            ; modifiers, name, postfixToken, [type], initializer.
            when pas: PropertyAssignment
            {
                var k i
                let a child_in_list(pas.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(pas.modifiers)
                let b child_slot(pas.name, k)
                if b <> null
                    return b
                set k: k - slot_count(pas.name)
                let c child_slot(pas.postfix_token, k)
                if c <> null
                    return c
                set k: k - slot_count(pas.postfix_token)
                let t child_slot(pas.type_node, k)
                if t <> null
                    return t
                set k: k - slot_count(pas.type_node)
                return child_slot(pas.initializer, k)
            }

            ; modifiers, name, postfixToken, [type], equalsToken,
            ; objectAssignmentInitializer.
            when spa: ShorthandPropertyAssignment
            {
                var k i
                let a child_in_list(spa.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(spa.modifiers)
                let b child_slot(spa.name, k)
                if b <> null
                    return b
                set k: k - slot_count(spa.name)
                let c child_slot(spa.postfix_token, k)
                if c <> null
                    return c
                set k: k - slot_count(spa.postfix_token)
                let t child_slot(spa.type_node, k)
                if t <> null
                    return t
                set k: k - slot_count(spa.type_node)
                let d child_slot(spa.equals_token, k)
                if d <> null
                    return d
                set k: k - slot_count(spa.equals_token)
                return child_slot(spa.object_assignment_initializer, k)
            }

            when al: ArrayLiteralExpression
                return child_in_list(al.elements, i)
            when ol: ObjectLiteralExpression
                return child_in_list(ol.elements, i)

            ; The one-child expression nodes. Same shape, distinct kinds — the
            ; same grouping the type side uses.
            when pxu: PostfixUnaryExpression
                return child_slot(pxu.inner, i)
            when de: DeleteExpression
                return child_slot(de.inner, i)
            when toe: TypeOfExpression
                return child_slot(toe.inner, i)
            when ve: VoidExpression
                return child_slot(ve.inner, i)
            when awe: AwaitExpression
                return child_slot(awe.inner, i)
            when nne: NonNullExpression
                return child_slot(nne.inner, i)
            when mp: MetaProperty
                return child_slot(mp.name, i)
            when pe: ParenthesizedExpression
                return child_slot(pe.inner, i)
            when sp: SpreadElement
                return child_slot(sp.inner, i)
            when spd: SpreadAssignment
                return child_slot(spd.inner, i)
            when cpn: ComputedPropertyName
                return child_slot(cpn.inner, i)

            ; ── the class family ────────────────────────────────────────────
            ;
            ; modifiers, name, typeParameters, heritageClauses, members — the
            ; declaration and the expression share the list AND the record.

            when cd: ClassDeclaration
            {
                var k i
                let a child_in_list(cd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(cd.modifiers)
                let b child_slot(cd.name, k)
                if b <> null
                    return b
                set k: k - slot_count(cd.name)
                let c child_in_list(cd.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(cd.type_parameters)
                let d child_in_list(cd.heritage_clauses, k)
                if d <> null
                    return d
                set k: k - list_count(cd.heritage_clauses)
                return child_in_list(cd.members, k)
            }

            when ce: ClassExpression
            {
                var k i
                let a child_in_list(ce.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ce.modifiers)
                let b child_slot(ce.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ce.name)
                let c child_in_list(ce.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(ce.type_parameters)
                let d child_in_list(ce.heritage_clauses, k)
                if d <> null
                    return d
                set k: k - list_count(ce.heritage_clauses)
                return child_in_list(ce.members, k)
            }

            ; The clause visits only its TYPES; `extends` vs `implements` is a
            ; field, not a child (see the record).
            when hc: HeritageClause
                return child_in_list(hc.types, i)

            ; modifiers, asteriskToken, name, postfixToken, typeParameters,
            ; parameters, type, [fullSignature], body.
            when md: MethodDeclaration
            {
                var k i
                let a child_in_list(md.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(md.modifiers)
                let b child_slot(md.asterisk_token, k)
                if b <> null
                    return b
                set k: k - slot_count(md.asterisk_token)
                let c child_slot(md.name, k)
                if c <> null
                    return c
                set k: k - slot_count(md.name)
                let d child_slot(md.postfix_token, k)
                if d <> null
                    return d
                set k: k - slot_count(md.postfix_token)
                let e child_in_list(md.type_parameters, k)
                if e <> null
                    return e
                set k: k - list_count(md.type_parameters)
                let f child_in_list(md.parameters, k)
                if f <> null
                    return f
                set k: k - list_count(md.parameters)
                let g child_slot(md.type_node, k)
                if g <> null
                    return g
                set k: k - slot_count(md.type_node)
                let fs child_slot(md.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(md.full_signature)
                return child_slot(md.body, k)
            }

            ; modifiers, name, postfixToken, type, initializer.
            when prd: PropertyDeclaration
            {
                var k i
                let a child_in_list(prd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(prd.modifiers)
                let b child_slot(prd.name, k)
                if b <> null
                    return b
                set k: k - slot_count(prd.name)
                let c child_slot(prd.postfix_token, k)
                if c <> null
                    return c
                set k: k - slot_count(prd.postfix_token)
                let d child_slot(prd.type_node, k)
                if d <> null
                    return d
                set k: k - slot_count(prd.type_node)
                return child_slot(prd.initializer, k)
            }

            ; modifiers, typeParameters, parameters, type, [fullSignature],
            ; body — no name slot at all.
            when ctd: ConstructorDeclaration
            {
                var k i
                let a child_in_list(ctd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ctd.modifiers)
                let b child_in_list(ctd.type_parameters, k)
                if b <> null
                    return b
                set k: k - list_count(ctd.type_parameters)
                let c child_in_list(ctd.parameters, k)
                if c <> null
                    return c
                set k: k - list_count(ctd.parameters)
                let d child_slot(ctd.type_node, k)
                if d <> null
                    return d
                set k: k - slot_count(ctd.type_node)
                let fs child_slot(ctd.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(ctd.full_signature)
                return child_slot(ctd.body, k)
            }

            ; modifiers, name, typeParameters, parameters, type,
            ; [fullSignature], body — the getter and the setter share it.
            when ga: GetAccessorDeclaration
            {
                var k i
                let a child_in_list(ga.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ga.modifiers)
                let b child_slot(ga.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ga.name)
                let c child_in_list(ga.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(ga.type_parameters)
                let d child_in_list(ga.parameters, k)
                if d <> null
                    return d
                set k: k - list_count(ga.parameters)
                let e child_slot(ga.type_node, k)
                if e <> null
                    return e
                set k: k - slot_count(ga.type_node)
                let fs child_slot(ga.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(ga.full_signature)
                return child_slot(ga.body, k)
            }

            when sa: SetAccessorDeclaration
            {
                var k i
                let a child_in_list(sa.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(sa.modifiers)
                let b child_slot(sa.name, k)
                if b <> null
                    return b
                set k: k - slot_count(sa.name)
                let c child_in_list(sa.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(sa.type_parameters)
                let d child_in_list(sa.parameters, k)
                if d <> null
                    return d
                set k: k - list_count(sa.parameters)
                let e child_slot(sa.type_node, k)
                if e <> null
                    return e
                set k: k - slot_count(sa.type_node)
                let fs child_slot(sa.full_signature, k)
                if fs <> null
                    return fs
                set k: k - slot_count(sa.full_signature)
                return child_slot(sa.body, k)
            }

            when csb: ClassStaticBlockDeclaration
            {
                var k i
                let a child_in_list(csb.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(csb.modifiers)
                return child_slot(csb.body, k)
            }

            ; modifiers, parameters, type.
            when isd: IndexSignatureDeclaration
            {
                var k i
                let a child_in_list(isd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(isd.modifiers)
                let b child_in_list(isd.parameters, k)
                if b <> null
                    return b
                set k: k - list_count(isd.parameters)
                return child_slot(isd.type_node, k)
            }

            ; ── the type-member surface (slice 7) ───────────────────────────

            when tl: TypeLiteral
                return child_in_list(tl.members, i)

            ; typeParameters, parameters, type — for BOTH signature arms.
            when cs: CallSignature
            {
                var k i
                let a child_in_list(cs.type_parameters, k)
                if a <> null
                    return a
                set k: k - list_count(cs.type_parameters)
                let b child_in_list(cs.parameters, k)
                if b <> null
                    return b
                set k: k - list_count(cs.parameters)
                return child_slot(cs.type_node, k)
            }

            when ks: ConstructSignature
            {
                var k i
                let a child_in_list(ks.type_parameters, k)
                if a <> null
                    return a
                set k: k - list_count(ks.type_parameters)
                let b child_in_list(ks.parameters, k)
                if b <> null
                    return b
                set k: k - list_count(ks.parameters)
                return child_slot(ks.type_node, k)
            }

            ; modifiers, name, postfixToken, typeParameters, parameters, type.
            when ms: MethodSignature
            {
                var k i
                let a child_in_list(ms.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ms.modifiers)
                let b child_slot(ms.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ms.name)
                let c child_slot(ms.postfix_token, k)
                if c <> null
                    return c
                set k: k - slot_count(ms.postfix_token)
                let d child_in_list(ms.type_parameters, k)
                if d <> null
                    return d
                set k: k - list_count(ms.type_parameters)
                let e child_in_list(ms.parameters, k)
                if e <> null
                    return e
                set k: k - list_count(ms.parameters)
                return child_slot(ms.type_node, k)
            }

            ; modifiers, name, postfixToken, type, initializer — the same slot
            ; list as PropertyDeclaration, which is why it shares the record.
            when ps: PropertySignature
            {
                var k i
                let a child_in_list(ps.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ps.modifiers)
                let b child_slot(ps.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ps.name)
                let c child_slot(ps.postfix_token, k)
                if c <> null
                    return c
                set k: k - slot_count(ps.postfix_token)
                let d child_slot(ps.type_node, k)
                if d <> null
                    return d
                set k: k - slot_count(ps.type_node)
                return child_slot(ps.initializer, k)
            }

            ; modifiers, name, typeParameters, heritageClauses, members — the
            ; same slot list as a class, which is why it shares the record.
            when id: InterfaceDeclaration
            {
                var k i
                let a child_in_list(id.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(id.modifiers)
                let b child_slot(id.name, k)
                if b <> null
                    return b
                set k: k - slot_count(id.name)
                let c child_in_list(id.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(id.type_parameters)
                let d child_in_list(id.heritage_clauses, k)
                if d <> null
                    return d
                set k: k - list_count(id.heritage_clauses)
                return child_in_list(id.members, k)
            }

            ; modifiers, name, members.
            when ed: EnumDeclaration
            {
                var k i
                let a child_in_list(ed.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ed.modifiers)
                let b child_slot(ed.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ed.name)
                return child_in_list(ed.members, k)
            }

            when em2: EnumMember
            {
                var k i
                let a child_slot(em2.name, k)
                if a <> null
                    return a
                set k: k - slot_count(em2.name)
                return child_slot(em2.initializer, k)
            }

            ; modifiers, name, body. `keyword` is a FIELD, not a child.
            when md: ModuleDeclaration
            {
                var k i
                let a child_in_list(md.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(md.modifiers)
                let b child_slot(md.name, k)
                if b <> null
                    return b
                set k: k - slot_count(md.name)
                return child_slot(md.body, k)
            }

            when mb: ModuleBlock
                return child_in_list(mb.statements, i)

            ; readonlyToken, typeParameter, nameType, questionToken, type,
            ; members.
            when mt: MappedType
            {
                var k i
                let a child_slot(mt.readonly_token, k)
                if a <> null
                    return a
                set k: k - slot_count(mt.readonly_token)
                let b child_slot(mt.type_parameter, k)
                if b <> null
                    return b
                set k: k - slot_count(mt.type_parameter)
                let c child_slot(mt.name_type, k)
                if c <> null
                    return c
                set k: k - slot_count(mt.name_type)
                let d child_slot(mt.question_token, k)
                if d <> null
                    return d
                set k: k - slot_count(mt.question_token)
                let e child_slot(mt.type_node, k)
                if e <> null
                    return e
                set k: k - slot_count(mt.type_node)
                return child_in_list(mt.members, k)
            }

            ; ── the import and export declarations (slice 8) ────────────────
            ;
            ; modifiers, importClause, moduleSpecifier, attributes.
            when imd: ImportDeclaration
            {
                var k i
                let a child_in_list(imd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(imd.modifiers)
                let b child_slot(imd.import_clause, k)
                if b <> null
                    return b
                set k: k - slot_count(imd.import_clause)
                let c child_slot(imd.module_specifier, k)
                if c <> null
                    return c
                set k: k - slot_count(imd.module_specifier)
                return child_slot(imd.attributes, k)
            }

            ; The reparser's JS spelling of the same node (slice 22).
            when jimd: JSImportDeclaration
            {
                var k i
                let a child_in_list(jimd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(jimd.modifiers)
                let b child_slot(jimd.import_clause, k)
                if b <> null
                    return b
                set k: k - slot_count(jimd.import_clause)
                let c child_slot(jimd.module_specifier, k)
                if c <> null
                    return c
                set k: k - slot_count(jimd.module_specifier)
                return child_slot(jimd.attributes, k)
            }

            ; modifiers, name, moduleReference. `is_type_only` is a FIELD.
            when ie: ImportEqualsDeclaration
            {
                var k i
                let a child_in_list(ie.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ie.modifiers)
                let b child_slot(ie.name, k)
                if b <> null
                    return b
                set k: k - slot_count(ie.name)
                return child_slot(ie.module_reference, k)
            }

            ; name, namedBindings — no modifiers, and the phase modifier is a
            ; field rather than the token node it is written as.
            when ic: ImportClause
            {
                var k i
                let a child_slot(ic.name, k)
                if a <> null
                    return a
                set k: k - slot_count(ic.name)
                return child_slot(ic.named_bindings, k)
            }

            when nsi: NamespaceImport
                return child_slot(nsi.inner, i)
            when nis: NamedImports
                return child_in_list(nis.elements, i)
            when nse: NamespaceExport
                return child_slot(nse.inner, i)
            when nes: NamedExports
                return child_in_list(nes.elements, i)
            when emr: ExternalModuleReference
                return child_slot(emr.inner, i)

            ; propertyName, name — for BOTH specifier arms.
            when isp: ImportSpecifier
            {
                var k i
                let a child_slot(isp.property_name, k)
                if a <> null
                    return a
                set k: k - slot_count(isp.property_name)
                return child_slot(isp.name, k)
            }

            when esp: ExportSpecifier
            {
                var k i
                let a child_slot(esp.property_name, k)
                if a <> null
                    return a
                set k: k - slot_count(esp.property_name)
                return child_slot(esp.name, k)
            }

            when iats: ImportAttributes
                return child_in_list(iats.attributes, i)

            when iat: ImportAttribute
            {
                var k i
                let a child_slot(iat.name, k)
                if a <> null
                    return a
                set k: k - slot_count(iat.name)
                return child_slot(iat.value, k)
            }

            ; modifiers, type, expression — the middle slot is the JSDoc
            ; reparser's, filled since slice 22 (see the record).
            when ea2: ExportAssignment
            {
                var k i
                let a child_in_list(ea2.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ea2.modifiers)
                let t child_slot(ea2.type_node, k)
                if t <> null
                    return t
                set k: k - slot_count(ea2.type_node)
                return child_slot(ea2.expression, k)
            }

            when ned: NamespaceExportDeclaration
            {
                var k i
                let a child_in_list(ned.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(ned.modifiers)
                return child_slot(ned.name, k)
            }

            ; modifiers, exportClause, moduleSpecifier, attributes.
            when exd: ExportDeclaration
            {
                var k i
                let a child_in_list(exd.modifiers, k)
                if a <> null
                    return a
                set k: k - list_count(exd.modifiers)
                let b child_slot(exd.export_clause, k)
                if b <> null
                    return b
                set k: k - slot_count(exd.export_clause)
                let c child_slot(exd.module_specifier, k)
                if c <> null
                    return c
                set k: k - slot_count(exd.module_specifier)
                return child_slot(exd.attributes, k)
            }

            ; ── slice 9: the loop and branch statements ──────────────────────
            ;
            ; ★ statement, THEN expression — `do` is the one iteration form
            ; whose body is visited before its condition, and the record's field
            ; order says so (see DoStatementData's header). Reading this arm
            ; against WhileStatement's below is the whole check.
            when ds: DoStatement
            {
                var k i
                let a child_slot(ds.statement, k)
                if a <> null
                    return a
                set k: k - slot_count(ds.statement)
                return child_slot(ds.expression, k)
            }

            when ws: WhileStatement
            {
                var k i
                let a child_slot(ws.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ws.expression)
                return child_slot(ws.statement, k)
            }

            when wis: WithStatement
            {
                var k i
                let a child_slot(wis.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(wis.expression)
                return child_slot(wis.statement, k)
            }

            ; initializer, condition, incrementor, statement — every one of the
            ; first three optional, which is what `for (;;) ;` is.
            when fs: ForStatement
            {
                var k i
                let a child_slot(fs.initializer, k)
                if a <> null
                    return a
                set k: k - slot_count(fs.initializer)
                let b child_slot(fs.condition, k)
                if b <> null
                    return b
                set k: k - slot_count(fs.condition)
                let c child_slot(fs.incrementor, k)
                if c <> null
                    return c
                set k: k - slot_count(fs.incrementor)
                return child_slot(fs.statement, k)
            }

            ; awaitModifier, initializer, expression, statement. Two arms, one
            ; reference struct — so the two slot lists cannot drift apart.
            when fis: ForInStatement
            {
                var k i
                let a child_slot(fis.await_modifier, k)
                if a <> null
                    return a
                set k: k - slot_count(fis.await_modifier)
                let b child_slot(fis.initializer, k)
                if b <> null
                    return b
                set k: k - slot_count(fis.initializer)
                let c child_slot(fis.expression, k)
                if c <> null
                    return c
                set k: k - slot_count(fis.expression)
                return child_slot(fis.statement, k)
            }

            when fos: ForOfStatement
            {
                var k i
                let a child_slot(fos.await_modifier, k)
                if a <> null
                    return a
                set k: k - slot_count(fos.await_modifier)
                let b child_slot(fos.initializer, k)
                if b <> null
                    return b
                set k: k - slot_count(fos.initializer)
                let c child_slot(fos.expression, k)
                if c <> null
                    return c
                set k: k - slot_count(fos.expression)
                return child_slot(fos.statement, k)
            }

            when bs: BreakStatement
                return child_slot(bs.label_name, i)

            when cs: ContinueStatement
                return child_slot(cs.label_name, i)

            when ls: LabeledStatement
            {
                var k i
                let a child_slot(ls.label_name, k)
                if a <> null
                    return a
                set k: k - slot_count(ls.label_name)
                return child_slot(ls.statement, k)
            }

            when ss: SwitchStatement
            {
                var k i
                let a child_slot(ss.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ss.expression)
                return child_slot(ss.case_block, k)
            }

            when cb: CaseBlock
                return child_in_list(cb.elements, i)

            ; expression, then the statement list. The expression is absent on
            ; the default clause and child_slot skips it, so a default clause's
            ; first child is its first statement.
            when cc: CaseClause
            {
                var k i
                let a child_slot(cc.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(cc.expression)
                return child_in_list(cc.statements, k)
            }

            when dc: DefaultClause
            {
                var k i
                let a child_slot(dc.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(dc.expression)
                return child_in_list(dc.statements, k)
            }

            when ts: ThrowStatement
                return child_slot(ts.expression, i)

            when trs: TryStatement
            {
                var k i
                let a child_slot(trs.try_block, k)
                if a <> null
                    return a
                set k: k - slot_count(trs.try_block)
                let b child_slot(trs.catch_clause, k)
                if b <> null
                    return b
                set k: k - slot_count(trs.catch_clause)
                return child_slot(trs.finally_block, k)
            }

            when cl: CatchClause
            {
                var k i
                let a child_slot(cl.variable_declaration, k)
                if a <> null
                    return a
                set k: k - slot_count(cl.variable_declaration)
                return child_slot(cl.block, k)
            }

            ; ── slice 10: the binding pattern ───────────────────────────────

            when obp: ObjectBindingPattern
                return child_in_list(obp.elements, i)
            when abp: ArrayBindingPattern
                return child_in_list(abp.elements, i)

            ; dotDotDotToken, propertyName, name, initializer — in that order.
            ; All four may be null, and an elision has all four null at once, so
            ; this arm answers null at i = 0 and the element is a LEAF that
            ; nevertheless exists. That is not a degenerate case to guard: it is
            ; what the reference builds for `[, a]`.
            when be: BindingElement
            {
                var k i
                let a child_slot(be.dot_dot_dot_token, k)
                if a <> null
                    return a
                set k: k - slot_count(be.dot_dot_dot_token)
                let b child_slot(be.property_name, k)
                if b <> null
                    return b
                set k: k - slot_count(be.property_name)
                let c child_slot(be.name, k)
                if c <> null
                    return c
                set k: k - slot_count(be.name)
                return child_slot(be.initializer, k)
            }

            ; ── slice 11: the template family ───────────────────────────────
            ;
            ; head, then the span list — the same two slots for the expression
            ; and the type, which is why one record serves both (see its header).

            when te: TemplateExpression
            {
                var k i
                let a child_slot(te.head, k)
                if a <> null
                    return a
                set k: k - slot_count(te.head)
                return child_in_list(te.template_spans, k)
            }

            when tlt: TemplateLiteralType
            {
                var k i
                let a child_slot(tlt.head, k)
                if a <> null
                    return a
                set k: k - slot_count(tlt.head)
                return child_in_list(tlt.template_spans, k)
            }

            ; expression (or, in a type, the type), then the literal.
            when ts: TemplateSpan
            {
                var k i
                let a child_slot(ts.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(ts.expression)
                return child_slot(ts.literal, k)
            }

            when tlts: TemplateLiteralTypeSpan
            {
                var k i
                let a child_slot(tlts.expression, k)
                if a <> null
                    return a
                set k: k - slot_count(tlts.expression)
                return child_slot(tlts.literal, k)
            }

            ; tag, questionDotToken, typeArguments, template — the list THIRD.
            when tt: TaggedTemplateExpression
            {
                var k i
                let a child_slot(tt.tag, k)
                if a <> null
                    return a
                set k: k - slot_count(tt.tag)
                let b child_slot(tt.question_dot_token, k)
                if b <> null
                    return b
                set k: k - slot_count(tt.question_dot_token)
                let c child_in_list(tt.type_arguments, k)
                if c <> null
                    return c
                set k: k - list_count(tt.type_arguments)
                return child_slot(tt.template, k)
            }

            ; ── slice 12: the decorator ─────────────────────────────────────
            ;
            ; One slot, `visit(v, node.Expression)`.
            when dec: Decorator
                return child_slot(dec.inner, i)

            ; ── slice 13c: the missing declaration ──────────────────────────
            ;
            ; One LIST slot, `visitModifiers(v, node.modifiers)`.
            when md: MissingDeclaration
                return child_in_list(md.elements, i)

            ; ── slice 18: the import type ───────────────────────────────────
            ;
            ; argument, [attributes], [qualifier], typeArguments — four slots of
            ; which two are optional, and the LIST sits last. `is_type_of` is not
            ; visited, which is why it is a field rather than a slot.
            when it: ImportType
            {
                var k i
                let a child_slot(it.argument, k)
                if a <> null
                    return a
                set k: k - slot_count(it.argument)
                let b child_slot(it.attributes, k)
                if b <> null
                    return b
                set k: k - slot_count(it.attributes)
                let c child_slot(it.qualifier, k)
                if c <> null
                    return c
                set k: k - slot_count(it.qualifier)
                return child_in_list(it.type_arguments, k)
            }

            ; ── slice 20: the JSX arms ──────────────────────────────────────

            when je: JsxElement
            {
                var k i
                let a child_slot(je.opening_element, k)
                if a <> null
                    return a
                set k: k - slot_count(je.opening_element)
                let b child_in_list(je.children, k)
                if b <> null
                    return b
                set k: k - list_count(je.children)
                return child_slot(je.closing_element, k)
            }

            ; Two kinds on one record, so ONE arm cannot serve them — a `choose`
            ; arm is selected by the union TAG, and the two tags are distinct.
            ; The slot lists are identical, which is what the shared record says.
            when joe: JsxOpeningElement
            {
                var k i
                let a child_slot(joe.tag_name, k)
                if a <> null
                    return a
                set k: k - slot_count(joe.tag_name)
                let b child_in_list(joe.type_arguments, k)
                if b <> null
                    return b
                set k: k - list_count(joe.type_arguments)
                return child_slot(joe.attributes, k)
            }

            when jsce: JsxSelfClosingElement
            {
                var k i
                let a child_slot(jsce.tag_name, k)
                if a <> null
                    return a
                set k: k - slot_count(jsce.tag_name)
                let b child_in_list(jsce.type_arguments, k)
                if b <> null
                    return b
                set k: k - list_count(jsce.type_arguments)
                return child_slot(jsce.attributes, k)
            }

            when jce: JsxClosingElement
                return child_slot(jce.inner, i)

            when jf: JsxFragment
            {
                var k i
                let a child_slot(jf.opening_fragment, k)
                if a <> null
                    return a
                set k: k - slot_count(jf.opening_fragment)
                let b child_in_list(jf.children, k)
                if b <> null
                    return b
                set k: k - list_count(jf.children)
                return child_slot(jf.closing_fragment, k)
            }

            when jx: JsxExpression
            {
                var k i
                let a child_slot(jx.dot_dot_dot_token, k)
                if a <> null
                    return a
                set k: k - slot_count(jx.dot_dot_dot_token)
                return child_slot(jx.expression, k)
            }

            when jas: JsxAttributes
                return child_in_list(jas.elements, i)

            when ja: JsxAttribute
            {
                var k i
                let a child_slot(ja.name, k)
                if a <> null
                    return a
                set k: k - slot_count(ja.name)
                return child_slot(ja.initializer, k)
            }

            when jsa: JsxSpreadAttribute
                return child_slot(jsa.inner, i)

            when jnn: JsxNamespacedName
            {
                var k i
                let a child_slot(jnn.namespace_name, k)
                if a <> null
                    return a
                set k: k - slot_count(jnn.namespace_name)
                return child_slot(jnn.name, k)
            }

            ; ── JSDoc (slice 21) ────────────────────────────────────────
            ;
            ; ★ The single-slot kinds share WrappedTypeData with the rest of the
            ; one-child nodes and STILL need an arm each: a `when` names the union
            ; TAG, not the record, so a shared record buys a shared BODY and never
            ; a shared arm. (JSDocNullableType and JSDocNonNullableType have had
            ; theirs since slice 3, up with the type ladder.)
            when jte: JSDocTypeExpression
                return child_slot(jte.inner, i)
            when jnr: JSDocNameReference
                return child_slot(jnr.inner, i)
            when jot: JSDocOptionalType
                return child_slot(jot.inner, i)
            when jvt: JSDocVariadicType
                return child_slot(jvt.inner, i)
            when jl: JSDocLink
                return child_slot(jl.inner, i)
            when jlc: JSDocLinkCode
                return child_slot(jlc.inner, i)
            when jlp: JSDocLinkPlain
                return child_slot(jlp.inner, i)

            when jd: JSDoc
            {
                var k i
                let a child_in_list(jd.comment, k)
                if a <> null
                    return a
                set k: k - list_count(jd.comment)
                return child_in_list(jd.tags, k)
            }

            ; ★ SEVEN kinds share the two-slot shape and NINE the three-slot
            ; one, and a `when` arm names the union TAG rather than the record —
            ; so the sixteen arms below are one line each over a shared helper,
            ; the same arrangement child_slot/child_in_list already impose on
            ; every other arm. Writing the cursor arithmetic sixteen times is
            ; sixteen chances to transcribe the visit ORDER wrong, and the order
            ; is what the yardstick compares.

            when t_unkn: JSDocUnknownTag
                return jsdoc_tag_child(t_unkn.tag_name, t_unkn.comment, i)
            when t_publ: JSDocPublicTag
                return jsdoc_tag_child(t_publ.tag_name, t_publ.comment, i)
            when t_priv: JSDocPrivateTag
                return jsdoc_tag_child(t_priv.tag_name, t_priv.comment, i)
            when t_prot: JSDocProtectedTag
                return jsdoc_tag_child(t_prot.tag_name, t_prot.comment, i)
            when t_read: JSDocReadonlyTag
                return jsdoc_tag_child(t_read.tag_name, t_read.comment, i)
            when t_over: JSDocOverrideTag
                return jsdoc_tag_child(t_over.tag_name, t_over.comment, i)
            when t_depr: JSDocDeprecatedTag
                return jsdoc_tag_child(t_depr.tag_name, t_depr.comment, i)

            when o_type: JSDocTypeTag
                return jsdoc_one_slot_tag_child(o_type.tag_name, o_type.node, o_type.comment, i)
            when o_retu: JSDocReturnTag
                return jsdoc_one_slot_tag_child(o_retu.tag_name, o_retu.node, o_retu.comment, i)
            when o_seet: JSDocSeeTag
                return jsdoc_one_slot_tag_child(o_seet.tag_name, o_seet.node, o_seet.comment, i)
            when o_impl: JSDocImplementsTag
                return jsdoc_one_slot_tag_child(o_impl.tag_name, o_impl.node, o_impl.comment, i)
            when o_augm: JSDocAugmentsTag
                return jsdoc_one_slot_tag_child(o_augm.tag_name, o_augm.node, o_augm.comment, i)
            when o_sati: JSDocSatisfiesTag
                return jsdoc_one_slot_tag_child(o_sati.tag_name, o_sati.node, o_sati.comment, i)
            when o_thro: JSDocThrowsTag
                return jsdoc_one_slot_tag_child(o_thro.tag_name, o_thro.node, o_thro.comment, i)
            when o_this: JSDocThisTag
                return jsdoc_one_slot_tag_child(o_this.tag_name, o_this.node, o_this.comment, i)
            when o_over: JSDocOverloadTag
                return jsdoc_one_slot_tag_child(o_over.tag_name, o_over.node, o_over.comment, i)

            when jtt: JSDocTemplateTag
            {
                var k i
                let a child_slot(jtt.tag_name, k)
                if a <> null
                    return a
                set k: k - slot_count(jtt.tag_name)
                let b child_slot(jtt.constraint, k)
                if b <> null
                    return b
                set k: k - slot_count(jtt.constraint)
                let c child_in_list(jtt.type_parameters, k)
                if c <> null
                    return c
                set k: k - list_count(jtt.type_parameters)
                return child_in_list(jtt.comment, k)
            }

            when jit: JSDocImportTag
            {
                var k i
                let a child_slot(jit.tag_name, k)
                if a <> null
                    return a
                set k: k - slot_count(jit.tag_name)
                let b child_slot(jit.import_clause, k)
                if b <> null
                    return b
                set k: k - slot_count(jit.import_clause)
                let c child_slot(jit.module_specifier, k)
                if c <> null
                    return c
                set k: k - slot_count(jit.module_specifier)
                let d child_slot(jit.attributes, k)
                if d <> null
                    return d
                set k: k - slot_count(jit.attributes)
                return child_in_list(jit.comment, k)
            }

            ; tagName, typeExpression, name, comment — @typedef and @callback.
            when n_typedef: JSDocTypedefTag
                return jsdoc_named_tag_child(n_typedef.tag_name, n_typedef.type_expression, n_typedef.name, n_typedef.comment, i)
            when n_callback: JSDocCallbackTag
                return jsdoc_named_tag_child(n_callback.tag_name, n_callback.type_expression, n_callback.name, n_callback.comment, i)

            when js: JSDocSignature
            {
                var k i
                let a child_in_list(js.type_parameters, k)
                if a <> null
                    return a
                set k: k - list_count(js.type_parameters)
                let b child_in_list(js.parameters, k)
                if b <> null
                    return b
                set k: k - list_count(js.parameters)
                return child_slot(js.type_node, k)
            }

            when jtl: JSDocTypeLiteral
                return child_in_list(jtl.property_tags, i)

            ; ★★★ The one arm whose ORDER is a function of a FIELD — see the
            ; record. `@param {T} x` and `@param x {T}` are the same node with
            ; the two middle slots swapped, and the yardstick compares the walk,
            ; so getting this backwards is a different tree.
            when jpt: JSDocParameterOrPropertyTag
            {
                var k i
                let a child_slot(jpt.tag_name, k)
                if a <> null
                    return a
                set k: k - slot_count(jpt.tag_name)
                if jpt.is_name_first
                {
                    let b child_slot(jpt.name, k)
                    if b <> null
                        return b
                    set k: k - slot_count(jpt.name)
                    let c child_slot(jpt.type_expression, k)
                    if c <> null
                        return c
                    set k: k - slot_count(jpt.type_expression)
                }
                else
                {
                    let b child_slot(jpt.type_expression, k)
                    if b <> null
                        return b
                    set k: k - slot_count(jpt.type_expression)
                    let c child_slot(jpt.name, k)
                    if c <> null
                        return c
                    set k: k - slot_count(jpt.name)
                }
                return child_in_list(jpt.comment, k)
            }

            ; The leaves. The reference gives none of these a ForEachChild, so
            ; they inherit NodeDefault's `return false` — no children at all.
            ; `Token` covers the punctuation and keyword nodes AND, for the same
            ; reason, KeywordTypeNode and ThisTypeNode (see the header).
            when t: Token
                return null
            when d: Identifier
                return null
            when pid: PrivateIdentifier
                return null
            when s: StringLiteral
                return null
            when nu: NumericLiteral
                return null
            when bi: BigIntLiteral
                return null
            when ns: NoSubstitutionTemplateLiteral
                return null
            when re: RegularExpressionLiteral
                return null
            when th: TemplateHead
                return null
            when tm: TemplateMiddle
                return null
            when tl: TemplateTail
                return null
            when em: EmptyStatement
                return null

            ; JsxText is a leaf like the other literal-likes; the reference gives
            ; it no ForEachChild either.
            when jxt: JsxText
                return null

            ; JSDocText and JSDocAllType are leaves too: the reference gives
            ; JSDocText a `text []string` this port does not store (§3.5q — no
            ; reader, and neither yardstick compares a node's text) and
            ; JSDocAllType no field at all.
            when jdt: JSDocText
                return null
            when jat: JSDocAllType
                return null

        null
    }
}

; ── the binder's data: Symbol, SymbolTable (slice 27) ───────────────────────
;
; Ported from the reference's internal/ast/symbol.go, and they live HERE for the
; reason they live in package ast upstream: a Symbol points at the declaration
; NODES it was built from and a node points at the symbol it owns, so the two
; types are mutually recursive. Two modules cannot be, so they share ast's.
;
; ★★★ NO NESTED BY-VALUE STRUCT, anywhere in this section, and that is the same
; decision AstNode's `pos`/`end` pair records: a by-value struct nested in a
; struct is not laid out in a root that never declared it (exit 16), and these
; types are read from the dumper program. A symbol's NAME is therefore a
; (pointer, length) PAIR spelled out as two fields rather than a `SymbolName`
; concept — which is also what a Go string is.
;
; ★ A name's bytes are BORROWED. They point either into the source text (an
; identifier's or a literal's own bytes, which live as long as the parse) or into
; a buffer the binder built on its own page for a synthesized name (`__type`,
; `"module"`, `__#1@x`). Nothing here copies, and nothing may free either.

define Symbol
(
    flags: int

    ; The reference's `Name string`. Bytes, not a String: an internal name begins
    ; with the byte 0xFE, which is not valid UTF-8 — upstream picks it for exactly
    ; that reason — so a type that promises text would be promising too much.
    name_data: pointer[char]
    name_len: int

    ; Every declaration node that contributed to this symbol, in the order the
    ; binder met them, and the reason the symbols dump prints them all: a merge
    ; (two `var x`, an interface reopened) is ONE symbol with several
    ; declarations, which is invisible in the SHAPE at any single node.
    declarations: ref[Array[ref[AstNode]?]]?
    value_declaration: ref[AstNode]?

    members: ref[SymbolTable]?
    exports: ref[SymbolTable]?
    parent: ref[Symbol]?
    export_symbol: ref[Symbol]?

    ; ★★★ `ast.GetSymbolId`'s lazily assigned id, slice 41, and the reason it is a
    ; field on the SYMBOL while the counter that feeds it sits on the Binder is the
    ; reference's own split: upstream keeps `nextSymbolId` as a package-global
    ; atomic and stores the drawn number in the symbol, assigning it on FIRST
    ; REQUEST by CAS. 0 means unassigned, exactly as upstream's zero value does,
    ; so a symbol nobody asks about never draws a number — which is load-bearing
    ; rather than an optimisation: the numbers are observable through
    ; GetSymbolNameForPrivateIdentifier, so a class that draws one it should not
    ; have shifts the name of every later class.
    ;
    ; ★★ The counter here is PER FILE and upstream's is per PROCESS. That is a
    ; deliberate divergence in the direction §3.10 already argued for, and what
    ; makes it invisible is a property of the oracle rather than of the reference:
    ; `tests/oracle/symbols.go` binds ONE file per process, and within a bind the
    ; only consumer of a symbol id in all of `internal/binder` is the private-name
    ; minter — so upstream's global counter starts at zero for every unit the
    ; yardstick compares and hands out the same numbers a per-file counter does.
    ; In a real multi-file program upstream's numbers would differ, and this port's
    ; would not. See §3.5cl: what agrees here is the harness, not the spelling.
    id: int

    ; ★★★ ast.Symbol.CheckFlags, slice 86, and the note it replaces is
    ; get_type_of_symbol's: *"this port has no CheckFlags at all, because nothing
    ; in it creates a TRANSIENT symbol"*. instantiate_symbol creates one, so the
    ; word is now a bit rather than a claim. The BINDER never sets it — every one
    ; of the reference's twenty-odd CheckFlags is written by the checker — which is
    ; why it lives beside `id` and not among the binder's slots, and why
    ; `Symbol.create` writes a plain zero.
    check_flags: int
)
{
    ; The reference's newSymbol, minus the arena: one allocation on the binder's
    ; page. NOT a constructed value — a data class with no init zero-fills only on
    ; CONSTRUCTION, and every field is written here, so a forgotten one would be
    ; region garbage rather than null.
    function create(host: ref[Page], flags: int, name_data: pointer[char], name_len: int) returns ref[Symbol]
    {
        let s host.allocate(sizeof Symbol, alignof Symbol) as pointer[Symbol]
        set s.flags: flags
        set s.name_data: name_data
        set s.name_len: name_len
        set s.declarations: null
        set s.value_declaration: null
        set s.members: null
        set s.exports: null
        set s.parent: null
        set s.export_symbol: null
        set s.id: 0
        set s.check_flags: 0
        s
    }

    function check_flags_of(s: ref[Symbol]) returns int
        s.check_flags

    procedure set_check_flags(s: ref[Symbol], f: int)
        set s.check_flags: f

    ; `symbol.Flags |= f`, slice 99. It exists because a TRANSIENT property symbol
    ; is minted with its member's flags and then gains SymbolFlagsOptional from
    ; either a default value or the contextual type's implied property — two writes
    ; on a symbol nothing else can reach, which is what makes an OR-in setter safe
    ; here where a plain `set_flags` would not be.
    procedure add_flags(s: ref[Symbol], f: int)
        set s.flags: s.flags | f

    ; The three slots `instantiateSymbol` copies from the symbol it instantiates.
    ; They are copied as REFERENCES — the declarations array is shared, exactly as
    ; the reference's `result.Declarations = symbol.Declarations` shares a slice —
    ; because a transient symbol is a second view of one declaration and not a
    ; second declaration.
    procedure copy_declarations_from(dest: ref[Symbol], src: ref[Symbol])
    {
        set dest.declarations: src.declarations
        set dest.value_declaration: src.value_declaration
        set dest.parent: src.parent
    }

    ; ast.GetMembers / ast.GetExports: the table is made on FIRST USE, exactly as
    ; upstream's are, because whether a symbol has one at all is observable — the
    ; symbols dump prints `-` for a symbol with no members table and an id for a
    ; symbol with an empty one.
    function get_members(host: ref[Page], s: ref[Symbol]) returns ref[SymbolTable]
    {
        if s.members = null
            set s.members: SymbolTable.create(host)
        s.members as ref[SymbolTable]
    }

    function get_exports(host: ref[Page], s: ref[Symbol]) returns ref[SymbolTable]
    {
        if s.exports = null
            set s.exports: SymbolTable.create(host)
        s.exports as ref[SymbolTable]
    }

    ; `c.globalThisSymbol.Exports = c.globals` (slice 104) — the one place in
    ; either program that hands a symbol a table it does not own. It cannot go
    ; through get_exports: that helper MAKES a table, and the point here is that
    ; the globals table and globalThis's exports are the SAME object, so a name
    ; merged into globals is visible as a property of `globalThis` without a
    ; second write.
    procedure set_exports(s: ref[Symbol], t: ref[SymbolTable])
        set s.exports: t

    ; ── accessors for the dumper, which is another program ROOT ──────────────
    ;
    ; Statics taking the symbol by pointer, for the reason AstNode's accessors are
    ; statics: a user program calling a CROSS-PACKAGE free function with a
    ; concept-pointer parameter fails resolution, while a concept STATIC resolves.

    function flags_of(s: ref[Symbol]) returns int
        s.flags

    function name_data_of(s: ref[Symbol]) returns pointer[char]
        s.name_data

    function name_len_of(s: ref[Symbol]) returns int
        s.name_len

    function parent_of(s: ref[Symbol]) returns ref[Symbol]?
        s.parent

    ; `symbol.Parent != nil` as checkFunctionOrMethodDeclaration asks it — a
    ; presence TEST rather than the value, which is all that call site wants.
    function has_parent(s: ref[Symbol]) returns bool
        s.parent <> null

    function export_symbol_of(s: ref[Symbol]) returns ref[Symbol]?
        s.export_symbol

    function value_declaration_of(s: ref[Symbol]) returns ref[AstNode]?
        s.value_declaration

    function members_of(s: ref[Symbol]) returns ref[SymbolTable]?
        s.members

    function exports_of(s: ref[Symbol]) returns ref[SymbolTable]?
        s.exports

    function declaration_count(s: ref[Symbol]) returns int
    {
        if s.declarations = null
            return 0
        s.declarations.get_length() as int
    }

    function declaration_at(s: ref[Symbol], i: int) returns ref[AstNode]?
    {
        if s.declarations = null
            return null
        if i >= (s.declarations.get_length() as int)
            return null
        *(s.declarations.get_buffer() + i)
    }
}

; One slot of a SymbolTable. The hash is stored beside the key because the whole
; table is rebuilt on growth and rehashing a name means walking its bytes again.
define SymbolTableEntry
(
    name_data: pointer[char]
    name_len: int
    hash: int
    symbol: ref[Symbol]?
)
{
    init(d: pointer[char], n: int, h: int, sym: ref[Symbol]?)
    {
        set name_data: d
        set name_len: n
        set hash: h
        set symbol: sym
    }
}

; The reference's `SymbolTable map[string]*Symbol`.
;
; ★★★ WHY A HASH TABLE AND NOT A LIST, measured rather than assumed: the largest
; locals table in the stage-2 corpus holds 5000 entries and so does the largest
; exports table, so a linear probe would be 12.5 million name comparisons for one
; container. Open addressing over a power-of-two bucket array, with the entries
; kept in a separate Array in INSERTION order — the order is not compared (the
; dump sorts by name, because a Go map has no order to compare) but it makes a
; table walkable without touching the buckets.
;
; ★ It is OURS rather than the stdlib's HashMap, and that is a decision with two
; halves. The stdlib's map is IMMUTABLE — built once from a HashMapBuilder — and a
; symbol table is written to throughout the bind; and the license rule runs the
; other way for this package (§1: MIT into Apache is fine, so using the stdlib
; would have been allowed, but nothing here may travel back).
define SymbolTable
(
    entries: ref[Array[SymbolTableEntry]]
    buckets: ref[Vector[int]]?      ; entry index + 1; 0 means empty
    mask: int
)
{
    function create(host: ref[Page]) returns ref[SymbolTable]
    {
        let t host.allocate(sizeof SymbolTable, alignof SymbolTable) as pointer[SymbolTable]
        let a &Array[SymbolTableEntry]^host()
        set t.entries: a
        set t.buckets: null
        set t.mask: 0
        t
    }

    ; FNV-1a over the bytes, folded to a non-negative int. The function is ours;
    ; only its CONSISTENCY matters, since no dump compares a hash.
    function hash_name(d: Slice[char]) returns int
    {
        var h: u64 14695981039346656037
        var i 0
        while i < d.length
        {
            let b (d[i]) as u8
            set h: h xor (b as u64)
            set h: h * 1099511628211
            set i: i + 1
        }
        ((h >> 1) as int)
    }

    function names_equal(a: pointer[char], an: int, b: pointer[char], bn: int) returns bool
    {
        if an <> bn
            return false
        var i 0
        while i < an
        {
            if *(a + i) <> *(b + i)
                return false
            set i: i + 1
        }
        true
    }

    function length(t: ref[SymbolTable]?) returns int
    {
        if t = null
            return 0
        t.entries.get_length() as int
    }

    function entry_symbol_at(t: ref[SymbolTable]?, i: int) returns ref[Symbol]?
    {
        if t = null
            return null
        if i >= (t.entries.get_length() as int)
            return null
        (*(t.entries.get_buffer() + i)).symbol
    }

    function entry_name_data_at(t: ref[SymbolTable]?, i: int) returns pointer[char]
    {
        if t = null
            return null
        if i >= (t.entries.get_length() as int)
            return null
        (*(t.entries.get_buffer() + i)).name_data
    }

    function entry_name_len_at(t: ref[SymbolTable]?, i: int) returns int
    {
        if t = null
            return 0
        if i >= (t.entries.get_length() as int)
            return 0
        (*(t.entries.get_buffer() + i)).name_len
    }

    ; The map read: `symbolTable[name]`, which answers nil for an absent name.
    function get(t: ref[SymbolTable]?, d: pointer[char], n: int) returns ref[Symbol]?
    {
        if t = null
            return null
        if t.buckets = null
            return null
        let h SymbolTable.hash_name(Slice[char](n, d))
        var slot h & t.mask
        while true
        {
            let e t.buckets.get(slot as size_t)
            if e = null
                return null
            let idx *e
            if idx = 0
                return null
            let ent *(t.entries.get_buffer() + (idx - 1))
            if ent.hash = h
            {
                if SymbolTable.names_equal(ent.name_data, ent.name_len, d, n)
                    return ent.symbol
            }
            set slot: (slot + 1) & t.mask
        }
        null
    }

    ; The map write: `symbolTable[name] = symbol`. An existing name is REPLACED in
    ; place, which is what the reference's assignment does when a conflict throws
    ; the old symbol away (declareSymbolEx does exactly that).
    procedure set_entry(host: ref[Page], t: ref[SymbolTable], d: pointer[char], n: int, sym: ref[Symbol]?)
    {
        let h SymbolTable.hash_name(Slice[char](n, d))
        if t.buckets <> null
        {
            var slot h & t.mask
            while true
            {
                let e t.buckets.get(slot as size_t)
                if e = null
                    break
                let idx *e
                if idx = 0
                    break
                let ent *(t.entries.get_buffer() + (idx - 1))
                if ent.hash = h
                {
                    if SymbolTable.names_equal(ent.name_data, ent.name_len, d, n)
                    {
                        ; ★★★ THE STORE MUST BE THE POINTER-MEMBER FORM, and the
                        ; explicit-deref spelling that stood here until slice 31 was
                        ; a SILENT NO-OP: `set (*p).field: v` writes to a
                        ; dereferenced value COPY, so the table kept its old symbol
                        ; and nothing anywhere failed. The same class is documented
                        ; in `scaly/memory/root_pages.scaly` (the heap-trace table),
                        ; where it also shipped for years unexecuted — and here it
                        ; was unexecuted for four binder slices, because REPLACING
                        ; an entry needs a name that is already in the table with a
                        ; DIFFERENT symbol: a class merging into a namespace that
                        ; exports `prototype` is the first construct in this port
                        ; that does it (fixtures/binder_module_prototype.ts).
                        let slot_ptr t.entries.get_buffer() + (idx - 1)
                        set slot_ptr.symbol: sym
                        return
                    }
                }
                set slot: (slot + 1) & t.mask
            }
        }

        t.entries.add(SymbolTableEntry(d, n, h, sym))
        let count t.entries.get_length() as int

        ; Grow while the load factor would pass one half, and rebuild every bucket
        ; from the entry list — the entries themselves never move.
        var cap 0
        if t.buckets <> null
            set cap: (t.mask + 1)
        if (count * 2) > cap
        {
            var new_cap 8
            while (count * 2) > new_cap
                set new_cap: new_cap * 2
            ; Vector[T](len) memsets its buffer, so the empty marker is 0 by
            ; construction rather than by a loop here — the stdlib's own init has
            ; the memset and its comment says so.
            let v Vector[int]^host(new_cap as size_t)
            set t.buckets: v
            set t.mask: new_cap - 1
            var j 0
            while j < count
            {
                let ent *(t.entries.get_buffer() + j)
                var slot ent.hash & t.mask
                while true
                {
                    let e t.buckets.get(slot as size_t)
                    if *e = 0
                        break
                    set slot: (slot + 1) & t.mask
                }
                t.buckets.put(slot as size_t, j + 1)
                set j: j + 1
            }
            return
        }

        var slot h & t.mask
        while true
        {
            let e t.buckets.get(slot as size_t)
            if *e = 0
                break
            set slot: (slot + 1) & t.mask
        }
        t.buckets.put(slot as size_t, count)
    }
}
