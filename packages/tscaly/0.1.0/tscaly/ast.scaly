    function body_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when fd: FunctionDeclaration
                return fd.body
            when fe: FunctionExpression
                return fe.body
            when af: ArrowFunction
                return af.body
            when md: MethodDeclaration
                return md.body
            when ctd: ConstructorDeclaration
                return ctd.body
