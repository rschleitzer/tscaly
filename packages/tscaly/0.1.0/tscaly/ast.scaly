    ; JSDocSignature's Type slot — which holds the @returns TAG, not a type.
    function jsdoc_signature_type_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when js: JSDocSignature
                return js.type_node
        null
    }

    function type_parameter_default_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when tp: TypeParameter
                return tp.default_type
        null
    }

    ; ── the writes ──────────────────────────────────────────────────────────

    procedure set_type(n: pointer[AstNode], t: pointer[AstNode])
    {
        choose n.data
            when vd: VariableDeclaration
            {
                var d vd
                set d.type_node: t
                set n.data: NodeData.VariableDeclaration(d)
            }
            when pd: PropertyDeclaration
            {
                var d pd
                set d.type_node: t
                set n.data: NodeData.PropertyDeclaration(d)
            }
            when ps: PropertySignature
            {
                var d ps
                set d.type_node: t
                set n.data: NodeData.PropertySignature(d)
            }
            when pa: PropertyAssignment
            {
                var d pa
                set d.type_node: t
                set n.data: NodeData.PropertyAssignment(d)
            }
            when spa: ShorthandPropertyAssignment
            {
                var d spa
                set d.type_node: t
                set n.data: NodeData.ShorthandPropertyAssignment(d)
            }
            when ea: ExportAssignment
            {
                var d ea
                set d.type_node: t
                set n.data: NodeData.ExportAssignment(d)
            }
            when pm: Parameter
            {
                var d pm
                set d.type_node: t
                set n.data: NodeData.Parameter(d)
            }
            when ga: GetAccessorDeclaration
            {
                var d ga
                set d.type_node: t
                set n.data: NodeData.GetAccessorDeclaration(d)
            }
            when sa: SetAccessorDeclaration
            {
                var d sa
                set d.type_node: t
                set n.data: NodeData.SetAccessorDeclaration(d)
            }
            when fd: FunctionDeclaration
            {
                var d fd
                set d.type_node: t
                set n.data: NodeData.FunctionDeclaration(d)
            }
            when fe: FunctionExpression
            {
                var d fe
                set d.type_node: t
                set n.data: NodeData.FunctionExpression(d)
            }
            when af: ArrowFunction
            {
                var d af
                set d.type_node: t
                set n.data: NodeData.ArrowFunction(d)
            }
            when md: MethodDeclaration
            {
                var d md
                set d.type_node: t
                set n.data: NodeData.MethodDeclaration(d)
            }
            when ctd: ConstructorDeclaration
            {
                var d ctd
                set d.type_node: t
                set n.data: NodeData.ConstructorDeclaration(d)
            }
            when ft: FunctionType
            {
                var d ft
                set d.type_node: t
                set n.data: NodeData.FunctionType(d)
            }
            when be: BinaryExpression
            {
                var d be
                set d.type_node: t
                set n.data: NodeData.BinaryExpression(d)
            }
            when ta: TypeAliasDeclaration
            {
                var d ta
                set d.type_node: t
                set n.data: NodeData.TypeAliasDeclaration(d)
            }
            when jta: JSTypeAliasDeclaration
            {
                var d jta
                set d.type_node: t
                set n.data: NodeData.JSTypeAliasDeclaration(d)
            }
            when ms: MethodSignature
            {
                var d ms
                set d.type_node: t
                set n.data: NodeData.MethodSignature(d)
            }
            when cs: CallSignature
            {
                var d cs
                set d.type_node: t
                set n.data: NodeData.CallSignature(d)
            }
            when ks: ConstructSignature
            {
                var d ks
                set d.type_node: t
                set n.data: NodeData.ConstructSignature(d)
            }
            when ix: IndexSignatureDeclaration
            {
                var d ix
                set d.type_node: t
                set n.data: NodeData.IndexSignatureDeclaration(d)
            }
    }

    procedure set_initializer(n: pointer[AstNode], e: pointer[AstNode])
    {
        choose n.data
            when vd: VariableDeclaration
            {
                var d vd
                set d.initializer: e
                set n.data: NodeData.VariableDeclaration(d)
            }
            when pd: PropertyDeclaration
