    ; A VariableStatement's declaration list, and a declaration list's
    ; declarations — two hops the reparser makes on every @type and @satisfies.
    function variable_statement_list_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when vs: VariableStatement
                return vs.declaration_list
        null
    }

    function variable_declarations_of(n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        if n = null
            return null
        choose n.data
            when dl: VariableDeclarationList
                return dl.declarations
        null
    }

    ; A ClassDeclaration's / ClassExpression's heritage clauses — the reference's
    ; getClassLikeData, which answers nil for anything else.
    function class_heritage_clauses_of(n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        if n = null
            return null
        choose n.data
            when cl: ClassDeclaration
                return cl.heritage_clauses
            when ce: ClassExpression
                return ce.heritage_clauses
        null
    }

    function heritage_clause_token_of(n: pointer[AstNode]) returns int
    {
        if n = null
            return KindUnknown
        choose n.data
            when hc: HeritageClause
                return hc.token
        KindUnknown
    }

    function heritage_clause_types_of(n: pointer[AstNode]) returns pointer[Array[pointer[AstNode]]]
    {
        if n = null
            return null
        choose n.data
            when hc: HeritageClause
                return hc.types
        null
    }

    function import_clause_of(n: pointer[AstNode]) returns pointer[AstNode]
    {
        if n = null
            return null
        choose n.data
            when imd: ImportDeclaration
                return imd.import_clause
            when jimd: JSImportDeclaration
                return jimd.import_clause
        null
    }

    ; The Identifier payload, so a reparse can compare two names by TEXT the way
    ; findMatchingParameter does.
    function identifier_text_of(n: pointer[AstNode]) returns pointer[char]
    {
        if n = null
            return null
        choose n.data
            when id: Identifier
                return id.text
        null
    }

    function identifier_text_length_of(n: pointer[AstNode]) returns int
    {
        if n = null
            return 0
        choose n.data
            when id: Identifier
                return id.text_len
        0
    }


