; SPDX-License-Identifier: Apache-2.0
;
; inflate — a gzip member (RFC 1952) over DEFLATE (RFC 1951), written from the two
; RFCs. The reference embeds its translated diagnostic messages gzip-compressed
; (internal/diagnostics/loc/*.json.gz, read through compress/gzip); the port reads
; the same files. The header's CRC and the trailer are not checked.

use scaly.memory.Page
use scaly.containers.Array

; a canonical Huffman code: how many codes of each length (0..15) and the symbols
; in code order
define HuffmanCode (counts: ref[Array[int]]  symbols: ref[Array[int]])

define Inflate
(
    host: ref[Page]
    data: Slice[char]
    var pos: int
    var bit_buffer: int
    var bit_count: int
    out: ref[Array[char]]
    var failed: bool
)
{
    ; the uncompressed bytes of a gzip file, empty when it is not one
    procedure gunzip(host: ref[Page], mutable data: Slice[char]) returns Slice[char]
    {
        let n data.length as int
        if n < 18
            return Slice[char]()
        if (data[0] as int) <> 31
            return Slice[char]()
        if (data[1] as int) <> 139
            return Slice[char]()
        if (data[2] as int) <> 8
            return Slice[char]()
        let flags data[3] as int
        var p 10
        if (flags & 4) <> 0
        {
            let xlen (data[p as size_t] as int) | ((data[(p + 1) as size_t] as int) << 8)
            p := p + 2 + xlen
        }
        if (flags & 8) <> 0
        {
            while (p < n) and ((data[p as size_t] as int) <> 0)
                p := p + 1
            p := p + 1
        }
        if (flags & 16) <> 0
        {
            while (p < n) and ((data[p as size_t] as int) <> 0)
                p := p + 1
            p := p + 1
        }
        if (flags & 2) <> 0
            p := p + 2
        let inflater &Inflate^host(host, data, p, 0, 0, &Array[char]^host(), false)
        inflater.run()
        if inflater.failed
            return Slice[char]()
        inflater.out.as_slice()
    }

    ; the next `count` bits, least significant first; -1 past the end
    procedure bits(mutable this, count: int) returns int
    {
        while bit_count < count
        {
            if pos >= (data.length as int)
            {
                this.failed := true
                return 0 - 1
            }
            this.bit_buffer := bit_buffer | ((data[pos as size_t] as int) << bit_count)
            this.pos := pos + 1
            this.bit_count := bit_count + 8
        }
        let value bit_buffer & ((1 << count) - 1)
        this.bit_buffer := bit_buffer >> count
        this.bit_count := bit_count - count
        value
    }

    procedure run(mutable this)
    {
        repeat
        {
            let final this.bits(1)
            let kind this.bits(2)
            if failed
                return
            if kind = 0
                this.stored()
            else
            {
                if kind = 1
                    this.fixed()
                else
                {
                    if kind = 2
                        this.dynamic()
                    else
                        this.failed := true
                }
            }
            if failed
                return
            if final = 1
                return
        }
    }

    ; a stored block: byte-aligned length, its complement, the bytes
    procedure stored(mutable this)
    {
        this.bit_buffer := 0
        this.bit_count := 0
        if (pos + 4) > (data.length as int)
        {
            this.failed := true
            return
        }
        let length (data[pos as size_t] as int) | ((data[(pos + 1) as size_t] as int) << 8)
        this.pos := pos + 4
        if (pos + length) > (data.length as int)
        {
            this.failed := true
            return
        }
        var i 0
        while i < length
        {
            out.add(data[(pos + i) as size_t])
            i := i + 1
        }
        this.pos := pos + length
    }

    ; a canonical code from the code lengths of its symbols
    procedure code_of(this, lengths: ref[Array[int]]) returns ref[HuffmanCode]
    {
        let counts &Array[int]^host()
        var l 0
        while l < 16
        {
            counts.add(0)
            l := l + 1
        }
        var s 0
        while s < (lengths.get_length() as int)
        {
            let len lengths[s as size_t]
            counts.put(len as size_t, counts[len as size_t] + 1)
            s := s + 1
        }
        counts.put(0, 0)
        let offsets &Array[int]()
        offsets.add(0)
        offsets.add(0)
        var k 1
        while k < 15
        {
            offsets.add(offsets[k as size_t] + counts[k as size_t])
            k := k + 1
        }
        let symbols &Array[int]^host()
        var z 0
        while z < (lengths.get_length() as int)
        {
            symbols.add(0)
            z := z + 1
        }
        var t 0
        while t < (lengths.get_length() as int)
        {
            let len lengths[t as size_t]
            if len <> 0
            {
                let at offsets[len as size_t]
                symbols.put(at as size_t, t)
                offsets.put(len as size_t, at + 1)
            }
            t := t + 1
        }
        &HuffmanCode^host(counts, symbols)
    }

    ; one symbol of a code, -1 on a bad code
    procedure decode(mutable this, h: ref[HuffmanCode]) returns int
    {
        var code 0
        var first 0
        var index 0
        var len 1
        while len < 16
        {
            let bit this.bits(1)
            if failed
                return 0 - 1
            code := code | bit
            let count h.counts[len as size_t]
            if (code - count) < first
                return h.symbols[(index + (code - first)) as size_t]
            index := index + count
            first := (first + count) << 1
            code := code << 1
            len := len + 1
        }
        this.failed := true
        0 - 1
    }

    procedure fixed(mutable this)
    {
        let lengths &Array[int]()
        var s 0
        while s < 288
        {
            if s < 144
                lengths.add(8)
            else
            {
                if s < 256
                    lengths.add(9)
                else
                {
                    if s < 280
                        lengths.add(7)
                    else
                        lengths.add(8)
                }
            }
            s := s + 1
        }
        let distances &Array[int]()
        var d 0
        while d < 30
        {
            distances.add(5)
            d := d + 1
        }
        this.codes(this.code_of(lengths), this.code_of(distances))
    }

    procedure dynamic(mutable this)
    {
        let literal_count this.bits(5) + 257
        let distance_count this.bits(5) + 1
        let length_count this.bits(4) + 4
        if failed
            return
        let order &Array[int]()
        order.add(16)
        order.add(17)
        order.add(18)
        order.add(0)
        order.add(8)
        order.add(7)
        order.add(9)
        order.add(6)
        order.add(10)
        order.add(5)
        order.add(11)
        order.add(4)
        order.add(12)
        order.add(3)
        order.add(13)
        order.add(2)
        order.add(14)
        order.add(1)
        order.add(15)
        let code_lengths &Array[int]()
        var z 0
        while z < 19
        {
            code_lengths.add(0)
            z := z + 1
        }
        var i 0
        while i < length_count
        {
            code_lengths.put(order[i as size_t] as size_t, this.bits(3))
            i := i + 1
        }
        if failed
            return
        let length_code this.code_of(code_lengths)
        let lengths &Array[int]()
        let total literal_count + distance_count
        while (lengths.get_length() as int) < total
        {
            let symbol this.decode(length_code)
            if failed
                return
            if symbol < 16
                lengths.add(symbol)
            else
            {
                var repeat_value 0
                var repeat_count 0
                if symbol = 16
                {
                    if lengths.get_length() = 0
                    {
                        this.failed := true
                        return
                    }
                    repeat_value := lengths[lengths.get_length() - 1]
                    repeat_count := 3 + this.bits(2)
                }
                if symbol = 17
                    repeat_count := 3 + this.bits(3)
                if symbol = 18
                    repeat_count := 11 + this.bits(7)
                var r 0
                while r < repeat_count
                {
                    lengths.add(repeat_value)
                    r := r + 1
                }
            }
        }
        let literal_lengths &Array[int]()
        let distance_lengths &Array[int]()
        var k 0
        while k < total
        {
            if k < literal_count
                literal_lengths.add(lengths[k as size_t])
            else
                distance_lengths.add(lengths[k as size_t])
            k := k + 1
        }
        this.codes(this.code_of(literal_lengths), this.code_of(distance_lengths))
    }

    ; the literal/length and distance symbols of a Huffman block
    procedure codes(mutable this, literal: ref[HuffmanCode], distance: ref[HuffmanCode])
    {
        repeat
        {
            let symbol this.decode(literal)
            if failed
                return
            if symbol < 256
                out.add(symbol as char)
            else
            {
                if symbol = 256
                    return
                let li symbol - 257
                if li >= 29
                {
                    this.failed := true
                    return
                }
                let length Inflate.length_base(li) + this.bits(Inflate.length_extra(li))
                let ds this.decode(distance)
                if failed
                    return
                if ds >= 30
                {
                    this.failed := true
                    return
                }
                let dist Inflate.distance_base(ds) + this.bits(Inflate.distance_extra(ds))
                if failed
                    return
                let start (out.get_length() as int) - dist
                if start < 0
                {
                    this.failed := true
                    return
                }
                var c 0
                while c < length
                {
                    let byte out[(start + c) as size_t]
                    out.add(byte)
                    c := c + 1
                }
            }
        }
    }

    function length_base(i: int) returns int
    {
        if i < 8
            return 3 + i
        if i = 28
            return 258
        let extra (i - 4) / 4
        let group (i - 4) % 4
        ((4 + group) << extra) + 3
    }

    function length_extra(i: int) returns int
    {
        if (i < 8) or (i = 28)
            return 0
        (i - 4) / 4
    }

    function distance_base(i: int) returns int
    {
        if i < 4
            return 1 + i
        let extra (i - 2) / 2
        ((2 + ((i - 2) % 2)) << extra) + 1
    }

    function distance_extra(i: int) returns int
    {
        if i < 4
            return 0
        (i - 2) / 2
    }
}
