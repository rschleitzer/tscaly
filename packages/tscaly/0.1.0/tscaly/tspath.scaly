; SPDX-License-Identifier: Apache-2.0
;
; tspath — the sliver of internal/tspath the PARSER asks for, and nothing else.
;
; The reference's parser imports a whole path package and calls exactly one
; thing out of it:
;
;     isDeclarationFile := tspath.IsDeclarationFileName(p.opts.FileName)
;     if isDeclarationFile { p.contextFlags |= ast.NodeFlagsAmbient }
;
; That is the entire relationship between a file's NAME and its parse, and it is
; why this module exists rather than the test program answering the question for
; itself: a port whose parser cannot tell a declaration file from an
; implementation file has not ported the parser, it has ported the parser's
; body. §3.5a is the same argument seen from the other side — export the
; QUESTION.
;
; ★ SINCE SLICE 19 IT ANSWERS A SECOND QUESTION about the same argument, and
; upstream keeps that one in `core` rather than in `tspath`:
; `GetScriptKindFromFileName` maps an extension to a ScriptKind, which decides
; the parser's context flags (JSON files are JavaScriptFile|JsonFile), its
; language variant, and which of the two GRAMMARS ParseSourceFile dispatches to.
; It is here because it is the same question asked of the same string — a file's
; NAME as an input to its parse (§3.5ai) — and putting it in a `core` module of
; its own would be one module for one function, declared for the sake of a
; package boundary the reference draws for unrelated reasons.
;
; ★ SCOPE, stated because a partial port of a path library is exactly the kind of
; thing that silently grows. Ported: GetDeclarationFileExtension's two arms, the
; part of GetBaseFileName that answers "where does the last path component
; begin", and — since slice 28 — GetRootLength with every one of its arms
; (POSIX, UNC, DOS volume, `^/`, URL), CombinePaths for the one shape its only
; caller uses, GetNormalizedAbsolutePath and RemoveFileExtension. NOT ported:
; NormalizeSlashes as a standalone rewrite (it happens while COPYING into the
; buffer the combine needs anyway, and `\` → `/` is length-preserving) and the
; Path type's method wrappers.
;
; ★★★ AND THE PARAGRAPH THAT USED TO STAND HERE EXPIRED WITH SLICE 28, in the
; direction §3.5p says these things usually get paid: it said ABSOLUTE versus
; RELATIVE cannot change the answer, so GetNormalizedAbsolutePath was not here
; "although the reference's own oracle calls it", because every question this
; module was asked was asked of the last component alone. That stopped being true
; the moment the binder named a module symbol after the WHOLE path. The two sides
; no longer merely have to agree in spite of being handed different strings —
; they are handed the same string, and our dumper computes it the way the
; reference's main() does. See the absolute-path section at the bottom.

use scaly.memory.Page
use scaly.containers.String

; The index at which the last path component begins — GetBaseFileName's answer,
; as an OFFSET rather than as a String. The base is a RANGE of the name, and
; every question asked of it below is a byte comparison, so copying it out would
; be an allocation bought for nothing.
function base_start(path: String) returns int
{
    var i path.get_length() as int
    while i > 0
    {
        let c path.get((i - 1) as size_t) as int
        if c = ("/" as char) as int
            return i
        if c = ("\\" as char) as int
            return i
        set i: i - 1
    }
    0
}

; strings.HasSuffix(base, suffix), where `base` is the range [start, end) of
; `path` and `suffix` is an ASCII literal.
function base_has_suffix(path: String, start: int, suffix: Slice[char]) returns bool
{
    let slen suffix.length as int

    let plen path.get_length() as int
    if plen - start < slen
        return false

    var i 0
    while i < slen
    {
        if (path.get((plen - slen + i) as size_t) as int) <> (suffix[i] as int)
            return false
        set i: i + 1
    }
    true
}

; strings.Index(base, ".d.") >= 0 — asked of the BASE, never of the whole path,
; which is the only reason base_start has to exist at all. A directory component
; spelled `types.d.v1/` would otherwise make every plain `.ts` file under it a
; declaration file.
function base_contains_dot_d(path: String, start: int) returns bool
{
    let plen path.get_length() as int
    var i start
    while i + 2 < plen
    {
        if (path.get(i as size_t) as int) = ("." as char) as int
            if (path.get((i + 1) as size_t) as int) = ("d" as char) as int
                if (path.get((i + 2) as size_t) as int) = ("." as char) as int
                    return true
        set i: i + 1
    }
    false
}

; IsDeclarationFileName = GetDeclarationFileExtension(fileName) != "".
;
; Two arms, and the second is not decoration: a base that merely ENDS in `.ts`
; and contains `.d.` anywhere is a declaration file too, which is what makes
; `index.d.v1.ts` one. SupportedDeclarationExtensions is the first arm's list, in
; the reference's own order.
function is_declaration_file_name(file_name: String) returns bool
{
    let start base_start(file_name)

    if base_has_suffix(file_name, start, ".d.ts")
        return true
    if base_has_suffix(file_name, start, ".d.cts") or base_has_suffix(file_name, start, ".d.mts")
        return true

    if base_has_suffix(file_name, start, ".ts")
        return base_contains_dot_d(file_name, start)

    false
}

; ── the script kind ─────────────────────────────────────────────────────────
;
; core.ScriptKind, with the reference's own ordinal values — they are an `iota`
; run upstream, and nothing here depends on the numbers except that our two
; sides agree about which is which.
define ScriptKindUnknown:  int 0
define ScriptKindJS:       int 1
define ScriptKindJSX:      int 2
define ScriptKindTS:       int 3
define ScriptKindTSX:      int 4
define ScriptKindExternal: int 5
define ScriptKindJSON:     int 6
define ScriptKindDeferred: int 7

; core.GetScriptKindFromFileName, arm for arm. The reference lowercases the
; extension before switching, so `A.JSON` is JSON; `ext_equals` does the
; comparison case-insensitively rather than building a lowered copy.
;
; ★ The reference takes the extension from the LAST dot in the whole path
; (`strings.LastIndex(fileName, ".")`), not from the base name — so a file with
; no dot in its own base but a dotted DIRECTORY above it takes the directory's
; extension. That is upstream's behaviour and it is transcribed rather than
; corrected: this port has no licence to be more right than the parser it is
; being compared against.
function last_dot(path: String) returns int
{
    var i path.get_length() as int
    while i > 0
    {
        if (path.get((i - 1) as size_t) as int) = ("." as char) as int
            return i - 1
        set i: i - 1
    }
    0 - 1
}

; strings.ToLower(fileName[dotPos:]) == ext, for an ASCII literal `ext` that is
; already lower case.
function ext_equals(path: String, dot: int, ext: Slice[char]) returns bool
{
    let plen path.get_length() as int
    let elen ext.length as int
    if (dot + elen) <> plen
        return false
    var i 0
    while i < elen
    {
        var c path.get((dot + i) as size_t) as int
        if (c >= ("A" as char) as int) and (c <= ("Z" as char) as int)
            set c: c + (("a" as char) as int - ("A" as char) as int)
        if c <> (ext[i] as int)
            return false
        set i: i + 1
    }
    true
}

; tspath.FileExtensionIs, and FileExtensionIsOneOf over the two extensions slice
; 100's arrow-function grammar check names. ★It is a SUFFIX test on the whole
; path and it is CASE SENSITIVE, unlike ext_equals above — `strings.HasSuffix`,
; not a lowered compare — so `a.MTS` is not one. That asymmetry is upstream's and
; is transcribed rather than tidied.
function file_extension_is(path: String, ext: Slice[char]) returns bool
{
    let plen path.get_length() as int
    let elen ext.length as int
    if plen <= elen
        return false
    var i 0
    while i < elen
    {
        if (path.get((plen - elen + i) as size_t) as int) <> (ext[i] as int)
            return false
        set i: i + 1
    }
    true
}

function file_extension_is_mts_or_cts(file_name: String) returns bool
{
    if file_extension_is(file_name, ".mts")
        return true
    file_extension_is(file_name, ".cts")
}

function script_kind_from_file_name(file_name: String) returns int
{
    let dot last_dot(file_name)
    if dot < 0
        return ScriptKindUnknown

    if ext_equals(file_name, dot, ".js")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".cjs")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".mjs")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".jsx")
        return ScriptKindJSX
    if ext_equals(file_name, dot, ".ts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".cts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".mts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".tsx")
        return ScriptKindTSX
    if ext_equals(file_name, dot, ".json")
        return ScriptKindJSON

    ScriptKindUnknown
}

; getLanguageVariant(scriptKind) — and the arm that is worth reading twice is
; JSON's. The reference answers LanguageVariantJSX for TSX, JSX, **JS** and
; **JSON**, so the variant is not "this file contains JSX": it is the set of
; kinds whose scan admits `</` as one token. A `.json` file is scanned under it.
function language_variant_is_jsx(script_kind: int) returns bool
{
    if script_kind = ScriptKindTSX or script_kind = ScriptKindJSX or script_kind = ScriptKindJS
        return true
    script_kind = ScriptKindJSON
}

; ── the ABSOLUTE, NORMALIZED path ───────────────────────────────────────────
;
; The header above says GetNormalizedAbsolutePath is not here because ABSOLUTE
; versus RELATIVE cannot change the answer, and that was true of every question
; this module was asked until slice 28: the BINDER names an external module's
; symbol `"` + RemoveFileExtension(file.FileName()) + `"`, so the symbol our dump
; prints IS the file name the caller handed the parse, byte for byte. The
; reference's own oracle — like tsc — hands it GetNormalizedAbsolutePath(arg,
; cwd), so ours has to compute the same string from the same two inputs or every
; module symbol differs in a way the other three yardsticks cannot see. §3.5ai
; one phase on: the file's NAME was an input to its parse, and now its whole TEXT
; is an input to the bind.
;
; ★★★ THE ROUTE IS THE REFERENCE'S OWN SECOND ONE, AND THE EQUIVALENCE IS
; MEASURED RATHER THAN ASSERTED (§3.5ag). Upstream has two implementations of
; this normalisation: the optimized `GetNormalizedAbsolutePath`, ~110 lines of
; in-place string surgery around a `simpleNormalizePath` fast path, and the
; components route `GetPathFromPathComponents(GetNormalizedPathComponents(path,
; cwd))`, which is two short loops. This module transcribes the SECOND, because
; the first's fast path is an allocation optimisation for a garbage collector and
; its slow path threads five mutually dependent locals through one loop — a port
; of it would be a port of the optimisation. Proof that the choice is not a
; deviation: a throwaway Go program in the submodule ran both routes over 49 hand
; edge cases × 13 working directories plus 400 000 randomised paths drawn from an
; alphabet covering every shape the root scanner distinguishes (POSIX, UNC, DOS
; volume, `^/`, `file://`, `http://`, doubled and trailing separators, `.` and
; `..` including above the root) — 400 624 comparisons, **0 differences** — and
; was then removed, leaving the submodule clean. A second PRODUCER is what a
; claim about strings needs.
;
; ★ Go's `^x` (bitwise complement) has no spelling in Scaly, and
; GetEncodedRootLength's negative return values are written with it. `^x` is
; `-x-1` for any int, so the two sites that produce one write `0 - (x + 1)` and
; the one that consumes one reads it back the same way. The same wall as
; tools/gensymbolflags.py's, which resolves the SymbolFlags composites for it.

function is_volume_character(c: int) returns bool
{
    if (c >= ("a" as char) as int) and (c <= ("z" as char) as int)
        return true
    (c >= ("A" as char) as int) and (c <= ("Z" as char) as int)
}

function is_any_directory_separator(c: int) returns bool
{
    if c = ("/" as char) as int
        return true
    c = ("\\" as char) as int
}

; strings.IndexByte(d[from:], c), answered as an ABSOLUTE index or -1. The
; reference's callers add the offset back; asking absolutely is the same
; arithmetic with one fewer place to get it wrong.
function index_of_byte(d: Slice[char], from: int, c: int) returns int
{
    var i from
    while i < d.length
    {
        if (d[i] as int) = c
            return i
        set i: i + 1
    }
    0 - 1
}

; strings.Index(d, lit) — the whole path, since the only caller looks for the URL
; scheme separator and the reference asks it of the whole path too.
function index_of_literal(d: Slice[char], lit: Slice[char]) returns int
{
    let ln lit.length as int
    if ln = 0
        return 0
    var i 0
    while i + ln <= d.length
    {
        var j 0
        var same true
        while j < ln
        {
            if (d[i + j] as int) <> (lit[j] as int)
                set same: false
            set j: j + 1
        }
        if same
            return i
        set i: i + 1
    }
    0 - 1
}

; d[start:start+len] == lit, for an ASCII literal.
function range_equals(d: Slice[char], start: int, len: int, lit: Slice[char]) returns bool
{
    let ln lit.length as int
    if ln <> len
        return false
    var i 0
    while i < ln
    {
        if (d[start + i] as int) <> (lit[i] as int)
            return false
        set i: i + 1
    }
    true
}

; getFileUrlVolumeSeparatorEnd, arm for arm — the `:` and the percent-encoded
; `%3a` spelling of it.
function file_url_volume_separator_end(d: Slice[char], start: int) returns int
{
    if d.length <= start
        return 0 - 1
    let ch0 (d[start] as int)
    if ch0 = (":" as char) as int
        return start + 1
    if ch0 = ("%" as char) as int
    {
        if d.length > start + 2
        {
            if (d[start + 1] as int) = ("3" as char) as int
            {
                let ch2 (d[start + 2] as int)
                if ch2 = ("a" as char) as int
                    return start + 3
                if ch2 = ("A" as char) as int
                    return start + 3
            }
        }
    }
    0 - 1
}

; GetEncodedRootLength. Every arm of the reference's is here, including the ones
; no path this harness produces can reach: an approximation is a wrong answer
; waiting for a reader (§3.5bw), and this one would be read by module resolution
; the day it is ported.
function get_encoded_root_length(d: Slice[char]) returns int
{
    if d.length = 0
        return 0
    let ch0 (d[0] as int)

    ; POSIX or UNC
    if is_any_directory_separator(ch0)
    {
        if d.length = 1
            return 1
        if (d[1] as int) <> ch0
            return 1                          ; POSIX: "/" (or non-normalized "\")
        let p1 index_of_byte(d, 2, ch0)
        if p1 < 0
            return d.length                          ; UNC: "//server" or "\\server"
        return p1 + 1                         ; UNC: "//server/" or "\\server\"
    }

    ; DOS
    if is_volume_character(ch0)
    {
        if d.length > 1
        {
            if (d[1] as int) = (":" as char) as int
            {
                if d.length = 2
                    return 2                  ; DOS: "c:" (but not "c:d")
                if is_any_directory_separator(d[2] as int)
                    return 3                  ; DOS: "c:/" or "c:\"
            }
        }
    }

    ; Untitled paths, e.g. "^/untitled/ts-nul-authority/Untitled-1"
    if ch0 = ("^" as char) as int
    {
        if d.length > 1
        {
            if (d[1] as int) = ("/" as char) as int
                return 2
        }
    }

    ; URL
    let scheme_end index_of_literal(d, "://")
    if scheme_end >= 0
    {
        let authority_start scheme_end + 3
        let authority_end index_of_byte(d, authority_start, ("/" as char) as int)
        if authority_end < 0
            return 0 - (d.length + 1)                ; URL: "file://server", "http://server"

        ; For a local `file` URL, include the leading DOS volume when there is
        ; one — an authority of "" or "localhost" both mean this machine.
        if range_equals(d, 0, scheme_end, "file")
        {
            var local false
            if authority_end = authority_start
                set local: true
            if range_equals(d, authority_start, authority_end - authority_start, "localhost")
                set local: true
            if local
            {
                if d.length > authority_end + 2
                {
                    if is_volume_character(d[authority_end + 1] as int)
                    {
                        let vse file_url_volume_separator_end(d, authority_end + 2)
                        if vse >= 0
                        {
                            if vse = d.length
                                return 0 - (vse + 1)
                            if (d[vse] as int) = ("/" as char) as int
                                return 0 - (vse + 2)
                        }
                    }
                }
            }
        }
        return 0 - (authority_end + 2)
    }

    0                                         ; relative
}

function get_root_length(d: Slice[char]) returns int
{
    let r get_encoded_root_length(d)
    if r < 0
        return 0 - (r + 1)
    r
}

; IsRootedDiskPath, PathIsRelative and IsExternalModuleNameRelative, slice 58 —
; the three-line stack the checker asks of a module SPECIFIER, not of a file
; name. Its one reader is checkExternalImportOrExportDeclaration, which uses the
; answer to decide whether a relative specifier inside `declare module "m"` is
; the TS2439 it reports.
;
; ★ The reference's comment is worth keeping because the name misleads without
; it: `C:\foo.ts` counts as RELATIVE here — not because it is, but because an
; absolute disk path is not searched for in node_modules and is not an ambient
; module either, which is the only distinction this predicate is drawing.
function is_rooted_disk_path(d: Slice[char]) returns bool
{
    get_encoded_root_length(d) > 0
}

function path_is_relative(d: Slice[char]) returns bool
{
    ; The reference's four statements, transcribed rather than folded: `.`, `..`,
    ; a `./`-prefix and a `../`-prefix, each with its own length guard.
    if d.length = 1
    {
        if (d[0] as int) = ("." as char) as int
            return true
    }
    if d.length = 2
    {
        if (d[0] as int) = ("." as char) as int
        {
            if (d[1] as int) = ("." as char) as int
                return true
        }
    }
    if d.length >= 2
    {
        if (d[0] as int) = ("." as char) as int
        {
            if is_any_directory_separator(d[1] as int)
                return true
        }
    }
    if d.length >= 3
    {
        if (d[0] as int) = ("." as char) as int
        {
            if (d[1] as int) = ("." as char) as int
            {
                if is_any_directory_separator(d[2] as int)
                    return true
            }
        }
    }
    false
}

function is_external_module_name_relative(d: Slice[char]) returns bool
{
    if path_is_relative(d)
        return true
    is_rooted_disk_path(d)
}


; NormalizeSlashes, applied while COPYING rather than as a rewrite of its own:
; every caller of it here wants the bytes in a buffer anyway, and `\` → `/` is
; length-preserving, so the copy and the replacement are one loop.
procedure copy_normalized(mutable dst: Slice[char], d: Slice[char])
{
    var i 0
    while i < d.length
    {
        var c (d[i] as int)
        if c = ("\\" as char) as int
            set c: ("/" as char) as int
        dst.put(i, c as char)
        set i: i + 1
    }
}

; CombinePaths(first, second) — the reference's is variadic, and its only caller
; here passes exactly ONE trailing path (`CombinePaths(currentDirectory,
; fileName)`), so this is that shape rather than a loop over a list nothing
; builds (§3.5aq). Answers the length and hands the buffer back through out_data.
;
; ★ Every function from here down takes a RANGE (a pointer and a length) rather
; than a String, in both directions. Two reasons, and the second is the
; load-bearing one: a Go `string` here is a slice of one buffer (§3.5bc), and a
; String's init allocates through `Page.get(this)`, so building one per
; intermediate result would put the root CLAUDE's page-hosted-init placement
; question in front of every step of a path computation. The binder wants bytes
; anyway — a Symbol's name IS a range.
function combine_paths(host: ref[Page], fd: Slice[char], sd: Slice[char]) returns Slice[char]
{
    ; `size` is an upper bound, not the answer: the separator is written only when
    ; the first path does not already end in one.
    let buf Slice[char]((fd.length + sd.length + 2) as size_t, host.allocate((fd.length + sd.length + 2) as size_t, 1) as pointer[char])
    copy_normalized(buf, fd)
    var len fd.length

    if sd.length = 0
    {
        return buf.subslice(0, len as size_t)
    }

    ; The trailing path replaces the result outright when the result is empty or
    ; the trailing path is itself rooted — which is what makes an absolute
    ; fileName ignore the working directory.
    var second_buf Slice[char]((sd.length + 1) as size_t, host.allocate((sd.length + 1) as size_t, 1) as pointer[char])
    copy_normalized(second_buf, sd)
    if len = 0
    {
        return second_buf.subslice(0, sd.length as size_t)
    }
    if get_root_length(second_buf.subslice(0, sd.length as size_t)) <> 0
    {
        return second_buf.subslice(0, sd.length as size_t)
    }

    if (buf[len - 1] as int) <> (("/" as char) as int)
    {
        buf.put(len, "/" as char)
        set len: len + 1
    }
    var i 0
    while i < sd.length
    {
        buf.put(len + i, second_buf[i])
        set i: i + 1
    }
    buf.subslice(0, len + sd.length as size_t)
}

; GetNormalizedAbsolutePath, by the components route the header argues for:
; combine with the working directory, then reduce the segments, then join them
; back. The two loops are GetNormalizedPathComponents' and
; GetPathFromPathComponents' respectively, transcribed.
;
; The components are RANGES into the combined buffer rather than strings
; (§3.5bc), which is what a Go `[]string` of slices of one string is. Their count
; is bounded by the number of separators, so the two index arrays are sized
; exactly once rather than grown.
function get_normalized_absolute_path(host: ref[Page], fd: Slice[char], wd: Slice[char]) returns Slice[char]
{
    var cd Slice[char]()
    if (get_root_length(fd) = 0) and (wd.length > 0)
        set cd: combine_paths(host, wd, fd)
    else
    {
        ; CombinePaths normalises slashes, so the other branch has to do it here.
        let buf Slice[char]((fd.length + 1) as size_t, host.allocate((fd.length + 1) as size_t, 1) as pointer[char])
        copy_normalized(buf, fd)
        set cd: buf.subslice(0, fd.length as size_t)
    }

    let root_length get_root_length(cd)

    var cap 2
    var i root_length
    while i < cd.length
    {
        if (cd[i] as int) = (("/" as char) as int)
            set cap: cap + 1
        set i: i + 1
    }
    let starts host.allocate((cap as size_t) * sizeof int, alignof int) as pointer[int]
    let lens host.allocate((cap as size_t) * sizeof int, alignof int) as pointer[int]

    ; Component 0 is the ROOT, always present and possibly empty — the reference
    ; says so in its own comment, and the join below depends on it.
    set *starts: 0
    set *lens: root_length
    var count 1

    var index root_length
    while index < cd.length
    {
        ; Skip separators: this is what folds a doubled or trailing one away.
        while index < cd.length
        {
            if (cd[index] as int) <> (("/" as char) as int)
                break
            set index: index + 1
        }
        if index >= cd.length
            break

        let start index
        while index < cd.length
        {
            if (cd[index] as int) = (("/" as char) as int)
                break
            set index: index + 1
        }
        let len index - start

        var skip false
        if len = 1
        {
            if (cd[start] as int) = (("." as char) as int)
                set skip: true
        }
        if skip = false
        {
            var is_dot_dot false
            if len = 2
            {
                if (cd[start] as int) = (("." as char) as int) and (cd[start + 1] as int) = (("." as char) as int)
                    set is_dot_dot: true
            }
            if is_dot_dot
            {
                if count > 1
                {
                    ; A `..` cancels the previous component — unless that one is a
                    ; `..` itself, in which case it stacks.
                    var prev_is_dot_dot false
                    if *(lens + count - 1) = 2
                    {
                        let ps *(starts + count - 1)
                        if (cd[ps] as int) = (("." as char) as int) and (cd[ps + 1] as int) = (("." as char) as int)
                            set prev_is_dot_dot: true
                    }
                    if prev_is_dot_dot = false
                    {
                        set count: count - 1
                        set skip: true
                    }
                }
                else
                {
                    ; Above an ABSOLUTE root there is nothing to go up to, so the
                    ; segment is dropped; a relative path keeps it.
                    if root_length <> 0
                        set skip: true
                }
            }
        }

        if skip = false
        {
            set *(starts + count): start
            set *(lens + count): len
            set count: count + 1
        }
        set index: index + 1
    }

    ; GetPathFromPathComponents: the root with a trailing separator ensured when
    ; it is not empty, then the rest joined with one separator each.
    var out_len 0
    var k 1
    while k < count
    {
        set out_len: out_len + *(lens + k)
        set k: k + 1
    }
    let buf host.allocate((root_length + count + out_len + 2) as size_t, 1) as pointer[char]
    var w 0
    var j 0
    while j < root_length
    {
        set *(buf + w): cd[j]
        set w: w + 1
        set j: j + 1
    }
    if root_length > 0
    {
        if (*(buf + w - 1) as int) <> (("/" as char) as int)
        {
            set *(buf + w): "/" as char
            set w: w + 1
        }
    }
    set k: 1
    while k < count
    {
        if k > 1
        {
            set *(buf + w): "/" as char
            set w: w + 1
        }
        let s *(starts + k)
        let l *(lens + k)
        var m 0
        while m < l
        {
            set *(buf + w): cd[s + m]
            set w: w + 1
            set m: m + 1
        }
        set k: k + 1
    }
    Slice[char](w, buf)
}

; RemoveFileExtension. It answers a LENGTH rather than a string, because every
; suffix it removes is a suffix: the caller already has the bytes and only needs
; to know how many of them belong to the name. `extensionsToRemove` is the
; reference's own list IN ITS ORDER, and the order is load-bearing — `.d.ts`
; before `.ts`, so `a.d.ts` loses five bytes and not three.
function has_suffix(d: Slice[char], suffix: Slice[char]) returns int
{
    let sl suffix.length as int
    if d.length < sl
        return 0 - 1
    var i 0
    while i < sl
    {
        if (d[d.length - sl + i] as int) <> (suffix[i] as int)
            return 0 - 1
        set i: i + 1
    }
    d.length - sl
}

function remove_file_extension(d: Slice[char]) returns int
{
    var r has_suffix(d, ".d.ts")
    if r >= 0
        return r
    set r: has_suffix(d, ".d.mts")
    if r >= 0
        return r
    set r: has_suffix(d, ".d.cts")
    if r >= 0
        return r
    set r: has_suffix(d, ".mjs")
    if r >= 0
        return r
    set r: has_suffix(d, ".mts")
    if r >= 0
        return r
    set r: has_suffix(d, ".cjs")
    if r >= 0
        return r
    set r: has_suffix(d, ".cts")
    if r >= 0
        return r
    set r: has_suffix(d, ".ts")
    if r >= 0
        return r
    set r: has_suffix(d, ".js")
    if r >= 0
        return r
    set r: has_suffix(d, ".tsx")
    if r >= 0
        return r
    set r: has_suffix(d, ".jsx")
    if r >= 0
        return r
    set r: has_suffix(d, ".json")
    if r >= 0
        return r
    d.length
}

; ── the program boundary ────────────────────────────────────────────────────
;
; A concept whose only members are statics over the functions above, and it exists
; for a Scaly reason rather than a design one: a program ROOT cannot call a
; cross-package FREE function that takes a concept pointer, and `pointer[Page]` is
; one (root CLAUDE.md), while a concept STATIC resolves. The caller is the DUMPER,
; which is this port's `main()` and therefore the place the reference's own
; main() asks the same question of the same two strings.
; ── the path helpers the source-map generator asks for (slice 247) ──
; tspath: NormalizeSlashes, HasTrailingDirectorySeparator, RemoveTrailingDirectorySeparator,
; EnsureTrailingDirectorySeparator, GetDirectoryPath, GetBaseFileName, GetPathComponents,
; reducePathComponents, GetPathComponentsRelativeTo, GetPathFromPathComponents,
; GetRelativePathToDirectoryOrUrl; stringutil.EncodeURI. Every answer that is not a
; view into its input is copied onto `host`.

function slice_copy_on(host: ref[Page], d: Slice[char]) returns Slice[char]
{
    let buf Slice[char]((d.length + 1) as size_t, host.allocate((d.length + 1) as size_t, 1) as pointer[char])
    var i 0
    while i < (d.length as int)
    {
        buf.put(i as size_t, d[i as size_t])
        set i: i + 1
    }
    buf.subslice(0, d.length as size_t)
}

function normalize_slashes(host: ref[Page], d: Slice[char]) returns Slice[char]
{
    var has_backslash false
    var i 0
    while i < (d.length as int)
    {
        if (d[i as size_t] as int) = ("\\" as char) as int
            set has_backslash: true
        set i: i + 1
    }
    if has_backslash = false
        return d
    let buf Slice[char]((d.length + 1) as size_t, host.allocate((d.length + 1) as size_t, 1) as pointer[char])
    copy_normalized(buf, d)
    buf.subslice(0, d.length as size_t)
}

function has_trailing_directory_separator(d: Slice[char]) returns bool
{
    if d.length = 0
        return false
    is_any_directory_separator(d[(d.length - 1) as size_t] as int)
}

function remove_trailing_directory_separator(d: Slice[char]) returns Slice[char]
{
    if has_trailing_directory_separator(d)
        return d.subslice(0, (d.length - 1) as size_t)
    d
}

function ensure_trailing_directory_separator(host: ref[Page], d: Slice[char]) returns Slice[char]
{
    if has_trailing_directory_separator(d)
        return d
    let buf Slice[char]((d.length + 2) as size_t, host.allocate((d.length + 2) as size_t, 1) as pointer[char])
    copy_normalized(buf, d)
    buf.put(d.length as size_t, "/" as char)
    buf.subslice(0, (d.length + 1) as size_t)
}

function last_slash_index(d: Slice[char]) returns int
{
    var i (d.length as int) - 1
    while i >= 0
    {
        if (d[i as size_t] as int) = ("/" as char) as int
            return i
        set i: i - 1
    }
    0 - 1
}

; GetDirectoryPath: the path up to its last (non-terminal) separator, the root at least
function get_directory_path(host: ref[Page], d: Slice[char]) returns Slice[char]
{
    let p normalize_slashes(host, d)
    let root_length get_root_length(p)
    if root_length = (p.length as int)
        return p
    let q remove_trailing_directory_separator(p)
    var cut last_slash_index(q)
    if cut < root_length
        set cut: root_length
    q.subslice(0, cut as size_t)
}

; GetBaseFileName: the portion after the last (non-terminal) separator
function get_base_file_name(host: ref[Page], d: Slice[char]) returns Slice[char]
{
    let p normalize_slashes(host, d)
    let root_length get_root_length(p)
    if root_length = (p.length as int)
        return Slice[char]()
    let q remove_trailing_directory_separator(p)
    var from last_slash_index(q) + 1
    let rl get_root_length(q)
    if from < rl
        set from: rl
    q.subslice(from as size_t, q.length as size_t)
}

; GetPathComponents: the root, then every segment (a trailing empty one dropped)
function get_path_components(host: ref[Page], d: Slice[char], current_directory: Slice[char]) returns ref[Array[Slice[char]]]
{
    let path combine_paths(host, current_directory, d)
    let root_length get_root_length(path)
    let out &Array[Slice[char]]^host()
    out.add(path.subslice(0, root_length as size_t))
    var start root_length
    var i root_length
    let n path.length as int
    while i <= n
    {
        if (i = n) or ((path[i as size_t] as int) = ("/" as char) as int)
        {
            out.add(path.subslice(start as size_t, i as size_t))
            set start: i + 1
        }
        set i: i + 1
    }
    ; a trailing separator yields an empty last segment the reference drops
    var drop_last false
    if out.get_length() > 1
    {
        let last out[(out.get_length() - 1) as size_t]
        if last.length = 0
            set drop_last: true
    }
    if drop_last
    {
        let trimmed &Array[Slice[char]]^host()
        var j 0
        while j < ((out.get_length() as int) - 1)
        {
            trimmed.add(out[j as size_t])
            set j: j + 1
        }
        return trimmed
    }
    out
}

; reducePathComponents: `.` and empty segments dropped, `..` folded
function reduce_path_components(host: ref[Page], components: ref[Array[Slice[char]]]) returns ref[Array[Slice[char]]]
{
    let reduced &Array[Slice[char]]^host()
    if components.get_length() = 0
        return reduced
    reduced.add(components[0])
    var i 1
    while i < (components.get_length() as int)
    {
        let component components[i as size_t]
        set i: i + 1
        if component.length = 0
            continue
        if component.equals(".")
            continue
        if component.equals("..")
        {
            if reduced.get_length() > 1
            {
                let last reduced[(reduced.get_length() - 1) as size_t]
                if last.equals("..") = false
                {
                    ; drop the last (an Array does not shrink; rebuild)
                    let shorter &Array[Slice[char]]()
                    var j 0
                    while j < ((reduced.get_length() as int) - 1)
                    {
                        shorter.add(reduced[j as size_t])
                        set j: j + 1
                    }
                    reduced.clear()
                    set j: 0
                    while j < (shorter.get_length() as int)
                    {
                        reduced.add(shorter[j as size_t])
                        set j: j + 1
                    }
                    continue
                }
            }
            else
            {
                let first reduced[0]
                if first.length <> 0
                    continue
            }
        }
        reduced.add(component)
    }
    reduced
}

function slices_equal_case_insensitive(a: Slice[char], b: Slice[char]) returns bool
{
    if a.length <> b.length
        return false
    var i 0
    while i < (a.length as int)
    {
        var ca a[i as size_t] as int
        var cb b[i as size_t] as int
        if (ca >= ("A" as char) as int) and (ca <= ("Z" as char) as int)
            set ca: ca + 32
        if (cb >= ("A" as char) as int) and (cb <= ("Z" as char) as int)
            set cb: cb + 32
        if ca <> cb
            return false
        set i: i + 1
    }
    true
}

; GetPathComponentsRelativeTo (case-sensitive file names): the shared prefix
; dropped, `..` for what remains of `from`, then the rest of `to`
function get_path_components_relative_to(host: ref[Page], from: Slice[char], to: Slice[char], current_directory: Slice[char]) returns ref[Array[Slice[char]]]
{
    let from_components reduce_path_components(host, get_path_components(host, from, current_directory))
    let to_components reduce_path_components(host, get_path_components(host, to, current_directory))
    var start 0
    var max_common from_components.get_length() as int
    if (to_components.get_length() as int) < max_common
        set max_common: to_components.get_length() as int
    while start < max_common
    {
        let fc from_components[start as size_t]
        let tc to_components[start as size_t]
        if start = 0
        {
            if slices_equal_case_insensitive(fc, tc) = false
                break
        }
        else
        {
            if fc.equals(tc) = false
                break
        }
        set start: start + 1
    }
    if start = 0
        return to_components
    let result &Array[Slice[char]]^host()
    result.add(Slice[char]())
    var d start
    while d < (from_components.get_length() as int)
    {
        let dots: Slice[char] ".."
        result.add(dots)
        set d: d + 1
    }
    var t start
    while t < (to_components.get_length() as int)
    {
        result.add(to_components[t as size_t])
        set t: t + 1
    }
    result
}

; GetPathFromPathComponents: the root (with its separator) then the segments joined by `/`
function get_path_from_path_components(host: ref[Page], components: ref[Array[Slice[char]]]) returns Slice[char]
{
    if components.get_length() = 0
        return Slice[char]()
    var size 1
    var i 0
    while i < (components.get_length() as int)
    {
        let ci components[i as size_t]
        set size: size + (ci.length as int) + 1
        set i: i + 1
    }
    let buf Slice[char](size as size_t, host.allocate(size as size_t, 1) as pointer[char])
    var len 0
    let root components[0]
    var r 0
    while r < (root.length as int)
    {
        buf.put(len as size_t, root[r as size_t])
        set len: len + 1
        set r: r + 1
    }
    if (root.length > 0) and (has_trailing_directory_separator(root) = false)
    {
        buf.put(len as size_t, "/" as char)
        set len: len + 1
    }
    set i: 1
    while i < (components.get_length() as int)
    {
        if i > 1
        {
            buf.put(len as size_t, "/" as char)
            set len: len + 1
        }
        let c components[i as size_t]
        var k 0
        while k < (c.length as int)
        {
            buf.put(len as size_t, c[k as size_t])
            set len: len + 1
            set k: k + 1
        }
        set i: i + 1
    }
    buf.subslice(0, len as size_t)
}

; GetRelativePathToDirectoryOrUrl: an absolute answer becomes a file:// URL when asked
procedure get_relative_path_to_directory_or_url(host: ref[Page], mutable directory_path_or_url: Slice[char], mutable relative_or_absolute_path: Slice[char], is_absolute_path_an_url: bool, mutable current_directory: Slice[char]) returns Slice[char]
{
    let components get_path_components_relative_to(host, directory_path_or_url, relative_or_absolute_path, current_directory)
    let first components[0]
    if is_absolute_path_an_url and is_rooted_disk_path(first)
    {
        var prefix: Slice[char] "file:///"
        if (first[0] as int) = ("/" as char) as int
        {
            let short: Slice[char] "file://"
            set prefix: short
        }
        components.put(0, combine_prefix(host, prefix, first))
    }
    get_path_from_path_components(host, components)
}

function combine_prefix(host: ref[Page], prefix: Slice[char], rest: Slice[char]) returns Slice[char]
{
    let n (prefix.length + rest.length) as int
    let buf Slice[char]((n + 1) as size_t, host.allocate((n + 1) as size_t, 1) as pointer[char])
    var i 0
    while i < (prefix.length as int)
    {
        buf.put(i as size_t, prefix[i as size_t])
        set i: i + 1
    }
    var j 0
    while j < (rest.length as int)
    {
        buf.put((i + j) as size_t, rest[j as size_t])
        set j: j + 1
    }
    buf.subslice(0, n as size_t)
}

; stringutil.EncodeURI: everything but the unreserved and reserved sets percent-encoded
function encode_uri_keeps(b: int) returns bool
{
    if (b >= ("A" as char) as int) and (b <= ("Z" as char) as int)
        return true
    if (b >= ("a" as char) as int) and (b <= ("z" as char) as int)
        return true
    if (b >= ("0" as char) as int) and (b <= ("9" as char) as int)
        return true
    let keep: Slice[char] "-_.!~*'();/?:@&=+$,#"
    var i 0
    while i < (keep.length as int)
    {
        if (keep[i as size_t] as int) = b
            return true
        set i: i + 1
    }
    false
}

function encode_uri(host: ref[Page], s: Slice[char]) returns Slice[char]
{
    var needs false
    var i 0
    while i < (s.length as int)
    {
        if encode_uri_keeps((s[i as size_t] as int) & 255) = false
            set needs: true
        set i: i + 1
    }
    if needs = false
        return s
    let size (s.length as int) * 3 + 1
    let buf Slice[char](size as size_t, host.allocate(size as size_t, 1) as pointer[char])
    let hex: Slice[char] "0123456789ABCDEF"
    var len 0
    set i: 0
    while i < (s.length as int)
    {
        let b (s[i as size_t] as int) & 255
        if encode_uri_keeps(b)
        {
            buf.put(len as size_t, b as char)
            set len: len + 1
        }
        else
        {
            buf.put(len as size_t, "%" as char)
            buf.put((len + 1) as size_t, hex[(b >> 4) as size_t])
            buf.put((len + 2) as size_t, hex[(b & 15) as size_t])
            set len: len + 3
        }
        set i: i + 1
    }
    buf.subslice(0, len as size_t)
}

define TsPath
{
    function normalized_absolute_path(host: ref[Page], fd: Slice[char], wd: Slice[char]) returns Slice[char]
        get_normalized_absolute_path(host, fd, wd)

    function directory_of(host: ref[Page], path: Slice[char]) returns Slice[char]
        get_directory_path(host, path)
}
