; SPDX-License-Identifier: Apache-2.0
;
; tspath — the sliver of internal/tspath the PARSER asks for, and nothing else.
;
; The reference's parser imports a whole path package and calls exactly one
; thing out of it:
;
;     isDeclarationFile := tspath.IsDeclarationFileName(p.opts.FileName)
;     if isDeclarationFile { p.contextFlags |= ast.NodeFlagsAmbient }
;
; That is the entire relationship between a file's NAME and its parse, and it is
; why this module exists rather than the test program answering the question for
; itself: a port whose parser cannot tell a declaration file from an
; implementation file has not ported the parser, it has ported the parser's
; body. §3.5a is the same argument seen from the other side — export the
; QUESTION.
;
; ★ SINCE SLICE 19 IT ANSWERS A SECOND QUESTION about the same argument, and
; upstream keeps that one in `core` rather than in `tspath`:
; `GetScriptKindFromFileName` maps an extension to a ScriptKind, which decides
; the parser's context flags (JSON files are JavaScriptFile|JsonFile), its
; language variant, and which of the two GRAMMARS ParseSourceFile dispatches to.
; It is here because it is the same question asked of the same string — a file's
; NAME as an input to its parse (§3.5ai) — and putting it in a `core` module of
; its own would be one module for one function, declared for the sake of a
; package boundary the reference draws for unrelated reasons.
;
; ★ SCOPE, stated because a partial port of a path library is exactly the kind of
; thing that silently grows. Ported: GetDeclarationFileExtension's two arms and
; the part of GetBaseFileName that answers "where does the last path component
; begin". NOT ported: NormalizeSlashes as a rewrite, GetRootLength (drive
; letters, UNC prefixes, URL schemes) and RemoveTrailingDirectorySeparator. What
; those handle is a path that IS a root, or one ending in a separator — neither
; is a file name, and `IsDeclarationFileName` of one is false either way, which
; is what this module answers for them. Both separators ARE recognised, because
; upstream's NormalizeSlashes makes `\` one on every target before the base is
; taken.
;
; ★ And ABSOLUTE versus RELATIVE cannot change the answer, which is why
; GetNormalizedAbsolutePath is not here although the reference's own oracle calls
; it: the question is asked of the last component alone. The two yardsticks feed
; our dumper a relative path and the reference's an absolute one, and they must
; still agree — that they do is a property of this file.

use scaly.containers.String

; The index at which the last path component begins — GetBaseFileName's answer,
; as an OFFSET rather than as a String. The base is a RANGE of the name, and
; every question asked of it below is a byte comparison, so copying it out would
; be an allocation bought for nothing.
function base_start(path: String) returns int
{
    var i path.get_length() as int
    while i > 0
    {
        let c path.get((i - 1) as size_t) as int
        if c = ("/" as char) as int
            return i
        if c = ("\\" as char) as int
            return i
        set i: i - 1
    }
    0
}

; strings.HasSuffix(base, suffix), where `base` is the range [start, end) of
; `path` and `suffix` is an ASCII literal.
function base_has_suffix(path: String, start: int, suffix: pointer[const_char]) returns bool
{
    var slen 0
    while (*(suffix + slen) as int) <> 0
        set slen: slen + 1

    let plen path.get_length() as int
    if plen - start < slen
        return false

    var i 0
    while i < slen
    {
        if (path.get((plen - slen + i) as size_t) as int) <> (*(suffix + i) as int)
            return false
        set i: i + 1
    }
    true
}

; strings.Index(base, ".d.") >= 0 — asked of the BASE, never of the whole path,
; which is the only reason base_start has to exist at all. A directory component
; spelled `types.d.v1/` would otherwise make every plain `.ts` file under it a
; declaration file.
function base_contains_dot_d(path: String, start: int) returns bool
{
    let plen path.get_length() as int
    var i start
    while i + 2 < plen
    {
        if (path.get(i as size_t) as int) = ("." as char) as int
            if (path.get((i + 1) as size_t) as int) = ("d" as char) as int
                if (path.get((i + 2) as size_t) as int) = ("." as char) as int
                    return true
        set i: i + 1
    }
    false
}

; IsDeclarationFileName = GetDeclarationFileExtension(fileName) != "".
;
; Two arms, and the second is not decoration: a base that merely ENDS in `.ts`
; and contains `.d.` anywhere is a declaration file too, which is what makes
; `index.d.v1.ts` one. SupportedDeclarationExtensions is the first arm's list, in
; the reference's own order.
function is_declaration_file_name(file_name: String) returns bool
{
    let start base_start(file_name)

    if base_has_suffix(file_name, start, ".d.ts")
        return true
    if base_has_suffix(file_name, start, ".d.cts")
        return true
    if base_has_suffix(file_name, start, ".d.mts")
        return true

    if base_has_suffix(file_name, start, ".ts")
        return base_contains_dot_d(file_name, start)

    false
}

; ── the script kind ─────────────────────────────────────────────────────────
;
; core.ScriptKind, with the reference's own ordinal values — they are an `iota`
; run upstream, and nothing here depends on the numbers except that our two
; sides agree about which is which.
define ScriptKindUnknown:  int 0
define ScriptKindJS:       int 1
define ScriptKindJSX:      int 2
define ScriptKindTS:       int 3
define ScriptKindTSX:      int 4
define ScriptKindExternal: int 5
define ScriptKindJSON:     int 6
define ScriptKindDeferred: int 7

; core.GetScriptKindFromFileName, arm for arm. The reference lowercases the
; extension before switching, so `A.JSON` is JSON; `ext_equals` does the
; comparison case-insensitively rather than building a lowered copy.
;
; ★ The reference takes the extension from the LAST dot in the whole path
; (`strings.LastIndex(fileName, ".")`), not from the base name — so a file with
; no dot in its own base but a dotted DIRECTORY above it takes the directory's
; extension. That is upstream's behaviour and it is transcribed rather than
; corrected: this port has no licence to be more right than the parser it is
; being compared against.
function last_dot(path: String) returns int
{
    var i path.get_length() as int
    while i > 0
    {
        if (path.get((i - 1) as size_t) as int) = ("." as char) as int
            return i - 1
        set i: i - 1
    }
    0 - 1
}

; strings.ToLower(fileName[dotPos:]) == ext, for an ASCII literal `ext` that is
; already lower case.
function ext_equals(path: String, dot: int, ext: pointer[const_char]) returns bool
{
    let plen path.get_length() as int
    var i 0
    while true
    {
        let e (*(ext + i) as int)
        if e = 0
            return dot + i = plen
        if dot + i >= plen
            return false
        var c path.get((dot + i) as size_t) as int
        if (c >= ("A" as char) as int) and (c <= ("Z" as char) as int)
            set c: c + (("a" as char) as int - ("A" as char) as int)
        if c <> e
            return false
        set i: i + 1
    }
    false
}

function script_kind_from_file_name(file_name: String) returns int
{
    let dot last_dot(file_name)
    if dot < 0
        return ScriptKindUnknown

    if ext_equals(file_name, dot, ".js")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".cjs")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".mjs")
        return ScriptKindJS
    if ext_equals(file_name, dot, ".jsx")
        return ScriptKindJSX
    if ext_equals(file_name, dot, ".ts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".cts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".mts")
        return ScriptKindTS
    if ext_equals(file_name, dot, ".tsx")
        return ScriptKindTSX
    if ext_equals(file_name, dot, ".json")
        return ScriptKindJSON

    ScriptKindUnknown
}

; getLanguageVariant(scriptKind) — and the arm that is worth reading twice is
; JSON's. The reference answers LanguageVariantJSX for TSX, JSX, **JS** and
; **JSON**, so the variant is not "this file contains JSX": it is the set of
; kinds whose scan admits `</` as one token. A `.json` file is scanned under it.
function language_variant_is_jsx(script_kind: int) returns bool
{
    if script_kind = ScriptKindTSX
        return true
    if script_kind = ScriptKindJSX
        return true
    if script_kind = ScriptKindJS
        return true
    script_kind = ScriptKindJSON
}
