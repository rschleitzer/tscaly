; the messages of an explanation in order, a code and its arguments each
define ExplainMessages (codes: ref[Array[int]]  args: ref[Array[ref[Array[String]]?]])
{
    function create(host: ref[Page]) returns ref[ExplainMessages] linked


    procedure add(mutable this, code: int, a: ref[Array[String]]?) @persists true linked




}

; tsoptions' config file reading for the driver
define ConfigFiles (reserved: int)
{
    ; core.ResolveConfigFileNameOfProjectReference
    function config_of_reference(host: ref[Page], path: Slice[char]) @page true @direct true returns Slice[char] linked






    ; GetParsedCommandLineOfConfigFilePath through a host: the reference, its parse
    ; null when the file cannot be read; null after a stop
    procedure resolve(mutable sys: ref[ExecSystem], mutable config: Slice[char], options: ref[TsOptions]?, raw: ref[TsOptions]?) @page true @direct true returns ref[ResolvedReference]? io reads localized_messages linked














    ; outputpaths.GetOutputDeclarationFileNameWorker over a config's own options:
    ; below declarationDir (else outDir) relative to the common source directory
    ; (rootDir, else the config's directory)
    function declaration_output_path(host: ref[Page], config: Slice[char], options: ref[TsOptions], file: Slice[char], cwd: Slice[char]) @page true @direct true returns Slice[char] linked












    ; getOutputPathWithoutChangingExtension + ChangeExtension
    function output_path(host: ref[Page], config: Slice[char], options: ref[TsOptions], file: Slice[char], ext: Slice[char], out_dir: Slice[char], cwd: Slice[char]) @page true @direct true returns Slice[char] linked
















    ; outputpaths.GetBuildInfoFileName, absolute
    procedure build_info_file_name_of(host: ref[Page], mutable o: ref[TsOptions], mutable config: Slice[char], mutable cwd: Slice[char]) @page true @direct true returns Slice[char] linked























    ; GetParsedCommandLineOfConfigFile: the config's parse diagnostics into
    ; `diagnostics`; null after a stop
    procedure parse(mutable sys: ref[ExecSystem], existing_options: ref[TsOptions]?, existing_raw: ref[TsOptions]?, mutable config_file_name: Slice[char], mutable text: Slice[char], mutable diagnostics: ref[Array[ref[DriverDiagnostic]]]) returns ref[TsParsedCommandLine]? io reads localized_messages linked



























































}

; a resolved project reference (projectReferenceParseTask): the config, its
; parse (null when the file could not be read), and the references it holds
; by index into the program's reference list
define ResolvedReference
(
    config: Slice[char]
    parsed: ref[TsParsedCommandLine]?
    text: Slice[char]
    diagnostics: ref[Array[ref[DriverDiagnostic]]]
    children: ref[Array[int]]
)

; EmitOptions.EmitOnly
define EmitOnlyAll: int 0
define EmitOnlyJs: int 1
define EmitOnlyDts: int 2
define EmitOnlyForcedDts: int 3

; one emitter.emit's outputs, not yet written
define FileEmitOutput
(
    skipped: bool
    has_js: bool
    js_path: Slice[char]
    js_text: Slice[char]
    has_dts: bool
    dts_path: Slice[char]
    dts_text: Slice[char]
    diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the map files written before their outputs (empty for none), and the
    ; declaration text's sourceMappingURL position (-1 for none)
    js_map_path: Slice[char]
    js_map_text: Slice[char]
    dts_map_path: Slice[char]
    dts_map_text: Slice[char]
    dts_url_pos: int
)
{
    ; getTextHandlingSourceMapForSignature over the declaration text
    function dts_signature_text(this) @page true @direct true returns Slice[char] linked





}

; PROTOTYPE (parallel checkers, slice 366): one checker's share of the check
; phase — the reference's checkerpool.go hands file i to checker i % n. A unit
; is a POSITION: the libs first, then the program's files, as checkSourceFiles
; walks them. The worker writes only its own job; `stop_pos` is the first unit
; that stopped (-1: none), and nothing after it in this share was checked.
define CheckJob
(
    program: ref[DriverProgram]
    checker: ref[Checker]
    initialize: bool
    positions: ref[Array[int]]
    var stop_pos: int
    ; the stop's row in the checker's stop log (-1: a stop that logged nothing)
    var stop_row: int
    done: u64
)

; one run of the checker pool over a set of positions (run_check_pool): the
; jobs, the first stop in position order (`total` when none) and its job (-1)
define PoolRun
(
    jobs: ref[Array[ref[CheckJob]]]
    stop_pos: int
    stop_job: int
)

procedure check_task(mutable arg: pointer[void]) returns pointer[void] io reads checker_rewrite_relative_import_extensions linked







; the checker pool is off until a driver enables it (DriverProgram.pool_size)
shared checker_pool_on: bool linked

define DriverProgram
(
    host: ref[Page]
    sys: ref[ExecSystem]
    options: EmitOptions
    ts: ref[TsOptions]
    pf: ref[ProgramFiles]
    root_names: ref[Array[Slice[char]]]
    var loader: ref[ProgramLoader]?
    var checker: ref[Checker]?
    ; the `createProgram` event, so that `load` can CLOSE it where the program is
    ; finished being created — upstream's `bindSourceFiles` is in tsc/emit.go,
    ; outside createProgram, and this port binds inside `load`
    var cp_tid: int
    var cp_args: ref[Array[ref[TraceArg]]]?
    config_path: Slice[char]
    config_text: Slice[char]
    config_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; Program.Emit's answer
    emitted_files: ref[Array[Slice[char]]]
    var emit_skipped: bool
    var emit_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the lib chain's files, their paths and texts (a related diagnostic's file)
    lib_nodes: ref[Array[ref[AstNode]?]]
    lib_paths: ref[Array[Slice[char]]]
    lib_texts: ref[Array[Slice[char]]]
    ; the root config's parse (its project references), null without a config
    var root_config: ref[TsParsedCommandLine]?
    ; the resolved project references (projectReferenceParser), shared with a build's
    ; other programs through `known_references`
    references: ref[Array[ref[ResolvedReference]]]
    root_references: ref[Array[int]]
    var known_references: ref[Array[ref[ResolvedReference]]]?
    ; the command line's options a build host parses a reference with
    var reference_options: ref[TsOptions]?
    var reference_raw: ref[TsOptions]?
    ; verifyProjectReferences' diagnostics (a program diagnostic each)
    reference_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    ; the lib chain's parsers (a program without a source file checks over a lib)
    lib_parsers: ref[Array[ref[Parser]?]]
    ; per entry of `references`: the indices of its own references in this program
    reference_children: ref[Array[ref[Array[int]]]]
    ; per lib file the lib file name it was loaded for (its path is a replacement's
    ; under libReplacement)
    lib_file_names: ref[Array[Slice[char]]]
    ; pathForLibFile's cache (the lib file name and its path) and, under
    ; libReplacement, each resolution's key (resolveFrom) and traces
    lib_resolution_names: ref[Array[Slice[char]]]
    lib_resolution_paths: ref[Array[Slice[char]]]
    lib_resolution_keys: ref[Array[Slice[char]]]
    lib_resolution_traces: ref[Array[ref[Array[String]]]]
    ; PROTOTYPE (parallel checkers, slice 366): checkers 1..n-1 under
    ; TSCALY_CHECKERS=<n>, each on a page of its own; `checker` is checker 0
    var extra_checkers: ref[Array[ref[Checker]]]?
)
{
    function create(host: ref[Page], sys: ref[ExecSystem], ts: ref[TsOptions], root_names: ref[Array[Slice[char]]], config_path: Slice[char], config_text: Slice[char], config_diagnostics: ref[Array[ref[DriverDiagnostic]]]) returns ref[DriverProgram] linked








    ; ── project references ───────────────────────────────────────────────────

    ; host.GetResolvedProjectReference: the reference at `config`, parsed once;
    ; its index in `references`
    procedure resolve_reference(mutable this, mutable config: Slice[char]) returns int io reads localized_messages linked


























































    ; addProjectReferenceTasks and initMapper: the references parsed, every
    ; referenced project's sources mapped to their output declaration files (a
    ; later project overwriting an earlier one's entry); false after a stop
    procedure load_references(mutable this, mutable ld: ref[ProgramLoader]?) returns bool io reads localized_messages linked

























    ; the TS2878 comparison: the relative path between the root directories against
    ; the one between the output directories (an unset outDir is the root directory)
    procedure reference_rewrite_unsafe(mutable this, reference_config: Slice[char], mutable reference_options: ref[TsOptions]) returns bool linked

























    procedure map_references(mutable this, mutable ld: ref[ProgramLoader], list: ref[Array[int]], mutable seen: ref[Array[int]]) io linked



















































































































    ; the redirects the checker follows (GetSourceFileForResolvedModule) and the
    ; outputs it names when one was not built
    procedure apply_reference_redirects(mutable this, ld: ref[ProgramLoader]) linked

























    ; verifyProjectReferences over RangeResolvedProjectReference
    procedure verify_project_references(mutable this, mutable ld: ref[ProgramLoader]?) linked








    procedure verify_references_of(mutable this, mutable parent: ref[TsParsedCommandLine], parent_path: Slice[char], parent_text: Slice[char], list: ref[Array[int]], mutable seen: ref[Array[int]], mutable build_info_name: Slice[char], mutable ld: ref[ProgramLoader]?) linked




























































    ; CreateDiagnosticAtReferenceSyntax, else a compiler diagnostic
    procedure add_reference_diagnostic(mutable this, parent: ref[TsParsedCommandLine], parent_path: Slice[char], parent_text: Slice[char], position: int, code: int, mutable a0: Slice[char], a1: Slice[char]) linked











    ; the compiler options as the case yardsticks spell them (`name=value`, the
    ; name lower-cased), over the current directory and the config file's path
    function emit_options_of(host: ref[Page], ts: ref[TsOptions], cwd: Slice[char], config_path: Slice[char]) @page true @direct true returns EmitOptions linked





















    function flag(this, name: Slice[char]) returns bool linked


    procedure stop(mutable this, tag: Slice[char]) linked


    function stopped(this) returns bool linked


    ; ── NewProgram ───────────────────────────────────────────────────────────

    function source_extension(path: Slice[char]) returns bool linked








    function under_directory(path: Slice[char], directory: Slice[char]) returns bool linked








    ; an option value TS7 removed (verifyCompilerOptions' createRemovedOptionDiagnostic,
    ; which this port reports only for downlevelIteration: the case yardsticks skip a
    ; configuration carrying the others, and so does the driver)
    procedure uses_removed_option(mutable this) returns bool linked










    ; verifyCompilerOptions' paths loop would report: a key or substitution with
    ; two stars, a substitution list that is not a non-empty array, a substitution
    ; neither relative nor absolute
    function paths_need_validation(paths: ref[JsonValue]) returns bool linked





































    function star_count(text: Slice[char]) returns int linked












    function value_or_empty(this, name: Slice[char]) returns ref[JsonValue] linked







    ; the program; false after a stop
    procedure load(mutable this) returns bool io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables reads checker_strict_null_checks linked












































































































































































































































































































































    ; The checker pool (slice 370), as the reference sizes it in
    ; compiler/checkerpool.go: four checkers, one under `singleThreaded`, `checkers`
    ; when it is given, and never more than the files it checks (the libraries
    ; included) or 256. As in the reference, a TEST program runs single-threaded
    ; (testutil.TestProgramIsSingleThreaded): the pool is ON only where a driver
    ; turns it on — tscaly_exec's --bench-batch, the real run — so the yardsticks
    ; and the dumps keep one checker. TSCALY_CHECKERS=<n> overrides it all, for
    ; measurements. Off whenever a trace is recorded (create_extra_checkers).
    procedure enable_checker_pool() mutable checker_pool_on reads checker_pool_on linked


    ; The parse workers, as the reference sizes them: fileLoader's work group
    ; runs a task per file over every core unless `singleThreaded`; like the
    ; checker pool it is on only where a driver turns it on (the real run), and
    ; a TEST program parses in the walk. Measured on VS Code (slice 373): four
    ; checkers went from 9.8 s to 7.0 s on a loaded box, output identical.
    procedure preparse_size(this) returns int reads checker_pool_on linked













    procedure pool_size(this, units: int) returns int io reads checker_pool_on linked


























    ; TSCALY_CHECKERS=<n>, 0 when unset
    procedure checkers_from_environment() returns int io linked


















    ; checkers 1..n-1, created and configured here on the main thread, each on a
    ; heap page of its own; initialize_checker runs in its worker (check_parallel)
    procedure create_extra_checkers(mutable this, n: int, first: int, mutable lib_files: ref[Array[ref[AstNode]?]], mutable lib_binders: ref[Array[ref[Binder]?]]) io mutable checker_defer_initialize reads checker_defer_initialize linked























    procedure checker_over(mutable this, first: int, lib_files: ref[Array[ref[AstNode]?]], lib_binders: ref[Array[ref[Binder]?]]) returns ref[Checker] io reads checker_trace_types linked


    ; the checker's own page is `on_page` (slice 366: a parallel checker's)
    procedure checker_over_on(this, on_page: ref[Page], first: int, lib_files: ref[Array[ref[AstNode]?]], lib_binders: ref[Array[ref[Binder]?]]) returns ref[Checker] io reads checker_trace_types linked
















































    procedure apply_checker_options(mutable this, mutable cd: ref[Checker]) linked





























    ; --diagnostics / --extendedDiagnostics (slice 348): the reference's
    ; statisticsFromProgram and Statistics.Report — the same rows in the same order
    ; and the same table, between the harness's markers (tsctests drops the block's
    ; contents: the numbers are timings). `Memory used` and `Memory allocs` read Go's
    ; runtime.MemStats upstream (`Alloc`, the live heap objects' bytes, and `Mallocs`,
    ; the objects allocated on the GC heap); here the RBMM runtime's own two counts,
    ; the live objects' bytes and every allocation made from a page
    ; (Page.live_bytes / Page.allocation_count). ★The second is NOT Go's quantity
    ; one to one: Go leaves what escape analysis keeps on the stack out and its
    ; arenas count a slab once, while every region object is counted here, a dead
    ; frame's included.
    procedure report_statistics(mutable this) io linked

















































































































































    function stat_count(host: ref[Page], n: int) @page true @direct true returns String linked






    function stat_kilobytes(host: ref[Page], bytes: int) @page true @direct true returns String linked







    ; formatDuration: `%.3fs`
    function stat_seconds(host: ref[Page], ns: int) @page true @direct true returns String linked















    ; len(file.ECMALineMap()) without building the map: the rule of
    ; Printer.compute_ecma_line_starts — CR, LF, CRLF, U+2028 and U+2029 end a
    ; line — counted instead of recorded
    function ecma_line_count(text: Slice[char]) returns int linked


































    ; TSCALY_STATS: the program's persistent structures by COUNT — nodes, flow nodes,
    ; symbols, types, signatures and every table row the checker holds — so a memory
    ; measurement can price them with the layouts and see what the rest is
    procedure report_stats(this) io linked


































































    ; The bytes a region holds (slice 380): its head page, the extension chain
    ; behind it and every exclusive page of each -- an oversized block by its
    ; rounded size, which its header keeps in `current_page` with no
    ; `next_object`; a normal exclusive page by its own chain. This is what the
    ; footprint is made of, page by page, where TSCALY_STATS' counts only say
    ; what the pages were asked to hold.
    function region_bytes(head: ref[Page]) returns int linked











    ; (the parameter is not called `page`: a first parameter of that name and
    ; type is the implicit caller page to the Modeler)
    function page_bytes(pg: pointer[Page]) returns int linked









    ; the regions of a file table's parsers and binders, each region once
    ; (a sequential walk parses every file onto one page), in bytes
    procedure parse_and_bind_bytes(this, mutable out_bind: ref[int]) returns int linked




































    ; the bytes of a checker's COUNTED persistent structures, priced with the
    ; record sizes the emitted IR gives them (Type 120, Symbol 88, Signature
    ; 128, ValueSymbolLink 64, TypeNodeLink 24, NodeLink 16, SignatureLink 32,
    ; SymbolNodeLink 24; a slot 8, a u32 map 4): what the region holds beyond
    ; this is either transient or a structure nobody counts
    function counted_bytes(cd: ref[Checker]) returns int linked





















































    ; one checker's persistent structures; beside each link table's SLOTS the
    ; rows it actually minted, because a slot is eight bytes and a row up to 64
    procedure report_checker_stats(this, cd: ref[Checker]) io linked

























































































































































    ; a checker stop since `mark` is the step's stop, tagged with its first event
    procedure checker_stopped(mutable this, mutable cd: ref[Checker], mark: int, log_before: int) returns bool io linked











    ; SourceFileMetaData.PackageJsonType as the case yardstick computes it
    procedure unit_package_json_type(mutable this, mutable path: Slice[char]) @page true @direct true returns Slice[char] io linked






















    procedure close_create_program(mutable this) linked







    ; the library half of `bindSourceFiles`
    procedure bind_lib_chain(mutable this, mutable lib_files: ref[Array[ref[AstNode]?]], mutable lib_binders: ref[Array[ref[Binder]?]], paths: ref[Array[Slice[char]]], mutable texts: ref[Array[Slice[char]]]) returns bool io reads shared_lock linked






































    ; fileLoader.sortLibs: lib.d.ts and lib.es6.d.ts first, then by the lib's
    ; position in tsoptions.Libs (stable)
    procedure sort_libs(mutable this, mutable files: ref[Array[ref[AstNode]?]], mutable binders: ref[Array[ref[Binder]?]]) linked







































    procedure swap_int(mutable list: ref[Array[int]], j: int) @page true @direct true linked






    procedure swap_slice(mutable list: ref[Array[Slice[char]]], j: int) @page true @direct true linked






    procedure swap_node(mutable list: ref[Array[ref[AstNode]?]], j: int) @page true @direct true linked






    ; getDefaultLibFilePriority
    function lib_priority(host: ref[Page], path: Slice[char]) returns int linked


































    ; the lib chain read through the System (a read ends a default lib's status),
    ; each file's own `/// <reference lib>`s first
    procedure load_lib_chain(mutable this, names: ref[Array[Slice[char]]], mutable out_files: ref[Array[ref[AstNode]?]], mutable out_binders: ref[Array[ref[Binder]?]], mutable seen: ref[Array[Slice[char]]]) returns bool io reads localized_messages linked



























































    ; fileLoader.pathForLibFile: the default library's file, or under libReplacement
    ; the `@typescript/lib-*` package it resolves to from the config's directory
    procedure path_for_lib_file(mutable this, file_name: Slice[char]) @page true @direct true returns Slice[char] io reads localized_messages linked





































    ; getLibraryNameFromLibFileName: lib.dom.iterable.d.ts → @typescript/lib-dom/iterable
    function library_name_from_lib_file_name(host: ref[Page], lib_file_name: Slice[char]) @page true @direct true returns Slice[char] linked









































    ; ── GetDiagnosticsOfAnyProgram ───────────────────────────────────────────

    procedure from_list(mutable this, list: ref[DiagnosticList], i: int, file_index: int, mutable out: ref[Array[ref[DriverDiagnostic]]]) @page true @direct true io linked









    ; related information as driver diagnostics: each in its own file, the entry's
    ; file when it has none (the parser's and the binder's)
    procedure related_of(mutable this, infos: ref[Array[RelatedInfo]]?, file_index: int) returns ref[Array[ref[DriverDiagnostic]]]? io linked













































    ; GetSyntacticDiagnostics of one file: the parse's and the JavaScript parse's
    procedure syntactic(mutable this, index: int, mutable out: ref[Array[ref[DriverDiagnostic]]]) io linked




























    function is_js_path(path: Slice[char]) returns bool linked


    ; SkipTypeChecking (no project references)
    function skip_type_checking(this, index: int) returns bool linked


    function skip_type_checking_ex(this, index: int, ignore_no_check: bool) returns bool linked



















    ; skipTypeChecking for a default library: `noCheck`, then `skipLibCheck` on a
    ; declaration file — which every lib is — and nothing else. A lib is never JS
    ; and carries no `@ts-nocheck`.
    function skip_lib_checking(this, i: int) returns bool linked








    ; checkSourceFile over one default library. The reference's program HOLDS its
    ; libs, so `checkSourceFiles` walks them ahead of the loader's files and their
    ; diagnostics are ordinary semantic ones; this port keeps the chain beside the
    ; table (see lib_nodes) and this is the walk that reaches it.
    ; PROTOTYPE (parallel checkers, slice 366): checkSourceFiles over the checker
    ; pool. Every unit is checked by checker (position % n) — checker 0 on this
    ; thread, the others on TaskPool workers — and the diagnostics are then
    ; collected in position order, each file's from its own checker, as the
    ; reference's getBindAndCheckDiagnosticsForFile asks the file's checker.
    procedure check_parallel(mutable this, ld: ref[ProgramLoader], mutable out: ref[Array[ref[DriverDiagnostic]]]) returns bool io reads checker_rewrite_relative_import_extensions linked

























    ; GetSemanticDiagnosticsWithoutNoEmitFiltering over a SUBSET of the source
    ; files, on the pool (slice 372): `positions` in source order (the default
    ; libraries first, then the loader's files, as source_pf_index numbers
    ; them), each file's bind-and-check diagnostics into per_file[k] — the
    ; incremental program's affected files, which the reference hands to the
    ; same pool the plain path uses (collectCheckerDiagnosticsFromFiles); the
    ; port had checked them one by one on checker 0, so a `composite` project
    ; never ran the pool at all. A library position is checked but yields no
    ; list (the incremental snapshot keeps none for a library). False after a
    ; stop, the way check_parallel is.
    procedure check_files_parallel(mutable this, positions: ref[Array[int]], mutable per_file: ref[Array[ref[Array[ref[DriverDiagnostic]]]]]) returns bool io reads checker_rewrite_relative_import_extensions linked





























    ; is position `p` (source order) one the checkers should check?
    function wants_check(this, ld: ref[ProgramLoader], p: int) returns bool linked







    ; the run's stop, reported the way the sequential walk reports one
    procedure pool_stop(mutable this, run: ref[PoolRun]) returns bool linked











    ; the pool over `wanted` (positions in source order): every position goes
    ; to checker (position % n), checker 0 on this thread, the others on
    ; TaskPool workers; answers the jobs and the first stop in position order
