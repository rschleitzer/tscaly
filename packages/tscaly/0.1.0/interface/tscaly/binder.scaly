    procedure bind_delete_expression_flow(mutable this, mutable n: ref[AstNode]) @ret_nonlocal true @deep true @deep_beyond_2 true @deep_this_2 true @deep_whole_2 true reads shared_lock linked







    ; bindConditionalExpressionFlow — the same has_flow_effects bargain the
    ; logical branch makes, over three labels instead of one.
    procedure bind_conditional_expression_flow(mutable this, mutable n: ref[AstNode]) @deep true reads shared_lock linked
























    ; bindVariableDeclarationFlow. ★The `for (x of xs)` test is why a declaration
