    procedure bind_class_like_declaration(mutable this, mutable n: ref[AstNode]) @deep true @deep_this_2 true @deep_whole_2 true reads shared_lock linked





















































































    ; The TypeLiteral / MappedType arm of bind: bindAnonymousDeclaration with the
