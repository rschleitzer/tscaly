; SPDX-License-Identifier: Apache-2.0
;
; Diagnostics — the parser's diagnostic list, ported from the reference's
; `p.diagnostics` plus `ast.Diagnostic`.
;
; ── What a Diagnostic carries here, and what it deliberately does not ───────
;
; POS, END and CODE. The reference's `ast.Diagnostic` also holds the file, the
; message and its arguments, and may carry RELATED INFO (which
; parseExpectedMatchingBrackets attaches). None of that is compared: the
; yardstick's dump is `D <pos> <end> <code>` and TESTPLAN.md says so where it
; lists what the format hides — a wrong message with a right code passes here,
; and related info is attached to a diagnostic rather than appended to the list,
; so it never reaches the dump at all. The 2000-entry message table stays
; unported; what the port needs is the integer, and DiagnosticCodes.scaly
; generates those from the reference.
;
; ── Why this is a shared OBJECT and not a callback (CLAUDE.md §3.9d/§3.9e) ──
;
; The reference's scanner takes an ErrorCallback and the parser installs one:
;
;     p.scanner.SetOnError(p.scanError)
;     func (p *Parser) scanError(message *Message, pos int, length int, args ...any) {
;         p.parseErrorAtRange(core.NewTextRange(pos, pos+length), message, args...)
;     }
;
; So the callback's ENTIRE body is "append to the parser's list". Scaly's only
; escaping-closure form is `return \x: …`, and a scanner holding a closure over
; the parser is exactly the shape the escape checker exists to reject — and a
; back-pointer to the Parser would be a cycle between two modules where the
; scanner is declared first. The list is therefore its own concept and BOTH hold
; a pointer to the same one. That preserves the two things the callback bought:
; emission ORDER (a scan error is appended at the moment of scanning, in between
; the parser's own appends) and the DEDUP, which has to see every entry.
;
; ★ It also owns `has_error`, and that is the same argument one level down rather
; than a convenience. `parseErrorAtRange` sets `p.hasParseError = true` on every
; call — OUTSIDE the dedup, so a diagnostic that is discarded as a duplicate
; still marks the node — and `finishNode` reads it, stamps
; NodeFlagsThisNodeHasError and CLEARS it. Both writers of the list need to set
; that flag, so the object that owns the append owns the flag; the Parser reads
; and clears it through here.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.ast.AstNode

; the message arguments (diagnostics.StringifyArgs), copied onto the list's page
define DiagnosticDetail (args: ref[Array[String]])

; one line of a message chain as WriteFlattenedDiagnosticMessage writes it: the
; indentation level (1 under the head), the code and the arguments
; `repopulate`: a line the build info records with RepopulateInfo (a fresh
; createModeMismatchDetails line; a repopulated one drops it)
define ChainLine (level: int  code: int  args: ref[Array[String]]?  repopulate: bool  repopulate_info: ref[Array[String]]?)

; one entry of a diagnostic's relatedInformation: its own file (the SourceFile
; node, null for none), location, code, arguments and message chain
define RelatedInfo (file: ref[AstNode]?  pos: int  end: int  code: int  args: ref[Array[String]]?  var chain: ref[Array[ChainLine]]?)

define Diagnostic (pos: int  end: int  code: int  var file_tag: int  var detail: ref[DiagnosticDetail]?  var chain: ref[Array[ChainLine]]?  var related: ref[Array[RelatedInfo]]?)
{
    init(p: int, e: int, c: int) linked









}

define DiagnosticList
(
    entries: ref[Array[Diagnostic]]

    ; The LOGICAL length. Not `entries.get_length()`, because a rewind truncates
    ; the list — the reference does `p.diagnostics = p.diagnostics[0:len]` — and
    ; the stdlib Array has no truncate. Keeping the count here makes a rewind one
    ; assignment and makes the slots above it reusable, which matters: a
    ; speculation-heavy parse re-reports through the same positions many times.
    var count: int

    ; The reference's `p.hasParseError`. Lives here rather than on the Parser
    ; because the scanner is the other writer; see the header.
    var has_error: bool

    ; message arguments STAGED for the next append (phase (b)1): the parser and the
    ; scanner compute them, stage them, and append at once, so nothing interleaves
    var staged: ref[Array[String]]?
)
{
    init(host: ref[Page]) linked








    ; stage the message arguments of the very next append, copied onto the list's page
    procedure stage(mutable this, a0: String) @deep true linked








    procedure stage(mutable this, a0: String, a1: String) @deep true linked










    procedure stage(mutable this, a0: String, a1: String, a2: String) @deep true linked












    procedure clear_stage(mutable this) @deep true linked


    ; the staged arguments onto the entry at `i`, and the stage cleared
    procedure take_staged(mutable this, i: int) @persists true @deep true linked














    ; The reference's parseErrorAtRange, whole:
    ;
    ;     if len(p.diagnostics) == 0 || p.diagnostics[len(p.diagnostics)-1].Pos() != loc.Pos() {
    ;         p.diagnostics = append(p.diagnostics, ...)
    ;     }
    ;     p.hasParseError = true
    ;
    ; ★★ The DEDUP is load-bearing, not a tidiness pass — "don't report another
    ; error if it would just be at the same location as the last error". A port
    ; that appends unconditionally emits extra diagnostics wherever the reference
    ; reports twice at one position, which the recovery paths do routinely: an
    ; error at a token followed by a list-context error at the same token is one
    ; diagnostic upstream and two without this.
    ;
    ; ★ And note the flag is set on BOTH paths. A duplicate is dropped from the
    ; list and still marks the enclosing node.
    procedure add(mutable this, pos: int, end: int, code: int) @deep true linked






















    function length(this) @ret_param_0 true @deep true returns int linked


    ; ── what reparseTopLevelAwait does to this list ─────────────────────────
    ;
    ; The reference sets the list ASIDE and starts a fresh one:
    ;
    ;     savedParseDiagnostics := p.diagnostics
    ;     p.diagnostics = []*ast.Diagnostic{}
    ;
    ; and then rebuilds it, interleaving slices copied back out of the saved one
    ; with whatever the reparse reports. Here the list is a shared OBJECT — the
    ; scanner holds the same pointer (see the header) — so swapping in a second
    ; instance would mean re-pointing the scanner too, and a scan error appended
    ; through a stale pointer would vanish. The equivalent that leaves the
    ; identity alone is to COPY the entries out and truncate to zero: same two
    ; sequences, one object, nothing to re-point.
    function snapshot(this, host: ref[Page]) @ret_explicit_1 true @deep true returns ref[Array[Diagnostic]] linked











    ; ★★ The RAW append — `p.diagnostics = append(p.diagnostics, ...)` with
    ; neither the dedup nor `hasParseError`. TWO callers upstream write it that
    ; way, and each has its own reason.
    ;
    ; reparseTopLevelAwait COPIES a slice of saved diagnostics back: no dedup,
    ; because those entries were already deduped when they were first reported
    ; and a second filtering would drop a legitimately repeated position that
    ; survived the first; and no `hasParseError`, because a copy is not a report
    ; and the flag is transient state finish_node consumes at the next node it
    ; closes.
    ;
    ; validateJsonValue (slice 19) REPORTS through it: the JSON-ness walk runs
    ; over the finished tree, so a dedup against the last parse error would
    ; swallow a complaint that lands at the same position, and there is no node
    ; left for has_error to reach.
    ;
    ; ★ The NAME is ours — upstream has no function here, only the `append`
    ; expression — so it says what it does rather than naming one of the two
    ; callers, which `add_saved` did until this slice found the second.
    procedure add_direct(mutable this, pos: int, end: int, code: int) @ret_nonlocal true @deep true linked










    ; a diagnostic of one file of a program (slice 269): the file's index in the table
    procedure add_direct_tagged(mutable this, pos: int, end: int, code: int, file_tag: int) @deep true linked










    ; the arguments of the entry at `i`, copied onto this list's page
    procedure set_args_at(mutable this, i: int, args: ref[Array[String]]?) @persists true @deep true linked






















    ; message arguments copied onto `host`
    function copy_args(host: ref[Page], args: ref[Array[String]]?) @ret_explicit_0 true @deep true returns ref[Array[String]]? linked
















    ; the message arguments of the entry at `i`, or null
    function detail_args_at(this, i: int) @ret_param_0 true @deep true returns ref[Array[String]]? linked










    ; one more chain line under the entry at `i` (its arguments copied onto the list's page)
    procedure add_chain_line_at(mutable this, i: int, level: int, code: int, args: ref[Array[String]]?) @persists true @deep true linked

















    ; one more chain line carrying RepopulateModuleNotFound's data (the module
    ; reference, the mode and the stored package name)
    procedure add_chain_line_with_info(mutable this, i: int, level: int, code: int, args: ref[Array[String]]?, info: ref[Array[String]]?) @persists true @deep true linked

















    ; AddRelatedInfo on the entry at `i`: the related diagnostic's file, span, code
    ; and arguments (copied onto the list's page)
    procedure add_related_at(mutable this, i: int, file: ref[AstNode]?, pos: int, end: int, code: int, args: ref[Array[String]]?) @persists true @deep true @deep_this_4 true @deep_whole_4 true linked

















    ; one more chain line under the related entry `k` of the entry at `i`
    procedure add_related_chain_line_at(mutable this, i: int, k: int, level: int, code: int, args: ref[Array[String]]?) @deep true linked























    function related_at(this, i: int) @ret_param_0 true @deep true returns ref[Array[RelatedInfo]]? linked







    ; `L <pos> <end> <code> <path>` and the escaped arguments per related entry of
    ; the entry at `i`, then its chain as `N <level> <code>` lines; `path` names the
    ; file of every entry (the parser's and the binder's relate within their own
    ; file, which SetDiagnostics attaches)
    procedure append_related_lines_at(this, i: int, mutable out: ref[StringBuilder], path: Slice[char]) @deep true linked














    procedure append_related_line(info: RelatedInfo, path: Slice[char], mutable out: ref[StringBuilder]) @deep true @deep_into_2_3 true linked































    ; a related entry of the entry at `i` equal to this one (CompareDiagnostics = 0)
    function related_contains_at(this, i: int, file: ref[AstNode]?, pos: int, end: int, code: int, args: ref[Array[String]]?) @ret_nonlocal true @deep true returns bool linked



















    function same_args(a: ref[Array[String]]?, b: ref[Array[String]]?) @ret_nonlocal true @deep true returns bool linked























    function related_count_at(this, i: int) @ret_param_0 true @deep true returns int linked







    function chain_at(this, i: int) @ret_param_0 true @deep true returns ref[Array[ChainLine]]? linked







    function chain_length_at(this, i: int) @ret_nonlocal true @deep true returns int linked










    ; `M <level> <code>` and the escaped arguments, one line per chain line
    procedure append_chain_lines_at(this, i: int, mutable out: ref[StringBuilder]) @deep true linked






















    procedure add_direct_tagged_args(mutable this, pos: int, end: int, code: int, file_tag: int, args: ref[Array[String]]?) @ret_nonlocal true @deep true linked





    ; whether the entry at `i` carries exactly these arguments (none equals none)
    function args_equal_at(this, i: int, args: ref[Array[String]]?) @ret_param_2 true @deep true returns bool linked
























    function has_args_at(this, i: int) @ret_param_0 true @deep true returns bool linked







    function args_at(this, i: int) @ret_param_0 true @deep true returns ref[Array[String]]? linked










    ; "\t" and the arguments joined by U+001F, each escaped (\\ \n \r \t); nothing
    ; when the entry carries none
    procedure append_args_at(this, i: int, mutable out: ref[StringBuilder]) @deep true linked










    procedure append_escaped_args(args: ref[Array[String]], mutable out: ref[StringBuilder]) @deep true linked











































    procedure retag_from(mutable this, from: int, file_tag: int) @deep true linked













    function file_tag_at(this, i: int) @ret_param_0 true @deep true returns int linked







    ; ★ Answers through OUT-PARAMETERS rather than returning the record. A
    ; `ref[T]?` from Array.get is fine inside this package, but the dump reads
    ; these from a program root across the package boundary, where a returned
    ; generic instance reads back as garbage (root CLAUDE.md: keep generic
    ; instances inside their package, hand the caller scalars). Three ints cross
    ; safely.
    procedure at(this, i: int, mutable out_pos: ref[int], mutable out_end: ref[int], mutable out_code: ref[int]) @ret_nonlocal true @deep true returns bool linked












    ; ── the sort GetDiagnosticsForFile answers through ──────────────────────
    ;
    ; ★★★ ITS READER IS THE CHECKER, AND SLICE 47 WROTE THE TRANSCRIPTION BEFORE
    ; THERE WAS ONE. `DiagnosticsCollection.GetDiagnosticsForFile` sorts before
    ; answering, so a port that emitted in DISCOVERY order would differ from the
    ; reference as a wrong SPAN on every line after the first — a difference that
    ; reads as a checker defect and is a missing sort. Slice 47 declined to write
    ; it because no arm of the checker produced a diagnostic yet, and left the
    ; transcription at its place instead; slice 48's TS1046 and the two ambient
    ; statements are the producers that earn it.
    ;
    ; CompareDiagnostics is path, then pos, then end, then code, then the message
    ; ARGUMENTS and the message chain, and the sort is STABLE. The path is one
    ; file here. The arguments cannot be compared — this port carries no message
    ; text — and they cannot MATTER either: two diagnostics agreeing on pos, end
    ; and code are the same three numbers in the dump, so any order between them
    ; prints identically. That is the argument for stopping at the code, and it is
    ; an argument rather than an approximation.
    ;
    ; ★ INSERTION sort, because stability is the requirement and the list is a
    ; handful of entries per file — the reference uses slices.SortStableFunc for
    ; the same reason it is stable here, not for the asymptotics.
    ;
    ; ★ Not called from the parser's own list: the PARSER's dump compares
    ; EMISSION order (tscaly_ast.scaly says so at its diagnostics section, because
    ; the reference hands sf.Diagnostics() out unsorted), so sorting there would
    ; break the second yardstick. One list concept, two consumers, and only one of
    ; them sorts.
    procedure sort_by_position(mutable this) @deep true linked



















    ; CompareDiagnostics, down to the code — see sort_by_position for why it stops
    ; there. Answers true when `a` must come STRICTLY before `b`, which is what
    ; keeps the insertion above stable: an equal pair never moves.
    function precedes(a: Diagnostic, b: Diagnostic) @ret_param_0 true @deep true returns bool linked








    ; The reference's rewind, which truncates back to the mark's length. §3.5i is
    ; the whole argument for why our stand-in had to have this lifetime; with a
    ; real list it is the reference's own line.
    procedure truncate(mutable this, n: int) @deep true linked





    ; ★★★ THE PORT'S SPELLING OF `ast.NewDiagnosticChain`, AND IT IS EXACT RATHER
    ; THAN AN APPROXIMATION. Chaining builds a NEW diagnostic at the chained one's
    ; own file and LOC with the new message as its head — `NewDiagnostic(chain.file,
    ; chain.loc, message).AddMessageChain(chain)` — so the only thing a dump of
    ; (pos, end, code) can see change is the CODE.
    ;
    ; ★★ The reference collects the diagnostics of one `isSignatureApplicable` run
    ; into a local slice and re-heads each before adding it; this port's relation
    ; adds them where it finds them, so the equivalent is to re-code everything
    ; appended since a mark. It is the SAME SET: nothing else writes to this list
    ; between the mark and the read.
    ; one entry, by index — the reference's per-diagnostic `NewDiagnosticChain(d, message)`
    procedure recode_at(mutable this, at: int, code: int) @persists true @deep true linked








    ; `ast.NewDiagnosticChain(diags[0], message, args...)` over a private list kept as a
    ; mark: the first entry since `mark` becomes the chain child of a new head with
    ; these arguments, and the rest of the private list is dropped. False when the
    ; list holds nothing since the mark.
    procedure rehead_since(mutable this, mark: int, code: int, args: ref[Array[String]]?) @persists true @ret_nonlocal true @deep true returns bool linked










    ; ast.NewDiagnosticChain(d, message): a new head at d's location whose one chain
    ; child is d, its own chain one level deeper
    procedure rechained(mutable this, d: Diagnostic, code: int) @page true @direct true @ret_caller true @deep true returns Diagnostic linked




























    procedure recode_from(mutable this, from: int, code: int) @deep true linked










}
