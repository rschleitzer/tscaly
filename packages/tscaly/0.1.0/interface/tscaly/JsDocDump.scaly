; SPDX-License-Identifier: Apache-2.0
;
; JsDocDump — our half of the JSDOC yardstick's dump, moved out of the program.
;
; ★★★ WHY THE INDEX AND NOT THE NODE. JSDoc hangs off a node through a side table
; rather than sitting in the tree (TESTPLAN's *The third yardstick*), so a dump of
; it has to say WHICH node it belongs to — and the only name both sides agree on is
; the node's position in the pre-order walk the parser yardstick has already
; compared. Hence `N <index> <count>` and then each JSDoc tree at depth 0.
;
; ★★ A NODE WITH NO JSDOC PRINTS NOTHING, and the walk still counts it: the index
; is a position in the WALK, not in the output. That is what makes an absent `N`
; line a comparison rather than a gap.
;
; ★ Moved here in slice 58 for AstDump's reason — one body, two drivers — and the
; tree printer is AstDump's, because a JSDoc node is an AstNode and its dump is the
; same five fields. Sharing it is not a shortcut: a JSDoc tree printed in a
; different shape from the tree it hangs off would be a second format to keep in
; step.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console
use tscaly.ast.AstNode
use tscaly.parser.Parser
use tscaly.AstDump.AstDump

define JsDocDump
{
    procedure write(host: ref[Page], mutable p: ref[Parser], mutable file: ref[AstNode]) @ret_nonlocal true io reads shared_lock linked








    procedure walk(mutable sb: ref[StringBuilder], mutable p: ref[Parser], mutable n: ref[AstNode]?, mutable index: ref[int]) reads shared_lock linked






























}
