; SPDX-License-Identifier: Apache-2.0
;
; semver — internal/semver whole (version.go, version_range.go; slice 259): the
; version and the npm range grammar a package.json `typesVersions` key and an
; exports `types@<range>` condition are tested with, against the compiler's own
; version (core.Version(), "7.0.2"). The reference's regular expressions are
; written out as scanners, each named after the pattern it replaces.

use scaly.memory.Page
use scaly.containers.Array

; the comparator operators (comparatorOperator)
define SemverOpLessThan: int 1
define SemverOpLessThanEqual: int 2
define SemverOpEqual: int 3
define SemverOpGreaterThanEqual: int 4
define SemverOpGreaterThan: int 5

; Version. `prerelease` and `build` are null for none (the reference's nil slices).
define SemverVersion
(
    major: int
    minor: int
    patch: int
    prerelease: ref[Array[Slice[char]]]?
    build: ref[Array[Slice[char]]]?
)
{
    function increment_major(this) @page true @direct true returns SemverVersion linked

    function increment_minor(this) @page true @direct true returns SemverVersion linked

    function increment_patch(this) @page true @direct true returns SemverVersion linked

    ; Version.Compare
    function compare(this, b: SemverVersion) returns int linked
}

; versionComparator
define SemverComparator
(
    op_kind: int
    operand: SemverVersion
)

; VersionRange: the alternatives of a disjunction, each a conjunction
define SemverRange
(
    alternatives: ref[Array[ref[Array[SemverComparator]]]]
)
{
    ; VersionRange.Test — an empty disjunction is `*`
    function test(this, version: SemverVersion) returns bool linked
}

; partialVersion
define SemverPartial
(
    ok: bool
    version: SemverVersion
    major_str: Slice[char]
    minor_str: Slice[char]
    patch_str: Slice[char]
)

; the scanned components of versionRegexp / partialRegExp: each group's span,
; -1 for an absent group
define SemverMatch
(
    ok: bool
    major_start: int
    major_end: int
    minor_start: int
    minor_end: int
    patch_start: int
    patch_end: int
    pre_start: int
    pre_end: int
    build_start: int
    build_end: int
)

define Semver
(
    unused: int
)
{
    function compare_int(a: int, b: int) returns int linked

    ; the compiler's version, core.Version()
    function typescript_version() @page true @direct true returns SemverVersion linked

    ; comparePreReleaseIdentifiers
    function compare_pre_release_identifiers(left: ref[Array[Slice[char]]]?, right: ref[Array[Slice[char]]]?) returns int linked

    ; strings.Compare
    function compare_bytes(a: Slice[char], b: Slice[char]) returns int linked

    function is_digit(c: int) returns bool linked

    function is_letter(c: int) returns bool linked

    ; numericIdentifierRegExp: `^(?:0|[1-9]\d*)$`
    function is_numeric_identifier(s: Slice[char]) returns bool linked

    ; comparePreReleaseIdentifier
    function compare_pre_release_identifier(left: Slice[char], right: Slice[char]) returns int linked

    function number_of(s: Slice[char]) returns int linked

    ; a numeric component that fits getUintComponent's uint32
    function component_fits(s: Slice[char]) returns bool linked

    ; `(0|[1-9]\d*)` at `pos`, or with wildcards `([x*0]|[1-9]\d*)` (partialRegExp);
    ; the end, or -1 for no match
    function scan_component(text: Slice[char], pos: int, wildcards: bool) returns int linked

    ; `[a-z0-9-.]+` (case-insensitive) at `pos`: the end, or -1
    function scan_identifier_run(text: Slice[char], pos: int, allow_plus: bool) returns int linked

    ; versionRegexp (wildcards false) and partialRegExp (wildcards true): the
    ; grammar `C(.C(.C(-pre)?(+build)?)?)?` over the whole text
    function match_version(text: Slice[char], wildcards: bool) @page true @direct true returns SemverMatch linked

    ; strings.Split(s, ".")
    function split_dots(host: ref[Page], s: Slice[char]) returns ref[Array[Slice[char]]] linked

    function span(text: Slice[char], start: int, end: int) @page true @direct true returns Slice[char] linked

    ; prereleaseRegexp: dot-separated `0|[1-9]\d*|[a-z-][a-z0-9-]*`
    function is_valid_prerelease(host: ref[Page], s: Slice[char]) returns bool linked

    ; buildRegExp: dot-separated non-empty `[a-z0-9-]+`
    function is_valid_build(host: ref[Page], s: Slice[char]) returns bool linked

    ; TryParseVersion; `ok` false on the reference's error
    procedure try_parse_version(host: ref[Page], text: Slice[char], mutable ok: ref[bool]) @page true @direct true returns SemverVersion linked

    function is_wildcard(text: Slice[char]) returns bool linked

    ; parsePartial
    function parse_partial(host: ref[Page], text: Slice[char]) @page true @direct true returns SemverPartial linked

    function zero_prerelease(host: ref[Page]) returns ref[Array[Slice[char]]] linked

    ; parseHyphen: `left - right`
    procedure parse_hyphen(host: ref[Page], left: Slice[char], right: Slice[char], mutable out: ref[Array[SemverComparator]]) @page true @direct true returns bool linked

    ; parseComparator; `op` is the operator text (empty for none)
    procedure parse_comparator(host: ref[Page], op: Slice[char], mutable text: Slice[char], mutable out: ref[Array[SemverComparator]]) @page true @direct true returns bool linked

    function op_is(op: Slice[char], literal: Slice[char]) returns bool linked

    ; `\s`
    function is_space(c: int) returns bool linked

    ; strings.TrimSpace (ASCII)
    function trim(s: Slice[char]) @page true @direct true returns Slice[char] linked

    ; whitespaceRegExp.Split: the runs between `\s+`
    function split_whitespace(host: ref[Page], s: Slice[char]) returns ref[Array[Slice[char]]] linked

    ; `[a-z0-9-+.*]+` over a whole token (case-insensitive)
    function is_range_operand(s: Slice[char]) returns bool linked

    ; TryParseVersionRange (parseAlternatives)
    procedure try_parse_version_range(host: ref[Page], mutable text_in: Slice[char], mutable ok: ref[bool]) @page true @direct true returns SemverRange linked

    ; testAlternative
    function test_alternative(alternative: ref[Array[SemverComparator]], version: SemverVersion) returns bool linked

    ; testComparator
    function test_comparator(comparator: SemverComparator, version: SemverVersion) returns bool linked
}
