; SPDX-License-Identifier: Apache-2.0
;
; commandline — tsoptions/commandlineparser.go: ParseCommandLine and
; ParseBuildCommandLine (phase (b)2).
;
; ★ The parser's option map (`parser.options`, an ordered map of name to a Go value)
; is a TsOptions of JsonValues here, in insertion order and WITHOUT the zero-unsetting
; `TsOptions.put` does for a converted CompilerOptions: the raw map keeps an explicit
; `null` and an empty list, and showConfig and `--init` print it as it stands. The
; converted options go through convertToOptionsWithAbsolutePaths and
; ParseCompilerOptions (`TsConfigParser.parse_compiler_option`), the tsconfig path's
; own conversion.
;
; ★ A declaration is (table, index): the compiler options (TsOptionDecls, the last
; declaration of a name winning as the reference's name map does), the watch options
; and the build options.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.program.JsonValue
use tscaly.tsoptions.TsOptions
use tscaly.tsoptions.TsConfigParser
use tscaly.tsoptions.TsGlobPattern
use tscaly.TsOptionDecls.TsOptionDecls
use tscaly.diagnosticwriter.DriverDiagnostic
use tscaly.system.ExecSystem

define OptionTableCompiler: int 0
define OptionTableWatch: int 1
define OptionTableBuild: int 2

; the parser's diagnostics sets (ParseCommandLineWorkerDiagnostics)
define ParseModeCompiler: int 0
define ParseModeBuild: int 1

define ParsedCommandLine
(
    ; parser.options, as parsed
    raw: ref[TsOptions]
    ; the CompilerOptions (tsc) or the build command's compiler options
    options: ref[TsOptions]
    ; the file names (tsc) or the projects (-b)
    file_names: ref[Array[Slice[char]]]
    errors: ref[Array[ref[DriverDiagnostic]]]
)

define CommandLine (reserved: int)
{
    ; ── the declarations ─────────────────────────────────────────────────────

    function table_count(table: int) @ret_nonlocal true @deep true returns int linked











    function decl_name(table: int, i: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked








    function decl_short(table: int, i: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked








    function decl_kind(table: int, i: int) @ret_nonlocal true @deep true returns int linked








    ; CommandLineOption.Elements().Kind: the watch lists are lists of strings
    function decl_element_kind(table: int, i: int) @deep true returns int linked






    function decl_tsconfig_only(table: int, i: int) @ret_nonlocal true @deep true returns bool linked








    function decl_min_value(table: int, i: int) @ret_nonlocal true @deep true returns int linked








    ; NameMap.GetOptionDeclarationFromName: the short name first, then the name
    ; without regard to case, the LAST declaration of a name winning
    function find_decl(table: int, name: Slice[char], allow_short: bool) @ret_nonlocal true @deep true returns int linked

























    ; ── values ───────────────────────────────────────────────────────────────

    function value(host: ref[Page], kind: int, text: Slice[char], truth: bool) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    function list_value(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    ; `p.options.Set(name, value)` on the ordered map: replaced in place, else appended
    procedure raw_set(host: ref[Page], mutable raw: ref[TsOptions], name: Slice[char], v: ref[JsonValue]) @deep true @deep_into_1_8 true linked













    function args1(host: ref[Page], a0: Slice[char]) @ret_explicit_0 true @deep true returns ref[Array[String]] linked







    function args2(host: ref[Page], a0: Slice[char], a1: String) @ret_explicit_0 true @deep true returns ref[Array[String]] linked









    ; ast.NewCompilerDiagnostic
    ; locale.Parse (golang.org/x/text/language): a registered two-letter or any
    ; three-letter language subtag, `root`, the grandfathered `i-`/`sgn-` forms, then
    ; alphanumeric subtags of one to eight characters, `-` or `_` separated
    function locale_is_valid(host: ref[Page], text: Slice[char]) @ret_nonlocal true @deep true returns bool linked




























































    ; the ISO 639-1 codes of the language registry
    function registered_language(host: ref[Page], code: Slice[char]) @ret_nonlocal true @deep true returns bool linked






    ; diagnostics' language matcher: a locale whose messages the reference translates
    function locale_is_translated(host: ref[Page], text: Slice[char]) @ret_nonlocal true @deep true returns bool linked









    procedure error(host: ref[Page], mutable errors: ref[Array[ref[DriverDiagnostic]]], code: int, args: ref[Array[String]]?) @page true @direct true @ret_nonlocal true @deep true @deep_into_1_8 true linked





    ; createDiagnosticForInvalidEnumType
    procedure invalid_enum(host: ref[Page], mutable errors: ref[Array[ref[DriverDiagnostic]]], i: int) @ret_nonlocal true @deep true linked















    ; convertJsonOptionOfEnumType: the value of a known key, null for an empty text
    ; or an option without a map, an error for an unknown key
    procedure enum_value(host: ref[Page], table: int, i: int, text: Slice[char], mutable errors: ref[Array[ref[DriverDiagnostic]]]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked















    function byte_at(s: Slice[char], i: int) @deep true returns int linked


    ; strings.TrimSpace over ASCII white space
    function trim(s: Slice[char]) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked










    function is_space(c: int) @ret_nonlocal true @deep true returns bool linked


    ; ParseListTypeOption → the list; the errors go to `errors`
    procedure parse_list(host: ref[Page], table: int, i: int, text: Slice[char], mutable errors: ref[Array[ref[DriverDiagnostic]]]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked







































    ; getCompilerOptionValueTypeString
    function type_string(table: int, i: int) @page true @direct true @ret_caller true @deep true returns String linked


    ; parseOptionValue → the index past the value
    procedure parse_option_value(host: ref[Page], mutable sys: ref[ExecSystem], args: ref[Array[Slice[char]]], i_in: int, table: int, d: int, mismatch_code: int, mutable raw: ref[TsOptions], mutable errors: ref[Array[ref[DriverDiagnostic]]]) @ret_nonlocal true @deep true returns int linked















































































































































    ; createUnknownOptionError, with the mode's alternate map
    procedure unknown_option(host: ref[Page], mode: int, input_name: Slice[char], text: Slice[char], mutable errors: ref[Array[ref[DriverDiagnostic]]]) @deep true linked






















    ; commandLineParser.parseStrings
    procedure parse_strings(host: ref[Page], mutable sys: ref[ExecSystem], mode: int, args: ref[Array[Slice[char]]], mutable raw: ref[TsOptions], mutable file_names: ref[Array[Slice[char]]], mutable errors: ref[Array[ref[DriverDiagnostic]]]) @deep true @deep_into_5_8 true linked

























































    ; convertToOptionsWithAbsolutePaths + convertMapToOptions(compilerOptionsParser)
    procedure convert_compiler_options(host: ref[Page], raw: ref[TsOptions], cwd: Slice[char]) @ret_explicit_0 true @deep true @deep_beyond_1 true @deep_whole_1 true returns ref[TsOptions] linked










































    ; tsoptions.ParseCommandLine
    procedure parse(host: ref[Page], mutable sys: ref[ExecSystem], args: ref[Array[Slice[char]]]) @ret_explicit_0 true @deep true @deep_beyond_1 true @deep_whole_1 true returns ref[ParsedCommandLine] linked









    ; tsoptions.ParseBuildCommandLine: the compiler options are the entries the build
    ; table and the compiler table agree on, the projects default to "."
    procedure parse_build(host: ref[Page], mutable sys: ref[ExecSystem], args: ref[Array[Slice[char]]]) @ret_explicit_0 true @deep true @deep_beyond_1 true @deep_whole_1 true returns ref[ParsedCommandLine] linked




































    function raw_true(raw: ref[TsOptions], name: Slice[char]) @ret_param_0 true @deep true returns bool linked







}
