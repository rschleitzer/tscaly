; SPDX-License-Identifier: Apache-2.0
;
; tracing — internal/tracing/tracing.go: the `--generateTrace` session, its event
; stream (trace.json) and its per-checker legend (legend.json).
;
; The THIRD artifact, types_<n>.json, is built in `checker.scaly` where
; `internal/checker/tracer.go` builds it, because every field of a type
; descriptor is a question only the checker can answer.
;
; ★★★ THE SESSION HOLDS NO FILESYSTEM, WHICH IS THE ONE DEPARTURE FROM THE
; REFERENCE'S SHAPE AND IT IS FORCED BY THE MODULE ORDER. Upstream's `Tracing`
; carries a `vfs.FS` and truncates trace.json at StartTracing, appending every
; 256 KB; this module is declared BEFORE `checker` (the checker pushes its own
; check events) and therefore before `system`, so it cannot hold one. It buffers
; the whole stream instead and `Execute` writes the three files at Stop. What a
; baseline compares is the finished file, and the finished file is the same
; bytes — the flush threshold is a peak-memory decision, not a format one.
;
; ★★ THE HARNESS ALWAYS RUNS DETERMINISTIC (`StartTracing(..., testing != nil)`),
; and that is worth knowing before reading `push`: in deterministic mode the
; timestamp is a monotonic counter and a SAMPLED event — `separateBeginAndEnd`
; false, which is most of the reference's call sites — is skipped entirely, so
; the stream is exactly the begin/end pairs.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.program.JsonValue
use tscaly.buildinfojson.JsonText
use tscaly.xxh3.Xxh3

; the phases, `tracing.Phase`
define TracePhaseParse: int 0
define TracePhaseProgram: int 1
define TracePhaseBind: int 2
define TracePhaseCheck: int 3
define TracePhaseCheckTypes: int 4
define TracePhaseEmit: int 5
define TracePhaseSession: int 6

; mainThreadID / firstSyntheticThreadID / firstFileThreadID / fileThreadIDHashRange
define TraceMainThreadId: int 1
define TraceFirstSyntheticThreadId: int 2
define TraceFirstFileThreadId: int 1000000
define TraceFileThreadIdHashRange: int 1000000000

; one entry of the args map. The reference's `map[string]any` is written with
; `json.Deterministic(true)`, so its members come out in KEY ORDER — a list kept
; sorted says the same thing and needs no map (§3.8's question does not arise for
; four keys).
define TraceArg (key: Slice[char]  text: Slice[char]  num: int  is_num: bool)

; a thread the stream has named: `traceThreadKey` plus the id it was given
define TraceThread (is_checker: bool  text: Slice[char]  index: int  tid: int)

; TraceRecord — one line of the legend
define TraceRecord (config_file_path: Slice[char]  trace_path: Slice[char]  types_path: Slice[char]  checker_id: int)

define Tracing
(
    host: ref[Page]
    trace_dir: Slice[char]
    trace_path: Slice[char]
    config_file_path: Slice[char]
    legend: ref[Array[ref[TraceRecord]]]
    content: ref[StringBuilder]
    threads: ref[Array[ref[TraceThread]]]
    var started: bool
    deterministic: bool
    var ts_counter: int
    var metadata_ts: int
)
{
    ; StartTracing. The header's three metadata events share ONE timestamp, which
    ; every later `thread_name` event reuses — see `thread_id_of`.
    procedure create(host: ref[Page], mutable trace_dir: Slice[char], mutable config_file_path: Slice[char], deterministic: bool) @ret_caller true returns ref[Tracing] linked

















    ; tspath.CombinePaths for the two names this module builds
    function combine(host: ref[Page], dir: Slice[char], name: Slice[char]) @page true @direct true @ret_explicit_0 true returns Slice[char] linked













    ; the timestamp in microseconds. ★The non-deterministic arm is the reference's
    ; `1000 * timestamp()` and this port has no monotonic clock reachable from a
    ; module declared this early; it answers the counter too, which is wrong only
    ; for a profile nobody in this repository reads and is never what the harness
    ; asks for. A clock belongs here the day `--generateTrace` is used for real.
    procedure timestamp(mutable this) @ret_param_0 true returns int linked





    function one_arg(host: ref[Page], key: Slice[char], text: Slice[char]) @ret_explicit_0 true returns ref[Array[ref[TraceArg]]] linked






    function no_args(host: ref[Page]) @ret_explicit_0 true returns ref[Array[ref[TraceArg]]] linked


    procedure add_arg(host: ref[Page], mutable args: ref[Array[ref[TraceArg]]], key: Slice[char], text: Slice[char]) @page true @direct true @ret_nonlocal true linked


    procedure add_num_arg(host: ref[Page], mutable args: ref[Array[ref[TraceArg]]], key: Slice[char], num: int) @page true @direct true @ret_nonlocal true linked


    function phase_name(phase: int) @page true @direct true @ret_nonlocal true returns Slice[char] linked
















    ; writeEventTo — the reference's struct order, its `omitzero` members left out
    procedure write_event(mutable this, tid: int, ph: Slice[char], cat: Slice[char], ts: int, name: Slice[char], scope: Slice[char], args: ref[Array[ref[TraceArg]]]?) @ret_nonlocal true linked

































    ; the args in KEY ORDER — the reference's json.Deterministic(true)
    procedure write_args(this, mutable sb: ref[StringBuilder], args: ref[Array[ref[TraceArg]]]) linked













































    function less_key(x: Slice[char], y: Slice[char]) @ret_param_0 true returns bool linked




















    ; Push with separateBeginAndEnd — the begin half. The end half is `pop`, which
    ; the caller runs where the reference runs its deferred closure, and it needs
    ; the SAME thread id, which is why the begin answers one.
    procedure push(mutable this, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) returns int linked










    procedure pop(mutable this, tid: int, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) linked








    ; Instant
    procedure instant(mutable this, phase: int, name: Slice[char], args: ref[Array[ref[TraceArg]]]?) linked









    ; threadIDLocked: the key off the args, the id off the key, and a `thread_name`
    ; metadata event the first time an id is handed out.
    procedure thread_id_of(mutable this, args: ref[Array[ref[TraceArg]]]?) returns int linked




















































































    function path_arg(args: ref[Array[ref[TraceArg]]], key: Slice[char]) @page true @direct true @ret_param_0 true returns Slice[char] linked















    function copy_text(host: ref[Page], t: Slice[char]) @page true @direct true @ret_explicit_0 true returns Slice[char] linked







    function same_text(x: Slice[char], y: Slice[char]) @ret_nonlocal true returns bool linked













    ; defaultThreadID: a checker gets a synthetic id by index, a file a STABLE one
    ; from the digest of its display name — see `Xxh3.hash64`, which exists for
    ; this line and is gated by tests/hashcheck.sh.
    function default_thread_id(is_checker: bool, index: int, text: Slice[char]) returns int linked






















    procedure write_thread_name(mutable this, tid: int, is_checker: bool, index: int, text: Slice[char]) @ret_nonlocal true linked


















    ; NewTypeTracer: the legend row, and the path its checker's types go to
    procedure new_type_tracer(mutable this, checker_index: int) @page true @direct true @ret_param_0 true returns Slice[char] linked












    ; the trace stream, closed. StopTracing's own last line.
    procedure trace_text(mutable this) @page true @direct true @ret_caller true returns Slice[char] linked








    ; legend.json, its rows sorted by typesPath and marshalled with two-space
    ; indentation (MarshalIndent("", "  "))
    procedure legend_text(mutable this) @page true @direct true @ret_param_0 true returns Slice[char] linked
















































}
