    ; parseOwnConfigOfJsonSourceFile
    procedure parse_own_config(mutable this, file: ref[AstNode], mutable base_path: Slice[char], mutable config_file_name: Slice[char]) @ret_caller true returns ref[TsParsedConfig] io reads localized_messages linked























