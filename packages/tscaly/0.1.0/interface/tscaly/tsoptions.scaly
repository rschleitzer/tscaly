    ; ── parseJsonConfigFileContentWorker ─────────────────────────────────────

    procedure parse_json_config_file_content(mutable this, mutable file: ref[AstNode], mutable base_path: Slice[char], mutable config_file_name: Slice[char]) @ret_caller true returns ref[TsParsedCommandLine] io reads localized_messages linked











































































































































































    ; getPropFromRaw for a source file: the value when it is an array, else null
