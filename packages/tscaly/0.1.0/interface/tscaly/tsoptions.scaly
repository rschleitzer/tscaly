; SPDX-License-Identifier: Apache-2.0
;
; tsoptions — a tsconfig.json read the way the reference's test harness reads it
; (slice 261): internal/tsoptions/tsconfigparsing.go's
; ParseJsonSourceFileConfigFileContent over the case's own files — convertToJson
; with the root and compilerOptions notifiers, parseOwnConfigOfJsonSourceFile,
; parseConfig with `extends` (a path, or a module resolved by ResolveConfig),
; mergeCompilerOptions, the `${configDir}` substitution and
; getFileNamesFromConfigSpecs — and internal/vfs/vfsmatch's glob matcher, which
; walks the case's files as the harness's map file system.
;
; ★ The options are the SET fields of core.CompilerOptions, kept as (declaration
; name, converted value) pairs in assignment order: a field parseCompilerOptions
; writes a zero value into is absent, which is what mergeCompilerOptions' IsZero
; test reads. The declarations come from the generated TsOptionDecls.
;
; ★ A JSON value is program.scaly's JsonValue. Go's two empty slices differ here and
; the reference reads the difference (getPropFromRaw, setPropertyValue): an array
; literal whose every element converted to nil is a NIL slice, and the port marks
; such an array with `truth` set.
;
; ★ The conversion's diagnostics (slice 273) are collected only when asked for
; (`config_file_diagnostics`, the errors run): the config file's parse diagnostics,
; then onPropertySet's and convertJsonOption's reports, the extends lookups and the
; worker's spec, empty-files and no-inputs reports. A diagnostic positioned in an
; EXTENDED config file is not kept — the dump prints the root config's section
; only — while a compiler diagnostic from any config of the chain is.
; validateJsonOptionValue's locale check is not ported — no ported reader asks for
; the locale. An object literal inside an ARRAY answers its properties' option
; from the array's own level, so `"extends": [{"extends": 1}]` reports TS1328
; where the reference's element option map reports TS5024.

use tscaly.incremental.IncSort
use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.ast.*
use tscaly.parser.Parser
use tscaly.program.*
use tscaly.addressindex.HashChain
use tscaly.Diagnostics.DiagnosticList
use tscaly.scanner.Scanner
use tscaly.TsOptionDecls.TsOptionDecls

; which notifier an object literal's properties report to
define TsConfigLevelNone: int 0
define TsConfigLevelRoot: int 1
define TsConfigLevelCompilerOptions: int 2
define TsConfigLevelTypeAcquisition: int 3

; vfsmatch.Usage
define TsGlobUsageFiles: int 0
define TsGlobUsageDirectories: int 1
define TsGlobUsageExclude: int 2

; vfsmatch's componentKind and segmentKind
define TsGlobComponentLiteral: int 0
define TsGlobComponentWildcard: int 1
define TsGlobComponentDoubleAsterisk: int 2
define TsGlobSegmentLiteral: int 0
define TsGlobSegmentStar: int 1
define TsGlobSegmentQuestion: int 2

; core.CompilerOptions as its set fields
define TsOptions
(
    names: ref[Array[Slice[char]]]
    values: ref[Array[ref[JsonValue]?]]
)
{
    function create(host: ref[Page]) @ret_explicit_0 true returns ref[TsOptions] linked


    function count(this) @ret_param_0 true returns int linked


    function name_at(this, i: int) @page true @direct true @ret_param_0 true returns Slice[char] linked


    function value_at(this, i: int) @ret_param_0 true returns ref[JsonValue]? linked


    function index_of_name(this, name: Slice[char]) @ret_nonlocal true returns int linked












    ; the value of a set field, null when unset
    function get(this, name: Slice[char]) @ret_param_0 true returns ref[JsonValue]? linked







    ; a string field's text, empty when unset
    function text_of(this, name: Slice[char]) @page true @direct true @ret_param_0 true returns Slice[char] linked










    ; a Tristate field: 1 true, 0 false, -1 unset
    function tristate_of(this, name: Slice[char]) @ret_nonlocal true returns int linked










    ; reflect's IsZero over the field kinds this table holds: an empty string and a
    ; nil slice are zero, a Tristate false is not
    function is_zero(v: ref[JsonValue]) @ret_param_0 true returns bool linked










    ; a field written; a zero value unsets it
    procedure put(host: ref[Page], mutable options: ref[TsOptions], name: Slice[char], value: ref[JsonValue]?) linked
























    ; mergeCompilerOptions(this, source, rawSource): a field the raw compilerOptions
    ; spells as null is zeroed, every other field the source sets is copied
    procedure merge(host: ref[Page], mutable target: ref[TsOptions], source: ref[TsOptions]?, raw: ref[JsonValue]?) linked



























































    ; one field's value as the case yardstick spells an option: a Tristate
    ; `true`/`false`, a text as is, a list joined with commas, a map as its keys
    function render(host: ref[Page], v: ref[JsonValue]) @page true @direct true @ret_param_1 true returns Slice[char] linked


































}

; parsedTsconfig
define TsParsedConfig
(
    raw: ref[JsonValue]?
    options: ref[TsOptions]?
    ; extendedConfigPath: null when the config has no `extends`
    extends_paths: ref[Array[Slice[char]]]?
)

; what parseOwnConfigOfJsonSourceFile's onPropertySet closure captured
define TsOwnConfig
(
    options: ref[TsOptions]
    var extends_paths: ref[Array[Slice[char]]]?
    base_path: Slice[char]
    config_file_name: Slice[char]
    ; the root config file's own parse, whose reports are kept (slice 273)
    reporting: bool
    ; an extended config's path and text (the driver's reports), empty for the root
    path: Slice[char]
    text: Slice[char]
)

; extendsResult
define TsExtendsResult
(
    options: ref[TsOptions]
    var include: ref[JsonValue]?
    var exclude: ref[JsonValue]?
    var files: ref[JsonValue]?
)

; ParsedCommandLine's two halves the harness reads
define TsParsedCommandLine
(
    options: ref[TsOptions]
    file_names: ref[Array[Slice[char]]]
    ; ParsedConfig.ProjectReferences: null without a `references` array
    references: ref[Array[ProjectReference]]?
    ; the `references` array's element ranges in the config file (pos, end per
    ; element), for CreateDiagnosticAtReferenceSyntax
    reference_ranges: ref[Array[int]]
    ; configFileSpecs: the validated `files` and `include` specs after the
    ; ${configDir} substitution, the include specs before it, whether the include
    ; is the default one, and basePathForFileNames
    files_specs: ref[Array[Slice[char]]]
    files_specs_raw: ref[Array[Slice[char]]]
    include_specs: ref[Array[Slice[char]]]
    include_specs_raw: ref[Array[Slice[char]]]
    is_default_include: bool
    base_path: Slice[char]
    ; validatedExcludeSpecs (substituted; the outDir/declarationDir defaults) and
    ; compileOnSave
    exclude_specs: ref[Array[Slice[char]]]
    compile_on_save: bool
    ; ConfigFile.ExtendedSourceFiles: every extended config file read
    extended_files: ref[Array[Slice[char]]]
)

; core.ProjectReference: the absolute path as written, and circular
define ProjectReference (path: Slice[char]  original_path: Slice[char]  circular: bool)

; vfsmatch.segment
define TsGlobSegment
(
    kind: int
    literal: Slice[char]
)

; vfsmatch.component
define TsGlobComponent
(
    kind: int
    literal: Slice[char]
    segments: ref[Array[TsGlobSegment]]?
    skip_package_folders: bool
)

; vfsmatch.globPattern (case-sensitive: the harness's file system is)
define TsGlobPattern
(
    components: ref[Array[TsGlobComponent]]
    is_exclude: bool
    exclude_min_js: bool
)
{
    ; compileGlobPattern: null when the pattern matches nothing
    procedure compile(host: ref[Page], mutable spec: Slice[char], mutable base_path: Slice[char], usage: int) @page true @direct true @ret_explicit_0 true returns ref[TsGlobPattern]? linked



























    ; tspath.GetNormalizedPathComponents over an already combined path
    function normalized_path_components(host: ref[Page], path: Slice[char]) @ret_explicit_0 true returns ref[Array[Slice[char]]] linked

























































    ; IsImplicitGlob: no `.`, `*` or `?`
    function is_implicit_glob(s: Slice[char]) @ret_nonlocal true returns bool linked












    function parse_component(host: ref[Page], s: Slice[char], is_include: bool) @page true @direct true returns TsGlobComponent linked

















    ; parseSegments: `*.ts` → [star, literal(".ts")]
    function parse_segments(host: ref[Page], s: Slice[char]) @ret_explicit_0 true returns ref[Array[TsGlobSegment]] linked

























    function matches(this, path: Slice[char]) @ret_nonlocal true returns bool linked


    function matches_prefix(this, path: Slice[char]) @ret_nonlocal true returns bool linked


    ; nextPathPartSingle: the part at `offset` as [out_start, out_end), answering the
    ; offset after it, -1 past the end
    procedure next_path_part(s: Slice[char], offset: int, mutable out_start: ref[int], mutable out_end: ref[int]) @ret_nonlocal true returns int linked























    ; matchPathParts over one path
    function match_path(this, s: Slice[char], offset_in: int, comp_in: int, prefix_only: bool) returns bool linked





















































    ; patternSatisfied: only trailing `**` components may match nothing
    function pattern_satisfied(this, comp_idx: int) @ret_nonlocal true returns bool linked












    function match_wildcard(this, segs: ref[Array[TsGlobSegment]], s: Slice[char]) @ret_nonlocal true returns bool linked

















    ; utf8.DecodeRuneInString's size at `i`
    function rune_size(s: Slice[char], i: int) @ret_nonlocal true returns int linked














    ; matchSegments: the iterative matcher keeping only the last star
    function match_segments(this, segs: ref[Array[TsGlobSegment]], s: Slice[char]) @ret_nonlocal true returns bool linked








































































    ; shouldIncludeMinJs: a files pattern leaves out `.min.js` unless it names `.min.`
    function should_include_min_js(this, filename: Slice[char], segs: ref[Array[TsGlobSegment]]) @ret_nonlocal true returns bool linked


















    function contains_text(s: Slice[char], t: Slice[char]) @ret_nonlocal true returns bool linked














    function is_hidden_path(name: Slice[char]) @ret_param_0 true returns bool linked






    ; isPackageFolder (EqualFold)
    function is_package_folder(name: Slice[char]) @ret_nonlocal true returns bool linked








    function equal_fold(a: Slice[char], b: Slice[char]) @ret_nonlocal true returns bool linked


















}

; vfsmatch.globMatcher
define TsGlobMatcher
(
    includes: ref[Array[ref[TsGlobPattern]]]
    excludes: ref[Array[ref[TsGlobPattern]]]
    had_includes: bool
)
{
    procedure create(host: ref[Page], mutable include_specs: ref[Array[Slice[char]]], mutable exclude_specs: ref[Array[Slice[char]]], mutable base_path: Slice[char], usage: int) @ret_explicit_0 true returns ref[TsGlobMatcher] linked






















    ; matchesFileParts: the index of the matching include, -1 for none
    function match_file(this, path: Slice[char]) @ret_nonlocal true returns int linked


























    ; matchesDirectoryParts
    function match_directory(this, path: Slice[char]) @ret_param_0 true returns bool linked





















}

; vfsmatch.globVisitor over the case's file table
define TsGlobVisitor
(
    host: ref[Page]
    files: ref[ProgramFiles]
    file_matcher: ref[TsGlobMatcher]
    directory_matcher: ref[TsGlobMatcher]
    extensions: ref[Array[Slice[char]]]
    visited: ref[Array[Slice[char]]]
    results: ref[Array[ref[Array[Slice[char]]]]]
)
{
    procedure visit(mutable this, path: Slice[char], absolute_path: Slice[char], resolved_real_path: Slice[char]) linked







































}

define TsConfigParser
(
    host: ref[Page]
    files: ref[ProgramFiles]
    current_directory: Slice[char]
    ; the first shape this port has not written (the case is then UNPORTED)
    var stop_tag: Slice[char]
    ; the conversion's diagnostics as (pos, end, code), pos -1 for a compiler
    ; diagnostic; null when nobody asked (slice 273)
    var diagnostics: ref[Array[int]]?
    var report_file: ref[AstNode]?
    var report_text: Slice[char]
    var reporting_next: bool
    ; the message arguments per diagnostic, beside `diagnostics`, and the ones the
    ; next report records
    var diagnostic_args: ref[Array[ref[Array[String]]?]]?
    var pending_args: ref[Array[String]]?
    ; ParseJsonSourceFileConfigFileContent's existingOptions and existingOptionsRaw
    ; (the driver's command line), and the last parse's answer
    var existing_options: ref[TsOptions]?
    var existing_raw: ref[JsonValue]?
    var last_parsed: ref[TsParsedCommandLine]?
    ; the driver keeps an extended config's reports too, each with its file (empty
    ; for the root config or none)
    var extended_reporting: bool
    var diagnostic_sources: ref[Array[Slice[char]]]?
    var source_path: Slice[char]
    var source_text: Slice[char]
    var last_json_diagnostics: ref[DiagnosticList]?
    ; the extended config files the current parse read
    var extended_files: ref[Array[Slice[char]]]
)
{
    function create(host: ref[Page], files: ref[ProgramFiles], current_directory: Slice[char]) @ret_explicit_0 true returns ref[TsConfigParser] linked


    procedure stop(mutable this, tag: Slice[char]) linked





    ; ── the harness's entry (test_case_parser.go) ────────────────────────────

    ; the first unit named tsconfig.json or jsconfig.json (GetConfigNameFromFileName),
    ; -1 for none
    function config_file_index(files: ref[ProgramFiles]) @ret_nonlocal true returns int linked














    function base_name_lower(path: Slice[char]) @page true @direct true @ret_param_0 true returns Slice[char] linked












    ; ParseJsonSourceFileConfigFileContent(config, host, configDir, nil, nil, configFileName)
    ; for the unit at `index`; null after a stop
    procedure parse_config_unit(mutable this, index: int) @page true @direct true @ret_caller true returns ref[TsParsedCommandLine]? io reads localized_messages linked













    ; GetConfigFileParsingDiagnostics for the harness's config (slice 273): the
    ; file's parse diagnostics, then ParseJsonSourceFileConfigFileContent's errors,
    ; as (pos, end, code) triples with pos -1 for a compiler diagnostic; null after
    ; a stop
    procedure config_file_diagnostics(mutable this, mutable config_file_name: Slice[char], mutable text: Slice[char]) @page true @direct true @ret_nonlocal true returns ref[Array[int]]? io reads localized_messages linked























































    ; ast.NewCompilerDiagnostic: kept from any config of the chain, since the
    ; reference appends an extended config's errors to its own
    procedure report_global(mutable this, code: int) linked












    ; the message arguments of the next report, copied onto host
    procedure stage(mutable this, a0: String) linked







    procedure stage(mutable this, a0: String, a1: String) linked









    procedure stage(mutable this, a0: String, a1: String, a2: String) linked











    procedure take_args(mutable this) @ret_param_0 true returns ref[Array[String]]? linked






    procedure record_source(mutable this, path: Slice[char]) linked








    ; the file of the `i`-th recorded diagnostic, empty for the root config
    function diagnostic_source_at(this, i: int) @page true @direct true @ret_param_0 true returns Slice[char] linked










    procedure record_args(mutable this, args: ref[Array[String]]?) linked








    ; the arguments of the `i`-th recorded diagnostic
    function diagnostic_args_at(this, i: int) @ret_param_0 true returns ref[Array[String]]? linked










    function arg_of(s: Slice[char]) @page true @direct true @ret_caller true returns String linked


    ; getCompilerOptionValueTypeString
    function option_type_text(kind: int, element_kind: int) @page true @direct true @ret_caller true returns String linked





















    ; CommandLineOption.Elements().Name
    function element_option_name(name: Slice[char]) @page true @direct true @ret_param_0 true returns Slice[char] linked








    ; core.StringifyJson of a raw spec list, an absent one as []
    function specs_json(specs: ref[JsonValue]?) @page true @direct true @ret_caller true returns String linked









































    ; ast.NewDiagnostic over a Loc of the config being converted (no trivia skipped)
    procedure report_range(mutable this, own: ref[TsOwnConfig], pos: int, end: int, code: int) linked














    ; CreateDiagnosticForNodeInSourceFileOrCompilerDiagnostic in the config being
    ; converted
    procedure report_node(mutable this, own: ref[TsOwnConfig], node: ref[AstNode]?, code: int) linked













    ; the worker's CreateDiagnosticForNodeInSourceFileOrCompilerDiagnostic, always
    ; in the root config
    procedure report_root_node(mutable this, node: ref[AstNode]?, code: int) linked





















    ; ForEachTsConfigPropArray's property: the initializer of the root object
    ; literal's first property named `key`
    function root_property_initializer(this, key: Slice[char]) @ret_param_0 true returns ref[AstNode]? linked






























    ; GetTsConfigPropArrayElementValue: the string literal `spec` in that array
    function prop_array_element_value(this, key: Slice[char], spec: Slice[char]) @ret_param_0 true returns ref[AstNode]? linked






















    ; the `index`th element of an array literal, null past its end
    function element_node_at(node: ref[AstNode]?, index: int) @ret_param_0 true returns ref[AstNode]? linked












    ; convertCompileOnSaveOptionFromJson: a boolean `compileOnSave` that is true
    function compile_on_save_of(raw: ref[JsonValue]?) @ret_caller true returns bool linked








    ; parser.ParseSourceFile(…, ScriptKindJSON); `out_errors` when the parse reported
    procedure parse_json(mutable this, file_name: Slice[char], mutable text: Slice[char], mutable out_errors: ref[bool]) @ret_param_0 true returns ref[AstNode]? linked

























    ; ── JSON values ──────────────────────────────────────────────────────────

    function new_value(this, kind: int, text: Slice[char], truth: bool) @ret_nonlocal true returns ref[JsonValue] linked


    function new_object(this) @ret_nonlocal true returns ref[JsonValue] linked


    function new_array(this) @ret_nonlocal true returns ref[JsonValue] linked


    ; OrderedMap.Set: a key already present keeps its place and takes the value
    procedure json_set(this, mutable obj: ref[JsonValue], key: Slice[char], value: ref[JsonValue]) linked


















    function object_has(obj: ref[JsonValue], key: Slice[char]) @ret_nonlocal true returns bool linked














    ; convertConfigFileToObject: the root value, the first object of a root array
    ; literal, else an empty map
    procedure convert_config_file(mutable this, file: ref[AstNode], mutable own: ref[TsOwnConfig]) @ret_nonlocal true returns ref[JsonValue] io reads localized_messages linked




































    ; convertPropertyValueToJson; Go's nil is a JsonKindNull value. `has_option`:
    ; the value's key names an option (the report for a value that is not JSON);
    ; `notify`: its object's properties reach onPropertySet
    procedure convert_value(mutable this, node: ref[AstNode]?, level: int, has_option: bool, notify: bool, mutable own: ref[TsOwnConfig]) @ret_nonlocal true returns ref[JsonValue] io reads localized_messages linked





































    ; convertObjectLiteralExpressionToJson with the notifier of `level` (none below
    ; an array: `notify` false)
    procedure convert_object(mutable this, node: ref[AstNode], level: int, notify: bool, mutable own: ref[TsOwnConfig]) @ret_nonlocal true returns ref[JsonValue] io reads localized_messages linked






















































































































    ; tsconfigRootOptionsMap's kinds (extends aside), 0 for a key it does not declare
    function root_option_kind(key: Slice[char]) returns int linked


















    ; CommandLineOption.Elements() of a root option
    function root_option_element_kind(key: Slice[char]) returns int linked






    ; typeAcquisitionDecls' kinds, 0 for a key they do not declare
    function type_acquisition_option_kind(key: Slice[char]) returns int linked












    ; the same under CommandLineOptionNameMap.Get's lower-cased second lookup
    function type_acquisition_option_name_folded(key: Slice[char]) @page true @direct true @ret_param_0 true returns Slice[char] linked












    function type_acquisition_option_kind_folded(key: Slice[char]) returns int linked












    ; CommandLineCompilerOptionsMap.Get: a declaration whose name matches `key` up to
    ; ASCII case, -1 for none
    function compiler_option_index_folded(key: Slice[char]) returns int linked













    ; convertJsonOption's reports for an option of `kind` (declaration `i`, -1 for a
    ; root or type-acquisition option); the conversion itself is convert_json_option
    procedure report_value_type(mutable this, own: ref[TsOwnConfig], name: Slice[char], kind: int, element_kind: int, value_node: ref[AstNode]?) @ret_nonlocal true linked





    procedure check_json_option(mutable this, own: ref[TsOwnConfig], name: Slice[char], i: int, kind: int, element_kind: int, value: ref[JsonValue], name_node: ref[AstNode]?, value_node: ref[AstNode]?) linked








































































    ; convertJsonOptionOfEnumType's report: a non-empty key not in the enum map
    procedure check_enum_value(mutable this, own: ref[TsOwnConfig], i: int, text: Slice[char], value_node: ref[AstNode]?) linked
















    ; convertArrayLiteralExpressionToJson (no notifier below an array): nil elements
    ; dropped, an empty literal an empty slice, all dropped a nil one
    procedure convert_array(mutable this, node: ref[AstNode], level: int, has_option: bool, mutable own: ref[TsOwnConfig]) @ret_nonlocal true returns ref[JsonValue] io reads localized_messages linked




















    ; onPropertySet's root arm for `extends`
    procedure set_extends(mutable this, mutable own: ref[TsOwnConfig], value: ref[JsonValue], value_node: ref[AstNode]?) io reads localized_messages linked





    ; onPropertySet's compilerOptions arm: convertJsonOption, then ParseCompilerOptions
    procedure on_compiler_option(mutable this, mutable own: ref[TsOwnConfig], key: Slice[char], value: ref[JsonValue]) linked










    ; convertJsonOption for a compiler option
    procedure convert_json_option(mutable this, i: int, value: ref[JsonValue], base_path: Slice[char]) @ret_param_2 true returns ref[JsonValue] linked


































    ; convertJsonOptionOfListType: each element through the element declaration, the
    ; falsy ones dropped unless the option keeps them
    procedure convert_json_list(mutable this, i: int, value: ref[JsonValue], base_path: Slice[char]) @ret_param_2 true returns ref[JsonValue] linked





































    ; convertJsonOptionOfEnumType: the lower-cased key's value (the key itself, or a
    ; lib's file name), nil for an empty or unknown key
    procedure convert_enum(mutable this, i: int, text: Slice[char]) @ret_nonlocal true returns ref[JsonValue] linked










    ; normalizeNonListOptionValue for a file path
    procedure normalize_file_path_value(mutable this, value: ref[JsonValue], base_path: Slice[char]) @ret_nonlocal true returns ref[JsonValue] linked












    function to_lower(host: ref[Page], s: Slice[char]) @page true @direct true returns Slice[char] linked














    ; startsWithConfigDirTemplate (case-insensitive)
    function starts_with_config_dir_template(s: Slice[char]) @ret_nonlocal true returns bool linked






    ; ParseCompilerOptions: the field's parse by its kind; a value the parse turns
    ; into the zero value unsets the field
    procedure parse_compiler_option(host: ref[Page], mutable options: ref[TsOptions], i: int, converted: ref[JsonValue]) linked














































    ; ── extends ──────────────────────────────────────────────────────────────

    ; getExtendsConfigPathOrArray
    procedure get_extends_config_path_or_array(mutable this, own: ref[TsOwnConfig], value: ref[JsonValue], value_node: ref[AstNode]?, base_path: Slice[char], config_file_name: Slice[char]) @ret_nonlocal true returns ref[Array[Slice[char]]] io reads localized_messages linked












































    ; getExtendsConfigPath: a rooted or relative path (with `.json` added when the
    ; name as written is absent), else a module resolved by ResolveConfig
    procedure get_extends_config_path(mutable this, own: ref[TsOwnConfig], extended_config: Slice[char], base_path: Slice[char], value_node: ref[AstNode]?) @page true @direct true returns Slice[char] io reads localized_messages linked















































