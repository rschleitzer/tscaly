; SPDX-License-Identifier: Apache-2.0
;
; HashCheck — the SECOND PRODUCER for XXH3-64, and it exists for NumCheck's
; reason one level over: no corpus of TypeScript sources can reach a hash.
;
; `Xxh3.hash64` decides the FILE THREAD IDS of every `--generateTrace` run
; (`1000000 + hash64("file:" + path) % 1000000000`), and the two trace baselines
; exercise exactly two inputs of one length class. The algorithm has six length
; classes — 0, 1..3, 4..8, 9..16, 17..128, 129..240 and the accumulator loop past
; 240, with a block boundary at 1024 — and an arm no input reaches is
; indistinguishable from a correct one. So: one generated corpus, two producers,
; a byte diff. tests/hashcheck.sh runs both.
;
; One line of the corpus is one INPUT STRING, verbatim; one line of output is the
; sixteen lowercase hex digits of its digest.
;
; It lives in the PACKAGE rather than the program root for NumCheck's reason: the
; accumulator is a container, and a generic instance handed to a program root
; reads back as garbage.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console
use tscaly.xxh3.Xxh3

define HashCheck
{
    procedure run(host: ref[Page], text: String) @ret_nonlocal true @deep true io linked
}
