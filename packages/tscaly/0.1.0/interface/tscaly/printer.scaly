}

; ── textwriter.go + singlelinestringwriter.go ───────────────────────────────
;
; The builder is page-hosted (StringBuilder allocates through `^this`), so a
; writer is made by `TextWriter.create(host, ...)` and never on a frame; `clear`
; takes the host for the same reason.
define TextWriter
(
    new_line: Slice[char]
    indent_size: int
    single_line: bool
    var sb: ref[StringBuilder]
    var last_rune: int
    var indent: int
    var line_start: bool
    var line_count: int
    var line_pos: int
    var has_trailing_comment_state: bool
    ; UTF-16 code units written since the line start — the reference computes
    ; `UTF16Len(text[linePos:])` off its builder's bytes on every GetColumn; the
    ; builder's buffer is not reachable through a reference here, so the count
    ; is kept as the writes happen (a line terminator inside a write restarts it).
    var line_units: int
)
{
    function create(host: ref[Page], new_line: Slice[char], indent_size_in: int) @ret_explicit_0 true @deep true returns ref[TextWriter] linked








    ; GetSingleLineStringWriter — the pooled single-line writer, one per call here.
    function create_single_line(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[TextWriter] linked






    procedure clear(mutable this, host: ref[Page]) @deep true linked












    procedure increase_indent(mutable this) @deep true linked






    procedure decrease_indent(mutable this) @deep true linked






    function get_indent(this) @ret_param_0 true @deep true returns int linked


    function get_line(this) @ret_param_0 true @deep true returns int linked


    function get_text_pos(this) @ret_param_0 true @deep true returns int linked


    function to_string(this) @page true @direct true @ret_caller true @deep true returns String linked


    function is_at_start_of_line(this) @ret_param_0 true @deep true returns bool linked


    function has_trailing_comment(this) @ret_param_0 true @deep true returns bool linked


    ; HasTrailingWhitespace — the last rune written, decoded once at the write.
    function has_trailing_whitespace(this) @ret_nonlocal true @deep true returns bool linked








    ; GetColumn — UTF-16 code units from the line start; the indent alone at a
    ; line start (nothing has been written on the line yet).
    function get_column(this) @ret_param_0 true @deep true returns int linked








    ; core.UTF16Len over a view's bytes [from, to): one unit per lead byte, two
    ; for a four-byte sequence.
    function utf16_len_of(s: Slice[char], from: int, to: int) @ret_nonlocal true @deep true returns int linked

















    ; The last ECMA line start inside a view, or -1 when it has no terminator.
    function last_line_start_in(s: Slice[char]) @ret_nonlocal true @deep true returns int linked













































    ; The last rune of a view, for has_trailing_whitespace; -1 for an empty view.
    function last_rune_of(s: Slice[char]) @ret_param_0 true @deep true returns int linked














    procedure append_view(mutable this, s: Slice[char]) @deep true linked










    ; updateLineCountAndPosFor — count the ECMA line starts of `s` (LF, CR, CRLF,
    ; LS, PS); the first start is position 0 and always there, so a count above
    ; one means a terminator was written.
    procedure update_line_count_and_pos_for(mutable this, s: Slice[char]) @deep true linked

























































    procedure raw_write(mutable this, s: Slice[char]) @deep true linked














    procedure write_indent(mutable this) @deep true linked










    procedure write_text(mutable this, s: Slice[char]) @deep true linked

















    procedure write(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked






    procedure write_comment(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked









    procedure write_keyword(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_operator(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_punctuation(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_space(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_string_literal(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_parameter(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_property(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_symbol(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_literal(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_trailing_semicolon(mutable this, s: Slice[char]) @ret_nonlocal true @deep true linked


    procedure write_line_raw(mutable this) @deep true linked









    procedure write_line(mutable this) @deep true linked










    procedure write_line_force(mutable this, force: bool) @deep true linked










    function get_default_indent_size() @ret_nonlocal true @deep true returns int linked

}

; ── utilities.go ────────────────────────────────────────────────────────────
;
; The statics of the printer package. `Printer` grows its fields when printer.go
; is ported (slice 232); until then it carries one so that it is a STRUCTURE and
; its functions are statics mangled under its name — a define without fields is
; a namespace whose functions are FREE and mangle without it, and the first such
; name that also names a static elsewhere (`node_is_missing` in the parser and
; the binder) took the link down (slice 230).
; ═══ printer.go (slice 233): the printer's infrastructure ══════════════════
;
; The record, its options, the writer plumbing, the line-terminator arithmetic,
; the comment and source-map machinery, the list emitter, the name-generation
; walk and the scoped enter/exit pairs. The per-kind emitters (printer.go's
; middle, lines 1348-4695) land in slices 234 and 235; until then every arm of
; the dispatch that reaches one records an `emit-kind` stop (§0.7: a stop is
; said, never silent) — `emit_unported` below is the one place they meet.
;
; ★ Four func values become tags (§3.18): the six PrintHandlers hooks are
; `handlers_tag` (none until the emitter installs them), `HasGlobalName` is
; `has_global_name_tag`, and the `emit func(p, node)` a list emitter receives
; is an EmitTag* dispatched by `emit_tagged`. The name generator's two
; callbacks are the printer itself (`NameGenerator.printer`, the route slice
; 232 owed).
;
; ★ `*ast.SourceFile` as the CURRENT FILE is `SourceFileInfo` (§3.40): the
; port's file text, line map, file name and declaration-file flag live with
; the binder and the parser, not on the node, so the printer takes the things
; it reads as one record the emitter builds.
;
; ★ The source-map generator is internal/sourcemap/generator.go (slice 247):
; the VLQ mappings, the sources relative to the map's directory, the JSON and
; its base64 data URL. The JS-only yardstick hands the printer no generator.

