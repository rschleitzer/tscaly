; The five things the printer reads off `*ast.SourceFile` (§3.40), plus the
; parser's identifier table, which the emitter fills from the tree.
define SourceFileInfo
@resident true @inplace true (
    var node: ref[AstNode]
    file_name: Slice[char]
    text: Slice[char]
    line_starts: ref[Array[int]]
    is_declaration_file: bool
    script_kind: int
    is_external_module: bool
    var identifiers: ref[Array[Slice[char]]]?
    ; whether a null `identifiers` is collected on the first question (the
    ; program's emit) or stays the empty set (the case harness's file info)
    collect_identifiers: bool
)
{
    ; `sourceFile.Identifiers[name]`. The set is collected on the first question
    ; (slice 331): only the emitter's name generation asks, and collecting it for
    ; every file of a --noEmit program was ~200 MB on ganz VS Code
    procedure has_identifier(mutable this, name: Slice[char]) @ret_nonlocal true @deep true @deep_pageof_1 true returns bool linked












}

