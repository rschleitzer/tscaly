; core.TextRange — a (pos, end) pair by value. `UndefinedTextRange` is (-1, -1).
define TextRange
(
    pos: int
    end: int
)
{
    function undefined_range() @page true @direct true @ret_nonlocal true @deep true returns TextRange linked


    function len(this) @ret_param_0 true @deep true returns int linked


    function is_valid(this) @ret_param_0 true @deep true returns bool linked


    function contains(this, p: int) @ret_nonlocal true @deep true returns bool linked


    function contains_inclusive(this, p: int) @ret_nonlocal true @deep true returns bool linked


    function contains_exclusive(this, p: int) @ret_param_0 true @deep true returns bool linked


    function with_pos(this, p: int) @page true @direct true @ret_param_0 true @deep true returns TextRange linked


    function with_end(this, e: int) @page true @direct true @ret_param_0 true @deep true returns TextRange linked


    function contained_by(this, other: TextRange) @ret_param_1 true @deep true returns bool linked


    function overlaps(this, other: TextRange) @ret_args_3 true @deep true returns bool linked










    ; Overlaps that treats touching ranges as intersecting: [0, 5) meets [5, 10).
    function intersects(this, other: TextRange) @ret_args_3 true @deep true returns bool linked










