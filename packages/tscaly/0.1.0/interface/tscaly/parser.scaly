    function compare_bytes(a: Slice[char], b: Slice[char]) @ret_nonlocal true @deep true returns int linked



















    function has_keyword_suggestion(this, text: Slice[char]) @ret_nonlocal true @deep true returns bool linked






    ; The reference compares Go strings; here a name is a pointer and a length
    ; and a keyword is a C literal, so the comparison is spelled out. It is the
    ; scanner's old `text_equals` asked of an arbitrary buffer rather than of
    ; the source — which is the whole of what slice 17 changed about this
    ; family, and why that one is gone with the source reads it served.
    function text_matches(text: Slice[char], word: Slice[char]) @ret_nonlocal true @deep true returns bool linked













    ; ... and the same question about a PREFIX, which is what getSpaceSuggestion
    ; asks: does the name BEGIN with this keyword.
    function text_starts_with(text: Slice[char], word: Slice[char]) @ret_nonlocal true @deep true returns bool linked













    ; getSpaceSuggestion — the identifier begins with a keyword and is more than
    ; two characters longer than it, so the user probably left out a space.
    ; The reference measures in BYTES on both sides, and so does this.
    function has_space_suggestion(this, text: Slice[char]) @ret_nonlocal true @deep true returns bool linked















    function has_spelling_suggestion(this, text: Slice[char]) @ret_nonlocal true @deep true returns bool linked



























































    function name_matches_ascii(name: Slice[int], cand: Slice[char]) @ret_nonlocal true @deep true returns bool linked













    ; core.levenshteinWithMax, ported with its weights intact: a substitution
    ; between two characters that differ only by CASE costs 0.1, any other
    ; substitution costs 2, and an insertion or deletion costs 1. Answers -1
    ; where the reference answers "undefined" — the whole column exceeded the
    ; budget, so no later column can rescue it.
    ;
    ; The two row buffers are stack arrays swapped by POINTER, which is the
    ; reference's `previous, current = current, previous`. Sized for the longest
    ; candidate plus one; the candidate set is the keyword table, whose longest
    ; entry is eleven characters.
    function levenshtein_with_max(s1: pointer[int], n1: int, s2: Slice[char], max_value: double) @deep true returns double linked














































































    ; unicode.ToLower, ASCII only. Every candidate is an all-lowercase ASCII
    ; keyword, so a fold can only matter when a character of the NAME lowercases
    ; INTO an ASCII letter — and U+212A KELVIN SIGN is the only code point in
    ; Unicode that does. That one character is where this differs from the
    ; reference, and it differs by making one substitution cost 2 instead of 0.1.
    function ascii_to_lower(c: int) @ret_nonlocal true @deep true returns int linked









    ; math.Ceil / math.Floor, to int. A cast TRUNCATES toward zero, which is
    ; floor for a non-negative value and ceil for a negative one — and both call
    ; sites can be negative, so neither is a cast on its own.
    function ceil_to_int(x: double) @ret_nonlocal true @deep true returns int linked







    function floor_to_int(x: double) @ret_nonlocal true @deep true returns int linked







