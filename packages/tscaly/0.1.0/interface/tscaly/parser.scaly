    ; tryParseTypeExpression — a type is present only if a `{` follows.
    procedure try_parse_type_expression(mutable this) @page true @returnpage true @deep true returns ref[AstNode]? linked









    ; parseBracketNameInPropertyAndParamTag — `[foo]`, `foo`, `[foo.bar]`,
