    ;
    ; `out_end` is the reference's NodeList TextRange end, handed back because a
    ; JsxElement stores it (§3.6's out-parameter answer for a multi-return, and
    ; the scalar direction, which is the safe one).
    procedure parse_jsx_children(mutable this, opening_tag: ref[AstNode], mutable out_end: ref[int]) @ret_param_0 true @deep true returns ref[Array[ref[AstNode]?]]? linked






































