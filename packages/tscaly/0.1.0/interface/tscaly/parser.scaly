    procedure cparts_remove_trailing_whitespace(this, mutable a: ref[Array[int]], first: int, count: int) @ret_nonlocal true @deep true returns int linked



















    ; removeLeadingNewlines — `strings.TrimLeft(comments[i], "\r\n") == ""`, so
    ; a part of SPACES is not empty here and is not dropped. Answers the new
