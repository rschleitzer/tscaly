; SPDX-License-Identifier: Apache-2.0
;
; SymbolDump — our half of the binder yardstick's dump.
;
; ★★★ THIS IS NOT A PORT OF ANYTHING. The format is OURS, invented with
; tests/oracle/symbols.go;
; this file is the second producer of it. It lives inside the package rather than
; in the dumper PROGRAM for a reason: the numbering
; needs containers (an ordered symbol list, a pointer-keyed index, a sorted view of
; each table), and a generic instance handed across a package boundary reads back
; as garbage. So the program root asks for the whole dump in one call and prints
; nothing itself.
;
; ── What the numbering has to get right ─────────────────────────────────────
;
; ★★★ SYMBOL IDENTITY is what the yardstick compares, so the two sides must
; DISCOVER symbols in the same sequence — an index is only comparable if the order
; that assigns it is the same. The sequence is:
;
;   1. the pre-order walk, for every node that owns a symbol;
;   2. then every LOCALS table's entries, table by table in id order, each table
;      name-sorted — the oracle learned this the hard way: a locals table can name
;      a symbol no walked node owns (the reference synthesizes some), and numbering
;      those while the tables were being PRINTED left 24 of 296 fixtures
;      referencing an index that was never defined;
;   3. then, per symbol in index order: its PARENT (during the `s` line, because
;      Go evaluates that argument first), its export symbol (the `x` line), then
;      its members' entries and its exports' entries, each name-sorted.
;
; Table ids come from ONE counter: locals tables as the walk meets them, then a
; symbol's members and exports as its `s` line is written. Assignment order is
; therefore ascending, which is why the tables are printed in the order they were
; collected rather than sorted afterwards.
;
; ★ THE TABLES ARE SORTED BY NAME because the reference's SymbolTable is a Go map
; with a randomised iteration order — there is no order to compare. That is the one
; normalisation in this dump, and the count printed beside each table is what keeps
; it from hiding a missing entry.
;
; ★★ THE SORT IS ON UNSIGNED BYTES, and that is not a detail: an internal symbol
; name begins with 0xFE, which sorts AFTER every ASCII name unsigned and BEFORE all
; of them signed. Go compares strings bytewise unsigned, so `char` is widened
; through u8 here at every comparison.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.Vector
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console
use tscaly.ast.AstNode
use tscaly.ast.Symbol
use tscaly.ast.SymbolTable
use tscaly.ast.SymbolTableEntry
use tscaly.binder.Binder

; One table to print: its id, its owner's table object.
define DumpTable (id: int  table: ref[SymbolTable])
{
    init(i: int, t: ref[SymbolTable]) linked
}

define SymbolDump
(
    host: ref[Page]
    out: ref[StringBuilder]

    ; The symbol registry: the ORDER is the answer, and the buckets are only there
    ; to find a symbol's index without walking the order for every question.
    sym_order: ref[Array[ref[Symbol]?]]
    var buckets: ref[Vector[int]]?     ; index + 1 into sym_order; 0 = empty
    var mask: int

    tables: ref[Array[DumpTable]]
    var table_count: int
)
{
    ; The entry point the dumper program calls: bind's results in, one dump out,
    ; written to stdout in one write.
    procedure write(host: ref[Page], b: ref[Binder], file: ref[AstNode]) @ret_nonlocal true @deep true io linked

    ; ── the registry ────────────────────────────────────────────────────────
    ;
    ; Assign-on-demand over the symbol POINTER. Open addressing on the pointer's
    ; own bits — a pointer is not a hash, so the low bits (always aligned) are
    ; shifted out first.
    procedure index_of(mutable this, s: ref[Symbol]?) @persists true @ret_param_0 true @deep true @deep_this_2 true @deep_whole_2 true returns int linked

    function pointer_hash(s: ref[Symbol]?) @ret_param_0 true @deep true returns int linked

    procedure new_table_id(mutable this) @ret_param_0 true @deep true returns int linked

    procedure collect_table(mutable this, id: int, t: ref[SymbolTable]) @persists true @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true linked

    ; ── section 1: the walk ─────────────────────────────────────────────────
    procedure walk(mutable this, n: ref[AstNode]?) @deep true @deep_this_2 true linked

    procedure emit_node_line(mutable this, n: ref[AstNode], sym_idx: int, locals_idx: int) @ret_nonlocal true @deep true linked

    procedure append_opt(mutable this, v: int) @deep true linked

    ; ── the second numbering pass ───────────────────────────────────────────
    ;
    ; Every locals table's entries, in table order, name-sorted. See the header for
    ; the defect this exists to prevent.
    procedure number_collected_tables(mutable this) @deep true linked

    procedure number_table_entries(mutable this, t: ref[SymbolTable]?) @deep true linked

    ; ── sections 2 and 3: the symbols and their declarations ────────────────
    ;
    ; The list GROWS while it is walked, and the loop re-reads its length for that
    ; reason: a symbol reachable only through another symbol's table gets its index
    ; here and its own `s` line later in the same pass.
    procedure emit_symbols(mutable this) @deep true linked

    ; ── section 4: the tables ───────────────────────────────────────────────
    ;
    ; In COLLECTION order, which is ascending id order because one counter assigns
    ; them — the oracle sorts by id and arrives at the same sequence.
    procedure emit_tables(mutable this) @deep true linked

    ; ── section 5: the file totals and the bind diagnostics ─────────────────
    procedure emit_file_totals(mutable this, b: ref[Binder]) @deep true linked

    procedure emit_bind_diagnostics(mutable this, b: ref[Binder]) @deep true linked

    ; ── the two orderings ───────────────────────────────────────────────────
    ;
    ; A permutation of a table's entry indices, sorted by NAME. Bottom-up MERGE
    ; sort rather than an insertion sort, and the reason is a measurement: the
    ; largest locals table in the stage-2 corpus holds 5000 entries, where an
    ; insertion sort is 12.5 million moves. Merge sort is also stable, so the
    ; permutation of two equal keys is decided by the entry order rather than by
    ; luck — a table cannot hold two equal names, so that is a property nothing
    ; depends on and it costs nothing to have.
    function sorted_order(this, t: ref[Vector[ref[SymbolTableEntry]?]]) @ret_nonlocal true @deep true returns ref[Array[int]] linked

    function compare_table_names(this, t: ref[Vector[ref[SymbolTableEntry]?]], i: int, j: int) @ret_nonlocal true @deep true returns int linked

    function snapshot_symbol(t: ref[Vector[ref[SymbolTableEntry]?]], i: int) @ret_nonlocal true @deep true returns ref[Symbol]? linked

    function snapshot_name(t: ref[Vector[ref[SymbolTableEntry]?]], i: int) @ret_nonlocal true @deep true returns Slice[char] linked

    ; The same ordering over the binder's classifiable-name set, which is a
    ; SymbolTable used as a set — so the sort is the one above, over that table.
    function sorted_classifiable(this, b: ref[Binder]) @ret_nonlocal true @deep true returns ref[Array[int]] linked

    ; Bytewise, UNSIGNED, shorter-is-less on a prefix — Go's own string order.
    function compare_names(ad: Slice[char], bd: Slice[char]) @ret_nonlocal true @deep true returns int linked

    ; ── the escape ──────────────────────────────────────────────────────────
    ;
    ; Every byte outside 0x21..0x7E, and `%` itself, becomes %XX with UPPERCASE
    ; hex. An empty name is `%00`, because a field has to be a field.
    procedure append_escaped(mutable this, d: Slice[char]) @deep true linked

    function hex_digit(v: int) @ret_nonlocal true @deep true returns char linked
}
