; SPDX-License-Identifier: Apache-2.0
;
; diagnosticwriter — internal/diagnosticwriter/diagnosticwriter.go: a diagnostic as a
; terminal prints it (the plain `file(line,col): error TSn: message` line and the
; pretty form with its colours, code snippet and related information), the error
; summary, and diagnostics.Format.
;
; ★ A driver diagnostic carries its file's NAME and TEXT rather than a source file:
; everything the writer asks of `FileLike` is those two and the ECMA line map, which
; is computed from the text where the reference caches it on the file.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.Diagnostics.ChainLine
use tscaly.DiagnosticMessages.DiagnosticMessages
use tscaly.printer.Printer
use tscaly.printer.TextWriter
use tscaly.program.JsonValue
use tscaly.program.JsonParser
use tscaly.inflate.Inflate
use scaly.os.File

; the translated messages of the command line's locale (the reference's
; getLocalizedMessages table), null for English
mutable localized_messages: ref[JsonValue]? linked

; diagnostics.Localize's text lookup
define Localization (reserved: int)
{
    ; a message's text in the current locale
    procedure text_of(code: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] reads localized_messages linked















    procedure reset() @deep true mutable localized_messages reads localized_messages linked


    ; language.NewMatcher over the reference's translations: the file of a locale
    ; whose messages are translated, empty for English
    function translation_file(host: ref[Page], locale: Slice[char]) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked




































    function lower(host: ref[Page], s: Slice[char]) @page true @direct true @ret_explicit_0 true @deep true returns Slice[char] linked















    function contains(s: Slice[char], part: Slice[char]) @ret_nonlocal true @deep true returns bool linked











    ; the embedded translation of a locale (internal/diagnostics/loc/<file>.json.gz)
    ; loaded as the current table; false when it cannot be read
    procedure load(host: ref[Page], file: Slice[char]) @ret_nonlocal true @deep true returns bool io mutable localized_messages reads localized_messages linked
































}

define DriverDiagnostic
(
    ; the file's name, empty for a diagnostic without a file
    file_name: Slice[char]
    text: Slice[char]
    pos: int
    end: int
    code: int
    args: ref[Array[String]]?
    chain: ref[Array[ChainLine]]?
    var related: ref[Array[ref[DriverDiagnostic]]]?
)
{
    function has_file(this) @ret_param_0 true @deep true returns bool linked


    function category(this) @ret_nonlocal true @deep true returns int linked

}

define DiagnosticWriter (reserved: int)
{
    ; diagnostics.Format over the message table's text
    procedure format_message(code: int, args: ref[Array[String]]?) @page true @direct true @ret_caller true @deep true returns String reads localized_messages linked







































    ; strings.ToValidUTF8(s, "\uFFFD"): each run of invalid bytes one replacement
    procedure append_valid_utf8(mutable sb: ref[StringBuilder], s: Slice[char]) @deep true linked














































































    function byte_at(s: Slice[char], i: int) @deep true returns int linked


    ; diagnostics.Category.Name
    function category_name(category: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked










    ; getCategoryFormat
    function category_format(category: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked










    ; WriteFlattenedDiagnosticMessage
    procedure write_flattened_message(mutable out: ref[StringBuilder], d: ref[DriverDiagnostic], new_line: Slice[char]) @deep true reads localized_messages linked





















    ; the ECMA line of `pos` over `starts`
    function line_of(starts: ref[Array[int]], pos: int) @ret_nonlocal true @deep true returns int linked














    ; tspath.ConvertToRelativePath
    procedure relative_file_name(host: ref[Page], mutable file_name: Slice[char], mutable cwd: Slice[char]) @page true @direct true @ret_args_3 true @deep true returns Slice[char] linked






    procedure write_with_style(mutable out: ref[StringBuilder], text: Slice[char], style: Slice[char]) @ret_nonlocal true @deep true linked






    ; WriteLocation
    procedure write_location(host: ref[Page], mutable out: ref[StringBuilder], mutable d: ref[DriverDiagnostic], pos: int, mutable cwd: Slice[char]) @ret_nonlocal true @deep true linked

















    procedure repeat_char(mutable out: ref[StringBuilder], c: char, n: int) @deep true linked









    ; `%*d` and `%*s`: right-aligned in `width`
    procedure write_padded(mutable out: ref[StringBuilder], text: String, width: int) @ret_nonlocal true @deep true linked





    function digits_of(n: int) @ret_caller true @deep true returns int linked






    function is_space_byte(c: int) @ret_nonlocal true @deep true returns bool linked


    ; writeCodeSnippet
    procedure write_code_snippet(host: ref[Page], mutable out: ref[StringBuilder], d: ref[DriverDiagnostic], start: int, length: int, squiggle_color: Slice[char], indent: Slice[char], new_line: Slice[char]) @deep true linked



















































































    ; FormatDiagnosticWithColorAndContext
    procedure format_with_color_and_context(host: ref[Page], mutable out: ref[StringBuilder], mutable d: ref[DriverDiagnostic], mutable cwd: Slice[char], new_line: Slice[char]) @deep true reads localized_messages linked









































    ; WriteFormatDiagnostic
    procedure write_format_diagnostic(host: ref[Page], mutable out: ref[StringBuilder], mutable d: ref[DriverDiagnostic], mutable cwd: Slice[char], new_line: Slice[char]) @ret_nonlocal true @deep true reads localized_messages linked























    ; prettyPathForFileError over the file's first error
    procedure pretty_path_for_file_error(host: ref[Page], mutable out: ref[StringBuilder], mutable d: ref[DriverDiagnostic], mutable cwd: Slice[char]) @ret_nonlocal true @deep true linked












    ; WriteErrorSummaryText
    procedure write_error_summary(host: ref[Page], mutable out: ref[StringBuilder], diags: ref[Array[ref[DriverDiagnostic]]], mutable cwd: Slice[char], new_line: Slice[char]) @deep true reads localized_messages linked















































































































    ; writeTabularErrorsDisplay
    procedure write_tabular_errors(host: ref[Page], mutable out: ref[StringBuilder], mutable files: ref[Array[ref[DriverDiagnostic]]], counts: ref[Array[int]], mutable cwd: Slice[char], new_line: Slice[char]) @deep true reads localized_messages linked




































    function compare_bytes(a: Slice[char], b: Slice[char]) @ret_nonlocal true @deep true returns int linked




















}
