    procedure emit_diagnostics(mutable this) returns ref[JsonValue] linked
















    ; setAffectedFilesPendingEmit
    procedure affected_files_pending_emit(mutable this) returns ref[JsonValue] linked
































    ; toBuildInfoDiagnosticsOfFile, null when there are none
    procedure diagnostics_of_file(mutable this, mutable path: Slice[char], mutable d: ref[IncDiagnostics]) returns ref[JsonValue]? linked











































    procedure put_common(mutable this, mutable o: ref[JsonValue], pos: int, end: int, code: int, args: ref[Array[String]]?) linked
































    procedure put_flags(mutable this, mutable o: ref[JsonValue], code: int) linked







    ; RepopulateModuleNotFound's info: the module reference, the mode, the package name
    procedure put_module_not_found_info(host: ref[Page], mutable o: ref[JsonValue], data: ref[Array[String]]) linked
















    ; RepopulateInfo: createModeMismatchDetails' four messages carry RepopulateModeMismatch
    procedure put_repopulate_info(host: ref[Page], mutable o: ref[JsonValue], code: int) linked









    ; toBuildInfoDiagnosticsFromDiagnostics: one diagnostic of `own`
    procedure diagnostic_json(mutable this, own: Slice[char], mutable d: ref[DriverDiagnostic]) returns ref[JsonValue] linked






































    ; the chain lines of `level` from `cursor` as a message chain tree; each line
    ; carries its head's file and range
    procedure chain_json(mutable this, head: ref[DriverDiagnostic], lines: ref[Array[ChainLine]], level: int, mutable cursor: ref[int]) returns ref[JsonValue] linked































    ; toBuildInfoDiagnosticsFromFileNameDiagnostics
    procedure build_info_diagnostic_json(mutable this, mutable d: ref[IncBuildInfoDiagnostic]) returns ref[JsonValue] linked











































































}

; ReadBuildInfoProgram and buildInfoToSnapshot
define ToSnapshot
(
    host: ref[Page]
    info: ref[JsonValue]
    directory: Slice[char]
    file_paths: ref[Array[Slice[char]]]
    file_path_sets: ref[Array[ref[Array[Slice[char]]]]]
    snapshot: ref[IncSnapshot]
)
{
    ; the old program's snapshot, null when there is no usable build info
    procedure read(host: ref[Page], mutable program: ref[DriverProgram]) @page true @direct true returns ref[IncSnapshot]? io linked
























    function file_path(this, id: int) @page true @direct true returns Slice[char] linked


    procedure convert(mutable this, program: ref[DriverProgram]) linked










































































































    procedure absolute_list(mutable this, v: ref[JsonValue]?) returns ref[Array[Slice[char]]] linked















    ; GetCompilerOptions(buildInfoDirectory): file paths made absolute
    procedure set_compiler_options(mutable this, cwd: Slice[char]) linked































    procedure set_file_info_and_emit_signatures(mutable this) linked








































































    procedure set_semantic_diagnostics(mutable this) linked




























    procedure diagnostics_list(this, v: ref[JsonValue]?) returns ref[IncDiagnostics] linked















    procedure diagnostic_list_of(this, v: ref[JsonValue]?) returns ref[Array[ref[IncBuildInfoDiagnostic]]]? linked














    procedure diagnostic(this, d: ref[JsonValue]) returns ref[IncBuildInfoDiagnostic] linked






















