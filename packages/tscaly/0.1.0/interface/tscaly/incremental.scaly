define SignatureUpdateKindComputedDts: int 0
define SignatureUpdateKindStoredAtEmit: int 1
define SignatureUpdateKindUsedVersion: int 2

; a map keyed by path: parallel key and value lists and a live bit per slot
define PathMap[T] (keys: ref[Array[Slice[char]]]  values: ref[Array[T]]  live: ref[Array[bool]])
{
    function slot_of(this, key: Slice[char]) returns int
    {
        var i 0
        while i < (keys.get_length() as int)
        {
            if live.get(i as size_t) <> null
            {
                let alive live[i as size_t]
                if alive
                {
                    let k keys[i as size_t]
                    if k.equals(key)
                        return i
                }
            }
            set i: i + 1
        }
        0 - 1
    }

    function has(this, key: Slice[char]) returns bool
        this.slot_of(key) >= 0

    function slot_count(this) returns int
        keys.get_length() as int

    function is_live(this, i: int) returns bool
        live[i as size_t]

    function key_at(this, i: int) returns Slice[char]
        keys[i as size_t]

    function value_at(this, i: int) returns T
        values[i as size_t]

    function size(this) returns int
    {
        var n 0
        var i 0
        while i < (keys.get_length() as int)
        {
            let alive live[i as size_t]
            if alive
                set n: n + 1
            set i: i + 1
        }
        n
    }

    ; every key and value a caller stores lives on the program's host page (a
    ; path of the file table, the build info's text, a host construction); the
    ; entry is written one call down
    procedure store(mutable this, key: Slice[char], value: T)
        this.store_entry(key, value)

    procedure store_entry(mutable this, key: Slice[char], value: T)
    {
        let i this.slot_of(key)
        if i >= 0
        {
            values.put(i as size_t, value)
            return
        }
        keys.add(key)
        values.add(value)
        live.add(true)
    }

    procedure remove(mutable this, key: Slice[char])
    {
        let i this.slot_of(key)
        if i >= 0
            live.put(i as size_t, false)
    }

    procedure clear(mutable this)
    {
        var i 0
        while i < (live.get_length() as int)
        {
            live.put(i as size_t, false)
            set i: i + 1
        }
    }

    ; the live keys in byte order (slices.Sort over tspath.Path)
    procedure sorted_keys(this, host: ref[Page]) returns ref[Array[Slice[char]]]
    {
        let out &Array[Slice[char]]^host()
        var i 0
        while i < (keys.get_length() as int)
        {
            let alive live[i as size_t]
            if alive
                IncSort.insert_sorted(out, keys[i as size_t])
            set i: i + 1
        }
        out
    }
}

define IncSort (reserved: int)
{
    procedure insert_sorted(mutable list: ref[Array[Slice[char]]], item: Slice[char]) @page true @direct true linked














    procedure insert_sorted_int(mutable list: ref[Array[int]], item: int) @page true @direct true linked













}

