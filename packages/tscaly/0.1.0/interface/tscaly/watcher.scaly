; SPDX-License-Identifier: Apache-2.0
;
; watcher — internal/execute/watcher.go (tsc --watch) and watchmanager, over the
; harness's mock watch backend (tsctests/mock_watch_backend.go).
;
; ★ The backend is the harness's: a watch is a registration record, an edit is
; delivered as the fsDiffer's changed paths (each file plus its ancestor
; directories) through every open registration whose path covers it, and the
; baseline prints the open registrations sorted. A cycle runs synchronously when
; the runner asks (Watcher.DoCycle), so the watch manager's locks and its run loop
; have no counterpart.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.program.ProgramFiles
use tscaly.program.JsonValue
use tscaly.tsoptions.TsOptions
use tscaly.tsoptions.TsGlobMatcher
use tscaly.tsoptions.TsGlobPattern
use tscaly.tsoptions.ProjectReference
use tscaly.tsoptions.TsConfigParser
use tscaly.tsoptions.TsParsedCommandLine
use tscaly.buildinfojson.JsonText
use tscaly.system.ExecSystem
use tscaly.system.VfsFile
use tscaly.commandline.CommandLine
use tscaly.commandline.ParsedCommandLine
use tscaly.diagnosticwriter.DriverDiagnostic
use tscaly.diagnosticwriter.DiagnosticWriter
use tscaly.programhost.DriverProgram
use tscaly.programhost.ConfigFiles
use tscaly.incremental.IncProgram
use tscaly.incremental.IncSnapshot
use tscaly.incremental.IncSort
use tscaly.incremental.ToSnapshot
use tscaly.execute.Execute
use tscaly.execute.Reporter
use tscaly.execute.CompileOutcome

; one directory watch: the directory and whether it is recursive
define WatchedDir (dir: Slice[char]  recursive: bool)

; watchmanager.WatchManager with the mock backend's registrations
define WatchManager
(
    host: ref[Page]
    sys: ref[ExecSystem]
    ; wm.watchedDirs (the backend's open registrations)
    dirs: ref[Array[WatchedDir]]
    ; MockWatchBackend.HasWatches: something was ever registered
    registered: bool
    ; the events accumulated since the last drain (changedPaths), and whether each
    ; is a delete (its EventKind)
    changed: ref[Array[Slice[char]]]
    changed_deleted: ref[Array[bool]]
)
{
    function create(host: ref[Page], sys: ref[ExecSystem]) returns ref[WatchManager] linked


    ; a map keyed by directory: the index of `dir` in `list`, -1 for none
    function index_of_dir(list: ref[Array[WatchedDir]], dir: Slice[char]) returns int linked












    ; ResolveDesiredDirs: each directory, or its nearest existing ancestor (never
    ; recursive), when that is watchable; two that meet are recursive if either is
    procedure resolve_desired_dirs(mutable this, desired: ref[Array[WatchedDir]]) returns ref[Array[WatchedDir]] linked

































    ; ReconcileWatches: the open registrations become the desired ones
    procedure reconcile_watches(mutable this, desired: ref[Array[WatchedDir]]) linked




















    ; IsDirCoveredByWatch
    function is_dir_covered_by_watch(sys: ref[ExecSystem], list: ref[Array[WatchedDir]], dir: Slice[char]) returns bool linked




















    ; IsPathUnderWatch
    function is_path_under_watch(this, path: Slice[char]) returns bool linked












    ; tspath.ContainsPath over normalized absolute paths
    function contains_path(sys: ref[ExecSystem], parent: Slice[char], child: Slice[char]) returns bool linked












    ; CanWatchDirectory
    function can_watch_directory(host: ref[Page], dir: Slice[char]) returns bool linked









    ; PerceivedOsRootLengthForWatching
    function perceived_os_root_length_for_watching(components: ref[Array[Slice[char]]]) returns int linked

































    ; `c:` at the start
    function is_volume_prefix(s: Slice[char]) returns bool linked








    ; `c$` (a UNC administrative share)
    function is_volume_prefix_dollar(s: Slice[char]) returns bool linked








    ; ShouldIgnoreWatchPath
    function should_ignore_watch_path(path: Slice[char]) returns bool linked










    ; pathIsUnder: a child of `dir`, a direct one unless recursive
    function path_is_under(event_path: Slice[char], dir: Slice[char], recursive: bool) returns bool linked













    ; MockWatchBackend.SendChangedPaths: each changed file and its ancestor
    ; directories, delivered through the registrations that cover them
    procedure send_changed_paths(mutable this, changes: ref[Array[Slice[char]]], changes_deleted: ref[Array[bool]]) linked





































































    ; path.Dir over a slash path: the part before the last slash, "/" for a root
    ; child, "." for none
    function path_dir(p: Slice[char]) @page true @direct true returns Slice[char] linked















    ; DrainEvents
    procedure drain_events(mutable this) returns ref[Array[Slice[char]]] linked







    ; CreateWatchStatusReporter: the harness's markers, the screen cleared for a
    ; starting code, the time and the flattened message, then two newlines
    procedure write_watch_status(mutable sys: ref[ExecSystem], status_options: ref[TsOptions], code: int, args: ref[Array[String]]?) reads localized_messages linked








































    procedure write_error_count(mutable sys: ref[ExecSystem], status_options: ref[TsOptions], count: int) reads localized_messages linked













    ; MockWatchBackend.WatchState
    procedure watch_state(this, mutable out: ref[StringBuilder]) linked



























}

; a config file's modification time as doBuild recorded it
define ConfigMtime (path: Slice[char]  mtime: int)

; execute.Watcher
define Watcher
(
    host: ref[Page]
    sys: ref[ExecSystem]
    ; compilerOptionsFromCommandLine and commandLineRaw
    cl: ref[ParsedCommandLine]
    config_file_name: Slice[char]
    ; w.config: the options, the file names, the config text and its parse
    ; diagnostics, the parse itself (null without a config)
    options: ref[TsOptions]
    root_names: ref[Array[Slice[char]]]
    config_text: Slice[char]
    config_diagnostics: ref[Array[ref[DriverDiagnostic]]]
    config: ref[TsParsedCommandLine]?
    report_diagnostic: Reporter
    summary_pretty: bool
    ; the watch status reporter's options (the config's at creation)
    status_options: ref[TsOptions]
    program: ref[IncProgram]?
    ; the program before the first build: ReadBuildInfoProgram's snapshot
    old_snapshot: ref[IncSnapshot]?
    config_modified: bool
    config_has_errors: bool
    config_file_paths: ref[Array[Slice[char]]]
    wm: ref[WatchManager]
    ; seenFiles, as paths
    seen_files: ref[Array[Slice[char]]]
    config_mtimes: ref[Array[ConfigMtime]]
)
{
    procedure create(mutable sys: ref[ExecSystem], cl: ref[ParsedCommandLine], options: ref[TsOptions], root_names: ref[Array[Slice[char]]], config_file_name: Slice[char], config_text: Slice[char], config_diagnostics: ref[Array[ref[DriverDiagnostic]]], config: ref[TsParsedCommandLine]?, report_diagnostic: Reporter, summary_pretty: bool) returns ref[Watcher] linked





    function stopped(this) returns bool linked


    procedure report_watch_status(mutable this, code: int, args: ref[Array[String]]?) reads localized_messages linked


    procedure report_error_count(mutable this, count: int) reads localized_messages linked


    ; tspath.ToPath: the canonical form a path set is keyed on
    procedure to_path(mutable this, file_name: Slice[char]) @page true @direct true returns Slice[char] linked


    procedure to_path_of(mutable sys: ref[ExecSystem], file_name: Slice[char]) @page true @direct true returns Slice[char] linked







    ; the config file and the files it extends
    procedure set_config_file_paths(mutable this) linked
















    ; Watcher.start
    procedure start(mutable this) io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables reads localized_messages linked









    ; the map file system as a program's file table (for a glob or a realpath)
    procedure files_of_system(mutable this) returns ref[ProgramFiles] linked


    procedure system_files(mutable sys: ref[ExecSystem]) returns ref[ProgramFiles] linked





















    ; ParsedCommandLine.WildcardDirectories (getWildcardDirectories)
    procedure wildcard_directories(mutable this) returns ref[Array[WatchedDir]] linked


    procedure wildcard_directories_of(mutable sys: ref[ExecSystem], mutable config: ref[TsParsedCommandLine]?) returns ref[Array[WatchedDir]] linked



























































































    procedure canonical_key_of(mutable sys: ref[ExecSystem], path: Slice[char]) @page true @direct true returns Slice[char] linked






    ; getWildcardDirectoryFromSpec
    procedure wildcard_directory_from_spec(spec: Slice[char], mutable out_path: ref[Slice[char]], mutable out_recursive: ref[bool]) returns bool linked










































    ; the last slash before `limit`, -1 for none
    function last_slash(s: Slice[char], limit: int) returns int linked











    ; vfsmatch.IsImplicitGlob
    function is_implicit_glob(component: Slice[char]) returns bool linked












    ; computeDesiredWatches
    procedure compute_desired_watches(mutable this, mutable pf: ref[ProgramFiles], seen_file_paths: ref[Array[Slice[char]]]) returns ref[Array[WatchedDir]] linked




























































    ; Watcher.DoCycle
    procedure do_cycle(mutable this) io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables reads localized_messages linked

























    ; the harness's OnProgram
    procedure on_program(mutable this) linked





    ; isRelevantChange
    procedure is_relevant_change(mutable this, changed_paths: ref[Array[Slice[char]]]) returns bool linked

























    ; ParsedCommandLine.PossiblyMatchesFileName
    procedure possibly_matches_file_name(mutable this, file_name: Slice[char]) returns bool linked














































    ; `<dir>/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json}` (or `/*.{…}`) against a name
    function glob_matches(dir: Slice[char], recursive: bool, file_name: Slice[char]) returns bool linked























    function last_dot(s: Slice[char]) returns int linked











    ; ParsedCommandLine.PossiblyMatchesDirectoryName
    procedure possibly_matches_directory_name(mutable this, directory_path: Slice[char]) returns bool linked






















    ; Watcher.doBuild
    procedure do_build(mutable this) io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables reads checker_strict_null_checks linked
















































































    ; ReloadFileNamesOfParsedCommandLine: the file names globbed again
    procedure reload_file_names(mutable this) linked






    ; recheckTsConfig: true when the config could not be parsed
    procedure recheck_ts_config(mutable this) returns bool io reads localized_messages linked
































































    ; parseConfigFile: null after the errors are reported
    procedure parse_config_file(mutable this, mutable out_text: ref[Slice[char]], mutable diagnostics: ref[Array[ref[DriverDiagnostic]]]) @page true @direct true returns ref[TsParsedCommandLine]? io reads localized_messages linked

















    ; reflect.DeepEqual over the two ParsedConfigs: the options, the file names and
    ; the project references
    procedure same_parsed_config(host: ref[Page], a_opt: ref[TsParsedCommandLine]?, b: ref[TsParsedCommandLine]) returns bool linked

















































}
