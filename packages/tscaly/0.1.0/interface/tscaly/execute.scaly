; SPDX-License-Identifier: Apache-2.0
;
; execute — internal/execute's command line (tsc.go and execute/tsc) (phase (b)2).
;
; ★ The reporters are closures upstream (CreateDiagnosticReporter,
; CreateReportErrorSummary); here they are the two booleans they close over —
; quiet and pretty — decided at the same call sites.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.program.JsonValue
use tscaly.program.ProgramFiles
use tscaly.tsoptions.TsOptions
use tscaly.tsoptions.TsConfigParser
use tscaly.tsoptions.TsParsedCommandLine
use tscaly.tsoptions.ProjectReference
use tscaly.TsOptionDecls.TsOptionDecls
use tscaly.buildinfojson.JsonText
use tscaly.emitter.EmitOptions
use tscaly.system.ExecSystem
use tscaly.system.CompileStats
use tscaly.system.VfsFile
use tscaly.commandline.CommandLine
use tscaly.commandline.ParsedCommandLine
use tscaly.diagnosticwriter.DriverDiagnostic
use tscaly.diagnosticwriter.DiagnosticWriter
use tscaly.programhost.DriverProgram
use tscaly.tracing.Tracing
use tscaly.tracing.TraceArg
use tscaly.checker.Checker
use tscaly.programhost.ConfigFiles
use tscaly.incremental.IncProgram
use tscaly.incremental.IncEmitResult
use tscaly.incremental.ToSnapshot
use tscaly.incremental.PathMap
use tscaly.help.Help
use tscaly.build.Orchestrator
use tscaly.help.Init
use tscaly.diagnosticwriter.Localization
use tscaly.watcher.Watcher

; tsc.ExitStatus
define ExitStatusSuccess: int 0
define ExitStatusDiagnosticsPresent_OutputsSkipped: int 1
define ExitStatusDiagnosticsPresent_OutputsGenerated: int 2
define ExitStatusInvalidProject_OutputsSkipped: int 3
define ExitStatusProjectReferenceCycle_OutputsSkipped: int 4
define ExitStatusNotImplemented: int 5

; a reporter's two decisions
define Reporter (quiet: bool  pretty: bool)

; EmitAndReportStatistics' answer
define CompileOutcome (status: int  diagnostics: ref[Array[ref[DriverDiagnostic]]]  emitted_files: ref[Array[Slice[char]]]  emit_skipped: bool)

; a concept with a field, so its statics mangle with its name (§3.38)
define Execute (reserved: int)
{
    ; execute.CommandLine
    procedure command_line(mutable sys: ref[ExecSystem], mutable args: ref[Array[Slice[char]]]) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_trace_types, checker_use_unknown_in_catch_variables, localized_messages reads localized_messages linked

    ; the command line's locale: its translated messages, when it has them
    procedure load_locale(mutable sys: ref[ExecSystem], cl: ref[ParsedCommandLine]) returns bool io mutable localized_messages reads localized_messages linked

    ; defaultIsPretty
    function default_is_pretty(sys: ref[ExecSystem]) returns bool linked

    ; shouldBePretty
    function should_be_pretty(sys: ref[ExecSystem], options: ref[TsOptions]) returns bool linked

    ; CreateDiagnosticReporter
    function reporter(sys: ref[ExecSystem], options: ref[TsOptions]) @page true @direct true returns Reporter linked

    procedure report(mutable sys: ref[ExecSystem], r: Reporter, mutable d: ref[DriverDiagnostic]) reads localized_messages linked

    procedure report_all(mutable sys: ref[ExecSystem], r: Reporter, mutable list: ref[Array[ref[DriverDiagnostic]]]) reads localized_messages linked

    ; ast.NewCompilerDiagnostic, reported
    procedure report_compiler(mutable sys: ref[ExecSystem], r: Reporter, code: int, mutable args: ref[Array[String]]?) reads localized_messages linked

    function arg1(host: ref[Page], a0: Slice[char]) returns ref[Array[String]] linked

    ; findConfigFile over the ancestors of the search path
    procedure find_config_file(mutable sys: ref[ExecSystem], search_path: Slice[char]) @page true @direct true returns Slice[char] linked

    ; tscCompilation
    procedure tsc_compilation(mutable sys: ref[ExecSystem], mutable cl: ref[ParsedCommandLine]) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_trace_types, checker_use_unknown_in_catch_variables reads localized_messages linked

    ; GetParsedCommandLineOfConfigFilePath with the command line's options: the
    ; config's parse diagnostics into `diagnostics`; null after a stop
    procedure parse_config(mutable sys: ref[ExecSystem], cl: ref[ParsedCommandLine], mutable config_file_name: Slice[char], mutable text: Slice[char], mutable diagnostics: ref[Array[ref[DriverDiagnostic]]]) returns ref[TsParsedCommandLine]? io reads localized_messages linked

    ; showConfig: tsoptions.ConvertToTSConfig, MarshalIndent with four spaces
    procedure show_config(mutable sys: ref[ExecSystem], mutable options: ref[TsOptions], mutable file_names: ref[Array[Slice[char]]], config: ref[TsParsedCommandLine]?, mutable config_file_name_in: Slice[char]) linked

    function show_config_omits(name: Slice[char]) returns bool linked

    function string_array(host: ref[Page], list: ref[Array[Slice[char]]]) returns ref[JsonValue] linked

    ; the two-space MarshalIndent text with every indentation doubled
    procedure append_four_space_indent(mutable out: ref[StringBuilder], text: Slice[char]) linked

    ; tspath.GetRelativePathFromFile: relative to the config's directory, `./` led
    procedure relative_path_from_file(mutable sys: ref[ExecSystem], mutable from_directory: Slice[char], mutable to: Slice[char]) @page true @direct true returns Slice[char] linked

    ; serializeCompilerOptions' value of option `i`; null to leave it out
    procedure show_config_value(mutable sys: ref[ExecSystem], i: int, mutable v: ref[JsonValue], config_path: Slice[char], mutable config_dir: Slice[char]) @page true @direct true returns ref[JsonValue]? linked

    ; addImpliedOptions over the implied options' table
    procedure add_implied_options(mutable sys: ref[ExecSystem], mutable option_map: ref[JsonValue], options: ref[TsOptions], config_path: Slice[char]) linked

    ; not provided itself, and one of its dependencies provided
    function implied_eligible(provided: ref[Array[Slice[char]]], name: Slice[char], dep1: Slice[char], dep2: Slice[char], dep3: Slice[char], dep4: Slice[char]) returns bool linked

    procedure put_implied_enum(host: ref[Page], mutable option_map: ref[JsonValue], name: Slice[char], n: int) linked

    procedure put_implied_bool(host: ref[Page], mutable option_map: ref[JsonValue], name: Slice[char], value: bool, default_value: bool) linked

    ; the compile options this port does not implement, as a stop; true when one stopped
    procedure unported_compile_options(mutable sys: ref[ExecSystem], options: ref[TsOptions]) returns bool linked

    ; performIncrementalCompilation, then EmitAndReportStatistics and the harness's
    ; OnProgram
    procedure perform_incremental_compilation(mutable sys: ref[ExecSystem], mutable options: ref[TsOptions], mutable root_names: ref[Array[Slice[char]]], mutable config_file_name: Slice[char], mutable config_text: Slice[char], mutable config_diagnostics: ref[Array[ref[DriverDiagnostic]]], r: Reporter, summary_pretty: bool, root_config: ref[TsParsedCommandLine]?) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_use_unknown_in_catch_variables reads checker_strict_null_checks linked

    ; EmitAndReportStatistics over an incremental program: the diagnostics reported
    ; (and collected into `collected`, a build task's errors), the emitted files
    ; touched (their times into a build's cache when it holds them); null after a stop
    procedure emit_and_report_incremental(mutable sys: ref[ExecSystem], mutable ip: ref[IncProgram], r: Reporter, summary_pretty: bool, mutable collected: ref[Array[ref[DriverDiagnostic]]]?, mutable mtimes: ref[PathMap[int]]?) @page true @returnpage true returns ref[CompileOutcome]? io reads localized_messages linked

    ; EmitFilesAndReportErrors over an incremental program (the watcher's
    ; compileAndEmit); the status is EmitAndReportStatistics'
    procedure emit_files_and_report_errors(mutable sys: ref[ExecSystem], mutable ip: ref[IncProgram], r: Reporter, summary_pretty: bool, mutable collected: ref[Array[ref[DriverDiagnostic]]]?, mutable mtimes: ref[PathMap[int]]?) @page true @direct true returns ref[CompileOutcome]? io reads localized_messages linked

    ; --diagnostics' phases on the real clock (slice 348): 0 config, 1 parse,
    ; 2 check, 3 emit. The parse is the program's creation MINUS its bind: the
    ; reference creates the program and binds lazily after, this port binds each
    ; file in the walk, so the bind time the loader measured is taken out here.
    procedure add_stat_time(mutable sys: ref[ExecSystem], phase: int, t0: int) io linked

    ; performCompilation, then EmitAndReportStatistics
    procedure perform_compilation(mutable sys: ref[ExecSystem], mutable options: ref[TsOptions], mutable root_names: ref[Array[Slice[char]]], mutable config_file_name: Slice[char], mutable config_text: Slice[char], mutable config_diagnostics: ref[Array[ref[DriverDiagnostic]]], r: Reporter, summary_pretty: bool, root_config: ref[TsParsedCommandLine]?) returns int io mutable checker_allow_arbitrary_extensions, checker_allow_importing_ts_extensions, checker_allow_umd_global_access, checker_allow_unreachable_code, checker_allow_unused_labels, checker_check_js, checker_check_js_unset, checker_defer_initialize, checker_exact_optional_property_types, checker_lib_option_has_dom, checker_no_emit, checker_no_fallthrough_cases_in_switch, checker_no_implicit_any, checker_no_implicit_any_explicit, checker_no_implicit_returns, checker_no_implicit_this, checker_no_property_access_from_index_signature, checker_no_unchecked_indexed_access, checker_no_unused_locals, checker_no_unused_parameters, checker_rewrite_relative_import_extensions, checker_strict_bind_call_apply, checker_strict_builtin_iterator_return, checker_strict_function_types, checker_strict_null_checks, checker_strict_property_initialization, checker_trace_types, checker_use_unknown_in_catch_variables reads checker_strict_null_checks linked

    ; ── tsc.go's startTracing / StopTracing ──────────────────────────────────
    ;
    ; `deterministic` is `testing != nil` upstream, and every program in this
    ; repository runs under the harness — see tracing.scaly's header for what the
    ; flag decides.
    procedure start_tracing(mutable sys: ref[ExecSystem], mutable options: ref[TsOptions], mutable config_file_name: Slice[char]) mutable checker_trace_types reads checker_trace_types linked

    ; StopTracing: the types file of every checker the session legended, then the
    ; stream and the legend
    procedure stop_tracing(mutable sys: ref[ExecSystem], mutable program: ref[DriverProgram]) io mutable checker_trace_types reads checker_trace_types linked
}
