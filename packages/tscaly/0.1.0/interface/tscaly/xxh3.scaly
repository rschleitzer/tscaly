; ★ The unseeded hash only: the secret is the default key, so every key64_NNN
; constant is a little-endian read of the key table at NNN. The SIMD paths of the
; dependency compute the scalar accumulator's result; the scalar one is ported.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder

define Xxh3Key: u8[] [
    0xb8, 0xfe, 0x6c, 0x39, 0x23, 0xa4, 0x4b, 0xbe, 0x7c, 0x01, 0x81, 0x2c, 0xf7, 0x21, 0xad, 0x1c,
    0xde, 0xd4, 0x6d, 0xe9, 0x83, 0x90, 0x97, 0xdb, 0x72, 0x40, 0xa4, 0xa4, 0xb7, 0xb3, 0x67, 0x1f,
    0xcb, 0x79, 0xe6, 0x4e, 0xcc, 0xc0, 0xe5, 0x78, 0x82, 0x5a, 0xd0, 0x7d, 0xcc, 0xff, 0x72, 0x21,
    0xb8, 0x08, 0x46, 0x74, 0xf7, 0x43, 0x24, 0x8e, 0xe0, 0x35, 0x90, 0xe6, 0x81, 0x3a, 0x26, 0x4c,
    0x3c, 0x28, 0x52, 0xbb, 0x91, 0xc3, 0x00, 0xcb, 0x88, 0xd0, 0x65, 0x8b, 0x1b, 0x53, 0x2e, 0xa3,
    0x71, 0x64, 0x48, 0x97, 0xa2, 0x0d, 0xf9, 0x4e, 0x38, 0x19, 0xef, 0x46, 0xa9, 0xde, 0xac, 0xd8,
    0xa8, 0xfa, 0x76, 0x3f, 0xe3, 0x9c, 0x34, 0x3f, 0xf9, 0xdc, 0xbb, 0xc7, 0xc7, 0x0b, 0x4f, 0x1d,
    0x8a, 0x51, 0xe0, 0x4b, 0xcd, 0xb4, 0x59, 0x31, 0xc8, 0x9f, 0x7e, 0xc9, 0xd9, 0x78, 0x73, 0x64,
    0xea, 0xc5, 0xac, 0x83, 0x34, 0xd3, 0xeb, 0xc3, 0xc5, 0x81, 0xa0, 0xff, 0xfa, 0x13, 0x63, 0xeb,
    0x17, 0x0d, 0xdd, 0x51, 0xb7, 0xf0, 0xda, 0x49, 0xd3, 0x16, 0x55, 0x26, 0x29, 0xd4, 0x68, 0x9e,
    0x2b, 0x16, 0xbe, 0x58, 0x7d, 0x47, 0xa1, 0xfc, 0x8f, 0xf8, 0xb8, 0xd1, 0x7a, 0xd0, 0x31, 0xce,
    0x45, 0xcb, 0x3a, 0x8f, 0x95, 0x16, 0x04, 0x28, 0xaf, 0xd7, 0xfb, 0xca, 0xbb, 0x4b, 0x40, 0x7e,
]

define Xxh3Prime32_1: u64 0x9e3779b1
define Xxh3Prime32_2: u64 0x85ebca77
define Xxh3Prime32_3: u64 0xc2b2ae3d
define Xxh3Prime64_1: u64 0x9e3779b185ebca87
define Xxh3Prime64_2: u64 0xc2b2ae3d27d4eb4f
define Xxh3Prime64_3: u64 0x165667b19e3779f9
define Xxh3Prime64_4: u64 0x85ebca77c2b2ae63
define Xxh3Prime64_5: u64 0x27d4eb2f165667c5

define Xxh3 (var hi: u64  var lo: u64)
{
    ; the text's hash as its canonical bytes in lower-case hex (hex.EncodeToString
    ; of Uint128.Bytes: Hi big-endian, then Lo)
    function hex_of(host: ref[Page], text: Slice[char]) @page true @direct true @ret_explicit_0 true @deep true returns Slice[char] linked









    procedure append_hex(mutable sb: ref[StringBuilder], v: u64) @deep true linked













    function byte_at(p: Slice[char], o: size_t) @deep true returns u64 linked


    function read_u64(p: Slice[char], o: size_t) @ret_nonlocal true @deep true returns u64 linked











    function read_u32(p: Slice[char], o: size_t) @ret_nonlocal true @deep true returns u64 linked











    function key_u64(o: int) @ret_nonlocal true @deep true returns u64 linked











    function key_u32(o: int) @ret_nonlocal true @deep true returns u64 linked











    ; bits.Mul64: the low half answered, the high half through the cell
    procedure mul128(x: u64, y: u64, mutable out_hi: ref[u64]) @ret_nonlocal true @deep true returns u64 linked















    function mul_fold64(x: u64, y: u64) @ret_nonlocal true @deep true returns u64 linked






    function rotl64(x: u64, r: u64) @ret_nonlocal true @deep true returns u64 linked


    function rotl32(x: u64, r: u64) @ret_nonlocal true @deep true returns u64 linked





    function bswap64(x: u64) @ret_nonlocal true @deep true returns u64 linked











    function bswap32(x: u64) @ret_nonlocal true @deep true returns u64 linked











    function avalanche(x_in: u64) @ret_nonlocal true @deep true returns u64 linked








    function avalanche_small(x_in: u64) @ret_nonlocal true @deep true returns u64 linked









    ; XXH64_avalanche, WHOLE. `avalanche_small` above is the same function with
    ; its first line dropped, which is exact wherever the input is known to be 32
    ; bits (`x xor (x >> 33)` is then the identity) and wrong anywhere else — the
    ; empty-input hash is the one caller that hands it a full 64-bit word.
    function avalanche64(x_in: u64) @ret_nonlocal true @deep true returns u64 linked






    ; XXH3_mix16B at seed 0: the sixteen bytes at `po` folded against the two key
    ; words at `ko`.
    function mix16b(p: Slice[char], po: size_t, ko: int) @ret_nonlocal true @deep true returns u64 linked


    ; XXH3_64bits — the 64-bit digest of the same algorithm, over the default
    ; secret and at seed 0. It is NOT the low half of `hash128`: the two agree on
    ; the accumulator loop and on `mix16B`, and they part at every finisher (see
    ; `finish_mid`, which recombines the two halves where this one avalanches its
    ; single accumulator). Written for `tracing`'s file thread ids, which are
    ; `1000000 + hash64(kind:text) % 1000000000` and appear in every trace.json.
    function hash64(p: Slice[char]) @ret_nonlocal true @deep true returns u64 linked






































































































    ; one 128-bit round over four input words (hash128.go's repeated block)
    procedure round(mutable acc: ref[Xxh3], i0: u64, i1: u64, i2: u64, i3: u64, k0: u64, k1: u64, k2: u64, k3: u64) @deep true linked





    function hash128(p: Slice[char]) @page true @direct true @ret_nonlocal true @deep true returns Xxh3 linked



































































































































    ; the 17..240 tail: hi and lo recombined, then avalanched (hi negated)
    function finish_mid(acc: Xxh3, lu: u64) @page true @direct true @ret_nonlocal true @deep true returns Xxh3 linked






    ; one stripe's eight lanes, at `p`+`po` against the key at `ko`
    procedure stripe(mutable accs: pointer[u64], p: Slice[char], po: size_t, ko: int) @deep true linked
















    ; accumScalar over the default key
    procedure accumulate(mutable accs: pointer[u64], p: Slice[char]) @deep true linked
























































}
