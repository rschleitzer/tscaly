)

define PrivateGeneratedEntry
(
    node: ref[AstNode]
    info: ref[PrivateIdentifierInfo]
)

define PrivateEnvironment
(
    var class_name: ref[AstNode]?
    var weak_set_name: ref[AstNode]?
    members: ref[Array[PrivateMemberEntry]]
    generated_identifiers: ref[Array[PrivateGeneratedEntry]]
)
{
    function create(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[PrivateEnvironment] linked
}

; classLexicalEnvironment
define ClassLexicalEnvironment
(
    var facts: int
    var class_constructor: ref[AstNode]?
    var class_this: ref[AstNode]?
    var super_class_reference: ref[AstNode]?
)

; classLexicalEnv: the linked list of class lexical environments
define ClassLexicalEnv
(
    previous: ref[ClassLexicalEnv]?
    var data: ref[ClassLexicalEnvironment]?
    var private_env: ref[PrivateEnvironment]?
)

; classAliases: class declaration (most original) → alias identifier
define ClassAliasEntry
(
    node: ref[AstNode]
    alias: ref[AstNode]
)

; transformers.TransformOptions: the context, the options, and the resolver —
; which is the checker here (§3.41), beside the binder for the file's flags.
define TransformOptions
(
    context: ref[EmitContext]
    options: EmitOptions
    checker: ref[Checker]?
    binder: ref[Binder]?
    file_info: ref[SourceFileInfo]
)

define Transformer
(
    host: ref[Page]
    tag: int
    context: ref[EmitContext]
    factory: ref[NodeFactory]
    var visitor: ref[NodeVisitor]?
    opts: TransformOptions
    var parent_node: ref[AstNode]?
    var current_node: ref[AstNode]?
    components: ref[Array[ref[Transformer]?]]
    var allowed_modifiers: int
    var current_source_file: ref[AstNode]?
    var import_require_statements: ref[Array[ref[AstNode]?]]?
    ; importRequireStatements.requireHelperName: the `__require` the node16+
    ; `import x = require()` lowering calls (slice 249)
    var require_helper_name: ref[AstNode]?
    ; runtimesyntax.go's scope state (slice 238)
    var current_scope: ref[AstNode]?
    var current_scope_first_declarations: ref[Array[NameNode]]?
    var current_enum: ref[AstNode]?
    var current_namespace: ref[AstNode]?
    ; using.go's hoisting state (slice 239)
    var export_bindings: ref[Array[NameNode]]?
    var export_vars: ref[Array[ref[AstNode]?]]?
    var default_export_binding: ref[AstNode]?
    var export_equals_binding: ref[AstNode]?
    ; esdecorator.go's state (slice 240)
    var esd_top: ref[EsdLexicalEntry]?
    var esd_class_info: ref[EsdClassInfo]?
    var esd_class_this: ref[AstNode]?
    var esd_class_super: ref[AstNode]?
    var esd_pending_expressions: ref[Array[ref[AstNode]?]]?
    var esd_outer_this: ref[AstNode]?
    var esd_private_static_in_file: bool
    var esd_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; commonjsmodule.go's state (slice 241)
    var cjs_info: ref[ExternalModuleInfo]?
    var cjs_unique_exports: ref[Array[Slice[char]]]?
    var cjs_has_export_default: bool
    var cjs_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; classfields.go's state (slice 242)
    var cf_initializers_using_set: bool
    var cf_initializers_using_define: bool
    var cf_initializers: bool
    var cf_private_elements_or_static_blocks: bool
    var cf_auto_accessors: bool
    var cf_this_in_static_initializers: bool
    var cf_super_in_static_initializers: bool
    var cf_private_static_elements_in_file: bool
    var cf_legacy_decorators: bool
    var cf_pending_expressions: ref[Array[ref[AstNode]?]]?
    var cf_pending_statements: ref[Array[ref[AstNode]?]]?
    var cf_lexical_environment: ref[ClassLexicalEnv]?
    var cf_current_class_container: ref[AstNode]?
    var cf_current_class_element: ref[AstNode]?
    var cf_class_aliases: ref[Array[ClassAliasEntry]]?
    var cf_enclosing_class_declarations: ref[Array[ref[AstNode]?]]?
    var cf_in_iteration_statement: bool
    var cf_inside_computed_property_name: bool
    var cf_visitors: ref[Array[ref[NodeVisitor]?]]?
    var cf_check_found: bool
    var cf_check_class_original: ref[AstNode]?
    var cf_check_class_name: ref[AstNode]?
    ; the ES downlevel transformers' state (slice 244)
    var ors_in_exported_variable_statement: bool
    var ors_expression_result_is_unused: bool
    var ors_parameters_with_preceding: ref[Array[ref[AstNode]?]]?
    var tt_declarations: ref[Array[ref[AstNode]?]]?
    var fa_enclosing_function_flags: int
    var fa_hierarchy_facts: int
    var sa_captured_super_properties: ref[Array[Slice[char]]]?
    var sa_has_super_element_access: bool
    var sa_has_super_property_assignment: bool
    var sa_super_binding: ref[AstNode]?
    var sa_super_index_binding: ref[AstNode]?
    var as_context_flags: int
    var as_enclosing_function_parameter_names: ref[Array[Slice[char]]]?
    var as_lexical_arguments_binding: ref[AstNode]?
    var as_lexical_arguments_used: bool
    var es_visitors: ref[Array[ref[NodeVisitor]?]]?
    ; legacy decorators and metadata (slice 245)
    var ld_class_aliases: ref[Array[ClassAliasEntry]]?
    var ld_enclosing_classes: ref[Array[ref[AstNode]?]]?
    var ld_check_found: bool
    var ld_check_class_original: ref[AstNode]?
    var ld_visitors: ref[Array[ref[NodeVisitor]?]]?
    var md_parent: ref[AstNode]?
    var md_current_lexical_scope: ref[AstNode]?
    var md_current_name_scope: ref[AstNode]?
    var md_strict_null_checks: bool
    var md_serializing_conditional_type_branch: bool
    ; the JSX transformer (slice 246)
    var jx_import_specifier: Slice[char]
    var jx_filename_declaration: ref[AstNode]?
    var jx_runtime_imports: ref[Array[ref[JsxRuntimeImport]?]]?
    var jx_in_jsx_child: bool
    ; the declaration emitter's state (slice 250): the transformer's own, the
    ; SymbolTrackerSharedState's and the SymbolTrackerImpl's, in that order
    var dt_needs_declare: bool
    var dt_needs_scope_fix_marker: bool
    var dt_result_has_scope_marker: bool
    var dt_enclosing_declaration: ref[AstNode]?
    var dt_result_has_external_module_indicator: bool
    var dt_suppress_new_diagnostic_contexts: bool
    var dt_witnessed_cjs_exports: ref[Array[Slice[char]]]?
    ; lateStatementReplacementMap / expandoHosts / expandoMembers, keyed by the
    ; most-original node (a present key with a null value is a deletion)
    var dt_late_keys: ref[Array[ref[AstNode]?]]?
    var dt_late_values: ref[Array[ref[AstNode]?]]?
    var dt_expando_host_keys: ref[Array[ref[AstNode]?]]?
    var dt_expando_host_values: ref[Array[ref[AstNode]?]]?
    var dt_expando_member_keys: ref[Array[ref[AstNode]?]]?
    var dt_expando_member_values: ref[Array[ref[Array[ref[AstNode]?]]?]]?
    var dt_seen_properties: ref[Array[ThisPropertyKey]]?
    var dt_this_property_assignments_collected: ref[Array[ref[AstNode]?]]?
    var dt_visitors: ref[Array[ref[NodeVisitor]?]]?
    var dt_cjs_export_assignment: ref[AstNode]?
    var dt_cjs_export_members: ref[Array[ref[AstNode]?]]?
    var dt_cjs_export_assignment_name: ref[AstNode]?
    var dt_in_class_expression_declaration: bool
    var dt_late_marked_statements: ref[Array[ref[AstNode]?]]?
    ; the declaration diagnostics, (pos, end, code) triples
    var dt_diagnostics: ref[Array[int]]?
    ; getSymbolAccessibilityDiagnostic as a tag + node (§3.18): 0 none (a panic
    ; upstream), 1 for-node, 2 for-node-name, 3 the default export, 4 the class
    ; base expression (with the class name)
    var dt_diag_kind: int
    var dt_diag_node: ref[AstNode]?
    var dt_diag_name: ref[AstNode]?
    var dt_error_name_node: ref[AstNode]?
    var dt_isolated_declarations: bool
    var dt_strip_internal: bool
    var dt_current_source_file: ref[AstNode]?
    var dt_fallback_stack: ref[Array[ref[AstNode]?]]?
    var dt_watched_class_symbol: ref[Symbol]?
    var dt_class_symbol_tracked: bool
    var unported_count: int
    var unported_tag: Slice[char]
    var unported_detail: int
    var node_builder: ref[NodeBuilder]?
    ; each declaration diagnostic's message arguments, beside dt_diagnostics
    var dt_diagnostic_args: ref[Array[ref[Array[String]]?]]?
    ; and its related information
    var dt_diagnostic_related: ref[Array[ref[Array[RelatedInfo]]?]]?
)
{
    ; NewTransformer: the visitor is the context's, with this transformer as its
    ; visit callback.
    procedure create(host: ref[Page], tag: int, mutable opts: TransformOptions) @ret_args_5 true @deep true @deep_into_2_5 true returns ref[Transformer] linked

    procedure record_unported(mutable this, tag_text: Slice[char], detail: int) @deep true @deep_this_2 true @deep_whole_2 true linked

    function the_visitor(this) @ret_param_0 true @deep true returns ref[NodeVisitor] linked

    function the_checker(this) @ret_param_0 true @deep true returns ref[Checker] linked

    procedure transform_source_file(mutable this, mutable file: ref[AstNode]) @ret_args_3 true @deep true returns ref[AstNode] io reads ordinal_lock linked

    ; the one `visit` — the func value of every transformer, by tag
    procedure visit(mutable this, mutable node: ref[AstNode]) @page true @returnpage true @deep true @deep_this_2 true @deep_whole_2 true returns ref[AstNode]? io reads ordinal_lock linked


    ; ═══ estransforms: the ES2016–ES2021 downlevel transformers (slice 244) ═══

    ; ═══ the ES2016–ES2021 downlevel transformers (slice 244) ═══

    ; ── exponentiation.go ──
    procedure visit_exponentiation(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; a **= b  →  a = Math.pow(a, b), the target evaluated once
    procedure exp_visit_exponentiation_assignment_expression(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── utilities.go createNotNullCondition ──
    ;   left !== null && right !== void 0     (inverted: left === null || right === void 0)
    procedure create_not_null_condition(mutable this, left: ref[AstNode], right: ref[AstNode], invert: bool) @deep true returns ref[AstNode] linked

    ; ── nullishcoalescing.go ──
    procedure visit_nullish_coalescing(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── optionalcatch.go ──
    procedure visit_optional_catch(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── logicalassignment.go ──
    procedure visit_logical_assignment(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── taggedtemplate.go: a tagged template with an invalid escape needs the
    ;    template object helper ──
    procedure visit_tagged_template_lift(mutable this, mutable node: ref[AstNode]) @deep true @deep_this_2 true @deep_whole_2 true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure tt_visit_source_file(mutable this, mutable node: ref[AstNode]) @deep true @deep_this_2 true @deep_whole_2 true returns ref[AstNode]? io reads ordinal_lock linked

    function tt_has_invalid_escape(template: ref[AstNode]) @ret_param_0 true @deep true returns bool linked

    ; createTemplateCooked: `void 0` for an invalid cooked string
    procedure tt_create_template_cooked(mutable this, template: ref[AstNode]) @deep true returns ref[AstNode] linked

    ; getRawLiteral: the source text between the delimiters, newlines normalized
    procedure tt_raw_literal(mutable this, node: ref[AstNode]) @deep true returns ref[AstNode] linked

    procedure tt_process_tagged_template_expression(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── optionalchain.go ──
    procedure visit_optional_chain(mutable this, mutable node: ref[AstNode]) @page true @returnpage true @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure oc_visit_call_expression(mutable this, mutable node: ref[AstNode], capture_this_arg: bool) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure oc_visit_parenthesized_expression(mutable this, mutable node: ref[AstNode], capture_this_arg: bool, is_delete: bool) @deep true returns ref[AstNode] io reads next_auto_generate_id linked

    procedure oc_visit_property_or_element_access_expression(mutable this, mutable node: ref[AstNode], capture_this_arg: bool, is_delete: bool) @page true @returnpage true @deep true returns ref[AstNode] io reads next_auto_generate_id linked

    procedure oc_visit_delete_expression(mutable this, mutable node: ref[AstNode]) @page true @returnpage true @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure oc_visit_non_optional_expression(mutable this, mutable node: ref[AstNode], capture_this_arg: bool, is_delete: bool) @page true @returnpage true @deep true returns ref[AstNode] io reads next_auto_generate_id linked

    ; flattenChain: the links of a chain from the outermost node down to the
    ; first `?.`, and the expression under it
    procedure oc_flatten_chain(this, chain_in: ref[AstNode], mutable links: ref[Array[ref[AstNode]?]]) @ret_param_1 true @deep true @deep_into_2_2 true returns ref[AstNode] linked

    function oc_is_call_chain(node: ref[AstNode]) @ret_param_0 true @deep true returns bool linked

    procedure oc_visit_optional_expression(mutable this, mutable node: ref[AstNode], capture_this_arg: bool, is_delete: bool) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; ── objectrestspread.go ──
    procedure visit_object_rest_spread(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_worker(mutable this, mutable node: ref[AstNode], expression_result_is_unused: bool) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_parameter(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    ; collectParametersWithPrecedingObjectRestOrSpread: the parameters AFTER the
    ; first one carrying an object rest or spread, else null
    procedure ors_collect_parameters_with_preceding(this, mutable node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]]? linked

    ; the seven function-like visitors, each entering a parameter list context
    procedure ors_visit_function_like(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads ordinal_lock linked

    ; transformFunctionBody: the hoisted declarations of the body and the
    ; parameters' rest assignments go in front of it
    procedure ors_transform_function_body(mutable this, mutable node: ref[AstNode]) @page true @returnpage true @deep true returns ref[AstNode]? io reads ordinal_lock linked

