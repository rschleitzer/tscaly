define PrivateKindAccessor: int 3
define PrivateKindUntransformed: int 4

; privateIdentifierInfo
define PrivateIdentifierInfo
(
    kind: int
    ; the WeakMap (instance field), the WeakSet (instance method / accessor) or
    ; the constructor (static member) that brand-checks the receiver
    brand_check_identifier: ref[AstNode]?
    is_static: bool
    ; a reserved name (#constructor) or a duplicate is invalid
    is_valid: bool
    ; the storage variable of a static field
    variable_name: ref[AstNode]?
