; transform.go thisPropertyAssignmentKey: a name-keyed entry, or a node-keyed one
; for a dynamic name
define ThisPropertyKey
(
    name: Slice[char]
    node: ref[AstNode]?
    is_static: bool
    is_private: bool
)

; diagnostics.go SymbolAccessibilityDiagnostic, as the port's (node, code); a
; code of 0 is the reference's nil (no diagnostic for this node kind)
define DtDiagnostic
(
