)
{
    function create(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[ExternalModuleInfo] linked

    ; exportSpecifiers.Get(name)
    function export_specifiers_of(this, host: ref[Page], name: Slice[char]) @ret_explicit_1 true @deep true returns ref[Array[ref[AstNode]?]] linked

    ; exportedBindings.Get(decl)
    function exported_bindings_of(this, host: ref[Page], decl: ref[AstNode]) @ret_explicit_1 true @deep true returns ref[Array[ref[AstNode]?]] linked
}

; destructuring.go's pendingDecl
define PendingDecl
(
