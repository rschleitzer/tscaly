; memberInfo: decoration-related data for a single class element
define EsdMemberInfo
(
    member_decorators_name: ref[AstNode]?
    var member_initializers_name: ref[AstNode]?
    var member_extra_initializers_name: ref[AstNode]?
    var member_descriptor_name: ref[AstNode]?
)

; the OrderedMap[*Node, *memberInfo] row
define EsdMemberEntry
(
    member: ref[AstNode]
    info: ref[EsdMemberInfo]
)

; classInfo: all transformation data for a single decorated class
define EsdClassInfo
(
    class_node: ref[AstNode]
    var class_decorators_name: ref[AstNode]?
    var class_descriptor_name: ref[AstNode]?
    var class_extra_initializers_name: ref[AstNode]?
    var class_this: ref[AstNode]?
    var class_super: ref[AstNode]?
    metadata_reference: ref[AstNode]
    member_infos: ref[Array[EsdMemberEntry]]
    var instance_method_extra_initializers_name: ref[AstNode]?
    var static_method_extra_initializers_name: ref[AstNode]?
    static_non_field_decoration_statements: ref[Array[ref[AstNode]?]]
    non_static_non_field_decoration_statements: ref[Array[ref[AstNode]?]]
    static_field_decoration_statements: ref[Array[ref[AstNode]?]]
    non_static_field_decoration_statements: ref[Array[ref[AstNode]?]]
    var has_static_initializers: bool
    var has_non_ambient_instance_fields: bool
    var has_static_private_class_elements: bool
    var pending_static_initializers: ref[Array[ref[AstNode]?]]?
    var pending_instance_initializers: ref[Array[ref[AstNode]?]]?
)

; lexicalEntry: one entry of the lexical scope stack
define EsdLexicalEntry
(
    kind: int
    next: ref[EsdLexicalEntry]?
    class_info: ref[EsdClassInfo]?
    saved_pending_expressions: ref[Array[ref[AstNode]?]]?
    var class_this: ref[AstNode]?
    var class_super: ref[AstNode]?
    var depth: int
)

; partialResult
define EsdPartialResult
(
    modifiers: ref[Array[ref[AstNode]?]]?
    referenced_name: ref[AstNode]?
    name: ref[AstNode]?
    initializers_name: ref[AstNode]?
    extra_initializers_name: ref[AstNode]?
    descriptor_name: ref[AstNode]?
    this_arg: ref[AstNode]?
)
; ast.ModifierFlagsTypeScriptModifier
define ModifierFlagsTypeScriptModifier: int ModifierFlagsAmbient | ModifierFlagsPublic | ModifierFlagsPrivate | ModifierFlagsProtected | ModifierFlagsReadonly | ModifierFlagsAbstract | ModifierFlagsConst | ModifierFlagsOverride | ModifierFlagsIn | ModifierFlagsOut

; ── ast/subtreefacts.go — the transformers' gate (slice 237) ──────────────────
;
; The reference gates EVERY transformer on `node.SubtreeFacts()`: the type
; eraser returns a subtree without SubtreeContainsTypeScript untouched (so a
; bodiless overload `function f1(),` prints as `function f1() { }` and a `static
; constructor() { }` keeps its `static`), the class-fields transformer asks for
; ContainsClassFields, `using` for ContainsUsing, and so on. The facts are the
; per-kind computeSubtreeFacts of ast.go / ast_generated.go (110 of them, the
; scope exclusions of subtreefacts.go applied on the way UP by
; propagateSubtreeFacts), cached on the node behind SubtreeFactsComputed.
;
; ★ The cache slot is `AstNode.subtree_facts` (0 = not yet computed; the
; reference caches on CompositeBase nodes only and recomputes the leaves — the
; answer is the same, computeSubtreeFacts being idempotent). A node the FACTORY
; makes (an updated node) starts at 0 too, so a transformed tree is asked afresh.

define SubtreeContainsTypeScript:                    int 1 << 0
define SubtreeContainsJsx:                           int 1 << 1
define SubtreeContainsESDecorators:                  int 1 << 2
define SubtreeContainsUsing:                         int 1 << 3
define SubtreeContainsClassStaticBlocks:             int 1 << 4
define SubtreeContainsESClassFields:                 int 1 << 5
define SubtreeContainsLogicalAssignments:            int 1 << 6
define SubtreeContainsNullishCoalescing:             int 1 << 7
define SubtreeContainsOptionalChaining:              int 1 << 8
define SubtreeContainsMissingCatchClauseVariable:    int 1 << 9
define SubtreeContainsESObjectRestOrSpread:          int 1 << 10
define SubtreeContainsForAwaitOrAsyncGenerator:      int 1 << 11
define SubtreeContainsAnyAwait:                      int 1 << 12
define SubtreeContainsExponentiationOperator:        int 1 << 13
define SubtreeContainsLexicalThis:                   int 1 << 14
define SubtreeContainsLexicalSuper:                  int 1 << 15
define SubtreeContainsRestOrSpread:                  int 1 << 16
define SubtreeContainsObjectRestOrSpread:            int 1 << 17
define SubtreeContainsAwait:                         int 1 << 18
define SubtreeContainsDynamicImport:                 int 1 << 19
define SubtreeContainsClassFields:                   int 1 << 20
define SubtreeContainsDecorators:                    int 1 << 21
define SubtreeContainsIdentifier:                    int 1 << 22
define SubtreeContainsPrivateIdentifierInExpression: int 1 << 23
define SubtreeContainsInvalidTemplateEscape:         int 1 << 24
define SubtreeFactsComputed:                         int 1 << 25
define SubtreeFactsNone:                             int 0
; every fact bit below the Computed marker
define SubtreeFactsAllBits:                          int 33554431
define SubtreeContainsLexicalThisOrSuper:            int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper

; The scope exclusions, spelled as the bits a scope CLEARS on the way up
; (subtreefacts.go spells them as the complement; SubtreeExclusionsNode is the
; Computed marker alone, which `subtree_facts` never hands out)
define SubtreeClearsFunction:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper | SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsArrowFunction:           int SubtreeContainsAwait | SubtreeContainsObjectRestOrSpread
define SubtreeClearsProperty:                int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsModule:                  int SubtreeContainsLexicalThis | SubtreeContainsLexicalSuper
define SubtreeClearsObjectLiteral:           int SubtreeContainsObjectRestOrSpread
define SubtreeClearsVariableDeclarationList: int SubtreeContainsObjectRestOrSpread
define SubtreeClearsCatchClause:             int SubtreeContainsObjectRestOrSpread
define SubtreeClearsBindingPattern:          int SubtreeContainsRestOrSpread

; core.CompilerOptions, the slots the emit reads. Every unset option is its zero
; (a Tristate is `TristateUnknown`), as the yardstick's `&core.CompilerOptions{}`.
define EmitOptions
(
    var target: int
    var module_kind: int
    var jsx: int
    var remove_comments: bool
    var no_emit_helpers: bool
    var new_line: int
    var verbatim_module_syntax: int
    var isolated_modules: int
    var experimental_decorators: int
    var emit_decorator_metadata: int
    var import_helpers: int
    var rewrite_relative_import_extensions: int
    var use_define_for_class_fields: int
    var preserve_const_enums: int
    ; the driver chapter's slots (slice 243): a case's directives
    var module_detection: int
    var declaration: int
    var source_map: int
    var inline_source_map: int
    var emit_declaration_only: int
    var no_emit: int
    var allow_js: int
    var strict: int
    var strict_null_checks: int
    var jsx_import_source: Slice[char]
    var react_namespace: Slice[char]
    var jsx_factory: Slice[char]
    var jsx_fragment_factory: Slice[char]
    var source_root: Slice[char]
    var map_root: Slice[char]
    var inline_sources: int
    var out_dir: Slice[char]
    var lib: Slice[char]
    var no_lib: int
    ; slice 248: the resolver's options
    var module_resolution: int
    var resolve_json_module: int
    ; the `type` of the nearest package.json of the unit being emitted (the
    ; program's SourceFileMetaData.PackageJsonType; slice 248), empty when none
    var package_json_type: Slice[char]
    ; slice 249: the package.json map tristates and rootDir
    var resolve_package_json_exports: int
    var resolve_package_json_imports: int
    var root_dir: Slice[char]
    ; the declaration emitter's options (slice 250)
    var declaration_map: int
    var declaration_dir: Slice[char]
    var strip_internal: int
    var isolated_declarations: int
    var composite: int
    ; the checker option a `.d.ts` varies with (slice 252)
    var exact_optional_property_types: int
    ; the module specifier generator's (slice 253)
    var allow_importing_ts_extensions: int
    ; the written file's byte order mark (slice 257)
    var emit_bom: int
    ; the harness's current directory and customConditions (slice 260), text
    var current_directory: Slice[char]
    var custom_conditions: Slice[char]
    ; compilerOptions.ConfigFilePath: a case's tsconfig.json (slice 261), text
    var config_file_path: Slice[char]
    ; noEmitOnError (slice 262): the driver's HandleNoEmitOnError
    var no_emit_on_error: int
    ; the checker's options (slice 263): each a Tristate, the strict family read
    ; through `strict` (strict_option_on)
    var no_implicit_any: int
    var no_implicit_this: int
    var use_unknown_in_catch_variables: int
    var strict_property_initialization: int
    var strict_function_types: int
    var strict_bind_call_apply: int
    var strict_builtin_iterator_return: int
    var check_js: int
    var no_implicit_returns: int
    var no_unchecked_indexed_access: int
    var no_property_access_from_index_signature: int
    var allow_arbitrary_extensions: int
    ; noUnusedLocals / noUnusedParameters (slice 265)
    var no_unused_locals: int
    var no_unused_parameters: int
    ; the remaining checker options (slice 266)
    var allow_unreachable_code: int
    var allow_unused_labels: int
    var no_fallthrough_cases_in_switch: int
    var allow_umd_global_access: int
    var erasable_syntax_only: int
    var no_unchecked_side_effect_imports: int
    var no_implicit_override: int
    ; the program's options (slice 268): verifyCompilerOptions and the file loader
    var downlevel_iteration: int
    var incremental: int
    var ts_build_info_file: Slice[char]
    var types: Slice[char]
    var no_resolve: int
    var max_node_module_js_depth: int
    var type_roots: Slice[char]
    var suppress_output_path_check: int
    var deduplicate_packages: int
    ; the harness's useCaseSensitiveFileNames (TRUE unless a case says false)
    var case_insensitive_file_names: bool
    var lib_replacement: int
    var preserve_symlinks: int
    ; compilerOptions.moduleSuffixes, comma-joined (empty for none)
    var module_suffixes: Slice[char]
    ; compilerOptions.forceConsistentCasingInFileNames (tristate)
    var force_consistent_casing: int
)
{
    function defaults() @page true @direct true @deep true returns EmitOptions linked

    ; the options of one test configuration, `name=value;name=value` with the
    ; names lower-cased by the runner (tests/casejs.py); an unknown name is
    ; ignored — the checker, the parser and the lib do not read these, so a
    ; name that reaches nothing is a directive the emit does not depend on
    function parse(host: ref[Page], text: Slice[char]) @page true @direct true @deep true returns EmitOptions linked

    ; a Tristate read outside the package (a program root cannot see the constant)
    ; strictNullChecks: the option itself, else `strict` — which, unset, is ON
    ; (core.GetStrictOptionValue: `options.Strict != TSFalse`)
    ; core.CompilerOptions.GetStrictOptionValue
    function strict_option_on(this, value: int) @ret_param_0 true @deep true returns bool linked

    ; `NoImplicitAny.DefaultIfUnknown(Strict).IsTrue()` (module.GetResolutionDiagnostic)
    function no_implicit_any_explicit(this) @ret_param_0 true @deep true returns bool linked

    function strict_null_checks_on(this) @ret_param_0 true @deep true returns bool linked

    ; exactOptionalPropertyTypes: `options.ExactOptionalPropertyTypes == TSTrue`
    function exact_optional_property_types_on(this) @ret_param_0 true @deep true returns bool linked

    ; Tristate.IsTrueOrUnknown
    function true_or_unknown(value: int) @ret_nonlocal true @deep true returns bool linked

    function on(value: int) @ret_nonlocal true @deep true returns bool linked

    ; `!IsFalse()`
    function on_or_unknown(value: int) @ret_nonlocal true @deep true returns bool linked

    ; `options.Jsx == core.JsxEmitPreserve` (a later module cannot see the constant)
    function jsx_is_preserve(this) @ret_param_0 true @deep true returns bool linked

    ; tsoptions.GetDefaultLibFileName and the `lib` option: the lib NAMES this
    ; configuration loads (empty under noLib)
    ; whether the explicit `lib` option names `dom` (the option's lib.dom.d.ts)
    function lib_option_has_dom(this) @ret_nonlocal true @deep true returns bool linked

    function lib_names(this, host: ref[Page]) @ret_explicit_1 true @deep true returns ref[Array[Slice[char]]] linked

    ; a non-negative decimal option value, -1 for anything else
    function decimal_of(value: Slice[char]) @ret_nonlocal true @deep true returns int linked

    function tristate(value: Slice[char]) @deep true returns int linked

    function target_of(value: Slice[char]) @deep true returns int linked

    function module_of(value: Slice[char]) @deep true returns int linked

    function jsx_of(value: Slice[char]) @deep true returns int linked

    procedure apply(mutable o_in: EmitOptions, key: Slice[char], value: Slice[char]) @page true @direct true @deep true returns EmitOptions linked

    ; GetStrictOptionValue: an unset strict-family option follows `strict`
    function get_strict_option_value(this, value: int) @ret_param_0 true @deep true returns bool linked

    function get_emit_script_target(this) @deep true returns int linked

    function get_emit_module_kind(this) @deep true returns int linked

    function get_jsx_transform_enabled(this) @ret_param_0 true @deep true returns bool linked

    function get_isolated_modules(this) @ret_param_0 true @deep true returns bool linked

    ; GetEmitStandardClassFields
    function get_emit_standard_class_fields(this) @ret_nonlocal true @deep true returns bool linked

    function get_use_define_for_class_fields(this) @ret_param_0 true @deep true returns bool linked

    function should_preserve_const_enums(this) @ret_param_0 true @deep true returns bool linked

    ; ast.GetEmitModuleFormatOfFileWorker for a file with no package.json above
    ; it: the implied node format is CommonJS for `.cjs`/`.cts`, ESNext for
    ; `.mjs`/`.mts`, else the emit module kind itself.
    ; the `moduleResolution` names the resolver serves (node/node10/classic are
    ; skipped by the yardstick, as the reference's runner skips them)
    function module_resolution_of(value: Slice[char]) @deep true returns int linked

    ; GetModuleResolutionKind: unset → by the module kind (node16/18/20 → node16,
    ; nodenext → nodenext, everything else → bundler)
    function get_module_resolution_kind(this) @deep true returns int linked

    ; the program's current directory: the harness's `/.src` unless the case names
    ; one (slice 260)
    ; the project root the program's output directories are relative to: rootDir,
    ; else the config file's directory (outputpaths.GetCommonSourceDirectory's two
    ; option arms; module.tryLoadInputFileForPath's rootDir), empty for neither
    function project_root_directory(this, host: ref[Page]) @page true @direct true @ret_args_3 true @deep true returns Slice[char] linked

    function get_current_directory(this) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked

    ; compilerOptions.CustomConditions: the comma list, trimmed
    function custom_condition_list(this, host: ref[Page]) @ret_explicit_1 true @deep true returns ref[Array[Slice[char]]] linked

    function module_detection_is_force(this) @ret_nonlocal true @deep true returns bool linked

    function module_detection_is_auto(this) @ret_nonlocal true @deep true returns bool linked

    ; GetEmitModuleDetectionKind: unset → `force` under node16..nodenext, else `auto`
    function get_module_detection_kind(this) @deep true returns int linked

    ; the node16/nodenext resolution kinds (the dump asks here: a program root does
    ; not see another package's module-level constants)
    function module_resolution_is_node(this) @ret_nonlocal true @deep true returns bool linked

    ; GetResolveJsonModule: unset → nodenext, else whether the resolution is bundler
    function get_resolve_json_module(this) @ret_param_0 true @deep true returns bool linked

    ; ast.GetImpliedNodeFormatForFile: the extension, else the package.json type
    function implied_node_format_of_file(this, file_name: Slice[char]) @deep true returns int linked

    ; ast.GetImpliedNodeFormatForEmitWorker
    function implied_node_format_for_emit_of_file(this, file_name: Slice[char]) @deep true returns int linked

    ; ast.GetEmitModuleFormatOfFileWorker
    function get_emit_module_format_of_file(this, file_name: Slice[char]) @ret_nonlocal true @deep true returns int linked
}

define TransformerTagCommonJS: int 11

