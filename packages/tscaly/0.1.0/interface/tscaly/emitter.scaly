    function dts_name_of(host: ref[Page], program_path: Slice[char]) @page true @direct true @ret_explicit_0 true @deep true returns Slice[char] linked

    ; getDeclarationDiagnostics for one file (slice 270): the declaration
    ; transformer's reports, appended to `out` as (pos, end, code); false after a
    ; said stop (`unported_count`)
    procedure declaration_diagnostics(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[Array[int]], mutable out_args: ref[Array[ref[Array[String]]?]], mutable out_related: ref[Array[ref[Array[RelatedInfo]]?]]) @ret_nonlocal true @deep true @deep_this_60 true returns bool io reads next_emit_context_id linked

    ; emitDeclarationFile for one file: the declaration transformer, then the
    ; printer under the reference's declaration printer options. The text is
    ; APPENDED to `out` (emit_js's rule about a String's region applies); a
    ; said stop leaves `unported_count` > 0 and appends nothing; a file whose
    ; declaration emit REPORTED is `dts_blocked` and appends nothing either — the
    ; reference writes no .d.ts for it (`declBlocked`).
    procedure emit_dts(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[StringBuilder]) @deep true @deep_this_60 true @deep_whole_58 true @deep_into_2_58 true io reads next_emit_context_id linked

    ; declarations' getReferencedFiles (slice 256): each preserved `path` reference
    ; resolved against its file's directory and named relative to the declaration
    ; output's directory. A reference the program does not hold is skipped (an empty
    ; name). ★A DECLARATION file is named by its own path; a source file would be
    ; named by ITS declaration output, and that half keeps the printer's extension
    ; rule (a sibling's answer) until an outDir case asks for more. Null without a
    ; program: the printer's rule stands.
    procedure dts_reference_names(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable dts_file_path: Slice[char], mutable checker: ref[Checker], mutable cwd: Slice[char]) @page true @direct true @ret_nonlocal true @deep true returns ref[Array[Slice[char]]]? linked

