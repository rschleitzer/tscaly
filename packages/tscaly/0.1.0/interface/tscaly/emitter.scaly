; transformers/destructuring.go's flattener: the state of one flattening, with
; the two MODES (assignment / binding) as a flag where the reference installs
; four callbacks, and the assignment callback as a tag the transformer dispatches
; (`Transformer.flatten_create_assignment`).

; ══════════════════════════════════════════════════════════════════════════════
; ── THE NODE BUILDER (slice 251) ─────────────────────────────────────────────
;
; checker/nodebuilderimpl.go, nodecopy.go, nodebuilderscopes.go, symboltracker.go
; and the entry points of checker/nodebuilder.go — the part of the checker that
; turns a TYPE back into a type NODE, which is what the declaration transformer
; asks for every declaration whose type it must infer. It lives in the emitter
; module rather than in the checker for a reason of ORDER: it constructs nodes
; through the factory, which is declared after the checker, and it reports to
; the declaration transformer's tracker (`dt_track_symbol` and its siblings),
; which is this file's own Transformer. The checker keeps its STRING printer
; (type_to_string_worker) untouched: the checker yardstick reads that one.
;
; ★★★ THE TRACKER IS A LAYER, NOT AN INTERFACE. Upstream wraps the transformer's
; tracker in a SymbolTrackerImpl (which records tracked symbols on the context
; and marks `reportedDiagnostic`) and, inside nodecopy's RECOVERY BOUNDARY, in a
; second wrapper that DEFERS every report and records every tracked symbol so a
; failed reuse can discard the symbols and still deliver the reports. Here that
; is a STACK of boundaries on the builder: a report at depth n is pushed into
; boundary n, a finalize at depth n delivers the deferred reports one level
; down (to boundary n-1, or to the transformer at depth 0) and replays the
; tracked symbols only when nothing failed — the same order of events the
; nested wrappers produce.
;
; ★★ THE PSEUDOCHECKER IS THE NEXT CHAPTER, AND ITS DIRECT HALF IS HERE. Corsa
; reuses an existing type node through a syntactic "pseudo type": an ANNOTATION
; (`PseudoTypeDirect`) is reused when its type is the checker's, and an
; initializer EXPRESSION is inferred syntactically (`PseudoTypeInferred` and the
; structural kinds). The Direct half — the annotation of a declaration, an
; accessor pair or a signature's return type — is ported here, because it is
; what makes `Array<string>` survive as `Array<string>`; the expression half
; (internal/pseudochecker, 1 100 lines) falls back to the checker's type, which
; prints the same node in every case but a reused annotation INSIDE the
; expression. That is a measured deviation, not a stop.
;
; ★ Two said stops: a module SPECIFIER (`import("./x").T`) needs the
; modulespecifiers package (2 300 lines, its own chapter), and a symbol chain
; through two module parents needs its ordering by specifier — both report
; `node-builder-module-specifier`.

define NbTrackedSymbol ( symbol: ref[Symbol]  enclosing: ref[AstNode]?  meaning: int )
define NbDeferredReport ( kind: int  text: Slice[char]  text2: Slice[char] )
define NbSymbolDepth ( is_constructor: bool  symbol: ref[Symbol]?  node: ref[AstNode]?  depth: int )
define NbTypeParamName ( type_id: int  name: ref[AstNode] )
define NbNameCount ( text: Slice[char]  count: int )
define NbSymbolType ( symbol: ref[Symbol]  t: ref[Type]? )
define NbFakeScope ( node: ref[AstNode]  kind: int )
define NbLocalsUndo ( name: Slice[char]  old_symbol: ref[Symbol]? )
define NbSeenName ( text: Slice[char]  t: ref[Type]  index: int )

; enterNewScope's cleanup, as a frame: the enclosing declaration and mapper to
; restore, and the fake-scope locals to undo
define NbScopeFrame
(
    old_enclosing: ref[AstNode]?
    old_mapper: ref[TypeMapper]?
    var params_locals: ref[SymbolTable]?
    var params_new_names: ref[Array[Slice[char]]]?
    var params_undo: ref[Array[NbLocalsUndo]]?
    var type_params_locals: ref[SymbolTable]?
    var type_params_new_names: ref[Array[Slice[char]]]?
    var type_params_undo: ref[Array[NbLocalsUndo]]?
)

; the serializedTypes cache: one row per (enclosing declaration, type, flags)
define NbCacheRow
(
    enclosing: ref[AstNode]
    type_id: int
    flags: int
    internal_flags: int
    node: ref[AstNode]?
    truncating: bool
    added_length: int
    tracked: ref[Array[NbTrackedSymbol]]?
)

; nodecopy.go's recoveryBoundary
define NbBoundary
(
    var had_error: bool
    var deferred: ref[Array[NbDeferredReport]]
    tracked: ref[Array[NbTrackedSymbol]]
    old_tracked: ref[Array[NbTrackedSymbol]]?
    old_encountered_error: bool
    old_approximate_length: int
)

; a scope of the four copy-on-write maps: the lengths at entry
define NbScopeMark ( names: int  names_by_text: int  next_counts: int  symbol_list: int )

; NodeBuilderContext
define NbContext
(
    var approximate_length: int
    max_truncation_length: int
    var encountered_error: bool
    var truncating: bool
    var reported_diagnostic: bool
    var flags: int
    var internal_flags: int
    var depth: int
    max_expansion_depth: int
    can_increase_expansion_depth: bool
    expansion_truncated: bool
    var enclosing_declaration: ref[AstNode]?
    enclosing_file: ref[AstNode]?
    var infer_type_parameters: ref[Array[ref[Type]?]]?
    var visited_types: ref[Array[int]]
    symbol_depth: ref[Array[NbSymbolDepth]]
    var tracked_symbols: ref[Array[NbTrackedSymbol]]?
    var mapper: ref[TypeMapper]?
    var reverse_mapped_stack: ref[Array[ref[Symbol]?]]
    var enclosing_symbol_types: ref[Array[NbSymbolType]]
    var suppress_report_inference_fallback: bool
    ; the four scoped maps: append-only rows, read from the END, truncated at
    ; scope exit — which is exactly copy-on-write with EnterScope
    var type_parameter_names: ref[Array[NbTypeParamName]]
    var type_parameter_names_by_text: ref[Array[Slice[char]]]
    var type_parameter_next_counts: ref[Array[NbNameCount]]
    var type_parameter_symbol_list: ref[Array[ref[Symbol]?]]
    var scope_marks: ref[Array[NbScopeMark]]
)
{
    function create(host: ref[Page], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @ret_explicit_0 true @deep true returns ref[NbContext] linked
}

; ── internal/pseudochecker (slice 252): type.go, lookup.go, checker.go ─────
;
; A pseudo type is the SKELETON of a declaration's type read off its syntax —
; an annotation (Direct), a literal, an `as const` tuple, an object literal, a
; function expression's one call signature — which the node builder maps to a
; type node directly when it is equivalent to the checker's type, keeping the
; source's spelling (`'a'`, `["404"]`, `get x()`/`set x()`, `...a: [n: "n"]`)
; and the source's STRUCTURE (a function expression's outer type is built from
; its own parameters, never pushed on the builder's visited stack).
;
; ★ One record for the twenty kinds, with the slots each kind reads (the
; reference's `PseudoTypeData` interface has no spelling here): `node` is the
; Direct kind's type node, the Inferred kind's expression, the NoResult kind's
; declaration, the MaybeConstLocation kind's location, a literal kind's literal
; and the SingleCallSignature kind's signature; `members` is a union's types and
; a tuple's elements; `elements` is an object literal's. The reference's
; singletons (PseudoTypeUndefined, …) are allocated per use: every reader asks
; the KIND, none compares identity.

define PseudoParameter
(
    is_rest: bool
    name: ref[AstNode]
    is_optional: bool
    pseudo_type: ref[PseudoType]
)

define PseudoType
(
    kind: int
    node: ref[AstNode]?
    error_nodes: ref[Array[ref[AstNode]?]]?
    is_signature_return: bool
    const_type: ref[PseudoType]?
    regular_type: ref[PseudoType]?
    members: ref[Array[ref[PseudoType]?]]?
    parameters: ref[Array[ref[PseudoParameter]?]]?
    type_parameters: ref[Array[ref[AstNode]?]]?
    return_type: ref[PseudoType]?
    elements: ref[Array[ref[PseudoObjectElement]?]]?
)

; PseudoObjectElement and its four kinds (method, property assignment, set and
; get accessor); `signature` is the reference's Signature() — null for a
; property assignment
define PseudoObjectElement
(
    kind: int
    name: ref[AstNode]
    is_optional: bool
    signature: ref[AstNode]?
    type_parameters: ref[Array[ref[AstNode]?]]?
    parameters: ref[Array[ref[PseudoParameter]?]]?
    return_type: ref[PseudoType]?
    is_readonly: bool
    pseudo_type: ref[PseudoType]?
    parameter: ref[PseudoParameter]?
)

define PseudoChecker
(
    host: ref[Page]
    strict_null_checks: bool
    exact_optional_property_types: bool
)
{
    ; ── type.go: the constructors ──────────────────────────────────────────

    procedure new_type(this, kind: int) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_direct(this, type_node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_inferred(this, expr: ref[AstNode], is_signature_return: bool) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_inferred_with_errors(this, expr: ref[AstNode], is_signature_return: bool, error_nodes: ref[Array[ref[AstNode]?]]?) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_no_result(this, decl: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_maybe_const_location(this, loc: ref[AstNode], const_type: ref[PseudoType], regular_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_union(this, types: ref[Array[ref[PseudoType]?]]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; NewPseudoTypeUnion([]*PseudoType{t, PseudoTypeUndefined})
    procedure new_union_with_undefined(this, member: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_single_call_signature(this, signature: ref[AstNode], parameters: ref[Array[ref[PseudoParameter]?]]?, type_parameters: ref[Array[ref[AstNode]?]]?, return_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_tuple(this, elements: ref[Array[ref[PseudoType]?]]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_object_literal(this, elements: ref[Array[ref[PseudoObjectElement]?]]?) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; NewPseudoTypeStringLiteral / NumericLiteral / BigIntLiteral
    procedure new_literal(this, kind: int, literal: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure new_parameter(this, is_rest: bool, name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoParameter] linked

    procedure new_object_method(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, type_parameters: ref[Array[ref[AstNode]?]]?, parameters: ref[Array[ref[PseudoParameter]?]]?, return_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoObjectElement] linked

    procedure new_property_assignment(this, is_readonly: bool, name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoObjectElement] linked

    procedure new_set_accessor(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, parameter: ref[PseudoParameter]) @ret_nonlocal true @deep true returns ref[PseudoObjectElement] linked

    procedure new_get_accessor(this, signature: ref[AstNode], name: ref[AstNode], is_optional: bool, pseudo_type: ref[PseudoType]) @ret_nonlocal true @deep true returns ref[PseudoObjectElement] linked

    function error_node_count(t: ref[PseudoType]) @ret_param_0 true @deep true returns int linked

    function member_count(t: ref[PseudoType]) @ret_param_0 true @deep true returns int linked

    function element_count(t: ref[PseudoType]) @ret_param_0 true @deep true returns int linked

    function parameter_count(params: ref[Array[ref[PseudoParameter]?]]?) @ret_param_0 true @deep true returns int linked

    ; `expr.Kind != PseudoTypeKindInferred || len(expr.ErrorNodes) > 0` — the
    ; test every declaration arm puts between an initializer's pseudo type and
    ; the NoResult fallback
    function is_usable_expression_type(expr: ref[PseudoType]) @ret_param_0 true @deep true returns bool linked

    ; ── lookup.go ──────────────────────────────────────────────────────────

    ; GetReturnTypeOfSignature; the reference fails on a kind outside its list,
    ; and createReturnFromSignature answers NoResult for such a node
    procedure get_return_type_of_signature(mutable this, signature_node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure get_type_of_accessor(mutable this, accessor: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure get_type_of_expression(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; GetTypeOfDeclaration: null for a kind outside the reference's switch (its
    ; debug.FailBadSyntaxKind); the caller says the stop
    procedure get_type_of_declaration(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType]? linked

    procedure type_from_property_assignment(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_expando_property(this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_property(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_variable(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; ast.IsVarConst
    function is_var_const(node: ref[AstNode]) @ret_param_0 true @deep true returns bool linked

    function has_question_postfix(node: ref[AstNode]) @ret_param_0 true @deep true returns bool linked

    ; ast.GetAllAccessorDeclarationsForDeclaration over the symbol's declarations
    procedure accessor_pair_of(mutable this, accessor: ref[AstNode]) @page true @direct true @ret_args_3 true @deep true returns AccessorPair linked

    procedure type_from_accessor(mutable this, accessor: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    function get_type_annotation_from_all_accessor_declarations(node: ref[AstNode], accessors: AccessorPair) @ret_args_3 true @deep true returns ref[AstNode]? linked

    ; getTypeAnnotationFromAccessor: a getter's return annotation, a setter's
    ; FIRST parameter's annotation
    function get_type_annotation_from_accessor(node: ref[AstNode]?) @ret_param_0 true @deep true returns ref[AstNode]? linked

    function is_value_signature_declaration(k: int) @ret_nonlocal true @deep true returns bool linked

    ; createReturnFromSignature: never null, a NoResult instead
    procedure create_return_from_signature(mutable this, fn: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; the Async and Generator bits of ast.GetFunctionFlags
    function async_generator_flags_of(n: ref[AstNode]) @deep true returns int linked

    ; typeFromSingleReturnExpression. ★ The reference's flag test is
    ; `flags&FunctionFlagsAsyncGenerator != 0` — Async OR Generator — so an
    ; async function's one return is Inferred too; slice 251's Direct half read
    ; it as both bits.
    procedure type_from_single_return_expression(mutable this, fn: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; ast.ForEachReturnStatement, collecting in visit order
    procedure collect_return_statements(node: ref[AstNode], mutable out: ref[Array[ref[AstNode]?]]) @deep true @deep_into_1_1 true linked

    ; typeFromExpression — "basically `checkExpression` for pseudotypes"
    procedure type_from_expression(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_object_literal(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; getAccessorMember (typeFromObjectLiteralAccessor in strada)
    procedure get_accessor_member(mutable this, accessor: ref[AstNode], name: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoObjectElement]? linked

    ; canGetTypeFromObjectLiteral: null when the literal can be typed, else its
    ; error nodes
    procedure can_get_type_from_object_literal(this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]]? linked

    procedure type_from_array_literal(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    ; canGetTypeFromArrayLiteral: a non-const array is its own error node; a
    ; const one with a spread names the spread
    procedure can_get_type_from_array_literal(this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]]? linked

    ; isConstContextPropagatingKind
    function is_const_context_propagating_kind(k: int) @ret_nonlocal true @deep true returns bool linked

    ; IsInConstContext: the first ancestor that is an assertion or does not
    ; propagate const-ness decides
    function is_in_const_context(node: ref[AstNode]) @ret_nonlocal true @deep true returns bool linked

    procedure type_from_primitive_literal_prefix(this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_type_assertion(mutable this, expression: ref[AstNode]?, type_node: ref[AstNode]?) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_function_like_expression(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure clone_type_parameters(this, nodes: ref[Array[ref[AstNode]?]]?) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]]? linked

    function is_undefined_pseudo_type(t: ref[PseudoType]) @ret_nonlocal true @deep true returns bool linked

    ; typeNodeCouldReferToUndefined
    function type_node_could_refer_to_undefined(node_in: ref[AstNode]) @ret_nonlocal true @deep true returns bool linked

    ; CouldAlreadyReferToUndefinedType
    function could_already_refer_to_undefined_type(t: ref[PseudoType]) @ret_nonlocal true @deep true returns bool linked

    function is_optional_initialized_or_rest_parameter(p: ref[AstNode]) @ret_param_0 true @deep true returns bool linked

    ; lastRequiredParamIndex: one past the last required parameter
    function last_required_param_index(params: ref[Array[ref[AstNode]?]]?) @ret_param_0 true @deep true returns int linked

    ; addUndefinedIfDefinitelyRequired
    procedure add_undefined_if_definitely_required(this, expr: ref[PseudoType]) @ret_param_1 true @deep true returns ref[PseudoType] linked

    procedure type_from_parameter(mutable this, node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure type_from_parameter_worker(mutable this, node: ref[AstNode], self_index: int, last_required: int) @ret_nonlocal true @deep true returns ref[PseudoType] linked

    procedure clone_parameters(mutable this, nodes: ref[Array[ref[AstNode]?]]?) @ret_nonlocal true @deep true returns ref[Array[ref[PseudoParameter]?]]? linked

    ; isContextuallyTyped: a call, a `satisfies`, an annotated variable,
    ; parameter, property or non-const assertion above the node, or JSX
    function is_contextually_typed(node: ref[AstNode]) @ret_nonlocal true @deep true returns bool linked
}

; one memo row of getSpecifierForModuleSymbol
define NbSpecifierRow
(
    symbol: ref[Symbol]
    file_path: Slice[char]
    mode: int
    specifier: Slice[char]
)

define NodeBuilder
(
    host: ref[Page]
    checker: ref[Checker]
    factory: ref[NodeFactory]
    context: ref[EmitContext]
    tracker: ref[Transformer]?
    var ctx: ref[NbContext]?
    var ctx_stack: ref[Array[ref[NbContext]?]]
    cache_rows: ref[Array[ref[NbCacheRow]?]]
    fake_scopes: ref[Array[NbFakeScope]]
    boundaries: ref[Array[ref[NbBoundary]?]]
    var boundary_depth: int
    var existing_visitor: ref[NodeVisitor]?
    var clone_binding_visitor: ref[NodeVisitor]?
    var attach_visitor: ref[NodeVisitor]?
    var scopes: ref[Array[ref[NbScopeFrame]?]]
    var attach_leftmost: ref[AstNode]?
    var attach_symbol: ref[Symbol]?
    var introduces_error: bool
    var tracked_sym: ref[Symbol]?
    var unported_count: int
    var unported_tag: Slice[char]
    var unported_detail: int
    ; the pseudochecker (slice 252), under the program's two options
    pc: ref[PseudoChecker]
    ; the module specifier host, made on first use, and getSpecifierForModuleSymbol's
    ; memo (the reference's links.specifierCache, keyed by file path and mode)
    var specifier_host: ref[SpecifierHost]?
    specifier_cache: ref[Array[ref[NbSpecifierRow]?]]
)
{
    procedure create(host: ref[Page], checker: ref[Checker], context: ref[EmitContext], tracker: ref[Transformer]?) @ret_explicit_0 true @deep true returns ref[NodeBuilder] reads checker_strict_null_checks linked

    procedure record_unported(mutable this, tag_text: Slice[char], detail: int) @deep true @deep_this_2 true @deep_whole_2 true linked

    function the_ctx(this) @ret_param_0 true @deep true returns ref[NbContext] linked

    procedure note_error(mutable this, site: Slice[char]) @deep true linked

    function the_binder(this) @ret_param_0 true @deep true returns ref[Binder] linked

    ; ── nodebuilder.go: the context stack ────────────────────────────────────

    procedure enter_context(mutable this, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure pop_context(mutable this) @deep true linked

    ; the checker's chain machinery reads its enclosing declaration off a cell
    ; (printer_enclosing_declaration, slice 221) — kept in step with the context
    procedure sync_checker(mutable this) @deep true linked

    procedure set_enclosing(mutable this, node: ref[AstNode]?) @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure exit_context(mutable this, result: ref[AstNode]?) @ret_param_1 true @deep true returns ref[AstNode]? reads shared_lock linked

    procedure exit_context_list(mutable this, result: ref[Array[ref[AstNode]?]]?) @ret_param_1 true @deep true returns ref[Array[ref[AstNode]?]]? reads shared_lock linked

    ; ── the entry points (nodebuilder.go) ────────────────────────────────────

    procedure type_to_type_node_ex(mutable this, mutable t: ref[Type]?, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads checker_strict_null_checks linked

    procedure symbol_to_entity_name_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_8 true @deep_whole_8 true returns ref[AstNode]? io reads shared_lock linked

    procedure symbol_to_expression_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_8 true @deep_whole_8 true returns ref[AstNode]? io reads shared_lock linked

    procedure symbol_to_node_ex(mutable this, mutable symbol: ref[Symbol], meaning: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_8 true @deep_whole_8 true returns ref[AstNode]? io reads shared_lock linked

    procedure symbol_to_parameter_declaration_ex(mutable this, mutable symbol: ref[Symbol], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads checker_strict_null_checks linked

    procedure symbol_to_type_parameter_declarations_ex(mutable this, mutable symbol: ref[Symbol], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true returns ref[Array[ref[AstNode]?]]? io reads ordinal_lock linked

    procedure type_parameter_to_declaration_ex(mutable this, mutable parameter: ref[Type], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads shared_lock linked

    procedure type_predicate_to_type_predicate_node_ex(mutable this, mutable predicate: ref[TypePredicate], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads shared_lock linked

    procedure serialize_type_for_declaration_ex(mutable this, mutable declaration: ref[AstNode]?, mutable symbol: ref[Symbol]?, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_8 true @deep_whole_8 true returns ref[AstNode]? io reads checker_exact_optional_property_types linked

    procedure serialize_return_type_for_signature_ex(mutable this, mutable signature_declaration: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_6 true @deep_whole_6 true returns ref[AstNode]? io reads ordinal_lock linked

    procedure serialize_type_parameters_for_signature_ex(mutable this, mutable signature_declaration: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true returns ref[Array[ref[AstNode]?]]? io reads ordinal_lock linked

    procedure serialize_type_for_expression_ex(mutable this, mutable expr: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads checker_strict_null_checks linked

    procedure signature_to_signature_declaration_ex(mutable this, mutable signature: ref[Signature], kind: int, enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_8 true @deep_whole_8 true returns ref[AstNode]? io reads checker_strict_null_checks linked

    procedure index_info_to_index_signature_declaration_ex(mutable this, mutable info: ref[IndexInfo], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads checker_strict_null_checks linked

    procedure try_js_type_node_to_type_node_ex(mutable this, mutable node: ref[AstNode], enclosing: ref[AstNode]?, flags: int, internal_flags: int) @ret_param_0 true @deep true @deep_this_4 true @deep_whole_4 true returns ref[AstNode]? io reads shared_lock linked

    ; ── symboltracker.go + nodecopy.go's wrapping tracker, as a stack ────────

    function top_boundary(this) @ret_param_0 true @deep true returns ref[NbBoundary] linked

    ; TrackSymbol: at depth n > 0 the boundary records it; at depth 0 the
    ; SymbolTrackerImpl asks the transformer and records it on the context
    procedure track_symbol(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?, meaning: int) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true returns bool io reads shared_lock linked

    procedure track_symbol_at(mutable this, mutable symbol: ref[Symbol], mutable enclosing: ref[AstNode]?, meaning: int, level: int) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true returns bool io reads shared_lock linked

    procedure append_tracked(mutable this, symbol: ref[Symbol], enclosing: ref[AstNode]?, meaning: int) @deep true linked

    procedure on_diagnostic_reported(mutable this) @deep true linked

    ; a deferrable report: marked on the context, then deferred into the
    ; boundary or delivered to the transformer
    procedure report(mutable this, kind: int, text: Slice[char], text2: Slice[char]) @ret_nonlocal true @deep true @deep_this_12 true @deep_whole_12 true reads shared_lock linked

    procedure report_at(mutable this, kind: int, text: Slice[char], text2: Slice[char], level: int) @deep true @deep_this_12 true @deep_whole_12 true reads shared_lock linked

    procedure report_cyclic_structure_error(mutable this) @ret_nonlocal true @deep true reads shared_lock linked

    procedure report_inaccessible_this_error(mutable this) @ret_nonlocal true @deep true reads shared_lock linked

    procedure report_inaccessible_unique_symbol_error(mutable this) @ret_nonlocal true @deep true reads shared_lock linked

    procedure report_likely_unsafe_import_required_error(mutable this, specifier: Slice[char], symbol_name: Slice[char]) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true reads shared_lock linked

    procedure report_non_serializable_property(mutable this, name: Slice[char]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true reads shared_lock linked

    procedure report_private_in_base_of_class_expression(mutable this, name: Slice[char]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true reads shared_lock linked

    ; the three that pass straight through every wrapper
    procedure report_truncation_error(mutable this) @ret_param_0 true @deep true reads shared_lock linked

    procedure report_inference_fallback(mutable this, mutable node: ref[AstNode]?) @deep true io reads checker_strict_null_checks linked

    procedure push_error_fallback_node(mutable this, node: ref[AstNode]) @ret_param_0 true @deep true linked

    procedure pop_error_fallback_node(mutable this) @ret_param_0 true @deep true linked

    ; createRecoveryBoundary
    procedure create_recovery_boundary(mutable this) @deep true linked

    ; finalizeBoundary: the deferred reports go one level down whatever
    ; happened; the tracked symbols only when nothing failed
    procedure finalize_boundary(mutable this) @ret_nonlocal true @deep true returns bool io reads shared_lock linked

    ; startRecoveryScope / endRecoveryScope: (tracked top, deferred top, had_error)
    function recovery_tracked_top(this) @ret_param_0 true @deep true returns int linked

    function recovery_deferred_top(this) @ret_param_0 true @deep true returns int linked

