    ; internal/vfs/internal/internal.go decodeBytes + decodeUtf16: the compiler
    ; host reads a source file THROUGH this — a UTF-16 file (either byte order
    ; mark) is transcoded to UTF-8 and a UTF-8 mark is dropped — while the
    ; yardstick oracles read the raw bytes (os.ReadFile). The emit baseline is
    ; the decoded file's, so the emit path decodes and the other six do not;
    ; tscaly_dump re-parses the decoded text for the emit alone. Answers true
    ; when `out` holds a DIFFERENT text than `text` (a mark was found).
    procedure decode_bytes(text: Slice[char], mutable out: ref[StringBuilder]) @ret_nonlocal true @deep true returns bool linked

    ; decodeUtf16: the code units in the given byte order (an odd trailing byte
    ; is dropped, as binary.Read's len/2 does), unicode/utf16.Decode's pairing
    ; (an unpaired surrogate becomes U+FFFD), then UTF-8.
    procedure decode_utf16(text: Slice[char], start: int, little_endian: bool, mutable out: ref[StringBuilder]) @deep true linked

    function utf16_unit_at(text: Slice[char], at: int, little_endian: bool) @ret_param_0 true @deep true returns int linked

    procedure append_utf8(mutable out: ref[StringBuilder], cp: int) @deep true linked

    function is_file_forced_to_be_module_by_format(file_name: Slice[char], options: EmitOptions) @ret_param_0 true @deep true returns bool linked

    ; the file's identifier table (sourceFile.Identifiers): every Identifier and
    ; PrivateIdentifier text in the tree, once
    ; ast.isFileModuleFromUsingJSXTag (moduleDetection auto): a JSX file whose
    ; tags the automatic runtime rewrites is a module — the runtime import needs one
    procedure is_file_module_from_using_jsx_tag(mutable file: ref[AstNode], script_kind: int, options: EmitOptions) @ret_param_0 true @deep true returns bool linked

    ; the case harness roots every unit at `/.src/<unit>` (its `_jsxFileName`,
    ; its `import.meta` paths); a batch path `/cases/<case>/<cfg>/u<i>/<unit>` maps
    ; back to that, any other path stands
    function harness_file_name(host: ref[Page], path: Slice[char]) @page true @direct true @ret_args_3 true @deep true returns Slice[char] linked

    ; file.Identifiers, in first-seen order; the set is a map upstream, so the
    ; duplicate test walks the rows of one hash and not the whole list
    procedure collect_identifiers(host: ref[Page], node: ref[AstNode], mutable out: ref[Array[Slice[char]]]) @ret_nonlocal true @deep true linked

    procedure collect_identifiers_into(node: ref[AstNode], mutable out: ref[Array[Slice[char]]], mutable seen: ref[HashChain]) @deep true linked

    procedure scan(this, mutable node: ref[AstNode], mutable checker: ref[Checker], mutable facts: ref[EmitFacts]) @deep true reads shared_lock linked

    ; emitJSFile for one file under the default options: the transformers in
    ; getScriptTransformers' order, then the printer. The JS text is APPENDED to
    ; `out`, the caller's builder; a said stop leaves `unported_count` > 0 and
    ; appends nothing. ★Neither a returned nor a stored String survives this
    ; routine: `to_string()` constructs on the CALLER page, which for a call
    ; made here is this routine's own region — gone with the return, and the
    ; text read back as garbage three units in (root CLAUDE.md, the out-param
    ; class). The bytes are copied out while the region lives.
    procedure emit_js(mutable this, mutable file: ref[AstNode], mutable info: ref[SourceFileInfo], mutable options: EmitOptions, mutable checker: ref[Checker], mutable binder: ref[Binder], mutable out: ref[StringBuilder]) @deep true @deep_this_60 true @deep_whole_58 true @deep_into_2_58 true io reads next_emit_context_id linked
}
