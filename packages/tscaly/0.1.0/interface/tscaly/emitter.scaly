    procedure ors_declaration_statement(mutable this, declarations: ref[AstNode]) @deep true returns ref[AstNode] linked

    ; collectObjectRestAssignments
    procedure ors_collect_object_rest_assignments(mutable this, mutable node: ref[AstNode]) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]] io reads next_auto_generate_id linked

    procedure ors_visit_catch_clause(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_variable_statement(mutable this, mutable node: ref[AstNode]) @ret_param_0 true @deep true returns ref[AstNode]? io reads ordinal_lock linked

    procedure ors_visit_variable_declaration(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_variable_declaration_worker(mutable this, mutable node: ref[AstNode], exported: bool) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_for_of_statement(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads next_auto_generate_id linked

    procedure ors_visit_binary_expression(mutable this, mutable node: ref[AstNode], expression_result_is_unused: bool) @deep true returns ref[AstNode]? io reads ordinal_lock linked

    ; visitObjectLiteralExpression: `{ a, ...b, c }` → `Object.assign({ a }, b, { c })`
    procedure ors_visit_object_literal_expression(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads ordinal_lock linked

    procedure ors_chunk_object_literal_elements(mutable this, mutable list: ref[Array[ref[AstNode]?]]?) @ret_nonlocal true @deep true returns ref[Array[ref[AstNode]?]] io reads ordinal_lock linked

    ; ── utilities.go superAccessState: `super.x` inside an async body becomes
    ;    `_super.x` over an `Object.create(null, { x: { get: () => super.x } })` ──
    procedure sa_reset(mutable this) @deep true reads next_auto_generate_id linked

    function sa_captured_count(this) @ret_param_0 true @deep true returns int linked

    ; the super-access visitor
    procedure sa_visit_super_access_node(mutable this, mutable node: ref[AstNode]) @deep true returns ref[AstNode]? io reads ordinal_lock linked

    procedure sa_substitute_super_accesses_in_body(mutable this, mutable body: ref[AstNode]) @page true @returnpage true @deep true returns ref[AstNode] io reads ordinal_lock linked

    procedure sa_substitute_call_expression_with_super_access(mutable this, mutable call: ref[AstNode], mutable visitor: ref[NodeVisitor]) @deep true returns ref[AstNode]? io reads ordinal_lock linked

    procedure sa_create_super_element_access_in_async_method(mutable this, argument_expression: ref[AstNode]) @deep true returns ref[AstNode] linked

    ; createSuperAccessVariableStatement:
    ;   const _super = Object.create(null, { x: { get: () => super.x[, set: v => super.x = v] } });
    procedure sa_create_super_access_variable_statement(mutable this) @deep true returns ref[AstNode] linked

    ; trackSuperAccess: what the body reads and writes through `super`
    procedure sa_track_super_access(mutable this, node: ref[AstNode]) @deep true linked

