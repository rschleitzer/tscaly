; ★★★ WHAT THE FILE LOADER NEEDS TO ANSWER A RESOLUTION MODE, AND IT IS NOT A
; CHECKER (slice 293). Upstream's `fileloader.go` holds none: `getModeForUsageLocation`
; and `getDefaultResolutionModeForFile` are free functions over
; `(fileName, SourceFileMetaData, options)`, and this port asked a Checker for them —
; which is why the checker had to exist before the walk, which is why every file had
; to be bound before the walk, which is why `bindSourceFiles` could not be a block of
; its own. The chain is pure; this record is its inputs.
define ResolutionContext
(
    files: ref[ProgramFiles]?
    module_kind: int
    module_resolution_kind: int
    resolve_exports: int
    resolve_imports: int
    emit_module_format: int
)

; ── the program's file table ───────────────────────────────────────────────────

; PROTOTYPE (parallel parse): one file read and parsed on a TaskPool worker, on
; a heap region of its own that outlives the worker; parse_entry takes it
define PreparsedFile
(
    text: String
    parser: ref[Parser]?
    unported: int
    tag: Slice[char]
    detail: int
)

define ProgramFiles
@resident true (
    paths: ref[Array[Slice[char]]]
    texts: ref[Array[Slice[char]]]
    files: ref[Array[ref[AstNode]?]]
    binders: ref[Array[ref[Binder]?]]
    parsers: ref[Array[ref[Parser]?]]
    emits: ref[Array[bool]]
    formats: ref[Array[int]]
    ; SourceFileMetaData.PackageJsonType per file (slice 253), set with the format
    package_json_types: ref[Array[Slice[char]]]
    ; `file.IsExternalModule()` and the moduleDetection half of it — PARSE-time
    ; answers, recorded here since slice 293 so that the loader and the specifier
    ; host can ask them while walking without a BINDER, which is what let the bind
    ; become a pass of its own
    externals: ref[Array[bool]]
    forced_modules: ref[Array[bool]]
    ; whether the collection has already named this entry — see rename_path_once
    path_claimed: ref[Array[bool]]
    ; the file system's symlinks (slice 260): `link_paths[i]` is a symlink to
    ; `link_targets[i]`, a file or a directory
    link_paths: ref[Array[Slice[char]]]
    link_targets: ref[Array[Slice[char]]]
    ; the resolutions that went through a symlink inside node_modules, the
    ; resolved module's OriginalPath beside its realpath (the symlink cache's input)
    resolution_originals: ref[Array[Slice[char]]]
    resolution_realpaths: ref[Array[Slice[char]]]
    ; compilerOptions.CustomConditions (slice 260)
    custom_conditions: ref[Array[Slice[char]]]
    ; the case's config file (slice 268): its program path and text, for the
    ; option diagnostics' locations
    var config_path: Slice[char]
    var config_text: Slice[char]
    ; the files the program holds (the file loader's answer), null for all
    var members: ref[Array[bool]]?
    ; tryLoadInputFileForPath's options (slice 268): declarationDir and the config
    ; file's path, absolute, and the current directory
    var declaration_dir: Slice[char]
    var config_file_path: Slice[char]
    var current_directory: Slice[char]
    ; compilerOptions.TypeRoots as absolute paths, empty when the option is unset
    ; (the module resolver's resolveFromTypeRoot reads only an explicit one)
    type_roots: ref[Array[Slice[char]]]
    ; the file loader's resolvedModules keys (program.GetResolvedModule): one
    ; `<file index>:<module name>` per name it resolved for a file; null without a
    ; loader, when the checker resolves on its own
    var resolution_keys: ref[Array[Slice[char]]]?
    ; package deduplication (filesByPath of a redirect): per table index the file
    ; a second instance of a package resolves to, -1 for none; null for no redirect
    var redirect_targets: ref[Array[int]]?
    ; the resolver's packageJsonInfoCache keys: every package.json path looked up,
    ; and whether it exists (the incremental program's packageJsons)
    package_json_lookups: ref[Array[Slice[char]]]
    package_json_found: ref[Array[bool]]
    ; whether lookups are recorded: the driver's program turns it on once its own
    ; pre-pass over the file system is done
    var package_json_recording: bool
    ; a referenced project's source per table index: its output declaration file
    ; (the checker's TS6305), null when the program has no references
    var reference_outputs: ref[Array[Slice[char]]]?
    ; a referenced project's output declaration file per table index: whether that
    ; project preserves const enums (GetProjectReferenceFromOutputDts)
    var reference_dts_preserve: ref[Array[int]]?
    ; outputFileToProjectReferenceSource: an output declaration file a redirected
    ; source task loaded, and that source
    included_outputs: ref[Array[Slice[char]]]
    included_output_sources: ref[Array[Slice[char]]]
    ; compilerOptions.paths (null for none) and GetPathsBasePath
    var paths_option: ref[JsonValue]?
    var paths_base_path: Slice[char]
    ; a referenced project's output declaration file or source per table index: its
    ; emit module format under that project's options (-1 for none)
    var reference_module_formats: ref[Array[int]]?
    ; a referenced project's source or output declaration file per table index: 1
    ; when the relative path between the projects' outputs differs from the one
    ; between their root directories (TS2878)
    var reference_rewrite_unsafe: ref[Array[int]]?
    ; a referenced project's source or output declaration file per table index: its
    ; redirect's `paths` (the checker's re-resolution uses them), 0 for none
    var redirect_path_flags: ref[Array[int]]?
    var redirect_path_values: ref[Array[ref[JsonValue]?]]?
    var redirect_path_bases: ref[Array[Slice[char]]]?
    ; trackingvfs.SeenFiles: every path a read-like question named while set (the
    ; watcher's program load), null otherwise
    var seen: ref[Array[Slice[char]]]?
    ; Program.GetPackagesMap: each resolved package name and whether one of its
    ; resolutions was a .d.ts
    var package_map_names: ref[Array[Slice[char]]]?
    var package_map_dts: ref[Array[bool]]?
    ; the file system's directories that hold no file any more (a directory stays
    ; when its files are removed), null for none known
    var directory_paths: ref[Array[Slice[char]]]?
    ; compilerOptions.moduleSuffixes (comma-joined), and per table index a
    ; redirect's own (null for none)
    var module_suffixes: Slice[char]
    var redirect_suffixes: ref[Array[Slice[char]]]?
    ; compilerOptions.preserveSymlinks: a resolution keeps its symlinked path
    var preserve_symlinks: bool
    ; useCaseSensitiveFileNames: a lookup on a case-insensitive file system folds case
    var case_insensitive: bool
    ; the open-addressed index over resolution_keys (1-based key index, 0 empty),
    ; null until the first record; resolvedModules is a map upstream
    var resolution_buckets: ref[Vector[int]]?
    var resolution_mask: int
    ; the open-addressed index over `paths` (1-based row, 0 empty), covering the
    ; first `path_indexed` rows; a rename drops it and the next lookup rebuilds
    var path_buckets: ref[Vector[int]]?
    var path_mask: int
    var path_indexed: int
    ; the resolver's packageJsonInfoCache: each package.json read once, keyed by its
    ; path, with the open-addressed index over the keys (1-based row, 0 empty)
    var package_json_paths: ref[Array[Slice[char]]]?
    var package_json_infos: ref[Array[PackageJsonInfo]]?
    var package_json_buckets: ref[Vector[int]]?
    var package_json_mask: int
    ; per table index the file on DISK its text is read from the first time anyone
    ; asks (empty once read, and for a text handed in); a registered file nothing
    ; reads is never read
    var disk_paths: ref[Array[Slice[char]]]?
    ; per table index the text as a String on this page, made once: the parser
    ; and the binder both take a String, and each used to copy the text for itself
    var strings: ref[Array[String]]?
    ; index_of_file's address index: the file node -> its table index, kept by
    ; every write of a file (a replaced entry is caught by the check at the read)
    var file_index: ref[AddressIndex]?
    ; GetSourceFiles' order as table indices (the loader's program_files), null for
    ; table order: the checker's merges run in it, and a later file's overloads of
    ; one global come first (reorderCandidates)
    var order: ref[Array[int]]?
    ; the open-addressed set of every directory above a row of `paths` (1-based
    ; key, 0 empty), covering the first `dir_indexed` rows: directory_exists_exact
    ; asks it where it scanned every path; a rename drops it
    var dir_keys: ref[Array[Slice[char]]]?
    var dir_buckets: ref[Vector[int]]?
    var dir_mask: int
    var dir_indexed: int
    ; directory_paths chained by case-folding hash, caught up per question and
    ; rebuilt when the list is another one (slice 335)
    var known_dir_list: ref[Array[Slice[char]]]?
    var known_dir_chain: ref[HashChain]?
    ; `paths` in byte order, for the glob walk's per-directory question (slice
    ; 335); built for `sorted_paths_count` rows, dropped by a rename
    var sorted_paths: ref[Array[Slice[char]]]?
    var sorted_paths_count: int
    ; package_json_lookups by folded path hash, made on the first recorded lookup
    ; (slice 357: the lookup walked every earlier one, 99 ms over VS Code)
    var package_json_lookup_chain: ref[HashChain]?
    ; PROTOTYPE (parallel parse): files parsed ahead of the loader's walk on
    ; TaskPool workers, each on a heap region of its own; taken by parse_entry
    var preparsed: ref[Array[ref[PreparsedFile]?]]?
)
{
    function create(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[ProgramFiles] linked


    procedure set_redirect_suffixes(mutable this, index: int, suffixes: Slice[char]) @ret_nonlocal true @deep true linked
















    procedure set_redirect_paths(mutable this, index: int, paths: ref[JsonValue]?, base_path: Slice[char]) @ret_nonlocal true @deep true @deep_this_4 true @deep_whole_4 true linked


























    ; the resolver's `paths` override for an importing file (a redirect's)
    ; getSourceToDtsIfSymlink: under preserveSymlinks a symlinked node_modules file
    ; stands for its real path's project reference output
    procedure symlink_dts_index(mutable this, index: int) @ret_nonlocal true @deep true returns int linked















    procedure apply_redirect_paths(mutable this, index_in: int, mutable resolver: ref[ModuleResolver]) @deep true linked





















    procedure set_reference_rewrite_unsafe(mutable this, index: int) @ret_nonlocal true @deep true linked
















    function reference_rewrite_unsafe_of(this, index: int) @ret_param_0 true @deep true returns bool linked









    procedure set_reference_module_format(mutable this, index: int, format: int) @ret_nonlocal true @deep true linked
















    function reference_module_format_of(this, index: int) @ret_param_0 true @deep true returns int linked









    ; 1: the output of a project that preserves const enums, 0: of one that does
    ; not, -1: no project reference's output
    procedure set_reference_dts_preserve(mutable this, index: int, preserve: bool) @ret_nonlocal true @deep true linked



















    function reference_dts_preserve_of(this, index: int) @ret_param_0 true @deep true returns int linked









    procedure set_reference_output(mutable this, index: int, output: Slice[char]) @ret_nonlocal true @deep true linked
















    function reference_output_of(this, index: int) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked









    ; GetSourceOfProjectReferenceIfOutputIncluded over a file name: the referenced
    ; project's source whose output declaration file it is, else the name itself
    function source_of_reference_output(this, file_name: Slice[char]) @page true @direct true @deep true returns Slice[char] linked












    ; getRedirectForResolution's file name: a referenced project's output declaration
    ; file resolves from its source
    procedure resolution_containing_path(mutable this, index_in: int) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked

















    procedure set_paths(mutable this, paths: ref[JsonValue], base_path: Slice[char]) @deep true @deep_this_2 true @deep_whole_2 true linked





    procedure add_included_output(mutable this, output: Slice[char], source: Slice[char]) @persists true @ret_nonlocal true @deep true linked





    ; a package.json lookup into the cache's key list (once per path)
    procedure record_package_json_lookup(mutable this, path: Slice[char], found: bool) @persists true @deep true linked





























    procedure set_config(mutable this, path: Slice[char], text: Slice[char]) @deep true @deep_pageof_1 true linked






    procedure set_output_options(mutable this, declaration_dir: Slice[char], config_file_path: Slice[char], current_directory: Slice[char]) @deep true @deep_pageof_1 true linked







    procedure set_members(mutable this, list: ref[Array[bool]]) @deep true @deep_this_2 true @deep_whole_2 true linked


    procedure set_order(mutable this, list: ref[Array[int]]) @deep true @deep_this_2 true @deep_whole_2 true linked


    ; the number of files in program order, and the table index of the k-th
    function ordered_count(this) @ret_param_0 true @deep true returns int linked






    function ordered_at(this, k: int) @ret_param_0 true @deep true returns int linked






    ; the program holds the file (every file without a loader)
    function holds(this, i: int) @ret_param_0 true @deep true returns bool linked









    function link_count(this) @ret_param_0 true @deep true returns int linked


    function link_path_at(this, i: int) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked


    function link_target_at(this, i: int) @page true @direct true @ret_param_0 true @deep true returns Slice[char] linked


    procedure add_link(mutable this, link: Slice[char], target: Slice[char]) @persists true @ret_nonlocal true @deep true @deep_pageof_1 true linked






    procedure set_redirect(mutable this, index: int, target: int) @ret_nonlocal true @deep true linked
















    ; the file a resolution to `index` answers (itself without a redirect)
    function redirect_target_of(this, index: int) @ret_param_0 true @deep true returns int linked












    procedure enable_resolution_records(mutable this) @deep true linked


    function resolution_key(host: ref[Page], index: int, name: Slice[char]) @page true @direct true @ret_caller true @deep true returns Slice[char] linked









    ; a loader resolution's package into GetPackagesMap
    procedure record_package(mutable this, package_key: Slice[char], resolved_path: Slice[char]) @deep true @deep_this_4 true @deep_whole_4 true @deep_pageof_1 true linked
































    ; GetPackagesMap's lookup: 0 absent, 1 present, 2 present with a .d.ts
    function package_map_state(this, name: Slice[char]) @ret_nonlocal true @deep true returns int linked




















    procedure record_resolution(mutable this, index: int, name: Slice[char]) @deep true linked










    function resolution_hash(index: int, name: Slice[char]) @ret_nonlocal true @deep true returns int linked














    ; the key just added into the index, rebuilt at double the capacity when the
    ; table would pass half full
    procedure index_resolutions(mutable this, keys: ref[Array[Slice[char]]]) @deep true linked

















































    ; whether the loader resolved `name` for the file (true without a loader)
    function has_resolution(this, index: int, name: Slice[char]) @ret_nonlocal true @deep true returns bool linked























    function key_matches(key: Slice[char], index: int, name: Slice[char]) @ret_nonlocal true @deep true returns bool linked



























    procedure add_type_root(mutable this, root: Slice[char]) @persists true @ret_nonlocal true @deep true linked


    procedure add_custom_condition(mutable this, condition: Slice[char]) @persists true @ret_nonlocal true @deep true linked


    ; the vfs's Realpath: every symlink prefix replaced by its target until none
    ; applies (bounded, a cycle answers the path it reached)
    procedure real_path(mutable this, path: Slice[char]) @page true @direct true @deep true @deep_pageof_1 true returns Slice[char] linked











































    ; the vfs's Realpath fails for a path that does not exist and answers the path
    procedure existing_real_path(mutable this, path: Slice[char], real: Slice[char]) @page true @direct true @deep true returns Slice[char] linked

















    ; a resolution through a symlink: recorded once per original path, on the
    ; TABLE's page — a resolver may run on a scratch page that is released after
    ; it answers (the checker's resolution memo), and the table outlives it
    procedure record_symlink_resolution(mutable files: ref[ProgramFiles], original: Slice[char], real: Slice[char]) @deep true @deep_pageof_1 true linked















