    procedure infer_from_contravariant_types_if_strict_function_types(mutable this, mutable n: ref[InferenceState], mutable source: ref[Type], mutable target: ref[Type]) io reads checker_strict_function_types linked










    ; invokeOnce. The reference's `action` is a func value over a closed set of
    ; three; here it is a tag on §3.5e's rule — 0 the conditional, 1 the generic
    ; mapped pair, 2 the object types.
    ;
    ; ★★★ THE VISIT TABLE IS WRITTEN TWICE PER PAIR AND BOTH WRITES MATTER. The
    ; first parks `Circularity` so that a recursive arrival answers *circular*
    ; rather than recursing; the second records what the action actually
    ; concluded, so a LATER arrival at the same pair reuses the priority instead of
    ; walking it again.
    procedure invoke_once(mutable this, mutable n: ref[InferenceState], mutable source: ref[Type], mutable target: ref[Type], action: int) io reads ordinal_lock linked

















































