    ; someSymbolTableInScope, materialised: `kinds` carries per table whether it
    ; is a LOCAL-NAME lookup (bit 1) and whether it is the globals table (bit 2).
    procedure collect_scope_tables(mutable this, mutable tables: ref[Array[ref[SymbolTable]?]], mutable kinds: ref[Array[int]]) @page true @direct true io reads ordinal_lock linked





































































































