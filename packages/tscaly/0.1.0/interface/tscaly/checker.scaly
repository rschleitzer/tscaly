    procedure try_create_type_reference(mutable this, mutable target: ref[Type]?, type_arguments: ref[Array[ref[Type]?]]?) @page true @returnpage true returns ref[Type]? linked















    ; newParameter and newProperty — one transient symbol carrying a type, and the
