    procedure is_object_type_with_inferable_index(mutable this, mutable t: ref[Type]) returns bool io reads checker_strict_null_checks linked



















































    ; The two reverse memos' shared lookup — the reference's map keyed on
    ; `ReverseMappedTypeKey{sourceId, targetId, constraintId}`, as this file's
    ; linear scan (find_subtype_reduction's idiom). It answers the ROW so that the
    ; caller can tell a cached null from an absent key; see ReverseMappedRow.
    function find_reverse_row(rows: ref[Array[ref[ReverseMappedRow]?]], source_id: int, target_id: int, constraint_id: int) returns ref[ReverseMappedRow]? linked





















    ; ══ THE REVERSE-MAPPED TYPE (slice 160) ═════════════════════════════════
    ;
    ; inferToMappedType and the whole family behind it: the homomorphic
    ; inference, createReverseMappedType, the ReverseMapped type kind, its member
    ; resolution and the reverse inference of one property's type.
    ;
    ; ★★★ WHAT THE CHAPTER IS. Inferring `S` to `{ [P in keyof T]: X }` cannot go
    ; property by property, because the target has no properties — it has a RULE.
    ; So the reference turns the question around: it builds an object with the same
    ; property NAMES as the source whose property TYPES are each inferred BACKWARDS
    ; through `X` (treating `T[P]` as the variable), and then infers from THAT
    ; object to `T`. The object is the ReverseMapped type, and it is lazy in two
    ; steps — its members are resolved on first ask, and each member's type on
    ; first read — because a reverse inference is a whole inference run per
    ; property.
    ;
    ; ★★ THE SECOND INFERENCE IS WHY THE PRIORITY EXISTS. `inferWithPriority` with
    ; HomomorphicMappedType keeps a DIRECT inference to `T` ahead of one made
    ; through `Partial<T>`, and PartialHomomorphicMappedType lowers it again where
    ; the source contains a non-inferrable type — a partial result is worth less
    ; than a whole one, which is a statement about the SOURCE and not about the
    ; mapping.
    procedure infer_to_mapped_type(mutable this, mutable n: ref[InferenceState], mutable source: ref[Type], mutable target: ref[Type], mutable constraint_type: ref[Type]) returns bool io reads checker_strict_null_checks linked




























































































































































    ; inferTypeForHomomorphicMappedType — createReverseMappedType behind a memo on
    ; the triple (source, target, constraint).
    ;
    ; ★ The memo is read as *non-null* rather than as *present*, which is the
    ; reference's own asymmetry with the other reverse table: a null answer here
    ; is recomputed. See ReverseMappedRow's note.
    procedure infer_type_for_homomorphic_mapped_type(mutable this, mutable source: ref[Type], mutable target: ref[Type], mutable constraint: ref[Type]) @page true @returnpage true returns ref[Type]? io reads checker_strict_null_checks linked

















    ; createReverseMappedType. The three shapes are the reference's: an array and a
    ; tuple get the mapping applied to their ELEMENT types eagerly, every other
    ; object type gets the lazy ReverseMapped kind.
    ;
    ; ★★ THE GUARD IS THE CHAPTER'S ADMISSION TEST — *a source is reverse mappable
    ; if it has a string index signature, or has properties and is partially
    ; inferable*. A null here is an ANSWER (the reference returns nil), not a hole,
    ; which is why nothing reports.
    procedure create_reverse_mapped_type(mutable this, mutable source: ref[Type], mutable target: ref[Type], mutable constraint: ref[Type]) @page true @returnpage true returns ref[Type]? io reads checker_strict_null_checks linked















































































































    ; isPartiallyInferableType — *not marked non-inferable, or an object literal
    ; with at least one property of an inferable type, or a tuple with one*. The
    ; three disjuncts are the reference's and the recursion is over the properties.
    procedure is_partially_inferable_type(mutable this, mutable t: ref[Type]) returns bool io reads checker_strict_null_checks linked


























































    ; inferReverseMappedType — the memo, the recursion guard and the worker.
    ;
    ; ★★★ THE MEMO HERE IS READ AS *PRESENT*, so a null result is an ANSWER and
    ; the caller turns it into `unknownType`. That is what makes the guard below
    ; terminating: a source that is deeply nested twice over stores its null and
    ; every later arrival reads it instead of descending again.
    procedure infer_reverse_mapped_type(mutable this, mutable source: ref[Type], mutable target: ref[Type], mutable constraint: ref[Type]) @persists true returns ref[Type]? io reads ordinal_lock linked


































