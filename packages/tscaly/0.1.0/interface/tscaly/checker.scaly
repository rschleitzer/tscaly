    ; mapType(t, getAwaitedTypeNoAlias) — a constituent with no awaited type
    ; drops out, and a union that loses every constituent is nil upstream.
    procedure map_type_awaited_no_alias(mutable this, mutable t: ref[Type]) @page true @returnpage true returns ref[Type]? io reads checker_strict_null_checks linked






































    procedure get_contextual_type(mutable this, mutable node: ref[AstNode], context_flags: int) @page true @returnpage true returns ref[Type]? io reads checker_strict_null_checks linked



















































































































































































