    ; would leave get_declared_type_of_enum_member with nothing to read — its whole
    ; body is `getDeclaredTypeOfEnum(parent)` followed by a read of that slot.
    procedure get_declared_type_of_enum(mutable this, mutable symbol: ref[Symbol]) returns ref[Type]? io reads ordinal_lock linked


























































































