    procedure get_alias_variances(mutable this, mutable symbol: ref[Symbol]) returns ref[Array[int]]? io reads checker_strict_null_checks linked





    ; ── c.varianceLinks ─────────────────────────────────────────────────────

    procedure variance_link_of(mutable this, sym: ref[Symbol]) returns ref[VarianceLink] linked















    ; InterfaceType.TypeParameters() — allTypeParameters minus the trailing
