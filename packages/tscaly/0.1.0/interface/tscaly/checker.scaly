    ; cannot borrow the parse's bytes — it is assembled in a StringBuilder and
    ; copied onto the checker's page, which is what the record's `text` note calls
    ; the one exception.
    procedure concat_eval_results(mutable this, left: EvalResult, right: EvalResult, iss: bool, rof: bool, her: bool) @page true @direct true returns EvalResult linked

















