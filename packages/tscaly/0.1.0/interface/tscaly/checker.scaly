    ; One constituent of a union, with the printer's parenthesis rule.
    ;
    ; ★★★ THE PRE-TEST IS WHAT KEEPS THIS CHEAP AND IT IS EXACT RATHER THAN
    ; CONSERVATIVE: only an ANONYMOUS object type can reach the two arms that build
    ; a below-TypeOperator node, so every other constituent is written straight into
    ; the sink and allocates nothing. A `typeof X` reached through the anonymous arm
    ; takes the scratch and needs no parens — TypeQuery is AT TypeOperator — which
    ; costs one copy and keeps the test a property of the TYPE rather than of the
    ; routing.
    procedure write_union_constituent(mutable this, mutable ct: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked





















































    ; The TEMPLATE LITERAL type's name — `` `a${T}b` `` — out of the interleaved
    ; texts and types. ★`texts` is always exactly one longer than `types` and
    ; `types` holds at least one element, which is what makes the walk a single
    ; loop with the head written first; both are the reference's invariants and
    ; TemplateLiteralTypeData's header records them.
    ;
    ; ★ Nothing inside `${…}` needs parenthesising — a TemplateLiteralTypeSpan's
    ; type is emitted at no precedence at all — so the constituents write straight
    ; through.
    procedure write_template_literal_type(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked
















































    ; `slices.Contains(b.ctx.inferTypeParameters, t)` — by IDENTITY, which is the
    ; only equality a type parameter has.
    function printer_infer_declares(this, t: ref[Type]) returns bool linked















    ; The InferTypeNode — `infer P`, and `infer P extends C` when the DECLARED
    ; constraint is not the one the position would have inferred anyway.
    ;
    ; ★★★ THE CONSTRAINT TEST IS THE WHOLE OF THE ARM AND IT ASKS
    ; getInferredTypeParameterConstraint WITH `omitTypeReferences` TRUE — the
    ; parameter whose note in that function read *its only caller passes false*,
    ; which was true until this arm. With the flag on, `Foo<infer T>` does NOT
    ; take its constraint from Foo's own parameter, so a constraint that came only
    ; from the position is not printed back: upstream's comment says exactly that —
    ; *we omit inferred constraints from type references as they may be elided*.
    ;
    ; ★ A parameter with NO declared constraint prints as the bare keyword and
    ; asks nothing, which is every `infer P` in an ordinary conditional.
    procedure write_infer_type(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads ordinal_lock linked





































    ; The name half of the type-parameter arm, shared by the infer node and the
    ; ordinary one: a type parameter with no symbol prints `?`.
    procedure write_symbol_name_or_question(mutable this, t: ref[Type], mutable out: ref[StringBuilder]) returns bool linked









    ; An operand emitted at TypePrecedenceUnion — the conditional's check and
    ; extends positions.
    procedure write_operand_at_union_precedence(mutable this, mutable ct: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked















    ; The EXTENDS operand of a conditional, and it is NOT the check type's
    ; precedence — slice 173.
    ;
    ; ★★★ UPSTREAM EMITS IT AT `TypePrecedenceLowest` WITH `inExtends` SET, AND
    ; THE FLAG IMMEDIATELY RAISES IT TO `TypePrecedenceFunction`: *in the extends
    ; clause of a ConditionalType or InferType, a ConditionalType must be
    ; parenthesized* — and only a conditional, because Function is the lowest
    ; precedence above it. The port emitted both operands at Union, which wraps a
    ; FUNCTION type as well, so `Required<T>[P] extends (...args: any) => any ? …`
    ; came out with a surplus pair. It is a different type only to a reader, but
    ; it is a different STRING, and the yardstick compares strings.
    ;
    ; ★★ THE STICKINESS IS NOT CARRIED. `inExtends` stays set while the emitter
    ; descends INTO the extends operand until a paren resets it, so a conditional
    ; buried in a union inside an extends clause is parenthesised too. That needs
    ; the flag threaded through the union and intersection constituent writers;
    ; nothing in either corpus reaches it, and the day it does the tell is a
    ; MISSING pair rather than a surplus one.
    procedure write_operand_in_extends(mutable this, mutable ct: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked















    ; An operand emitted at TypePrecedencePostfix — what a TypeOperatorNode's and
    ; an IndexedAccessTypeNode's object position take. Same shape as the
    ; intersection's constituent writer, one precedence step higher.
    procedure write_operand_at_postfix_precedence(mutable this, mutable ct: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked















    ; One constituent of an INTERSECTION. emitIntersectionTypeConstituent emits at
    ; TypePrecedenceTypeOperator exactly as the union's does, so the rule is the
    ; same and only the population differs — see the intersection arm's own note.
    procedure write_intersection_constituent(mutable this, mutable ct: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked















    ; `t.Target() == c.globalArrayType || t.Target() == c.globalReadonlyArrayType`,
    ; asked on the SYMBOL. getGlobalType("Array", 1) is the declared type of the
    ; globals table's `Array` when that symbol is a class or an interface of arity
    ; one, and get_declared_type_of_class_or_interface memoises per symbol — so one
    ; symbol has one declared type and the symbol comparison IS the type
    ; comparison. Asking it this way computes no declared type, which matters
    ; because this runs on every type reference the dump names.
    ;
    ; ★ The arity test is the reference's and it is load-bearing: at a different
    ; arity getGlobalType answers `emptyGenericType`, which no real target equals,
    ; so `interface Array<T, U> {}` is NOT the global array type.
    procedure target_is_global_array_type(mutable this, tgt: ref[Type]) returns bool io reads checker_rewrite_relative_import_extensions linked















    ; `sym == c.globalArrayType.symbol`, asked the way target_is_global_array_type
    ; asks it — out of the GLOBALS table, at arity one. ★It differs from that
    ; function in taking the symbol directly and in NOT testing ReadonlyArray: the
    ; alias arm's shorthand is `T[]` off `globalArrayType` alone.
    procedure target_symbol_is_global_array(mutable this, sym: ref[Symbol]) returns bool io reads checker_rewrite_relative_import_extensions linked





    ; typeReferenceToTypeNode, and the ONE of its four branches this port can
    ; reach.
    ;
    ; ★★★ TWO BRANCHES ARE UNREACHABLE AND THE THIRD WAS NOT — SLICE 109 REFUTED
    ; THIS FILE'S OWN CLOSURE ARGUMENT. It read *the `globalArrayType` /
    ; `globalReadonlyArrayType` fork needs a lib type, and both are nil here
    ; (§3.11) — and the test is `target == globalArrayType`, so a nil global
    ; against a non-nil target is FALSE and the fork is closed by the comparison
    ; rather than by a guard*. The premise is wrong: `globalArrayType` is
    ; `getGlobalType("Array", 1)`, which resolves out of the GLOBALS TABLE — and
    ; since slice 104 that table carries a script file's own top-level names. A
    ; unit declaring `interface Array<T> {}` therefore HAS a global Array without
    ; any lib, and the reference names its declared type `T[]`.
    ;
    ; ★★ IT WAS INVISIBLE UNTIL THE CHAIN LANDED, AND THAT IS THE POINT: the one
    ; unit of the corpus that does it (`compiler_noLibAndNoUncheckedIndexedAccess`
    ; `DestructuringArray@globals.ts`, `@noLib: true`) used to stop at
    ; `type-of-node` before its dump was ever compared, so a wrong NAME was hidden
    ; behind a missing ANSWER. ★What it printed was `Array<T>` at rc 0 — a
    ; well-formed wrong answer, which is the class this port hunts.
    ;
    ; ★ So the fork REPORTS rather than being ported: `getGlobalType` is eager
    ; upstream with `reportErrors=true` and would owe TS2318 for every one of the
    ; forty globals `initializeChecker` resolves, which is §3.11's chapter and not
    ; a name. The trigger is the reference's own predicate asked on the SYMBOL
    ; instead of the type — `get_declared_type_of_class_or_interface` memoises per
    ; symbol, so the target's symbol being the global `Array`/`ReadonlyArray` at
    ; arity 1 is exactly `target == globalArrayType`, and it costs no declared type.
    ;
    ; `ObjectFlagsTuple` needs a tuple target and nothing in this port
    ; mints one. `WriteClassExpressionAsTypeLiteral` is a flag typeToString does
    ; not set. The fourth branch is the whole of what a type reference is called.
    ;
    ; ★★ THE OUTER-TYPE-PARAMETER GROUPING IS A STOP AND NOT AN OMISSION. Its guard
    ; is a non-empty `OuterTypeParameters()`, which a nested generic produces, and
    ; what it builds is a QUALIFIED name — `Outer<T>.Inner<U>` — through
    ; appendReferenceToType. That is a second name shape, not a variation on this
    ; one.
    ; typeReferenceToTypeNode's ARRAY branch plus the emit printer's ArrayTypeNode
    ; and — for a readonly array — its TypeOperatorNode.
    ;
    ; ★★★ THE ELEMENT IS EMITTED AT TypePrecedencePostfix, WHICH IS ONE LEVEL ABOVE
    ; A UNION CONSTITUENT'S, and that single fact is why `wrote_paren_needing_type`
    ; had to become a precedence VALUE this slice. `(A | null)[]` is what the
    ; reference prints and `A | null[]` is a different type; the corpus has the
    ; former eight times.
    ;
    ; ★ `WriteArrayAsGenericType` is not in typeToString's mask, so the `Array<T>`
    ; fork in front of this is closed and the shorthand is the only shape.
    procedure write_array_type_reference(mutable this, mutable t: ref[Type], tgt: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked




































    ; emitPostfixTypeOperand — the operand of an array, an optional or an indexed
    ; access. ★★ ITS TypeQuery EXCEPTION IS UNREACHABLE HERE AND THAT IS EXACT: the
    ; guard is `ast.IsParseTreeNode(parent)`, and every node this printer would build
    ; is SYNTHESIZED, so the operand always goes at Postfix.
    ;
    ; ★★★ THE SENTENCE THAT FOLLOWED — *"TypeQuery is NonArray anyway, so the two
    ; answers coincide for it in any case"* — WAS FALSE, AND IT COST SIX UNITS
    ; (slice 183). `GetTypeNodePrecedence` answers TypePrecedenceTypeOperator for
    ; KindTypeQuery, with a comment saying exactly why: it is a NonArrayType that is
    ; treated as an operator SO THAT this position parenthesizes it. The exception
    ; above is indeed unreachable, but only because the unguarded path already
    ; wraps — `TypeOperator < Postfix` — which is the opposite of what the note
    ; claimed and made `(typeof C)[]` come out as `typeof C[]`. **An unreachability
    ; argument and the reason a line is harmless are two different claims; this note
    ; proved the first and asserted the second.** The precedence is set in
    ; symbol_to_type_node, which is the arm that builds the TypeQuery.
    procedure write_postfix_type_operand(mutable this, mutable element: ref[Type]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked













    ; typeReferenceToTypeNode's TUPLE branch plus the emit printer's TupleTypeNode,
    ; NamedTupleMember, RestTypeNode and OptionalTypeNode.
    ;
    ; ★★★ A TUPLE ELEMENT IS EMITTED AT TypePrecedenceLowest AND IS THEREFORE NEVER
    ; PARENTHESIZED — `emitTupleElementType` is `emitTypeNodeOutsideExtends`, whose
    ; precedence argument is Lowest. So `[A | B, C]` is written straight through,
    ; which is the OPPOSITE of the array element one function above. The two are ten
    ; lines apart in the reference and disagree; reading one and assuming the other
    ; is how `[(A | B)]` would get written.
    ;
    ; ★★★ THE EMPTY TUPLE PRINTS `[]` AND THE REASON IS A FLAG ALIAS. The reference's
    ; fork is `if b.ctx.encounteredError || flags&AllowEmptyTuple != 0`, and
    ; `FlagsIgnoreErrors` — which typeToStringEx adds — is DEFINED as a union that
    ; INCLUDES AllowEmptyTuple. So the branch below the fork (`encounteredError =
    ; true; return nil`, i.e. no name at all) is unreachable from this entry point.
    ;
    ; ★★ THE OPTIONAL MARKER IS WRITTEN TWICE IN TWO PLACES AND THEY ARE NOT THE
    ; SAME `?`: a LABELLED element writes `name?: T` (the question token rides with
    ; the name) and an unlabelled one writes `T?` (an OptionalTypeNode, postfix). A
    ; REST element likewise: labelled is `...name: T[]` and unlabelled is `...T[]`,
    ; and in BOTH the element type is wrapped in an extra array — the tuple's own
    ; element type is the ELEMENT, not the array.
    procedure write_tuple_type_reference(mutable this, mutable t: ref[Type], tgt: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_exact_optional_property_types linked









































































































































    ; write_tuple_element_type over an ALREADY RENDERED piece — the REST wrapper's
    ; `[]` with its postfix parentheses, or the piece itself.
    procedure write_tuple_piece(piece: String, prec: int, rest: bool, mutable out: ref[StringBuilder]) linked










    ; The emit printer's `emitTypeNode(node, prec)` over a piece whose precedence
    ; was recorded when it was written.
    procedure write_parenthesized_piece(piece: String, prec: int, at: int, mutable out: ref[StringBuilder]) linked









    ; One tuple element's TYPE, at Lowest precedence, with the extra `[]` a REST
    ; element's node carries. ★A VARIADIC element does NOT get the array wrapper —
    ; the reference's `IfElse(flags&Rest != 0, NewArrayTypeNode(...), ...)` tests
    ; Rest and not Variable — because a variadic element's type IS the array.
    procedure write_tuple_element_type(mutable this, mutable arg: ref[Type]?, rest: bool, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked










    procedure type_reference_to_type_node(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_exact_optional_property_types linked

































































































































































































































    ; getParentSymbolOfTypeParameter — the symbol of the CONTAINER a type parameter
    ; is declared on, which is what names a group in the qualified form above.
    ; ★The JSDoc template-tag arm is commented out upstream (`!!! JSDoc support`)
    ; and is therefore not a stop here either.
    procedure parent_symbol_of_type_parameter(mutable this, mutable tp: ref[Type]?) returns ref[Symbol]? io reads ordinal_lock linked
















    ; getTypeAliasForTypeLiteral — the name a circular type literal prints under.
    ;
    ; ★ The DECLARATION's parent and not the declaration: the symbol belongs to the
    ; `{ … }` node, and what carries the alias name is whatever the literal is the
    ; right-hand side OF, with parenthesised types walked through.
    procedure type_alias_for_type_literal(mutable this, mutable t: ref[Type]) returns ref[Symbol]? io reads ordinal_lock linked



















    ; ── slice 111: the anonymous object type ─────────────────────────────────
    ;
    ; createAnonymousTypeNode → createAnonymousTypeNodeEx, then
    ; createTypeNodeFromObjectType, then the emit printer. THIS PORTS THE THREE
    ; NAME SHAPES AN ANONYMOUS OBJECT TYPE HAS — the function type, the
    ; constructor type and the type literal — plus the `typeof` shortcut in front
    ; of them.
    ;
    ; ★★★ FIVE FLAGS DECIDE THIS FAMILY AND typeToString SETS NONE OF THEM, which
    ; is what makes it portable at all. `printer.go`'s typeToString is
    ; `AllowUniqueESSymbolType | UseAliasDefinedOutsideCurrentScope`, widened by
    ; typeToStringEx to `| IgnoreErrors | NoTruncation`. Absent are:
    ;   • WriteClassExpressionAsTypeLiteral — collapses shouldEmitTypeOfSymbol's
    ;     long second conjunct to `true`, and removes the private/protected
    ;     tracker calls and the prototype filter from the property loop;
    ;   • UseStructuralFallback — collapses shouldWriteTypeOfFunctionSymbol's
    ;     accessibility conjunct to `true`, so no visibility question is asked;
    ;   • UseTypeOfFunction — leaves `visitedTypes.Has(id)` as the SOLE route by
    ;     which a function symbol reaches `typeof`, which is why visited_types is
    ;     an input to the NAME and not only a recursion guard;
    ;   • OmitThisParameter and OmitParameterModifiers — so the this-parameter is
    ;     written and `preserveModifierFlags` is the caller's own `false`;
    ;   • MultilineObjectLiterals — so a type literal is EFSingleLine, which is
    ;     the whole of its punctuation.
    ; ★★ And two context VALUES do the same work: `enclosingDeclaration` is nil
    ; (the collapse write_symbol_name's header already names) and `verbosity` is
    ; nil, so `maxExpansionDepth` is −1 — which makes `shouldExpandType` FALSE at
    ; its first line and `isExpanding` false for the whole walk. Without that the
    ; typeof arm would be a fork rather than a return, and the property loop would
    ; carry a prototype filter.
    ;
    ; ★★★ The truncation cutoff is 1 000 000 characters under NoTruncation
    ; (`noTruncationMaximumTruncationLength`). This line read *so
    ; `checkTruncationLength` is false for every name this corpus can produce and
    ; the three elision arms are not written* until slice 170, and the object
    ; spread's arms produced the counter-example on the first build — see
    ; truncation_budget_exceeded, which asks the question at the reference's four
    ; sites and reports rather than eliding.
    procedure create_anonymous_type_node(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked
































































































































































    ; createMappedTypeNodeFromType plus the emit printer's MappedTypeNode, which
    ; under EFSingleLine is `{ `, the one member, `;` and ` }`.
    ;
    ; ★★★ THE PUNCTUATION IS THE PRINTER'S AND IT IS ASYMMETRIC IN A SECOND WAY
    ; the type literal is not: the trailing semicolon comes BEFORE the space, so a
    ; mapped type is `{ [P in K]: T; }` — the same two characters as a literal's,
    ; written by a different line. Both spellings are read off the reference's own
    ; answers (`internal/printer/printer_test.go`'s nine MappedTypeNode rows).
    ;
    ; ★★★ THREE FORKS OF THE REFERENCE ARE CONSTANT-FALSE UNDER THIS ENTRY POINT
    ; AND EACH IS WRITTEN AS ITS TEST RATHER THAN FOLDED AWAY. All three are
    ; guarded by `FlagsGenerateNamesForShadowedTypeParams`, which typeToString does
    ; not set — the same mask create_anonymous_type_node's own note names — so
    ; `needsModifierPreservingWrapper` is false, no fresh type variable is minted,
    ; and the constraint node is either `keyof <modifiers type>` or the constraint
    ; type itself.
    ;
    ; ★ The type parameter's NAME is the declaration's, which is what
    ; `typeParameterToName` answers with that flag unset — and an INSTANTIATED
    ; mapped type shares the original's symbol (clone_type_parameter passes it
    ; through), so the two spellings cannot diverge.
    procedure create_mapped_type_node_from_type(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked






































































































    ; isClassInstanceSide — the symbol's class flag, then `t` against the symbol's
    ; DECLARED type. ★The second disjunct (`ObjectFlagsIsClassInstanceClone`) has no
    ; writer in this port; it is set by getTypeWithThisArgument's clone path, which
    ; resolve_object_type_members reaches but which never mints an ANONYMOUS type,
    ; so it cannot arrive here. Written as the reference's test all the same.
    procedure is_class_instance_side(mutable this, t: ref[Type], mutable sym: ref[Symbol]) returns bool io reads checker_strict_null_checks linked














    ; shouldEmitTypeOfSymbol, with `forceExpansion` and `forceClassExpansion` both
    ; FALSE — createAnonymousTypeNode is the only caller and passes false twice.
    ;
    ; ★★★ THE LONG SECOND CONJUNCT IS `true`, AND THAT IS A FLAG ARGUMENT RATHER
    ; THAN A SIMPLIFICATION. Upstream reads
    ; `!(ValueDeclaration != nil && IsClassLike(…) && flags&WriteClassExpressionAsTypeLiteral != 0 && …)`;
    ; the third factor is false under this entry point, so the parenthesis is false
    ; and its negation is true. Both IsSymbolAccessible calls inside it are
    ; therefore never asked, which is the only reason this arm needs no visibility
    ; machinery at all.
    procedure should_emit_type_of_symbol(mutable this, mutable sym: ref[Symbol], type_id: int, mutable out_sym: ref[ref[Symbol]?]) returns bool io reads checker_rewrite_relative_import_extensions linked

















    ; shouldWriteTypeOfFunctionSymbol.
    ;
    ; ★★★ ITS ANSWER REDUCES TO `(isStaticMethod || isNonLocalFunction) && visitedTypes.Has(id)`,
    ; and the second half is why the function is not dead in a port with no
    ; UseTypeOfFunction caller: a function that names ITSELF in its own type —
    ; `function f() { return f; }` — re-enters the printer with its own type id on
    ; the visited stack, and `typeof f` is the only finite name there is.
    ;
    ; ★★ THE isFunctionExpressionSymbol RE-TARGETING IS WRITTEN, NOT DROPPED, and it
    ; always fires once its branch is taken: the guard is
    ; `ValueDeclaration.Parent != ctx.enclosingDeclaration`, a comparison against
    ; NIL, so it holds whenever there is a parent at all. That is the one place in
    ; this family where the symbol that gets NAMED is not the symbol that was asked
    ; about, which is why the caller takes it back through an out-cell.
    procedure should_write_type_of_function_symbol(mutable this, mutable sym: ref[Symbol], type_id: int, mutable out_sym: ref[ref[Symbol]?]) returns bool io reads ordinal_lock linked























































































































    ; `ast.IsStatic` — a class element carrying the `static` modifier, or a static
    ; BLOCK. ★The second disjunct cannot arrive at the one call site above (a static
    ; block declaration carries no SymbolFlagsMethod) and is written as the
    ; reference's line rather than folded away.
    function declaration_is_static(this, n: ref[AstNode]) returns bool linked








    ; The tail of shouldWriteTypeOfFunctionSymbol's function-expression chain, asked
    ; on the declaration's PARENT: a variable declaration inside a declaration list
    ; inside a statement whose own parent is a source file or a module block.
    function parent_is_top_level_variable(p: ref[AstNode]) returns bool linked






















