    ; getUniqueTypeParameters, with hasTypeParameterByName and
    ; getUniqueTypeParameterName below it.
    ;
    ; ★★★ THE CLONE'S TWO SLOTS ARE THE POINT, AND SLICE 125 ALREADY DECLARED THEM
    ; for the mapped type's `P`: a renamed parameter carries `target` (the original)
    ; and `mapper` (old → new), and `getConstraintFromTypeParameter`'s first branch
    ; is what reads them. Without the mapper the renamed parameter would answer the
    ; ORIGINAL's constraint verbatim, which is wrong as soon as one renamed
    ; parameter's constraint mentions another.
    ;
    ; ★★ THE MAPPER IS BUILT ONCE AND STORED ON EVERY NEW PARAMETER, after the
    ; loop — it cannot be built inside it, because a parameter renamed early must
    ; map through the renamings that come later too.
    procedure get_unique_type_parameters(mutable this, context: ref[InferenceContext], mutable type_parameters: ref[Array[ref[Type]?]]) @page true @direct true returns ref[Array[ref[Type]?]]? reads ordinal_symbols linked




































































































    function has_type_parameter_by_name(type_parameters: ref[Array[ref[Type]?]], name: Slice[char]) returns bool linked




















    ; getUniqueTypeParameterName. ★The trailing-digit strip keeps `len > 1`, so a
    ; parameter literally named `1` keeps its name and becomes `11` rather than
