    ; ── slice 130: the ERROR ELABORATION ────────────────────────────────────
    ;
    ; elaborateObjectLiteral / elaborateArrayLiteral / elaborateArrowFunction and
    ; the elaborateElement they all end in.
    ;
    ; ★★★ THE CHAPTER'S WHOLE PRODUCT IS *WHERE* THE DIAGNOSTIC LANDS, and that is
    ; exactly what a dump can see. `var x: { a: string } = { a: 1 }` without it is
    ; one TS2322 spanning the WHOLE literal; with it the relation is re-asked per
    ; property and the TS2322 lands on the `1`. So this is not an elaboration in
    ; the decorative sense — it moves a span, and a span is compared.
    ;
    ; ★★★ THE `diagnosticOutput` LIST IS NOT PORTED AND THE REASON IS THIS PORT'S
    ; STANDING CONTAINMENT: upstream every elaborator COLLECTS its diagnostics and
    ; the caller decides whether to emit them, because the collected diagnostic is
    ; then decorated with RELATED INFO (*the expected type comes from property 0*).
    ; A dump carries pos, end and code — related info is invisible in both
    ; directions — so the collection's only observable product is the emission
    ; itself, which this port does at the line. What IS carried is the reference's
    ; own control: `len(diags) == 0` decides the return, and that is the boolean
    ; `check_type_related_to_ex` already answers.
    ;
    ; ★★ THE RETURN VALUE IS AN OR-FOLD AND NOT AN EARLY EXIT: every property of an
    ; object literal is elaborated, so one bad property does not hide the next.
    procedure elaborate_object_literal(mutable this, mutable node: ref[AstNode], mutable source: ref[Type], mutable target: ref[Type], relation: int) returns bool io reads ordinal_lock linked



































































    ; elaborateArrayLiteral, whole.
    ;
    ; ★★★ THE RE-CHECK IN ITS HEAD IS THE FUNCTION. A `[1, "a"]` written against a
    ; tuple target has been checked WITHOUT that context and widened to
    ; `(string | number)[]`, which has no per-index property to elaborate against;
    ; so the literal is re-checked with the target pushed as the contextual type
    ; and `ForceTuple`, and only the tuple that comes back can be walked. A port
    ; that skipped the re-check would elaborate nothing for exactly the inputs the
    ; function exists for.
    procedure elaborate_array_literal(mutable this, mutable node: ref[AstNode], mutable source: ref[Type], mutable target: ref[Type], relation: int) returns bool io reads checker_exact_optional_property_types linked
























































    ; `getPropertyOfType(target, jsnum.Number(i).String())` — the index rendered as
    ; a decimal NAME, which is what a tuple's members are keyed by.
    procedure tuple_has_index_property(mutable this, mutable target: ref[Type], index: int) returns bool io reads checker_strict_bind_call_apply linked







    procedure render_decimal(mutable out: Slice[char], value: int) returns int linked

























    ; elaborateElement — the routine every elaborator ends in.
    ;
    ; ★★★ IT ASKS THE RELATION TWICE AND THE SECOND ASK IS THE ONE THAT REPORTS.
    ; First without an error node, to find out whether this element is the problem
    ; at all; then, if it is, either RECURSIVELY through elaborate_error (so a
    ; nested literal narrows the span further) or with the element as the error
    ; node. That is why an element which relates fine costs nothing.
    ;
    ; ★★ `specificSource` IS THE EXPRESSION'S OWN TYPE, not the indexed access —
    ; `checkExpressionForMutableLocationWithContextualType` re-checks the initializer
    ; under the target property's type — and when the two DISAGREE the reference
    ; asks a second time with the indexed access, so that an expression whose
    ; contextual re-check happens to succeed still reports.
    ;
    ; ★ The `diagnosticFactory` parameter has one caller upstream (the JSX text
    ; child's dynamic message) and that chapter is elsewhere; it is not a
    ; parameter here for §3.5be's reason.
    ; ★★★ `text_child_code` IS THE REFERENCE'S `createDiagnostic` FUNC VALUE, AND IT
    ; COLLAPSES TO A CODE BECAUSE OF WHAT A DIAGNOSTIC IS HERE. Upstream the field
    ; is `func(prop *ast.Node) *ast.Diagnostic`, and its ONE producer builds
    ; `NewDiagnosticForNode(prop, <message>, tagName, childrenPropName,
    ; typeToString(childrenTargetType))` — a closure over three INTERPOLATION
    ; arguments and nothing else. This port's diagnostics carry a code and a span
    ; (the yardstick's own `C pos end code`), so the three captures have no reader
    ; and the func value is a code plus the `prop` the caller already passes:
    ; §3.18's tag with the tag left implicit, 0 meaning *no custom diagnostic*.
    procedure elaborate_element(mutable this, mutable source: ref[Type], mutable target: ref[Type], relation: int, prop: ref[AstNode], mutable next: ref[AstNode]?, mutable name_type: ref[Type], error_code: int, text_child_code: int, text_child_args: ref[Array[String]]?) returns bool io reads checker_no_unchecked_indexed_access linked



























































































































    ; elaborateElement's related information on the diagnostic it reported: the
    ; index signature, else the property (or the type) the expected type comes from,
    ; neither from a default library file
    procedure elaborate_element_related_info(mutable this, element_mark: int, source: ref[Type], mutable target: ref[Type], mutable name_type: ref[Type]) io reads checker_strict_bind_call_apply linked





























































    ; getBestMatchIndexedAccessTypeOrUndefined — the target property's type, and
    ; for a UNION target the one BEST MATCHING constituent's, so that an
