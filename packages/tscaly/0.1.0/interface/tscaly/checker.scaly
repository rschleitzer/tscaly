    function get_host_signature_from_jsdoc(node: ref[AstNode]) returns ref[AstNode]? linked




































    ; resolveJSDocMemberName. ★The qualified fallback is the whole reason the
    ; function is recursive: `A.b` first tries the entity name whole, and only if
