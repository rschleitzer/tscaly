    function visited_type(this, id: int) returns bool linked












    ; ── the five signature FORMS, which are one function upstream ────────────
    ;
    ; signatureToSignatureDeclarationHelper takes a `kind` and switches on it at the
    ; very end; these are the five that a type name can contain, and the number is
    ; what the emit printer does with the same three pieces.
    ;
    ;   FunctionType       <T>(p: A) => R
    ;   ConstructorType    new <T>(p: A) => R
    ;   CallSignature      <T>(p: A): R
    ;   ConstructSignature new <T>(p: A): R
    ;   MethodSignature    m?<T>(p: A): R
    ;
    ; ★ The other eight kinds of the switch are declaration EMITTER shapes
    ; (FunctionDeclaration, MethodDeclaration, ArrowFunction, the accessors, …) and
    ; no type NAME contains one — except the two accessor kinds, which
    ; addPropertyToElementList reaches and which stop there for a reason of their
    ; own.

    ; createTypeNodeFromObjectType — the four exits, in the reference's order.
    ;
    ; ★★★ THE ORDER IS LOAD-BEARING TWICE OVER. The `properties == 0 &&
    ; indexInfos == 0` gate stands in front of all three special shapes, so a type
    ; with ONE call signature AND a property is a type LITERAL and not a function
    ; type — which is exactly how `{ (a: string): void; (a: number): void; }` and
    ; `(x: string) => void` come out of the same builder. And the empty test comes
    ; first, so a type with nothing at all is `{}` rather than a literal with no
    ; members.
    procedure create_type_node_from_object_type(mutable this, mutable t: ref[Type], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked












































































































































































    ; createTypeNodesFromResolvedType plus the emit printer's TypeLiteralNode, which
    ; under EFSingleLine is `{ `, each member, `; `, and `}`.
    ;
    ; ★★★ THE PUNCTUATION IS THE PRINTER'S AND IT IS NOT SYMMETRIC: the separator
    ; and the TERMINATOR are the same two characters, so a one-member literal is
    ; `{ a: number; }` and not `{ a: number }`. The empty literal takes the other
    ; branch above and writes no space at all. Both spellings are read off the
    ; reference's own answers rather than reasoned about.
    ;
    ; ★★ THE MEMBER ORDER IS THE REFERENCE'S AND IT IS NOT THE DECLARATION ORDER:
    ; call signatures, then construct signatures, then index signatures, then
    ; properties — so `{ (a: string): void; x: number; }` comes out that way even
    ; where the source wrote `x` first.
    ; getResolvedTypeWithoutAbstractConstructSignatures — a copy of the object type
    ; with the abstract construct signatures filtered out, and the one memo the
    ; printer owns (`without_abstract_construct_signatures` on StructuredMembers).
    ;
    ; ★★★ THE COPY MEMOISES ITSELF, AND THAT LINE IS THE TERMINATION ARGUMENT.
    ; Upstream writes both `t.objectTypeWithoutAbstractConstructSignatures =
    ; typeCopy` and `typeCopy.objectTypeWithoutAbstractConstructSignatures =
    ; typeCopy`; the second is what makes asking the copy the identity instead of
    ; a second copy. Here the abstract fork above never reaches the copy anyway —
    ; it has no abstract construct signature left — but the slot is written as the
    ; reference writes it, because the invariant is the reference's and not this
    ; caller's.
    ;
    ; ★ The three early exits are the reference's, in its order: no construct
    ; signature at all is the type itself, a filled memo is the answer, and a
    ; filter that removed nothing memoises the type as its own copy.
    procedure get_resolved_type_without_abstract_construct_signatures(mutable this, mutable t: ref[Type]) @page true @returnpage true returns ref[Type]? io reads checker_rewrite_relative_import_extensions linked











































    procedure write_type_literal(mutable this, mutable sm: ref[StructuredMembers], mutable calls: ref[Array[ref[Signature]?]], mutable ctors: ref[Array[ref[Signature]?]], reverse_mapped: bool, mutable out: ref[StringBuilder]) returns bool io reads checker_exact_optional_property_types linked


































































































    ; getExpandedParameters, at `skipUnionExpanding` — the only shape this printer
    ; asks for, which closes the union branch and leaves the TUPLE one.
    ;
    ; ★★★ THE NOTE THIS REPLACES SAID THE LIST COMES BACK UNCHANGED BECAUSE *the
    ; tuple half of the port does not exist*, AND THAT PREMISE EXPIRED WITHOUT A
    ; WORD. The port mints tuple types and prints tuple labels; what kept the claim
    ; alive was the wall in get_effective_rest_type one chapter over, so every unit
    ; that would have shown the difference stopped before the printer ran. Lifting
    ; that wall (slice 161) turned four units from UNPORTED into a printed
    ; `(...args: [x: number]) => void` where the reference writes `(x: number) =>
    ; void` — §3.5eq exactly, a wrong answer a wall had been covering.
    ;
    ; ★★ AN ELEMENT FLAGGED `Rest` NEEDS createArrayType AND THEREFORE THE LIB
    ; (§3.11), so that one element shape reports; every other flag combination is
    ; answered here.
    procedure get_expanded_parameters(mutable this, mutable sig: ref[Signature]) returns ref[Array[ref[Symbol]?]]? io reads checker_strict_null_checks linked



































































































































    ; signatureToSignatureDeclarationHelper, and the emit printer for the five
    ; forms above. `name` is the MethodSignature's property name and is null for
    ; every other form; the question token rides with it, because upstream passes
    ; both through the same options record.
    ;
    ; ★★ THE TYPE-ARGUMENT FORK IN FRONT OF THE TYPE PARAMETERS IS DEAD:
    ; `flags&WriteTypeArgumentsOfSignature` is not in typeToString's mask, so the
    ; `signature.target`/`mapper` branch is never taken and the declared type
    ; parameters are what get written.
    ; enterSignatureScope's one product this printer needs: `if mapper != nil {
    ; b.ctx.mapper = mapper }` over the whole signature declaration, restored
    ; after. Everything else that scope does — the fake parameter scopes, the
    ; type-parameter table — serves accessibility, which is unconditional here
    ; (see the node-REUSE site's header). ★The guard is the reference's: a
    ; signature with no mapper of its own does not CLEAR an outer one, because a
    ; nested signature type is printed inside the outer signature's scope.
    procedure write_signature_form(mutable this, mutable sig: ref[Signature], form: int, mutable name: ref[Symbol]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked









    procedure write_signature_form_scoped(mutable this, mutable sig: ref[Signature], form: int, mutable name: ref[Symbol]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked






































































































































    ; serializeReturnTypeForSignature, whose whole reuse half is behind
    ; `ctx.enclosingDeclaration != nil` — nil here, so the pseudochecker is never
    ; consulted and the answer is serializeInferredReturnTypeForSignature.
    ;
    ; ★★ `suppressAny` IS FALSE TWICE OVER: SuppressAnyReturnType is not in the mask
    ; AND signatureToSignatureDeclarationHelper clears it before the call. So the
    ; `any` return is written rather than elided, which is what makes `() => any`
    ; the name of an unannotated signature.
    ;
    ; ★★★ THE TYPE-PREDICATE FORK LANDED IN SLICE 134, and until then it was a stop
    ; DETECTED FROM THE DECLARATION rather than from the predicate.
    ; serializeInferredReturnTypeForSignature asks getTypePredicateOfSignature first
    ; and answers `x is T` / `asserts x is T` when there is one; the Signature
    ; record's `resolved_type_predicate` was one of the five slots this port
    ; defers, so the predicate could not be READ, and what could be read was the
    ; ANNOTATION that produces one. ★★★That detection was exact for the DECLARED
    ; predicate and blind to the INFERRED one — a boolean-returning single-return
    ; function carries a predicate with no annotation anywhere — so the stop was
    ; not merely coarse, it MISSED a case while looking precise. See the type
    ; predicate chapter.
    ;
    ; ★ `ctx.mapper` is nil at every entry point this printer has (there is no
    ; instantiating node builder here), so the instantiateTypePredicate fork of
    ; serializeInferredReturnTypeForSignature answers the predicate itself and is
    ; written as that rather than as a branch on a slot nothing sets.
    ;
    ; ★★ `ctx.suppressReportInferenceFallback` HAS NOTHING TO PORT, and that is read
    ; off its READERS rather than guessed from its name: all four sit in
    ; serializeTypeForDeclaration's PSEUDOCHECKER path (`reportErrors :=
    ; !suppressReportInferenceFallback`, then pseudoTypeEquivalentToType), and this
    ; function's own note two paragraphs up already records that the pseudochecker
    ; is never consulted here because ctx.enclosingDeclaration is nil. It is worth
    ; saying because the INFERRED predicate runs a body walk from inside the
    ; printer — checkExpressionCached plus the flow machinery — so a flag named
    ; *suppressReport* standing over that call reads exactly like a diagnostic gate
    ; and is not one.
    ; ★★★ THE RETURN TYPE IS INSTANTIATED THROUGH THE PRINTER'S ACTIVE MAPPER
    ; (slice 218). serializeReturnTypeForSignature reads `instantiateType(
    ; getReturnTypeOfSignature(signature), b.ctx.mapper)` for every signature
    ; that has a declaration, and enterNewScope KEEPS the outer mapper when the
    ; signature entered has none — so a fresh function type printed INSIDE an
    ; instantiated signature (an alias type argument of an unresolved reference,
    ; `ClassMethodDecoratorContext<This, (this: This, ...args: Args) => Return>`)
    ; prints its return type under the outer instantiation (`=> void`) while its
    ; parameters, which symbolToParameterDeclaration reads with a plain
    ; getTypeOfSymbol, stay as declared (`this: This`). The predicate is mapped
    ; the same way (serializeInferredReturnTypeForSignature); the reference asks
    ; the return type BEFORE the predicate, and the order is kept because both
    ; are instantiations with caches.
    procedure write_return_type_of_signature(mutable this, mutable sig: ref[Signature], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked




































    ; ── slice 134: THE TYPE PREDICATE ────────────────────────────────────────
    ;
    ; ★★★ IT RETIRES A SLOT THIS FILE HAS DEFERRED TWICE. Signature's header lists
    ; `resolved_type_predicate` among the five fields *"whose only writers are
    ; chapters this port has not opened"* and names getTypePredicateOfSignature as
    ; the writer; write_return_type_of_signature stops on the SYMPTOM, detecting a
    ; predicate from its ANNOTATION because the slot could not be read. Both are
    ; this chapter, and it is the fourth field of the five to land.
    ;
    ; ★★★ THERE ARE TWO WAYS TO GET ONE AND ONLY ONE OF THEM IS WRITTEN DOWN IN THE
    ; SOURCE. `function f(x: unknown): x is string` declares its predicate; but a
    ; boolean-returning function with ONE return statement gets a predicate
    ; INFERRED from that return's flow — `function f(x: unknown) { return typeof x
    ; === "string" }` is `x is string` — and the inference is run through the flow
    ; machinery on two synthetic flow nodes, a TrueCondition and a FalseCondition
    ; over the return expression. The `false` half is the part that makes it sound:
    ; *"x is T means that x is T if and only if it returns true"*, so the ELSE
    ; branch must reduce to `never` or there is no predicate.
    ;
    ; ★★ THE `composite` ARM IS NOT WRITTEN AND CANNOT BE. `sig.composite` is one of
    ; the two slots Signature still defers, and its own note calls the arm
    ; *"provably dead for every signature this file can mint"* — nothing here builds
    ; a union or intersection of signatures. The arm is named rather than reported,
    ; because a row for it would be a row no input can reach.
    ;
    ; ★ noTypePredicate is a SENTINEL and not a null: *asked, none* has to differ
    ; from *not asked*, which is what the `type_predicate_computed` flag already
    ; says one slot up. Both are kept — the flag is what this port's readers use,
    ; the sentinel is what the reference's `== c.noTypePredicate` test reads — and
    ; they agree by construction, because the only writer sets both.

    ; ★★★ THE THREE FUNCTIONS THIS CHAPTER LOOKED LIKE IT NEEDED WERE ALREADY
    ; HERE, and the note that sent this slice looking for them is what was expired:
    ; write_return_type_of_signature's header said `resolved_type_predicate` *"is
    ; one of the five slots this port defers"*, while getTypePredicateOfSignature,
    ; createTypePredicateFromTypePredicateNode and instantiateTypePredicate have
    ; stood in the relation's own chapter since slice 123 — see them beside
    ; has_type_predicate_or_never_return_type. What was missing is ONE ARM of the
    ; first (`get-type-predicate-from-body`) and the PRINTER's use of it.
    ;
    ; ★★★ AND THE COMPILER SAID NOTHING WHEN THIS SLICE WROTE ALL THREE A SECOND
    ; TIME: a duplicate METHOD in one concept compiles, one of the two is emitted,
    ; and `tests/run.sh`'s duplicate scan covers only TOP-LEVEL `define`s. **Grep
    ; the source for every reference function name before writing it** — §3.5fo's
    ; rule about reading the reference applies to reading the PORT as well.

    ; getTypePredicateFromBody — the INFERRED predicate.
    ;
    ; ★★ "Only attempt to infer a type predicate if there's exactly one return."
    ; An arrow with an expression body IS that one return; a block body is walked,
    ; and the walk bails on the SECOND return, on a bare `return;` and on a
    ; function that can fall off its end.
    procedure get_type_predicate_from_body(mutable this, mutable fn: ref[AstNode]) returns ref[TypePredicate]? io reads ordinal_lock linked































    ; ast.ForEachReturnStatement over getTypePredicateFromBody's visitor, fused the
    ; way for_each_return_statement_is_context_sensitive is (§3.9d: the visitor
    ; does not survive as a closure, so the walk carries the state).
    ;
    ; ★ THE KIND LIST IS THE WALK'S WHOLE DEFINITION and it is the reference's: a
    ; return inside a NESTED FUNCTION belongs to that function, so the descent
    ; enters only the statement forms — block, if, the loops, `with`, switch and
    ; its clauses, a label, try and catch.
    procedure find_single_return_expression(this, node: ref[AstNode], mutable out_expr: ref[ref[AstNode]?], mutable out_bailed: ref[bool]) linked










































    ; checkIfExpressionRefinesAnyParameter.
    ;
    ; ★ THE FOUR SKIPS ARE THE REFERENCE'S, and the boolean one carries its
    ; comment: *"refining `x: boolean` to `x is true` or `x is false` isn't
    ; useful."* The other three are an assigned parameter (its declared type is not
    ; what a caller sees), a rest parameter and a parameter whose name is a binding
    ; pattern — none of which a predicate can name.
    procedure check_if_expression_refines_any_parameter(mutable this, mutable fn: ref[AstNode], mutable expr_in: ref[AstNode]) returns ref[TypePredicate]? io reads ordinal_lock linked


























































    ; checkIfExpressionRefinesParameter — the flow question, asked twice on two
    ; synthetic flow nodes.
    ;
    ; ★★★ THE `false` HALF IS WHAT MAKES IT SOUND and the reference states it:
    ; *"`x is T` means that x is T if and only if it returns true. If it returns
    ; false then x is not T. This means that if the function is called with an
    ; argument of type trueType, there can't be anything left in the `else` branch.
    ; It must reduce to never."* So a true-branch narrowing alone is not enough —
    ; `function f(x: unknown) { return typeof x === "string" || x === 1 }` narrows
    ; the true branch and leaves `number` in the false one, and is NOT a predicate.
    ;
    ; ★ The START node stands in for a return whose flow the binder did not label,
    ; which is the reference's `&ast.FlowNode{Flags: FlowFlagsStart}`.
    procedure check_if_expression_refines_parameter(mutable this, mutable fn: ref[AstNode], mutable expr: ref[AstNode], mutable param: ref[AstNode], mutable init_type: ref[Type]) returns ref[Type]? io reads ordinal_lock linked








































    ; The checker's own flow-node mint. The BINDER has one (new_flow_node_ex) and
    ; it is on the binder, so the three nodes this chapter needs — a Start and the
    ; two conditions — get the same three lines here rather than a cross-object
    ; call: these nodes are not part of the file's flow GRAPH, they are arguments.
    procedure new_checker_flow_node(mutable this, flags: int, node: ref[AstNode]?, antecedent: ref[FlowNode]?) returns ref[FlowNode] linked










    ; typePredicateToTypePredicateNodeHelper, as this file writes a text:
    ; `[asserts ]<name|this>[ is <T>]`.
    ;
    ; ★ THE TYPE IS OPTIONAL AND ONLY FOR AN `asserts`: `asserts x` is a valid
    ; predicate with no type at all, which is why the ` is ` is inside the guard.
    procedure write_type_predicate(mutable this, mutable predicate: ref[TypePredicate], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked























    ; The type-parameter list, `<T, U extends V = W>`.
    ;
    ; ★ typeParameterToDeclaration's three parts are the NAME, the constraint and
    ; the default, and the two modifiers in front of them (`in` / `out`) come from
    ; getTypeParameterVariances, which needs the variance computation. A variance
    ; annotation is source syntax, so it is READ off the declaration rather than
    ; recomputed — and where it is present this stops, because the modifier order
    ; upstream is the computed one.
    procedure write_type_parameter_list(mutable this, mutable sig: ref[Signature], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked
























    ; ── the printer's ONE node-REUSE site (slice 169) ────────────────────────
    ;
    ; typeToTypeNodeHelperWithPossibleReusableTypeNode, tryReuseExistingNodeHelper
    ; and the visitor behind it (`nodecopy.go`), plus the emitter's TYPE-NODE arms,
    ; which are what a reused node is printed BY. Until this slice the site was six
    ; shape-scoped stops and the units behind them were `frontier.sh`'s head.
    ;
    ; ★★★ THE CONTEXT IS WHAT MAKES IT AFFORDABLE, AND IT IS A MEASUREMENT AND NOT
    ; A SIMPLIFICATION. This printer is `TypeToString(t)`, whose enclosing
    ; declaration is NIL, and `isSymbolAccessibleWorker` answers ACCESSIBLE
    ; unconditionally when it is — `if symbol != nil && enclosingDeclaration != nil`
    ; guards its whole body. So the accessibility half of trackExistingEntityName
    ; (IsSymbolAccessible, getAccessibleSymbolChain, hasVisibleDeclarations, and the
    ; symbol-at-location cross-check that sits behind the same `!= nil`) cannot
    ; introduce an error here, and `ctx.mapper` is nil for the same reason, which
    ; closes the remapped-type-parameter refusal in tryVisitTypeReference. What is
    ; left of the entity-name walk is the JS `exports` shapes and the NAME — and the
    ; name is the identifier's TEXT either way, because
    ; attachSymbolToLeftmostIdentifier rebuilds the leftmost identifier from
    ; `node.Text()` and typeParameterToName reduces to the symbol's own name (its
    ; uniquifying loop is behind GenerateNamesForShadowedTypeParams, which
    ; typeToString does not set).
    ; ★★★ THE DAY AN ENCLOSING DECLARATION REACHES THIS PRINTER, EVERY ONE OF THOSE
    ; DOORS OPENS AND THIS PARAGRAPH IS THE LIST.
    ;
    ; ★★★ A REFUSAL IS LOCAL AND NOT FATAL, and reading it the other way is what
    ; made the six stops look like the only option. The visitor wraps every node in
    ; a recovery scope and the fallback is per NODE:
    ;
    ;     if bound.hadError { if IsTypeNode(node) && !IsTypePredicateNode(node) {
    ;         bound.endRecoveryScope(recover_)          ; the error is UNDONE
    ;         return b.typeToTypeNode(b.getTypeFromTypeNode(node, false)) } }
    ;
    ; so a node that cannot be reused is replaced by its own CANONICAL name while
    ; the tree around it is still reused. `<T extends unique symbol>` is the proof:
    ; the reference prints `symbol` — the canonical name — inside a reuse that
    ; SUCCEEDED. Only an error raised where no type node encloses it (a computed
    ; property name, a type predicate) travels further, and it travels exactly to
    ; the nearest enclosing type node.
    ;
    ; ★★ SO THE WRITER IS A PREDICATE PLUS AN EMITTER RATHER THAN ONE FUNCTION, and
    ; the reason is the buffer: the reference discards a NODE, this port would have
    ; to discard BYTES, and a StringBuilder cannot be rolled back.
    ;
    ; ★★ EVERY FORMAT BELOW IS READ OFF THE ORACLE AND NOT OFF THE EMITTER. Three
    ; probe fixtures over sixty constraint shapes fixed the whole table — `{ ` … `; }`
    ; for a type literal, `new ` with its space, the SOURCE's own quotes on a string
    ; literal, `-readonly`/`-?` on a mapped type, and `keyof (X)` KEEPING its
    ; parentheses, because `ast.SkipParentheses` in tryVisitSimpleTypeNode skips
    ; parenthesized EXPRESSIONS and a ParenthesizedType is not one.
    ;
    ; ★ IDENTIFIER ESCAPING IS NOT PORTED: the printer writes a non-ASCII identifier
    ; as `\uXXXX` unless EFNoAsciiEscaping is on it, which the visitor sets on the
    ; leftmost identifier of an entity name and on nothing else. Every identifier
    ; here is written as its text, so a non-ASCII name in a constraint is a FAIL and
    ; not a silence.
    ; `b.getTypeFromTypeNode(node, false)` — the type of an EXISTING node as the
    ; printer sees it, which is the checker's answer put through the context's
    ; mapper. The `noMappedTypes` half has no caller here.
    procedure printer_type_of_type_node(mutable this, mutable node: ref[AstNode]) @page true @returnpage true returns ref[Type]? io reads checker_strict_null_checks linked







    procedure write_possibly_reused_type_node(mutable this, mutable t: ref[Type]?, mutable node: ref[AstNode]?, mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked





























    ; The visitor's per-node fork.
    procedure write_reused_node(mutable this, mutable node: ref[AstNode], mutable out: ref[StringBuilder]) returns bool io reads checker_strict_null_checks linked


















