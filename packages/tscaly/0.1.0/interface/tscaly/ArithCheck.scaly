; SPDX-License-Identifier: Apache-2.0
;
; ArithCheck — the SECOND PRODUCER for jsnum's ARITHMETIC, and NumCheck's twin
; for the same reason one file over.
;
; Slice 116 added the other half of internal/jsnum: the five bitwise operators,
; the three shifts, the four arithmetic ones and the two the enum evaluator needs
; beside them. The checker yardstick sees them through ENUM MEMBER VALUES and
; nowhere else, and the corpus's enums are almost all small non-negative
; integers — so ToInt32's modulus, the shift count's mask, NaN's propagation
; through a remainder, the sign of a negative zero and `-1 >>> 0` are between
; them zero units. An unexercised arm is indistinguishable from a correct one
; (§3.5v's fourth row), so they get an instrument.
;
; One line of the corpus is TWO 16-hex-digit bit patterns, so the generator can
; reach any pair of doubles — which a decimal text cannot, and a TypeScript
; source certainly cannot. One line of output is thirteen results in the fixed
; order tests/oracle/arith.go writes, each as bits: a rendering would be measuring
; jsnum_to_string a second time, and two wrongs there cancel.
;
; It lives in the PACKAGE rather than the program root for NumCheck's reason: the
; accumulator is a container, and a generic instance handed to a program root
; reads back as garbage.

use scaly.memory.Page
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.Console

define ArithCheck
{
    procedure append_hex(mutable out: ref[StringBuilder], bits: u64) linked

    ; One 16-digit hex field of the corpus line, read back into the bits it
    ; spells. The corpus is generated by this suite, so a malformed digit is a
    ; harness defect rather than an input — it answers 0 and the diff says so.
    function read_hex(d: Slice[char], start: int, stop: int) returns u64 linked

    procedure run(host: ref[Page], text: String) io linked
}
