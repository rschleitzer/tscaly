; SPDX-License-Identifier: Apache-2.0
;
; inflate — a gzip member (RFC 1952) over DEFLATE (RFC 1951), written from the two
; RFCs. The reference embeds its translated diagnostic messages gzip-compressed
; (internal/diagnostics/loc/*.json.gz, read through compress/gzip); the port reads
; the same files. The header's CRC and the trailer are not checked.

use scaly.memory.Page
use scaly.containers.Array

; a canonical Huffman code: how many codes of each length (0..15) and the symbols
; in code order
define HuffmanCode (counts: ref[Array[int]]  symbols: ref[Array[int]])

define Inflate
(
    host: ref[Page]
    data: Slice[char]
    var pos: int
    var bit_buffer: int
    var bit_count: int
    out: ref[Array[char]]
    var failed: bool
)
{
    ; the uncompressed bytes of a gzip file, empty when it is not one
    procedure gunzip(host: ref[Page], mutable data: Slice[char]) @page true @direct true returns Slice[char] linked






































    ; the next `count` bits, least significant first; -1 past the end
    procedure bits(mutable this, count: int) returns int linked


















    procedure run(mutable this) linked




























    ; a stored block: byte-aligned length, its complement, the bytes
    procedure stored(mutable this) linked
























    ; a canonical code from the code lengths of its symbols
    procedure code_of(this, lengths: ref[Array[int]]) returns ref[HuffmanCode] linked















































    ; one symbol of a code, -1 on a bad code
    procedure decode(mutable this, h: ref[HuffmanCode]) returns int linked























    procedure fixed(mutable this) linked































    procedure dynamic(mutable this) linked



























































































    ; the literal/length and distance symbols of a Huffman block
    procedure codes(mutable this, literal: ref[HuffmanCode], distance: ref[HuffmanCode]) linked















































    function length_base(i: int) returns int linked










    function length_extra(i: int) returns int linked






    function distance_base(i: int) returns int linked







    function distance_extra(i: int) returns int linked





}
