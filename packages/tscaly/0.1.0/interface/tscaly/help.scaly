; SPDX-License-Identifier: Apache-2.0
;
; help — internal/execute/tsc/help.go: PrintVersion, PrintHelp (the easy and the
; --all view) and PrintBuildHelp (phase (b)2).
;
; ★ help.go assembles its text as a list of CHUNKS and one rule reads the list back
; (generateGroupOptionOutput's "always a blank line in the end" asks whether the
; chunk before the last is a newline), so the writer keeps the last two chunks'
; newline-ness rather than the chunks. The per-option data — value type, possible
; values, default text, whether the additional lines show — is generated from the
; declarations (TsOptionDecls.help_*), §3.23's argument.

use tscaly.diagnosticwriter.Localization
use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.TsOptionDecls.TsOptionDecls
use tscaly.DiagnosticMessages.DiagnosticMessages
use tscaly.diagnosticwriter.DiagnosticWriter
use tscaly.system.ExecSystem
use tscaly.program.JsonValue
use tscaly.tsoptions.TsOptions

; an option of a help list: the declaration table and the index in it
define HelpOption (table: int  index: int)

; the chunk writer and tsc.colors
define HelpWriter
(
    host: ref[Page]
    out: ref[StringBuilder]
    var last_newline: bool
    var before_last_newline: bool
    var count: int
    show_colors: bool
    is_windows: bool
    is_windows_terminal: bool
    is_vscode: bool
    supports_richer_colors: bool
    terminal_width: int
)
{
    ; createColors
    function create(host: ref[Page], sys: ref[ExecSystem], pretty: bool) @ret_explicit_0 true @deep true returns ref[HelpWriter] linked

    procedure chunk(mutable this, text: Slice[char]) @deep true linked

    procedure chunk_string(mutable this, text: String) @ret_nonlocal true @deep true linked

    procedure bold(mutable this, text: Slice[char]) @deep true linked

    procedure blue(mutable this, text: Slice[char]) @deep true linked

    procedure bright_white(mutable this, text: Slice[char]) @deep true linked

    ; blueBackground, around the brightWhite of `inner_white` when set
    procedure blue_background(mutable this, text: Slice[char], inner_white: bool) @ret_nonlocal true @deep true linked
}

; two text helpers of no module's own
define TsConfigParserless (reserved: int)
{
    function lower(host: ref[Page], s: Slice[char]) @ret_explicit_0 true @deep true returns Slice[char] linked

    function contains(s: Slice[char], t: Slice[char]) @ret_nonlocal true @deep true returns bool linked
}

define Help (reserved: int)
{
    ; core.Version() as the baselines were written: the pin's version.go says 7.0.2,
    ; but the help header's padding (the harness replaces the version after the
    ; text is laid out) is 9 characters wide — the 7.0.0-dev the baselines predate
    function version() @ret_nonlocal true @deep true returns Slice[char] linked

    procedure message(code: int) @ret_nonlocal true @deep true returns Slice[char] reads localized_messages linked

    procedure message1(host: ref[Page], code: int, a0: Slice[char]) @ret_explicit_0 true @deep true returns Slice[char] reads localized_messages linked

    ; PrintVersion
    procedure print_version(mutable sys: ref[ExecSystem]) @ret_nonlocal true @deep true reads localized_messages linked

    procedure title(host: ref[Page]) @ret_explicit_0 true @deep true returns Slice[char] reads localized_messages linked

    ; ── the declarations of a help list ─────────────────────────────────────

    function name_of(o: HelpOption) @ret_nonlocal true @deep true returns Slice[char] linked

    function short_name_of(o: HelpOption) @ret_nonlocal true @deep true returns Slice[char] linked

    function description_of(o: HelpOption) @ret_nonlocal true @deep true returns int linked

    function category_of(o: HelpOption) @ret_nonlocal true @deep true returns int linked

    function command_line_only(o: HelpOption) @ret_nonlocal true @deep true returns bool linked

    function simplified(o: HelpOption) @ret_nonlocal true @deep true returns bool linked

    function value_type(o: HelpOption) @ret_nonlocal true @deep true returns Slice[char] linked

    function possible_values(o: HelpOption) @ret_nonlocal true @deep true returns Slice[char] linked

    function default_text(o: HelpOption) @ret_nonlocal true @deep true returns Slice[char] linked

    function shows_additional_info(o: HelpOption) @ret_nonlocal true @deep true returns bool linked

    ; getDisplayNameTextOfOption
    function display_name(host: ref[Page], o: HelpOption) @ret_explicit_0 true @deep true returns Slice[char] linked

    ; the options of a table in declaration order (OptionsDeclarations, the compiler
    ; table's names being unique by index)
    procedure compiler_options(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[Array[HelpOption]] linked

    ; ── the chunks ───────────────────────────────────────────────────────────

    procedure spaces(host: ref[Page], n: int) @ret_explicit_0 true @deep true returns Slice[char] linked

    ; getHeader
    procedure header(mutable w: ref[HelpWriter], message: Slice[char]) @deep true linked

    ; getPrettyOutput
    procedure pretty_output(mutable w: ref[HelpWriter], left: Slice[char], right: Slice[char], right_align_of_left: int, left_align_of_right: int, color_left: bool) @deep true linked

    ; generateOptionOutput
    procedure option_output(mutable w: ref[HelpWriter], o: HelpOption, right_align_of_left: int, left_align_of_right: int) @deep true reads localized_messages linked

    ; generateGroupOptionOutput
    procedure group_output(mutable w: ref[HelpWriter], options: ref[Array[HelpOption]]) @ret_nonlocal true @deep true reads localized_messages linked

    ; generateSectionOptionsOutput
    procedure section_output(mutable w: ref[HelpWriter], section_name: Slice[char], options: ref[Array[HelpOption]], sub_category: bool, before: Slice[char], after: Slice[char]) @deep true reads localized_messages linked

    procedure example(mutable w: ref[HelpWriter], line: Slice[char], code: int) @ret_nonlocal true @deep true reads localized_messages linked

    ; PrintHelp: the easy view, or --all's
    procedure print_help(mutable sys: ref[ExecSystem], pretty: bool, all: bool) @deep true reads localized_messages linked

    function lower_less(a: Slice[char], b: Slice[char]) @deep true returns int linked

    ; printAllHelp
    procedure print_all_help(mutable w: ref[HelpWriter], options: ref[Array[HelpOption]]) @ret_nonlocal true @deep true reads localized_messages linked

    procedure build_section(mutable w: ref[HelpWriter]) @ret_nonlocal true @deep true reads localized_messages linked

    ; PrintBuildHelp
    procedure print_build_help(mutable sys: ref[ExecSystem], pretty: bool) @ret_nonlocal true @deep true reads localized_messages linked
}

; tsc/init.go: WriteConfigFile and generateTSConfig
define Init (reserved: int)
{
    ; WriteConfigFile; true when the file exists (the caller reports)
    procedure write_config_file(mutable sys: ref[ExecSystem], pretty: bool, mutable raw: ref[TsOptions]) @ret_nonlocal true @deep true returns bool reads localized_messages linked

    ; encoding/json's string encoding (HTML-safe, as json.Marshal writes it)
    procedure json_string(mutable sb: ref[StringBuilder], s: Slice[char]) @ret_nonlocal true @deep true linked

    ; formatSingleValue over a parsed value; `option` the declaration whose enum map
    ; maps it back to its first key, -1 for none
    procedure format_single_value(mutable sb: ref[StringBuilder], v: ref[JsonValue]?, option: int) @deep true linked

    ; formatValueOrArray
    procedure format_value_or_array(mutable sb: ref[StringBuilder], setting: Slice[char], v: ref[JsonValue]?) @deep true linked

    procedure line(host: ref[Page], mutable lines: ref[StringBuilder], text: Slice[char]) @ret_nonlocal true @deep true linked

    procedure header(mutable lines: ref[StringBuilder], code: int) @ret_nonlocal true @deep true reads localized_messages linked

    ; emitOption; `mode` 0 never commented, 1 always, 2 unless set; `remaining`
    ; the set options not yet written
    procedure emit_option(host: ref[Page], mutable lines: ref[StringBuilder], raw: ref[TsOptions], mutable remaining: ref[Array[Slice[char]]], setting: Slice[char], default_value: ref[JsonValue]?, mode: int) @ret_nonlocal true @deep true @deep_pageof_8 true @deep_into_3_8 true linked

    ; the list without its trailing empty entry (Array has no remove)
    procedure truncate(mutable list: ref[Array[Slice[char]]]) @deep true @deep_this_1 true @deep_pageof_1 true linked

    function value(host: ref[Page], kind: int, text: Slice[char], truth: bool) @ret_explicit_0 true @deep true returns ref[JsonValue] linked

    ; generateTSConfig
    procedure generate(host: ref[Page], raw: ref[TsOptions]) @page true @direct true @ret_caller true @deep true returns String reads localized_messages linked
}
