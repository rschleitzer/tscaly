; SPDX-License-Identifier: Apache-2.0
;
; buildinfojson — a JSON value tree as text (internal/json over go-json-experiment's
; encoder: Marshal and MarshalIndent), and tsctests' readable build info
; (readablebuildinfo.go), which the test system writes beside every .tsbuildinfo.
;
; ★ The build info is a JsonValue tree on both sides of the port: the incremental
; program builds it in the field order of incremental.BuildInfo and writes it
; compact, the harness parses the text and re-marshals it (testFs's version swap)
; and converts it to the readable form. A struct in the reference, a tree here —
; what is observable is the text, and a tree built in the struct's field order with
; its `omitzero` members left out serializes to the same bytes.

use scaly.memory.Page
use scaly.containers.Array
use scaly.containers.String
use scaly.containers.StringBuilder
use tscaly.program.JsonValue
use tscaly.program.JsonParser

define JsonText (reserved: int)
{
    ; ── construction ─────────────────────────────────────────────────────────

    function new_object(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    function new_array(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    function new_string(host: ref[Page], s: Slice[char]) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    function new_bool(host: ref[Page], b: bool) @ret_explicit_0 true @deep true returns ref[JsonValue] linked


    function new_number(host: ref[Page], n: int) @ret_explicit_0 true @deep true returns ref[JsonValue] linked







    procedure put_member(mutable obj: ref[JsonValue], key: Slice[char], value: ref[JsonValue]) @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true linked







    procedure push(mutable arr: ref[JsonValue], value: ref[JsonValue]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked





    ; a number member's value, 0 when absent or not a number
    function int_of(v: ref[JsonValue]?) @ret_nonlocal true @deep true returns int linked

























    function member_int(obj: ref[JsonValue], key: Slice[char]) @ret_nonlocal true @deep true returns int linked


    function member_bool(obj: ref[JsonValue], key: Slice[char]) @ret_param_0 true @deep true returns bool linked








    ; ── the text ─────────────────────────────────────────────────────────────

    function to_text(host: ref[Page], v: ref[JsonValue], indent: bool) @page true @direct true @ret_explicit_0 true @deep true @deep_beyond_2 true returns Slice[char] linked







    procedure newline_indent(mutable sb: ref[StringBuilder], depth: int) @deep true linked










    procedure write(mutable sb: ref[StringBuilder], v_opt: ref[JsonValue]?, indent: bool, depth: int) @deep true @deep_this_2 true linked















































































    ; the length of the valid UTF-8 sequence at `i`, 0 when the byte starts none
    function utf8_length(s: Slice[char], i: int) @ret_nonlocal true @deep true returns int linked















































    ; jsonwire.AppendQuote without EscapeForHTML/EscapeForJS: `"`, `\` and the
    ; control characters escaped, each invalid byte a U+FFFD
    procedure quote(mutable sb: ref[StringBuilder], s: Slice[char]) @ret_nonlocal true @deep true linked














































    procedure escape_control(mutable sb: ref[StringBuilder], c: int) @deep true linked































}

; tsctests' readableBuildInfo over a parsed build info
define ReadableBuildInfo
(
    host: ref[Page]
    info: ref[JsonValue]
    file_names: ref[JsonValue]?
    var file_ids_list: ref[JsonValue]?
)
{
    procedure file_name(mutable this, id: int) @ret_param_0 true @deep true returns ref[JsonValue] linked










    ; toReadableBuildInfo(buildInfo, buildInfoText)
    procedure convert(host: ref[Page], mutable info: ref[JsonValue], text: Slice[char]) @page true @direct true @ret_explicit_0 true @deep true @deep_beyond_3 true @deep_whole_3 true returns Slice[char] linked












































































    ; the length of fsbaselineutil.SanitizeInternalSymbolName(text): every
    ; `\uFFFD@name@123` with its digits replaced by `<symbolId>`
    function sanitized_length(text: Slice[char]) @ret_param_0 true @deep true returns int linked































    procedure copy_member(this, mutable out: ref[JsonValue], key: Slice[char]) @ret_nonlocal true @deep true @deep_into_1_4 true linked






    procedure map_ids(mutable this, ids: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked











    procedure map_lists(mutable this, lists: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked











    procedure roots(mutable this, root: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked































    ; ResolutionMode.String
    function resolution_mode_name(mode: int) @page true @direct true @ret_nonlocal true @deep true returns Slice[char] linked










    procedure file_infos(mutable this, infos: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked












































    procedure referenced_map(mutable this, entries: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked






















    procedure readable_diagnostics(mutable this, list: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked





























    procedure diagnostics_of_file(mutable this, pair: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked











    procedure semantic_diagnostics(mutable this, list: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked















    ; GetFileEmitKind over the build info's own options
    function full_emit_kind(this) @ret_nonlocal true @deep true returns int linked



















    ; toReadableFileEmitKind
    function emit_kind_name(host: ref[Page], kind: int) @ret_explicit_0 true @deep true returns ref[JsonValue] linked



























































    procedure pending_emit(mutable this, list: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked





























    procedure emit_signatures(mutable this, list: ref[JsonValue]) @ret_param_0 true @deep true returns ref[JsonValue] linked



































}
