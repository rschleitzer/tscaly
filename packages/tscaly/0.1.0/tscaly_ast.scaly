; SPDX-License-Identifier: Apache-2.0
;
; tscaly_ast — our half of the parser yardstick.
;
; Dumps our parse of one file in the format tests/oracle/ast.go produces, minus
; the trailing kind NAME (the oracle supplies that so a failing diff is
; readable; carrying a 386-entry name table here would buy nothing):
;
;   <depth> <kind> <pos> <end> <flags>       one line per node, pre-order
;   D <pos> <end> <code>                     one line per diagnostic
;
; Since slice 13b the D section is REAL for everything the scanner reports — an
; unterminated string or template, an invalid escape, a bad radix prefix, an
; invalid character, a merge-conflict marker. The PARSER's own ~99 error sites
; are still unported (13c), so a case needing one of those never reaches this
; comparison: the runner decides UNPORTED before it diffs anything.
;
; When the parser (or the scanner under it) meets a construct this slice does
; not implement it stops and reports UNPORTED with the position instead of
; printing a well-formed tree that disagrees with the reference. The runner
; treats that as its own outcome — neither a pass nor a silent failure.
;
; This is a program, not part of the `define tscaly` package module: it is
; compiled standalone against the package object, exactly as tscaly_tokens is.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.containers.String
use tscaly.ast.AstNode
use tscaly.parser.Parser

; Pre-order, through the reference's own child ORDER — which is part of what the
; yardstick compares, so the walk asks Node for it rather than knowing it here.
;
; The recursion is plain because the children come back as an index pair rather
; than through a visitor callback: Scaly's only escaping-closure form is
; `return \x: …`, so a walk that builds a fresh closure per level is the shape
; the escape checker exists to reject. See ast.scaly.
procedure dump(n: pointer[AstNode], depth: int)
{
    print "`depth` `AstNode.kind_of(n)` `AstNode.pos_of(n)` `AstNode.end_of(n)` `AstNode.flags_of(n)`"
    var i 0
    let count AstNode.child_count(n)
    while i < count
    {
        dump(AstNode.child_at(n, i), depth + 1)
        set i: i + 1
    }
}

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_ast <file.ts>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region: one arena for the whole parse. The tree, the node lists
    ; and the parser itself live on it and die with it — the reference's own
    ; back-pointers and caches would cost nothing here for the same reason.
    ;
    ; ★ The anchor is a SMALL string, deliberately, and the source text cannot
    ; serve as one: a large file's buffer is an OVERSIZED allocation, and
    ; Page.get() of an address inside one answers a page whose next_object is
    ; null — the first allocation on it then trips the oversized-page trap
    ; (exit 19). Measured on the corpus: one case in 296 is big enough. This is
    ; the idiom dazzle_cli uses for the same reason.
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer() as pointer[void])

    var unported 0 - 1
    var unported_tag null as pointer[const_char]
    var unported_detail 0
    ; The path is an ARGUMENT to the parse, not just to the read: a `.d.ts` name
    ; makes the file ambient (tspath.scaly), and the reference's oracle derives
    ; the same answer from the same argument. It asks the question of the last
    ; path component only, so our relative path and the oracle's normalized
    ; absolute one must agree — and that they do is what the declaration-file
    ; fixtures gate.
    let file Parser.parse(host, path, text, &unported, &unported_tag, &unported_detail)

    ; Read the unported position FIRST: a non-negative one invalidates the tree,
    ; and a tree built past an unscannable construct has meaningless spans.
    if unported >= 0
    {
        ; The TAG is what makes the unported column a plan rather than a count:
        ; `grep '^UNPORTED' | awk '{print $3, $4}' | sort | uniq -c` names the
        ; construct that would unlock the most cases next. The runner only looks
        ; at the first field, so the extra columns cost it nothing.
        print "UNPORTED `unported` `unported_tag` `unported_detail`"
        return 0
    }

    if file = null
    {
        print "UNPORTED 0 no-tree 0"
        return 0
    }

    dump(file, 0)

    ; The diagnostics section, in the oracle's order — which is EMISSION order,
    ; not sorted: `finishSourceFile` does
    ; `SetDiagnostics(attachFileToDiagnostics(p.diagnostics, result))` with no
    ; sort and no filter, so the list is compared exactly as it was appended.
    ; That is why a scan error has to be appended at the moment of scanning
    ; rather than collected and merged afterwards.
    var di 0
    let dn AstNode.diagnostic_count(file)
    while di < dn
    {
        var dpos 0
        var dend 0
        var dcode 0
        if AstNode.diagnostic_at(file, di, &dpos, &dend, &dcode)
            print "D `dpos` `dend` `dcode`"
        set di: di + 1
    }
    0
}
