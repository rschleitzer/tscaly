; SPDX-License-Identifier: Apache-2.0
;
; tscaly_paths — our half of the PATH cross-check (slice 28).
;
; Reads a corpus of `<cwd>TAB<path>` lines and prints, per line, the length after
; RemoveFileExtension and the normalized absolute path. tests/oracle/paths.go is
; the other producer and tests/pathcheck.sh runs both over the same file.
;
; Why it is a program of its own rather than a case in the four yardsticks: the
; question is about a STRING and not about a source file, so there is no unit to
; hang it on — and the arms it covers (UNC, a DOS volume, `^/`, `file://`,
; `http://`, `..` above a root, doubled separators) are the ones the corpus of
; TypeScript sources cannot produce. See tscaly/PathCheck.scaly.
;
; The work lives in the package; this is three steps and no logic of its own.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.containers.String
use tscaly.PathCheck.PathCheck

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_paths <corpus>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region and its SMALL anchor: the corpus text is one oversized
    ; allocation, and Page.get() of an address inside one answers a page whose
    ; first allocation trips the oversized-page trap (§3.12).
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    PathCheck.run(host, text)
    0
}
