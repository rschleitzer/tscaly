; SPDX-License-Identifier: Apache-2.0
;
; tscaly_jsdoc — our half of the THIRD yardstick, slice 21.
;
; Dumps our JSDoc parse of one file in the format tests/oracle/jsdoc.go
; produces, minus the trailing kind NAME (the oracle supplies that so a failing
; diff is readable):
;
;   N <index> <count>                        one line per node that has JSDoc
;   <depth> <kind> <pos> <end> <flags>       one line per JSDoc node, pre-order
;
; `index` is the node's position in the SAME pre-order walk tscaly_ast prints,
; so a JSDoc block is anchored to a node both sides have already agreed on.
;
; ★★★ WHY THIS IS A THIRD PROGRAM AND NOT A SECTION OF tscaly_ast. JSDoc nodes
; are not in the tree the parser yardstick walks — for a TS/TSX file the
; reference does not even parse them during ParseSourceFile, it sets HasLazyJSDoc
; and parses on the first access to Node.JSDoc(file). So a JSDoc defect is
; invisible to both existing yardsticks in either direction, and folding it into
; the ast dump would have turned all 804 units red at once the moment the section
; appeared. The oracle's header carries the same argument from the other side.
;
; ★ It asks the PARSER for each node's JSDoc rather than reading a cache,
; because that is what the reference's accessor does for a TS file: parse on
; demand, per node. `Parser.parse_ex` exists so the parser survives the parse.
;
; This is a program, not part of the `define tscaly` package module: it is
; compiled standalone against the package object, exactly as tscaly_ast is.

package scaly 0.1.0
package tscaly 0.1.0

use scaly.memory.Page
use scaly.io.File
use scaly.containers.String
use scaly.containers.Array
use tscaly.ast.AstNode
use tscaly.parser.Parser
use tscaly.JsDocDump.JsDocDump

function main(argc: int, argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_jsdoc <file>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; The run region, anchored on a SMALL string — a large file's buffer is an
    ; oversized allocation and Page.get() of an address inside one trips the
    ; oversized-page trap (§3.12).
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    var unported 0 - 1
    var unported_tag: pointer[const_char] null
    var unported_detail 0
    let script_kind Parser.supported_script_kind(path)
    let p Parser.parse_ex(host, path, text, script_kind, &unported, &unported_tag, &unported_detail)

    if unported >= 0
    {
        print "UNPORTED `unported` `unported_tag` `unported_detail`"
        return 0
    }

    let file Parser.source_file_of(p)
    if file = null
    {
        print "UNPORTED 0 no-tree 0"
        return 0
    }

    ; The walk is JsDocDump's since slice 58 — see that module for why the node's
    ; WALK INDEX is the only name both sides agree on.
    JsDocDump.write(host, p, file)
    0
}
