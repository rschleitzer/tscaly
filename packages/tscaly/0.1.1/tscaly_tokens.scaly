; SPDX-License-Identifier: Apache-2.0
;
; tscaly_tokens — our half of the scanner yardstick.
;
; Dumps our token stream for one file in the format tests/oracle/tokens.go
; produces, minus the trailing kind NAME (the oracle supplies that so a failing
; diff is readable; carrying a 351-entry name table here would buy nothing):
;
;   <kind> <tokenStart> <tokenEnd> <tokenFlags>
;
; When the scanner meets a construct this slice does not implement it stops and
; reports UNPORTED with the position instead of continuing and emitting a
; well-formed stream that disagrees with the reference. The runner treats that as
; its own outcome — neither a pass nor a silent failure.
;
; This is a program, not part of the `define tscaly` package module: it is
; compiled standalone against the package object, the way onsgmls.scaly is for
; opensp.

package scaly 0.1.0
package tscaly 0.1.1

use scaly.memory.Page
use scaly.os.File
use scaly.containers.String
use tscaly.scanner.Scanner
use tscaly.parser.Parser
use tscaly.TokenDump.TokenDump

procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int
{
    if argc <> 2
    {
        print "usage: tscaly_tokens <file>"
        return 2
    }

    let path String(*(argv + 1))
    if File.exists(path) = false
    {
        print "cannot read `path`"
        return 1
    }

    let text File.read_to_string(path)

    ; ★ The run region and its SMALL anchor: a large file's buffer is an OVERSIZED
    ; allocation, and Page.get() of an address inside one answers a page whose
    ; first allocation trips the oversized-page trap (§3.12). The scanner itself
    ; allocates nothing; the dump's StringBuilder does.
    let anchor String("tscaly")
    let host Page.get(anchor.get_buffer())

    ; The body is TokenDump's since slice 58 — see that module for why the file's
    ; NAME has to reach the scanner, and tscaly.scaly for why it moved.
    TokenDump.write(host, text, Parser.script_kind_is_jsx_variant(path))
    0
}
